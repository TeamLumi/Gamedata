ev_c05r0901_girl2:
	_TALK_OBJ_START_TURN_NOT()
	_IF_FLAGON_JUMP($SYS_FLAG_MIZUKI, 'ev_c05r0901_girl2_02')
	_SET_SYS_FLAG($SYS_FLAG_MIZUKI)
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_01_1', 'Hiya!\rOh, I’ve seen you somewhere before! Where was\nit again? Hold on, it’ll come to me...\rOh yeah! You’re the one who was battling those\nscary looking guys in Jubilife City!\rI was really curious about you after that, so I\nwent ahead and did a little research.', 1)
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_01_2', 'And then... Surprise, surprise! Turns out you’re\nconnected to the famous Professor Rowan?\fAnd you’ve been goin’ around defeating Gym\fLeaders, too? I seriously thought my eyes were\fgonna pop out of my head!', 1)
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_01_3', 'Oh, sorry! There I go running my mouth again!\nIt’s me, Bebe! You remember me, don’t you?', 1)
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_01_4', 'I’m the one who gave you those Ball Capsules!\rAnd hey, you know those Pokémon Boxes you’ve\nbeen using? I’m the system administrator of ’em!', 1)
	_MACRO_TALKMSG('dialogue_c05r0901', '00_msg_ev_c05r0901_girl_give', 'While you’re here, you should take this. It’s a\nspare, but it might be helpful for your\fPokédex!\rThis Upgrade will install an evolution patch\ninto Porygon. Give it a try!')
	_LDVAL(@SCWK_TEMP0, 252)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c05r0901', '00_msg_ev_c05r0901_girl_repeat', 'Sorry to be so sudden. I’ve\nhad that Upgrade for a while now,\fbut I’ve never had a use for it.\rIt’s great for any Porygon—otherwise\nknown as the Virtual Pokémon!\rI don’t have a partner Porygon, unfortunately.\rA Porygon will evolve into Porygon2\nif it gets exposed to that Upgrade.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0901_girl2_02:
	_IF_FLAGON_JUMP($SYS_FLAG_GAME_CLEAR, 'ev_c05r0901_girl2_03'); If the player has beaten the Pokémon League
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_02_1', 'My buddy Bill developed the basic storage\nsystem. I just tinkered with it here and there\fto make it easier to use.\rAnyway, now that you’re here in Hearthome City,\nhow ’bout trying out a Super Contest Show?\rJust be sure to use those Stickers of yours.\nDon’t you dare forget!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0901_girl2_03:
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_03_1', 'Hey there, Champ! Congrats, by the way.\nLooks like my boxes have been helping a\fwhole lot!')
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_03_2', 'A bunch of storage technician friends\nand I have been messaging non-stop about the\fstrange migration phenomenon.')
	_MACRO_TALKMSG('dialogue_c05r0901', '53-msg_c05r0901_girl2_03_3', 'The Pokémon you’ve captured have been\nespecially interesting. Thanks!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()