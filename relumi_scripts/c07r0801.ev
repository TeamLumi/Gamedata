ev_c07r0801_woman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#TMFLG_C07R0801_DRESSING, 'ev_c07r0801_woman_after_dressing')
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_01', 'Oh, looking a little tired?\nHm? No, not you—I meant your Pokémon.\rIf you’d like, I can give a massage to a Pokémon.\nWould you like that?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07r0801_woman_cancel')
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_02', 'Which one needs a little love?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_POKELIST_SET_PROC(9)
	_POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_c07r0801_woman_cancel')
	_TEMOTI_BOX_MONSNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0801_woman_tamago')
	_LDVAL(@LOCALWORK0, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_04', '*giggle* Let’s get started.\nOK, sweetie, just relax...')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_SE_PLAY('S_FI221')
	_SE_WAIT('S_FI221')
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_NICK_NAME_ALL(0, @LOCALWORK0, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_05', '{0,1,1,0} looks dreamily contented...')
	_FLAG_SET(#TMFLG_C07R0801_DRESSING)
	_ADD_NATSUKI(3, @LOCALWORK0, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_08', 'When I was massaging your Pokémon,\nI found this.')
	_JUMP('ev_c07r0801_woman_getseal')
	_END()
ev_c07r0801_woman2:
	_JUMP('ev_c07r0801_woman_dressing_end')
	_END()
ev_c07r0801_woman_getseal:
	_GET_RND(@SCWK_TEMP1, 9)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 0, 'ev_c07r0801_woman_getseal_a')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 1, 'ev_c07r0801_woman_getseal_b')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 2, 'ev_c07r0801_woman_getseal_c')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 3, 'ev_c07r0801_woman_getseal_d')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 4, 'ev_c07r0801_woman_getseal_e')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 5, 'ev_c07r0801_woman_getseal_f')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 6, 'ev_c07r0801_woman_getseal_g')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 7, 'ev_c07r0801_woman_getseal_h')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 8, 'ev_c07r0801_woman_getseal_i')
	_END()
ev_c07r0801_woman_getseal_a:
	_LDVAL(@SCWK_TEMP0, 52)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_JUMP('ev_c07r0801_woman2')
	_END()
