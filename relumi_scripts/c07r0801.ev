ev_c07r0801_woman_after_dressing:
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_09', 'Oh? You want me to show you how to\nmassage Pokémon?\rTehehe...\rIt’s a secret, of course!\rCome back again tomorrow!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0801_woman_tamago:
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_07', 'That’s silly!\nI’d break that Egg if I tried to massage it!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0801_woman_cancel:
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_03', 'Oh! Hey, I’m not doing anything shady...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0801_woman_dressing_end:
	_MACRO_TALKMSG('dialogue_c07r0801', '107-msg_c07r0801_woman2_06', 'Drop by again tomorrow if you’d like.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0801_boy:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0801', '107-msg_c07r0801_boy2_01', 'My sister’s boyfriend is the Scarf Guy in\nPastoria City.\rThey take strolls together with their Pokémon.\nThose two are really close.')
	_END()
ev_c07r0801_poke:
	_EASY_VOICE_MSG('dialogue_c07r0801%107-msg_c07r0801_patiritusu_01', 'PLAY_PV_EV_417_00_00')
	_END()