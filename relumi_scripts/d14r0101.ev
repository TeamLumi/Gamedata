ev_d14r0101_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D14R0101)
	_END()
d14r0101_mount_flag_set:
	_LDVAL(@WK_SCENE_D14R0101, 2)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2900)
	_RET()
ev_d14r0101_mount_tips:
	_BOUKENNOOTO_TIPS_OPEN(14, @SCWK_ANSWER) ; TM tooltip
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2464); HM Chapter
	_FLAG_SET(#FE_HIDEN_06_GET)
	_RET()
ev_d14r0101_mount:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d14r0101_mount_02')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_03', 'Oh! Good golly!\nThat’s Oreburgh City’s Gym Badge!\rAll right! Now you can use the hidden move\nRock Smash on small boulders!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d14r0101_mount_02:
	_IF_FLAGON_JUMP(#FE_HIDEN_06_GET, 'ev_d14r0101_mount_03')
	_EVENT_CAMERA_INDEX(164)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_01_1', 'Oh, lookie there! You’ve got a Pokétch!\rHmm... You’re still a pretty new Trainer,\naren’t you?')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_01_2', 'But it’s all good! You’re a new fellow friend\nof Pokémon!\rSo, let me make a gift of this Technical\nMachine to you!')
	_IFVAL_CALL(@WK_SCENE_D14R0101, 'NE', 2, 'pos_d14r0101_mount_itemget')
	_CALL('d14r0101_mount_flag_set')
	_MACRO_TALK_KEYWAIT('dialogue_d14r0101', '59-msg_d14r0101_mount_02_1', 'This TM contains the move\nRock Smash.\rFYI, Technical Machines are used to teach your\nPokémon a move, and TMs will not break.\rSo no need to worry when you use it.')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_02_2', 'But to use this hidden move in the field, you’ll\nfirst need the Gym Badge from Oreburgh City.\rI’m looking forward to seeing your growth!', 1)
	_TALK_CLOSE()
	_IF_FLAGOFF_CALL(#FE_HIDEN_06_GET, 'ev_d14r0101_mount_tips')
	_EVENT_CAMERA_INDEX(151)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_END()
ev_d14r0101_mount_03:
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_02_1', 'This TM contains the move\nRock Smash.\rFYI, Technical Machines are used to teach your\nPokémon a move, and TMs will not break.\rSo no need to worry when you use it.')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_02_2', 'But to use this hidden move in the field, you’ll\nfirst need the Gym Badge from Oreburgh City.\rI’m looking forward to seeing your growth!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_d14r0101_hm_rock_smash:
	_EVENT_START()
	_OBJ_ANIME('D14R0101_MOUND_01', 'anm_d14r0101_mount_01')
	_OBJ_ANIME('HERO', 'anm_d14r0101_player_01')
	_OBJ_ANIME_WAIT()
	_NONE_USE_NUMBER()
	_EVENT_CAMERA_INDEX(131)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_01_1', 'Oh, lookie there! You’ve got a Pokétch!\rHmm... You’re still a pretty new Trainer,\naren’t you?')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_01_2', 'But it’s all good! You’re a new fellow friend\nof Pokémon!\rSo, let me make a gift of this Technical\nMachine to you!')
	_IFVAL_CALL(@WK_SCENE_D14R0101, 'NE', 2, 'pos_d14r0101_mount_itemget')
	_CALL('d14r0101_mount_flag_set')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_02_1', 'This TM contains the move\nRock Smash.\rFYI, Technical Machines are used to teach your\nPokémon a move, and TMs will not break.\rSo no need to worry when you use it.')
	_MACRO_TALKMSG('dialogue_d14r0101', '59-msg_d14r0101_mount_02_2', 'But to use this hidden move in the field, you’ll\nfirst need the Gym Badge from Oreburgh City.\rI’m looking forward to seeing your growth!', 1)
	_TALK_CLOSE()
	_IF_FLAGOFF_CALL(#FE_HIDEN_06_GET, 'ev_d14r0101_mount_tips')
	_NONE_USE_NUMBER()
	_EVENT_CAMERA_INDEX(151)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
pos_d14r0101_mount_itemget:
	_LDVAL(@SCWK_TEMP0, 425)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_RET()
anm_d14r0101_player_01:
	_AC_DIR_U(8)
	_ACMD_END()
anm_d14r0101_mount_01:
	_AC_MARK_GYOE(1)
	_AC_WORLD_Z(20.910000, 8)
	_ACMD_END()