ev_r217_flag_change:
	_IF_FLAGON_CALL(#FE_HIDEN_08_GET, 'ev_r217_anaunce_chk')
	_IF_FLAGON_JUMP(#FE_R217R0201_ITEM_GET, 'ev_r217r0201_woman1_del')
	; After Darmanitan blocker has been removed, remove the NPCs if the player is not coming from R216
	_IF_FLAGON_CALL(#2408, 'ev_r217_remove_blockers_check_2')
	_END()
ev_r217r0201_woman1_del:
	_FLAG_SET(#FV_R217R0201_WOMAN1)
	_END()
ev_r217_anaunce_chk:
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 10800, 'ev_r217_anaunce_upd')
	_END()
ev_r217_anaunce_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 10900)
	_RET()
ev_r217_remove_blockers_check_2:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'LT', 380, 'ev_r216_remove_blockers') ; Player is not coming from R216
	_RET()
ev_r217_stone:
	_MACRO_EASY_OBJ_MSG('dialogue_r217', '174-msg_r217_stone_01', 'The boulder is encrusted with ice. It is\nbone-chilling to touch.')
	_END()
ev_r217_stone_event:
	_IF_FLAGON_JUMP(#2762, 'ev_r217_stone')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r217', '00_msg_r217_stone_1', 'The boulder is encrusted with ice.\nIt is bone chilling to touch.\r...\rA piece of the boulder fell off...')
	_LDVAL(@SCWK_TEMP0, 849); Ice stone ID
	_LDVAL(@SCWK_TEMP1, 1); 1
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_FLAG_SET(#2762); Stone event is over
	_END()
ev_r217_sign1:
	_EASY_BOARD_MSG('dialogue_r217%174-msg_r217_sign1_01', 'BOARD_TYPE_ROAD', 0, 10)
	_END()
ev_r217_girl4:
	_MACRO_EASY_OBJ_MSG('dialogue_r217', '174-msg_r217_girl4_01', 'I’m using the Dowsing Machine on my Pokétch.\rI’m looking for things buried under the snow.')
	_END()
ev_r217_grotto_warp_0:
	_TALK_OBJ_START()
	_CALL('ev_grotto_warp')
	_MAP_CHANGE('GROTTOR0401', 0)
	_TALK_OBJ_END()
	_END()
ev_r217_grotto_warp_1:
	_TALK_OBJ_START()
	_CALL('ev_grotto_warp')
	_MAP_CHANGE('GROTTOR0401', 1)
	_TALK_OBJ_END()
	_END()