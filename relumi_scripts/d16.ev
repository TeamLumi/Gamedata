ev_d16_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D16)
	_IF_FLAGON_CALL(#2537, 'ev_d16_check_post_stark_event')
	_END()
ev_d16_check_post_stark_event:
	_IF_FLAGOFF_CALL(#3100, 'ev_d16_post_stark_event')
	_END()
ev_d16_sign1:
	_EASY_BOARD_MSG('dialogue_d16%64-msg_d16_sign1_01', 'BOARD_TYPE_POST', 0)
	_END()
pos_d16_grunt_event:
	_EVENT_START()
	_CHARA_LOOK_LOCK('HERO', 'D16_GRUNT1')
	_OBJ_ANIME('D16_GRUNT1', 'anm_d16_grunt1_walk_stark_mountain1')
	_OBJ_ANIME('D16_GRUNT2', 'anm_d16_grunt2_walk_stark_mountain1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d16', '00_msg_d16_grunt_0', 'This is it!\nStark Mountain!\rNow we need to get deep inside.\nLet’s do this!')
	_TALK_CLOSE()
	_OBJ_ANIME('D16_GRUNT1', 'anm_d16_grunt1_walk_stark_mountain2')
	_OBJ_ANIME('D16_GRUNT2', 'anm_d16_grunt2_walk_stark_mountain2')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('D16_GRUNT2', 'D16_GRUNT1')
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_grunt_1', 'Yeah, but...\nCan that old guy really take over?\fCan he replace Master Cyrus?')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('D16_GRUNT1', 'D16_GRUNT2')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D16_GRUNT1')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('D16_GRUNT1', 'anm_d16_grunt1_lookup')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_grunt_2', 'Yeah, I hear you...\rThat elder Charon is a Commander,\nbut he can’t replace Master Cyrus.\r...Maybe this is a good time for me to\nbe done with this Team Galactic thing...')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('D16_GRUNT2')
	_OBJ_ANIME('D16_GRUNT1', 'anm_d16_grunt1_enter_stark_mountain')
	_OBJ_ANIME('D16_GRUNT2', 'anm_d16_grunt2_enter_stark_mountain')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_FLAG_SET(#2533)
	_OBJ_DEL('D16_GRUNT1')
	_OBJ_DEL('D16_GRUNT2')
	;Play warp sound
	_SE_PLAY('S_FI001')
	_LDVAL(@481, 2)
	_EVENT_END()
	_END()
anm_d16_grunt1_walk_stark_mountain1:
	_AC_DIR_R(8)
	_AC_RIGHT(4, 8)
	_ACMD_END()
anm_d16_grunt2_walk_stark_mountain1:
	_AC_UP(1, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(3, 8)
	_ACMD_END()
anm_d16_grunt1_walk_stark_mountain2:
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(4, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
anm_d16_grunt2_walk_stark_mountain2:
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(3, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
anm_d16_grunt1_lookup:
	_AC_DIR_U(8)
	_ACMD_END()
anm_d16_grunt1_enter_stark_mountain:
	_AC_UP(3, 8)
	_AC_INVISIBLE_ON()
	_ACMD_END()
anm_d16_grunt2_enter_stark_mountain:
	_AC_RIGHT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(3, 8)
	_AC_INVISIBLE_ON()
	_ACMD_END()
anm_d16_hero_5:
	_AC_DIR_U(4)
	_ACMD_END()
anm_d16_buck_1:
	_AC_INDEX_ANIME(1, 1)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
anm_d16_buck_2:
	_AC_DIR_U(4)
	_AC_UP(3, 8)
	_AC_INVISIBLE_ON()
	_ACMD_END()
anm_d16_buck_3:
	_AC_DIR_D(4)
	_AC_INVISIBLE_OFF()
	_AC_DOWN(2, 4)
	_AC_DIR_R(4)
	_ACMD_END()
anm_d16_buck_4:
	_AC_DIR_D(4)
	_AC_DOWN(2, 8)
	_AC_DIR_L(4)
	_AC_LEFT(4, 8)
	_AC_DIR_U(4)
	_AC_UP(2, 8)
	_AC_DIR_L(4)
	_AC_LEFT(4, 8)
	_AC_DOWN(12, 1)
	_AC_RIGHT(10, 1)
	_AC_UP(2, 1)
	_AC_UP(5, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(8, 8)
	_ACMD_END()
anm_d16_looker_1:
	_AC_DIR_L(4)
	_ACMD_END()
anm_d16_looker_2:
	_AC_DIR_L(4)
	_ACMD_END()
anm_d16_looker_3:
	_AC_WAIT(8)
	_AC_DIR_L(4)
	_ACMD_END()
anm_d16_looker_4:
	_AC_DIR_D(4)
	_ACMD_END()
ev_d16_post_stark_event:
	_TALK_OBJ_START()
	_CHARA_LOOK_LOCK('D16_BUCK_POST', 'D16_LOOKER')
	_MACRO_TALKMSG('dialogue_d16', '00_msg_d16_text_3', 'Whew! The air outside, it is\ndelicious, yes!\r...Gweh! Gah! Geff! Bleah!\rI have inhaled the volcanic ash by\nthe lungful!')
	_TALK_CLOSE()
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_text_4', 'Now, you two.\nThis is what they were after.\rThe Magma Stone.\rMoving this is said to awaken the\nPokémon Heatran.\rThe old tales say that its awakening,\nit will make Stark Mountain erupt.\r...But I have moved it. It is here.\nWill this cause the eruption?!')
	;Steps in place
	_OBJ_ANIME('D16_BUCK_POST', 'anm_d16_buck_1'); OW 5
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_text_5', 'Hey, don’t sweat it, stranger.\rGive me that Magma Stone.\nI’ll go put it back for you.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('D16_BUCK_POST')
	_OBJ_ANIME('D16_BUCK_POST', 'anm_d16_buck_2')
	_OBJ_ANIME_WAIT()
	;Play warp sound
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('D16_LOOKER', 'anm_d16_looker_2'); OW 4
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_CHARA_LOOK_LOCK('D16_LOOKER', 'HERO')
	_MACRO_TALKMSG('dialogue_d16', '00_msg_d16_text_6', 'That boy, he has quite the\nenergy, yes?\r{0,1,0,0}, I should tell you why\nI have arrived here.\rAfter we parted at the Mt. Coronet,\nI investigated their hideout.\rI uncovered Charon’s plot, which led\nme to a stakeout of this place.\rThat Charon is now securely within our\ncustody.\rIt is safe to say the Team Galactic is\na threat no longer.\rThat being said, it looks like my work\nhere is finally finished.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('D16_LOOKER')
	_TIME_WAIT(30, @SCWK_ANSWER)
	;Play warp sound
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('D16_BUCK_POST', 'anm_d16_buck_3')
	_OBJ_ANIME('D16_LOOKER', 'anm_d16_looker_3')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'D16_BUCK_POST')
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_text_7', 'Hey, stranger!\nI put the Magma Stone where it belongs.\rIt’ll be OK now.\nHeatran won’t wake up. Probably.')
	_CHARA_LOOK_LOCK('D16_BUCK_POST', 'HERO')
	_PLAYER_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_text_9', 'But, hey, {0}!\nYou’re an amazing Trainer!\rSwing by my place later.\nIt’s in the Survival Area.\rBe seeing you, stranger, {0}!\nBye-bye!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('D16_BUCK_POST')
	_CHARA_LOOK_LOCK('D16_LOOKER', 'D16_BUCK_POST')
	_OBJ_ANIME('D16_BUCK_POST', 'anm_d16_buck_4')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('D16_LOOKER')
	_OBJ_DEL('D16_BUCK_POST')
	_OBJ_ANIME('D16_LOOKER', 'anm_d16_looker_4')
	_OBJ_ANIME('HERO', 'anm_d16_hero_5')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_d16', '00_msg_d16_text_8', 'I, also, will take my leave.\r“The more wonderful the meeting, the\nsadder the parting.”\rThat is a quote I have heard many years\nago in a foreign land.\rIts meaning...\nI understand it better now.\rFarewell, {0}, my friend!\nLong may you cherish Pokémon!')
	_TALK_CLOSE()
	_BLACK_OUT()
	_FADE_WAIT()
	_OBJ_DEL('D16_LOOKER')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_BLACK_IN()
	_FADE_WAIT()
	_FLAG_SET(#2885); Hides Looker and Buck PlaceDatas
	_LDVAL(@481, 4); Disables the StopData
	_FLAG_SET(#3100); Post stark event done
	_FLAG_RESET(#2886); Enables Buck PlaceData in a different location
	_TALK_OBJ_END()
	_END()
ev_t06_temp_buck:
	_IF_FLAGOFF_JUMP(#2537, 'ev_t06_temp_buck_dialogue'); has this buck up but hasn't done the Stark mountain event somehow
	_ITEM_CHK(458, 1, @SCWK_ANSWER)
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t06_magma_stone_fix')
	_JUMP('ev_t06_temp_buck_dialogue')
	_END()
ev_t06_magma_stone_fix:
	_TALK_OBJ_START()
	_LDVAL(@SCWK_TEMP0, 458); Magma Stone
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_RET()
ev_t06_temp_buck_dialogue:
	_PLAYER_NAME(0)
	_MACRO_EASY_OBJ_MSG('dialogue_d16', '00_msg_t06_temp_buck', 'Hey {0}!\rWe’re still getting things ready\nin here, but the good news is that\fHeatran is now ready to catch.')
	_FLAG_SET(#FE_D16R0103_LEGEND_UNSEAL)
	_END()
