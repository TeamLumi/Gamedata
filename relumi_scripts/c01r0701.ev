	_LDVAL(@SCWK_TEMP0, 93); Heart Scales
	_LDVAL(@SCWK_TEMP1, 15); Quantity 15
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_FLAG_SET(#2583)
	_TALK_OBJ_END()
	_END()
ev_c01r0701_jan_done:
