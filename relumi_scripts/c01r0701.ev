ev_c01r0701_rival:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(504)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_01_1', 'Hey, {0,1,0,0}! Did you come to\nstudy, too?\rI went ahead and memorized everything that was\nup on the blackboard.', 0, 1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_01_2', 'I even heard someone say we get free access\nto portable Pokémon Boxes now that we’re\fregistered Trainers.', 1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_01_3', 'So, {0,1,0,0}, what brings you here?\nYou’ve got something for me?', 1)
	_SE_PLAY('M_FI013')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_02', 'You delivered the Parcel.')
	_ME_WAIT()
	_LDVAL(@SCWK_TEMP0, 459)
	_SUB_ITEM(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_03_1', 'So, what is this?\rScore! It’s a Town Map!')
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_03_2', 'Huh?! Why are there two in here?\rI like it a lot, but I don’t need two.\nHere, {0,1,0,0}, you take one!', 1)
	_SE_PLAY('M_FI012')
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_03_3', 'You obtained a <color=#F01E1EFF>Town Map</color>!', 1)
	_ME_WAIT()
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_04_1', 'Hmm...\rWell, according to the Town Map, I guess\nOreburgh City is where I should be going next.')
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_04_2', 'There’s a Gym, so it’d be perfect for raising the\nPokémon I just caught.')
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_rival_04_3', 'Well, I’m on the road to becoming the greatest\nTrainer of all time!\rSee you around!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(505)
	_EVENT_CAMERA_END_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 5, 'ev_c01r0701_player_dir_right')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 6, 'ev_c01r0701_player_dir_up')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_c01r0701_player_dir_left')
	_JUMP('ev_c01r0701_player_dir_right')
	_END()
ev_c01r0701_player_dir_up:
	_OBJ_ANIME('C01R0701_RIVAL', 'anm_c01r0701_rival_01')
	_OBJ_ANIME('HERO', 'anm_c01r0701_player_01')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c01r0701_player_dir')
	_END()
ev_c01r0701_player_dir_left:
	_OBJ_ANIME('C01R0701_RIVAL', 'anm_c01r0701_rival_03')
	_OBJ_ANIME('HERO', 'anm_c01r0701_player_03')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c01r0701_player_dir')
	_END()
ev_c01r0701_player_dir_right:
	_OBJ_ANIME('C01R0701_RIVAL', 'anm_c01r0701_rival_03')
	_OBJ_ANIME('HERO', 'anm_c01r0701_player_03')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c01r0701_player_dir')
	_END()
common_c01r0701_player_dir:
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C01R0701_RIVAL')
	_SE_WAIT('S_FI001')
	_LDVAL(@WK_SCENE_C01_RIVAL, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2100)
	_FLAG_SET(#FE_TOWNMAP_GET)
	_FLAG_RESET(#FV_C01_POKETCH)
	_FLAG_RESET(#FV_C01_CROWN)
	_TALK_OBJ_END()
	_TALK_END()
	_END()
anm_c01r0701_rival_01:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 4)
	_AC_DIR_D(4)
	_AC_DOWN(9, 4)
	_AC_DIR_D(4)
	_ACMD_END()
anm_c01r0701_rival_03:
	_AC_DIR_D(4)
	_AC_DOWN(4, 4)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 4)
	_AC_DIR_D(4)
	_AC_DOWN(5, 4)
	_AC_DIR_D(4)
	_ACMD_END()
anm_c01r0701_player_01:
	_AC_WAIT(8)
	_AC_DIR_R(8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_c01r0701_player_03:
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_ACMD_END()
ev_c01r0701_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0701', '54-msg_c01r0701_woman3_01', 'You just became a Trainer, did you?\rYou should look up topics that you’re not\nfamiliar with.')
	_END()
ev_c01r0701_babygirl1:
	_END()
ev_c01r0701_boy2:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_boy2_01_1', 'We learned about Pokémon types today. Umm...')
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_boy2_01_2', 'Grass is weak to Fire, Fire is weak to Water, and\nWater is weak to Grass! I think that’s how it goes!', 1)
	_TALK_CLOSE()
	_END()
ev_c01r0701_boy2a:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_boy2a_01', 'I wrote an essay in my notebook on what makes\na true Pokémon Trainer.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0701_girl1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_girl1_01', 'Pokémon are smart enough to use items\nthey’re holding.\rBut they won’t know what to do with\nhuman-made items like Potions and Antidotes.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0701_boy1:
	_END()
ev_c01r0701_boy1b:
	_END()
ev_c01r0701_trainer_boy:
	_EVENT_START()
	_TALK_OBJ_START()
	_EVENT_CAMERA_INDEX(524)
	_EVENT_CAMERA_END_WAIT()
	_IF_FLAGON_JUMP(#FE_C01R0701_ITEM_GET, 'ev_c01r0701_trainer_boy_after')
	_IF_FLAGON_JUMP(#FE_C01R0701_BOY_WIN, 'ev_c01r0701_trainer_boy_win')
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_boy_01')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0701_trainer_boy_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01r0701_trainer_boy_01_no')
	_END()
ev_c01r0701_trainer_boy_01_yes:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_boy_02')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 264)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_FLAG_SET(#FE_C01R0701_BOY_WIN)
	_IF_FLAGON_JUMP(#FE_C01R0701_GIRL_WIN, 'ev_c01r0701_trainer_boy_item_get')
	_IF_FLAGOFF_JUMP(#FE_C01R0701_GIRL_WIN, 'ev_c01r0701_trainer_boy_item_nothing')
	_END()
ev_c01r0701_trainer_boy_item_nothing:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_boy_04')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_boy_item_get:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_boy_05')
	_LDVAL(@SCWK_TEMP0, 337); Hidden power TM
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0701_trainer_boy_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C01R0701_ITEM_GET)
	_JUMP('ev_c01r0701_trainer_boy_after')
	_END()
ev_c01r0701_trainer_boy_after:
	_MACRO_TALK_KEYWAIT('dp_trainer_msg_sub', '00_msg_c01r0701_trainer_boy_06', 'A Technical Machine, or TM for short,\ncontains a Pokémon move.\rUsing a TM, you can instantly teach\nits move to a Pokémon.\rYou’ll find you receive lots of copies\nof a TM when you obtain it.\rDon’t be shy to use them!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_boy_item_event_fail:
	_CALL('ev_item_event_fail')
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0701_trainer_boy_win:
	_IF_FLAGON_JUMP(#FE_C01R0701_GIRL_WIN, 'ev_c01r0701_trainer_boy_item_get')
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_boy_04')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_boy_01_no:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_boy_03')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_girl3:
	_EVENT_START()
	_TALK_OBJ_START()
	_EVENT_CAMERA_INDEX(524)
	_EVENT_CAMERA_END_WAIT()
	_IF_FLAGON_JUMP(#FE_C01R0701_GIRL_WIN, 'ev_c01r0701_trainer_girl3_win')
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_girl3_01')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0701_trainer_girl3_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01r0701_trainer_girl3_01_no')
	_END()
ev_c01r0701_trainer_girl3_01_yes:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_girl3_02', 1)
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 267)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_FLAG_SET(#FE_C01R0701_GIRL_WIN)
	_IF_FLAGON_JUMP(#FE_C01R0701_BOY_WIN, 'ev_c01r0701_trainer_girl3_item_get')
	_IF_FLAGOFF_JUMP(#FE_C01R0701_BOY_WIN, 'ev_c01r0701_trainer_girl3_item_nothing')
	_END()
ev_c01r0701_trainer_girl3_win:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_girl3_04', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_girl3_01_no:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_girl3_03')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_girl3_item_nothing:
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_girl3_04', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_trainer_girl3_item_get:
	_IF_FLAGON_JUMP(#FE_C01R0701_ITEM_GET, 'ev_c01r0701_trainer_girl3_item_nothing')
	_TALKMSG('dp_trainer_msg_sub%54-msg_c01r0701_trainer_girl3_05', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(525)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c01r0701_board:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_01', 'The blackboard lists status changes that may\naffect Pokémon in battle.')
	_JUMP('ev_c01r0701_board_02')
	_END()
ev_c01r0701_board_02:
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_02', 'Which status would you like to read about?', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_000')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_001')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_002')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_003')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_004')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_005')
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0701_board_select_00')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01r0701_board_select_01')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c01r0701_board_select_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_c01r0701_board_select_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_c01r0701_board_select_04')
	_JUMP('ev_c01r0701_board_select_05')
	_END()
ev_c01r0701_board_select_00:
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_03', 'If a Pokémon is poisoned, it will steadily lose HP.\nThe effects of poison remain after a battle.\rHeal a poisoning using an Antidote.')
	_JUMP('ev_c01r0701_board_02')
	_END()
ev_c01r0701_board_select_01:
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_04', 'Paralysis reduces Speed and may prevent\nPokémon from using any moves.\rParalysis also lingers after battle, so use a\nParalyze Heal to clear up its nasty effects.')
	_JUMP('ev_c01r0701_board_02')
	_END()
ev_c01r0701_board_select_02:
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_05', 'If a Pokémon falls asleep, it will be unable to\nattack till it wakes.\rThe Pokémon may wake up on its own, but if\nthe battle ends first, then it will stay asleep.\rYou can wake it up using an Awakening.')
	_JUMP('ev_c01r0701_board_02')
	_END()
ev_c01r0701_board_select_03:
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_06', 'Burns lower a Pokémon’s Attack and steadily\nreduce its HP. They linger even after battle.\rYou can cure burns using a Burn Heal.')
	_JUMP('ev_c01r0701_board_02')
	_END()
ev_c01r0701_board_select_04:
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_board_07', 'If a Pokémon is frozen, it becomes\ncompletely helpless.\rIt may thaw out on its own, but if the battle\nends first, it will remain frozen afterward.\rYou can thaw it out using an Ice Heal.')
	_JUMP('ev_c01r0701_board_02')
	_END()
ev_c01r0701_board_select_05:
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c01r0701_notebook:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_notebook_01_1', 'It’s a notebook filled with writing. Let’s see...')
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_notebook_01_2', 'Pokémon are to be caught using Poké Balls.\rUp to six Pokémon can accompany a Trainer.', 1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_notebook_01_3', 'A Trainer is someone who catches Pokémon,\nraises them, and battles with them.', 1)
	_MACRO_TALKMSG('dialogue_c01r0701', '54-msg_c01r0701_notebook_01_4', 'A Trainer’s mission is to defeat the strong\nTrainers who await challengers in Pokémon Gyms.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0701_egg:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2600, 'common_c01r0701_egg')
	_MACRO_TALKMSG('dialogue_c01r0701', '18-msg_00-msg_c01r0701_egg_01', 'Well, howdy there!\nYou’re a Pokémon Trainer, aren’t you?\rHave y’all heard about the Pokémon\nDay Care in Solaceon Town?\rIt’s a place where you can ask ol’\nMa and Pa to raise your Pokémon.\rSometimes, there’s even a special\nsurprise with a Pokémon Egg!\rAs a special promotion, here’s an Egg,\njust for you!\rIt’s got a cute baby Pokémon inside.\nDo you want it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0701_egg_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01r0701_egg_no')
	_END()
ev_c01r0701_egg_yes:
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'c01r0701_egg_temoti_max'); Party and Boxes are full
	_SE_PLAY('M_FI013')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c01r0701', '00-msg_c01r0701_egg_yes', '{0,1,0,0} received a Pokémon Egg!')
	_GET_TABLE_POKE(18, @465, @SCWK_TEMP0); Table, MonsNo, FormNo (Putting this before the _ME_WAIT gives the game some time to read from the JSONs)
	_ME_WAIT()
	_ADD_TAMAGO_EXTRA(@465, @SCWK_TEMP0); MonsNo, FormNo
	_FLAG_SET(#2600)
	_JUMP('common_c01r0701_egg')
	_END()
common_c01r0701_egg:
	_MACRO_TALKMSG('dialogue_c01r0701', '00-msg_c01r0701_egg_common', 'Y’all please take good care of that\nbaby Pokémon now.\rKeep that Egg warm in your Pokémon\nparty and it’ll hatch in no time!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0701_egg_no:
	_MACRO_TALKMSG('dialogue_c01r0701', '18-msg_00-msg_c01r0701_egg_no', 'Are y’all sure you don’t want this Egg?\nThere’s something cute inside!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
c01r0701_egg_temoti_max:
	_MACRO_TALKMSG('dialogue_c01r0701', '00-msg_c01r0701_egg_temoti_max', 'Oh, y’all got too many Pokémon.\nCome back here when y’all got room.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_c01r0701_jan_1:
	_AC_DIR_L(4)
	_AC_WAIT(8)
	_AC_DIR_R(4)
	_AC_WAIT(8)
	_ACMD_END()
ev_c01r0701_jan:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2583, 'ev_c01r0701_jan_done')
	_IF_FLAGON_JUMP(#2529, 'ev_c01r0701_jan_onix')
	_IF_FLAGON_JUMP(#2531, 'ev_c01r0701_jan_item_dialogue_2')
	_IF_FLAGON_JUMP(#2530, 'ev_c01r0701_jan_item_dialogue_1')
	_MACRO_TALKMSG('dialogue_c01r0701', '00_msg_c01r0701_jan_0', 'Hey, I’m Jan!')
	_MACRO_TALK_KEYWAIT('dialogue_c01r0701', '00_msg_c01r0701_jan_1', 'I’m visiting Sinnoh looking for an Onix that\ncan survive an Ice Punch.')
	_TALK_CLOSE()
	_OBJ_ANIME('C01R0701_JAN', 'anm_c01r0701_jan_1'); Look side to side
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C01R0701_JAN', 'HERO'); Look back at the player
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C01R0701_JAN')
	_MACRO_TALK_KEYWAIT('dialogue_c01r0701', '00_msg_c01r0701_jan_2', 'I’ve heard whispers around town that this\nOnix might be nearby.\rYou should ask around for me.')
	_TALK_CLOSE()
	_FLAG_SET(#2530)
	_JUMP('ev_c01r0701_jan_item_dialogue_1')
	_END()
ev_c01r0701_jan_item_dialogue_2:
	_MACRO_TALKMSG('dialogue_c01r0701', '00_msg_c01r0701_jan_7', 'Change your mind?')
	_JUMP('ev_c01r0701_jan_item_dialogue')
ev_c01r0701_jan_item_dialogue_1:
	_MACRO_TALKMSG('dialogue_c01r0701', '00_msg_c01r0701_jan_3', 'Anyways, lemme ask you a question.\nDo you cheat?')
	_JUMP('ev_c01r0701_jan_item_dialogue')
ev_c01r0701_jan_item_dialogue:
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0701_jan_item_yes')
	_JUMP('ev_c01r0701_jan_item_no')
ev_c01r0701_jan_item_yes:
	_MACRO_TALK_KEYWAIT('dialogue_c01r0701', '00_msg_c01r0701_jan_5', 'Nice, cheating is based.')
	_LDVAL(@SCWK_TEMP0, 1293); Everlasting Candy
	_LDVAL(@SCWK_TEMP1, 99); Quantity 99
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(9, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2459); Everlasting Candy Chapter
	_FLAG_SET(#2529)
	_TALK_OBJ_END()
	_END()
ev_c01r0701_jan_item_no:
	_MACRO_TALK_KEYWAIT('dialogue_c01r0701', '00_msg_c01r0701_jan_6', 'Hey, whatever you find fun.')
	_TALK_CLOSE()
	_FLAG_SET(#2531)
	_TALK_OBJ_END()
	_END()
ev_c01r0701_jan_onix:
	_MACRO_TALKMSG('dialogue_c01r0701', '00_msg_c01r0701_jan_10', 'Any luck finding that Onix?')
	_IF_FLAGON_JUMP(#2519, 'ev_c01r0701_jan_has_onix')
