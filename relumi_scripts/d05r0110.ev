ev_d05r0110_gingam:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d05r0110', '27-msg_d05r0110_gingam_01', 'I’m hopelessly lost!\rPlease don’t pay attention to a lowly grunt\nwithout any Pokémon!')
