ev_t06r0101_oldman1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_HIIDORAN_SEE, 'ev_t06r0101_oldman1_03')
	_IF_FLAGON_JUMP(#FE_KAZANNOOKIISI_GET, 'ev_t06r0101_oldman1_02')
	_MACRO_TALKMSG('dialogue_t06r0101', '59-msg_t06r0101_oldman1_01_1', 'Let me tell you about Stark Mountain.\rThat volcano dates back to when Sinnoh was\nmade by the melding of time and space.')
	_MACRO_TALKMSG('dialogue_t06r0101', '59-msg_t06r0101_oldman1_01_2', 'Fiery lava spilled out and pooled, which then\nturned into a Pokémon.\rIt’s said that the Magma Stone was used to keep\nthe Pokémon under control.\rAccording to legend, the Pokémon transformed\nover time into the heart of the volcano itself.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t06r0101_oldman1_02:
	_MACRO_TALKMSG('dialogue_t06r0101', '59-msg_t06r0101_oldman1_02', 'You say the Magma Stone was found? Does that\nmean the legend was true?\rIf so, the Pokémon of the volcano may awaken\nand cause an eruption!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t06r0101_oldman1_03:
	_MACRO_TALKMSG('dialogue_t06r0101', '59-msg_t06r0101_oldman1_03', 'Heatran... So there really was such a Pokémon?\nDid it come to be when Sinnoh was created?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t06r0101_seven2:
	_TALK_OBJ_START()
	_FLAG_SET(#FE_D16R0103_LEGEND_UNSEAL)
	_MACRO_TALKMSG('dialogue_t06r0101', '59-msg_t06r0101_seven2_01_1', 'Gotcha, Gramps! I’ll put the Magma Stone back.')
	_MACRO_TALKMSG('dialogue_t06r0101', '59-msg_t06r0101_seven2_01_2', 'That Magma Stone was keeping the Pokémon\nof the volcano under control.\rIt’s all right, though. I can go put it back myself.')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 4, 'ev_t06r0101_seven2_out01')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 5, 'ev_t06r0101_seven2_out02')
	_OBJ_DEL('T06R0101_SEVEN2')
	_FLAG_SET(#FE_SEVEN5_CLEAR)
	_FLAG_SET(#FV_T06R0101_SEVEN2)
	_TALK_OBJ_END()
	_END()
ev_t06r0101_seven2_out01:
	_OBJ_ANIME('HERO', 'anm_t06r0101_player_01')
	_OBJ_ANIME('T06R0101_SEVEN2', 'anm_t06r0101_seven2_01')
	_OBJ_ANIME_WAIT()
	_RET()
ev_t06r0101_seven2_out02:
	_OBJ_ANIME('HERO', 'anm_t06r0101_player_02')
	_OBJ_ANIME('T06R0101_SEVEN2', 'anm_t06r0101_seven2_02')
	_OBJ_ANIME_WAIT()
	_RET()
anm_t06r0101_player_01:
	_AC_DIR_D(8)
	_ACMD_END()
anm_t06r0101_player_02:
	_AC_DIR_L(8)
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_t06r0101_seven2_01:
	_AC_DIR_D(4)
	_AC_DOWN(3, 8)
	_AC_DIR_L(4)
	_AC_LEFT(4, 8)
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_t06r0101_seven2_02:
	_AC_DIR_L(4)
	_AC_LEFT(1, 8)
	_AC_DIR_D(4)
	_AC_DOWN(3, 8)
	_AC_DIR_L(4)
	_AC_LEFT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_ACMD_END()