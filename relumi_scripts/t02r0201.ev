ev_t02r0201_oldman1a:
	_TALK_OBJ_START()
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0201_oldman1a_02')
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_oldman1a_01_1', 'Ah, so that Rowan fellow is back?')
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_oldman1a_01_2', 'He’s quite the remarkable man. He’s been\nstudying Pokémon since way, way back.\rMy son and grandchild help Rowan with his\nstudies now.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0201_oldman1a_02:
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_oldman1a_02_1', 'Oh my! You’ve got a National Pokédex?')
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_oldman1a_02_2', 'How fantastic is that?!\rRowan should be delighted. It will greatly help\nhis research.', 1)
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_oldman1a_02_3', 'But, young Trainer...you should know this.\rIn this world, there are three hundred...\nNo, four hundred... No, no, no! There’re a lot\fmore kinds of Pokémon than that!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0201_babygirl:
	_TALK_OBJ_START()
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0201_babygirl_02')
	_JUMP('ev_t02r0201_babygirl_90')
	_JUMP('ev_t02r0201_babygirl_90')
ev_t02r0201_babygirl_90:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 't02r0201_player_male_01')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 't02r0201_player_female_01')
	_END()
t02r0201_player_male_01:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_01_1', 'Who are you?\r...\rOh... You’re {0,1,0,0}?')
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_01_2', 'Hey, you’re doing that Pokédex thingy for\nthe professor!\rWow! That’s the same as my big sister! Go for it!', 1)
	_JUMP('common_t02r0201_player_01')
	_JUMP('common_t02r0201_player_01')
t02r0201_player_female_01:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_02_1', 'Who are you?\r...\rOh... You’re {0,1,0,0}?')
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_02_2', 'You’re doing that Pokédex thingy for\nthe professor!\rWow! That’s the same as my big brother!\nGo for it!', 1)
	_JUMP('common_t02r0201_player_01')
	_JUMP('common_t02r0201_player_01')
common_t02r0201_player_01:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0201_babygirl_02:
	_IF_FLAGOFF_JUMP($SYS_FLAG_GAME_CLEAR, 'ev_t02r0201_babygirl_90')
	_IF_FLAGON_JUMP(#FE_GENERATE_START, 'ev_t02r0201_babygirl_02_start')
	_FLAG_SET(#FE_GENERATE_START)
	_START_GENERATE()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_03_1', 'Oh, hi, {0,1,0,0}!\rThere was news on TV saying there is a massive\noutbreak of Pokémon!')
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_03_2', 'That’d be great for filling up your Pokédex!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0201_babygirl_02_start:
	_PLAYER_NAME(0)
	_GENERATE_INFO_GET(@LOCALWORK1, @LOCALWORK0)
	_ZONE_NAME2(1, @LOCALWORK1)
	_POKEMON_NAME_EXTRA(2, @LOCALWORK0, 'PM_MALE', 1)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 't02r0201_player_male_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 't02r0201_player_female_02')
	_END()
t02r0201_player_male_02:
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_04', 'Let me see... What did that news say now...?\r{1,1,5,0}! They said there’s\na whole bunch of {2,1,1,0} there!\r{0,1,0,0}, you have to hurry!\rI want you to do better than my sister Dawn!')
	_JUMP('common_t02r0201_player_02')
	_JUMP('common_t02r0201_player_02')
t02r0201_player_female_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0201', '17-msg_t02r0201_babygirl_05', 'Let me see... What did that news say now...?\r{1,1,5,0}! They said there’s\na whole bunch of {2,1,1,0} there!\r{0,1,0,0}, you have to hurry!\rI want you to do better than my brother Lucas!')
	_JUMP('common_t02r0201_player_02')
	_JUMP('common_t02r0201_player_02')
common_t02r0201_player_02:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()