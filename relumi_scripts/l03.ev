ev_l03_init_change:
	_IF_FLAGOFF_JUMP(#FE_D27R0102_GKANBU_WIN, 'ev_l03_door_exit_move_1')
	_IF_FLAGON_JUMP(#FE_D27R0102_GKANBU_WIN, 'ev_l03_door_exit_move_2')
	_END()
ev_l03_door_exit_move_1:
	_SXY_EXIT_POS_CHANGE(2, 308, 225)
	_SXY_EXIT_POS_CHANGE(3, 309, 225)
	_END()
ev_l03_door_exit_move_2:
	_SXY_EXIT_POS_CHANGE(0, 308, 225)
	_SXY_EXIT_POS_CHANGE(1, 309, 225)
	_END()
ev_l03_sign1:
	_EASY_BOARD_MSG('dialogue_l03%198-msg_l03_sign1_01', 'BOARD_TYPE_ROAD', 0, 3)
	_END()
pos_lo3_rival:
	_EVENT_START()
	;Camera move up
	_EVENT_CAMERA_INDEX(140)
	_EVENT_CAMERA_END_WAIT()
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_l03', 'msg_l03_rival_01', 'Hey, {1}!\nWhat, you finally come along now?\fSlooow! Way too slow!\rListen, {1}.\nSee how the rocks are all lumpy here?\rYou can’t climb those rocks until you\nget the Snowpoint Gym Badge.\rAnyway, I’m off.\nTeam Galactic! I’m coming for you!')
	_TALK_CLOSE()
	_OBJ_ANIME('L03_RIVAL', 'anm_l03_rival')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('L03_RIVAL')
	_FLAG_SET(#3068)
	_LDVAL(@519, 1)
	;Camera move down/back to normal
	_EVENT_CAMERA_INDEX(141)
	_EVENT_CAMERA_END_WAIT()
	_EVENT_END()
	_END()
anm_l03_rival:
	_AC_DIR_U(8)
	_AC_UP(3, 8)
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()