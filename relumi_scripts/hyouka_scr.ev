ev_doctor_zukan_hyouka:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_hyouka_scr', '16-msg_hyouka_doctor_01', 'Ah, {0,1,0,0}!\rYou’ve come to show me your progress on\nthe Pokédex?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_doctor_zukan_hyouka')
	_JUMP('yes_doctor_zukan_hyouka')
	_END()
no_doctor_zukan_hyouka:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '16-msg_hyouka_doctor_03', 'What’s wrong? You’re not going to tell me\nyou’ve seen too few to bother showing me?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_RET()
	_END()
yes_doctor_zukan_hyouka:
	_CALL('ev_zukan_shinou_mode')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_RET()
	_END()
ev_ookido_zukan_hyouka:
	_PLAYER_NAME(0)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_ookido_zukan_hyouka_male')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_ookido_zukan_hyouka_female')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_ookido_zukan_hyouka')
	_JUMP('yes_ookido_zukan_hyouka')
	_END()
ev_ookido_zukan_hyouka_male:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_ookido_04', 'Ah, {0,1,0,0}!\rYou’ve come to show me how your Pokédex is\ncoming along?')
	_RET()
ev_ookido_zukan_hyouka_female:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_ookido_07', 'Ah, {0,1,0,0}!\rYou’ve come to show me how your Pokédex is\ncoming along?')
	_RET()
no_ookido_zukan_hyouka:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_ookido_06', 'I see...\rCome see me if you’d like me to have a look at\nyour Pokédex.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_RET()
	_END()
yes_ookido_zukan_hyouka:
	_CALL('ev_zukan_zenkoku_mode')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_RET()
	_END()
ev_pc_zukan_hyouka:
	_CALL('ev_pc_zukan_hyouka_sub')
	_RET()
	_END()
ev_pc_zukan_hyouka_sub:
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_zukan_shinou_mode_sub')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_zukan_zenkoku_mode_sub')
	_RET()
	_END()
ev_zukan_shinou_mode_sub:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_pc_on_05', 'You accessed Professor Rowan’s PC.')
	_JUMP('ev_zukan_shinou_mode')
	_JUMP('ev_zukan_shinou_mode')
ev_zukan_zenkoku_mode_sub:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_pc_on_06', 'You accessed Professor Oak’s PC.')
	_JUMP('ev_zukan_zenkoku_mode')
	_JUMP('ev_zukan_shinou_mode')
ev_zukan_shinou_mode:
	_IF_FLAGOFF_JUMP($FLAG_ARRIVE_C04, 'ev_zukan_shinou_mode_hyouka')
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_zukan_shinou_comp_fix')
	_JUMP('ev_zukan_shinou_mode_hyouka')
	_END()
ev_zukan_shinou_mode_hyouka:
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_zukan_shinou_comp')
	_SHINOU_ZUKAN_SEE_NUM(@SCWK_TEMP0)
	_NUMBER_NAME(0, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_hyouka_scr', '16-msg_hyouka_doctor_02', 'Hmm...\rSo, you’ve seen {0,2,2,0} Pokémon.')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 14, 'ev_zukan_shinou_hyouka_1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 24, 'ev_zukan_shinou_hyouka_2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 39, 'ev_zukan_shinou_hyouka_3')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 59, 'ev_zukan_shinou_hyouka_4')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 89, 'ev_zukan_shinou_hyouka_5')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 114, 'ev_zukan_shinou_hyouka_6')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 134, 'ev_zukan_shinou_hyouka_7')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 144, 'ev_zukan_shinou_hyouka_8')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 149, 'ev_zukan_shinou_hyouka_9')
	_TALK_CLOSE()
	_RET()
	_END()
ev_zukan_shinou_hyouka_end:
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_RET()
	_END()
ev_zukan_shinou_hyouka_1:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s00', 'Look harder for wild Pokémon.\rDon’t be afraid of going into tall grass.')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_2:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s01', 'Your pace is picking up. Things can only\nget better!')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_3:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s02', 'Be persistent when you’re searching for Pokémon\nthat appear only in certain places.')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_4:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s03', 'Pokémon aren’t hiding only in tall grass. You can\nfind many others in caves and seas.')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_5:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s04', 'Your Pokédex is looking more and\nmore respectable!')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_6:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s05', 'Are you fishing with rods? Pokémon that live\nunderwater need to be caught by fishing.')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_7:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s06', 'The Trainers that challenge you to battle have\nPokémon, obviously.\rThey may have rare ones with them, and that can\nadd to your Pokédex.')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_8:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s07', 'Your Pokédex is well on the way to being\nfilled up.\rThis Pokédex can be considered a journal of\nyour adventure.')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_hyouka_9:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_s08', 'You’re not far from seeing every Pokémon there\nis to see in Sinnoh!')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_comp:
	_SHINOU_ZUKAN_SEE_NUM(@SCWK_TEMP0)
	_NUMBER_NAME(0, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_hyouka_scr', '16-msg_hyouka_doctor_02', 'Hmm...\rSo, you’ve seen {0,2,2,0} Pokémon.')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_doctor_08', 'I see!\rYou’ve met all the Pokémon there are in Sinnoh!')
	_JUMP('ev_zukan_shinou_hyouka_end')
	_END()
ev_zukan_shinou_comp_fix:
	_SHINOU_ZUKAN_SEE_NUM(@SCWK_TEMP0)
	_NUMBER_NAME(0, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_hyouka_scr', '16-msg_hyouka_doctor_02', 'Hmm...\rSo, you’ve seen {0,2,2,0} Pokémon.')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_doctor_07', 'I see!\rYou’ve met all the Pokémon there are in Sinnoh!\r{0,1,0,0}, I need to see you at my lab.\nI’ll be waiting!')
	_TALK_CLOSE()
	_FLAG_SET(#FE_PC_SHINOU_ZUKAN_COMP)
	_RET()
ev_zukan_zenkoku_mode:
	_ZENKOKU_ZUKAN_GET_NUM(@SCWK_TEMP0)
	_GET_MY_SEX(@SCWK_TEMP1)
	_NUMBER_NAME(0, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_ookido_05', 'Hmhm... You’ve caught {0,2,2,0} so far...')
	_PLAYER_NAME(0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 39, 'ev_zukan_zenkoku_hyouka_1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 59, 'ev_zukan_zenkoku_hyouka_2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 89, 'ev_zukan_zenkoku_hyouka_3')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 119, 'ev_zukan_zenkoku_hyouka_4')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 149, 'ev_zukan_zenkoku_hyouka_5')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 189, 'ev_zukan_zenkoku_hyouka_6')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 229, 'ev_zukan_zenkoku_hyouka_7')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 269, 'ev_zukan_zenkoku_hyouka_8')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 309, 'ev_zukan_zenkoku_hyouka_9')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 349, 'ev_zukan_zenkoku_hyouka_10')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 379, 'ev_zukan_zenkoku_hyouka_11')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 409, 'ev_zukan_zenkoku_hyouka_12')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 429, 'ev_zukan_zenkoku_hyouka_13')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 449, 'ev_zukan_zenkoku_hyouka_14')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 459, 'ev_zukan_zenkoku_hyouka_15')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 469, 'ev_zukan_zenkoku_hyouka_16')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 475, 'ev_zukan_zenkoku_hyouka_17')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 483, 'ev_zukan_zenkoku_hyouka_18')
	_IFVAL_JUMP(@SCWK_TEMP0, 'LE', 493, 'ev_zukan_zenkoku_hyouka_19')
	_IFVAL_JUMP(@SCWK_TEMP0, 'GT', 493, 'ev_zukan_zenkoku_hyouka_19')
	_END()
ev_zukan_zenkoku_end:
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_RET()
	_END()
ev_zukan_zenkoku_hyouka_1:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z00', 'They say there are at least four hundred species\nof Pokémon nationwide.\rIf you’re planning to catch them all, you’d better\nbe a committed Trainer.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_2:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z01', 'Hm! Little by little, you’re filling the Pokédex\nwith complete data on Pokémon you’ve gotten.\rKeep up the good work!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_3:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z02', 'Here’s a tip on catching Pokémon in the wild.\rMinimize their HP before you throw out your\nPoké Ball to catch ’em.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_4:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z03', 'Remember: If you can’t catch them, you can\nalways trade for them.\rAs soon as you trade, the Pokémon’s data is\nadded to the Pokédex.\rThat’s why you should seek out as many trades\nas possible.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_5:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z04', 'Have you visited the Great Marsh?\rSome Pokémon only appear in places such\nas that.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_6:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z05', 'As you know, there are Pokémon that\neventually evolve.\rThat’s an important thing to consider when\nyou’re filling your Pokédex.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_7:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z06', 'You’ve proven yourself capable. There’s nothing\nto worry about.\rKeep catching Pokémon the way you’ve been\ndoing so far.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_8:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z07', 'Are you aware that there is more than one style\nof Evolution?\rThere are some Pokémon that evolve by\nbecoming friends with the Trainer.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_9:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z08', 'Apparently, there are some Pokémon that appear\nin swarms on occasion.\rDon’t miss out on these massive outbreaks\nof Pokémon!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_10:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z09', 'Amazing! You’ve already gotten over three\nhundred Pokémon!\rThat’s already a major achievement, but I know\nyou’re capable of more!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_11:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z10', 'Some wild Pokémon only appear during certain\ntimes of the day.\rYou’ll need to look for Pokémon around\nthe clock.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_12:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z11_1', 'I’ve been getting reports of different Pokémon\nsightings in places like the Grand Underground.\rBy “different,” I mean Pokémon that aren’t native\nto the Sinnoh region.')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z11_2', 'You should perhaps go back to areas you’ve\nalready scoured.\rYou may end up seeing Pokémon that weren’t\nthere before.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_13:
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 1, 'ev_zukan_zenkoku_hyouka_13_b')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z12', '{0,1,0,0}, have you visited Renegade\nPark recently?\rThere still may be Pokémon that are rarely seen\nin Sinnoh.', 0, 1)
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_13_b:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z19', '{0,1,0,0}, have you visited Renegade\nPark recently?\rThere still may be Pokémon that are rarely seen\nin Sinnoh.', 0, 1)
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_14:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z13', 'Hm! Your Pokédex is getting closer\nto completion.\rHave you ever considered a career as a\nPokémon Professor?')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_15:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z14', 'Hmm... You’ve caught quite the impressive\ncollection of Pokémon.\rYou’ve obviously had to employ many means to\nseek them all out.\rKeep an eye out for rustling tall grass, and search\nit thoroughly.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_16:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z15', 'I can only marvel at the diversity of Pokémon.\nI’m still very much in awe of them.')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_17:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z16', 'Good, good. You’re getting close to completing\nthe Pokédex.\rI’m looking forward to seeing its completion.\rWhen that happens, your views about Pokémon\nwill likely have changed!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_18:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z17', 'Hmm... You are so very close to completing\nyour Pokédex.\rThink about what’s missing. Recall what\nyou’ve overlooked.\rYou’re so close—please finish the Pokédex!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_19:
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 1, 'ev_zukan_zenkoku_hyouka_19_b')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z18_1', '{0,1,0,0}! You’ve finally done it!\nYou’ve finally completed the National Pokédex!')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z18_2', 'This is better than meeting any exotic Pokémon\nfor the first time!\rI feel blessed to have become friends with a\nTrainer like you!')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z18_3', 'Sincerely, I thank you from the bottom of\nmy heart!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()
ev_zukan_zenkoku_hyouka_19_b:
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z20_1', '{0,1,0,0}! You’ve finally done it!\rYou’ve finally completed the National Pokédex!')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z20_2', 'This is better than meeting any exotic Pokémon\nfor the first time!\rI feel blessed to have become friends with a\nTrainer like you!')
	_MACRO_TALKMSG('dialogue_hyouka_scr', '92-msg_hyouka_z20_3', 'Sincerely, I thank you from the bottom of\nmy heart!')
	_JUMP('ev_zukan_zenkoku_end')
	_END()