ev_r213r0501_clown:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_WAZAMASIN92_GET, 'ev_r213r0501_clown_02')
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_clown_01', 'We’re a traveling troupe of street performers.\rIn place of a formal introduction, please,\ntake this!')
	_LDVAL(@SCWK_TEMP0, 419)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213r0501_clown_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_WAZAMASIN92_GET)
	_JUMP('ev_r213r0501_clown_02')
	_JUMP('ev_r213r0501_clown_02')
ev_r213r0501_clown_02:
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_clown_02', 'Trick Room is a doozy of a weird move—\nuse it, and for a while afterward, the slowest\fPokémon get to use their attack first! Bam!\rHow you use Trick Room is up to you, Trainer.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0501_clown_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0501_mystery:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_R213R0501_MYSTERY_TALK, 'ev_r213r0501_mystery_06')
	_FLAG_SET(#FE_R213R0501_MYSTERY_TALK)
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_mystery_01', 'Let me gaze into your eyes...\nI will read your fortune...\r...')
	_GET_RND(@SCWK_ANSWER, 10)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213r0501_mystery_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r213r0501_mystery_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_r213r0501_mystery_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_r213r0501_mystery_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_r213r0501_mystery_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 5, 'ev_r213r0501_mystery_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 6, 'ev_r213r0501_mystery_03')
	_JUMP('ev_r213r0501_mystery_05')
	_JUMP('ev_r213r0501_mystery_02')
ev_r213r0501_mystery_02:
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_mystery_02', 'A magical encounter is in the winds...\rThough I cannot tell whether it will be with a\nPokémon or a Trainer...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0501_mystery_03:
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_mystery_03', 'A brief occasion of joy is imminent...\rBut remember this: the good and the bad are on\nopposite sides of a coin...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0501_mystery_05:
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_mystery_05', 'Destiny shall shift...\rWhether that bodes well or ill is beyond the\nscope of my sight...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0501_mystery_06:
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_mystery_06_1', 'Many are the eyes that I have gazed into over\nthe years, be they human or Pokémon...')
	_MACRO_TALKMSG('dialogue_r213r0501', '149-msg_r213r0501_mystery_06_2', 'But your eyes swirl with compassion, strength,\njoy, sorrow, and more...\rThe ever-shifting colors in your eyes make you\ndifficult to read.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0501_man2:
	_MACRO_EASY_OBJ_MSG('dialogue_r213r0501', '149-msg_r213r0501_man2_01', 'Me, I’m just a simple soul. I let my guitar do all\nmy talking. All I need is music and Pokémon.\rI can shine wherever I go if I have those things\nin my life.')
	_END()