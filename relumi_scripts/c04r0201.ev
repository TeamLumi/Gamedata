ev_c04r0201_flag_change:
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 5200, 'ev_c04r0201_guide_upd')
	_IF_FLAGOFF_JUMP(#1932, 'ev_c04r0201_looker_1')
	_END()
ev_c04r0201_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 5250)
	_RET()
ev_c04r0201_looker_1:
	_TIME_WAIT(10, @SCWK_ANSWER)
	_EVENT_START()
	_OBJ_ANIME('C04R0201_LOOKER', 'anm_c04r0201_looker_100')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c04r0201_hero_100')
	_OBJ_ANIME_WAIT()
	_AYOU_NAME(0)
	_MACRO_TALKMSG('dialogue_c04r0201', 'msg_c04r0201_looker_01', 'Hello, {0,1,0,0}! It is me! Me! Hahaha!\nI have startled you, yes?\rI am, after all, an officer of the\nInternational Police.\rIt is only natural that I be a master of\ndisguise.')
	_TALK_CLOSE()
	_OBJ_ANIME('C04R0201_LOOKER', 'anm_c04r0201_looker_101')
	_OBJ_ANIME_WAIT()
	_OBJ_ADD('C04R0201_LOOKER_HIDDEN')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c04r0201', 'msg_c04r0201_looker_02', '...Incidentally, you are a first-rate Trainer.\nOf that, I am very aware.\rI therefore think you will be OK, but I must\nwarn you to be careful anyway.')
	_MACRO_TALKMSG('dialogue_c04r0201', 'msg_c04r0201_looker_03', 'Also, a word of advice.\rThis building, it has two stairs.\nOne of them, a trap it must be.\rBut the crooks of Team Galactic, they do not\nappear, how shall I say, smart.\rThere should be an easy way to tell the stairs\napart!')
	_TALK_CLOSE()
	_OBJ_ANIME('C04R0201_LOOKER_HIDDEN', 'anm_c04r0201_looker_101')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C04R0201_LOOKER', 'anm_c04r0201_looker_102')
	_OBJ_ANIME_WAIT()
	_FLAG_SET(#1932)
	_EVENT_END()
	_END()
ev_c04r0201_gingam_a:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0201', '5-msg_c04r0201_gingam_a_01', 'Welcome to Team Galactic. Are you here to\ndonate your Pokémon?\rWhat? You’re not? Then kindly get off\nour property!\rDo we have to bring the pain like we did with\nthe Cycle Shop manager?')
	_END()
ev_c04r0201_gingam_b:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04r0201', '5-msg_c04r0201_gingam_b_01', 'As a group, Team Galactic has its sights set on\nthe stars, not on this world!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0201_looker_2:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04r0201', 'msg_c04r0201_looker_04', 'Now, I have been conducting my investigation\ninto Team Galactic.\rBut I have no clue as to who they are or what\nthey wish to do.\rThe minions, they appear ignorant of the\nintentions of their boss.')
	_MACRO_TALKMSG('dialogue_c04r0201', 'msg_c04r0201_looker_03', 'Also, a word of advice.\rThis building, it has two stairs.\nOne of them, a trap it must be.\rBut the crooks of Team Galactic, they do not\nappear, how shall I say, smart.\rThere should be an easy way to tell the stairs\napart!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0201_door:
	_ITEM_CHK(467, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04r0201_door_end')
	_IF_FLAGOFF_JUMP(#FE_C04R0204_WIN, 'ev_c04r0201_door_end')
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_ITEM_NAME(1, 467, 1)
	_TALKMSG('dlp_rotom_message%msg_01_rotomnote_19')
	_TALK_CLOSE()
	_SE_PLAY('S_FI230')
	_WHITE_OUT()
	_FADE_WAIT()
	_OBJ_DEL('C04R0201_ROTOMU_WALL')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_SE_WAIT('S_FI230')
	_WHITE_IN()
	_FADE_WAIT()
	_TALKMSG('dlp_rotom_message%msg_01_rotomnote_20')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0201_door_end:
	_END()
ev_c04r0201_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0201', 'msg_c04r0201_poster_01', 'The path you chose leads to glory.')
	_END()
anm_c04r0201_hero_100:
	_AC_DIR_R(4)
	_ACMD_END()
anm_c04r0201_looker_100:
	_AC_DIR_L(8)
	_AC_WAIT(4)
	_AC_MARK_GYOE()
	_AC_WAIT(16)
	_AC_LEFT(2, 8)
	_ACMD_END()
anm_c04r0201_looker_101:
	_AC_DIR_D(4)
	_AC_DIR_R(4)
	_AC_DIR_U(4)
	_AC_DIR_L(4)
	_AC_VANISH_ON()
	_ACMD_END()
anm_c04r0201_looker_102:
	_AC_VANISH_OFF()
	_ACMD_END()