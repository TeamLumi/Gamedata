ev_t04r0301_sunglasses:; Solaceon News Room Pokemon Fetch
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_T04R0301_ITEM_DEPOSIT, 'ev_t04r0301_sunglasses_item_chk')
	_IF_FLAGON_JUMP(#TMFLG_T04R0301_NEWS_END, 'ev_t04r0301_sunglasses_11')
	_IF_FLAGOFF_JUMP(#FE_T04R0301_SUNGLASSES_TALK, 'ev_t04r0301_sunglasses_01')
	_IFVAL_JUMP(@WK_SCENE_NEWS_MONSNO, 'EQ', 0, 'ev_t04r0301_sunglasses_02')
	_JUMP('ev_t04r0301_sunglasses_04')
	_END()
ev_t04r0301_sunglasses_01:
	_FLAG_SET(#FE_T04R0301_SUNGLASSES_TALK)
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_01_1', 'Oh? Welcome!\rYou saw the notice outside about us hiring, right?')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_01_2', 'Is that a Pokédex there? Then you must know\nProfessor Rowan!\rYou’re just the Pokémon-searching expert we’ve\nbeen looking for!')
	_JUMP('ev_t04r0301_sunglasses_03')
	_END()
ev_t04r0301_sunglasses_02:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_02', 'Here you are! Good! We’ve got a deadline to\nmeet. Here’s your assignment.')
	_JUMP('ev_t04r0301_sunglasses_03')
	_END()
ev_t04r0301_sunglasses_03:
	_GET_NEWS_POKE_NO(@SCWK_ANSWER)
	_LDVAL(@WK_SCENE_NEWS_MONSNO, @SCWK_ANSWER)
	_FLAG_SET(#TMFLG_T04R0301_NEWS_ONEDAY)
	_POKEMON_NAME_EXTRA(0, @WK_SCENE_NEWS_MONSNO, 0, 0)
	_TALKMSG('dialogue_t04r0301%68-msg_t04r0301_sunglasses_03_1')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_03_2', 'Remember, it has to be today—before the date\nrolls over!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_sunglasses_04:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_04', 'What’s up? Did you bring us the Pokémon\nwe needed?')
	_IF_FLAGOFF_JUMP(#TMFLG_T04R0301_NEWS_ONEDAY, 'ev_t04r0301_sunglasses_10')
	_TEMOTI_BOX_POKE_CHK(@SCWK_ANSWER, @WK_SCENE_NEWS_MONSNO)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t04r0301_sunglasses_09')
	_JUMP('ev_t04r0301_sunglasses_05')
	_END()
ev_t04r0301_sunglasses_05:
	_POKEMON_NAME_EXTRA(0, @WK_SCENE_NEWS_MONSNO, 0, 0)
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_05_1', 'Oh! Ohh! Ohhh! That’s it! {0,1,1,0}!\nThanks! Let me get a closer look!')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_05_2', '...I see, hmhm... Right, right... That’s it!\rThank you! I can write a great article now!')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_05_3', 'This is for your trouble. It’s not much, but thanks!')
	_GET_RND(@SCWK_ANSWER, 12)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_t04r0301_item_01_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_t04r0301_item_02_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_t04r0301_item_03_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_t04r0301_item_04_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 4, 'ev_t04r0301_item_05_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 5, 'ev_t04r0301_item_06_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 6, 'ev_t04r0301_item_07_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 7, 'ev_t04r0301_item_08_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 8, 'ev_t04r0301_item_09_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 9, 'ev_t04r0301_item_10_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 10, 'ev_t04r0301_item_11_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 11, 'ev_t04r0301_item_12_set')
	_LDVAL(@SCWK_TEMP1, 3)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'ev_t04r0301_sunglasses_06')
	_FLAG_SET(#TMFLG_T04R0301_NEWS_END)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t04r0301_sunglasses_07')
	_END()
ev_t04r0301_item_01_set:
	_LDVAL(@SCWK_TEMP0, 2)
	_RET()
ev_t04r0301_item_02_set:
	_LDVAL(@SCWK_TEMP0, 3)
	_RET()
ev_t04r0301_item_03_set:
	_LDVAL(@SCWK_TEMP0, 4)
	_RET()
ev_t04r0301_item_04_set:
	_LDVAL(@SCWK_TEMP0, 6)
	_RET()
ev_t04r0301_item_05_set:
	_LDVAL(@SCWK_TEMP0, 7)
	_RET()
ev_t04r0301_item_06_set:
	_LDVAL(@SCWK_TEMP0, 8)
	_RET()
ev_t04r0301_item_07_set:
	_LDVAL(@SCWK_TEMP0, 9)
	_RET()
ev_t04r0301_item_08_set:
	_LDVAL(@SCWK_TEMP0, 10)
	_RET()
ev_t04r0301_item_09_set:
	_LDVAL(@SCWK_TEMP0, 11)
	_RET()
ev_t04r0301_item_10_set:
	_LDVAL(@SCWK_TEMP0, 13)
	_RET()
ev_t04r0301_item_11_set:
	_LDVAL(@SCWK_TEMP0, 14)
	_RET()
ev_t04r0301_item_12_set:
	_LDVAL(@SCWK_TEMP0, 15)
	_RET()
ev_t04r0301_sunglasses_06:
	_CALL('ev_item_event')
	_FLAG_RESET(#FE_T04R0301_ITEM_DEPOSIT)
	_LDVAL(@WK_SCENE_NEWS_MONSNO, 0)
	_FLAG_SET(#TMFLG_T04R0301_NEWS_END)
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_06', 'You really came through for us! I hope you’ll help\nus again tomorrow!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_sunglasses_item_chk:
	_LDVAL(@SCWK_TEMP0, @WK_SCENE_T04R0301_RE_ITEM)
	_LDVAL(@SCWK_TEMP1, 3)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t04r0301_sunglasses_07')
	_JUMP('ev_t04r0301_sunglasses_08')
	_END()
ev_t04r0301_sunglasses_07:
	_LDVAL(@WK_SCENE_T04R0301_RE_ITEM, @SCWK_TEMP0)
	_FLAG_SET(#FE_T04R0301_ITEM_DEPOSIT)
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_07', 'Whoops! What’s all this? Your Bag is stuffed full.\nI’ll hold on to these until next time.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_sunglasses_08:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_08', 'Oh, there you are! Here’s your reward for the last\nassignment! It’s not much, but thanks!')
	_FLAG_RESET(#FE_T04R0301_ITEM_DEPOSIT)
	_LDVAL(@WK_SCENE_NEWS_MONSNO, 0)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_sunglasses_09:
	_POKEMON_NAME_EXTRA(0, @WK_SCENE_NEWS_MONSNO, 0, 0)
	_POKEMON_NAME_EXTRA(1, @WK_SCENE_NEWS_MONSNO, 0, 0)
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_09', 'What’s wrong? You still haven’t caught the\n{0,1,1,0} we need?\rWe’re counting on you to come through for us!\rBring us the {0,1,1,0} before the date\nrolls over!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_sunglasses_10:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_10', 'Now, now! You failed to bring me the Pokémon I\nasked for...\rThings like that can happen, but we need you to\ncome up big for us!')
	_LDVAL(@WK_SCENE_NEWS_MONSNO, 0)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_sunglasses_11:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_t04r0301_sunglasses_11', 'OK! I’ll crank out a riveting story based on this!\rOh, right! I’ll have another assignment for\nyou tomorrow!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t04r0301_man1:
	_MACRO_EASY_OBJ_MSG('dialogue_t04r0301', '68-msg_t04r0301_man1_01', 'The Sinnoh region’s newspaper is tiny, but it has\nmany fans. That newspaper is printed right here!')
	_END()
ev_t04r0301_ball_guide_01:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_01', '“Weekly Poké Ball Roundup” is the top story.\nIt’s a feature article on new types of Poké Balls.')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_02', 'Which article would you like to read?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_264', 0)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_265', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_266', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_267', 3)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_press_paso_00')
	_CASE_JUMP(1, 'ev_press_paso_01')
	_CASE_JUMP(2, 'ev_press_paso_02')
	_JUMP('ev_press_paso_cancel')
	_END()
ev_press_paso_00:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_03_1', 'Dark caves and streets unlit at night are\nforbidding places to go.\rIf you’re threatened by the dark, a supply of\nDusk Balls is your biggest ally!')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_03_2', 'Use them in the dark for the best Pokémon-\ncatching performance!\rKeep the dark at bay on your travels with\nDusk Balls!')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_press_paso_01:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_04_1', 'Catching Pokémon is best accomplished by\nwhittling the target’s HP down as low as possible,\fthen throwing a Poké Ball.')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_04_2', 'But a Pokémon caught like that probably\nshouldn’t be used in battle right away.\rThat’s where the Heal Ball comes in handy.')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_04_3', 'It doesn’t matter if you lower the target’s HP bar\nto red, put the target to sleep, or paralyze it—\fthe Heal Ball will instantly heal whatever ails the\fPokémon it catches!\rThat’s the Pokémon-friendly Heal Ball! Please,\ndo give it a try!')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_press_paso_02:
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_05_1', 'When attempting to catch a Pokémon, you want\nto cut the target’s HP.\rBut a fleet-footed Pokémon could bolt if you\ntake too much time.')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_05_2', 'The Quick Ball is the solution to that dilemma.')
	_MACRO_TALKMSG('dialogue_t04r0301', '68-msg_ball_guide_05_3', 'It’s designed to work best when thrown right at\nthe start of battle! The Quick Ball: the perfect\fgift for the impatient Trainer!')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_press_paso_cancel:
	_TALK_CLOSE()
	_TALK_END()
	_END()