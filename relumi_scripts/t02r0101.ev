ev_t02r0201_script_15:
	_TALK_OBJ_START()
	_FLAG_RESET(#352)
	_FLAG_SET(#2539)
	_OBJ_ADD('T02R0101_SUPPORT_2')
	_OBJ_POS_CHANGE_WORLD('T02R0101_DOCTOR', 7, 0, 14)
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_doctor_1_1')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_msg_51', '{0}!\nYou’ve come back!\rYou... You leave me speechless!\rYou’ve done it!\nYou really have done it!\rNever has my heart pounded this hard\nfor so long in my 60 years of living!')
	_TALK_CLOSE()
	_OBJ_ANIME('T02R0101_SUPPORT_2', 'anm_t02r0101_action_4')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('T02R0101_SUPPORT_2', 'HERO')
	_CHARA_LOOK_RELEASE('T02R0101_SUPPORT_2')
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t02r0201_func_12')
	_JUMP('ev_t02r0201_func_13')
ev_t02r0201_func_12:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_msg_52', 'The professor did a lot of\nchecking up after you left.\rHe was really worried about you,\n{0,1,0,0}...\rHe contacted acquaintances looking for\nhelp, and...\r{0,1,0,0}, I’m glad to see you safe!\nWelcome back!')
	_JUMP('ev_t02r0101_doctor_post_distortion')
ev_t02r0201_func_13:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_msg_53', 'After you left, the professor\ndid a lot of checking around.\rHe got really worried about you,\n{0,1,0,0}.\rHe got in touch with people he knows\nto rustle up help...\rYou didn’t need it, {0,1,0,0}.\nI’m glad to see you back safe, too.')
	_JUMP('ev_t02r0101_doctor_post_distortion')
ev_t02r0101_doctor_zukan_zenkoku:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_08', 'The world is immense. There are many\nmore Pokémon.\rThat means there are many more thrills for you to\nseek and enjoy!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
	_RET()
