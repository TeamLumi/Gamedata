ev_t02r0101_flag_change:
	_INVISIBLE_OBJ_PROP('T02R0101_DOCTOR', 'fc2003_01_bagskin')
	_FLAG_SET(#2855)
	_OBJ_DEL('T02R0101_SUPPORT_2')
	_FLAG_RESET(#2539)
	_OBJ_POS_CHANGE_WORLD('T02R0101_DOCTOR', 7, 0, 5)
	_IF_FLAGOFF_JUMP(#2780, 'ev_t02r0101_distortion_world_scene_trigger')
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_not_dendou')
	_END()
ev_t02r0101_disable_support:
	_RET()
ev_t02r0101_distortion_world_scene_trigger:
	_IFVAL_JUMP(@WK_SCENE_D05R0114, 'EQ', 4, 'ev_t02r0201_script_15')
	_END()
ev_t02r0101_not_dendou:
	_IF_FLAGON_CALL($SYS_FLAG_GAME_CLEAR, 'ev_t02r0101_not_hyouta')
	_END()
ev_t02r0101_not_hyouta:
	_IFVAL_JUMP(@WK_SCENE_T02, 'EQ', 2, 'common_t02r0101_zenkoku_zukan_open')
	_END()
ev_t02r0101_doctor:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2539, 'ev_t02r0101_rowan_player_back')
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_doctor_zukan_zenkoku')
	_IF_FLAGOFF_JUMP($FLAG_ARRIVE_C04, 'ev_t02r0101_doctor_01')
	_ZUKAN_CHK_SHINOU(@LOCALWORK17)
	_IFVAL_JUMP(@LOCALWORK17, 'EQ', 1, 'ev_t02r0101_doctor_zukan_shinou_comp')
	_JUMP('ev_t02r0101_doctor_01')
	_TALK_OBJ_END()
	_END()
ev_t02r0101_doctor_01:
	_IFVAL_JUMP(@WK_SCENE_T02, 'GE', 2, 'ev_t02r0101_doctor_zukan_hyouka')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_13', 'Go on!\r{0,1,0,0}, your grand adventure\nawaits you!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_doctor_zukan_hyouka:
	_CALL('ev_doctor_zukan_hyouka')
	_END()
ev_t02r0101_support:
	_END()
ev_t02r0101_doctor_zukan:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(51)
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_01_t02r0101_support_01')
	_OBJ_ANIME('HERO', 'anm_01_t02r0101_player_01')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(52)
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_doctor_rot')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_01_1', '...')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_01_2', 'Finally, you’ve come. {0,1,0,0}, was it?\nLet me see that Pokémon again.', 1)
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_01_t02r0101_doctor_01')
	_OBJ_ANIME_WAIT()
	_LDVAL(@SCWK_TEMP0, 0)
	_TEMOTI_MONSNO(@SCWK_TEMP0, @SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(387, 'ev_t02r0101_doctor_zukan_normal_poke')
	_CASE_JUMP(390, 'ev_t02r0101_doctor_zukan_normal_poke')
	_CASE_JUMP(393, 'ev_t02r0101_doctor_zukan_normal_poke')
	_JUMP('ev_t02r0101_doctor_zukan_evo_poke')
	_END()
ev_t02r0101_doctor_zukan_normal_poke:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_02_1', '...')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_02_2', 'Hmm... I see.\nThis Pokémon seems to be rather happy.\rAs you may already know, you can rename\nyour Pokémon.\rThis is known to improve bonds and bring\npeople and Pokémon closer together.', 1)
	_JUMP('ev_t02r0101_doctor_poke_nick_name_after')
	_END()
ev_t02r0101_doctor_zukan_evo_poke:
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_face05')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_03', 'Well well!\nYou’ve made your Pokémon evolve already?!')
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_face00')
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('T02R0101_DOCTOR', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SET_FORCE_BLINK('T02R0101_DOCTOR', 0)
	_JUMP('ev_t02r0101_doctor_poke_nick_name_after')
	_END()
ev_t02r0101_doctor_zukan_common_01:
	_POKEMON_NAME(0, 0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_04', 'All righty then!\nI’ll give that {0,1,1,0} to you as a gift.')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_05', 'Now that it’s yours, would you like to give it\na nickname?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_doctor_poke_nick_name_after')
	_JUMP('ev_t02r0101_doctor_poke_nick_name_retry')
	_END()
ev_t02r0101_doctor_poke_nick_name_retry:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_NAMEIN_POKE(0, -1, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_14', 'Hmm, OK, I see.\nAnd you’re happy with that nickname?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_doctor_poke_nick_name_retry')
	_JUMP('ev_t02r0101_doctor_poke_nick_name_after')
	_END()
ev_t02r0101_doctor_poke_nick_name_after:
	_EVENT_CAMERA_INDEX(53)
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(6, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2456); Nicknames Chapter
	_POKEMON_NAME(0, 0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_06_1', 'Your friend {1,1,0,0} told me the two of you had \na battle.\rI heard you battled very well, despite it being\nyour first time.', 0, 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_06_2', 'And, from what I can see, there is a growing\nbond between you and that Pokémon, though it\fis still young.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_06_3', 'That’s why I would like to entrust you\nwith {0,1,1,0}.', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_01_t02r0101_support_10')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_t02r0101_player_20')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t02r0101_male_doctor_01')
	_JUMP('ev_t02r0101_female_doctor_01')
	_END()
ev_t02r0101_male_doctor_01:
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_heroine_01', 'I’m so glad that you’re kind toward Pokémon!\rIf you weren’t, I’d have to... Oh, I just can’t\nsay it.', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_support_10')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t02r0101_support_10')
	_END()
ev_t02r0101_female_doctor_01:
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_hero_01', 'Am I ever glad you’re kind toward Pokémon!\rIf you weren’t, well...I don’t even want to think\nabout it.', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_support_10')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t02r0101_support_10')
	_END()
common_t02r0101_support_10:
	_EVENT_CAMERA_INDEX(54)
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_01_t02r0101_doctor_02')
	_OBJ_ANIME('HERO', 'anm_t02r0101_player_19')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('HERO', 'anm_t02r0101_hero_rot')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(35, @SCWK_ANSWER)
	_BGM_PLAY('B_OTH003')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_07', 'Er-hem! Let’s move on to the main topic.\nThere is something I want you to do for me.', 1)
	_SET_FORCE_BLINK('T02R0101_DOCTOR', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SET_FORCE_BLINK('T02R0101_DOCTOR', 0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_07_01_1', 'My name is Rowan. I study Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_07_01_2', 'First of all, I want to know exactly what kinds of\nPokémon live in the Sinnoh region.\rTo do so, it is necessary to collect data using\nthe Pokédex.', 1)
	_EVENT_CAMERA_INDEX(55)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_07_01_3', 'This is what I wish to ask of you.\nI want to entrust you with this Pokédex.\rWill you use it to record data on all the Pokémon\nin Sinnoh for me?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_doctor_cancel_02')
	_JUMP('common_t02r0101_doctor_20')
	_END()
ev_t02r0101_doctor_cancel_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_08_1', '...\r...\r...\r...')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_08_2', 'I can stand here without speaking for hours.\nI’m a very patient man.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_08_3', 'Let me ask you again, {0,1,0,0}.\nI want to entrust you with this Pokédex.\rWill you use it to record data on all the Pokémon\nin Sinnoh for me?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_doctor_cancel_02')
	_JUMP('common_t02r0101_doctor_20')
	_END()
common_t02r0101_doctor_20:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_09', 'Hm! Good answer!')
	_SYS_FLAG_ZUKAN_SET()
	_FLAG_SET(#105)
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_10', 'You obtained the <color=#F01E1EFF>Pokédex</color>!', 1)
	_ME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_11_1', 'That Pokédex is a very high-tech device.\rIt will automatically record data on every kind of\nPokémon you encounter.')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_11_2', '{0,1,0,0}, I ask that you go everywhere\nand meet every kind of Pokémon in this region!', 1, 1)
	_TALK_CLOSE()
	_JUMP('common_t02r0101_doctor_200')
common_t02r0101_doctor_200:
	_ZENKOKU_ZUKAN_FLAG(1, @SCWK_ANSWER); 1 = Set, 2 = Get
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_01_t02r0101_support_11')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'common_t02r0101_male_support_20')
	_JUMP('common_t02r0101_female_support_20')
	_END()
common_t02r0101_male_support_20:
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_heroine_02', 'I’ve got one, too!', 1)
	_JUMP('common_t02r0101_support_30')
	_END()
common_t02r0101_female_support_20:
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_hero_02', 'I’ve got the same kind of Pokédex as you.', 1)
	_JUMP('common_t02r0101_support_30')
	_END()
common_t02r0101_support_30:
	_EVENT_CAMERA_INDEX(56)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_12_1', 'When you walked up Route 201 with your\nPokémon, what did you feel?', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_12_2', 'I’ve lived for 60 long years. Even now, I get a\nthrill when I’m with a Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_12_3', 'Now, you should know that there are countless\nPokémon in this world.\rThat means there are just as many thrills waiting\nfor you out there!', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_12_4', 'Now go!\r{0,1,0,0}, your grand adventure begins\nright now!', 1, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(57)
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_01_t02r0101_support_11')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_t02r0101_hero_rot_cancel')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'anm_t02r0101_player_20')
	_OBJ_ANIME_WAIT()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'common_t02r0101_male_support_30')
	_JUMP('common_t02r0101_female_support_30')
	_END()
common_t02r0101_male_support_30:
	_PLAYER_NAME(0)
	_SUPPORT_POKEMON_NAME(1)
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_heroine_03_1', 'The Pokémon that I used for the first time\nwas {1,1,1,0}!\rIf you would have chosen {1,1,1,0} at\nthe lake, we’d have the same Pokémon now!', 1)
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_heroine_03_2', 'Not that it matters, but...\nAnyways, I’m Dawn.\rI also help the professor add pages to\nthe Pokédex.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_heroine_03_3', 'So, in a sense, I’m just like you.\rI just got a little head start on you, that’s all.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_heroine_03_4', 'I’ll be happy to teach you things. Glad to meet\nyou, {0,1,0,0}!', 1)
	_JUMP('common_t02r0101_support_35')
	_END()
common_t02r0101_female_support_30:
	_PLAYER_NAME(0)
	_RIVAL_POKEMON_NAME(1)
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_hero_03_1', 'I’m Lucas, by the way!\rThe professor asked me to help, so I’m going to\ngo out and fill the Pokédex pages, too.', 1)
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_hero_03_2', 'That makes us comrades working toward the\nsame goal.\rI’ll teach you stuff later, OK?', 1)
	_JUMP('common_t02r0101_support_35')
	_END()
common_t02r0101_support_35:
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(11)
	_OBJ_ANIME('HERO', 'anm_t02r0101_player_30')
	_OBJ_ANIME('T02R0101_SUPPORT', 'anm_t02r0101_support_30')
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_doctor_rot_cancel')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('T02R0101_SUPPORT')
	_FLAG_RESET(#FV_T02_SUPPORT)
	_CALL('ev_t02r0101_incense_burner_tutorial')
	_LDVAL(@WK_SCENE_T02R0101, 1)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_t02r0101_incense_burner_tutorial:
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_incense_00')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'T02R0101_DOCTOR')
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_incense_00', 'Hm?\nWhat is that?!\rWhere did you find that object on your bag?')
	_MACRO_TALK_KEYWAIT('dialogue_t02r0101', '00_msg_t02r0101_incense_01', '...\r...')
	_CHARA_LOOK_RELEASE('T02R0101_DOCTOR')
	_CHARA_LOOK_RELEASE('HERO')
	_MACRO_TALK_KEYWAIT('dialogue_t02r0101', '00_msg_t02r0101_incense_02', 'A Pokémon shaped like the object gave it to you?\rWell! Let me tell you something.\rThat item you have there is called an\nIncense Burner!\rIt was used in ancient times to\ndraw Pokémon in from faraway places.\rIt is believed to be shaped after\nthe Gratitude Pokémon, Shaymin.')
	_MACRO_TALK_KEYWAIT('dialogue_t02r0101', '00_msg_t02r0101_incense_03', 'The scent produced by burning special plants\nthat Shaymin can grow brings out all sorts\fof new Pokémon.')
	_MACRO_TALK_KEYWAIT('dialogue_t02r0101', '00_msg_t02r0101_incense_04', 'My assistant and I have been researching this\nIncense Burner.\rIt must have been left behind in our haste to\nleave Lake Verity...')
	_TALK_CLOSE()
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_incense_01')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'HERO')
	_MACRO_TALK_KEYWAIT('dialogue_t02r0101', '00_msg_t02r0101_incense_05', 'The fact that Shaymin itself saw fit to\nreturn it to you, {0},\fcould not be a mere coincidence.')
	_MACRO_TALK_KEYWAIT('dialogue_t02r0101', '00_msg_t02r0101_incense_06', 'Please keep it and use it to expand your knowledge\nof Pokémon that visit Sinnoh!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('T02R0101_DOCTOR')
	_RET()
anm_t02r0101_incense_00:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_t02r0101_incense_01:
	_AC_DIR_L(8)
	_AC_LEFT(2, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(4, 8)
	_AC_DIR_L(8)
	_AC_LEFT(2, 8)
	_ACMD_END()
