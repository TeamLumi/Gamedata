	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_t02r0101_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
anm_t02r0101_face05:
	_AC_FACE_INDEX(5)
	_ACMD_END()
