ev_t02r0101_CASE:
	_MACRO_TALKMSG('dialogue_t02r0101', '23-msg_t02r0101_briefcase_01', 'It’s crammed full of academic papers\nand notes about field research.')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_t02r0101_doctor_post_distortion:
	_IF_FLAGON_JUMP(#2003, 'ev_t02r0101_doctor_legendary_end')
	_FLAG_SET(#2003) ; You've been told by Rowan that cool stuff is *GOING DOWN*
	_FLAG_RESET(#2800) ; Unhide Articuno
	_FLAG_RESET(#2801) ; Unhide Zapdos
	_FLAG_RESET(#2802) ; Unhide Moltres
	_FLAG_RESET(#2803) ; Unhide Raikou
	_FLAG_RESET(#2804) ; Unhide Entei
	_FLAG_RESET(#2805) ; Unhide Suicune
	_FLAG_SET(#2851); Hide D17 Cynthia
	_FLAG_RESET(#FV_D27R0103_AI)
	_FLAG_RESET(#FV_D28R0103_HAI)
	_FLAG_RESET(#FV_D29R0103_REI)
	_FLAG_SET(#FV_L02_BIGMAN); Open Sunyshore
	_FLAG_SET(#2780); End this event
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 11300)
	_LDVAL(@WK_SCENE_L02_BIGMAN, 1)
	_ZENKOKU_ZUKAN_SEE_NUM(@SCWK_ANSWER)
	_NUMBER_NAME(0, @SCWK_ANSWER)
	_TALKMSG('dlp_rotom_message%t02r0101_doctor_post_distortion_01')
	_PLAYER_NAME(0)
	_MACRO_TALK_KEYWAIT('dlp_rotom_message', 't02r0101_doctor_post_distortion_02', 'Oh, yes, {0,1,4}.\rIf you see Cynthia, please give her \nmy best regards.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_doctor_legendary_end:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_08', 'The world is immense. There are many\nmore Pokémon.\rThat means there are many more thrills for you to\nseek and enjoy!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_rowan_player_back:
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_back_rowan', 'I... I’m stunned by your greatness!\rI feel as shaken and inspired as when\nmy child was born!\rOh, how wonderful it is to be alive!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_support_player_back:
	_TALK_OBJ_START()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t02r0101_support_player_back_dawn')
	_JUMP('ev_t02r0101_support_player_back_lucas')
ev_t02r0101_support_player_back_dawn:
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_dawn_support', 'Hearing what was happening from the\nprofessor gave me shivers.\rBut he strongly stated that you will\nmake everything all right.\rI believed that you would make it, and\nhere you are!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_support_player_back_lucas:
	_MACRO_TALKMSG('dialogue_t02r0101', '00_msg_t02r0101_lucas_support', 'Hearing what was happening from the\nprofessor gave me shivers.\rBut he strongly stated that you will\nmake everything all right.\rI believed that you would make it, and\nhere you are!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()