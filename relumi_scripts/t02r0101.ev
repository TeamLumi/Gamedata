	_AC_UP(8, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_01_t02r0101_support_10:
	_AC_DIR_L(8)
	_ACMD_END()
anm_01_t02r0101_support_11:
	_AC_DIR_L(8)
	_ACMD_END()
anm_01_t02r0101_player_01:
	_AC_WAIT(25)
	_AC_UP(9, 8)
	_ACMD_END()
anm_t02r0101_player_19:
	_AC_DIR_U(8)
	_ACMD_END()
anm_t02r0101_player_20:
	_AC_DIR_R(8)
	_ACMD_END()
anm_t02r0101_player_30:
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_t02r0101_support_10:
	_AC_DIR_L(8)
	_ACMD_END()
anm_t02r0101_support_30:
	_AC_DIR_D(4)
	_AC_DOWN(8, 8)
	_ACMD_END()
anm_t02r0101_doctor_rot:
	_AC_NECK_ROTATE(0, 15, 0, 4)
	_ACMD_END()
anm_t02r0101_doctor_rot_cancel:
	_AC_NECK_ROTATE(0, 0, 0, 4)
	_ACMD_END()
ev_t02r0101_assistm1:
	_TALK_OBJ_START()
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER); Checks if the Sinnoh Dex has been completed
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_assistm1_02')
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_assistm1_01', 'I’m {0,1,0,0}’s father.\rI’ll be happy to assist you on your quest for\nthe professor.\rHahaha. Eh... I’m sure we can count on you!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_assistm1_02:
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_assistm1_02_1', 'It’s really quite something! Imagine... Cataloging\nevery kind of Pokémon in the Sinnoh region!')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_assistm1_02_2', 'And in complete contrast,\nthere’s {0,1,0,0}...\rAnyway, you’ve been great for the prof’s\nPokémon Evolution research!', 1, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_assistw1:
	_TALK_OBJ_START()
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER); Checks if the Sinnoh Dex has been completed
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_assistw1_02')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_assistw1_01', 'Professor Rowan invented a new Pokédex\nwhile working alongside a professor from\fthe Kanto region!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_assistw1_02:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_assistw1_02', 'Yes, that’s correct.\rProfessor Rowan has been studying Pokédex\nsystems with Professor Oak.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_bookshelf1:
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0101', '16-msg_t02r0101_bookshelf1_01', 'Adventure Rule No. 1\nThe X Button opens the menu.')
	_END()
ev_t02r0101_bookshelf2:
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0101', '16-msg_t02r0101_bookshelf2_01', 'Adventure Rule No. 2\nRecord your progress with Save.')
	_END()
ev_t02r0101_bookshelf3:
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0101', '16-msg_t02r0101_bookshelf3_01', 'It’s crammed full of books with all sorts of\nPokémon information.')
	_END()
ev_t02r0101_bookshelf4:
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0101', '16-msg_t02r0101_bookshelf4_01', 'There’s a lot of reference material and research\nreports on Pokémon.')
	_END()
ev_t02r0101_pc1:
	_PLAYER_NAME(0)
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0101', '16-msg_t02r0101_pc_01', 'You checked the PC.\rThe screen is filled with special terms and\nacademic writing that is impossible to figure out.')
	_END()
ev_t02r0101_freezer1:
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0101', '16-msg_t02r0101_freezer_01', 'The refrigerator is filled with tasty\nsweets! Mmm...')
	_END()
ev_t02r0101_doctor_zukan_shinou_comp:
	_IF_FLAGON_JUMP(#230, 'ev_t02r0101_pc_shinou_zukan_comp_ok')
	_JUMP('ev_t02r0101_pc_shinou_zukan_comp_ng')
	_END()
ev_t02r0101_pc_shinou_zukan_comp_ok:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_01_1', 'Hm! {0,1,0,0}, I’ve been waiting to\nsee you!', 0, 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_01_2', 'You’ve met every kind of Pokémon there is in the\nSinnoh region!\rThis will help immensely with my studies on\nPokémon Evolution...', 1)
	_TALK_CLOSE()
	_JUMP('common_t02r0101_hyouka_ookido')
	_END()
ev_t02r0101_pc_shinou_zukan_comp_ng:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_hyouka_doctor_01', 'Ah, {0,1,0,0}!\rYou’ve come to show me your progress on\nthe Pokédex?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t02r0101_hyouka_doctor_no')
	_JUMP('ev_t02r0101_hyouka_doctor_20_yes')
	_END()
ev_t02r0101_hyouka_doctor_no:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_hyouka_doctor_03', 'What’s wrong? You’re not going to tell me\nyou’ve seen too few to bother showing me?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t02r0101_hyouka_doctor_20_yes:
	_SHINOU_ZUKAN_SEE_NUM(@SCWK_ANSWER)
	_NUMBER_NAME(0, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_hyouka_doctor_02', 'Hmm...\rSo, you’ve seen {0,2,2,0} Pokémon.')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_hyouka_s09_1', 'Bravo, {0,1,0,0}!\rYou’ve recorded all the Pokémon of Sinnoh in\nyour Pokédex!', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_hyouka_s09_2', 'This will help immeasurably with my studies on\nPokémon Evolution...', 1)
	_TALK_CLOSE()
	_JUMP('common_t02r0101_hyouka_ookido')
	_END()
common_t02r0101_hyouka_ookido:
	_PLAYER_DIR_GET(@241)
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SXY_POS_CHANGE('HERO', 7, 7)
	_OBJ_DIR_CHANGE('HERO', 0)
	_OBJ_DIR_CHANGE('T02R0101_DOCTOR', 1)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_FLAG_RESET(#495)
	_OBJ_ADD('T02R0101_OOKIDO')
	_EVENT_CAMERA_INDEX(312)
	_OBJ_ANIME('HERO', 'anm_t02r0101_player_110')
	_OBJ_ANIME('T02R0101_OOKIDO', 'anm_t02r0101_ookido_110')
	_OBJ_ANIME('T02R0101_DOCTOR', 'anm_t02r0101_doctor_110')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'T02R0101_DOCTOR')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_01_1', 'Greetings, Professor Rowan! It’s been a very\nlong time!')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_01_2', 'I’ll tell you, Sinnoh certainly is a long trip\nfrom Kanto.\rOf course, if it means meeting new Pokémon,\nthere’s no distance too great for the likes of us\fto travel.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_02_1', 'Oh! If it isn’t my old colleague, Professor Oak!\rI should have expected as much from the world’s\nauthority on Pokémon!')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_02_2', 'We always used to joke, “Where there are\nPokémon, you’ll find Oak!”\rIt’s good to see that hasn’t changed one bit!', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'HERO')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'T02R0101_OOKIDO')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_POS_CHANGE_WORLD('HERO', 5.500000, 0, 7)
	_EVENT_CAMERA_INDEX(313)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_03', 'Professor Oak, let me introduce you to my\nyoung assistant.\rThis youngster has filled every page of the\nSinnoh Pokédex for me.')
	_TALK_CLOSE()
	_EVENT_CAMERA_END_WAIT()
	_EVENT_CAMERA_INDEX(314)
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'T02R0101_OOKIDO')
	_CHARA_LOOK_LOCK('T02R0101_OOKIDO', 'HERO')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_02_1', 'Ah, well, very glad to meet you! As you’ve heard,\nmy name is Oak.\rI’ve been hearing a great deal about you from\nProfessor Rowan lately.')
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_02_2', 'He’s been exuberant in praise about a fantastic\nyoung Trainer.\rI see that you live up to—no—that you’ve\nsurpassed his praise.\rYou’ve also got an impeccable sense of timing.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_02_3', 'You see, I had an errand to run for Professor\nRowan on my visit here. He’d asked me to bring\fthe data for the National Pokédex.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_02_4', 'So, since you’re here, let me upgrade your\nPokédex with the National Mode.\rAfter all, there are many kinds of Pokémon in this\nworld of ours!', 1)
	_IF_FLAGON_CALL($SYS_FLAG_GAME_CLEAR, 'common_t02r0101_zenkoku_zukan_open')
	_EVENT_CAMERA_INDEX(315)
	_FLAG_RESET(#FV_D03R0101_LEADER)
	_ZENKOKU_ZUKAN_FLAG(1, @SCWK_ANSWER); 1 = Set, 2 = Get
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_03', 'Your Pokédex was upgraded with the\nNational Mode!')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_04', 'I’m afraid it won’t be easy to complete the\nNational Pokédex. However, I’m sure you will\fmake an honest attempt on our behalf!', 1)
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'T02R0101_OOKIDO')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_04', 'Have no fear. {0,1,0,0} will get the\njob done.\rBy the way, Professor Oak, what compelled you\nto visit this region?', 1, 1)
	_EVENT_CAMERA_INDEX(316)
	_CHARA_LOOK_LOCK('HERO', 'T02R0101_DOCTOR')
	_CHARA_LOOK_LOCK('T02R0101_OOKIDO', 'T02R0101_DOCTOR')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_05_1', 'Ah, yes. I’ve heard that Renegade Park is now\nopen. If I remember correctly, it’s at the end\fof Route 221.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_05_2', 'Renegade Park has a special system that\nattracts every imaginable kind of Pokémon\ffrom every region.', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_05_3', 'I’ve come to make certain that system is\noperating properly.', 1)
	_CHARA_LOOK_LOCK('HERO', 'T02R0101_OOKIDO')
	_CHARA_LOOK_LOCK('T02R0101_OOKIDO', 'HERO')
	_PLAYER_NAME(0)
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'common_t02r0101_zenkoku_zukan_t02r0101_male')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'common_t02r0101_zenkoku_zukan_t02r0101_female')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('T02R0101_OOKIDO')
	_OBJ_ANIME('T02R0101_OOKIDO', 'anm_t02r0101_ookido_130')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('T02R0101_OOKIDO')
	_CHARA_LOOK_LOCK('HERO', 'T02R0101_DOCTOR')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_05', 'Off he goes, as busy as ever...')
	_TALK_CLOSE()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(317)
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'anm_t02r0101_player_130')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('T02R0101_DOCTOR', 'HERO')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_06', 'Now, {0,1,0,0}...\rI have a gift here as your reward for completing\nthe Sinnoh Pokédex.')
	_LDVAL(@SCWK_TEMP0, 431)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_07_1', 'That’s the Pokémon Radar—or just Poké Radar\nfor short.\rUse it, and it will indicate grass patches where\nPokémon are lurking.')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_doctor_a_07_2', 'I’d prepared that to help my field assistants put\ntogether the Sinnoh Pokédex, but you took care\fof that!\rI’m sure it will be useful for your goal of filling\nthe National Pokédex.', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('T02R0101_DOCTOR')
	_EVENT_CAMERA_INDEX(318)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_END()
common_t02r0101_zenkoku_zukan_open:
	_LDVAL(@HIDEMAP_ID_L04, 1)
	_FLAG_SET(#FV_R214_KAKURE_ROAD)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 13200)
	_LDVAL(@WK_SCENE_T02, 3)
	_RET()
common_t02r0101_zenkoku_zukan_t02r0101_male:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_06_1', '{0,1,0,0}, you should make an effort to\nvisit Renegade Park, too.')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_06_2', 'Oops! I’ll be late for my meeting if I don’t\nget going!', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_06_3', 'OK, it was a pleasure seeing the both of you!\nBye now!', 1)
	_RET()
common_t02r0101_zenkoku_zukan_t02r0101_female:
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_07_1', '{0,1,0,0}, you should make an effort to\nvisit Renegade Park, too.')
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_07_2', 'Oops! I’ll be late for my meeting if I don’t\nget going!', 1)
	_MACRO_TALKMSG('dialogue_t02r0101', '16-msg_t02r0101_ookido_a_07_3', 'OK, it was a pleasure seeing the both of you!\nBye now!', 1)
	_RET()
