ev_t07r0101_flag_change:
	_LDVAL(@WK_ELEVATOR_FLOOR, 0)
	_IF_FLAGON_JUMP(#FE_T07R0101_MEMBER, 'ev_t07r0101_flag_change_01')
	_END()
ev_t07r0101_flag_change_01:
	_SXY_POS_CHANGE('T07R0101_WOMAN2', 16, 14)
	_OBJ_DIR_CHANGE('T07R0101_WOMAN2', 1)
	_END()
ev_t07r0101_kaiin_check:
	_CALL('ev_block_doc')
	_EVENT_START()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CHK_RIBBON_COUNT_ALL(@SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'LT', 10, 'ev_t07r0101_woman2_01')
	_LDVAL(@WK_SCENE_T07R0101, 1)
	_FLAG_SET(#FE_T07R0101_MEMBER)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_02_1', '*sniff*\nI do apologize.\rThis is an exclusive establishment, open only to a\nselect few.\rYou might consider it a special stage for the\ncream of the crop.')
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_02_2', 'If you wish to enter, I suggest you start by\ncollecting lots of Ribbons.', 1)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_02_3', 'Wait! Oh my gosh! Look at all your Ribbons!\rI truly apologize for my rudeness. It’s so out of\ncharacter for me!', 1)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_02_4', 'If you would be so kind, we would be honored to\ninvite you...\rOh, no, no! You really must join us as a\nfull-fledged member!', 1)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_02_5', 'You were made a member without any say in\nthe decision!', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('T07R0101_WOMAN2', 'anm_t07r0101_woman2_move_01')
	_OBJ_ANIME_WAIT()
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_t07r0101_woman2_01:
	_CALL('ev_block_doc')
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_01_1', '*sniff*\nI do apologize.\rThis is an exclusive establishment, open only to a\nselect few.\rYou might consider it a special stage for the\ncream of the crop.')
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_01_2', 'If you wish to enter, I suggest you start by\ncollecting lots of Ribbons.', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_t07r0101_hero_move_01')
	_OBJ_ANIME_WAIT()
	_BLACK_OUT('SCR_WIPE_DIV', 2)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MAP_CHANGE('T07', 3)
	_BLACK_IN('SCR_WIPE_DIV', 2)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
anm_t07r0101_woman2_move_01:
	_AC_DIR_L(8)
	_AC_RIGHT(1, 8)
	_ACMD_END()
anm_t07r0101_hero_move_01:
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_ACMD_END()
ev_t07r0101_woman2:
	_PLAYER_NAME(0)
	_MACRO_EASY_OBJ_MSG('dialogue_t07r0101', '51-msg_t07r0101_woman2_03', 'Welcome! We’ve looked forward to seeing\nyou, {0,1,0,0}.\rI do hope you enjoy the luxurious atmosphere\nand services that only we can provide.')
	_END()
ev_t07r0101_shopw:
	_TALK_OBJ_START()
	_FRONT_POKEMON(@SCWK_PARAM0)
	_PLAYER_NAME(0)
	_POKEMON_NAME(2, @SCWK_PARAM0)
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM0, 17)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07r0101_shopw_04')
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM0, 16)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07r0101_shopw_03')
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM0, 15)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07r0101_shopw_02')
	_JUMP('ev_t07r0101_shopw_01')
	_JUMP('ev_t07r0101_shopw_01')
ev_t07r0101_shopw_01:
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_01_1', 'Welcome.\rMay I interest you in top-grade Ribbons we had\nspecially imported?\rThese Ribbons are available only through us.')
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_01_2', '{0,1,0,0}, would you like one for a\nPokémon, perhaps?\rRight now, I can offer you the Gorgeous Ribbon.\rFor a mere 10,000, you can be the proud\nowner of one.', 1)
	_MONEY_OPEN()
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07r0101_shopw_12')
	_COMP_GOLD(@SCWK_ANSWER, 10000)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t07r0101_shopw_11')
	_SUB_GOLD(10000)
	_SE_PLAY('s_me050')
	_SE_WAIT('s_me050')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_05', 'You bought a Gorgeous Ribbon.')
	_FRONT_POKEMON(@SCWK_PARAM0)
	_POKEMON_NAME(2, @SCWK_PARAM0)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_06', 'You put the Gorgeous Ribbon\non {2,1,1,0}.')
	_SET_RIBBON(@SCWK_PARAM0, 15)
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_shopw_02:
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_02_1', 'Welcome.\rMay I interest you in top-grade Ribbons we had\nspecially imported?\rThese Ribbons are available only through us.')
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_02_2', '{0,1,0,0}, would you like one for a\nPokémon, perhaps?\rRight now, I can offer you the Royal Ribbon.\rFor a mere 100,000, you can be the proud\nowner of one.', 1)
	_MONEY_OPEN()
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07r0101_shopw_12')
	_COMP_GOLD(@SCWK_ANSWER, 100000)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t07r0101_shopw_11')
	_SUB_GOLD(100000)
	_SE_PLAY('s_me050')
	_SE_WAIT('s_me050')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_07', 'You bought a Royal Ribbon.')
	_FRONT_POKEMON(@SCWK_PARAM0)
	_POKEMON_NAME(2, @SCWK_PARAM0)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_08', 'You put the Royal Ribbon on {2,1,1,0}.')
	_SET_RIBBON(@SCWK_PARAM0, 16)
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_shopw_03:
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_03_1', 'Welcome.\rMay I interest you in top-grade Ribbons we had\nspecially imported?\rThese Ribbons are available only through us.')
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_03_2', '{0,1,0,0}, would you like one for a\nPokémon, perhaps?\rRight now, I can offer you the\nGorgeous Royal Ribbon.\rFor a mere 999,999, you can be the proud\nowner of one.', 1)
	_MONEY_OPEN()
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07r0101_shopw_12')
	_COMP_GOLD(@SCWK_ANSWER, 999999)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t07r0101_shopw_11')
	_SUB_GOLD(999999)
	_SE_PLAY('s_me050')
	_SE_WAIT('s_me050')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_09', 'You bought a Gorgeous Royal Ribbon.')
	_FRONT_POKEMON(@SCWK_PARAM0)
	_POKEMON_NAME(2, @SCWK_PARAM0)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_10', 'You put the Gorgeous Royal Ribbon\non {2,1,1,0}.')
	_SET_RIBBON(@SCWK_PARAM0, 17)
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_shopw_04:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_04', 'Welcome.\rOoh! That’s a Gorgeous Royal Ribbon!\r{0,1,0,0}, your {2,1,1,0}\ncertainly looks gorgeous and royal!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_shopw_11:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_11', 'Oh, please, {0,1,0,0}.\rYou shouldn’t joke about not having money.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_shopw_12:
	_MONEY_CLOSE()
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_shopw_12', 'I see. Please do visit again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_middlewoman2:
	_MACRO_EASY_OBJ_MSG('dialogue_t07r0101', '51-msg_t07r0101_middlewoman2_01', 'Just being in here is a sign of status, just so\nyou know.')
	_END()
ev_t07r0101_gorggeousw:
	_TALK_OBJ_START_TURN_NOT()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 't07r0101_gorggeousw_male')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 't07r0101_gorggeousw_female')
	_END()
t07r0101_gorggeousw_male:
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_gorggeousw_01', 'I wish people would pay more attention to the\nway they dress themselves.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
t07r0101_gorggeousw_female:
	_MACRO_TALKMSG('dialogue_t07r0101', '51-msg_t07r0101_gorggeousw_02', 'A person worthy of being seen with Pokémon...\nThat’s what I hope to be.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07r0101_eneco:
	_EASY_VOICE_MSG('dialogue_t07r0101%51-msg_t07r0101_eneco_01', 'PLAY_PV_EV_300_00_00')
	_END()
ev_t07r0101_koduck:
	_EASY_VOICE_MSG('dialogue_t07r0101%51-msg_t07r0101_koduck_01', 'PLAY_PV_EV_054_00_00')
