ev_r210a_flag_change:
	_IF_FLAGON_CALL(#FV_R210A_POKE, 'ev_r210a_cdac_chap')
	; Move the Darmanitan blocker to be positioned half a tile
	_IF_FLAGOFF_CALL(#FV_R210A_POKE, 'ev_r210a_position_darmanitan_blocker')
	_GET_TIME_ZONE(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_r210a_fc_morning')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_r210a_fc_noon')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 2, 'ev_r210a_fc_evening')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 3, 'ev_r210a_fc_night')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 4, 'ev_r210a_fc_midnight')
	_END()
ev_r210a_fc_morning:
	_FLAG_RESET(#FV_R210A_JOGGER4_TR)
	_FLAG_SET(#FV_R210A_JOGGER4_NPC)
	_OBJ_DEL('R210A_JOGGER4')
	_END()
ev_r210a_fc_noon:
	_JUMP('ev_r210a_fc_midnight')
ev_r210a_fc_evening:
	_JUMP('ev_r210a_fc_midnight')
ev_r210a_fc_night:
	_JUMP('ev_r210a_fc_midnight')
ev_r210a_fc_midnight:
	_FLAG_RESET(#FV_R210A_JOGGER4_NPC)
	_FLAG_SET(#FV_R210A_JOGGER4_TR)
	_OBJ_DEL('TR_JOGGER_04')
	_END()
ev_r210a_cdac_chap:
	_LDVAL(@LOCALWORK31, 1)
	_RET()
ev_r210a_position_darmanitan_blocker:
	_OBJ_POS_CHANGE_WORLD('R210A_DARMANITAN_STOPPER1', 560.5, 2, 586)
	_RET()
ev_r210a_stopper:
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	;_ITEM_CHK(1310, 1, @SCWK_ANSWER)
	; Checks if the galactic chase of Valor Lakefront has been completed
	_IFVAL_JUMP(@484, 'EQ', 7, 'ev_r210a_stopper_hiden')
	_EVENT_CAMERA_INDEX(246)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_r210a', '75-msg_r210a_stopper_01', 'This awkwardly placed statue...\nIs it a Pokémon?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(247)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_r210a_stopper_hiden:
	_EVENT_CAMERA_INDEX(246)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_r210a', '75-msg_r210a_stopper_02', 'The sleeping Darmanitan is as still as a statue.\nWould you like to give it\fCynthia’s Rage Candy Bar?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r210a_stopper_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r210a_stopper_01_no')
	_END()
ev_r210a_stopper_01_no:
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(247)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_r210a_stopper_01_yes:
	_CALL('ev_another_out')
	_MACRO_TALKMSG('dialogue_r210a', '75-msg_r210a_stopper_03', 'Darmanitan responded to Cynthia’s Rage\nCandy Bar.\rThe awakened Darmanitan attacked!')
	_TALK_CLOSE()
	_VOICE_PLAY(555, 0, 0)
	_MACRO_TALKMSG('dialogue_r210a', 'msg_r210a_darmanitan_awakened', 'Daaaaaaaar... Daaaaaaaar...')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET(555, 38, 0, 0, 1)
	; Check if the pokemon was caught
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 555)
	_OBJ_DEL('R210A_DARMANITAN_STOPPER1')
	; If the pokemon was not caught, change placedata for awakened one
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_r210a_stopper_01_not_caught')
	_EVENT_CAMERA_INDEX(247)
	_EVENT_CAMERA_END_WAIT()
	_FLAG_SET(#FV_R210A_POKE)
	; All this was part of the deleted Cynthia event
	_FLAG_SET(#FE_R210A_CLEAR)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7600)
	_LDVAL(@LOCALWORK31, 1)
	; Remove item from bag
	_SUB_ITEM(1310, 1, @SCWK_ANSWER)
	_CALL('ev_another_out_end')
	_END()
ev_r210a_stopper_01_not_caught:
	; Position the awakened Darmanitan in the same place as the blocker
	_OBJ_POS_CHANGE_WORLD('R210A_DARMANITAN_AWAKENED', 560.5, 2, 586)
	; Enable awakened Darmanitan
	_FLAG_RESET(#2868)
	_OBJ_ADD('R210A_DARMANITAN_AWAKENED')
	;Animation to look left, then right, then question mark emote, and then run up
	_OBJ_ANIME('R210A_DARMANITAN_AWAKENED', 'anm_r210a_darmanitan_stopper1_00')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R210A_DARMANITAN_AWAKENED', 'anm_r210a_darmanitan_stopper1_01')
	_PLAY_EMO_SE(7)
	_OBJ_ANIME_WAIT()
	_OBJ_POS_CHANGE_WORLD('R210A_DARMANITAN_AWAKENED', 560, 2, 574)
	_OBJ_DIR_CHANGE('R210A_DARMANITAN_AWAKENED', 0)
	_RET()
ev_r210a_darmanitan_awakened:
	_TALK_OBJ_START()
	_VOICE_PLAY(555, 0, 0)
	_MACRO_TALKMSG('dialogue_r210a', 'msg_r210a_darmanitan_awakened_1', 'MAAAAAAAAANI! DARMAAAAAANI!!')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET(555, 38, 0, 0, 1)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 555)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_r210a_darmanitan_awakened_caught')
	_TALK_OBJ_END()
	_END()
ev_r210a_darmanitan_awakened_caught:
	; Remove Darmanitan when caught
	_FLAG_SET(#2868)
	_OBJ_DEL('R210A_DARMANITAN_AWAKENED')
	_RET()
anm_r210a_darmanitan_stopper1_00:
	_AC_DIR_L(8)
	_AC_WAIT(15)
	_AC_DIR_R(8)
	_AC_WAIT(15)
	_AC_DIR_D(8)
	_AC_WAIT(15)
	_ACMD_END()
anm_r210a_darmanitan_stopper1_01:
	_AC_MARK_EMO(7)
	_AC_DIR_U(8)
	_AC_UP(8, 8)
	_ACMD_END()
ev_r210a_woman3:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_WAZAMASIN51_GET, 'ev_r210a_woman3_02')
	_MACRO_TALKMSG('dialogue_r210a', '75-msg_r210a_woman3_01', 'I’m taking a rest. If I were a bird Pokémon, it\nwould be a roost. Haha!\rUh... You should rest up, too.')
	_LDVAL(@SCWK_TEMP0, 378)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r210a_woman3_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_WAZAMASIN51_GET)
	_JUMP('ev_r210a_woman3_02')
	_JUMP('ev_r210a_woman3_02')
ev_r210a_woman3_02:
	_MACRO_TALKMSG('dialogue_r210a', '75-msg_r210a_woman3_02', 'If they had to keep flying forever, bird Pokémon\nwould eventually crash.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r210a_woman3_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r210a_sign1:
	_EASY_BOARD_MSG('dialogue_r210a%75-msg_r210a_sign1_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_r210a_sign2:
	_EASY_BOARD_MSG('dialogue_r210a%75-msg_r210a_sign2_01', 'BOARD_TYPE_ROAD', 0, 4)
	_END()
ev_r210a_jogger4:
	_MACRO_EASY_OBJ_MSG('dialogue_r210a', '75-msg_r210a_jogger_04_01', 'I’m going to keep running. Just as long as there’s\na road...')
	_END()
pos_r210a_pw_cdac_out01:
	_OBJ_ANIME('HERO', 'anm_r210a_pw_cdac_out01')
	_OBJ_ANIME_WAIT()
	_END()
anm_r210a_pw_cdac_out01:
	_AC_DIR_D(8)
	_AC_WORLD_X(560.500000, 8)
	_AC_WORLD_Z(588, 8)
	_ACMD_END()