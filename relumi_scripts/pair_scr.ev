ev_pair_r201_rival:
	_TALK_OBJ_START()
	_RIVAL_NAME(0)
	_RIVAL_POKEMON_NAME(1)
	_IFVAL_JUMP(@477, 'EQ', 1, 'ev_pair_r201_rival_dialogue')
	_SYS_FLAG_ONE_STEP_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_pair_r201_rival_one_step')
	_SWITCH(@WK_SCENE_PAIR_R201_RIVAL)
	_CASE_JUMP(6, 'ev_pair_r201_rival_07')
	_CASE_JUMP(5, 'ev_pair_r201_rival_06')
	_CASE_JUMP(4, 'ev_pair_r201_rival_05')
	_CASE_JUMP(3, 'ev_pair_r201_rival_04')
	_CASE_JUMP(2, 'ev_pair_r201_rival_03')
	_CASE_JUMP(1, 'ev_pair_r201_rival_02')
	_JUMP('ev_pair_r201_rival_01')
	_END()
ev_pair_r201_rival_dialogue:
	_MACRO_TALKMSG('dialogue_pair_scr', '00_msg_r201_no_leave', 'What’s up with you?\nOpen the briefcase and pick a Pokémon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_r201_rival_one_step:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_r201_rival_a_07', 'All right, let’s move out! Hustle up!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_r201_rival_07:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_rival_a_06', 'Hey, that’s enough talking already. I’m itching to\nget going to the lake. Come on, come on!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_r201_rival_06:
	_MACRO_TALKMSG('dialogue_pair_scr', 'msg_pair_r201_rival_06', 'Hey, do you know about the Champion?\rThere’s this out-of-this-world tough Trainer\nwho gets called that.\rWell, I’m gonna get so tough, the Champ has\nto battle me. You watch!\rWith this little guy here, I’m sure I can get that\ntough.')
	_JUMP('ev_pair_r201_rival_common')
	_END()
ev_pair_r201_rival_05:
	_MACRO_TALKMSG('dialogue_pair_scr', 'msg_pair_r201_rival_05', 'Check this out!\nMy new Pokémon Watch has a Pokémon living\fin it.\rIt won’t battle or anything, though.\nNo matter how loud I yell commands.')
	_JUMP('ev_pair_r201_rival_common')
	_END()
ev_pair_r201_rival_04:
	_MACRO_TALKMSG('dialogue_pair_scr', 'msg_pair_r201_rival_04', 'That lake has a mirage Pokémon living in it.\rEveryone says it’s just a legend, but I know I’m\nright.')
	_JUMP('ev_pair_r201_rival_common')
	_END()
ev_pair_r201_rival_03:
	_MACRO_TALKMSG('dialogue_pair_scr', 'msg_pair_r201_rival_03', 'Do you believe it?\nI can hardly believe it.\rYou and me, we’re Pokémon Trainers all of a\nsudden.\rMan, we’ve got tons to learn about being a\nTrainer.\rBut seeing this Poké Ball with this {1,1,0,0}\ninside...\rIt makes me feel like I can do anything!\rNothing’s impossible!')
	_JUMP('ev_pair_r201_rival_common')
	_END()
ev_pair_r201_rival_02:
	_MACRO_TALKMSG('dialogue_pair_scr', 'msg_pair_r201_rival_02', 'Pokémon all have different moves, huh?\rA Trainer makes their Pokémon battle by\nordering them to use moves.\rThat’s so awesomely cool.')
	_JUMP('ev_pair_r201_rival_common')
	_END()
ev_pair_r201_rival_01:
	_MACRO_TALKMSG('dialogue_pair_scr', 'msg_pair_r201_rival_01', 'That Pokémon battle...\nWasn’t that wickedly fun or what?\rI mean, I’d pick the moves, and my Pokémon\nwould use them!\rYeah, I’m going to battle tons and get real\nclose with Pokémon.')
	_JUMP('ev_pair_r201_rival_common')
	_END()
ev_pair_r201_rival_common:
	_ADD_WK(@WK_SCENE_PAIR_R201_RIVAL, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_l01_rival:
	_TALK_OBJ_START()
	_RIVAL_NAME(0)
	_IFVAL_JUMP(@WK_SCENE_PAIR_L01_RIVAL, 'GE', 2, 'ev_pair_l01_rival_02')
	_IFVAL_JUMP(@WK_SCENE_PAIR_L01_RIVAL, 'EQ', 1, 'ev_pair_l01_rival_01')
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_rival_b_01', 'We didn’t have any choice in using those\npeople’s Pokémon, right?\rBut these Pokémon belong to them.\nThey’ll want them back, won’t they?\rBut this is the first Pokémon I’ve ever\nbattled with.')
	_JUMP('ev_pair_l01_rival_common')
	_END()
ev_pair_l01_rival_02:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_rival_b_03', 'I don’t feel like talking... Let’s go.\rAre we maybe walking slower than when we went\nto the lake?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_l01_rival_01:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_rival_b_02', 'I wish I could grow tougher with this little guy...')
	_JUMP('ev_pair_l01_rival_common')
	_END()
ev_pair_l01_rival_common:
	_TALK_CLOSE()
	_ADD_WK(@WK_SCENE_PAIR_L01_RIVAL, 1)
	_TALK_OBJ_END()
	_END()
ev_pair_d03r0101_seven1:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_PAIR_D03R0101_SEVEN1, 'GE', 2, 'ev_pair_d03r0101_seven1_02')
	_IFVAL_JUMP(@WK_SCENE_PAIR_D03R0101_SEVEN1, 'EQ', 1, 'ev_pair_d03r0101_seven1_01')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven1_04', 'It’s startling to see two wild Pokémon appear at\nthe same time.')
	_JUMP('ev_pair_d03r0101_seven1_common')
	_END()
ev_pair_d03r0101_seven1_01:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven1_05', 'My Pokémon is an excellent healer.\nBut attacking isn’t its strong point.')
	_JUMP('ev_pair_d03r0101_seven1_common')
	_END()
ev_pair_d03r0101_seven1_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven1_06', '{0,1,0,0}, battling with you makes me\nfeel elated!\rIf I could predict what you’re about to do, we\nwould make a fierce combo!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_d03r0101_seven1_common:
	_ADD_WK(@WK_SCENE_PAIR_D03R0101_SEVEN1, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_d16r0102_seven5:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_PAIR_D16R0102_SEVEN5, 'GE', 3, 'ev_pair_d16r0102_seven5_03')
	_IFVAL_JUMP(@WK_SCENE_PAIR_D16R0102_SEVEN5, 'EQ', 2, 'ev_pair_d16r0102_seven5_02')
	_IFVAL_JUMP(@WK_SCENE_PAIR_D16R0102_SEVEN5, 'EQ', 1, 'ev_pair_d16r0102_seven5_01')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven5_03', 'Why do I like the volcano so much?\rI don’t really have a good reason for it, but I\ndon’t really need one.')
	_JUMP('ev_pair_d16r0102_seven5_common')
	_END()
ev_pair_d16r0102_seven5_01:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven5_04_1', 'There’s no law that says I have to be tough or\nanything, but losing isn’t fair to my Pokémon.')
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven5_04_2', 'After all, they try so hard for me.\rI think it’s my responsibility as a Trainer to\nrecognize their hard work.')
	_JUMP('ev_pair_d16r0102_seven5_common')
	_END()
ev_pair_d16r0102_seven5_02:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven5_05_1', 'My big brother is one of the Elite Four.\rSo, of course it’s only normal that I’d be better\nthan ordinary folks.')
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven5_05_2', 'But that’s not what I want. I want to be tough on\nmy own terms.\rIt wouldn’t be fair to the Pokémon that chose to\nbe with me.')
	_JUMP('ev_pair_d16r0102_seven5_common')
	_END()
ev_pair_d16r0102_seven5_03:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven5_06', 'It might be cool being a Gym Leader or one of\nthe Elite Four...\rBut, then again, it sounds like it’d be a lot of\nhard work!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_d16r0102_seven5_common:
	_ADD_WK(@WK_SCENE_PAIR_D16R0102_SEVEN5, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_d09r0104_seven4:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_PAIR_D09R0104_SEVEN4, 'GE', 1, 'ev_pair_d09r0104_seven4_01')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven4_05', 'You’re very chatty...')
	_JUMP('ev_pair_d09r0104_seven4_common')
	_END()
ev_pair_d09r0104_seven4_01:
	_MACRO_TALKMSG('dialogue_pair_scr', '67-msg_pair_seven4_06', 'The Pokémon among flowers...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_pair_d09r0104_seven4_common:
	_ADD_WK(@WK_SCENE_PAIR_D09R0104_SEVEN4, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()