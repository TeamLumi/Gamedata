ev_c03pc0101_flag_change:
	_IF_FLAGON_JUMP($806, 'ev_c03pc0101_flag_change_end_a')
	_FLAG_RESET(#516)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_c03pc0101_flag_change_end_a:
	_SYS_FLAG_BADGE_GET($124, @246)
	_IFVAL_JUMP(@246, 'EQ', 1, 'ev_c03pc0101_flag_change_del_stopper')
	_END()
ev_c03pc0101_flag_change_del_stopper:
	_FLAG_SET(#1660)
	_FLAG_SET(#516)
	_END()
ev_c03pc0101_pcwoman1:
	_LDVAL(@241, 'C03PC0101_PCWOMAN1')
	_JUMP('ev_heal_p01')
	_END()
ev_c03pc0101_babyboy1:
	_MACRO_EASY_OBJ_MSG('dialogue_c03pc0101', '87-msg_c03pc0101_babyboy1_01', 'Yay!\rI traded Pokémon at the Global Club downstairs!')
	_END()
ev_c03pc0101_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_c03pc0101', '87-msg_c03pc0101_woman3_01', 'Switch on the PC at any Pokémon Center and\nconnect to the Pokémon Boxes.\rThat’s all you need to do to store or bring out\nyour Pokémon.\rYou may be able to access the Pokémon Boxes\nfrom the menu screen!')
	_TALK_CLOSE()
	_END()
ev_c03pc0101_mystery:
	_MACRO_EASY_OBJ_MSG('dialogue_c03pc0101', '87-msg_c03pc0101_mystery_01', 'If you’d like to change your appearance for the\nUnion Room, talk to the receptionist to the left\fon the second floor.')
	_END()
ev_c03pc0101_gentleman_1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c03pc0101', '00_msg_c03pc0101_script_5_1', 'Hmmm!\nWhat, or who, is this Team Galactic?!\rThey make wonderful claims of a dream\nenergy source on one hand...\rBut rumor has it, they steal Pokémon\nfrom others by force.\rIt’s a mystery! They’re mysterious!\nIsn’t anyone investigating them?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END(); _IF_FLAGON_JUMP(#2404, 'ev_c03pc0101_gentleman_2'), can't add because can't find where 2404 is set in DSPRE
ev_c03pc0101_youngboy_1:
	_MACRO_EASY_OBJ_MSG('dialogue_c03pc0101', '00_msg_c03pc0101_script_6_1', 'You know how you can battle a friend\nusing wireless communications?\rWell now, you can capture it as a Battle\nVideo using a Vs. Recorder!\rIf this game had one!')
	_END()
ev_c03pc0101_youngboy_2:
	_MACRO_EASY_OBJ_MSG('dialogue_c03pc0101', '00_msg_c03pc0101_script_7_1', 'Ha!\nYou don’t have a Vs. Recorder!\rSo, did you go to the Global Terminal in\nJubilife City? Did ya? Did ya?')
	_END()
ev_c03pc0101_gentleman_2:
	_MACRO_EASY_OBJ_MSG('dialogue_c03pc0101', '00_msg_c03pc0101_script_5_2', 'Hmmm!\nWhat, or who, is this Team Galactic?!\rLately, they’ve renounced such acts\nas stealing Pokémon.\rThey’re still involved in developing \ndream energies, but ethically now.')
	_END()