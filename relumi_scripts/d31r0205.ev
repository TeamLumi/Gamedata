	_FLAG_RESET(#FE_BT_M_WINS_PRESENT_GET_50)
	_FLAG_RESET(#FE_BT_M_WINS_PRESENT_GET_75)
	_FLAG_RESET(#FE_BT_M_WINS_PRESENT_GET_100)
	_FLAG_SET(#FE_BT_M_WINS_PRESENT_GET_200)
	_ADD_WK(@WK_BT_MASTER_WINS_COUNT_NEXT, 10)
	_FLAG_SET(#FE_BT_M_WINS_PRESENT_LOOP)
	_LDVAL(@WK_BT_MASTER_WINS_COUNT, 0)
	_FLAG_RESET(#FE_BT_M_WINS_PRESENT_MINTO)
	_RET()
ev_tower_rooms_sbtl_ms1:
	_CALL('ev_tower_rooms_sbtl_call_ms')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_tower_rooms_common_lose')
	_CALL('ev_tower_rooms_common_win_param')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 989, 'ev_tower_rooms_common_clear_ret')
	_CALL('ev_tower_rooms_comanm_eneout')
	_CALL('ev_tower_rooms_comanm_sbtl_end')
	_CALL('ev_tower_rooms_common_heal')
	_JUMP('ev_tower_rooms_sbtl_ms02')
	_END()
ev_tower_rooms_sbtl_call_ms:
	_CALL('ev_tower_rooms_comanm_enein')
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK8)
	_IFVAL_JUMP(@LOCALWORK8, 'EQ', 7, 'ev_tower_rooms_ms_leader_talks')
	_TALKMSG_BTOWER_APPEAR(0)
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks:
	_BTWR_SUB_GET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK9)
	_PLAYER_NAME(0)
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 1, 'ev_tower_rooms_ms_leader_talks_01')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 2, 'ev_tower_rooms_ms_leader_talks_02')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 3, 'ev_tower_rooms_ms_leader_talks_03')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 4, 'ev_tower_rooms_ms_leader_talks_04')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 5, 'ev_tower_rooms_ms_leader_talks_05')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 6, 'ev_tower_rooms_ms_leader_talks_06')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 7, 'ev_tower_rooms_ms_leader_talks_07')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 8, 'ev_tower_rooms_ms_leader_talks_08')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 9, 'ev_tower_rooms_ms_leader_talks_09')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 10, 'ev_tower_rooms_ms_leader_talks_10')
	_END()
ev_tower_rooms_ms_leader_talks_01:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c01gym0101_leader_01', 'If you’re into battling, this is the place to be.\nYou can train here as much as you like!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_02:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c03gym0101_leader_01', 'Would you like to see how much my Pokémon’s\nskills have grown?')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_03:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c07gym0101_leader_01', 'I’m here learning what it means to be strong!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_04:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c06gym0101_leader_01', 'Crash! Crash! Watch out, Battle Tower!\nCrasher Wake...is...heeere!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_05:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c05gym0113_leader_01', 'The stage is set for our battle! Shall we dance?')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_06:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c02gym0101_leader_01', 'I think Roark’s here, too, somewhere... Oh, I see!\nYou’ve already defeated my son!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_07:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c09gym0101_leader_01', 'I figured if I trained here, I might get more—\nOh, what’s the word I’m looking for...dignity?\fWhatever it is that makes a Gym Leader cool!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_08:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c08gym0103_leader_01', 'For some strange reason, my pulse is pounding...\nAha. It must be because you’re here!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_09:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_champion_01', 'I knew you’d make it here. After all, you’d never\ngive up on a challenge.\rAnd now I shall battle you with all my might!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_ms_leader_talks_10:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_boss_01', '{0,1,0,0}! You finally made it to the top!\rHere in the Master Class, only the strongest\ncome to test their mettle against one another.\rThere’s no room here for the slightest mistake,\nnor a moment’s hesitation!\rAnd now, you are here to challenge me at the\nvery pinnacle of this revered battleground.\rAs the Tower Tycoon of this treasured place—\nand as a Trainer with a true love for Pokémon—\fI shall accept your challenge with all that I have!')
	_JUMP('ev_tower_rooms_if_leader_battle_ms')
	_END()
ev_tower_rooms_if_leader_battle_ms:
	_TALK_CLOSE()
	_CALL('ev_tower_rooms_comanm_sbtl_start')
	_BTWR_SUB_LOCAL_BTL_CALL()
	_BTWR_PLAYER_WIN_CHECK(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_tower_rooms_common_lose')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_tower_rooms_ms_after_check')
	_RET()
ev_tower_rooms_ms_after_check:
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK8)
	_IFVAL_CALL(@LOCALWORK8, 'EQ', 7, 'ev_tower_rooms_ms_leader_talks_after')
	_RET()
ev_tower_rooms_ms_leader_talks_after:
	_BTWR_SUB_GET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK9)
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 1, 'ev_tower_rooms_ms_leader_talksb_01')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 2, 'ev_tower_rooms_ms_leader_talksb_02')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 3, 'ev_tower_rooms_ms_leader_talksb_03')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 4, 'ev_tower_rooms_ms_leader_talksb_04')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 5, 'ev_tower_rooms_ms_leader_talksb_05')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 6, 'ev_tower_rooms_ms_leader_talksb_06')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 7, 'ev_tower_rooms_ms_leader_talksb_07')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 8, 'ev_tower_rooms_ms_leader_talksb_08')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 9, 'ev_tower_rooms_ms_leader_talksb_09')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 10, 'ev_tower_rooms_ms_leader_talksb_10')
	_TALK_CLOSE()
	_RET()
ev_tower_rooms_ms_leader_talksb_01:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c01gym0101_leader_02', 'You might be able to conquer this whole place.')
	_RET()
ev_tower_rooms_ms_leader_talksb_02:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c03gym0101_leader_02', 'Wow. You and your Pokémon have really done a\nlot of growing, too!')
	_RET()
ev_tower_rooms_ms_leader_talksb_03:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c07gym0101_leader_02', 'Feeling a Pokémon’s trust in you... I think that’s\none meaning of strength.')
	_RET()
ev_tower_rooms_ms_leader_talksb_04:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c06gym0101_leader_02', 'He rises and he falls like the rolling of the tide...\nThat’s Crasher Wake!')
	_RET()
ev_tower_rooms_ms_leader_talksb_05:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c05gym0113_leader_02', 'Your groove is truly magnifique!')
	_RET()
ev_tower_rooms_ms_leader_talksb_06:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c02gym0101_leader_02', 'Gwahahahaha! Like son, like father—well done\nbeating us both!')
	_RET()
ev_tower_rooms_ms_leader_talksb_07:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c09gym0101_leader_02', 'Just wait—I’ll become a Gym Leader so dignified\nand cool that everyone will want to be like me!')
	_RET()
ev_tower_rooms_ms_leader_talksb_08:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_c08gym0103_leader_02', 'Go on, then. Somewhere out there, the battle of\nyour dreams awaits!')
	_RET()
ev_tower_rooms_ms_leader_talksb_09:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_champion_02', 'I knew it. Ever since I saw you looking so worried\nfor those Psyduck holding their heads in pain,\fI knew that someday you’d become a Trainer\fwho would take the world by storm!\rNow get going—you’re nearly at the top!\nShow them how strong you truly are!')
	_RET()
ev_tower_rooms_ms_leader_talksb_10:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_ms_boss_02', 'What else is there to say? You came prepared to\nmake it to the top, and that’s just what you did!\rYou know, the thing I love most about being the\nTower Tycoon is taking in the view from up here.\rAs I look over all of Sinnoh, I think about how\neach day starts with a brand new Trainer taking\fthe first step on their Pokémon journey.\rThat thought alone fills me with hope, and today\nthat hope became reality when you defeated me!\rIf we continue this way, passing the baton down\nthrough the generations, then tomorrow will be\fas limitless as time and space itself!\r{0,1,0,0}, you were brilliant!\rNow you can truly declare yourself the winner,\nand carry Sinnoh into a shining future!')
	_OBJ_ANIME('TOWER_PLAYER_07_01', 'anm_d31r0205_enemy_033')
	_OBJ_ANIME_WAIT()
	_LDVAL(@SCWK_TEMP0, 61)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_BTWR_SUB_RENSHOU_RIBBON_SET()
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE01)
	_IF_FLAGOFF_CALL(#FE_BT_M_S_CREAR, 'ev_tower_ms_crear')
	_RET()
ev_tower_rooms_sbtl_ms02:
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK0)
	_NUMBER_NAME(0, @LOCALWORK0)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_66', 'You will be facing opponent number {0,2,0,0}.\nAre you ready?')
	_IFVAL_JUMP(@LOCALWORK0, 'GT', 5, 'ev_tower_rooms_sbtl_ms02_4match_over')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_03', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_05', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 2)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_tower_rooms_next_ms')
	_CASE_JUMP(1, 'ev_tower_rooms_is_rest')
	_CASE_JUMP(2, 'ev_tower_rooms_is_retire_ms')
	_JUMP('ev_tower_rooms_next_ms')
	_END()
ev_tower_rooms_sbtl_ms02_4match_over:
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_03', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 1)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_tower_rooms_next_ms')
	_CASE_JUMP(1, 'ev_tower_rooms_is_retire_ms')
	_JUMP('ev_tower_rooms_next_ms')
	_END()
ev_tower_rooms_next_ms:
	_TALK_CLOSE()
	_CALL('ev_tower_rooms_comanm_guide_out')
	_JUMP('ev_tower_rooms_sbtl_ms1')
	_END()
ev_tower_rooms_sbtl_md1:
	_CALL('ev_tower_rooms_sbtl_call_md')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_tower_rooms_common_lose')
	_CALL('ev_tower_rooms_common_win_param')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 989, 'ev_tower_rooms_common_clear_ret')
	_CALL('ev_tower_rooms_md_eneout')
	_CALL('ev_tower_rooms_comanm_sbtl_end')
	_CALL('ev_tower_rooms_common_heal')
	_JUMP('ev_tower_rooms_sbtl_md02')
	_END()
ev_tower_rooms_sbtl_call_md:
	_CALL('ev_tower_rooms_tag_enein')
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK8)
	_IFVAL_JUMP(@LOCALWORK8, 'EQ', 7, 'ev_tower_rooms_md_leader_talks')
	_TALKMSG_BTOWER_APPEAR(0)
	_TALKMSG_BTOWER_APPEAR(1)
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks:
	_PLAYER_NAME(0)
	_BTWR_SUB_GET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK9)
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 1, 'ev_tower_rooms_md_leader_talks_01')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 2, 'ev_tower_rooms_md_leader_talks_02')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 3, 'ev_tower_rooms_md_leader_talks_03')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 4, 'ev_tower_rooms_md_leader_talks_04')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 5, 'ev_tower_rooms_md_leader_talks_05')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 6, 'ev_tower_rooms_md_leader_talks_06')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 7, 'ev_tower_rooms_md_leader_talks_07')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 8, 'ev_tower_rooms_md_leader_talks_08')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 9, 'ev_tower_rooms_md_leader_talks_09')
	_IFVAL_JUMP(@LOCALWORK9, 'EQ', 10, 'ev_tower_rooms_md_leader_talks_10')
	_END()
ev_tower_rooms_md_leader_talks_01:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c01gym0101_leader_01', 'I’m confident in the rock-solid rapport between\nmy dad and me!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c02gym0101_leader_01', 'Gwahaha! Don’t get so cocky that you let your\nguard down, son!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_02:
	_IF_FLAGOFF_JUMP(#FV_D21R0101_SEVEN2, 'ev_tower_rooms_ms_leader_talks_02_b')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven2_01a', 'Oh! Hi, {0,1,0,0}!\rI almost got lost again, but then I met Cheryl!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven1_01', 'It’s been a while, {0,1,0,0}.\rIt’s always nice to have a traveling companion—\nand right now, mine is Mira!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_ms_leader_talks_02_b:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven2_01b', 'Let’s get out of here together, Cheryl!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven1_01', 'It’s been a while, {0,1,0,0}.\rIt’s always nice to have a traveling companion—\nand right now, mine is Mira!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_03:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c05gym0113_leader_01', 'Please enjoy the spectacle of our duet!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c03gym0101_leader_01', 'Let me lay it on the line—if we work together,\nFantina and I are sure to beat you!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_04:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gkanbu3_01', 'Oh, it’s you... I suppose I’ll set aside our history.\rFor now, I am simply your opponent.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gkanbu2_01', 'Did you want something?\rHow silly of me to even ask.')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_05:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c09gym0101_leader_01', 'When you combine my focus with Maylene’s...\nWell, it’s pretty impressive!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c07gym0101_leader_01', 'Gee, I’m hungry... Oh, sorry, it’s nothing.')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_06:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven3_01', 'Are you ready for us to test out your teamwork\nwith your Pokémon?')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven4_01', 'I hope you and your team are healthy...')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_07:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven5_01a', 'Yo! If it isn’t {0,1,0,0}!\rLet’s see which of us can make it to the top first!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_bigfour2_01', 'Ahaha! Dear child, keep your feet on the ground\nand your head out of the clouds!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_07_b:
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_08:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_bigfour3_01', 'Hiya, {0,1,0,0}!\rStill got those flames burning inside you?')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c08gym0103_leader_01', 'I thought you’d show up, {0,1,0,0}.\rGood thing, too—I was just starting to get bored!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_09:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gkanbu1_01', '{0,1,0,0}, it’s payback time!\rWe’ve got quite the backlog of scores to settle—\nand I’m not about to let you off the hook!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gingaboss_01', 'So, we meet again, {0,1,0,0}.\rIt seems that our fates have become intertwined.\nBut here and now, I will finally break that bond!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_md_leader_talks_10:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_rival_01', 'You made it, {0,1,0,0}!\rI managed to meet my dad here and achieve one\nof the biggest goals my life!\rBut my other goal is to become the greatest\nPokémon Trainer in the world.\rAnd I’m about to achieve it by beating you—\nright here, right now!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_boss_01', 'Hi, {0,1,0,0}! Well done getting this far!\rMy son grew up so much since meeting you\nthat I could hardly recognize him.\rSo please, accept my most sincere thanks!\rAnd now, as the Tower Tycoon, I will face you in\nbattle with all my might—and my son by my side!')
	_JUMP('ev_tower_rooms_if_leader_battle_md')
	_END()
ev_tower_rooms_if_leader_battle_md:
	_TALK_CLOSE()
	_CALL('ev_tower_rooms_comanm_md_start')
	_BTWR_SUB_LOCAL_BTL_CALL()
	_BTWR_PLAYER_WIN_CHECK(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_tower_rooms_md_after_check')
	_RET()
ev_tower_rooms_md_after_check:
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK8)
	_IFVAL_CALL(@LOCALWORK8, 'EQ', 7, 'ev_tower_rooms_md_leader_talks_after')
	_RET()
ev_tower_rooms_md_leader_talks_after:
	_BTWR_SUB_GET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK9)
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 1, 'ev_tower_rooms_md_leader_talksb_01')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 2, 'ev_tower_rooms_md_leader_talksb_02')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 3, 'ev_tower_rooms_md_leader_talksb_03')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 4, 'ev_tower_rooms_md_leader_talksb_04')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 5, 'ev_tower_rooms_md_leader_talksb_05')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 6, 'ev_tower_rooms_md_leader_talksb_06')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 7, 'ev_tower_rooms_md_leader_talksb_07')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 8, 'ev_tower_rooms_md_leader_talksb_08')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 9, 'ev_tower_rooms_md_leader_talksb_09')
	_IFVAL_CALL(@LOCALWORK9, 'EQ', 10, 'ev_tower_rooms_md_leader_talksb_10')
	_TALK_CLOSE()
	_RET()
ev_tower_rooms_md_leader_talksb_01:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c01gym0101_leader_02', 'You smashed through our father-son teamwork...')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c02gym0101_leader_02', 'Well done! I see I still have some training to do!')
	_RET()
ev_tower_rooms_md_leader_talksb_02:
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE02)
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE03)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven2_02', 'Me and Cheryl have no one else left...')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven1_02', 'We’ll just wait here.')
	_RET()
ev_tower_rooms_md_leader_talksb_03:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c05gym0113_leader_02', 'What a spectacular show! Your timing together\nwas idéal!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c03gym0101_leader_02', 'And here I thought we were doing so well!')
	_RET()
ev_tower_rooms_md_leader_talksb_04:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gkanbu3_02', 'I suppose I should have expected this from the\nTrainer who defeated our boss.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gkanbu2_02', 'Next time I’ll send you running away crying!')
	_RET()
ev_tower_rooms_md_leader_talksb_05:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c09gym0101_leader_02', 'I’m so sorry, Maylene! I just couldn’t stay focused!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c07gym0101_leader_02', 'If I hadn’t been so hungry... Oops, never mind!\nI didn’t say anything!')
	_RET()
ev_tower_rooms_md_leader_talksb_06:
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE04)
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE05)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven3_02', 'Whatever you did to prepare for this, you must\nhave been doing it right!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven4_02', 'You’re the best, just the way you are...')
	_RET()
ev_tower_rooms_md_leader_talksb_07:
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE06)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_seven5_02a', 'Heheh! You really are pretty good! Of course,\nit won’t take me long to surpass you.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_bigfour2_02', 'I believe you can go as far as you want.')
	_RET()
ev_tower_rooms_md_leader_talksb_08:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_bigfour3_02', '...\r...\r...\r...Whew. Burnt right down to cinders...')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_c08gym0103_leader_02', 'Hahaha! That was a blast! Right, Flint?\nUhhh... Flint?')
	_RET()
ev_tower_rooms_md_leader_talksb_09:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gkanbu1_02', 'Calm down, Mars... This is all a dream...\nJust a bad dream!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_gingaboss_02', 'Just how long will your legend continue?!')
	_RET()
ev_tower_rooms_md_leader_talksb_10:
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_rival_02', 'Darn it! I seriously still can’t win?! I always seem\nto lose right when it counts!\rIt’s bad enough letting down my dad, let alone\nthe Tower Tycoon... Darn it!!!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_mw_boss_02', 'Bravo, {0,1,0,0}!\rI see you’ve nurtured your relationship with your\nPokémon into an unbreakable bond!\rAnd son, hold your head up high! You’ve got\nabsolutely nothing to be ashamed of.\rYou’ve had a grand adventure with a worthy rival\nand made it all the way here. As a father, nothing\fcould make me prouder!\r{0,1,0,0}, let me thank you once more!\rAnd if it isn’t too much trouble, please keep\nlooking after {1,1,0,0} here.\rNow go—your adventure’s just begun! Reach out\ninto the vast world before you, that endless time\fand borderless space, and grasp it for yourself!\rWalk on!')
	_OBJ_ANIME('TOWER_PLAYER_07_02', 'anm_d31r0205_enemy_033_md')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_d31r0205_hero_033_md')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP0, 61)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_BTWR_SUB_RENSHOU_RIBBON_SET()
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE01)
	_IF_FLAGOFF_CALL(#FE_BT_M_W_CREAR, 'ev_tower_md_crear')
	_RET()
ev_tower_rooms_sbtl_md02:
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK0)
	_NUMBER_NAME(0, @LOCALWORK0)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_66', 'You will be facing opponent number {0,2,0,0}.\nAre you ready?')
	_IFVAL_JUMP(@LOCALWORK0, 'GT', 5, 'ev_tower_rooms_sbtl_md02_4match_over')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_03', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_05', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 2)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_tower_rooms_next_md')
	_CASE_JUMP(1, 'ev_tower_rooms_is_rest')
	_CASE_JUMP(2, 'ev_tower_rooms_is_retire_md')
	_JUMP('ev_tower_rooms_next_md')
	_END()
ev_tower_rooms_sbtl_md02_4match_over:
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_03', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 1)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_tower_rooms_next_md')
	_CASE_JUMP(1, 'ev_tower_rooms_is_retire_md')
	_JUMP('ev_tower_rooms_next_md')
	_END()
ev_tower_rooms_next_md:
