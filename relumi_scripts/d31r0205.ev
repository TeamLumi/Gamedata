ev_tower_rooms_if_leader_battle:
	_BTWR_SUB_GET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'NE', 0, 'ev_tower_rooms_sbtl_02')
	_BTWR_SUB_GET_RENSHOU_CNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 20, 'ev_tower_rooms_leader_comin')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 48, 'ev_tower_rooms_leader_comin')
	_JUMP('ev_tower_rooms_sbtl_02')
	_END()
ev_tower_rooms_leader_comin:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_01_1', 'Congratulations on your winning\nstreak, challenger!')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_01_2', 'The Tower Tycoon has sent word that he is\nimpressed with you.\rHe recognizes your skill, and he’d like to\nchallenge you to a battle!')
	_JUMP('ev_tower_rooms_leader_comin_re')
ev_tower_rooms_leader_comin_re:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_01_3', 'Are you ready to battle the Tower Tycoon?')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_03', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 1)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_tower_rooms_leader_entry')
	_CASE_JUMP(1, 'ev_tower_rooms_is_leader_retire')
	_JUMP('ev_tower_rooms_leader_entry')
	_END()
ev_tower_rooms_leader_entry:
	_CALL('ev_tower_rooms_comanm_guide_out')
	_CALL('ev_tower_rooms_comanm_leader_in')
	_BTWR_SUB_GET_RENSHOU_CNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 48, 'ev_tower_rooms_leader_talk_01')
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_02_1', 'Hi! My name’s Palmer.\rI remember you from when you were in\nTwinleaf, {0,1,0,0}.\rYou were always playing with my son\n{1,1,0,0}, right?')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_02_2', 'You’ve grown up since then—and most\nimpressively, too!\rSo, I’d like you to show me.\rShow me the bond you’ve built with\nyour Pokémon.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_02_3', 'Show me the skill you’ve acquired as a Trainer!')
	_JUMP('ev_tower_rooms_leader_talk01_end')
	_END()
ev_tower_rooms_is_leader_retire:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_68', 'Would you like to cancel your\nBattle Room challenge?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_tower_rooms_common_retire')
	_JUMP('ev_tower_rooms_leader_comin_re')
	_END()
ev_tower_rooms_leader_talk01_end:
	_TALK_CLOSE()
	_BTWR_SUB_GET_NOW_ROUND(@SCWK_ANSWER)
	_LDVAL(@LOCALWORK1, @SCWK_ANSWER)
	_CALL('ev_tower_rooms_comanm_sbtl_start')
	_BTWR_SUB_LOCAL_BTL_CALL()
	_BTWR_PLAYER_WIN_CHECK(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_tower_rooms_common_lose')
	_BTWR_SUB_GET_RENSHOU_CNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 48, 'ev_tower_rooms_leader_talk_02')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_04_1', 'Bravo!\rOne day, I imagine my son will come challenge\nme, just as you have.\rThat’s something I look forward to a great deal.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_04_2', 'You will become even more skilled, the very\nsame way your father did.\rKeep battling Trainers from around the world and\nkeep growing greater in stature!')
	_JUMP('ev_tower_rooms_leader_talk02_end')
	_END()
ev_tower_rooms_leader_talk02_end:
	_TALK_CLOSE()
	_CALL('ev_tower_rooms_common_win_param')
	_FLAG_SET(#FE_TOWER_MASTER_WINED)
	_BTWR_SUB_GET_RENSHOU_CNT(@SCWK_REG3)
	_JUMP('ev_tower_rooms_common_clear_ret')
	_END()
ev_tower_rooms_leader_talk_01:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_03_1', 'So, you’ve come this far!\rAs the Tower Tycoon, I’ll have to give you my\nbest effort.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_03_2', 'That’s how the best Trainers show respect to\neach other.\rBy battling all out as dedicated students\nof Pokémon!')
	_JUMP('ev_tower_rooms_leader_talk01_end')
	_END()
ev_tower_rooms_leader_talk_02:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_05_1', 'Bravo! I feel inspired in my heart!\rIt brings back a memory of that day long ago...')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_05_2', 'I went out to the lake with your father that day.\rWe were attacked by a wild Pokémon.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_05_3', 'We fended it off, but I don’t recall how. It was\nthat desperate.\rThat was my first step as a Trainer. I wonder if the\nprofessor is doing well?\r...That’s enough reminiscing.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_05_4', 'My young friend, the world and your future hold\ninfinite promise.')
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_boss_05_5', 'Go on—you can be all that you desire!\nThere is no limit to where you can go!')
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE01)
	_JUMP('ev_tower_rooms_leader_talk02_end')
	_END()
ev_tower_rooms_sbtl_02:
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK0)
	_NUMBER_NAME(0, @LOCALWORK0)
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_66', 'You will be facing opponent number {0,2,0,0}.\nAre you ready?')
	_IFVAL_JUMP(@LOCALWORK0, 'GT', 5, 'ev_tower_rooms_sbtl_02_4match_over')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_03', 0)
