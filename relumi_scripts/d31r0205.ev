	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_68', 'Would you like to cancel your\nBattle Room challenge?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_tower_rooms_common_retire')
	_JUMP('ev_tower_rooms_sbtl_ms02')
	_END()
ev_tower_rooms_is_retire_md:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_68', 'Would you like to cancel your\nBattle Room challenge?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_tower_rooms_common_retire')
