ev_tower_rooms_common_clear_ret:
	_LDVAL(@WK_SCENE_D31R0201, 1)
	_FLAG_SET(#1756)
	_BTWR_SUB_SET_SCORE()
	_FLAG_RESET(#1756)
	_IF_FLAGOFF_CALL(#1755, 'ev_tower_gate_charenge_add_only_once')
	_BTWR_SUB_ADD_BATTLE_POINT(@SCWK_REG1)
	_BTWR_TOOL_SET_NOW_WIN(0)
	_BTWR_SUB_GET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_BTWR_SUB_GET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK2)
	_BTWR_SUB_RANK_DOWN_LOSE_RESET(@WK_BATTLE_TOWER_MODE)
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 0, 'ev_tower_rooms_common_clear_ret_n')
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 1, 'ev_tower_rooms_common_clear_ret_n')
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 2, 'ev_tower_rooms_common_clear_ret_m')
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 3, 'ev_tower_rooms_common_clear_ret_m')
	_JUMP('ev_tower_rooms_common_clear_ret2')
ev_tower_rooms_common_clear_ret2:
	_BTWR_SUB_GET_RENSHOU_CNT(@SCWK_REG3); Round Count
	_LDVAL(@SCWK_REG2, @WK_BATTLE_TOWER_MODE)
	_BTWR_TOOL_SET_PLAY_MODE(-1)
	_JUMP('ev_tower_rooms_common_exit')
	_END()
ev_tower_rooms_common_clear_ret_n:
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 7, 'ev_tower_rooms_common_clear_ret_reset')
	_ADD_WK(@LOCALWORK2, 1)
	_BTWR_TOOL_SET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK2)
	_JUMP('ev_tower_rooms_common_clear_ret2')
	_END()
ev_tower_rooms_common_clear_ret_m:
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 10, 'ev_tower_rooms_common_clear_ret_m_runkmax')
	_ADD_WK(@LOCALWORK2, 1)
	_BTWR_TOOL_SET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK2)
	_JUMP('ev_tower_rooms_common_clear_ret2')
	_END()
ev_tower_rooms_common_clear_ret_m_runkmax:
	_FLAG_SET(#FE_BT_M_RUNK_MAX)
	_JUMP('ev_tower_rooms_common_clear_ret2')
