	_JUMP('ev_tower_rooms_common_lose2')
	_END()
ev_tower_rooms_common_lose_m_d:
	_SUB_WK(@LOCALWORK2, 1)
	_BTWR_TOOL_SET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK2)
	_BTWR_SUB_RANK_DOWN_LOSE_RESET(@WK_BATTLE_TOWER_MODE)
	_FLAG_SET(#FE_BT_M_LOSE_RUNK_DOWN)
	_JUMP('ev_tower_rooms_common_lose2')
