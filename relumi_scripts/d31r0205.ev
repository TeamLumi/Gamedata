ev_tower_rooms_common_clear_ret_reset:
	_BTWR_TOOL_SET_RANK(@WK_BATTLE_TOWER_MODE, 1)
	_JUMP('ev_tower_rooms_common_clear_ret2')
	_END()
ev_tower_rooms_common_retire:
	_LDVAL(@LOCALWORK0, 1)
	_LDVAL(@WK_SCENE_D31R0201, 3)
	_BTWR_SUB_SET_SCORE()
	_IF_FLAGOFF_CALL(#1755, 'ev_tower_gate_charenge_add_only_once')
	_BTWR_TOOL_SET_NOW_WIN(0)
	_BTWR_SUB_GET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_BTWR_SUB_ADD_LOSE(@WK_BATTLE_TOWER_MODE)
	_BTWR_SUB_RANK_DOWN_LOSE(@WK_BATTLE_TOWER_MODE, @SCWK_TEMP1)
	_JUMP('ev_tower_rooms_common_lose1')
	_END()
ev_tower_rooms_common_rest:
	_LDVAL(@WK_SCENE_D31R0201, 2)
	_BTWR_SUB_SET_SCORE()
	_IF_FLAGOFF_CALL(#1755, 'ev_tower_gate_charenge_add_only_once')
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_JUMP('ev_tower_rooms_common_exit_escape')
	_END()
ev_tower_rooms_common_win_param:
	_LDVAL(@SCWK_REG2, @WK_BATTLE_TOWER_MODE)
	_IFVAL_CALL(@SCWK_REG2, 'EQ', 2, 'ev_bt_master_rank_wins_count')
	_IFVAL_CALL(@SCWK_REG2, 'EQ', 3, 'ev_bt_master_rank_wins_count')
	_BTWR_SUB_INC_ROUND()
	_BTWR_SUB_GET_NOW_ROUND(@LOCALWORK7)
	_IFVAL_CALL(@LOCALWORK7, 'EQ', 8, 'tower_win')
	_RET()
tower_win:
	_LDVAL(@SCWK_ANSWER, 989)
	_RET()
ev_bt_master_rank_wins_count:
	_ADD_WK(@WK_BT_MASTER_ACCUMULATION_WINS, 1)
	_ADD_WK(@WK_BT_MASTER_WINS_COUNT, 1)
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_LOOP, 'ev_bt_master_rank_wins_count_loop')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 10, 'ev_prize_get_ok_10')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 20, 'ev_prize_get_ok_20')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 30, 'ev_prize_get_ok_30')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 40, 'ev_prize_get_ok_40')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 50, 'ev_prize_get_ok_50')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 100, 'ev_prize_get_ok_100')
	_IFVAL_JUMP(@WK_BT_MASTER_WINS_COUNT, 'EQ', 200, 'ev_prize_get_ok_200')
	_RET()
ev_bt_master_rank_wins_count_loop:
