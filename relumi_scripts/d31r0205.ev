ev_d31r0205_obj_change:
	_JUMP('ev_d31r0205_obj_pos_change')
	_END()
ev_d31r0205_obj_pos_change:
	_OBJ_POS_CHANGE_WORLD('TOWER_GATE_05', 2, 0, 6)
	_END()
ev_tower_rooms_common_exit:
	_TIME_WAIT(30, @SCWK_ANSWER)
	_SWITCH(@SCWK_REG2)
	_CASE_JUMP(2, 'ev_tower_rooms_comexit_01')
	_CASE_JUMP(3, 'ev_tower_rooms_comexit_01')
	_MAP_CHANGE('D31R0201', 1)
	_EVENT_END()
	_END()
ev_tower_rooms_comexit_01:
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_10, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_20, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_30, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_40, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_50, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_75, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_100, 'ev_tower_rooms_mclass_prize_get')
	_IF_FLAGON_CALL(#FE_BT_M_WINS_PRESENT_GET_200, 'ev_tower_rooms_mclass_prize_get')
	_MAP_CHANGE('D31R0201', 2)
	_EVENT_END()
	_END()
ev_tower_rooms_mclass_prize_get:
	_FLAG_SET(#FE_BT_M_RETURN_PRESENT_GET)
	_RET()
ev_tower_rooms_common_exit_escape:
	_BTWR_SUB_GET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_SWITCH(@WK_BATTLE_TOWER_MODE)
	_CASE_JUMP(2, 'ev_tower_rooms_comexit_01')
	_CASE_JUMP(3, 'ev_tower_rooms_comexit_01')
	_MAP_CHANGE('D31R0201', 1)
	_EVENT_END()
	_END()
ev_tower_rooms_common_exit_lose:
	_SWITCH(@SCWK_REG2)
	_CASE_JUMP(2, 'ev_tower_rooms_comexit_01')
	_CASE_JUMP(3, 'ev_tower_rooms_comexit_01')
	_MAP_CHANGE('D31R0201', 1)
	_EVENT_END()
	_END()
ev_tower_rooms_common_heal:
	_MACRO_TALKMSG('dialogue_d31r0205', '45-msg_tower_65', 'Your Pokémon will be restored to full health.')
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_RET()
ev_tower_rooms_common_entry:
	_EVENT_START()
	_LDVAL(@WK_SCENE_D31R0205, 3)
	_LDVAL(@SCWK_ANSWER, 0)
	_CALL('ev_tower_rooms_comanm_in'); Some animations?
	; No double battle call here??
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 2, 'ev_tower_rooms_sbtl_ms1')
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 3, 'ev_tower_rooms_sbtl_md1')
	_JUMP('ev_tower_rooms_sbtl_01')
	_END()
ev_tower_rooms_common_continue:
	_EVENT_START()
	_LDVAL(@WK_SCENE_D31R0205, 3)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 989, 'ev_tower_rooms_common_exit')
	_CALL('ev_tower_rooms_comanm_in')
	_CALL('ev_tower_rooms_comanm_continue')
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 2, 'ev_tower_rooms_sbtl_ms02')
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 3, 'ev_tower_rooms_sbtl_md02')
	_JUMP('ev_tower_rooms_if_leader_battle')
	_END()
ev_tower_rooms_sbtl_01:
	_CALL('ev_tower_rooms_common_sbtl_call')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_tower_rooms_common_lose')
	_CALL('ev_tower_rooms_common_win_param')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 989, 'ev_tower_rooms_common_clear_ret')
	_CALL('ev_tower_rooms_comanm_eneout')
	_CALL('ev_tower_rooms_comanm_sbtl_end')
	_CALL('ev_tower_rooms_common_heal')
	_JUMP('ev_tower_rooms_if_leader_battle')
	_END()
ev_tower_rooms_common_sbtl_call:
	_CALL('ev_tower_rooms_comanm_enein')
	_TALKMSG_BTOWER_APPEAR(0)
	_TALK_CLOSE()
	_CALL('ev_tower_rooms_comanm_sbtl_start')
	_BTWR_SUB_LOCAL_BTL_CALL()
	_BTWR_PLAYER_WIN_CHECK(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP0, @SCWK_ANSWER)
	_RET()
ev_tower_rooms_common_lose:
	_LDVAL(@WK_SCENE_D31R0201, 4)
	_BTWR_SUB_SET_SCORE()
	_IF_FLAGOFF_CALL(#1755, 'ev_tower_gate_charenge_add_only_once')
	_BTWR_TOOL_SET_NOW_WIN(0)
	_BTWR_SUB_GET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_BTWR_SUB_ADD_LOSE(@WK_BATTLE_TOWER_MODE)
	_BTWR_SUB_RANK_DOWN_LOSE(@WK_BATTLE_TOWER_MODE, @SCWK_TEMP1)
	_JUMP('ev_tower_rooms_common_lose1')
	_JUMP('ev_tower_rooms_common_lose2')
ev_tower_rooms_common_lose1:
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 0, 'ev_tower_rooms_common_lose_n')
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 1, 'ev_tower_rooms_common_lose_n')
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 2, 'ev_tower_rooms_common_lose_m')
	_IFVAL_JUMP(@WK_BATTLE_TOWER_MODE, 'EQ', 3, 'ev_tower_rooms_common_lose_m')
	_JUMP('ev_tower_rooms_common_lose2')
	_JUMP('ev_tower_rooms_common_lose2')
ev_tower_rooms_common_lose2:
	_LDVAL(@SCWK_REG2, @WK_BATTLE_TOWER_MODE)
	_BTWR_TOOL_SET_PLAY_MODE(-1)
	_JUMP('ev_tower_rooms_common_exit_lose')
	_END()
ev_tower_rooms_common_lose_n:
	_BTWR_TOOL_SET_RANK(@WK_BATTLE_TOWER_MODE, 1)
	_BTWR_SUB_RANK_DOWN_LOSE_RESET(@WK_BATTLE_TOWER_MODE)
	_JUMP('ev_tower_rooms_common_lose2')
	_END()
ev_tower_rooms_common_lose_m:
	_BTWR_SUB_GET_RANK(@WK_BATTLE_TOWER_MODE, @LOCALWORK2)
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 1, 'ev_tower_rooms_common_lose_n_d')
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 10, 'ev_tower_rooms_common_lose_m10')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 2, 'ev_tower_rooms_runkdown_losecount_r2')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 3, 'ev_tower_rooms_runkdown_losecount_r3')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 4, 'ev_tower_rooms_runkdown_losecount_r4')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 5, 'ev_tower_rooms_runkdown_losecount_r5')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 6, 'ev_tower_rooms_runkdown_losecount_r6')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 7, 'ev_tower_rooms_runkdown_losecount_r7')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 8, 'ev_tower_rooms_runkdown_losecount_r8')
	_IFVAL_CALL(@LOCALWORK2, 'EQ', 9, 'ev_tower_rooms_runkdown_losecount_r9')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', @SCWK_TEMP3, 'ev_tower_rooms_common_lose_m_d')
	_JUMP('ev_tower_rooms_common_lose2')
	_END()
ev_tower_rooms_runkdown_losecount_r2:
	_LDVAL(@SCWK_TEMP3, 4)
	_RET()
ev_tower_rooms_runkdown_losecount_r3:
