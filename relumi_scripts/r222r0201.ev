ev_r222r0201_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_R222R0201)
	_END()
ev_r222r0201_hikaku:
	_TALK_OBJ_START()
	_TEMOTI_BOX_POKE_CHK(@SCWK_ANSWER, 223)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r222r0201_01')
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_02_1', 'I had a dream! It was a wonderful dream!\rI dreamed that a Trainer would bring me a\ngiant Remoraid!')
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_02_2', 'Oh my gosh! That dream was no dream! H-how\nbig of a Remoraid did you bring me?!')
	_TALK_CLOSE()
	_POKELIST_SET_PROC(11)
	_POKELIST_GET_RESULT(@SCWK_PARAM2, @SCWK_PARAM3)
	_IFVAL_JUMP(@SCWK_PARAM2, 'EQ', -1, 'ev_r222r0201_hikaku_cancel')
	_TEMOTI_BOX_MONSNO(@SCWK_PARAM2, @SCWK_PARAM3, @SCWK_PARAM1)
	_IFVAL_JUMP(@SCWK_PARAM1, 'NE', 223, 'ev_r222r0201_hikaku_07')
	_OOKISA_RECORD_CHK(@SCWK_ANSWER, @SCWK_PARAM2, @SCWK_PARAM3)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r222r0201_hikaku_06')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r222r0201_hikaku_05')
	_OOKISA_TEMOTI_SET_BUF(0, 1, @SCWK_PARAM2, @SCWK_PARAM3)
	_TALKMSG('dialogue_r222r0201%187-msg_r222r0201_hikaku_03')
	_LDVAL(@SCWK_TEMP0, 6)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r222r0201_hikaku_08')
	_CALL('ev_item_event')
	_OOKISA_RECORD_SET(@SCWK_PARAM2, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_04', 'Thank you! I really enjoyed this. I think I’ll dream\nof an even bigger Remoraid tonight.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r222r0201_01:
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_01', 'I had a dream! It was a wonderful dream!\rI dreamed that a Trainer would bring me a\ngiant Remoraid!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r222r0201_hikaku_05:
	_OOKISA_KIROKU_SET_BUF(0, 1, 223)
	_TALKMSG('dialogue_r222r0201%187-msg_r222r0201_hikaku_05')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r222r0201_hikaku_06:
	_OOKISA_TEMOTI_SET_BUF(0, 1, @SCWK_PARAM2, @SCWK_PARAM3)
	_OOKISA_KIROKU_SET_BUF(2, 3, 223)
	_TALKMSG('dialogue_r222r0201%187-msg_r222r0201_hikaku_06')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r222r0201_hikaku_07:
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_07', 'Wha—? What do you think you’re showing me?\nDid you even listen to what I had to say?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r222r0201_hikaku_08:
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_08', 'Your Bag’s jammed full... I can’t give you this...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r222r0201_hikaku_cancel:
	_MACRO_TALKMSG('dialogue_r222r0201', '187-msg_r222r0201_hikaku_09', 'Oh, what? Why would you deny me the chance\nto measure your Remoraid?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()