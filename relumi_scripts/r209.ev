ev_r209_flag_change:
	_RESET_SYS_FLAG($SYS_FLAG_MAP_INFO_STOP)
	_GET_TIME_ZONE(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_r209_fc_morning')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_r209_fc_noon')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 2, 'ev_r209_fc_evening')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 3, 'ev_r209_fc_night')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 4, 'ev_r209_fc_midnight')
	_END()
ev_r209_fc_morning:
	_FLAG_RESET(#FV_R209_JOGGER1_TR)
	_FLAG_RESET(#FV_R209_JOGGER6_TR)
	_FLAG_SET(#FV_R209_JOGGER1_NPC)
	_FLAG_SET(#FV_R209_JOGGER6_NPC)
	_OBJ_DEL('R209_JOGGER1')
	_OBJ_DEL('R209_JOGGER6')
	_END()
ev_r209_fc_noon:
	_JUMP('ev_r209_fc_midnight')
ev_r209_fc_evening:
	_JUMP('ev_r209_fc_midnight')
ev_r209_fc_night:
	_JUMP('ev_r209_fc_midnight')
ev_r209_fc_midnight:
	_FLAG_RESET(#FV_R209_JOGGER1_NPC)
	_FLAG_RESET(#FV_R209_JOGGER6_NPC)
	_FLAG_SET(#FV_R209_JOGGER1_TR)
	_FLAG_SET(#FV_R209_JOGGER6_TR)
	_OBJ_DEL('TR_JOGGER_01')
	_OBJ_DEL('TR_JOGGER_06')
	_END()
ev_r209_middleman1:
	_MACRO_EASY_OBJ_MSG('dialogue_r209', '59-msg_r209_middleman1_01', 'Where departed Pokémon sleep...\nThis is the Lost Tower.')
	_END()
ev_r209_buneary:
	_TALK_OBJ_START()
	_VOICE_PLAY(427, 0 , 0)
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_08', 'Kukuuh...\nBuneary seems very hungry.\rIt may want a Sitrus Berry.')
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_09', 'Give a Sitrus Berry to Buneary?')
	_YES_NO_WIN(@246)
	_IFVAL_JUMP(@246, 'EQ', 1, 'ev_r209_buneary_dialogue_no')
	_JUMP('ev_r209_buneary_item_check')
	_END()
ev_r209_buneary_dialogue_no:
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_10', 'Buneary looks sad.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_buneary_item_check:
	_ITEM_CHK(158, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r209_buneary_item_check_fail')
	_JUMP('ev_r209_buneary_item_check_successful')
ev_r209_buneary_item_check_fail:
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_11', 'You do not have a Sitrus Berry.')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_10', 'Buneary looks sad.')
	_TALK_CLOSE()
	_END()
ev_r209_buneary_item_check_successful:
	_SUB_ITEM(158, 1, @SCWK_ANSWER)
	_VOICE_PLAY(427, 0 , 0)
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_12', 'Nii nii!\nBuneary ate the Sitrus Berry.\rIt was delighted!')
	_TALK_CLOSE()
	_OBJ_ANIME('R209_BUNEARY', 'anm_r209_Buneary_mew')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_r209_mew_hero')
	_OBJ_ANIME_WAIT()
	_WHITE_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_OBJ_DEL('R209_BUNEARY')
	_TIME_WAIT(10, @246)
	_FLAG_SET(#2817)
	_OBJ_ADD('R209_MEW')
	_FLAG_RESET(#2816)
	_WHITE_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_VOICE_PLAY(151, 0 , 0)
	_OBJ_ANIME('HERO', 'anm_r209_mew_hero_g')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_04', 'Myuu...')
	_TALK_CLOSE()
	_WHITE_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_TIME_WAIT(10, @246)
	_FLAG_SET(#2816)
	_OBJ_DEL('R209_MEW')
	_WHITE_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_MACRO_TALKMSG('dialogue_r209', '18-msg_mew_13', 'The strange Pokémon disappeared,\nbut it looked very happy.')
	_FLAG_RESET(#2092)
	_FLAG_RESET(#2813); Enable Torchic
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_r209_mew_hero:
	_AC_DIR_R(8)
	_ACMD_END()
anm_r209_mew_hero_g:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_r209_Buneary_mew:
	_AC_DIR_D(4)
	_AC_DOWN(1,4)
	_AC_DIR_R(4)
	_AC_RIGHT(5,4)
	_AC_DIR_L(4)
	_ACMD_END()
ev_r209_mikage:
	_TALK_START()
	_LDVAL(@SCWK_TEMP0, 111)
	_IFVAL_JUMP(@WK_SCENE_R209, 'EQ', 1, 'ev_r209_mikage_09')
	_ITEM_CHK(111, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r209_mikage_01')
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_02', 'There is a broken, crumbling tower made\nof stone...\rThere seems to be a spot that would be a\nperfect fit for the Odd Keystone.\rWould you like to use the Odd Keystone?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r209_mikage_03')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_03:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_03', '{0,1,0,0} pushed the Odd Keystone\ninto the stone tower.\rThe stone tower has been restored!\n“Hallowed Tower” is written on it.')
	_SUB_ITEM(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_LDVAL(@WK_SCENE_R209, 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_surechigai_check:
	_GET_UG_NPC_TALK_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 32, 'ev_r209_mikage_09')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 29, 'ev_r209_mikage_08')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 22, 'ev_r209_mikage_07')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 15, 'ev_r209_mikage_06')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 8, 'ev_r209_mikage_05')
	_JUMP('ev_r209_mikage_04')
	_END()
ev_r209_mikage_09:
	_SE_WAIT('UI_COMMON_SELECT')
	_VOICE_PLAY(442, 0, 0)
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_09', 'Yulaaah!')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET(442, 35)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 442)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_r209_mikage_battle_lose')
	_RESET_UG_NPC_TALK_COUNT()
	_LDVAL(@WK_SCENE_R209, 0)
	_TALK_END()
	_END()
ev_r209_mikage_battle_lose:
	_TALK_END()
	_END()
ev_r209_mikage_04:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_04', 'It’s the Hallowed Tower. It appears to have been\nbuilt many years ago.')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_05:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_05', 'It’s the Hallowed Tower. Its stones appear to\nhave shifted...')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_06:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_06', 'It’s the Hallowed Tower. ...Is that crying coming\nfrom inside the tower?')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_07:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_07', 'It’s the Hallowed Tower. ...Is the tower shaking\never so slightly?')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_08:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_08', 'It’s the Hallowed Tower. There is some sort of\npresence... It appears ready to emerge!')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_mikage_01:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mikage_01', 'There is a broken, crumbling tower made\nof stone...')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_r209_fishing1:
	_TALK_OBJ_START_TURN_NOT()
	_LDVAL(@SCWK_TEMP0, 446, 1)
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_IF_FLAGON_JUMP(#FE_IITURIZAO_GET, 'ev_r209_fishing1_flag_on')
	_TALKMSG('dialogue_r209%59-msg_r209_fishing1_01')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r209_fishing1_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r209_fishing1_no')
	_END()
ev_r209_fishing1_flag_on:
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_fishing1_03', 'Try fishing wherever there is a body of water.\rOh, incidentally, do you need me to explain how\nto use that fishing rod?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r209_fishing1_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r209_fishing1_06')
	_END()
ev_r209_fishing1_05:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_fishing1_05', 'First, you face a body of water. Then, you use\nyour fishing rod.\rNext, you must focus. If a Pokémon bites,\nan “!” appears. That’s your cue to reel it in!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_fishing1_06:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_fishing1_06', 'Have fun!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_fishing1_no:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_fishing1_04', 'You don’t like to fish?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_fishing1_yes:
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_fishing1_02', 'Hmm! We’re of identical minds! Take this\n{0,1,9,0}, hmm!')
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FE_IITURIZAO_GET)
	_FLAG_SET(#FE_TURIZAO_GET)
	_JUMP('ev_r209_fishing1_flag_on')
	_JUMP('ev_r209_sign1')
ev_r209_sign1:
	_EASY_BOARD_MSG('dialogue_r209%59-msg_r209_sign1_01', 'BOARD_TYPE_ROAD', 0, 2)
	_END()
ev_r209_sign2:
	_EASY_BOARD_MSG('dialogue_r209%59-msg_r209_sign2_01', 'BOARD_TYPE_ROAD', 0, 3)
	_END()
ev_r209_sign3:
	_EASY_INFOBOARD_MSG('dialogue_r209%59-msg_r209_sign3_01', 'BOARD_TYPE_INFO', 0)
	_END()
ev_r209_jogger1:
	_MACRO_EASY_OBJ_MSG('dialogue_r209', '59-msg_r209_jogger_01_01', 'Do you jog every morning, too?')
	_END()
ev_r209_jogger6:
	_MACRO_EASY_OBJ_MSG('dialogue_r209', '59-msg_r209_jogger_06_01', 'When I was jogging the other day, a wild\nPokémon came after me.\rI ran so fast, I was on top of the waves, I swear.')
	_END()
ev_r209_girl2_iro_01:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_girl2_iro_01', 'Yah! Ha! Yay!\rI’m training for a Super Contest Show with my\nBibarel here!')
	_IF_FLAGON_JUMP(#FE_C05R1101_CONTEST_FIRST, 'ev_r209_girl2_iro_01_seen02')
	_JUMP('ev_r209_girl2_iro_01_talk_end')
ev_r209_girl2_iro_01_talk_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_girl2_iro_01_seen02:
	_IF_FLAGON_JUMP(#FE_R209_SEAL_GET1, 'ev_r209_girl2_iro_01_talk_end')
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_girl2_iro_02', 'Oh?\rLooks to me like you’ve already participated in a\nSuper Contest Show. You beat me to the punch!\rAn experienced contestant like you\ndeserves these!')
	_LDVAL(@SCWK_TEMP0, 22)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R209_SEAL_GET1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_woman1_iro_01:
	_TALK_OBJ_START()
	_ITEM_CHK(449, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r209_woman1_iro_01_seen02')
	_JUMP('ev_r209_woman1_iro_01b')
	_END()
ev_r209_woman1_iro_01b:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_woman1_iro_01', 'Hm? I sense the presence of a Trainer who\nloves Pokémon...\rYou’re just the sort of person that the chairman\nof the Pokémon Fan Club has been looking for.')
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_woman1_iro_02', 'The Pokémon Fan Club Chairman should be in\nHearthome City...')
	_TALK_CLOSE()
	_FLAG_SET(#FE_R209_TALK2)
	_TALK_OBJ_END()
	_END()
ev_r209_woman1_iro_01_seen02:
	_IF_FLAGON_JUMP(#FE_R209_SEAL_GET2, 'ev_r209_woman1_iro_01_seen03')
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_woman1_iro_03', 'Hm? Yes, I knew that you and the Pokémon Fan\nClub Chairman would hit it off.\rI’m so happy that you’ve become one of us.\nPlease take these as a token of our friendship.')
	_LDVAL(@SCWK_TEMP0, 41)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R209_SEAL_GET2)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_woman1_iro_01_seen03:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_woman1_iro_04', 'You and I are both Pokémon Fan Club members,\nso let’s keep in touch.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_campboy_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_HIDEN_04_GET, 'ev_r209_campboy_iro_01_seen02')
	_JUMP('ev_r209_campboy_iro_01b')
	_END()
ev_r209_campboy_iro_01b:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_campboy_iro_01', 'I wonder what’s at the top of the Lost Tower...\rI’m very curious, but I’m also very scared.')
	_TALK_CLOSE()
	_FLAG_SET(#FE_R209_TALK3)
	_TALK_OBJ_END()
	_END()
ev_r209_campboy_iro_01_seen02:
	_IF_FLAGON_JUMP(#FE_R209_SEAL_GET3, 'ev_r209_campboy_iro_01_seen03')
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_campboy_iro_02', 'Whoa! You climbed the Lost Tower? No way!\rAnd you saw two elderly women at the top?\nI wonder what they’re doing there...\rThank you for telling me about what’s up there.\nPlease take these—they’re yours, if you want.\rTo be honest, I’m not even sure where I\ngot them...')
	_LDVAL(@SCWK_TEMP0, 52)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R209_SEAL_GET3)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_campboy_iro_01_seen03:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_campboy_iro_03', 'The Lost Tower is frightening, but I find myself\nstrangely drawn to it...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_mount_iro_01:
	_TALK_OBJ_START()
	_GET_STATUE_NUM(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r209_mount_iro_01b')
	_JUMP('ev_r209_mount_iro_01_seen02')
	_END()
ev_r209_mount_iro_01b:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mount_iro_01', 'Have you heard? There are statues that you can\ndig up from the walls of the Grand Underground.\fI’d love to see a statue for myself someday.')
	_TALK_CLOSE()
	_FLAG_SET(#FE_R209_TALK4)
	_TALK_OBJ_END()
	_END()
ev_r209_mount_iro_01_seen02:
	_IF_FLAGON_JUMP(#FE_R209_SEAL_GET4, 'ev_r209_mount_iro_01_seen03')
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mount_iro_02', 'Oh, that’s a statue! Did you find it underground?\rI’ve always wanted to see one of these!\nI’ll give these to you as my way of saying thanks.')
	_LDVAL(@SCWK_TEMP0, 8)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R209_SEAL_GET4)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_mount_iro_01_seen03:
	_MACRO_TALKMSG('dialogue_r209', '59-msg_r209_mount_iro_03', 'There’s an adventure in every statue!\nThere’s a statue in every adventure!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r209_biidaru:
	_EASY_VOICE_MSG('dialogue_r209%59-msg_r209_biidaru', 'PLAY_PV_EV_400_00_00')
	_END()
ev_r209_goosu:
	_EASY_VOICE_MSG('dialogue_r209%59-msg_r209_goosu', 'PLAY_PV_EV_092_00_00')
	_END()
ev_r209_mukubird:
	_EASY_VOICE_MSG('dialogue_r209%59-msg_r209_mukubird', 'PLAY_PV_EV_397_00_00')
	_END()
ev_r209_police_blocker:
	_MACRO_EASY_OBJ_MSG('dialogue_r209', '00_msg_209_police_blocker_1', 'Excuse me!\rWe currently have a hostile situation\noccurring at the Pokémon Mansion.\rThis path has been blocked off to\nstop the criminals from escaping.\rThank you for your co-operation\nat this time.')
	_END(); Flag 2713
pos_r209_police_blocker:
	_TALK_OBJ_START(); @479, expects 0
	_OBJ_ANIME('R209_POLICE_BLOCKER', 'anm_r209_police_blocker_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_r209', '00_msg_209_police_blocker_2', 'Excuse me!\rWe currently have a hostile situation\noccurring at the Pokémon Mansion.\rThis path has been blocked off to\nstop the criminals from escaping.\rThank you for your co-operation\nat this time.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_r209_police_blocker_2')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
anm_r209_police_blocker_1:
	_AC_DIR_D(4)
	_AC_MARK_GYOE()
	_ACMD_END()
anm_r209_police_blocker_2:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_ACMD_END()