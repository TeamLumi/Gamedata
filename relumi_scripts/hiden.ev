ev_hiden_naminori_02:
	_IF_FLAGOFF_CALL($SYS_FLAG_USE_TODAY_NAMINORI, 'ev_hiden_naminori_msg')
	_TALK_CLOSE()
	_BICYCLE_REQ(0); No bikes on a fish to fix bike glitch
	;;_CUTIN(57)
	_NAMINORI(0); 0 = Check player settings for surf music
	_GET_NOW_ZONE_ID(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 385, 'ev_hiden_naminori_r213flag')
	_TALK_END()
	_END()
ev_hiden_naminori_menu:
	_GET_NOW_ZONE_ID(@SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 661, 'ev_distortionr0101_naminori_menu'); Jumps to the Distortion World Naminori Menu script, if the player is there.
	_CALL('ev_hiden_naminori_surf_check')
	_EVENT_START()
	_IF_FLAGOFF_CALL($SYS_FLAG_USE_TODAY_NAMINORI, 'ev_hiden_naminori_msg')
	_TALK_CLOSE()
	_OBJ_PAUSE_CLEAR('FLDOBJ_ID_PLAYER')
	;;_CUTIN(57)
	_BICYCLE_REQ(0); No bikes on a fish to fix bike glitch
	_NAMINORI(0); 0 = Check player settings for surf music
	_OBJ_PAUSE('FLDOBJ_ID_PLAYER')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 385, 'ev_hiden_naminori_r213flag')
	_TALK_END()
	_END()
ev_hiden_naminori_end:
	_EVENT_START()
	_NAMINORI_END()
	_BICYCLE_REQ(0); No bikes on a fish to fix bike glitch
	_TALK_END()
	_END()
