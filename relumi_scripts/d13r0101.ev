ev_d13r0101_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D13R0101)
	_FLAG_SET(#FV_WALL_PUT)
	_OBJ_DEL('D13R0101_WALL01')
	_OBJ_DEL('D13R0101_WALL02')
	_IFVAL_JUMP(@WK_SCENE_D13R0101, 'EQ', 0, 'ev_d13r0101_wall')
	_IFVAL_JUMP(@WK_SCENE_D13R0101, 'GE', 1, 'ev_d13r0101_farm_time_check')
	_END()
ev_d13r0101_wall:
	_FLAG_RESET(#FV_WALL_PUT)
	_OBJ_ADD('D13R0101_WALL01')
	_OBJ_ADD('D13R0101_WALL02')
	_SXY_POS_CHANGE('D13R0101_MIDDLEMAN1', 32, 37)
	_SXY_POS_CHANGE('D13R0101_MOUNT', 12, 46)
	_SXY_POS_CHANGE('D13R0101_BABYBOY1', 12, 47)
	_MOVE_CODE_CHANGE('D13R0101_MIDDLEMAN1', 46); Makes the man look nervously look between the two grunts
	_MOVE_CODE_CHANGE('D13R0101_BABYBOY1', 0)
	_RET()
ev_d13r0101_farm_time_check:
	_GET_TIME_ZONE(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'LE', 2, 'ev_d13r0101_farm_add_actors'); Morning, Noon and Evening
	_JUMP('ev_d13r0101_farm_del_actors')
ev_d13r0101_farm_add_actors:
	_PLAYER_POS_GET(@LOCALWORK0, @LOCALWORK1)
	_OBJ_ADD('D13R0101_MOUNT')
	_OBJ_ADD('D13R0101_BABYBOY1')
	_IFCOORDS_CALL('D13R0101_MOUNT', @LOCALWORK0, @LOCALWORK1, 'ev_d13r0101_farm_move_mount'); Moves the NPC by a tile if the player saved where they are standing before a time change.
	_IFCOORDS_CALL('D13R0101_BABYBOY1', @LOCALWORK0, @LOCALWORK1, 'ev_d13r0101_farm_move_babyboy1'); Moves the NPC by a tile if the player saved where they are standing before a time change.
	_FLAG_RESET(#2708)
	_FLAG_RESET(#2709)
	_RET()
ev_d13r0101_farm_del_actors:
	_OBJ_DEL('D13R0101_MOUNT')
	_OBJ_DEL('D13R0101_BABYBOY1')
	_FLAG_SET(#2708)
	_FLAG_SET(#2709)
	_RET()
ev_d13r0101_farm_move_mount:
	_SXY_POS_CHANGE('D13R0101_MOUNT', 33, 34)
	_RET()
ev_d13r0101_farm_move_babyboy1:
	_SXY_POS_CHANGE('D13R0101_BABYBOY1', 14, 22)
	_RET()
pos_d13r0101_mount:
	_EVENT_START()
	_CHARA_LOOK_LOCK('D13R0101_MOUNT', 'HERO')
	_CHARA_LOOK_LOCK('D13R0101_BABYBOY1', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D13R0101_MOUNT')
	_CHARA_LOOK_RELEASE('D13R0101_BABYBOY1')
	_OBJ_ANIME('D13R0101_MOUNT', 'anm_d13r0101_mount_pos_1')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'D13R0101_MOUNT')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_mount_pos_1', 'Trainer!\nPlease, you must help us!')
	_OBJ_ANIME('D13R0101_MOUNT', 'anm_d13r0101_mount_pos_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_mount_pos_2', 'A dear friend of mine is being harassed by a\ncouple of weird space men in the berry field.')
	_CHARA_LOOK_LOCK('D13R0101_MOUNT', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D13R0101_MOUNT')
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_mount_pos_3', 'I would be forever in your debt if you could\nchase them off with your Pokémon.')
	_TALK_CLOSE()
	_OBJ_ANIME('D13R0101_MOUNT', 'anm_d13r0101_mount_pos_2')
	_OBJ_ANIME('D13R0101_BABYBOY1', 'anm_d13r0101_mount_pos_2')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME_WAIT()
	_LDVAL(@534, 1)
	_EVENT_END()
	_END()
anm_d13r0101_mount_pos_1:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_d13r0101_mount_pos_2:
	_AC_DIR_R(4)
	_AC_WAIT(2)
	_ACMD_END()
ev_d13r0101_mount:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_D13R0101, 'GE', 1, 'ev_d13r0101_mount_farm')
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_mount_1', 'I would be forever in your debt if you could\nchase off those space men with your Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_mount_farm:
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_mount_farm_1', 'This meadow is the perfect place for your\nberries to grow.\rThe Combee living in the Honey Tree pollinate\nall of the plant-life here.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_babyboy1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2701, 'ev_d13r0101_babyboy1_complete')
	_IFVAL_JUMP(@WK_SCENE_D13R0101, 'GE', 1, 'ev_d13r0101_babyboy1_farm')
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_babyboy1_1', 'Please save our berry farm!\rI don’t want the wild Pokémon to be afraid to\nplay here.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_babyboy1_farm:
	_CALL('ev_d13r0101_babyboy1_vivillon_check')
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_babyboy1_farm_1', 'There used to be a Pokémon that would play\nhide and seek in the meadow.\rIt was really good at it too, because it looked\nexactly like a Poké Ball!\rI think it left to play with its friends.\rI hope it comes back soon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_babyboy1_vivillon_check:
	_TEMOTI_POKE_CHK(@SCWK_ANSWER, 666)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_babyboy1_vivillon_no')
	_TEMOTI_POKE_CHK_GET_POS(@SCWK_TEMP0, 666); Index, MonsNo
	_TEMOTI_FORMNO(@SCWK_TEMP0, @SCWK_TEMP1); Index, Result
	_GET_CAUGHT_LOCATION(@SCWK_TEMP0, -1, @SCWK_TEMP2); Index, TrayIndex, Result
	_IFVAL_JUMP(@SCWK_TEMP1, 'NE', 19, 'ev_d13r0101_babyboy1_vivillon_no')
	_IFVAL_JUMP(@SCWK_TEMP2, 'NE', 253, 'ev_d13r0101_babyboy1_vivillon_no')
	_JUMP('ev_d13r0101_babyboy1_vivillon')
ev_d13r0101_babyboy1_vivillon:
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_babyboy1_vivillon_1', 'Oh! You caught the Vivillon that likes to play\nin the meadow!\rIsn’t its pattern the coolest?')
	_TALK_CLOSE()
	_FLAG_SET(#2701); Vivillon shown to Floaroma Meadow boy
	_TALK_OBJ_END()
	_END()
ev_d13r0101_babyboy1_vivillon_no:
	_RET()
ev_d13r0101_babyboy1_complete:
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_babyboy1_complete_1', 'Do you wanna hear something cool?\rDad took me to the library in Canalave City\nand we found this book about Vivillon.\rThere are lots of different patterns and\nsome scientists found out that you can\fdecide what pattern it will become by\fgiving it certain berries before it evolves!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_d13r0101_ginga_double_battle:
	_LDVAL(@SCWK_TEMP1, 221)
	_LDVAL(@SCWK_TEMP2, 222)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_double_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP1, @SCWK_TEMP2)
	_RET()
pos_d13r0101_ginga:
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 32, 1, 40)
	_EVENT_CAMERA_INDEX(500)
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CALL('pos_d13r0101_gingam_a_common_01')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 3700, 'ev_d02_townmap_apd1')
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'pos_d13r0101_ginga_battle')
	_IFVAL_CALL(@SCWK_ANSWER, 'GT', 1, 'pos_d13r0101_ginga_double_battle')
	_CALL('pos_d13r0101_gingam_a_common_03')
	_SET_SYS_FLAG($SYS_FLAG_BGM_D13)
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 3900, 'ev_d02_townmap_apd3')
	_CALL('ev_d13r0101_shaymin_event')
	_CHARA_LOOK_RELEASE('HERO')
	_EVENT_CAMERA_INDEX(600)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_d13r0101_mount_thanks')
	_TALK_END()
	_END()
anm_d13r0101_hm_left:
	_AC_DIR_L(8)
	_AC_WAIT(2)
	_AC_LEFT(1, 8)
	_AC_DIR_D(8)
	_AC_WAIT(2)
	_AC_DOWN(8, 8)
	_AC_DIR_L(8)
	_AC_WAIT(2)
	_AC_LEFT(6, 8)
	_ACMD_END()
ev_d13r0101_honeyman_left:
	_OBJ_ANIME('D13R0101_MIDDLEMAN1', 'anm_d13r0101_hm_left')
	_OBJ_ANIME_WAIT()
	_SXY_POS_CHANGE('D13R0101_MIDDLEMAN1', 12, 46)
	_MOVE_CODE_CHANGE('D13R0101_MIDDLEMAN1', 0)
	_RET()
anm_d13r0101_shaymin_enter_right_1:
	_AC_LEFT(6, 8)
	_ACMD_END()
anm_d13r0101_shaymin_enter_right_2:
	_AC_LEFT(4, 8)
	_AC_WAIT(2)
	_AC_MARK_GYOE()
	_AC_DIR_D(8)
	_AC_DOWN(3, 8)
	_AC_DIR_L(8)
	_AC_WAIT(2)
	_ACMD_END()
anm_d13r0101_honey_yes:
	_AC_ANIME_DURATION(0.110000)
	_AC_INDEX_ANIME(4, 1)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
anm_d13r0101_honey_yes_emo:
	_AC_MARK_EMO(2)
	_ACMD_END()
anm_d13r0101_honey_no:
	_AC_ANIME_DURATION(0.110000)
	_AC_INDEX_ANIME(4, 1)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
anm_d13r0101_honey_no_emo:
	_AC_MARK_EMO(12)
	_ACMD_END()
anm_d13r0101_honey_no_player_1:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_d13r0101_honey_no_player:
	_AC_FACE_INDEX(5)
	_ACMD_END()
anm_d13r0101_face_normal:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_d13r0101_turn_right:
	_AC_DIR_R(8)
	_ACMD_END()
anm_d13r0101_turn_left:
	_AC_DIR_L(8)
	_ACMD_END()
anm_d13r0101_shaymin_enter_emo_1:
	_AC_MARK_EMO(9)
	_ACMD_END()
anm_d13r0101_shaymin_enter_emo_2:
	_AC_MARK_EMO(11)
	_ACMD_END()
anm_d13r0101_look_down:
	_AC_NECK_ROTATE(0, 30, 0, 4); Yaw Pitch Roll Speed
	_ACMD_END()
anm_d13r0101_look_default:
	_AC_NECK_ROTATE(0, 0, 0, 4); Yaw Pitch Roll Speed
	_ACMD_END()
anm_d13r0101_shaymin_leave:
	_AC_DIR_D(8)
	_AC_DOWN(4, 8)
	_ACMD_END()
ev_d13r0101_shaymin_event_right:
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_shaymin_enter_right_1')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'D13R0101_SHAYMIN')
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_shaymin_enter_right_2')
	_JUMP('ev_d13r0101_shaymin_event_anm')
ev_d13r0101_shaymin_event_anm:
	_TIME_WAIT(60, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(501)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_d13r0101_look_down')
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_shaymin_enter_emo_1')
	_PLAY_EMO_SE(9)
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(8, @SCWK_ANSWER)
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_shaymin_enter_emo_2')
	_PLAY_EMO_SE(11)
	_OBJ_ANIME_WAIT()
	_RET()
ev_d13r0101_shaymin_event:
	_CALL('ev_d13r0101_honeyman_left')
	_OBJ_ADD('D13R0101_SHAYMIN')
	_FLAG_RESET(#2856)
	_CALL('ev_d13r0101_shaymin_event_right')
	_VOICE_PLAY(492, 0, 0)
	_MACRO_TALKMSG('dialogue_d13r0101', '00_d13r0101_shaymin_question_1', 'The Pokémon seems to be sniffing your bag...\rIt seems interested in the honey\nyou just obtained.\rWould you like to give the Pokémon\nsome honey?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_shaymin_honey')
	_JUMP('ev_d13r0101_shaymin_no_honey')
ev_d13r0101_shaymin_honey:
	_MACRO_TALKMSG('dialogue_d13r0101', '00_d13r0101_shaymin_given_honey', 'You gave the Pokémon some Honey!')
	_TALK_CLOSE()
	_VOICE_PLAY(492, 0, 0)
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_honey_yes')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_honey_yes_emo')
	_PLAY_EMO_SE(2)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', '00_d13r0101_shaymin_mental_herb', 'The Pokémon seems to have something\nfor you...')
	_LDVAL(@SCWK_TEMP0, 219); Mental Herb
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_d13r0101_look_default')
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_shaymin_leave')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('D13R0101_SHAYMIN')
	_RET()
ev_d13r0101_shaymin_no_honey:
	_MACRO_TALKMSG('dialogue_d13r0101', '00_d13r0101_shaymin_no_honey', 'You kept the Honey for yourself.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_d13r0101_honey_no_player_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', '00_d13r0101_shaymin_takes_honey', 'The Pokémon is trying to take the honey!')
	_TALK_CLOSE()
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_honey_no')
	_OBJ_ANIME('HERO', 'anm_d13r0101_honey_no_player')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('D13R0101_SHAYMIN', 'anm_d13r0101_honey_no_emo')
	_PLAY_EMO_SE(12)
	_OBJ_ANIME_WAIT()
	_CAMERA_SHAKE(12, 1, 0, 15, 180)
	_BLACK_OUT()
	_FADE_WAIT()
	_FLAG_SET(#2856)
	_OBJ_DEL('D13R0101_SHAYMIN')
	_OBJ_ANIME('HERO', 'anm_d13r0101_face_normal')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_d13r0101_look_default')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_BLACK_IN()
	_FADE_WAIT()
	_SUB_ITEM(85, 1, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d13r0101', '00_d13r0101_shaymin_has_left', 'The Pokémon seems to have taken the honey\nand fled...')
	_TALK_CLOSE()
	_RET()
pos_d13r0101_ginga_battle:
	_OBJ_ANIME('GINGAM_01', 'anm_d13r0101_exclamation_mark')
	_OBJ_ANIME('GINGAM_02', 'anm_d13r0101_exclamation_mark')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', '00_msg_d13r0101_gingam_01_rp', 'Ha! This kid has one Pokémon!\nYou can’t take us on two-on-one!')
	_MACRO_TALK_KEYWAIT('dialogue_d13r0101', '00_msg_d13r0101_gingam_02_rp', 'Too bad, kid!\nYoure so gonna lose now!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 221)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_LDVAL(@SCWK_TEMP3, 222)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_RET()
ev_d02_townmap_apd1:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 3800)
	_RET()
ev_d02_townmap_apd2:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 3900)
	_RET()
ev_d02_townmap_apd3:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 4000)
	_RET()
