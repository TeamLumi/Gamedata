	_AC_MARK_GYOE()
	_END()
anm_d13r0101_action_3:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_VAL(4, 330)
	_AC_WAIT(2)
	_ACMD_END()
anm_d13r0101_action_4:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_VAL(4, 30)
	_AC_WAIT(2)
	_ACMD_END()
pos_d13r0101_gingam_a_common_01:
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_a_01', 'Enough arguing! Hand over that sweet Honey!')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_b_01', 'Do as we say!\nTeam Galactic will have that Honey!\rWe must have it to attract Pokémon in\ngreat numbers!')
	_CHARA_LOOK_LOCK('D13R0101_GINGAM_A', 'HERO')
	_CHARA_LOOK_LOCK('D13R0101_GINGAM_B', 'HERO')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('D13R0101_MIDDLEMAN1', 'anm_d13r0101_gingam_a_01')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D13R0101_GINGAM_A')
	_CHARA_LOOK_RELEASE('D13R0101_GINGAM_B')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('D13R0101_GINGAM_A', 'anm_d13r0101_gingam_a_01_g')
	_OBJ_ANIME('D13R0101_GINGAM_B', 'anm_d13r0101_gingam_a_01_g')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_a_02', 'Hey! This kid is a witness! What’ll we do?')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_b_02', 'We can’t have the brat running off to get help.\rThe solution’s simple... We must ensure the brat\nstays quiet!')
	_TALK_CLOSE()
	_OBJ_ANIME('D13R0101_GINGAM_A', 'anm_d13r0101_action_3')
	_OBJ_ANIME('D13R0101_GINGAM_B', 'anm_d13r0101_action_4')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_RET()
pos_d13r0101_gingam_a_common_02:
	_OBJ_ANIME('D13R0101_GINGAM_A', 'anm_d13r0101_gingam_a_11')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_a_03', 'This is so lame...\nThey’re going to dock my pay!')
	_TALK_CLOSE()
	_OBJ_ANIME('D13R0101_GINGAM_A', 'anm_d13r0101_gingam_a_21')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_a_04', 'I’m up next! Heheheh...\rBattling you right after my cohort has weakened\nyou gives me the edge!')
	_TALK_CLOSE()
	_RET()
pos_d13r0101_gingam_a_common_03:
	_CHARA_LOOK_LOCK('D13R0101_GINGAM_A', 'D13R0101_GINGAM_B')
	_CHARA_LOOK_LOCK('D13R0101_GINGAM_B', 'D13R0101_GINGAM_A')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D13R0101_GINGAM_A')
	_CHARA_LOOK_RELEASE('D13R0101_GINGAM_B')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_gingam_a_05', 'This brat’s tough! Like, really, really tough!\nTougher than I can put into words, and I know\fa lot of words!\rWe’re done for now... Let’s get back to the\nValley Windworks.')
	_TALK_CLOSE()
	_BLACK_OUT()
	_FADE_WAIT()
	_OBJ_DEL('D13R0101_GINGAM_A')
	_OBJ_DEL('D13R0101_GINGAM_B')
	_LDVAL(@WK_SCENE_D13R0101, 1)
	_FLAG_RESET(#FV_D13R0101_ITEM)
	_OBJ_ADD('D13R0101_ITEM')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_BLACK_IN()
	_FADE_WAIT()
	_OBJ_ANIME('D13R0101_MIDDLEMAN1', 'anm_d13r0101_middleman1_11')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('D13R0101_ITEM')
	_CHARA_LOOK_LOCK('D13R0101_MIDDLEMAN1', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'D13R0101_MIDDLEMAN1')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_01', 'Oh, what’s this thing? They seem to have\nforgotten it...\rIt’s a Works Key... It must be for the\nValley Windworks!\rIt’s of no use to me. You may as well have it.')
	_LDVAL(@SCWK_TEMP0, 438)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FE_D13R0101_ITEM)
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_08_1', 'Thank you! You surely saved me.\rThose goons were trying to rob me of my sweet,\nsweet Honey.')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_08_2', 'They sure were weird, though. You saw how they\nwere dressed.\rWhat they were saying didn’t make a whole lot\nof sense, either.\rOh! I need to thank you! Will you take this as\nmy thanks?')
	_LDVAL(@SCWK_TEMP0, 94)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_middleman1_item_event_fail')
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_02', 'If you slather that Honey on a sweet-smelling\ntree, it might attract Pokémon.')
	_JUMP('ev_d13r0101_middleman1_item_event_common')
ev_d13r0101_middleman1_item_event_fail:
	_CALL('ev_item_event_fail')
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_05', 'Oopsy! You can’t hold any more.')
	_JUMP('ev_d13r0101_middleman1_item_event_common')
ev_d13r0101_middleman1_item_event_common:
	_FLAG_SET(#FE_D13R0101_AMAIMITU_GET)
	_FLAG_SET(#FV_WALL_PUT)
	_OBJ_DEL('D13R0101_WALL01')
	_OBJ_DEL('D13R0101_WALL02')
	_CHARA_LOOK_RELEASE('D13R0101_MIDDLEMAN1')
	_CHARA_LOOK_RELEASE('HERO')
	_TALK_CLOSE()
	_RET()
ev_d13r0101_gingam_a:
	_JUMP('ev_d13r0101_gingam_b')
ev_d13r0101_gingam_b:
	_END()
ev_d13r0101_middleman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_03', 'Honey can attract Pokémon if it’s slathered on a\ntree and left a while.\rWould you like to buy some Honey for a\nmere 100?')
	_MONEY_OPEN()
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_842', 3)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_843', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_844', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(3, 'ev_d13r0101_middleman1_buyone')
	_CASE_JUMP(2, 'ev_d13r0101_middleman1_buyten')
	_CASE_JUMP(1, 'ev_d13r0101_middleman1_no')
	_JUMP('ev_d13r0101_middleman1_no')
	_END()
ev_d13r0101_middleman1_buyone:
	_COMP_GOLD(@SCWK_ANSWER, 100)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_middleman1_no_money')
	_LDVAL(@SCWK_TEMP0, 94)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_middleman1_item_full')
	_SUB_GOLD(100)
	_CALL('ev_item_event')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_middleman1_buyten:
	_COMP_GOLD(@SCWK_ANSWER, 1000)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_middleman1_no_money')
	_LDVAL(@SCWK_TEMP0, 94)
	_LDVAL(@SCWK_TEMP1, 10)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d13r0101_middleman1_item_full')
	_SUB_GOLD(1000)
	_CALL('ev_item_event')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_middleman1_no:
	_MONEY_CLOSE()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_07', 'Oopsy! Well, come again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_middleman1_item_full:
	_MONEY_CLOSE()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_05', 'Oopsy! You can’t hold any more.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_middleman1_no_money:
	_MONEY_CLOSE()
	_MACRO_TALKMSG('dialogue_d13r0101', '99-msg_d13r0101_middleman1_06', 'Oopsy! You don’t have enough money.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d13r0101_item:
	_TALK_OBJ_START()
	_LDVAL(@SCWK_TEMP0, 438)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_FLAG_SET(#FE_D13R0101_ITEM)
	_OBJ_DEL('D13R0101_ITEM')
	_TALK_OBJ_END()
	_END()

ev_d13r0101_mount_thanks:
	_SXY_POS_CHANGE('D13R0101_MOUNT', 25, 46)
	_SXY_POS_CHANGE('D13R0101_BABYBOY1', 24, 46)
	_SXY_DIR_CHANGE('D13R0101_MOUNT', 270)
	_SXY_DIR_CHANGE('D13R0101_BABYBOY1', 270)
	_OBJ_ANIME('HERO', 'anm_d13r0101_dir_down')
	_OBJ_ANIME('D13R0101_MOUNT', 'anm_d13r0101_mount_thanks_1')
	_OBJ_ANIME('D13R0101_BABYBOY1', 'anm_d13r0101_babyboy1_thanks_1')
	_TIME_WAIT(25, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('HERO', 'D13R0101_MOUNT')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('HERO')
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_mount_thanks', 'Thank goodness for you, Trainer.\nYou have my gratitude in perpetuity.\rThis berry farm is my property and thanks to\nyou, it is safe.\rSo please, feel free to help yourself to any of\nthe berries growing here and don’t be shy\fabout planting any here yourself.\rYou’ll need to stop by to water them but I\nshall watch over them and will make sure the\fMurkrow don’t steal them.')
	_TALK_CLOSE()
	_OBJ_ANIME('D13R0101_MOUNT', 'anm_d13r0101_mount_thanks_2')
	_OBJ_ANIME_WAIT()
	_OBJ_POS_CHANGE_WORLD('D13R0101_MOUNT', 0, 0, 0)
	_OBJ_DEL('D13R0101_MOUNT')
	_CHARA_LOOK_LOCK('HERO', 'D13R0101_BABYBOY1')
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_babyboy1_thanks', 'Thank you for protecting our farm!\rI’d like it a lot if you wanted to visit and chat\nabout Pokémon with me.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'anm_d13r0101_dir_down')
	_OBJ_ANIME('D13R0101_BABYBOY1', 'anm_d13r0101_babyboy1_thanks_2')
	_OBJ_ANIME_WAIT()
	_OBJ_POS_CHANGE_WORLD('D13R0101_BABYBOY1', 0, 0, 0)
	_OBJ_DEL('D13R0101_BABYBOY1')
	_RET()
anm_d13r0101_dir_down:
	_AC_DIR_D(8)
	_AC_WAIT(2)
	_ACMD_END()
anm_d13r0101_mount_thanks_1:
	_AC_RIGHT(6, 8)
	_AC_DIR_U(8)
	_AC_WAIT(2)
	_AC_UP(5, 8)
	_AC_DIR_VAL(4, 235)
	_AC_WAIT(2)
	_ACMD_END()
anm_d13r0101_babyboy1_thanks_1:
	_AC_RIGHT(6, 8)
	_AC_WAIT(12)
	_AC_RIGHT(1, 8)
	_AC_DIR_U(8)
	_AC_WAIT(2)
	_AC_UP(4, 8)
	_AC_DIR_VAL(4, 210)
	_AC_WAIT(2)
	_ACMD_END()
anm_d13r0101_mount_thanks_2:
	_AC_DIR_R(4)
	_AC_WAIT(2)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_AC_WAIT(2)
	_AC_DOWN(5, 8)
	_AC_DIR_R(8)
	_AC_WAIT(2)
	_AC_RIGHT(7, 8)
	_ACMD_END()
anm_d13r0101_babyboy1_thanks_2:
	_AC_DIR_D(4)
	_AC_WAIT(1)
	_AC_DOWN(4, 4)
	_AC_DIR_R(4)
	_AC_WAIT(1)
	_AC_RIGHT(8, 4)
	_ACMD_END()
ev_d13r0101_disguised_vivillon_flag:
	_IF_FLAGOFF_JUMP(#2410, 'ev_d13r0101_disguised_vivillon_flag_off')
	_IF_FLAGOFF_JUMP(#2411, 'ev_d13r0101_disguised_vivillon_flag_off')
	_IF_FLAGOFF_JUMP(#2412, 'ev_d13r0101_disguised_vivillon_flag_off')
	_FLAG_RESET(#2927)
	_RET()
ev_d13r0101_disguised_vivillon_flag_off:
	_RET()
ev_d13r0101_vivillon_item:
	_TALK_START()
	_TURN_HERO_TALK_OBJ()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SXY_POS_CHANGE('HERO', 32, 17)
	_SXY_DIR_CHANGE('HERO', 180)
	_OBJ_ANIME('HERO', 'anm_d13r0101_neck_down')
	_EVENT_CAMERA_INDEX(559)
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_vivillon_item_1', 'This item seems strange...\nPick it up?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d13r0101_vivillon_item_no')
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('HERO', 'anm_item_get_pose_a')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_WHITE_OUT('SCR_WIPE_DIV', 4)
	_FADE_WAIT()
	_OBJ_DEL('D13R0101_VIVILLON_ITEM')
	_FLAG_SET(#2927)
	_OBJ_ADD('D13R0101_VIVILLON')
	_FLAG_RESET(#2928)
	_WHITE_IN('SCR_WIPE_DIV', 4)
	_FADE_WAIT()
	_OBJ_ANIME('HERO', 'anm_d13r0101_neck_normal_surprise')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(666, 0, 0); MonsNo, Formno, VoiceType
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_vivillon_item_2', 'Vivliv!!')
	_OBJ_ANIME('D13R0101_VIVILLON', 'anm_d13r0101_vivillon')
	_PLAY_EMO_SE(5)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_vivillon_item_3', 'It looks friendly!\nDoes it want to play battle?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_d13r0101_vivillon_item_no:
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
anm_item_get_pose_a:
	_AC_ANIME_DURATION(0.130000)
	_AC_INDEX_ANIME(12, 1)
	_AC_WAIT(24)
	_AC_INDEX_ANIME(74, 1)
	_ACMD_END()
anm_d13r0101_neck_down:
	_AC_NECK_ROTATE(0, 25, 0, 1); Yaw Pitch Roll Speed
	_ACMD_END()
anm_d13r0101_neck_normal_surprise:
	_AC_NECK_ROTATE(0, 0, 0, 2); Yaw Pitch Roll Speed
	_AC_MARK_GYOE()
	_ACMD_END()
anm_d13r0101_vivillon:
	_AC_ANIME_DURATION(0.05)
	_AC_INDEX_ANIME(10)
	_AC_MARK_EMO(5)
	_ACMD_END()
ev_d13r0101_vivillon:
	_TALK_OBJ_START()
	_VOICE_PLAY(666, 0, 0); MonsNo, Formno, VoiceType
	_MACRO_TALKMSG('dialogue_d13r0101', 'msg_d13r0101_vivillon', 'Vivlivliiv!!!')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET_EXTRA(666, 19, 25, 3, -1, -1, -1, -1, 2)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_ANSWER, 666)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_d13r0101_vivillon_caught')
	_TALK_OBJ_END()
	_END()
ev_d13r0101_vivillon_caught:
	_OBJ_DEL('D13R0101_VIVILLON')
	_FLAG_SET(#2928)
	_RET()