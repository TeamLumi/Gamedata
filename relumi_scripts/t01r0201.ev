	_MACRO_EASY_OBJ_MSG('dialogue_t01r0201', '23-msg_t01r0201_rivalmama_05', 'Let me think... Knowing my boy, he would\nprobably head straight to Jubilife City...\rOK, please take that to my {1,1,0,0}.')
	_END()
ev_t01r0201_tv:
	_TALK_OBJ_START()
	_GET_TIME_ZONE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t01r0201_tv_morning')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t01r0201_tv_noon')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_t01r0201_tv_evening')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_t01r0201_tv_night')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_t01r0201_tv_midnight')
	_END()
ev_t01r0201_tv_morning:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_tv_01_1', 'Here we are! It’s the Contest Digest!\rThe Star of the Show in today’s Normal Rank\nCuteness Contest is...')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_tv_01_2', 'Brooke, who entered a breathtakingly\nagile Pokémon!\rThat’s all the time we have today!\nUntil next time!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_tv_noon:
	_JUMP('ev_t01r0201_tv_evening')
ev_t01r0201_tv_evening:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_tv_02_1', 'Here we are! It’s the Contest Digest!\rThe Star of the Show in today’s Normal Rank\nCleverness Contest is...')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_tv_02_2', 'Westley, who won with his particularly well-\ngroomed Pokémon!\rThat’s all the time we have today!\nLet’s meet again!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_tv_night:
	_JUMP('ev_t01r0201_tv_midnight')
ev_t01r0201_tv_midnight:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_tv_03_1', 'Here we are! It’s the Contest Digest!\rThe Star of the Show in today’s Normal Rank\nToughness Contest is...')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_tv_03_2', 'Dominic, who overwhelmed with his eerily\nvocal Pokémon!\rThat’s all the time we have today!\nLet’s meet again!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_freezer:
	_MACRO_EASY_OBJ_MSG('dialogue_t01r0201', '23-msg_t01r0201_freezer_01', 'Mom’s favorite dessert is in the refrigerator.')
	_END()
ev_t01r0201_sink:
	_MACRO_EASY_OBJ_MSG('dialogue_t01r0201', '23-msg_t01r0201_sink_01', 'Mom’s kitchen is spotless! You can see your face\non the floor!')
	_END()
ev_t01r0201_counter:
	_MACRO_EASY_OBJ_MSG('dialogue_t01r0201', '23-msg_t01r0201_counter_01', 'This is where Mom does all her\ndelicious cooking.')
	_END()
pos_t01r0201_mama_cap:
	_EVENT_START()
	_CALL('ev_block_doc')
	_CHARA_LOOK_LOCK('HERO', 'T01R0201_MAMA')
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('T01R0201_MAMA')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_28', 'Oh, {0,1,0,0}!\rYou’re forgetting something important.')
	_LDVAL(@SCWK_TEMP0, 126)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(4, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2454); Clothing Chapter
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_clothing_change', 'Would you like to change before\nheading out on your adventure?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'pos_t01r0201_mama_change_clothes_hat')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'pos_t01r0201_mama_change_clothes')
	_TALK_CLOSE()
	_FLAG_SET(#FE_DONE_FUREAI)
	_SET_SYS_FLAG($SYS_FUREAI_EXIT)
	_AC_ANIM_LOCK('HERO')
	_BLACK_OUT()
	_FADE_WAIT()
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('HERO')
	_GET_PLAYER_CAP()
	_LDVAL(@WK_SCENE_T01R0201, 6)
	_MAP_CHANGE('T01', 0)
	_TALK_CLOSE()
	_TALK_END()
	_END()
pos_t01r0201_mama_change_clothes_hat:
	_MACRO_TALKMSG('dialogue_t01r0201', 'msg_t01r0201_mama_change_clothes_hat', 'It’s cold outside. Remember to put on your\nhat, {0}.')
	_RET()
pos_t01r0201_mama_change_clothes:
	_TALK_CLOSE()
	_GET_COSTUME(@LOCALWORK4)
	_SHOP_OPEN_BOUTIQUE_CHANGE()
	_DPR_SHOP_OPEN_WAIT()
	_GET_COSTUME(@LOCALWORK5)
	_IFVAL_CALL(@LOCALWORK5, 'NE', @LOCALWORK4, 'ev_c07r0101_shop_chg')
	_RET()
pos_t01r0201_oak_event:
	_EVENT_START()
	_CALL('ev_block_doc')
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MAP_CHANGE('T01', 0)
	_TALK_END()
	_END()
