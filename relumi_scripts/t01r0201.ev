ev_t01r0201_mama_midnight:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_20', 'Welcome home, {0,1,0,0}. Are you and your\nPokémon healthy?\rIt’s so late right now... Take a quick rest, dear.')
	_RET()
ev_t01r0201_mama_bag_after:
	_MACRO_TALKMSG('dialogue_t01r0201', 'msg_t01r0201_mama_bag_after', 'I think you need to visit Professor Rowan in his\nlab in Sandgem Town.\rYou need to properly thank him for giving you\none of his Pokémon.')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_5', 'I’m sure he will be grateful you did.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_poke_get:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_1', 'What’s up, dear?\r...\rWow. I can’t believe that happened to you.')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_2', 'Am I ever glad that both you and\n{0,1,0,0} are unharmed.\rThe professor you mentioned is most likely\nProfessor Rowan of Sandgem Town.', 1, 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_3', 'I’ve heard that he is well known for his studies\non Pokémon. I hear he’s also quite intimidating...', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_4', '{1,1,0,0}, I think you need to visit him in\nSandgem Town.\rYou need to properly thank him for giving \nyou one of his Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_5', 'I’m sure he will be grateful you did.', 1)
	_TALK_CLOSE()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_06', 'If you’re going to catch up with him, you’d\nbetter take these!')
	_SYS_FLAG_BAG_SET()
	_ADD_ITEM(17, 1, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_07', 'You received a pair of <color=#F01E1EFF>Running Shoes</color>!')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_08_1', 'With those Running Shoes, you can get to\nplaces much faster.')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_08_2', 'OK, let me read the instructions...\r“Tilt the Left Stick firmly and dash about faster\nthan ever before!”', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_08_3', '“Put on the Running Shoes and blaze new trails\nof adventure!”\rWell, isn’t that just nifty!', 1)
	_TALK_CLOSE()
	_LDVAL(@WK_SCENE_T01R0201, 4)
	_TALK_OBJ_END()
	_END()
