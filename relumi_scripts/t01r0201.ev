pos_t01r0201_mama:
	_EVENT_START()
	_JUMP('pos_t01r0201_mama_01_a')
	_END()
pos_t01r0201_mama_01_a:
	_OBJ_ANIME('HERO', 'anm_t01r0201_player_01_01')
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'HERO')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t01r0201_mama')
	_END()
common_t01r0201_mama:
	_LDVAL(@WK_SCENE_T01R0201, 2)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 500)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_03_1', 'Oh, yes! {0,1,0,0}! Don’t go into the tall\ngrass. Wild Pokémon might attack you.')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_03_2', 'It would be OK if you had your own Pokémon,\nbut you don’t, so...', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('T01R0201_MAMA')
	_TALK_END()
	_END()
