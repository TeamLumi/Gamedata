	_LDVAL(@SCWK_TEMP0, 459)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FE_BOUKENNOOTO_GET)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_16', 'Bye-bye, {0,1,0,0}!\nEnjoy your adventure!', 1, 1)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_rivalmama_05', 'Let me think... Knowing my boy, he would\nprobably head straight to Jubilife City...\rOK, please take that to my {1,1,0,0}.', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'T01R0201_RIVALMAMA')
	_OBJ_DIR_CHANGE('T01R0201_MAMA_EEVEE', 300)
