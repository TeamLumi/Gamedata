	_END()
ev_t01r0201_mama_eevee_cheer:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_eevee_cheer', 'Eevee is cheering you on!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_eevee_gift:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_eevee', 'It’s an Eevee! Will you take it with you?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t01r0201_mama_eevee_get')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_eevee_get:
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_t01r0201_mama_eevee_no_tray_space'); Party and Boxes are full
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_eevee_get', 'You obtained an Eevee!')
	_ME_WAIT()
	_ADD_POKEMON_UI_EXTRA(133, 0, 5, 0, 3, 4) ; MonsNo, FormNo, Level, Item, MaxIVs, BallId
	_TALK_CLOSE()
	_OBJ_DEL('T01R0201_MAMA_EEVEE')
	_FLAG_SET(#2754); Mom's Eevee
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_eevee_no_tray_space:
	_MACRO_TALKMSG('dialogue_t01r0201', 'msg_t01r0201_mama_eevee_no_tray_space', 'You don’t have any room for it in your party or\nboxes.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
