ev_t01r0201_mama_eevee_bicycle:
	_ATTACH_TRANSFORM('T01R0201_MAMA_EEVEE', 'MapSockets/EEVEE_COUNTER', 0)
	_CHARA_LOOK_LOCK('HERO', 'T01R0201_MAMA_EEVEE')
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'T01R0201_MAMA_EEVEE')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t01r0201', 'msg_t01r0201_mama_eevee_bicycle_1', 'Oh look!\rEevee wants to make sure you don’t forget\nyour bike!')
	_TALK_CLOSE()
	_BICYCLE_COLOR_SET(3); This can be changed in the future.
	_FIND_BG_DISABLE(0, 'P_C_001_Bicycle_Counter')
	_LDVAL(@SCWK_TEMP0, 450)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_CHARA_LOOK_LOCK('HERO', 'T01R0201_MAMA')
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t01r0201', 'msg_t01r0201_mama_eevee_bicycle_2', 'Y’know, {0}, that Eevee is still quite\nyoung.\rI think it would get a lot out of going with you\non your adventure.')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('T01R0201_MAMA_EEVEE', 'anm_t01r0201_eevee_motion')
	_VOICE_PLAY(133, 0, 0)
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('T01R0201_MAMA')
	_EVENT_CAMERA_INDEX(307)
	_OBJ_ANIME('T01R0201_MAMA_EEVEE', 'anm_t01r0201_eevee_finish_1')
	_OBJ_ANIME_WAIT()
	_GAMEOBJECT_MOVE('T01R0201_MAMA_EEVEE', 0, -1, 0, 7)
	_ATTACH_TRANSFORM('T01R0201_MAMA_EEVEE', 'MapSockets/EEVEE_FLOOR', 0)
	_OBJ_ANIME('T01R0201_MAMA_EEVEE', 'anm_t01r0201_eevee_finish_2')
	_LDVAL(@WK_SCENE_T01R0201, 6)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 1800)
	_TV_MONITOR_RESET()
	_SXY_EXIT_POS_CHANGE(0, 5, 13)
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_heal:
	_PLAYER_NAME(0)
	_GET_TIME_ZONE(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_t01r0201_mama_morning')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_t01r0201_mama_noon')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_t01r0201_mama_evening')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_t01r0201_mama_night')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 4, 'ev_t01r0201_mama_midnight')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_RET()
ev_t01r0201_mama_morning:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_10', 'Welcome home, {0,1,0,0}. Are you and your\nPokémon healthy?\rIt’s still early in the morning. Take a quick\nrest, dear.')
	_RET()
