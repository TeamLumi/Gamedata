ev_t01r0201_flag_change:
	_IFVAL_CALL(@480, 'EQ', 1, 'ev_t01r0201_warp')
	_IFVAL_CALL(@WK_SCENE_T01R0201, 'EQ', 3, 'ev_t01r0201_flag_change_mama_dir')
	_IF_FLAGOFF_CALL(#FE_BOUKENNOOTO_GET, 'ev_t01r0201_flag_change_calendarbike_add')
	_IF_FLAGON_CALL(#FE_BOUKENNOOTO_GET, 'ev_t01r0201_flag_change_rivalmama_del')
	_IFVAL_CALL(@WK_SCENE_T01R0201, 'EQ', 6, 'ev_t01r0201_warp')
	_IFVAL_CALL(@WK_SCENE_T01R0201, 'EQ', 3, 'ev_t01r0201_notsave')
	_IFVAL_CALL(@WK_SCENE_T01R0201, 'EQ', 4, 'ev_t01r0201_notsave')
	_END()
ev_t01r0201_flag_change_mama_dir:
	_SXY_POS_CHANGE('T01R0201_MAMA_EEVEE', 7, 7)
	_OBJ_DIR_CHANGE('T01R0201_MAMA_EEVEE', 45)
	_SXY_POS_CHANGE('T01R0201_MAMA', 2, 4)
	_OBJ_DIR_CHANGE('T01R0201_MAMA', 180)
	_SXY_MV_CHANGE('T01R0201_MAMA', 'MV_UP')
	_RET()
ev_t01r0201_flag_change_calendarbike_add:
	_FIND_BG_ENABLE(0, 'P_C_001_Bicycle_Calendar')
	_RET()
ev_t01r0201_flag_change_rivalmama_del:
	_FLAG_SET(#FV_T01R0201_RIVALMAMA)
	_RET()
ev_t01r0201_warp:
	_SXY_EXIT_POS_CHANGE(0, 5, 13)
	_RET()
ev_t01r0201_notsave:
	_SET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_RET()
ev_t01r0201_mama_first:
	_EVENT_START()
	_OBJ_ANIME('HERO', 'anm_t01r0201_player_first_01')
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_first_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_first_01_g')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(2)
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_first_01_A')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_FLAG_SET(#FE_T01R0201_MAMA_TALK)
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_01', '{0,1,0,0}! {1,1,0,0} already left.\rI don’t know what it was about, but\nhe sure was in a hurry!', 0, 1)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_06', 'If you’re going to catch up with him, you’d\nbetter take these!', 1)
	_SYS_FLAG_SHOES_SET()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_07', 'You received a pair of <color=#F01E1EFF>Running Shoes</color>!', 1)
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_08_1', 'With those Running Shoes, you can get to\nplaces much faster.', 1)
	_TALK_CLOSE()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(3)
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_first_02')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@WK_SCENE_T01R0201, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 400)
	_TALK_END()
	_END()
anm_t01r0201_player_first_01:
	_AC_WAIT(4)
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_ACMD_END()
anm_t01r0201_mama_first_01:
	_AC_DIR_U(8)
	_AC_WAIT(8)
	_ACMD_END()
anm_t01r0201_mama_first_01_g:
	_AC_MARK_GYOE(1)
	_AC_WAIT(8)
	_ACMD_END()
anm_t01r0201_mama_first_01_A:
	_AC_UP(1, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(3, 8)
	_AC_DIR_U(4)
	_AC_UP(1, 8)
	_ACMD_END()
anm_t01r0201_mama_first_02:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_L(4)
	_AC_LEFT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_U(8)
	_ACMD_END()
ev_t01r0201_mama_game_clear:
	_EVENT_START()
	_LDVAL(@WK_SCENE_T01R0201_GAME_CLEAR, 2)
	_IF_FLAGON_JUMP(#FE_T01R0201_GAMECLEAR_KISSAKI, 'ev_t01r0201_mama_game_clear_end')
	_IF_FLAGOFF_JUMP(#FE_T01R0201_GAMECLEAR_ZUKAN, 'ev_t01r0201_mama_game_clear_event_ok')
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t01r0201_mama_game_clear_end')
	_JUMP('ev_t01r0201_mama_game_clear_end')
ev_t01r0201_mama_game_clear_event_ok:
	_OBJ_ANIME('HERO', 'anm_t01r0201_player_game_clear_first_01')
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_game_clear_first_01')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(310)
	_CHARA_LOOK_LOCK('HERO', 'T01R0201_MAMA')
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'HERO')
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_t01r0201_mama_game_clear_kissaki')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_t01r0201_mama_game_clear_zukan')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(311)
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('T01R0201_MAMA')
	_JUMP('ev_t01r0201_mama_game_clear_end')
ev_t01r0201_mama_game_clear_end:
	_IF_FLAGOFF_JUMP($SYS_FLAG_WILDCARD_000, 'ev_t01r0201_mama_game_clear_end_b')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 12700)
	_TALK_END()
	_END()
ev_t01r0201_mama_game_clear_end_b:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 12650)
	_TALK_END()
	_END()
ev_t01r0201_mama_game_clear_kissaki:
	_FLAG_SET(#FE_T01R0201_GAMECLEAR_KISSAKI)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_25_1', '{0,1,0,0}! {1,1,0,0} came\nlooking for you a little while ago.', 0, 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_25_2', 'I don’t know what it was about, but he was\nshouting about you needing to get on a ship at\fSnowpoint City.\rYou know how impatient he is. He was gone\nbefore I could ask.', 1)
	_RET()
ev_t01r0201_mama_game_clear_zukan:
	_FLAG_SET(#FE_T01R0201_GAMECLEAR_ZUKAN)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_27_1', '{0,1,0,0}! {1,1,0,0} came\nlooking for you a little while ago.', 0, 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_27_2', 'I don’t know what it was about, but he was\nshouting about you needing to get on a ship at\fSnowpoint City.\rYou know how impatient he is. He was gone\nbefore I could ask.', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_27_3', 'Anyway, how’s it going, kid? Is your project with\nProfessor Rowan coming along?', 1)
	_RET()
anm_t01r0201_player_game_clear_first_01:
	_AC_WAIT(4)
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_ACMD_END()
anm_t01r0201_mama_game_clear_first_01:
	_AC_MARK_GYOE(1)
	_ACMD_END()
ev_t01r0201_mama_bag:
	_EVENT_START()
	_TV_MONITOR_SET(43)
	_EVENT_CAMERA_INDEX(43)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_80')
	_OBJ_ANIME('HERO', 'anm_t01r0201_player_80')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(44)
	_FLAG_SET(#FV_D27R0101_RIVAL)
	_FLAG_RESET(#FV_D27R0101_SUPPORT)
	_LDVAL(@WK_SCENE_R201, 0)
	_OBJ_DEL('R201_SUPPORT')
	_OBJ_DEL('R201_DOCTOR')
	_OBJ_DEL('D27R0101_KABAN')
	_OBJ_DEL('D27R0101_KABAN_02')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_1', 'What’s up, dear?\r...\rWow. I can’t believe that happened to you.')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_2', 'Am I ever glad that both you and\n{0,1,0,0} are unharmed.\rThe professor you mentioned is most likely\nProfessor Rowan of Sandgem Town.', 1, 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_3', 'I’ve heard that he is well known for his studies\non Pokémon. I hear he’s also quite intimidating...', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_4', '{1,1,0,0}, I think you need to visit him in\nSandgem Town.\rYou need to properly thank him for giving \nyou one of his Pokémon.', 1)
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_05_5', 'I’m sure he will be grateful you did.', 1)
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_face00')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(45)
	_CALL('ev_block_doc_end')
	_TV_MONITOR_RESET()
	_LDVAL(@WK_SCENE_T01R0201, 4)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 1400)
	_IFVAL_CALL(@WK_SCENE_T01R0201, 'EQ', 4, 'ev_t01r0201_notsave')
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
anm_t01r0201_mama_80:
	_AC_DIR_L(4)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_WAIT(16)
	_AC_DIR_R(4)
	_AC_RIGHT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(2, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(2, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_t01r0201_mama_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_t01r0201_mama_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
anm_t01r0201_player_80:
	_AC_WAIT(56)
	_AC_DIR_R(8)
	_AC_WAIT(32)
	_AC_RIGHT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(2, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_ACMD_END()
ev_t01r0201_mama:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_T01R0201, 'GE', 7, 'ev_t01r0201_mama_heal_10')
	_IFVAL_JUMP(@WK_SCENE_T01R0201, 'EQ', 6, 'ev_t01r0201_mama_boukennooto_after')
	_IF_FLAGON_JUMP(#FE_ZUKAN_GET, 'ev_t01r0201_mama_zukan')
	_IFVAL_JUMP(@WK_SCENE_T01R0201, 'GE', 5, 'ev_t01r0201_mama_heal_09')
	_IFVAL_JUMP(@WK_SCENE_T01R0201, 'GE', 4, 'ev_t01r0201_mama_bag_after')
	_IF_FLAGON_JUMP(#FE_T01R0201_MAMA_TALK2, 'ev_t01r0201_mama_pos_talk2')
	_IFVAL_JUMP(@WK_SCENE_T01R0201, 'GE', 2, 'ev_t01r0201_mama_pos_talk')
	_IF_FLAGON_JUMP(#FE_T01R0201_MAMA_TALK, 'ev_t01r0201_mama_talk')
	_FLAG_SET(#FE_T01R0201_MAMA_TALK)
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_01', '{0,1,0,0}! {1,1,0,0} already left.\rI don’t know what it was about, but\nhe sure was in a hurry!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_game_clear_first:
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_25_1', '{0,1,0,0}! {1,1,0,0} came\nlooking for you a little while ago.', 0, 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_25_2', 'I don’t know what it was about, but he was\nshouting about you needing to get on a ship at\fSnowpoint City.\rYou know how impatient he is. He was gone\nbefore I could ask.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_boukennooto_after:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_26', 'Bye-bye, {0,1,0,0}!\nEnjoy your adventure!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0201_mama_zukan:
	_PLAYER_NAME(0)
	_GET_TIME_ZONE(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_t01r0201_mama_morning')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_t01r0201_mama_noon')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_t01r0201_mama_evening')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_t01r0201_mama_night')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 4, 'ev_t01r0201_mama_midnight')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_TV_MONITOR_SET(43)
	_SXY_POS_CHANGE('T01R0201_MAMA_EEVEE', 2, 6)
	_OBJ_DIR_CHANGE('T01R0201_MAMA_EEVEE', 90)
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('T01R0201_MAMA')
	_CHARA_LOOK_RELEASE('T01R0201_RIVALMAMA')
	_OBJ_POS_CHANGE_WORLD('HERO', 7, 0, 7)
	_DEBUG_PRINT('ROT', 'CHANGE')
	_OBJ_DIR_CHANGE('HERO', 0)
	_OBJ_DIR_CHANGE('T01R0201_MAMA', 180)
	_EVENT_CAMERA_INDEX(209)
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_12_1', 'What’s up, {0,1,0,0}?\r...')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_12_2', 'Wow. Professor Rowan asked you to do\nsomething that big?\rOK, dear, go for it! Your mom’s got your back!', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_12_3', 'Oh, I know! {0,1,0,0}, I’ve got something\nthat you’ll find useful.', 1)
	_LDVAL(@SCWK_TEMP0, 433)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_13', 'That’s a Guidebook.\rTake a look at it if you want to find out what\nnew features Re:Illuminated has in store for\fyou during your adventure.\rIt has more in-depth information about any\ntooltip you find, and plenty of more useful\ftopics on top of that!', 1)
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(1, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2451); Guidebook Chapter
	_GET_REL_POS_HERO('T01R0201_MAMA', @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 7, 'ev_t01r0201_mama_zukan_dir_down')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 8, 'ev_t01r0201_mama_zukan_dir_down')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 9, 'ev_t01r0201_mama_zukan_dir_down')
	_JUMP('ev_t01r0201_mama_zukan_dir')
	_END()
ev_t01r0201_mama_zukan_dir_down:
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_19')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t01r0201_mama_zukan_dir')
	_END()
ev_t01r0201_mama_zukan_dir:
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_20')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t01r0201_mama_zukan_dir')
	_END()
common_t01r0201_mama_zukan_dir:
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_14', 'Gee, a journey full of adventure...\nI envy you, kiddo.\rPlus, you’re not alone. You have your Pokémon\nwith you. I wish I could go instead!', 1)
	_SET_FORCE_BLINK('T01R0201_MAMA', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SET_FORCE_BLINK('T01R0201_MAMA', 0)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_TURN_HERO_SITE()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_15_1', 'I’m just joking, {0,1,0,0}!\rI’ll be all right by myself, dear, so you go and\nenjoy your adventure!')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_15_2', 'When you’re exposed to new things and\nexperience new sensations... it makes your\fmother happy, too.', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_15_3', 'But please come back sometimes. I would like to\nsee the kinds of Pokémon you’ve caught, dear.', 1)
	_TALK_CLOSE()
	_SE_PLAY('S_FI012')
	_FLAG_RESET(#FV_T01R0201_RIVALMAMA)
	_OBJ_ADD('T01R0201_RIVALMAMA')
	_OBJ_ANIME('T01R0201_RIVALMAMA', 'anm_t01r0201_raivalmama_0')
	_OBJ_ANIME_WAIT()
	_SE_WAIT('S_FI012')
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_50')
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'T01R0201_RIVALMAMA')
	_OBJ_ANIME('HERO', 'anm_t01r0201_player_50')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(210)
	_IFVAL_CALL(@SCWK_TEMP2, 'NE', 1, 'ev_t01r0201_rivalmama_50_0')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_t01r0201_rivalmama_50_1')
	_CHARA_LOOK_LOCK('T01R0201_RIVALMAMA', 'T01R0201_MAMA')
	_CHARA_LOOK_LOCK('HERO', 'T01R0201_RIVALMAMA')
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_rivalmama_01', 'Excuse me. Is my little {1,1,0,0} here?', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_21', 'Oh? No, he’s not...', 1)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_rivalmama_02_1', 'Oh... Then he must have left already...\nWhat to do...', 1)
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_rivalmama_02_2', 'That boy shouted about going on an adventure,\nthen he bolted.\rHe’s so headstrong and reckless... I at least\nwanted him to take this...', 1)
	_PLAYER_NAME(0)
	_OBJ_ANIME('T01R0201_MAMA', 'anm_t01r0201_mama_face01')
	_MACRO_TALKMSG('dialogue_t01r0201', '23-msg_t01r0201_mama_22', 'Not to worry. {0,1,0,0} will deliver that\nto him.', 1, 1)
	_CHARA_LOOK_LOCK('T01R0201_MAMA', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'T01R0201_MAMA')
	_JUMP('common_t01r0201_mama_zukan_dir_02')
	_END()
ev_t01r0201_rivalmama_50_0:
	_OBJ_ANIME('T01R0201_RIVALMAMA', 'anm_t01r0201_rivalmama_50')
	_OBJ_ANIME_WAIT()
	_RET()
ev_t01r0201_rivalmama_50_1:
	_OBJ_ANIME('T01R0201_RIVALMAMA', 'anm_t01r0201_rivalmama_50_1')
	_OBJ_ANIME_WAIT()
	_RET()
ev_t01r0201_rivalmama_dir_left_02:
	_OBJ_ANIME('HERO', 'anm_t01r0201_player_70')
	_OBJ_ANIME_WAIT()
	_RET()
ev_t01r0201_rivalmama_dir_left_02_1:
