ev_t05pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_t05pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_t05pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t05pc0101_flag_change_del_stopper')
	_END()
ev_t05pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_t05pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_t05pc0101_oldwoman1:
	_MACRO_EASY_OBJ_MSG('dialogue_t05pc0101', '155-msg_t05pc0101_oldwoman1_01', 'What would bring you to a place so far off the\nbeaten path? There is nothing to see here but\fsome ancient Pokémon etchings...')
	_END()
ev_t05pc0101_babygirl1:
	_MACRO_EASY_OBJ_MSG('dialogue_t05pc0101', '155-msg_t05pc0101_babygirl1_01', 'They say this town has been here since Sinnoh\nwas made.')
	_END()
ev_t05pc0101_middleman1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#TMFLG_T05PC0101_ITEM_GET, 'ev_t05pc0101_middleman1_03')
	_MACRO_TALKMSG('dialogue_t05pc0101', '155-msg_t05pc0101_middleman1_01', 'Oh, now, this is interesting.\nLet’s see your Pokémon.')
	_FRONT_POKEMON(@SCWK_PARAM0)
	_GET_NATSUKI(@SCWK_ANSWER, @SCWK_PARAM0, -1)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 150, 'ev_t05pc0101_middleman1_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 50, 'ev_t05pc0101_middleman1_04')
	_JUMP('ev_t05pc0101_middleman1_05')
	_JUMP('ev_t05pc0101_middleman1_item_event_fail')
ev_t05pc0101_middleman1_02:
	_MACRO_TALKMSG('dialogue_t05pc0101', '155-msg_t05pc0101_middleman1_02', 'It clearly likes you very much. You can have this!')
	_LDVAL(@SCWK_TEMP0, 3)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05pc0101_middleman1_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#TMFLG_T05PC0101_ITEM_GET)
	_JUMP('ev_t05pc0101_middleman1_03')
	_JUMP('ev_t05pc0101_middleman1_item_event_fail')
ev_t05pc0101_middleman1_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05pc0101_middleman1_03:
	_MACRO_TALKMSG('dialogue_t05pc0101', '155-msg_t05pc0101_middleman1_03', 'It’s about trust between the Trainer and\nthe Pokémon.\rDeveloping trust in each other is the key\nto victory.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05pc0101_middleman1_04:
	_MACRO_TALKMSG('dialogue_t05pc0101', '155-msg_t05pc0101_middleman1_04', 'It’s warming up to you in a very nice way.\rIt will grow even more friendly if you travel with\nit some more.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05pc0101_middleman1_05:
	_MACRO_TALKMSG('dialogue_t05pc0101', '155-msg_t05pc0101_middleman1_05', 'It’s not very used to you yet.\rYou both need to develop trust for one another\nas Trainer and Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()