ev_c08r0101_flag_change:
	_END()
ev_c08r0101_woman1_talk:
	_OBJ_ANIME('C08R0101_WOMAN1', 'anm_c08r0101_woman1_00')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c08r0101_woman1')
	_END()
anm_c08r0101_woman1_00:
	_AC_DIR_R(8)
	_ACMD_END()
ev_c08r0101_woman1:
	_TALK_OBJ_START()
	_FRONT_POKEMON(@SCWK_PARAM0)
	_CHK_RIBBON(@SCWK_ANSWER, 0, 7)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08r0101_woman1_06')
	_POKEMON_NAME(0, @SCWK_PARAM0)
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_woman1_01', 'Oh? Your {0,1,1,0}...')
	_CHK_PRMEXP(@SCWK_ANSWER, @SCWK_PARAM0)
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 510, 'ev_c08r0101_woman1_05')
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_woman1_02', 'It worked stupendously hard, didn’t it?\rAs its reward, please give it this Effort Ribbon.')
	_SET_RIBBON(@SCWK_PARAM0, 7)
	_SE_PLAY('M_FI010')
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_woman1_03', 'You received an Effort Ribbon.')
	_ME_WAIT()
	_POKEMON_NAME(0, @SCWK_PARAM0)
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_woman1_04', 'You put the Effort Ribbon on {0,1,1,0}.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0101_woman1_05:
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_woman1_05', 'It needs to work a little harder.\rIf it does, I’ll give your Pokémon something nice.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0101_woman1_06:
	_POKEMON_NAME(0, @SCWK_PARAM0)
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_woman1_06', 'Oh! That Effort Ribbon looks good on\nyour {0,1,1,0}!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0101_seaman_talk:
	_OBJ_ANIME('C08R0101_SEAMAN', 'anm_c08r0101_seaman_00')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c08r0101_seaman')
	_END()
anm_c08r0101_seaman_00:
	_AC_DIR_D(8)
	_ACMD_END()
ev_c08r0101_seaman:
	_MACRO_EASY_OBJ_MSG('dialogue_c08r0101', '1-msg_c08r0101_seaman_01', 'Sunyshore Market is best known for its big\nselection of Poké Ball Stickers.')
	_END()
ev_c08r0101_sunglasses_talk:
	_OBJ_ANIME('C08R0101_SUNGLASSES', 'anm_c08r0101_sunglasses_00')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c08r0101_sunglasses')
	_END()
anm_c08r0101_sunglasses_00:
	_AC_DIR_D(8)
	_ACMD_END()
ev_c08r0101_sunglasses:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_sunglasses_01', 'Ah, please, allow me a little of your time, if you\nwill. You won’t regret it.')
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c08r0101_shop_re')
	_END()
ev_c08r0101_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c08r0101_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c08r0101_shop_buy')
	_CASE_JUMP(2, 'ev_c08r0101_shop_end')
	_JUMP('ev_c08r0101_shop_end')
	_END()
ev_c08r0101_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c08r0101', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c08r0101_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_SEAL()
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c08r0101_shop_re')
	_END()
ev_c08r0101_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0101_middleman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_middleman1_01', 'See the Sticker Merchant there?')
	_CHK_WEEK(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c08r0101_middleman1_02')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_c08r0101_middleman1_02')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 2, 'ev_c08r0101_middleman1_02')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 3, 'ev_c08r0101_middleman1_02')
	_JUMP('ev_c08r0101_middleman1_03')
	_END()
ev_c08r0101_middleman1_02:
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_middleman1_02', 'He didn’t have the Stickers I wanted today...\nMaybe tomorrow, I guess.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0101_middleman1_03:
	_MACRO_TALKMSG('dialogue_c08r0101', '1-msg_c08r0101_middleman1_03', 'He came through with different Stickers today!\nJust what I wanted to see!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_c08r0101_leoparodo_trade:
    _TALK_OBJ_START()
    _CALL('ev_c08r0101_leoparodo_trade_values')
    _IF_FLAGON_JUMP(#3083, 'ev_c08r0101_leoparodo_trade_over')
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_leoparodo_trade_1', 'Yo, you’re a trainer, right?\rDo you know the Pokémon {0,1,1,0}?')
    _TALK_CLOSE()
    _POKE_WINDOW_PUT(@LOCALWORK0, @LOCALWORK1)
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _POKEMON_NAME_FORM(1, @LOCALWORK2, @LOCALWORK3)
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_leoparodo_trade_2', 'So listen.\nI’ve got this problem.\rMy {0,1,1,0}. My Dudu.\nHe went and evolved into\f{1,1,1,0}.\rIt might sound like a good thing but I ain’t got\nthe space to keep him in my dorm.\rI don’t know why but every single {0,1,1,0}\nthat I catch ends up evolving to be super long.\rThe shorter ones must be really rare or\nsomething.\rAnyway.\nHave you got a {0,1,1,0}? Wanna swap?')
    _YES_NO_WIN(@SCWK_ANSWER)
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c08r0101_leoparodo_trade_yes')
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08r0101_leoparodo_trade_no')
ev_c08r0101_leoparodo_trade_values:
    _LDVAL(@LOCALWORK0, 206); Given trade MonsNo
    _LDVAL(@LOCALWORK1, 0); Given trade FormNo
    _LDVAL(@LOCALWORK2, 982); Received trade MonsNo
    _LDVAL(@LOCALWORK3, 1); Received trade FormNo
    _RET()
ev_c08r0101_leoparodo_trade_yes:
    _TALK_CLOSE()
    _POKELIST_SET_PROC(38)
    _POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
    _IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_c08r0101_leoparodo_trade_no'); If nothing was selected
    _TEMOTI_BOX_MONSNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
    _TEMOTI_BOX_FORMNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2)
    _IFVAL_JUMP(@SCWK_ANSWER, 'NE', @LOCALWORK0, 'ev_c08r0101_leoparodo_trade_wrong_mon'); If a species other than the target was selected
    _IFVAL_JUMP(@SCWK_TEMP2, 'NE', @LOCALWORK1, 'ev_c08r0101_leoparodo_trade_wrong_form'); If an incorrect form of the correct species was selected
    _TEMOTI_BOX_SHINY(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2)
    _TEMOTI_BOX_GENDER(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP3)
    _TALK_CLOSE()
    _LOCALKOUKAN_APPLY(11, @SCWK_TEMP1, @SCWK_TEMP0)
	_SXY_POS_CHANGE('HERO', 5, 4)
	_SXY_DIR_CHANGE('HERO', 180)
	_SXY_DIR_CHANGE('C08R0101_LEOPARODO', 0)
    _IFVAL_CALL(@SCWK_TEMP2, 'EQ', 0, 'ev_c08r0101_leoparodo_trade_placedata')
    _IFVAL_CALL(@SCWK_TEMP2, 'GE', 1, 'ev_c08r0101_leoparodo_trade_placedata_shiny')
	_CALL('ev_c08r0101_dunsparce_cry')
    _JUMP('ev_c08r0101_leoparodo_trade_over')
ev_c08r0101_leoparodo_trade_no:
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_leoparodo_trade_no', 'Crazy...')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c08r0101_leoparodo_trade_wrong_mon:
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_leoparodo_trade_wrong_mon', 'Hey, so...\nGood pitch but that ain’t gonna work for me.\rIt is {0,1,1,0} or bust for this guy.')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c08r0101_leoparodo_trade_wrong_form:
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_leoparodo_trade_wrong_form', 'I don’t...\nThat looks like what I asked for but also not.\rSee if you can find one in another form,\nI guess?')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c08r0101_leoparodo_trade_placedata:
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 0, 'ev_c08r0101_leoparodo_trade_placedata_male')
	_IFVAL_JUMP(@SCWK_TEMP3, 'GE', 1, 'ev_c08r0101_leoparodo_trade_placedata_female')
	_RET()
ev_c08r0101_leoparodo_trade_placedata_male:
    _OBJ_ADD('C08R0101_DUNSPARCE_MALE')
    _FLAG_RESET(#2973)
    _RET()
ev_c08r0101_leoparodo_trade_placedata_female:
    _OBJ_ADD('C08R0101_DUNSPARCE_FEMALE')
    _FLAG_RESET(#2974)
    _RET()
ev_c08r0101_leoparodo_trade_placedata_shiny:
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 0, 'ev_c08r0101_leoparodo_trade_placedata_shiny_male')
	_IFVAL_JUMP(@SCWK_TEMP3, 'GE', 1, 'ev_c08r0101_leoparodo_trade_placedata_shiny_female')
	_RET()
ev_c08r0101_leoparodo_trade_placedata_shiny_male:
    _OBJ_ADD('C08R0101_DUNSPARCE_SHINY_MALE')
    _FLAG_RESET(#2975)
    _RET()
ev_c08r0101_leoparodo_trade_placedata_shiny_female:
    _OBJ_ADD('C08R0101_DUNSPARCE_SHINY_FEMALE')
    _FLAG_RESET(#2976)
    _RET()
ev_c08r0101_leoparodo_trade_over:
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_leoparodo_trade_over', 'Thanks a lot for trading with me.\rI would have struggled to cope in Sinnoh\nwithout a trusty yellow buddy by my side.')
    _FLAG_SET(#3083)
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c08r0101_dunsparce:
	_TALK_OBJ_START()
    _CALL('ev_c08r0101_leoparodo_trade_values')
	_CALL('ev_c08r0101_dunsparce_cry')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0101_dunsparce_cry:
    _VOICE_PLAY(@LOCALWORK0, @LOCALWORK1, 0)
    _MACRO_TALKMSG('dialogue_c08r0101', 'msg_c08r0101_dunsparce_cry', 'Duduuuuu!!!')
    _VOICE_WAIT()
	_RET()