ev_t07pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_t07pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_t07pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07pc0101_flag_change_del_stopper')
	_END()
ev_t07pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_t07pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_t07pc0101_gorggeousm:
	_MACRO_EASY_OBJ_MSG('dialogue_t07pc0101', '50-msg_t07pc0101_gorggeousm_01', 'Pokémon appear where there’s still lots of\nnature left.\rAnd Trainers gather where Pokémon appear.\rAnd where Trainers gather, that’s where\nPokémon Centers appear.')
	_END()
ev_t07pc0101_idol:
	_MACRO_EASY_OBJ_MSG('dialogue_t07pc0101', '50-msg_t07pc0101_idol_01', 'An Idol goes anywhere to sing for their\nadoring fans.\rA Trainer goes anywhere—as long as it’s with\ntheir Pokémon.')
	_END()