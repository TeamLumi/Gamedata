ev_l02_flag_change:
	_IF_FLAGON_CALL(#FV_L02_GINGAM, 'ev_l02_gungm_chap')
	_IF_FLAGON_CALL(#FE_L02_GINGAM, 'ev_l02_flag_change_02')
	_IF_FLAGOFF_JUMP(#FE_D05R0114_CLEAR, 'ev_l02_door_exit_move_1')
	_IF_FLAGON_JUMP(#FE_D05R0114_CLEAR, 'ev_l02_door_exit_move_2')
	_END()
	_END()
ev_l02_flag_change_02:
	_SXY_POS_CHANGE('L02_GINGAM_1', 722, 770)
	_OBJ_DIR_CHANGE('L02_GINGAM_1', 0)
	_SXY_MV_CHANGE('L02_GINGAM_1', 'MV_UP')
	_RET()
ev_l02_gungm_chap:
	_LDVAL(@LOCALWORK31, 1)
	_RET()
ev_l02_init_change:
	_IF_FLAGOFF_JUMP(#FE_D05R0114_CLEAR, 'ev_l02_door_exit_move_1')
	_IF_FLAGON_JUMP(#FE_D05R0114_CLEAR, 'ev_l02_door_exit_move_2')
	_END()
ev_l02_door_exit_move_1:
	_SXY_EXIT_POS_CHANGE(2, 713, 760)
	_SXY_EXIT_POS_CHANGE(3, 713, 761)
	_END()
ev_l02_door_exit_move_2:
	_SXY_EXIT_POS_CHANGE(0, 713, 760)
	_SXY_EXIT_POS_CHANGE(1, 713, 761)
	_END()
pos_l02_gingam_1_stop_data:
	_EVENT_START()
	_JUMP('ev_l02_gingam_1')
ev_l02_gingam_1_talk_start:
	_TALK_OBJ_START()
	_JUMP('ev_l02_gingam_1')
ev_l02_gingam_1:
	_CALL('ev_another_out')
	_IF_FLAGON_JUMP(#FE_L02_GINGAM, 'ev_l02_gingam_02'); This uses the same placedata object since it's a short distance
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_gingam_1_01_1', '*pant*\nWhy am I running like this anyway?!')
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_gingam_1_01_2', 'That new universe the boss was talking about...\rIt’s giving me goose bumps thinking about it.\nSo, we use this...')
	_CHARA_LOOK_LOCK('HERO', 'L02_GINGAM_1')
	_CHARA_LOOK_LOCK('L02_GINGAM_1', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('L02_GINGAM_1')
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_01')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(922)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_gingam_1_02', 'Gweh! You were eavesdropping! I was only\ntalking to myself!\rYou’re persistent, too... I’m pooped out from all\nthe running...\rBut, I’m not...going to battle you.')
	_TALK_CLOSE()
	_GET_REL_POS_HERO('L02_GINGAM_1', @SCWK_TEMP3)
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 8, 'ev_l02_gingam_dir_down')
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 2, 'ev_l02_gingam_dir_up')
	_JUMP('ev_l02_gingam_dir')
	_JUMP('ev_l02_gingam_dir_common')
ev_l02_gingam_dir_down:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_02')
	_OBJ_ANIME('HERO', 'anm_l02_player_02')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_l02_gingam_dir_common')
ev_l02_gingam_dir_up:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_03')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_l02_gingam_dir_common')
ev_l02_gingam_dir:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_03')
	_OBJ_ANIME('HERO', 'anm_l02_player_03')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_l02_gingam_dir_common')
ev_l02_gingam_dir_common:
	_OBJ_POS_CHANGE('L02_GINGAM_1', 722, 1, 770, 0)
	_LDVAL(@484, 6); Set's the stopdata for the final part of the galactic chase
	_FLAG_SET(#FE_L02_GINGAM)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7300)
	_EVENT_CAMERA_INDEX(923)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_l02_gingam_02:
	_CALL('ev_another_out')
	_HERO_MOVE_GRID_CENTER(0); Make sure the player is centered on the tile
	_CHARA_LOOK_LOCK('L02_GINGAM_1', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'L02_GINGAM_1')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('L02_GINGAM_1', 'anm_galactic_grunt_annoyed')
	_PLAY_EMO_SE(12) ; Play annoyed sound effect
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_gingam_1_03', 'Aww, no! You’re still on my tail? The lake’s\nwithin sight.\rYou leave me no choice... My Pokémon will\nknock you out.')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_CHARA_LOOK_RELEASE('L02_GINGAM_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 775, 'ev_galactic_chase_grunt_battle_stop_data'); If the StopData gets activated
	_EVENT_CAMERA_INDEX(438)
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@SCWK_TEMP3, 673)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	; Move the player to always be positioned centered and below the grunt, for simplicity
	_CALL('ev_l02_center_player_after_battle')
	_EVENT_CAMERA_INDEX(439)
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_LOCK('L02_GINGAM_1', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_gingam_1_04', 'I can’t battle anymore. I’m running on fumes...\rI’ll have to give this to the commander.\nI wish I got to use it at the lake...')
	_TALK_CLOSE()
	; Reset the camera before the grunt leaves
	_EVENT_CAMERA_INDEX(439)
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_RELEASE('L02_GINGAM_1')
	_GET_REL_POS_HERO('L02_GINGAM_1', @SCWK_TEMP3)
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 8, 'ev_l02_gingam_dir_down_02')
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 2, 'ev_l02_gingam_dir_up_02')
	_JUMP('ev_l02_gingam_dir_02')
	_JUMP('ev_l02_gingam_dir_common_02')
ev_galactic_chase_grunt_battle_stop_data:
	_IFVAL_CALL(@SCWK_TEMP0, 'NE', 722, 'ev_galactic_chase_grunt_battle_turn'); If the player is NOT in line with the grunt
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 722, 'ev_galactic_chase_grunt_battle_no_turn'); If the player IS in line with the grunt
	_RET()
ev_galactic_chase_grunt_battle_turn:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_galactic_chase_grunt_battle_turn')
	_OBJ_ANIME_WAIT()
	_RET()
ev_galactic_chase_grunt_battle_no_turn:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_galactic_chase_grunt_battle_no_turn')
	_OBJ_ANIME_WAIT()
	_RET()
ev_l02_center_player_after_battle:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_DIR_CHANGE('L02_GINGAM_1', 0)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 775, 'ev_l02_center_player_after_battle_stairs'); If the player is at the stairs
	_JUMP('ev_l02_center_player_after_battle_path') ; If they are not because they talked to the grunt directly
	_END()
ev_l02_center_player_after_battle_stairs:
	_OBJ_POS_CHANGE_WORLD('HERO', 723, 1, 775)
	_OBJ_POS_CHANGE_WORLD('L02_GINGAM_1', 723, 1, 773)
	_RET()
ev_l02_center_player_after_battle_path:
	_OBJ_POS_CHANGE_WORLD('HERO', 722, 1, 772)
	_RET()
ev_l02_gingam_dir_down_02:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_10')
	_OBJ_ANIME('HERO', 'anm_l02_player_10')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_l02_gingam_dir_common_02')
ev_l02_gingam_dir_up_02:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_11')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_l02_gingam_dir_common_02')
ev_l02_gingam_dir_02:
	_OBJ_ANIME('L02_GINGAM_1', 'anm_l02_gingam_11')
	_OBJ_ANIME('HERO', 'anm_l02_player_11')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_l02_gingam_dir_common_02')
ev_l02_gingam_dir_common_02:
	_OBJ_DEL('L02_GINGAM_1')
	; Add Cynthia and Rival
	_FLAG_RESET(#FV_L02_CHAMP)
	_OBJ_ADD('L02_CHAMP')
	; Depending on where the player ended up after the battle, position Cynthia and Rival
	_CALL('ev_l02_position_champ_and_rival_after_battle')
	; Cynthia walks down to the player
	_OBJ_ANIME('L02_CHAMP', 'anm_l02_champ_walk_to_player')
	_OBJ_ANIME_WAIT()
	; Zoom again
	_EVENT_CAMERA_INDEX(438)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_00', 'Oh, hello, long time no see!\nHow is your Pokédex filling up?\rI came to research the folklore\nabout the lake, but...\rWell, it doesn’t appear as if the\nlake is open to the public now.\rHave you heard the folklore about it?\rThey say there is an island inside\nthe lake.\rAnd inside that island is a mirage\nof a Pokémon.\rNo one must enter the chamber\nof that Pokémon...\rOh, that’s right! I had to talk to you\nabout something else...')
	_TALK_CLOSE()
	_OBJ_ADD('L02_RIVAL')
	_OBJ_ANIME('L02_RIVAL', 'anm_l02_rival_walk_to_player')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'L02_RIVAL')
	_CHARA_LOOK_LOCK('L02_CHAMP', 'L02_RIVAL')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_rival_01', 'Hey, {0}!\nWhere’d that Galactic goon run off to?')
	_CHARA_LOOK_LOCK('L02_RIVAL', 'L02_CHAMP')
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_rival_02', 'Huh?\nIs this your older sister?\rNo? She isn’t?\nOh, OK.')
	_CHARA_LOOK_LOCK('L02_RIVAL', 'HERO')
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_rival_03', 'That explosion in the Great Marsh?\nIt wasn’t anything serious.\rMr. Wake told me to tell you that.\rBut that Team Galactic... Wow! Are they\nout of control or what?\rNext time I see them, I’ll teach them\na lesson they won’t forget!\rSee you around!')
	_TALK_CLOSE()
	;Rival leaves
	_CHARA_LOOK_RELEASE('L02_RIVAL')
	_OBJ_ANIME('L02_RIVAL', 'anm_l02_rival_leave')
	; Player and Cynthia look to Rival leaving
	_CHARA_LOOK_LOCK('L02_CHAMP', 'L02_RIVAL')
	_CHARA_LOOK_LOCK('HERO', 'L02_RIVAL')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('L02_RIVAL')
	_CHARA_LOOK_LOCK('L02_CHAMP', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'L02_CHAMP')
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_01', 'He’s your friend? He’s more impatient than he\nis energetic, isn’t he?\rWhat he was talking about concerns me\nthough...\rTeam Galactic and an explosion at the Great\nMarsh? I’m going to need to look into this...\rMay I ask you for a favor?\nHave you seen that statue like Pokémon on\fRoute 210?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_l02_darmanitan_yes')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_l02_darmanitan_no')
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_02', 'Darmanitan are known to enter a meditative\ntrance sometimes. It’s almost impossible to\fwake them up!\rI was going to share this Rage Candy Bar with\nit to see if I could get it to stir.\rMy hands are going to be full with this\nGalactic investigation though, so do you think\fyou’d be able to do it in my stead?\rI suppose I’d better give you the whole thing.\nI was looking forward to having some myself...')
	;You obtained Cynthia's Rage Candy Bar!
	_LDVAL(@SCWK_TEMP0, 1310)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_03', 'That’s okay though. You can make it up to me\nby buying me a Casteliacone sometime!\fJust kidding. Although, I do love ice cream!\rCome to think of it, there is something else\nthat you could do for me, since you’re on your\fway to Celestic Town. Could you please take\fthis charm to my grandma there?\rThere are lots of rare Pokémon on the way to\nCelestic Town, so it would be worth your while\fto go, for your Pokédex.')
	;You obtained the Old Charm!
	_LDVAL(@SCWK_TEMP0, 439)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_04', 'My grandma has this sort of bossy atmosphere\nabout her. I think you’ll recognize her straight\faway. Yes, I’m sure you will. She’s the elder of\fCelestic Town. The place is steeped in\fmythology and history too. It may help you\funcover the secret behind the mysterious\fPokémon you’re searching for.\rNevertheless, thank you for doing these\nlittle jobs for me. I’ll see you later!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('L02_CHAMP')
	_OBJ_ANIME('L02_CHAMP', 'anm_l02_champ_leave')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('L02_CHAMP')
	_FLAG_SET(#2840); Hide Looker
	_FLAG_SET(#2838); Hide Barry 2
	_FLAG_SET(#2942); Hide Torterra
	_FLAG_SET(#2943); Hide Infernape
	_FLAG_SET(#2944); Hide Empoleon
	_FLAG_SET(#2931); Hide Barry 3
	_LDVAL(@484, 7); Pastoria event is completely over
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7500)
	; Reset the camera
	_EVENT_CAMERA_INDEX(439)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_l02_position_champ_and_rival_after_battle:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 775, 'ev_l02_position_champ_after_battle_stairs'); If the player is at the stairs
	_JUMP('ev_l02_position_rival_after_battle_path') ; If they are not because they talked to the grunt directly
	_END()
ev_l02_position_champ_after_battle_stairs:
	_OBJ_POS_CHANGE_WORLD('L02_CHAMP', 723, 1, 765)
	_RET()
ev_l02_position_rival_after_battle_path:
	_OBJ_POS_CHANGE_WORLD('L02_RIVAL', 723, 4, 781)
	_RET()
ev_l02_darmanitan_yes:
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_yes', 'Yes, that’s right. By the café on Route 210.\nYou’ve seen that Darmanitan that’s blocking\fthe path to Celestic Town.')
	_RET()
ev_l02_darmanitan_no:
	_MACRO_TALKMSG('dialogue_l02', 'msg_l02_champ_no', 'You haven’t seen it? Well, there’s a\nDarmanitan by the café on Route 210,\fblocking the path to Celestic Town.')
	_RET()
anm_l02_champ_walk_to_player:
	_AC_DIR_D(1)
	_AC_DOWN(6, 8)
	_AC_DIR_U(8)
	_AC_WAIT(10)
	_AC_DIR_D(8)
	_AC_DOWN(3, 8)
	_ACMD_END()
anm_l02_rival_walk_to_player:
	_AC_DIR_U(1)
	_AC_UP(9, 4)
	_AC_DIR_L(8)
	_ACMD_END()
anm_l02_rival_leave:
	_AC_DIR_U(8)
	_AC_UP(9, 8)
	_ACMD_END()
anm_l02_champ_leave:
	_AC_DIR_U(8)
	_AC_UP(6, 8)
	_ACMD_END()
anm_galactic_grunt_annoyed:
	_AC_MARK_EMO(12)
	_ACMD_END()
anm_galactic_chase_grunt_battle_turn:
	_AC_DIR_R(8)
	_AC_HERO_MATCH_X(8)
	_AC_DIR_D(8)
	_AC_DOWN(3, 8)
	_ACMD_END()
anm_galactic_chase_grunt_battle_no_turn:
	_AC_DOWN(3, 8)
	_ACMD_END()
anm_l02_player_02:
	_AC_DIR_R(8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_l02_player_03:
	_AC_DIR_U(8)
	_ACMD_END()
anm_l02_player_10:
	_AC_WAIT(8)
	_AC_DIR_R(8)
	_AC_WAIT(8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_l02_player_11:
	_AC_WAIT(8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_l02_gingam_01:
	_AC_MARK_GYOE(1)
	_ACMD_END()
anm_l02_gingam_02:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 4)
	_AC_DIR_U(4)
	_AC_UP(10, 4)
	_AC_DIR_R(4)
	_AC_RIGHT(2, 4)
	_AC_DIR_U(4)
	_AC_UP(10, 4)
	_ACMD_END()
anm_l02_gingam_03:
	_AC_DIR_U(4)
	_AC_UP(10, 4)
	_AC_DIR_R(4)
	_AC_RIGHT(3, 4)
	_AC_DIR_U(4)
	_AC_UP(10, 4)
	_ACMD_END()
anm_l02_gingam_10:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_DIR_U(4)
	_AC_UP(9, 16)
	_ACMD_END()
anm_l02_gingam_11:
	_AC_DIR_U(4)
	_AC_UP(2, 8)
	_AC_DIR_U(4)
	_AC_UP(8, 16)
	_ACMD_END()
ev_l02_gingam:
	_MACRO_EASY_OBJ_MSG('dialogue_l02', '114-msg_l02_gingam_01', 'We’ve been asked to keep everyone out of the\nlake area.\rReason? I’m not too sure, but apparently to\nprotect the lake.')
	_END()
ev_l02_gingam1:
	_MACRO_EASY_OBJ_MSG('dialogue_l02', '114-msg_l02_gingam1_01', 'To protect the lake... It’s nice to know there are\nstill people worth admiring like that.\rI believe his name was Cyrus?')
	_END()
ev_l02_woman2:
	_TALK_OBJ_START()
	_LDVAL(@SCWK_TEMP0, 451)
	_ITEM_CHK(451, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_l02_woman2_02')
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_woman2_01', 'What am I to do? I’ve gone and dropped my\nSuite Key somewhere again...\rThe hotel people won’t be happy with me...\rI’m sure I had it when I left the reception\ncounter earlier...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02_woman2_02:
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_woman2_02', 'What am I to do? I’ve gone and dropped my\nSuite Key somewhere again...\rOh! That’s my Suite Key!\rYou found it for me? Oh, that’s sweet of you!\nThank you!')
	_TALK_CLOSE()
	_SUB_ITEM(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_OBJ_ANIME('L02_WOMAN2', 'anm_l02_woman2_in_01')
	_OBJ_ANIME_WAIT()
	_SET_DOOR_OBJ('L02R0201_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI012')
	_HIT_DOOR_ANIME_WAIT()
	_OBJ_ANIME('L02_WOMAN2', 'anm_l02_woman2_in_02')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('L02_WOMAN2')
	_SET_DOOR_OBJ('L02R0201_D01')
	_HIT_DOOR_ANIME(1)
	_SE_PLAY('S_FI013')
	_FLAG_RESET(#FV_L02R0201_WOMAN2)
	_FLAG_SET(#FV_L02_WOMAN2)
	_TALK_OBJ_END()
	_END()
anm_l02_woman2_in_01:
	_AC_DIR_U(8)
	_ACMD_END()
anm_l02_woman2_in_02:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
ev_l02_sign1:
	_EASY_BOARD_MSG('dialogue_l02%114-msg_l02_sign_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_l02_bigman:
	_MACRO_EASY_OBJ_MSG('dialogue_l02', '114-msg_l02_bigman_02', 'Stop, stop! Yes, you!\rSunyshore City, which is down this road, had a\nmajor blackout!\rCrews are working on restoring power, but the\nroad’s closed now.')
	_END()
pos_l02_bigman:
	_EVENT_START()
	_CALL('ev_another_out')
	_OBJ_ANIME('L02_BIGMAN', 'anm_l02_bigman_gyoe')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('L02_BIGMAN', 'anm_l02_bigman_gyoe_02')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_PARAM0, @SCWK_PARAM1)
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 789, 'pos_l02_bigman_walk1_01')
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 790, 'pos_l02_bigman_walk2_01')
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 791, 'pos_l02_bigman_walk3_01')
	_OBJ_ANIME('L02_BIGMAN', 'anm_l02_bigman_push')
	_OBJ_ANIME('HERO', 'anm_l02_player_push_out')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_l02', '114-msg_l02_bigman_01', 'Stop, stop! Yes, you!\rSunyshore City, which is down this road, had a\nmajor blackout!\rCrews are working on restoring power, but the\nroad’s closed now.')
	_TALK_CLOSE()
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 789, 'pos_l02_bigman_walk1_02')
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 790, 'pos_l02_bigman_walk2_02')
