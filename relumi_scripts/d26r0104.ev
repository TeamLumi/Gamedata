ev_d26r0104_obj_change:
	_IF_FLAGON_JUMP(#FV_D26R0104_DOOR, 'ev_d26r0104_obj_change_vanish')
	_END()
ev_d26r0104_obj_change_vanish:
	_SET_DOOR_OBJ('P_C_001_AutoDoor_01')
	_DOOR_FORCE_ANIME_END(0)
	_END()
ev_d26r0104_gingaboss:
	_EVENT_START()
	_OBJ_ANIME('HERO', 'anm_hero_01')
	_OBJ_ANIME_WAIT()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_INDEX(237)
	_OBJ_POS_CHANGE_WORLD('HERO', 8, 0, 11)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_d26r0104_gingaboss_01')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_01_1', 'I see. You must be the Trainer I’ve been\nhearing about.\rThe foolhardy one that’s trying to stand up to\nTeam Galactic.')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D26R0104_GINGABOSS', 1)
	_TIME_WAIT(20, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_01_2', 'Although I’d hardly expected to see that the\nTrainer is a mere child.\rI’d heard that our commanders had a rough time\nwith you.')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D26R0104_GINGABOSS', 0)
	_EVENT_CAMERA_INDEX(238)
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_d26r0104_gingaboss_02')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D26R0104_GINGABOSS', 1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D26R0104_GINGABOSS', 0)
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_02_1', 'I know why you’re here. I can sense it in you.\rIt’s about Uxie, Mesprit, and Azelf, correct?\nYou want to save them.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_02_2', 'I no longer have any need for them. I am finished\nwith them.\rIf your heart aches to save them, go right ahead.\nI could care less.\rIt will save me the trouble of disposing of them.')
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_c03gym0101_leader_01_face02')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_02_3', 'But I must say...you are a remarkable specimen.\rThose Pokémon have nothing to do with you, do\nthey not?\rBut still you came to rescue them out of pity?\rSuch pitifully useless emotions... It’s illogical\nand irrational.\rPity and compassion are products of the weak\nand lacking human heart.\rYou were compelled to come here by such\nvacuous sentimentality!\rI will make you regret paying heed to your heart!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(239)
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_c03gym0101_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 8, 'ev_d26r0104_gingaboss_x1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 9, 'ev_d26r0104_gingaboss_x2')
	_END()
ev_d26r0104_gingaboss_x1:
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_d26r0104_gingaboss_03')
	_OBJ_ANIME_WAIT()
	_JUMP('common_d26r0104_gingaboss_01')
	_JUMP('common_d26r0104_gingaboss_01')
ev_d26r0104_gingaboss_x2:
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_d26r0104_gingaboss_13')
	_OBJ_ANIME_WAIT()
	_JUMP('common_d26r0104_gingaboss_01')
	_JUMP('common_d26r0104_gingaboss_01')
common_d26r0104_gingaboss_01:
	_LDVAL(@WK_PLAY_REPO_NO, 15)
	_FLAG_SET(#FE_PLAY_REPO)
	_LDVAL(@SCWK_TEMP3, 882)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_03_1', 'I see. You are indeed strong.\rAnd the basis of your power is your compassion\ntoward Pokémon.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_03_2', 'How wasteful... Such emotions are but\nmere illusions.\rAnd, like all illusions, they fade over time until\ndeath banishes them forever.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_03_3', 'That is why I have abandoned all emotions as\nuseless sentimentality.\rBut that doesn’t matter. I doubt you will ever\nunderstand my position.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_03_4', 'That said, I recognize that you are strong and\ncourageous to come alone. This is your reward.')
	_LDVAL(@SCWK_TEMP0, 1)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_d26r0104_item_event_ok')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_04_1', 'The Master Ball is the ultimate Poké Ball.\rIt will unfailingly catch any Pokémon in the wild.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_04_2', 'But it is not anything that I require.\rUnlike you Trainers, I do not make Pokémon my\nfriends or partners.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_04_3', 'Unlike other Team Galactic members, I don’t use\nPokémon as tools.\rInstead, I make the power of Pokémon my own.')
	_TALK_CLOSE()
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_d26r0104_gingaboss_10')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_05_1', 'If you wish to save the Pokémon from the lakes,\ntake the warp panel ahead.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_05_2', 'I am off to Mount Coronet.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_gingaboss_05_3', 'That’s correct. Mount Coronet, where you and I\nfirst met.\rI will ascend the mountain to its peak and then\nput an end to everything.\rNo. I will bring about a new beginning\nfor everything...')
	_TALK_CLOSE()
	_OBJ_ANIME('D26R0104_GINGABOSS', 'anm_d26r0104_gingaboss_04')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('D26R0104_GINGABOSS')
	_LDVAL(@WK_SCENE_D26R0104, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 10400)
	_TALK_END()
	_END()
ev_d26r0104_item_event_ok:
	_CALL('ev_item_event')
	_RET()
ev_d26r0104_gingaboss_battle_lose:
	_TALK_END()
	_END()
anm_c03gym0101_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c03gym0101_leader_01_face02:
	_AC_FACE_INDEX(2)
	_ACMD_END()
anm_hero_01:
	_AC_UP(1, 8)
	_ACMD_END()
anm_d26r0104_gingaboss_01:
	_AC_DIR_D(8)
	_ACMD_END()
anm_d26r0104_gingaboss_02:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_d26r0104_gingaboss_03:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_d26r0104_gingaboss_13:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_d26r0104_gingaboss_10:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(4, 8)
	_AC_DIR_U(8)
	_AC_UP(3, 8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_d26r0104_gingaboss_04:
	_AC_DIR_R(8)
	_AC_RIGHT(7, 8)
	_ACMD_END()
ev_d26r0104_door:
	_TALK_OBJ_START()
	_ITEM_CHK(440, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d26r0104_door_02')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_door_01', 'The door is locked. A special key is needed.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0104_door_02:
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_door_02', 'The door is locked. A special key is needed.\rWould you like to use the Galactic Key?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d26r0104_door_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d26r0104_door_no')
	_END()
ev_d26r0104_door_yes:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_door_03', 'The door opened.')
	_SE_WAIT('UI_COMMON_SELECT')
	_SE_PLAY('S_FI014')
	_SET_DOOR_OBJ('P_C_001_AutoDoor_01')
	_HIT_DOOR_ANIME(0)
	_HIT_DOOR_ANIME_WAIT()
	_FLAG_SET(#FV_D26R0104_DOOR)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0104_door_no:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0104_paper1:
	_MACRO_EASY_OBJ_MSG('dialogue_d26r0104', '83-msg_d26r0104_paper1_01', 'Team Galactic Warp Panels!\rThe green warp panel returns you to the\nground floor.\rOnward to a new universe!\n—Team Galactic')
	_END()
ev_d26r0104_pc1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_01', 'Team Galactic Report')
	_JUMP('ev_d26r0104_pc1_menu')
	_END()
ev_d26r0104_pc1_menu:
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_02', 'Which report would you like to read?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_268')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_269')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_270')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_271')
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_d26r0104_pc_menu_01')
	_CASE_JUMP(1, 'ev_d26r0104_pc_menu_02')
	_CASE_JUMP(2, 'ev_d26r0104_pc_menu_03')
	_JUMP('ev_d26r0104_pc_menu_cancel')
	_END()
ev_d26r0104_pc_menu_01:
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_03_1', 'Some say the universe originated from a\nmassive explosion.\rSimilarly, Sinnoh is thought to have been formed\nby an explosion in ancient times.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_03_2', 'Needless to say, the explosion came from the\npower of a Pokémon.\rThe Pokémon must have been the mythical\ncreature considered a deity by the ancients.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_03_3', 'Our aim is not to capture the mythical Pokémon\nbut to obtain its power...\rThe PC entry ends there.')
	_JUMP('ev_d26r0104_pc1_menu')
	_END()
ev_d26r0104_pc_menu_02:
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_04_1', 'The mythical Pokémon...\rAccording to myths, the Pokémon created Sinnoh\nwith its power.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_04_2', 'However, capturing the Pokémon with a\nPoké Ball prevents it from using its full power.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_04_3', 'But with the Red Chain, the Pokémon can be\nshackled, and its power can be used\fwithout restraint...')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_04_4', 'The PC entry ends there.')
	_JUMP('ev_d26r0104_pc1_menu')
	_END()
ev_d26r0104_pc_menu_03:
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_05_1', 'The Red Chain...\rThe Pokémon of the three lakes and\nMount Coronet are somehow connected.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_05_2', 'Capturing the Pokémon of the lakes will free the\nPokémon of Mount Coronet.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_05_3', 'From the Pokémon of the lakes, crystals can be\nextracted to create a Red Chain.\rUsing that Red Chain, the mythical Pokémon can\nbe summoned and shackled to do as\fwe command.')
	_MACRO_TALKMSG('dialogue_d26r0104', '83-msg_d26r0104_pc_05_4', 'The PC entry ends there.')
	_JUMP('ev_d26r0104_pc1_menu')
	_END()
ev_d26r0104_pc_menu_cancel:
	_TALK_CLOSE()
	_TALK_END()
	_END()