ev_d16r0102_flag_change:
	_CALL('ev_d24r0105_flag_change_col_del')
	_IF_FLAGON_CALL($SYS_FLAG_PAIR, 'ev_d24r0105_flag_change_col_set')
	_IFVAL_JUMP(@WK_SCENE_D16R0102, 'EQ', 1, 'ev_d16r0102_flag_change_au')
	_IF_FLAGOFF_JUMP(#FV_D16R0102_SEVEN5, 'ev_d16r0102_flag_change_retry')
	_END()
ev_d16r0102_flag_change_retry:
	_LDVAL(@WK_SCENE_D16R0102, 0)
	_END()
ev_d16r0102_flag_change_au:
	_END()
ev_d16r0102_flag_change_col_set:
	_FLAG_RESET(#FV_WALL_PUT)
	_OBJ_ADD('D16R0102_WALL01')
	_OBJ_ADD('D16R0102_WALL02')
	_RET()
ev_d16r0102_flag_change_col_del:
	_FLAG_SET(#FV_WALL_PUT)
	_OBJ_DEL('D16R0102_WALL01')
	_OBJ_DEL('D16R0102_WALL02')
	_RET()
pos_d16r0102_seven5_01:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(478)
	_EVENT_CAMERA_END_WAIT()
	_BICYCLE_REQ(0)
	_SYS_FLAG_PAIR_RESET()
	_CALL('ev_d16r0102_flag_change_col_del')
	_OBJ_ANIME('PAIR_D16R0102_SEVEN4', 'anm_d16r0102_seven5_100')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_IF_FLAGOFF_CALL(#FE_D16R0102_SEVEN5_TALK, 'ev_d16r0102_seven5_01_talk_off')
	_IF_FLAGON_CALL(#FE_D16R0102_SEVEN5_TALK, 'ev_d16r0102_seven5_01_talk_on')
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI005')
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_pair_01', 'You decided to go with Buck!')
	_ME_WAIT()
	_FLAG_SET(#FE_D16R0102_SEVEN5_TALK)
	_LDVAL(@WK_SCENE_D16R0102, 1)
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_pair_02', 'You won’t regret teaming up! I’ll keep your\nPokémon healthy!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(479)
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@SYS_WORK_PAIR_TRAINER_ID, 485)
	_CALL('ev_set_trainer_id_for_current_gamemode_partner_id')
	_SYS_FLAG_PAIR_SET()
	_CALL('ev_d16r0102_flag_change_col_set')
	_MOVE_CODE_CHANGE('PAIR_D16R0102_SEVEN4', 'MV_PAIR')
	_PAIR_OBJID_SET('PAIR_D16R0102_SEVEN4')
	_TALK_END()
	_END()
ev_d16r0102_seven5_01_talk_off:
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_d16r0102_seven5_01_1', 'Hey! {0,1,0,0}, right? Your buddy\nchallenged me to a battle earlier.\rYeah, I owned the little dude. Made sure he was\ntaught a lesson.')
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_d16r0102_seven5_01_2', 'But I don’t know if I could beat him again next\ntime. Seriously, you’re bound to run into skilled\fTrainers wherever you go!')
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_d16r0102_seven5_01_3', 'Anyway, I found out about this place, but the\nPokémon here are tough...\rWhat do you say we team up and go together?')
	_RET()
ev_d16r0102_seven5_01_talk_on:
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_d16r0102_seven5_02', 'So, yeah, the Pokémon here are tough... What do\nyou say we team up and go together?')
	_RET()
pos_d16r0102_seven5_03:
	_EVENT_START()
	_OBJ_ANIME('PAIR_D16R0102_SEVEN4', 'anm_d16r0102_seven5_110')
	_OBJ_ANIME('HERO', 'anm_d16r0102_player_10')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_d16r0102_seven5_03', 'Whoa, wait up! I can’t go on by myself if you\nleave me now.\rWell, if you gotta go, you gotta go. I’ll stick\naround here for you.')
	_TALK_CLOSE()
	_LDVAL(@WK_SCENE_D16R0102, 0)
	_SYS_FLAG_PAIR_RESET()
	_CALL('ev_d16r0102_flag_change_col_del')
	_MOVE_CODE_CHANGE('PAIR_D16R0102_SEVEN4', 'MV_DOWN')
	_OBJ_ANIME('PAIR_D16R0102_SEVEN4', 'anm_d16r0102_seven5_11')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
anm_d16r0102_player_10:
	_AC_DIR_U(8)
	_ACMD_END()
anm_d16r0102_seven5_11:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
anm_d16r0102_seven5_100:
	_AC_DIR_D(8)
	_ACMD_END()
anm_d16r0102_seven5_110:
	_AC_DIR_D(8)
	_ACMD_END()
pos_d16r0102_seven5_04:
	_EVENT_START()
	_SYS_FLAG_PAIR_RESET()
	_CALL('ev_d16r0102_flag_change_col_del')
	_MOVE_CODE_CHANGE('PAIR_D16R0102_SEVEN4', 'MV_DOWN')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_INDEX(71)
	_OBJ_POS_CHANGE('PAIR_D16R0102_SEVEN4', 47, 11, 3, 90)
	_SXY_POS_CHANGE('HERO', 46, 3)
	_OBJ_DIR_CHANGE('HERO', 270)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_JUMP('common_d16r0102_seven5_04_dir')
	_END()
common_d16r0102_seven5_04_dir:
	_OBJ_ANIME('PAIR_D16R0102_SEVEN4', 'anm_d16r0102_seven5_02')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d16r0102', '66-msg_d16r0102_seven5_04', 'There we go! There’s the exit!\rMy instincts tell me that the volcano’s treasure is\njust ahead of us.\rYou might be the toughest there is—besides me!\nSee you around, {0,1,0,0}!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(72)
	_OBJ_ANIME('PAIR_D16R0102_SEVEN4', 'anm_d16r0102_seven5_03')
	_OBJ_ANIME_WAIT()
	_SE_WAIT('UI_COMMON_SELECT')
	_SE_PLAY('S_FI001')
	_OBJ_DEL('PAIR_D16R0102_SEVEN4')
	_SE_WAIT('S_FI001')
	_LDVAL(@WK_SCENE_D16R0102, 2)
	_FLAG_SET(#FV_D16R0102_SEVEN5)
	_TALK_END()
	_END()
anm_d16r0102_player_01:
	_AC_DIR_R(8)
	_ACMD_END()
anm_d16r0102_seven5_01:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_d16r0102_seven5_01_2:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_d16r0102_seven5_02:
	_AC_DIR_U(8)
	_AC_WAIT(16)
	_AC_DIR_L(8)
	_ACMD_END()
anm_d16r0102_seven5_03:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()