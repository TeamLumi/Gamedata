ev_t01r0401_oldwoman1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_ZUKAN_GET, 'ev_t01r0401_oldwoman1_02')
	_MACRO_TALKMSG('dialogue_t01r0401', '26-msg_t01r0401_oldwoman1_01', 'Did you hear? The Pokémon Professor returned\nto the next town over.\rThey say he was gone for four long years.\rI wonder if he found some amazing Pokémon\nwhile he was gone?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0401_oldwoman1_02:
	_MACRO_TALKMSG('dialogue_t01r0401', '26-msg_t01r0401_oldwoman1_02', 'Well! Professor Rowan gave you a Pokédex,\ndid he?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0401_babygirl1:
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_IF_FLAGON_JUMP(#FE_ZUKAN_GET, 'ev_t01r0401_babygirl1_02')
	_MACRO_TALKMSG('dialogue_t01r0401', '26-msg_t01r0401_babygirl1_01', 'Listen, listen, {0,1,0,0}. I want a\ncute Pokémon!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0401_babygirl1_02:
	_MACRO_TALKMSG('dialogue_t01r0401', '26-msg_t01r0401_babygirl1_02', 'Listen, listen, {0,1,0,0}.\rDo you think I can be friends with Pokémon like\nyou are?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()