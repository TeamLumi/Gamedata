	_SE_STOP('S_FI227_OTHER')
	_SE_PLAY('S_FI230')
	_CAMERA_SHAKE(12, 1, 0, 15, 20)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SE_STOP('S_FI230')
	_JUMP('ev_attach_player_world')
