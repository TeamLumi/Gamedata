ev_distortionr0101_waterfall_1_1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_waterfall_1_1', 'Riding down the waterfall already has your\nhead spinning. Better not try riding back up.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_distortionr0101_waterfall_2_1:
	_EVENT_START()
	_LOAD_CAMERA_CONTROLLER('field/camera/distortionr0101_cam')
	_LOAD_WAIT_CAMERA_CONTROLLER()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_SWITCH(@SCWK_TEMP1)
	_CASE_CALL(77, 'ev_distortionr0101_waterfall_down_2')
	_CASE_CALL(78, 'ev_distortionr0101_waterfall_down_1')
	_CASE_CALL(80, 'ev_distortionr0101_waterfall_up_1')
	_CASE_CALL(81, 'ev_distortionr0101_waterfall_up_2')
	_SXY_DIR_CHANGE('HERO', 90)
	_SXY_POS_CHANGE('HERO', 108, 79)
	_CAMERA_CONTROLLER_PLAY('distortionr0101_cam_waterfall')
	_OBJ_ANIME('HERO', 'anm_distortionr0101_waterfall_2_1')
	_TIME_WAIT(12, @SCWK_ANSWER)
	_GAMEOBJECT_ROTATE_PIVOT('DISTORTIONR0101(Clone)', 0, 0, -90, 30, 'LOCATORS/Locator_ (9)')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_waterfall_2_2')
	_GAMEOBJECT_MOVE('DISTORTIONR0101(Clone)', -19, 0, 0, 680)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_waterfall_2_3')
	_GAMEOBJECT_ROTATE_PIVOT('DISTORTIONR0101(Clone)', 0, 0, -90, 30, 'LOCATORS/Locator_ (10)')
	_OBJ_ANIME_WAIT()
	_CAMERA_CONTROLLER_WAIT('distortionr0101_cam_waterfall')
