	_CALL('ev_distortionr0101_detach_surf_a5')
	_FIND_BG_DISABLE(0, 'AREA_5_GEO')
	_LDVAL(@625, 1)
	_CALL('ev_distortionr0101_attach_surf_a6')
	_IFVAL_CALL(@634, 'EQ', 0, 'ev_distortionr0101_a6_azelf_enable')
	_LDVAL(@630, 9)
	_CAMERA_CONTROLLER_END()
	_SET_CAMERA_OFFSET_ANGLE(27, -52, 0)
	_SET_CAMERA_OFFSET_ANGLE(-37, 72, 105, 0)
	_SET_CAMERA_OFFSET_ANGLE(30, 0, 75, 0)
	_RELEASE_CAMERA_CONTROLLER()
	_EVENT_END()
	_END()

