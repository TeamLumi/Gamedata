	_CALL('ev_distortionr0101_a4_animated_objects_off')
	_CALL('ev_distortionr0101_detach_transform_a4_jumps')
	_FIND_BG_DISABLE(0, 'AREA_4_GEO')
	_IFVAL_CALL(@622, 'EQ', 0, 'ev_distortionr0101_a6_giratina_enable'); Enables the upcoming Giratina flyunder if it hasn't yet been triggered
	_IFVAL_CALL(@629, 'EQ', 0, 'ev_distortionr0101_a6_cam_adj_enable_right'); Enables the camera adjustment for when you walk under the overhang
	_EVENT_END()
	_END()
ev_distortionr0101_a4_a5_island_lift_up:
	_ATTACH_TRANSFORM('HERO', 'AREA_LIFTS/A4_A5_LIFT', 1)
	_FIND_BG_ENABLE(0, 'AREA_4_GEO')
	_CALL('ev_distortionr0101_attach_transform_a4_jumps')
	_CALL('ev_distortionr0101_island_lift_4')
	_GAMEOBJECT_MOVE('AREA_LIFTS/A4_A5_LIFT', 0, 32, 0, 240, 3)
	_CALL('ev_distortionr0101_island_lift_2')
	_LDVAL(@619, 0); Area 4 Lift is up. Player is in Area 4.
	_LDVAL(@630, 12)
	_CALL('ev_distortionr0101_a4_floater_1_on')
	_CALL('ev_distortionr0101_a4_animated_objects_on')
	_IFVAL_CALL(@622, 'EQ', 1, 'ev_distortionr0101_a6_giratina_disable'); Disables the upcoming Giratina flyunder if the player goes back down to Area 4 before it has been triggered
	_IFVAL_CALL(@629, 'GT', 0, 'ev_distortionr0101_a6_cam_adj_disable'); Disables the camera adjustment for when you walk under the overhang
	_EVENT_END()
	_END()
pos_distortionr0101_a7_a8_island_lift:
	_EVENT_START()
	_IFVAL_JUMP(@620, 'EQ', 0, 'ev_distortionr0101_a7_a8_island_lift_down')
	_IFVAL_JUMP(@620, 'EQ', 1, 'ev_distortionr0101_a7_a8_island_lift_up')
ev_distortionr0101_a7_a8_island_lift_down:
	_IF_FLAGOFF_CALL(#3407, 'ev_distortionr0101_a7_cynthia_lift_attach')
	_ATTACH_TRANSFORM('HERO', 'AREA_LIFTS/A7_A8_LIFT', 1)
	_CALL('ev_distortionr0101_island_lift_5')
	_GAMEOBJECT_MOVE('AREA_LIFTS/A7_A8_LIFT', 0, -31, 0, 232.5, 3)
	_CALL('ev_distortionr0101_island_lift_2')
	_LDVAL(@620, 1); Area 7 Lift is down. Player is in Area 8.
	_LDVAL(@630, 16)
	_LDVAL(@635, 1)
	_CALL('ev_distortionr0101_detach_transform_a7_jumps')
	_CALL('ev_distortionr0101_detach_transform_a6_a7_lift_jumps')
	_FIND_BG_DISABLE(0, 'AREA_7_GEO')
	_IFVAL_CALL(@623, 'EQ', 0, 'ev_distortionr0101_a8_cynthia_cyrus_enable'); Enables the upcoming cutscene if it hasn't yet been triggered
	_IF_FLAGOFF_CALL(#3407, 'ev_distortionr0101_a7_cynthia_lift_2')
	_FLAG_SET(#3407); A7 Cynthia has left the platform in Area 8 and is finished with
	_EVENT_END()
	_END()
ev_distortionr0101_a7_a8_island_lift_up:
	_ATTACH_TRANSFORM('HERO', 'AREA_LIFTS/A7_A8_LIFT', 1)
	_FIND_BG_ENABLE(0, 'AREA_7_GEO')
	_CALL('ev_distortionr0101_attach_transform_a7_jumps')
	_CALL('ev_distortionr0101_attach_transform_a6_a7_lift_jumps')
	_CALL('ev_distortionr0101_island_lift_6')
	_GAMEOBJECT_MOVE('AREA_LIFTS/A7_A8_LIFT', 0, 31, 0, 232.5, 3)
	_CALL('ev_distortionr0101_island_lift_2')
	_LDVAL(@620, 0); Area 7 Lift is up. Player is in Area 7.
	_LDVAL(@630, 10)
	_LDVAL(@635, 0)
	_IFVAL_CALL(@623, 'EQ', 1, 'ev_distortionr0101_a8_cynthia_cyrus_disable'); Disables the upcoming cutscene if the player goes back down to Area 7 before it has been triggered
	_EVENT_END()
	_END()


ev_distortionr0101_island_lift_1:
	_SE_PLAY('S_FI229')
	_CAMERA_SHAKE(12, 1, 0, 15, 60)
	_SE_WAIT('S_FI229')
	_TIME_WAIT(40, @SCWK_ANSWER)
	_SE_PLAY('S_FI227_OTHER')
	_RET()
