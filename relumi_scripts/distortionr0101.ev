ev_distortionr0101_tbl:
	_OBJ_POS_GET('HERO', @666, @667, @668)
	_OBJ_DIR_CHANGE('HERO', 0); Resets player's direction so we can attach the skybox properly. Would like to remove this in favour of a better solution eventually.
	_RESET_SYS_FLAG($SYS_FLAG_USE_TODAY_KAIRIKI)
	_RESET_SYS_FLAG($SYS_FLAG_USE_TODAY_NAMINORI)
	_CALL('ev_distortionr0101_wait_for_gameobject')
	_JUMP('ev_distortionr0101_worldstate')
ev_distortionr0101_tbl2:
	_IF_FLAGON_CALL(#3403, 'ev_distortionr0101_a3_cynthia_moved')
	_IF_FLAGON_CALL(#3406, 'ev_distortionr0101_a7_cynthia_solved')
	_IF_FLAGON_CALL(#3408, 'ev_distortionr0101_a8_cynthia_cyrus_moved')
	_IF_FLAGON_CALL(#3421, 'ev_distortionr0101_a8_cyrus_left')
	_IF_FLAGON_CALL(#3422, 'ev_distortionr0101_a8_giratina_appeared')
	_IF_FLAGON_CALL(#3423, 'ev_distortionr0101_a8_giratina_defeated')
	_IF_FLAGOFF_JUMP(#3400, 'ev_distortionr0101_a1_cynthia')
	_END()

ev_distortionr0101_end:
	_END()

ev_distortionr0101_a1_portal:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_portal', 'There is the portal leading back to the\nSpear Pillar.\rLeap into the portal and return to the\nSpear Pillar?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_distortionr0101_a1_portal_yes')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_distortionr0101_a1_portal_yes:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_portal_yes', '{0} headed for the\nSpear Pillar!')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_CALL('ev_distortionr0101_reset_world_works')
	_FADE_WAIT()
	_ATTACH_TRANSFORM('DWSkyBox', 'Dummy', 1)
	_MAP_CHANGE('D05R0114', 7)
	_TALK_OBJ_END()
	_END()

ev_distortionr0101_a8_portal:
	_TALK_START()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_portal', 'There is a portal where Giratina was.\nWill you leap into the portal?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_distortionr0101_a8_portal_yes')
	_TALK_CLOSE()
	_TALK_END()
	_END()

ev_distortionr0101_a8_portal_yes:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_portal_yes', '{0} leapt into the portal.')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FLAG_SET(#3417); Distortion World Story has been completed and the player has exited
	_FLAG_SET(#2941); Distortion World A8 Cynthia
	_CALL('ev_distortionr0101_reset_world_works')
	_FADE_WAIT()
	_ATTACH_TRANSFORM('DWSkyBox', 'Dummy', 1)
	_MAP_CHANGE('D17R0101', 5)
	_TALK_END()
	_END()

ev_distortionr0101_a1_cynthia:
	_EVENT_START()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('HERO', 'anm_distortionr0101_a1_cynthia_player_move_1')
	_OBJ_ANIME_WAIT()
	_SXY_POS_CHANGE('DISTORTIONR0101_A1_CYNTHIA', 50, 39)
	_SXY_DIR_CHANGE('DISTORTIONR0101_A1_CYNTHIA', 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_right')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_up')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_cynthia_1', 'This place...')
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_down')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_a1_cynthia_face_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_cynthia_2', 'Can you feel it?\nThere are no Pokémon here at all.\rTime isn’t flowing.\nAnd space isn’t stable.\fA world where the rules are broken.')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_cynthia_3', 'A space one might call the Distortion World...')
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_left')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_a1_cynthia_face_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_cynthia_4', 'Let’s find Giratina.\rWe need it to stop the spreading distortion at\nthe Spear Pillar...')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_a1_cynthia_move_1')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_a1_cynthia_player_move_2')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(487, 0, 0)
	_EVENT_ENTITY_CLIP_PLAY('A1_GIRATINA', 0)
	_SE_PLAY('PLAY_PM_COMMON_WHOOSH_XL')
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_a1_cynthia_move_2')
	_OBJ_ANIME('HERO', 'anm_distortionr0101_a1_cynthia_player_move_3')
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_right_fast')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_face_right_fast')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_cynthia_5', 'That was...\rGiratina...!')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_up')
	_OBJ_ANIME('HERO', 'anm_distortionr0101_face_down')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_cynthia_6', 'We have to hurry!\rIf something’s not done, the distortion will\nswallow not only our world, it will overwhelm\fthe Distortion World...')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_a1_cynthia_move_3')
	_OBJ_ANIME_WAIT()
	_SXY_POS_CHANGE('DISTORTIONR0101_A1_CYNTHIA', 34, 51)
	_SXY_DIR_CHANGE('DISTORTIONR0101_A1_CYNTHIA', 270)
	_FLAG_SET(#3400); Distortion World intro cutscene complete
	_EVENT_END()
	_END()

ev_distortionr0101_jump_a1_lift:
	_EVENT_START()
	_TURN_HERO_TALK_OBJ()
	_JUMP('ev_distortionr0101_jump_a1_lift_down')
	_END()
ev_distortionr0101_jump_a1_lift_down:
	_OBJ_ANIME('HERO', 'anm_player_face_for_jump_down')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('HERO', 3.0, 0.75, 0.0, 0.7)
	_IF_FLAGOFF_JUMP(#3401, 'ev_distortionr0101_jump_a1_lift_cynthia')
	_EVENT_END()
	_END()
ev_distortionr0101_jump_a1_lift_cynthia:
	_TIME_WAIT(20, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_lift_cynthia', 'This rock slab...\rIt appears to move if you step on a certain\nspot.')
	_TALK_CLOSE()
	_FLAG_SET(#3401); Cynthia explained DW lifts
	_EVENT_END()
	_END()
ev_distortionr0101_jump_a1_lift_cynthia_again:
	_MACRO_EASY_OBJ_MSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_lift_cynthia_again', 'On the ground here...\nWhy is it colored differently?')
	_END()

ev_distortionr0101_jump_a1_lift_cynthia_leave:
	_OBJ_ANIME('HERO', 'anm_distortionr0101_face_up')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(50, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_down')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a1_lift_cynthia_leave', 'Will we get to see Giratina if we keep going\ndown?\r...In the Distortion World, are we really\ntravelling downward?')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_jump_a1_lift_cynthia_leave')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_face_left')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('DISTORTIONR0101_A1_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_LEDGE_JUMP('DISTORTIONR0101_A1_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_down')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(5, @SCWK_ANSWER)
	_LEDGE_JUMP('DISTORTIONR0101_A1_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_OBJ_ANIME('DISTORTIONR0101_A1_CYNTHIA', 'anm_distortionr0101_face_left')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(5, @SCWK_ANSWER)
	_LEDGE_JUMP('DISTORTIONR0101_A1_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_FLAG_SET(#3402); Distortion World A1 Cynthia
	_FLAG_RESET(#2937); Distortion World A3 Cynthia
	_OBJ_DEL('DISTORTIONR0101_A1_CYNTHIA')
	_OBJ_ADD('DISTORTIONR0101_A3_CYNTHIA')
	_ATTACH_TRANSFORM('DISTORTIONR0101_A3_CYNTHIA', 'AREA_3_GEO/Island_1/A3_CYNTHIA', 0)
	_RET()

pos_distortionr0101_a2_mespirit:
	_EVENT_START()
	_VOICE_PLAY(481, 0, 0)
	_VOICE_WAIT()
	_EVENT_CAMERA_INDEX(601)
	_LOAD_UMA_ANIME('field/animeobj/distortionr0101_obj')
	_LOAD_UMA_ANIME_WAIT()
	_UMA_ANIME_ATTACH(0, 'DISTORTIONR0101_A2_MESPIRIT')
	_UMA_ANIME_PLAY(0, 'A2_MESPIRIT_1')
	_UMA_PLAY_WAIT(0, 'A2_MESPIRIT_1')
	_CHARA_LOOK_LOCK('HERO', 'DISTORTIONR0101_A2_MESPIRIT')
	_TIME_WAIT(60, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(602)
	_UMA_ANIME_PLAY(0, 'A2_MESPIRIT_2')
	_OBJ_ANIME('DISTORTIONR0101_A2_MESPIRIT', 'anm_distortionr0101_a2_mespirit_1')
	_UMA_PLAY_WAIT(0, 'A2_MESPIRIT_2')
	_CHARA_LOOK_RELEASE('HERO')
	_EVENT_CAMERA_INDEX(600)
	_UMA_IS_NULL(0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_distortionr0101_uma_release')
	_OBJ_DEL('DISTORTIONR0101_A2_MESPIRIT')
	_FLAG_SET(#3409); A2 Mesprit Cutscene complete
	_LDVAL(@631, 1); A2 Mesprit
	_EVENT_CAMERA_END_WAIT()
	_EVENT_END()
	_END()
ev_distortionr0101_uma_release:
	_RELEASE_UMA_ANIME('field/animeobj/distortionr0101_obj')
	_RET()
anm_distortionr0101_a2_mespirit_1:
	_AC_WAIT(10)
	_AC_ANIME_DURATION(0.333330)
	_AC_INDEX_ANIME(2)
	_AC_INDEX_ANIME_WAIT()
	_AC_INDEX_ANIME(2)
	_AC_INDEX_ANIME_WAIT()
	_AC_ANIME_DURATION(0.333330)
	_AC_INDEX_ANIME(10)
	_AC_INDEX_ANIME_WAIT()
	_AC_ANIME_DURATION(0.233330)
	_AC_INDEX_ANIME(1)
	_AC_INDEX_ANIME_WAIT()
	_AC_INDEX_ANIME(1)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()

ev_distortionr0101_a3_cynthia:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#3403, 'ev_distortionr0101_a3_cynthia_again')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a3_cynthia', 'The legend of Giratina has been forgotten to\nall but a few...\rThe legend told of a world on the other side\nof ours. This world.\rWhy does this world exist?\nWhy is Giratina here all alone?\r...There’s so much that can’t be explained, but\nwe have things to do.\rLet’s split up.\nWe have to find the right way.\rOh right.\rSince we’re cut off from our own world, we\nwill not be able to rely on the help of wild\fPokémon to perform Hidden Moves for us.\rYou can call on the assistance of mine if you\nencounter any obstacles.')
	_TALK_CLOSE()
	_IFVAL_CALL(@SCWK_TEMP1, 'LE', 20, 'ev_distortionr0101_a3_cynthia_player_move')
	_OBJ_ANIME('DISTORTIONR0101_A3_CYNTHIA', 'anm_distortionr0101_a3_cynthia_move_1')
	_OBJ_ANIME_WAIT()
	_FLAG_SET(#3403); A3 Cynthia moved out of the way
	_TALK_OBJ_END()
	_END()
ev_distortionr0101_a3_cynthia_player_move:
	_OBJ_ANIME('HERO', 'anm_distortionr0101_a3_cynthia_player_move_1')
	_OBJ_ANIME_WAIT()
	_RET()
ev_distortionr0101_a3_cynthia_again:
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a3_cynthia_again', 'We don’t need to go together now.\nLet’s keep looking for the way down.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_distortionr0101_jump_a4_cyrus:
	_EVENT_START()
	_TURN_HERO_TALK_OBJ()
	_CALL('ev_distortionr0101_jump_a4_cyrus_down')
	_TALK_END()
	_END()
ev_distortionr0101_jump_a4_cyrus_down:
	_OBJ_ANIME('HERO', 'anm_player_face_for_jump_down')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('HERO', 3.0, 0.75, 0.0, 0.7)
	_IF_FLAGOFF_JUMP(#3404, 'ev_distortionr0101_jump_a4_cyrus_scene')
	_EVENT_END()
	_END()
ev_distortionr0101_jump_a4_cyrus_scene:
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A4_CYRUS', 'anm_distortionr0101_jump_a4_cyrus_move_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_jump_a4_cyrus_scene_1', '...The shadowy Pokémon isn’t here.\rIt abandoned me here, then disappeared\nsomewhere farther down...\rWas it content merely to interfere with my\nplan...?\rIncidentally, do you understand the concept\nof genes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_distortionr0101_jump_a4_cyrus_scene_yes')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_distortionr0101_jump_a4_cyrus_scene_no')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_jump_a4_cyrus_scene_2', 'Genes can be considered the blueprints of all\nlife-forms.\rThat includes humans and Pokémon alike.\rGenes are contained in a DNA strand.\rA DNA strand consists of two chains of\nopposing characteristics in a spiral.\rIf one of the chains were to be broken, the\nother could replicate it.\rOne or the other cannot exist without its\nopposite.\rDo you understand where I am going with this?\rThis is a bizarre world.\nTime doesn’t flow.\fSpace isn’t stable.\rOnly that shadowy Pokémon lives here.\rThis world is the opposite of our world—our\nworld I wish to change.\rIt is like the two chains composing a strand of\nDNA.\rThe two worlds must be balancing each other\nto remain in existence.\rWithout the one, the other cannot exist.\rThe shadowy Pokémon must play a role in\nkeeping the worlds in balance.\rThat is why it must have interfered and brought\nme here.\rThe shadowy Pokémon must have made this\nbizarre world.\rThat’s why trying to change our world\ndisturbed it and made it reveal itself.\rBut that is all irrelevant.\rWhat matters is defeating that Pokémon and\nmaking this world disappear.\rI won’t allow it to interfere with me again.\rWith it gone, neither world will be able to\nrevert to its original state...')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A4_CYRUS', 'anm_distortionr0101_jump_a4_cyrus_move_2')
	_OBJ_ANIME_WAIT()
	_FLAG_SET(#3404); Distortion World A4 Cyrus
	_FLAG_SET(#2937); Distortion World A3 Cynthia
	_FLAG_RESET(#2938); Distortion World A5 Cyrus
	_FLAG_RESET(#2939); Distortion World A7 Cynthia
	_OBJ_DEL('DISTORTIONR0101_A4_CYRUS')
	_OBJ_DEL('DISTORTIONR0101_A3_CYNTHIA')
	_OBJ_ADD('DISTORTIONR0101_A5_CYRUS')
	_OBJ_ADD('DISTORTIONR0101_A7_CYNTHIA')
	_ATTACH_TRANSFORM('DISTORTIONR0101_A5_CYRUS', 'AREA_5_GEO/Island_2/A5_CYRUS', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_A7_CYNTHIA', 'AREA_7_GEO/Island/A7_CYNTHIA', 0)
	_EVENT_END()
	_END()
ev_distortionr0101_jump_a4_cyrus_scene_yes:
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_jump_a4_cyrus_scene_yes', '...If it’s true, you’ve impressed me.')
	_RET()
ev_distortionr0101_jump_a4_cyrus_scene_no:
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_jump_a4_cyrus_scene_no', '...No, of course, you wouldn’t.')
	_RET()

