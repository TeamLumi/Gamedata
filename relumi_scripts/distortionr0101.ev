ev_distortionr0101_jump_a8_giratina_sequence_4_up:
	_OBJ_ANIME('HERO', 'anm_player_face_for_jump_up')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('HERO', 3.0, 0.75, 0.0, 0.7)
	_IF_FLAGOFF_JUMP(#3420, 'ev_distortionr0101_jump_a8_giratina_sequence_4_scene')
	_EVENT_END()
	_END()
ev_distortionr0101_jump_a8_giratina_sequence_4_scene:
	_SE_PLAY('PLAY_PM_COMMON_WHOOSH_L')
	_EVENT_ENTITY_CLIP_PLAY('A8_GIRATINA_2', 0)
	_EVENT_ENTITY_CLIP_WAIT('A8_GIRATINA_2')
	_FLAG_SET(#3420); A8 Giratina Sequence 4 complete
	_EVENT_END()
	_END()

ev_distortionr0101_jump_a8_giratina_sequence_5:
	_EVENT_START()
	_TURN_HERO_TALK_OBJ()
	_CALL('ev_distortionr0101_jump_a8_giratina_sequence_5_up')
	_TALK_END()
	_END()
ev_distortionr0101_jump_a8_giratina_sequence_5_up:
	_OBJ_ANIME('HERO', 'anm_player_face_for_jump_up')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('HERO', 3.0, 0.75, 0.0, 0.7)
	_IF_FLAGOFF_JUMP(#3422, 'ev_distortionr0101_jump_a8_giratina_sequence_5_scene')
	_EVENT_END()
	_END()
ev_distortionr0101_jump_a8_giratina_sequence_5_scene:
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_ATTACH_TRANSFORM('DWSkyBox', 'DISTORTIONR0101(Clone)', 1)
	_FIND_BG_DISABLE(0, 'DWSkyBox/CloudStormFast')
	_FIND_BG_ENABLE(0, 'DWSkyBox/CloudStormReverse')
	_ATTACH_TRANSFORM('DWSkyBox', 'Main Camera', 1)
	_SET_LIGHTINTENSITY_POKE(80, 0.4)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_EVENT_ENTITY_CLIP_PLAY('A8_GIRATINA_3', 0)
	_EVENT_ENTITY_CLIP_WAIT('A8_GIRATINA_3')
	_EVENT_ENTITY_CLIP_PLAY('A8_GIRATINA_3', 1)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_jump_a8_giratina_sequence_4_scene', 'Giratina is quietly eyeing {0}...')
	_TALK_CLOSE()
	_ATTACH_TRANSFORM('DISTORTIONR0101_A8_GIRATINA', 'AREA_8_GEO/A8_GIRATINA_FIGHT', 0)
	_FLAG_SET(#3422); A8 Giratina Sequence 5 complete
	_LDVAL(@637, 2)
	_EVENT_END()
	_END()

ev_distortionr0101_giratina_battle:
	_TALK_START()
	_VOICE_PLAY(487, 1, 0); Giratina scream
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_d34r0110_giartina_02', 'Giygogagohgwooh!')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET_EXTRA(487, 1, 100, 3, 0, -1, -1, -1, -1, 1)
	_JUMP('ev_distortionr0101_post_giratina_battle')
ev_distortionr0101_post_giratina_battle:
	_SET_LIGHTINTENSITY_POKE(0, 1)
	_FLAG_SET(#3423); Distortion World Giratina Defeated
	_OBJ_DEL('DISTORTIONR0101_A8_GIRATINA')
	_EVENT_ENTITY_CLIP_PLAY('A8_GIRATINA_3', 2)
	_ATTACH_TRANSFORM('DWSkyBox', 'DISTORTIONR0101(Clone)', 1)
	_FIND_BG_DISABLE(0, 'DWSkyBox/CloudStormReverse')
	_FIND_BG_ENABLE(0, 'DWSkyBox/CloudStormNormal')
	_ATTACH_TRANSFORM('DWSkyBox', 'Main Camera', 1)
	_ATTACH_TRANSFORM('DISTORTIONR0101_A8_PORTAL', 'AREA_8_GEO/A8_GIRATINA_FIGHT', 0)
	_CALL('ev_distortionr0101_worldstate_attach_jumps')
	_ATTACH_TRANSFORM('DISTORTIONR0101_JUMP_A8_84_47', 'Dummy', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_WALL', 'AREA_8_GEO/Island_4/A8_WALL_MOVE', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_A8_CYNTHIA', 'AREA_8_GEO/Island_4/A8_CYNTHIA', 0)
	_TIME_WAIT(2, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_setup_cutscene')
	_OBJ_ANIME_WAIT()
	_LDVAL(@635, 1)
	_LDVAL(@637, 0)
	_LDVAL(@489, 2); TODO Use a different work for Cynthia's talking in Sendoff Spring. This is also used for the E4 Aaron fight in Hearthome
	_JUMP('ev_distortionr0101_ending_scene')
ev_distortionr0101_ending_scene:
	_LEDGE_JUMP('DISTORTIONR0101_A8_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_LEDGE_JUMP('DISTORTIONR0101_A8_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ADD('DISTORTIONR0101_A8_CYRUS')
	_ATTACH_TRANSFORM('DISTORTIONR0101_A8_CYRUS', 'AREA_8_GEO/Island_4/A8_CYRUS', 0)
	_TIME_WAIT(2, @SCWK_ANSWER)
	_ENTITY_MOVE('DISTORTIONR0101_A8_CYRUS', 0, -1, 0, 1); Cyrus gets loaded in at the wrong height for *some reason* so we need to move him down like this. More traditional methods of ensuring correct height all failed.
	_OBJ_ANIME('DISTORTIONR0101_A8_CYRUS', 'anm_distortionr0101_setup_cutscene')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cynthia_1', 'Giratina seems to have understood us!')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cyrus_1', 'That Pokémon...\rThat shadowy Pokémon was defeated?!')
	_TALK_CLOSE()
	_DUMMY_SET_POS_HERO()
	_CAMERA_TARGET_DUMMY()
	_DUMMY_ANIME('anm_distortionr0101_ending_scene_cam_1')
	_OBJ_ANIME('HERO', 'anm_player_face_for_jump_down')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_player_face_for_jump_down')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('DISTORTIONR0101_A8_CYRUS', 3.0, 0.75, 0.0, 0.7)
	_DUMMY_ANIME_WAIT()
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cyrus_2', 'Your doing so means this irrational world will\nremain in existence!\rDoes that make it impossible for me to create\na new world?\rEven if I made new Red Chains, the new world\ncan’t be made!\rWhy?! What compels you to protect the two\nworlds?\rIs spirit, a vague and incomplete thing, so\nimportant to you?!')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cynthia_2', '...The places we are born.\rThe time we spend living...\rThe languages we speak...\rWe are all different.\nBut the presence of Pokémon unites us.\rWe share our lives with our Pokémon, and our\nhappiness grows as we all become greater\fthan we were alone.\rThat is why we can battle and trade with\nanyone we choose...')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cyrus_3', '<size=250%>Silence!</size>\rEnough of your blathering!\rThat’s how you justify spirit as something\nworthwhile?!\rThat is merely humans hoping, deluding\nthemselves that they are happy and safe!\rThe emotions roiling inside me...\nRage, hatred, frustration...\rThese ugly emotions arise because of my own\nincomplete spirit!\r...Enough.\nWe will never see eye to eye.\rThis, I promise you.\nI will break the secrets of the world.\rWith that knowledge, I will create my complete\nand perfect world.\rOne day, you will awaken to a world of my\ncreation.\rA world without spirit.')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A8_CYRUS', 'anm_player_face_for_jump_down')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('DISTORTIONR0101_A8_CYRUS', 3.0, 0.75, 0.0, 0.7)
	_OBJ_ANIME('DISTORTIONR0101_A8_CYRUS', 'anm_distortionr0101_ending_scene_cyrus')
	_OBJ_ANIME_WAIT()
	_OBJ_INVISIBLE('DISTORTIONR0101_A8_CYRUS')
	_DUMMY_ANIME('anm_distortionr0101_ending_scene_cam_2')
	_DUMMY_ANIME_WAIT()
	_CAMERA_TARGET_HERO()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cynthia_3', '...\n...\rSince there is sadness, we can feel joy.\rWhen there is anger, compassion is born...')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_face_up_fast')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_ending_scene_cynthia_4', 'Let’s go back home.\rThe portal where Giratina was should lead\nback to our world.\rGiratina was written in legend as being on the\nother side of our world.\rIt stands to reason that it has a link to the\nother side.')
	_TALK_CLOSE()
	_TALK_END()
	_END()

anm_distortionr0101_ending_scene_cam_1:
	_AC_DOWN(3, 12)
	_ACMD_END()
anm_distortionr0101_ending_scene_cam_2:
	_AC_UP(3, 12)
	_ACMD_END()
anm_distortionr0101_setup_cutscene:; For some reason this is the only way I could get Cynthia and Cyrus into position correctly
	_AC_WORLD_X(77, 1)
	_AC_WORLD_Z(56, 1)
	_AC_DIR_U(2)
	_AC_UP(1, 4)
	_AC_WAIT(2)
	_ACMD_END()
anm_distortionr0101_ending_scene_cyrus:
	_AC_DOWN(3, 8)
	_ACMD_END()

