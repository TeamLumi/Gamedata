ev_distortionr0101_a7_cynthia:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#3406, 'ev_distortionr0101_a7_cynthia_lift_1')
	_IF_FLAGOFF_JUMP(#3414, 'ev_distortionr0101_a7_cynthia_unsolved')
	_IF_FLAGOFF_JUMP(#3415, 'ev_distortionr0101_a7_cynthia_unsolved')
	_IF_FLAGOFF_JUMP(#3416, 'ev_distortionr0101_a7_cynthia_unsolved')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a7_cynthia', 'I guess the Pokémon of the lakes must have\ngone home.\rI understand they can keep balance against\neither Palkia or Dialga.\rDoes it mean they can’t do that with Giratina?\r...Oops.\nThis is no time for idle chitchat.')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SE_PLAY('PLAY_UI_COMMON_PM_ENCOUNT_CAVE')
	_EVENT_ENTITY_CLIP_PLAY('A7_A8_LIFT_ENTITY', 1)
	_EVENT_ENTITY_CLIP_WAIT('A7_A8_LIFT_ENTITY')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A7_CYNTHIA', 'anm_distortionr0101_a7_cynthia_move_1')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('DISTORTIONR0101_A7_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A7_CYNTHIA', 'anm_distortionr0101_a7_cynthia_move_2')
	_OBJ_ANIME_WAIT()
	_CALL('ev_distortionr0101_a7_cynthia_solved')
	_FLAG_SET(#3406); A7 Cynthia got out of the way
	_FLAG_RESET(#2940); Distortion World A8 Cyrus
	_OBJ_ADD('DISTORTIONR0101_A8_CYRUS')
	_ATTACH_TRANSFORM('DISTORTIONR0101_A8_CYRUS', 'AREA_8_GEO/Island_4/A8_CYRUS', 0)
	_TALK_OBJ_END()
	_END()
ev_distortionr0101_a7_cynthia_unsolved:
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a7_cynthia_unsolved', 'This place...\nIt seems to be a giant puzzle.\rMaybe Giratina wants to test those that visit\nhere?\rIt appears as if we can’t go on unless we solve\nthe puzzle.\rThere were some boulders that could be\nmoved...\rAnd there are several odd pits on the floor...\rThe Pokémon of the lakes seem eager to show\nus something...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_distortionr0101_a7_cynthia_lift_1:
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a7_cynthia_lift_1', 'Call it a Trainer’s intuition, but we’re getting\nclose.\rLet’s go on!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_distortionr0101_a7_cynthia_lift_2:
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('HERO', 'anm_distortionr0101_face_up_fast')
	_OBJ_ANIME('DISTORTIONR0101_A7_CYNTHIA', 'anm_distortionr0101_face_up_fast')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a7_cynthia_lift_2', 'This is it...\nGiratina is up ahead.')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A7_CYNTHIA', 'anm_distortionr0101_a7_cynthia_move_3')
	_OBJ_ANIME_WAIT()
	_LEDGE_JUMP('DISTORTIONR0101_A7_CYNTHIA', 3.0, 0.75, 0.0, 0.7)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('DISTORTIONR0101_A7_CYNTHIA', 'anm_distortionr0101_a7_cynthia_move_4')
	_OBJ_ANIME_WAIT()
	_FLAG_SET(#2939); Distortion World A7 Cynthia
	_FLAG_RESET(#2941); Distortion World A8 Cynthia
	_OBJ_DEL('DISTORTIONR0101_A7_CYNTHIA')
	_OBJ_ADD('DISTORTIONR0101_A8_CYNTHIA')
	_ATTACH_TRANSFORM('DISTORTIONR0101_A8_CYNTHIA', 'AREA_8_GEO/Island_4/A8_CYNTHIA', 0)
	_RET()
ev_distortionr0101_a7_cynthia_lift_attach:
	_ATTACH_TRANSFORM('DISTORTIONR0101_A7_CYNTHIA', 'AREA_LIFTS/A7_A8_LIFT', 1)
	_RET()

ev_distortionr0101_a8_cynthia_cyrus_enable:
	_LDVAL(@623, 1)
	_RET()
ev_distortionr0101_a8_cynthia_cyrus_disable:
	_LDVAL(@623, 0)
	_RET()
pos_distortionr0101_a8_cynthia_cyrus:
	_EVENT_START()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_1', '...So, you were already here.')
	_TALK_CLOSE()
	_OBJ_ANIME('DISTORTIONR0101_A8_CYRUS', 'anm_distortionr0101_a8_cyrus_move_1')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_a8_cynthia_move_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_2', 'Why do you seek to change the world?\rIf you hate our world, you should just go off\nsomewhere alone.\rFind somewhere where you can live without\nseeing others.')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cyrus_1', 'Why should I run and hide from the world and\nhave to wait quietly?\rMy aim is to rid our world of the vague and\nincomplete thing we call spirit.\rBy freeing ourselves of that, our world can be\nmade complete.\rThat is my justice!\nNo one can interfere!')
	_TALK_CLOSE()
	_FLAG_SET(#3408); A8 Cyrus and Cynthia cutscene completed and they have moved
	_LDVAL(@623, 2); Prevents this scene from being re-enabled by the A7_A8 lift
	_EVENT_END()
	_END()

ev_distortionr0101_a8_cynthia:
	_TALK_START()
	_IF_FLAGON_JUMP(#3421, 'ev_distortionr0101_a8_cynthia_post_battle')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_3', 'But...\nThat’s no justice at all!')
	_TALK_CLOSE()
	_TALK_END()
	_END()

ev_distortionr0101_a8_cynthia_post_battle:
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_post_battle', 'I know that the bond you share with your\nPokémon is strong!')
	_TALK_CLOSE()
	_TALK_END()
	_END()

ev_distortionr0101_a8_cyrus:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cyrus_2', 'I won’t lose!\rNot to that shadowy Pokémon!\nNot in any worthless world!')
	_TALK_CLOSE()
	_CALL('ev_distortionr0101_randomteam_cyrus')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_JUMP('ev_distortionr0101_a8_cyrus_post_battle')

ev_distortionr0101_a8_cyrus_post_battle:
	_CALL('ev_distortionr0101_worldstate_attach_jumps')
	_ATTACH_TRANSFORM('DISTORTIONR0101_JUMP_A8_80_83', 'Dummy', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_JUMP_A8_80_82', 'Dummy', 0)
	_SXY_POS_CHANGE('HERO', 73, 75)
	_SXY_DIR_CHANGE('HERO', 180)
	_OBJ_POS_CHANGE_WORLD('DISTORTIONR0101_A8_CYRUS', 73, -159, 74)
	_OBJ_DIR_CHANGE('DISTORTIONR0101_A8_CYRUS', 0)
	_OBJ_POS_CHANGE_WORLD('DISTORTIONR0101_A8_CYNTHIA', 72, -159, 74)
	_OBJ_DIR_CHANGE('DISTORTIONR0101_A8_CYNTHIA', 270)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cyrus_3', '...Don’t think that you can defeat or capture\nthat Pokémon.\rThis bizarre world is none other than that\nPokémon itself!\rCapturing it or defeating it will make this world\ndisappear!\rVery well!\nDo what you will!\rRather than repairing the world, you’re going\nto destroy it for me!\rDo it.\nYou inherit my legacy.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_a8_hero_move_1')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYRUS', 'anm_distortionr0101_a8_cyrus_move_2')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_a8_cynthia_move_2')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('DISTORTIONR0101_A8_CYRUS')
	_ATTACH_TRANSFORM('DISTORTIONR0101_JUMP_A8_80_83', 'Dummy', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_JUMP_A8_80_82', 'Dummy', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_WALL', 'AREA_8_GEO/Island_4/A8_WALL', 0)
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_a8_cynthia_move_3')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_4', 'Don’t believe his lies.')
	_OBJ_ANIME('HERO', 'anm_distortionr0101_face_up_fast')
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_5', 'It’s not possible that a Pokémon can make the\nworld disappear.\rThe world awaited your birth.\nNot only yours, either.')
	_SET_FORCE_BLINK('DISTORTIONR0101_A8_CYNTHIA', 1)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_6', 'The Pokémon with you.\nThe people close to you.\rAll the Pokémon and people were born\nbecause they have a part in the world.\rI’m convinced of that.')
	_SET_FORCE_BLINK('DISTORTIONR0101_A8_CYNTHIA', 0)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_7', 'Giratina won’t go out of existence.\nThis Distortion World won’t disappear.\fOur world won’t disappear, either.\rLet’s go meet Giratina.')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_a8_cynthia_face_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_8', '...Oops. I should do something about your\nhardworking Pokémon first.')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_a8_cynthia_face_2')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_heal', 'Cynthia fully healed {0}’s\nPokémon.')
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_9', 'Now let’s go meet Giratina!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_distortionr0101_a8_hero_move_2')
	_OBJ_ANIME('DISTORTIONR0101_A8_CYNTHIA', 'anm_distortionr0101_a8_cynthia_move_4')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_distortionr0101', 'msg_distortionr0101_a8_cynthia_10', 'Giratina is enraged because the two worlds are\nendangered.\rIt has merged the Distortion World and our\nworld at the Spear Pillar.\rThat’s why both worlds are becoming\ndistorted.\rBut there’s nothing to fear.\rIf you can defeat Giratina and show it the\nstrong bond you share with your Pokémon,\fI am sure it will understand once it sees your\fsynchronicity.\rThe distortion of the two worlds will stop!')
	_TALK_CLOSE()
	_GAMEOBJECT_MOVE('AREA_LIFTS/A7_A8_LIFT', 0, 31, 0, 0)
	_LDVAL(@620, 2); Area 7 Lift is up. Player is in Area 8.
	_FLAG_SET(#3421); Cyrus has been defeated in the Distortion World
	_FLAG_SET(#2940); Distortion World A8 Cyrus
	_TALK_OBJ_END()
	_END()

