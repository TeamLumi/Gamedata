ev_item_event:
	_ADD_ITEM(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_GET_POCKET_NO(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 8, 'event_item_get_key_item'); Key Item Pocket
	_IFVAL_CALL(@SCWK_ANSWER, 'NE', 8, 'event_item_get_regular_item')
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(420, 'ev_poketch_soft_app_text_h01')
	_CASE_JUMP(421, 'ev_poketch_soft_app_text_h02')
	_CASE_JUMP(422, 'ev_poketch_soft_app_text_h03')
	_CASE_JUMP(423, 'ev_poketch_soft_app_text_h04')
	_CASE_JUMP(424, 'ev_poketch_soft_app_text_h05')
	_CASE_JUMP(425, 'ev_poketch_soft_app_text_h06')
	_CASE_JUMP(426, 'ev_poketch_soft_app_text_h07')
	_CASE_JUMP(427, 'ev_poketch_soft_app_text_h08')
	_RET()
event_item_get_key_item:
	; If we haven't set the @SCWK_TEMP2 to be 69420, we play the fanfare
	_IFVAL_CALL(@SCWK_TEMP2, 'NE', 69420, 'ev_play_pocket_fanfare')
	_PLAYER_NAME(0)
	_ITEM_NAME(1, @SCWK_TEMP0, 1)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_event_item_get_04', 'You obtained the <color=#0064FFFF>{1,1,9,0}</color>!')
	_ME_WAIT()
	; If we set the @SCWK_TEMP2 to be 69420, we skip the "You put into x pocket"
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 69420, 'event_item_return')
	; TEMP0 is still the item id that was set in the call to ev_item_event
	_GET_POCKET_NO(@SCWK_TEMP0, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_ITEM_NAME(1, @SCWK_TEMP0, @SCWK_TEMP1)
	_POCKET_NAME(2, @SCWK_ANSWER)
	_TALKMSG('dialogue_common_scr%91-msg_event_item_get_07')
	_RET()
event_item_get_regular_item:
	; If we haven't set the @SCWK_TEMP2 to be 69420, we play the fanfare
	_IFVAL_CALL(@SCWK_TEMP2, 'NE', 69420, 'ev_play_pocket_fanfare')
	_ITEM_NAME(0, @SCWK_TEMP0, @SCWK_TEMP1)
	_TALKMSG('dialogue_common_scr%91-msg_event_item_get_01')
	_ME_WAIT()
	_AUSU_ITEM_CHECK(@SCWK_TEMP0, @SCWK_ANSWER); Check if this is an Arceus plate
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_plate_msg_sub')
	; If we set the @SCWK_TEMP2 to be 69420, we skip the "You put into x pocket"
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 69420, 'event_item_return')
	; TEMP0 is still the item id that was set in the call to ev_item_event
	_GET_POCKET_NO(@SCWK_TEMP0, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_ITEM_NAME(1, @SCWK_TEMP0, @SCWK_TEMP1)
	_POCKET_NAME(2, @SCWK_ANSWER)
	_TALKMSG('dialogue_common_scr%93-msg_fld_item_get_10')
	_RET()
event_item_return:
	_RET()
ev_item_event_fail:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_event_item_get_03', 'Too bad! The Bag is full...')
	_RET()
ev_pc_on:
	_EVENT_START()
	_EVENT_ENTITY_CLIP_PLAY('P_RO_005_Machine_03', 1)
	_FLAG_SET(#FE_PC_USE_START); Flag is not reset??
	_SE_PLAY('S_ME046')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_pc_on_01', 'You booted up the PC.')
	_JUMP('ev_pc_on_menu01')
	_END()
ev_pc_on_menu01:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_pc_on_02', 'Which PC should be accessed?')
	_IF_FLAGON_CALL($SYS_BOX_SYSTEM_OFF, 'ev_pc_on_menu01_portable_boxes_off_options'); Someone's PC
	_IF_FLAGOFF_CALL($SYS_BOX_SYSTEM_OFF, 'ev_pc_on_menu01_portable_boxes_on_options'); Bebé's PC and Your PC
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_pc_on_menu01_natdex_off_options'); Add Call to Rowan
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_pc_on_menu01_natdex_on_options'); Add Call to Oak
	_IF_FLAGON_CALL($SYS_FLAG_GAME_CLEAR, 'ev_pc_on_menu01_hall_of_fame_on_options'); Add Hall of Fame option
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_064', 4)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP2)
	_SWITCH(@SCWK_TEMP2)
	_CASE_JUMP(0, 'ev_pc_on_main_box'); Bebe's PC
	_CASE_JUMP(1, 'ev_pc_on_your_pc'); Your PC
	_CASE_JUMP(2, 'ev_pc_on_call_professor'); Call for Dex Check
	_CASE_JUMP(3, 'ev_pc_on_hall_of_fame'); Hall of Fame
	_CASE_JUMP(4, 'ev_pc_on_cancel'); Switch Off
	_JUMP('ev_pc_on_cancel')
	_END()
ev_pc_on_menu01_portable_boxes_off_options:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_058', 0)
	_RET()
ev_pc_on_menu01_portable_boxes_on_options:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_059', 0)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_060', 1)
	_RET()
ev_pc_on_menu01_natdex_off_options:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_063', 2)
	_RET()
ev_pc_on_menu01_natdex_on_options:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_062', 2)
	_RET()
ev_pc_on_menu01_hall_of_fame_on_options:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_061', 3); Hall of Fame
	_RET()
ev_pc_on_main_box:
	_SE_PLAY('S_ME047')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_pc_on_03', 'The Pokémon Boxes were accessed.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115); TODO Change this to be a better camera
	_EVENT_CAMERA_END_WAIT()
	_BOX_SET_PROC()
	_BOX_SEAL_UI_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_pc_on_menu01')
	_END()
ev_pc_on_your_pc:
	_SE_PLAY('S_ME047')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_pc_on_04', 'Accessed {0,1,0,0}’s PC.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115); TODO Change this to be a better camera
	_EVENT_CAMERA_END_WAIT()
	_CUSTOM_BALL_EVENT_CALL()
	_BOX_SEAL_UI_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_pc_on_menu01')
	_END()
ev_pc_on_hall_of_fame:
	_SE_PLAY('S_ME047')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115); TODO Change this to be a better camera
	_EVENT_CAMERA_END_WAIT()
	_PC_DENDOU_SET_PROC()
	_PC_DENDOU_SET_PROC_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_pc_on_menu01')
ev_pc_on_call_professor:
	_SE_PLAY('S_ME047')
	_CALL('ev_pc_zukan_hyouka')
	_JUMP('ev_pc_on_menu01')
ev_pc_on_cancel:
	_TALK_CLOSE()
	_SE_PLAY('S_ME048')
	_EVENT_ENTITY_CLIP_PLAY('P_RO_005_Machine_03', 0)
	_TALK_END()
	_END()
ev_shop_start_talk:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_shop_01', 'Welcome! May I help you?')
	_RET()
ev_game_over_recover_myhome:; Called in Exefs
	_FLAG_RESET(#2196); Disable double battles
	_EVENT_START()
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_OBJ_ANIME('HERO', 'player_recover_myhome_anm')
	_OBJ_ANIME('T01R0201_MAMA', 'mama_recover_myhome_anm')
	_OBJ_ANIME_WAIT()
	_BLACK_IN()
	_FADE_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_11', '{0,1,0,0}! Welcome home.\rIt sounds like you had quite the experience\nout there.\rMaybe you should take a quick rest so you\ncan relax.\r...\n...')
	_BLACK_OUT()
	_FADE_WAIT()
	_TALK_CLOSE()
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_BLACK_IN()
	_FADE_WAIT()
	_IF_FLAGON_CALL(#FE_ZUKAN_GET, 'ev_game_over_recover_myhome_zukan_on')
	_IF_FLAGOFF_CALL(#FE_ZUKAN_GET, 'ev_game_over_recover_myhome_zukan_off')
	_TALK_CLOSE()
	_CALL('ev_box_close')
	_CALL('ev_c06_Lose_check')
	_CALL('ev_yarinohasira_zenmetu_check')
	_CALL('ev_nakama_turearuki_zenmetu_check')
	_IF_FLAGON_CALL(#FE_D16R0103_LEGEND_UNSEAL, 'ev_d16r0103legend_zenmetu_check')
	_CALL('ev_block_doc_end')
	_RESET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_RESET_SYS_FLAG($SYS_FLAG_MAP_INFO_STOP)
	_FLAG_SET(#FV_WALL_PUT)
	_TALK_END()
	_END()
ev_game_over_recover_myhome_zukan_on:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_12_1', 'Oh, good! You and your Pokémon are\nlooking great.\rBy the way, I heard from Professor Rowan.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_12_2', 'He said that a Pokémon’s energy is measured in\nHP, which stands for Hit Points.\rIf your Pokémon lose their HP, you can restore it\nat any Pokémon Center.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_12_3', 'If you’re going to travel far away, the smart\nTrainer stocks up on Potions at the Poké Mart.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_12_4', 'Make me proud, honey! Take care!')
	_RET()
ev_game_over_recover_myhome_zukan_off:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_13_1', 'Oh, good! You and your Pokémon are\nlooking great.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_13_2', 'By the way, {0,1,0,0}, your Pokémon will\nfaint if it runs out of HP.\rIf your Pokémon loses its HP, come home before\nit faints.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_13_3', 'It will be healed to full health by taking a rest.\rWell, honey, make me proud! Take care!')
	_RET()
ev_game_over_recover_pc:; Called in Exefs
	_FLAG_RESET(#2196); Disable double battles
	_EVENT_START()
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TEMOTI_BALL_LOAD()
	_OBJ_ANIME('HERO', 'player_gb')
	_OBJ_ANIME_WAIT()
	_BLACK_IN()
	_FADE_WAIT()
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('HERO', 'player_banzai_anm00')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'player_idle_return')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_06', 'First, let’s restore your Pokémon to full health.')
	; Sets the OBJ_ID of the nurse based on the current zone ID
	_CALL('now_zone_to_pcwoman_code_pc_kaihuku')
	_IF_FLAGON_CALL($BADGE_ID_C03, 'ev_game_over_recover_pc_first_badge')
	_IF_FLAGOFF_CALL($BADGE_ID_C03, 'ev_game_over_recover_pc_no_badge')
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('HERO', 'player_banzai_anm01')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'player_idle_return')
	_OBJ_ANIME_WAIT()
	_CALL('now_zone_to_pcwoman_code_bow_anime01')
	_IF_FLAGOFF_CALL($BADGE_ID_C03, 'ev_game_over_recover_pc_no_badge')
	_TALK_CLOSE()
	_CALL('ev_box_close')
	_CALL('ev_c06_Lose_check')
	_CALL('ev_yarinohasira_zenmetu_check')
	_CALL('ev_nakama_turearuki_zenmetu_check')
	_IF_FLAGON_CALL(#FE_D16R0103_LEGEND_UNSEAL, 'ev_d16r0103legend_zenmetu_check')
	_CALL('ev_block_doc_end')
	_RESET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_RESET_SYS_FLAG($SYS_FLAG_MAP_INFO_STOP)
	_FLAG_SET(#FV_WALL_PUT)
	_CALL('call_current_map_script')
	_TALK_END()
	_END()
ev_game_over_recover_pc_no_badge:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_07', 'Your Pokémon have been healed to\nperfect health.')
	_RET()
ev_game_over_recover_pc_first_badge:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_10', 'There! All happy and healthy!\nGood luck and take care!')
	_RET()
ev_game_over_recover_pc_no_badge_information:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_08_1', 'Please visit a Pokémon Center when your\nPokémon’s HP goes down.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_all_dead_08_2', 'If you’re planning to travel any distance, you\nshould stock up on Potions at a Poké Mart.\rGood luck, Trainer!')
	_RET()
call_current_map_script:
	_GET_NOW_ZONE_ID(@SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 171, 'SP_C10R0101_FLAG'); Resets all E4 doors
	_RET()
player_recover_myhome_anm:
	_AC_DIR_R(8)
	_ACMD_END()
mama_recover_myhome_anm:
	_AC_DIR_L(8)
	_ACMD_END()
player_gb:
	_AC_DIR_U(1)
	_ACMD_END()
turn_l_anime:
	_AC_DIR_L(8)
	_ACMD_END()
turn_u_anime:
	_AC_DIR_U(8)
	_ACMD_END()
turn_r_anime:
	_AC_DIR_R(8)
	_ACMD_END()
turn_d_anime:
	_AC_DIR_D(8)
	_ACMD_END()
ev_airhole:
	_MACRO_EASY_OBJ_MSG('dialogue_common_scr', '91-msg_airhole_01', 'It’s a vent that exchanges air from the\nGrand Underground.')
	_END()
ev_sweet_no_enc:; Sweet Scent no encounters in the map
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_amaikaori_01', 'There appears to be nothing here...')
	_TALK_CLOSE()
	_RET()
ev_sweet_weather:; Cannot use Sweet Scent when raining
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_amaikaori_02', 'The sweet scent faded for some reason...')
	_TALK_CLOSE()
	_RET()
ev_bump_post:
	_ITEM_CHK(450, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'end_bump_post_not_bicycle')
	_EVENT_START()
	_SE_PLAY('UI_COMMON_DECIDE')
	_BICYCLE_CHECK(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_bicycle_use')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_bycyclestop_02', 'Ride your bike?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'end_bump_post')
	_BICYCLE_REQ(1)
	_TIME_WAIT(12, @SCWK_ANSWER)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_bicycle_use:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_bycyclestop_03', 'Get off your bike?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'end_bump_post')
	_BICYCLE_REQ(0)
	_TIME_WAIT(12, @SCWK_ANSWER)
	_TALK_CLOSE()
	_TALK_END()
	_END()
end_bump_post:
	_TALK_CLOSE()
	_TALK_END()
	_END()
end_bump_post_not_bicycle:
	_END()
ev_egg_hatching:
	_TALK_START()
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_egg_01', 'Oh?')
	_AB_KEYWAIT()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_TALK_CLOSE()
	_TAMAGO_DEMO()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_TALK_END()
	_END()
ev_end_spray:
	_TALK_START()
	_ITEM_CHK(@SCWK_REG0, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_end_spray_reuse')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_spray_01', 'Repel’s effect wore off...')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_end_spray_reuse:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_spray_02', 'Repel’s effect wore off. Would you like to use\nanother one?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_end_spray_usemsg')
	_TALK_END()
	_END()
ev_end_spray_usemsg:
	_PLAYER_NAME(0)
	_SE_PLAY('UI_bag_item_insect_repellent')
	_ITEM_NAME(1, @SCWK_REG0, 1)
	_MACRO_TALKMSG('dialogue_common_scr', '93-msg_fld_item_use_01', 'You used the {1,1,9,0}!')
	_TALK_CLOSE()
	_TALK_END()
	_USE_SPRAY(@SCWK_REG0)
	_END()
ev_stopper_friendbook:; PC Downstairs Needs 1st badge
	_MACRO_EASY_OBJ_MSG('dialogue_common_scr', '91-msg_stopper_friendbook_01', 'I’m very sorry. We are working underground\nright now.\rIt’s off-limits to the public. Please try later on.')
	_END()
ev_plate_msg:
	_CALL('ev_plate_msg_sub')
	_RET()
	_END()
ev_plate_msg_sub:
	_ADD_WK(@WK_SCENE_PLATE_MSG, 1)
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'GE', 9, 'ev_plate_msg_wk_reset')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 1, 'ev_plate_msg_01')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 2, 'ev_plate_msg_02')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 3, 'ev_plate_msg_03')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 4, 'ev_plate_msg_04')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 5, 'ev_plate_msg_05')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 6, 'ev_plate_msg_06')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 7, 'ev_plate_msg_07')
	_IFVAL_CALL(@WK_SCENE_PLATE_MSG, 'EQ', 8, 'ev_plate_msg_08')
	_RET()
ev_plate_msg_wk_reset:
	_LDVAL(@WK_SCENE_PLATE_MSG, 1)
	_RET()
ev_plate_msg_01:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_01', 'There is text engraved in the back of the\nobtained Plate...\r“When the universe was created, its shards\nbecame this Plate.”')
	_RET()
ev_plate_msg_02:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_02', 'There is text engraved in the back of the\nobtained Plate...\r“The power of defeated giants infuses this Plate.”')
	_RET()
ev_plate_msg_03:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_03', 'There is text engraved in the back of the\nobtained Plate...\r“Two beings of time and space set free from the\nOriginal One.”')
	_RET()
ev_plate_msg_04:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_04', 'There is text engraved in the back of the\nobtained Plate...\r“Three beings were born to bind time\nand space.”')
	_RET()
ev_plate_msg_05:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_05', 'There is text engraved in the back of the\nobtained Plate...\r“Two make matter, and three make spirit, shaping\nthe world.”')
	_RET()
ev_plate_msg_06:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_06', 'There is text engraved in the back of the\nobtained Plate...\r“The Original One breathed alone before the\nuniverse came.”')
	_RET()
ev_plate_msg_07:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_07', 'There is text engraved in the back of the\nobtained Plate...\r“The powers of Plates are bestowed to the\nPokémon that was born.”')
	_RET()
ev_plate_msg_08:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_plate_get_08', 'There is text engraved in the back of the\nobtained Plate...\r“The rightful bearer of a Plate draws from the\nPlate it holds.”')
	_RET()
ev_the_boy_girl_play:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_the_boy')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_the_girl')
