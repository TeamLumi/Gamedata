ev_exec_item_ananukenohimo:; When using Escape Rope from menu
	_EVENT_START()
	_BICYCLE_REQ_NON_BGM(0)
	_WARP_START_ANIMATION(1)
	_ANANUKENOHIMO()
	_TALK_END()
	_END()
