	_IFCOORDS_JUMP(@437, 74, 59, 'ev_distortionr0101_boulder_move_cancel')
	_IFCOORDS_JUMP(@437, 56, 68, 'ev_distortionr0101_boulder_move_cancel')
	_IFCOORDS_JUMP(@437, 84, 67, 'ev_distortionr0101_boulder_move_cancel')
