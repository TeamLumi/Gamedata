	_CALL_EFFECT_OBJ(0, 29, @437)
	_SE_PLAY('S_FI034')
	_OBJ_ANIME(@437, 'iwa_right')
	_OBJ_ANIME_WAIT()
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_TALK_END()
	_END()

ev_distortionr0101_boulder_move:
	_IFVAL_JUMP(@438, 'EQ', 0, 'ev_distortionr0101_boulder_move_up')
	_IFVAL_JUMP(@438, 'EQ', 1, 'ev_distortionr0101_boulder_move_down')
	_IFVAL_JUMP(@438, 'EQ', 2, 'ev_distortionr0101_boulder_move_left')
	_JUMP('ev_distortionr0101_boulder_move_right')
	_END()
ev_distortionr0101_boulder_move_up:
	_IFVAL_CALL(@630, 'EQ', 10, 'ev_distortionr0101_boulder_move_up_pos_check_a7')
	_CALL_EFFECT_OBJ(0, 29, @437)
	_SE_PLAY('S_FI034')
	_OBJ_ANIME(@437, 'iwa_up')
	_OBJ_ANIME_WAIT()
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_IFCOORDS_CALL(@437, 63, 67, 'ev_distortionr0101_boulder_2_fall_2_wrong')
	_IFCOORDS_CALL(@437, 67, 67, 'ev_distortionr0101_boulder_2_fall_2_wrong')
	_IFCOORDS_CALL(@437, 56, 67, 'ev_distortionr0101_boulder_2_fall_2')
	_TALK_END()
	_END()
ev_distortionr0101_boulder_move_down:
	_IFVAL_CALL(@630, 'EQ', 9, 'ev_distortionr0101_boulder_move_down_pos_check_a6')
	_IFVAL_CALL(@630, 'EQ', 10, 'ev_distortionr0101_boulder_move_down_pos_check_a7')
	_CALL_EFFECT_OBJ(0, 29, @437)
	_SE_PLAY('S_FI034')
	_OBJ_ANIME(@437, 'iwa_down')
	_OBJ_ANIME_WAIT()
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_IFCOORDS_CALL(@437, 74, 57, 'ev_distortionr0101_boulder_1_fall_1')
	_IFCOORDS_CALL(@437, 88, 68, 'ev_distortionr0101_boulder_3_fall_2_wrong')
	_IFCOORDS_CALL(@437, 93, 68, 'ev_distortionr0101_boulder_3_fall_2_wrong')
	_IFCOORDS_CALL(@437, 84, 68, 'ev_distortionr0101_boulder_3_fall_2')
	_TALK_END()
	_END()
ev_distortionr0101_boulder_move_left:
	_IFVAL_CALL(@630, 'EQ', 9, 'ev_distortionr0101_boulder_move_left_pos_check_a6')
	_IFVAL_CALL(@630, 'EQ', 10, 'ev_distortionr0101_boulder_move_left_pos_check_a7')
	_CALL_EFFECT_OBJ(0, 29, @437)
	_SE_PLAY('S_FI034')
	_OBJ_ANIME(@437, 'iwa_left')
	_OBJ_ANIME_WAIT()
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_IFCOORDS_CALL(@437, 73, 52, 'ev_distortionr0101_boulder_1_fall_2_wrong')
	_IFCOORDS_CALL(@437, 73, 56, 'ev_distortionr0101_boulder_1_fall_2_wrong')
	_IFCOORDS_CALL(@437, 73, 60, 'ev_distortionr0101_boulder_1_fall_2')
	_IFCOORDS_CALL(@437, 85, 67, 'ev_distortionr0101_boulder_3_fall_1')
	_TALK_END()
	_END()
ev_distortionr0101_boulder_move_right:
	_IFVAL_CALL(@630, 'EQ', 10, 'ev_distortionr0101_boulder_move_right_pos_check_a7')
	_CALL_EFFECT_OBJ(0, 29, @437)
	_SE_PLAY('S_FI034')
	_OBJ_ANIME(@437, 'iwa_right')
	_OBJ_ANIME_WAIT()
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_IFCOORDS_CALL(@437, 64, 68, 'ev_distortionr0101_boulder_2_fall_1')
	_TALK_END()
	_END()

