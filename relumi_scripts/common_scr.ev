ev_block_player_shining_pearl:
	_MACRO_TALKMSG('dialogue_common_scr', '00_msg_wrong_game_00', 'Something isn’t right with your mod install.\nPlease visit\r<color=#0064FFFF>https://luminescent.team/install</color>.\rMake sure you’re following the instructions\nfor your game and platform.')
	_TALK_CLOSE()
	_SET_TELEPORT_ID(0, 0)
	_TELEPORT()
	_TALK_OBJ_END()
	_END()
ev_block_player_bad_exefs:
	_MACRO_TALKMSG('dialogue_common_scr', '00_msg_bad_install_00', 'Something isn’t right with your mod install.\nPlease visit\r<color=#0064FFFF>https://luminescent.team/install</color>.\rMake sure you’re following the instructions\nfor your game and platform.')
	_TALK_OBJ_END()
	_END()
ev_heal_p01:
	_TALK_OBJ_START()
	_TEMOTI_BALL_LOAD()
	_PM_VERSION_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 49, 'ev_block_player_shining_pearl'); Block player progression in the wrong game
	_LDVAL(@SCWK_ANSWER, 0); Clear stale value (e.g. version 69) so a no-op _INSTALL_CHECK can't falsely pass
	_INSTALL_CHECK(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 69, 'ev_block_player_bad_exefs')
	_GET_TRCARD_RANK(@LOCALWORK8)
	_IFVAL_JUMP(@LOCALWORK8, 'GE', 4, 'gold_card_heal_p01')
	_GET_TIME_ZONE(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_heal_p01_ask_morning')
	_CASE_JUMP(1, 'ev_heal_p01_ask_noon')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_01', 'Hello, and welcome to the Pokémon Center.\nWe restore your tired Pokémon to full health.\rWould you like to rest your Pokémon?')
	_JUMP('ev_heal_p01_ask')
	_END()
ev_heal_p01_ask:
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, '_pc_kaifuku_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, '_pc_kaifuku_no')
	_END()
ev_heal_p01_ask_morning:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_11', 'Good morning! Welcome to the Pokémon Center.\nWe restore your tired Pokémon to full health.\rWould you like to rest your Pokémon?')
	_JUMP('ev_heal_p01_ask')
	_END()
ev_heal_p01_ask_noon:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_12', 'Hello, and welcome to the Pokémon Center.\nWe restore your tired Pokémon to full health.\rWould you like to rest your Pokémon?')
	_JUMP('ev_heal_p01_ask')
	_END()
_pc_kaifuku_no:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_04', 'We hope to see you again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
_pc_kaifuku_yes:
	; Animations
	_AC_ANIM_LOCK('HERO'); Prevents player from doing idle animation
	_OBJ_ANIME('HERO', 'player_banzai_anm00')
	_OBJ_ANIME_WAIT(); Wait for player animation
	_AC_ANIM_RELEASE('HERO'); Release idle animation lock
	_OBJ_ANIME('HERO', 'player_idle_return'); Makes player use idle animation
	; Gold Trainer Card check
	_GET_TRCARD_RANK(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 4, 'gold_pc_kaihuku_01')
	_IFVAL_CALL(@SCWK_ANSWER, 'LT', 4, 'normal_pc_kaihuku_01')
	; Sets the OBJ_ID of the nurse based on the current zone ID
	_CALL('now_zone_to_pcwoman_code_pc_kaihuku')
	_PC_KAIFUKU()
	_IF_FLAGOFF_JUMP(#FE_PC_POKERUS, 'ev_pc_pokerus_chk')
	_JUMP('ev_pc_kaihuku_after')
	_END()
normal_pc_kaihuku_01:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_02', 'OK, I’ll take your Pokémon for a few seconds.')
	_TALK_CLOSE()
	_RET()
gold_pc_kaihuku_01:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_08', 'I will be pleased to take your Pokémon for a\nfew seconds.')
	_TALK_CLOSE()
	_RET()
now_zone_to_pcwoman_code_pc_kaihuku:
	_TALK_CLOSE()
	; ID of the camera that will be used for the close-up. Will be 298 for all PCs except the League entrance
	_LDVAL(@LOCALWORK1, 298)
	; Nurse PlaceData that will play the animations
	;TODO a new command could be used to find the ID in the scene and assign that to the work. If not we can just set ID 0 and move all Nurses to the beginning of the file
	_LDVAL(@LOCALWORK0, 0)
	; Checks if the current PC is the League entrance, if so change the ID
	_GET_NOW_ZONE_ID(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 171, 'pcwoman_pc_kaihuku_c10r0101')
	; Only plays the ball animation if the user has toggled it
	_IF_FLAGON_CALL(#2751, 'pcwoman_pc_kaihuku_anim_common')
	_SE_PLAY('M_FI002')
	_RET()
pcwoman_pc_kaihuku_c10r0101:
	; ID of the camera that will be used for the close-up in the league
	_LDVAL(@LOCALWORK1, 92)
	_RET()
pcwoman_pc_kaihuku_anim_common:
	_AC_ANIM_RELEASE(@LOCALWORK0)
	_OBJ_ANIME(@LOCALWORK0, 'turn_l_anime')
	_OBJ_ANIME_WAIT()
	_TEMOTI_BALL_LOAD_WAIT()
	_GET_POKE_COUNT2(@SCWK_TEMP2)
	_LDVAL(@SCWK_TEMP0, 0)
	; Will be 298 for all PCs except the League entrance
	_EVENT_CAMERA_INDEX(@LOCALWORK1)
	_JUMP('pcwoman_pc_kaihuku_anim_common_loop')
	_END()
pcwoman_pc_kaihuku_anim_common_loop_pre:
	_JUMP('pcwoman_pc_kaihuku_anim_common_loop')
	_END()
pcwoman_pc_kaihuku_anim_common_loop:
	_POKECEN_PUT_BALL(@SCWK_TEMP0)
	_SE_PLAY('S_ME051')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_ADD_WK(@SCWK_TEMP0, 1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', @SCWK_TEMP2, 'pcwoman_pc_kaihuku_anim_common_2')
	_JUMP('pcwoman_pc_kaihuku_anim_common_loop_pre')
	_END()
pcwoman_pc_kaihuku_anim_common_2:
	_PC_RECOVER_ANM(@SCWK_TEMP2)
	_SE_PLAY('M_FI002')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_PC_RECOVER_ANM(@SCWK_TEMP2)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_PC_RECOVER_ANM(@SCWK_TEMP2)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_PC_RECOVER_ANM(@SCWK_TEMP2)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_POKECEN_CLEAR_BALL()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(299)
	_OBJ_ANIME(@LOCALWORK0, 'turn_d_anime') ; TODO not ideal since the player might be interacting from an angle, a better solution might be needed
	_OBJ_ANIME_WAIT()
	_RET(); Will return to _pc_kaifuku_yes
now_zone_to_pcwoman_code_bow_anime01:
	; LOCALWORK0 contains the OBJ_ID of the nurse that was determined in now_zone_to_pcwoman_code_pc_kaihuku
	_AC_ANIM_LOCK(@LOCALWORK0)
	_OJIGI(@LOCALWORK0); Runs animation 16 and then returns to idle
	_CHARA_LOOK_RELEASE(@LOCALWORK0)
	_RET()
now_zone_to_pcwoman_wait:; Not called in Scripts
	_GET_NOW_ZONE_ID(@SCWK_TEMP0)
	_TIME_WAIT(6, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'pcwoman_wait_c01pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 27, 'pcwoman_wait_c02pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 41, 'pcwoman_wait_c03pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 58, 'pcwoman_wait_c04pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 89, 'pcwoman_wait_c05pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 113, 'pcwoman_wait_c06pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 125, 'pcwoman_wait_c07pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 147, 'pcwoman_wait_c08pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 162, 'pcwoman_wait_c09pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 168, 'pcwoman_wait_c10pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 188, 'pcwoman_wait_c11pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 431, 'pcwoman_wait_t02pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 440, 'pcwoman_wait_t03pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 448, 'pcwoman_wait_t04pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 457, 'pcwoman_wait_t05pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 467, 'pcwoman_wait_t06pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 475, 'pcwoman_wait_t07pc0101')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 171, 'pcwoman_wait_c10r0101')
	_RET()
