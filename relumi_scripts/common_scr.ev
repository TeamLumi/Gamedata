ev_nakama_turearuki_d21r0101_re:
	_LDVAL(@WK_SCENE_D21R0101, 0)
	_RET()
ev_nakama_turearuki_d24r0105_re:
	_LDVAL(@WK_SCENE_D24R0105, 0)
