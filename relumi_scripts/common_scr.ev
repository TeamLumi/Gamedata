ev_distortionr0101_boulder_1_fall_1:
	_IFVAL_JUMP(@630, 'EQ', 10, 'ev_distortionr0101_boulder_move_end')
	_GAMEOBJECT_MOVE('DISTORTIONR0101_BOULDER_1', 0, -16, 0, 60, 7)
	_SE_PLAY('S_UND003')
	_LDVAL(@626, 1)
	_RET()
ev_distortionr0101_boulder_1_fall_2:
	_GAMEOBJECT_MOVE('DISTORTIONR0101_BOULDER_1', 1, -2, 0, 45, 1)
	_SE_PLAY('S_UND003')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_LOAD_UMA_ANIME('field/animeobj/distortionr0101_obj')
	_LOAD_UMA_ANIME_WAIT()
	_UMA_ANIME_ATTACH(0, 'DISTORTIONR0101_A7_UXIE')
	_VOICE_PLAY(480, 0, 0)
	_OBJ_ANIME('DISTORTIONR0101_A7_UXIE', 'anm_distortionr0101_a7_lake_spirit_leave')
	_UMA_ANIME_PLAY(0, 'A7_UXIE_1')
	_UMA_PLAY_WAIT(0, 'A7_UXIE_1')
	_UMA_IS_NULL(0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_distortionr0101_uma_release')
	_OBJ_DEL('DISTORTIONR0101_A7_UXIE')
	_FLAG_SET(#3414); Boulder 1 solved
	_LDVAL(@626, 2)
	_RET()
