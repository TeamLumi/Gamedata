	_RET()
ev_effect_del:
	_STOP_EFFECT(0, 0)
	_STOP_EFFECT(1, 0)
	_STOP_EFFECT(2, 0)
	_STOP_EFFECT(3, 0)
	_STOP_EFFECT(4, 0)
	_STOP_EFFECT(5, 0)
	_STOP_EFFECT(6, 0)
	_STOP_EFFECT(7, 0)
	_STOP_EFFECT(8, 0)
	_STOP_EFFECT(9, 0)
	_RELEASE_EFFECT(0)
	_RELEASE_EFFECT(1)
	_RELEASE_EFFECT(2)
	_RELEASE_EFFECT(3)
	_RELEASE_EFFECT(4)
	_RELEASE_EFFECT(5)
	_RELEASE_EFFECT(6)
	_RELEASE_EFFECT(7)
	_RELEASE_EFFECT(8)
	_RELEASE_EFFECT(9)
	_RET()
