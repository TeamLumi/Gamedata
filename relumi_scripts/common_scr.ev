anm_dj_turn_hero_around:
	_AC_DIR_D(4)
	_ACMD_END()
ev_pc_kaihuku_after:
	_GET_TRCARD_RANK(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 4, 'ev_pc_gold_thank_you')
	_IFVAL_CALL(@SCWK_ANSWER, 'LT', 4, 'ev_pc_normal_thank_you')
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('HERO', 'player_banzai_anm00')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'player_idle_return')
	_TALK_CLOSE()
	_CALL('now_zone_to_pcwoman_code_bow_anime01')
	_GET_TRCARD_RANK(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 4, 'ev_pc_gold_goodbye')
	_IFVAL_CALL(@SCWK_ANSWER, 'LT', 4, 'ev_pc_normal_goodbye')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_dj_turn_hero_around')
	_OBJ_ANIME_WAIT()
	_CALL('ev_healthcheck'); Custom scripts to attempt to correct flags
	_TALK_OBJ_END()
	_END()
ev_pc_gold_thank_you:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_09', 'Thank you for waiting.')
	_RET()
ev_pc_normal_thank_you:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_03', 'Thank you for waiting.\nWe’ve restored your Pokémon to full health.')
	_RET()
ev_pc_gold_goodbye:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_10', 'We hope to see you again!')
	_RET()
ev_pc_normal_goodbye:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_04', 'We hope to see you again!')
	_RET()
ev_pc_pokerus_chk:
	_CHK_TEMOTI_POKERUS(@SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 1, 'ev_pc_pokerus')
	_JUMP('ev_pc_kaihuku_after')
	_END()
ev_pc_pokerus:
	_FLAG_SET(#FE_PC_POKERUS)
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('HERO', 'player_banzai_anm00')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'player_idle_return')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_heal_pokerus_01_1', 'Your Pokémon may be infected with\nthe Pokérus.\rLittle is known about the Pokérus except that\nthey are microscopic life-forms that attach\fto Pokémon.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_heal_pokerus_01_2', 'While infected, Pokémon are said to grow\nexceptionally well.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
gold_card_heal_p01:
	_IF_FLAGON_JUMP(#FE_PC_GOLD, 'gold_card_heal_p02')
	_FLAG_SET(#FE_PC_GOLD)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_05', 'Hello, and welcome to the Pokémon Center.\nWe restore your tired Pokémon to full health.\rWould you like to—')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_06_1', 'Th-that Trainer Card!\rThat sparkling color! And all those stars!')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_06_2', 'I’ve seen several Trainers with Silver Trainer\nCards before... But yours tops them all.')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_06_3', 'Please, {0,1,0,0}, may I have the honor\nof healing your Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, '_pc_kaifuku_yes')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_10', 'We hope to see you again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
gold_card_heal_p02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_07', 'It’s great to see you, {0,1,0,0}! You want\nthe usual, am I right?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, '_pc_kaifuku_yes')
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_common_pc_heal_10', 'We hope to see you again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
player_banzai_anm00:
	_AC_INDEX_ANIME(9)
	_AC_WAIT(35)
	_ACMD_END()
player_idle_return:
	_AC_INDEX_ANIME(0)
	_AC_WAIT(10)
	_ACMD_END()
player_banzai_anm01:
	_AC_INDEX_ANIME(9)
	_AC_WAIT(10)
	_ACMD_END()
ev_common_board:; Only Called in Exefs
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_board_cancel')
	_CASE_JUMP(1, 'ev_board_menu')
	_BOARD_MSG(@SCWK_ANSWER); It is hardcoded to be @SCWK_ANSWER
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'ev_board_menu')
	_BOARD_REQ('BOARD_REQ_DOWN')
	_RET()
ev_board_cancel:
	_BOARD_REQ('BOARD_REQ_DOWN')
	_RET()
ev_board_menu:
	_BOARD_REQ('BOARD_REQ_DEL')
	_BOARD_REQ_WAIT()
	_RET()
ev_play_pocket_fanfare:
	_GET_POCKET_NO(@SCWK_TEMP0, @SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'case1_pocket_me'); Healing Items
	_CASE_JUMP(1, 'case1_pocket_me'); Poke balls
	_CASE_JUMP(2, 'case1_pocket_me'); Battle Items
	_CASE_JUMP(3, 'case1_pocket_me'); Berries
	_CASE_JUMP(4, 'case1_pocket_me'); Tools/Other
	_CASE_JUMP(5, 'case2_pocket_me'); TM/HM
	_CASE_JUMP(6, 'case4_pocket_me'); Treasure
	_CASE_JUMP(8, 'case3_pocket_me'); Key Items
	_RET()
case1_pocket_me:
	_SE_PLAY('M_FI013')
	_RET()
case2_pocket_me:
	_SE_PLAY('M_FI008')
	_RET()
case3_pocket_me:
	_SE_PLAY('M_FI012')
	_RET()
case4_pocket_me:
	_SE_PLAY('M_FI013')
	_RET()
ev_report_call:; Used for Online Play
	_CALL('ev_report_sub')
	_LDVAL(@LOCALWORK0, @SCWK_ANSWER)
	_RET()
	_END()
ev_report_sub:
	_IFVAL_JUMP(@WK_SCENE_GLOBAL_COUNTER, 'EQ', 1, 'ev_report_sub_1')
	_TALKMSG('ss_report%SS_report_16')
	_JUMP('ev_report_sub_1')
	_END()
ev_report_sub_1:
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_report_cancel')
	_JUMP('ev_report_save_parts')
	_END()
ev_report_save_parts:
	_AUTO_MSG(1, 0)
	_TALKMSG('ss_report%SS_report_17')
	_JUMP('ev_report_save')
	_END()
ev_report_save:
	_TIME_WAIT(2, @SCWK_ANSWER)
	_CALL('common_report_core')
	_JUMP('common_report_save_reqbit')
	_END()
common_report_core:
	_REPORT_SAVE(@SCWK_ANSWER)
	_RET()
common_report_save_reqbit:
	_REPORT_SAVE_CHECK(@SCWK_ANSWER)
	_PLAYER_NAME(0)
	_TALKMSG('ss_report%SS_report_18')
	_AUTO_MSG_STOP()
	_TIME_WAIT(8, @SCWK_TEMP3)
	_LDVAL(@SCWK_ANSWER, 1)
	_RET()
ev_report_cancel:
	_LDVAL(@SCWK_ANSWER, 0)
	_RET()
ev_honey_tree:
	_TALK_START()
	_LDVAL(@SCWK_TEMP0, 94)
	_ITEM_CHK(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'honey_tree_spread_ok')
	_JUMP('honey_tree_spread_ok_no_have')
	_END()
honey_tree_spread_ok_no_have:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_honey_tree_01', 'There is a sweet scent in the air...')
	_TALK_CLOSE()
	_TALK_END()
	_END()
honey_tree_spread_ok:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_honey_tree_05', 'There is a sweet scent in the air...')
	_JUMP('honey_tree_spread_yn')
	_END()
honey_tree_spread_yn:
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_honey_tree_03', 'Slather the bark with Honey?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'honey_tree_spread_yes')
	_TALK_CLOSE()
	_TALK_END()
	_END()
honey_tree_spread_yes:
	_TALK_CLOSE()
	_SUB_ITEM(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_common_scr', '91-msg_honey_tree_04', 'The bark was slathered with Honey.')
	_TALK_CLOSE()
	_JUMP('honey_tree_spread_encount')
	_END()
honey_tree_spread_encount:
	_BTL_ENCSEQ_LOAD('room01')
	_HONEY_TREE_BTL_SET()
	_JUMP('honey_tree_honey_check')
	_END()
honey_tree_honey_check:
	_ITEM_CHK(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'honey_tree_spread_yn')
	_TALK_CLOSE()
	_TALK_END()
	_END()
