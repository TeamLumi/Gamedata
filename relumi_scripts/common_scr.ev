	_ADD_CUSTUM_WIN_LABEL('ss_bag%SS_bag_156', 4); Sp.Def
	_RET()
ev_keyitem_pro_vitamin_case_spd:
	_ADD_CUSTUM_WIN_LABEL('ss_bag%SS_bag_157', 5); Speed
	_RET()
ev_keyitem_pro_vitamin_case_no_box_access:
	_MACRO_TALKMSG('dialogue_common_scr', 'msg_keyitem_pro_vitamin_case_no_box_access', 'Booting Pro-Vitamins in Box Mode...\r...\n...\rCould not establish a connection to your\nPokémon Boxes.\rPlease use the Pro-Vitamins Case from the bag\nuntil the connection can be restored.')
	_TALK_CLOSE()
	_JUMP('ev_keyitem_pro_vitamin_case_end')
ev_keyitem_pro_vitamin_case_end:
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()

ev_attach_player_world:
	_ATTACH_TRANSFORM('HERO', 'Parmanent Objects/GameManager/Field Objects', 1)
	_RET()

