ev_keyitem_pro_vitamin_case:
	_EVENT_START()
	_CALL('ev_block_doc')
	_IF_FLAGON_JUMP($SYS_BOX_SYSTEM_OFF, 'ev_keyitem_pro_vitamin_case_no_box_access'); Cannot access boxes
	_MACRO_TALKMSG('dialogue_common_scr', 'msg_keyitem_pro_vitamin_case_1', 'Booting Pro-Vitamins in Box Mode...\nPlease select a Pokémon.')
	_TALK_CLOSE()
	_POKELIST_SET_PROC(0)
	_POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_keyitem_pro_vitamin_case_end')
	_MACRO_TALKMSG('dialogue_common_scr', 'msg_keyitem_pro_vitamin_case_2', 'Which stat would you like to change?')
	_IF_FLAGON_CALL(#4014, 'ev_keyitem_pro_vitamin_case_hp')
	_IF_FLAGON_CALL(#4015, 'ev_keyitem_pro_vitamin_case_atk')
	_IF_FLAGON_CALL(#4016, 'ev_keyitem_pro_vitamin_case_def')
	_IF_FLAGON_CALL(#4017, 'ev_keyitem_pro_vitamin_case_spatk')
	_IF_FLAGON_CALL(#4018, 'ev_keyitem_pro_vitamin_case_spdef')
	_IF_FLAGON_CALL(#4019, 'ev_keyitem_pro_vitamin_case_spd')
	_ADD_CUSTUM_WIN_LABEL('ss_bag%SS_bag_096', 6); Cancel
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 6, 'ev_keyitem_pro_vitamin_case_end')
	_CUSTOM_NUMBER_INPUT(@SCWK_TEMP2, 252, 'SS_strinput_pro_vitamin')
	_SET_EFFORT_VALUE(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER, @SCWK_TEMP2)
	_SE_PLAY('M_FI007')
	_MACRO_TALKMSG('dialogue_common_scr', 'msg_keyitem_pro_vitamin_case_3', 'Effort Values were changed!')
	_SE_WAIT('M_FI007')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_keyitem_pro_vitamin_case_hp:
	_ADD_CUSTUM_WIN_LABEL('ss_bag%SS_bag_160', 0); HP
	_RET()
ev_keyitem_pro_vitamin_case_atk:
	_ADD_CUSTUM_WIN_LABEL('ss_bag%SS_bag_153', 1); Attack
	_RET()
ev_keyitem_pro_vitamin_case_def:
