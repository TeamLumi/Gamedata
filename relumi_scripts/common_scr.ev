ev_common_tray_space_check:
	_LDVAL(@551, 0); Pre-loads a result of false for the "Are trays at capacity?" check.
	_COUNT_MONSBOX_SPACE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'ev_common_party_space_check')
	_RET()
ev_common_party_space_check:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 6, 'ev_common_trays_maxed')
	_RET()
ev_common_trays_maxed:
	_LDVAL(@551, 1); Loads a result of true for the "Are trays at capacity?" check.
	_RET()

ev_common_trans_check:
	_LDVAL(@552, 0); Pre-loads a result of false for the "Are you trans?" check.
	_GET_MY_SEX(@SCWK_TEMP0); Gets your gender that was assigned at birth
	_GET_COSTUME(@SCWK_TEMP1); Gets your drip
	_GET_COSTUME_GENDER(@SCWK_TEMP1, @SCWK_TEMP2); Checks which gender identity corresponds to your drip
	_IFVAL_JUMP(@SCWK_TEMP0, 'NE', @SCWK_TEMP2, 'ev_common_trans_check_true'); If gender assigned at birth does not equal gender identity then you're trans!
	_RET()
ev_common_trans_check_true:
	_LDVAL(@552, 1); Loads a result of true and based for the "Are you trans?" check.
	_RET()

ev_common_poke_ball_appear_effect:
	_CALL_EFFECT(@SCWK_TEMP0, 0, @SCWK_TEMP1, @SCWK_TEMP2, @SCWK_TEMP3)
	_SE_PLAY('PLAY_BA_SYS_POKE_APPERANCE_FIELD')
	_SE_WAIT('PLAY_BA_SYS_POKE_APPERANCE_FIELD')
	_STOP_EFFECT(@SCWK_TEMP0)
	_RELEASE_EFFECT(@SCWK_TEMP0)
	_RET()

ev_common_poke_ball_return_effect:
	_CALL_EFFECT(@SCWK_TEMP0, 0, @SCWK_TEMP1, @SCWK_TEMP2, @SCWK_TEMP3)
	_SE_PLAY('PLAY_BA_SYS_BALL_OPEN_FIELD')
	_SE_WAIT('PLAY_BA_SYS_BALL_OPEN_FIELD')
	_STOP_EFFECT(@SCWK_TEMP0)
	_RELEASE_EFFECT(@SCWK_TEMP0)
	_RET()