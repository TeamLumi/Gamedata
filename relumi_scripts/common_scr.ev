ev_punchingbag_move: ; Move the ounching bag in front of player
	_EVENT_START()
	_IFVAL_JUMP(@503, 'EQ', 0, 'ev_punchingbag_move_up') ; @503 is direction
	_IFVAL_JUMP(@503, 'EQ', 1, 'ev_punchingbag_move_down')
	_IFVAL_JUMP(@503, 'EQ', 2, 'ev_punchingbag_move_left')
	_JUMP('ev_punchingbag_move_right')
	_END()
ev_punchingbag_move_up:
	_CALL_EFFECT_OBJ(0, 29, @502)
	_SE_PLAY('S_FI034')
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 1) ; @502 is the punching bag's ID
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@502)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 5)
	_ENTITY_MOVE(@502, 0, 0, @504, 15) ; @504 is the amount of tiles
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 9)
	_IFVAL_JUMP(@505, 'EQ', -1, 'ev_punchingbag_end')
	_JUMP('ev_punchingbag_break_tires')
ev_punchingbag_move_down:
	_CALL_EFFECT_OBJ(0, 29, @502)
	_SE_PLAY('S_FI034')
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 2) ; @502 is the punching bag's ID
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@502)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 6)
	_ENTITY_MOVE(@502, 0, 0, @504, 15) ; @504 is the amount of tiles
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 10)
	_IFVAL_JUMP(@505, 'EQ', -1, 'ev_punchingbag_end')
	_JUMP('ev_punchingbag_break_tires')
ev_punchingbag_move_left:
	_CALL_EFFECT_OBJ(0, 29, @502)
	_SE_PLAY('S_FI034')
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 3) ; @502 is the punching bag's ID
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@502)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 7)
	_ENTITY_MOVE(@502, @504, 0, 0, 15) ; @504 is the amount of tiles
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 11)
	_IFVAL_JUMP(@505, 'EQ', -1, 'ev_punchingbag_end')
	_JUMP('ev_punchingbag_break_tires')
ev_punchingbag_move_right:
	_CALL_EFFECT_OBJ(0, 29, @502)
	_SE_PLAY('S_FI034')
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 4) ; @502 is the punching bag's ID
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@502)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 8)
	_ENTITY_MOVE(@502, @504, 0, 0, 15) ; @504 is the amount of tiles
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 12)
	_IFVAL_JUMP(@505, 'EQ', -1, 'ev_punchingbag_end')
	_JUMP('ev_punchingbag_break_tires')
ev_punchingbag_end:
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@502)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 0)
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_EVENT_END()
	_END()
ev_punchingbag_break_tires:
	_TIME_WAIT(5, @SCWK_ANSWER)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@505, 1) ; @505 is the tires' ID
	_CALL_EFFECT_OBJ(1, 9, @505)
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@502)
	_EVENT_ENTITY_CLIP_PLAY_BY_INDEX(@502, 0)
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_EVENT_ENTITY_CLIP_WAIT_BY_INDEX(@505)
	_OBJ_DEL(@505)
	_STOP_EFFECT(1, 0)
	_RELEASE_EFFECT(1)
	_EVENT_END()
	_END()
