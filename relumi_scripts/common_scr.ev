	_ATTACH_TRANSFORM('DISTORTIONR0101_BOULDER_1', 'BOULDERS/BOULDER_1_A6', 0)
	_ATTACH_TRANSFORM('DISTORTIONR0101_BOULDER_1', 'DISTORTIONR0101(Clone)', 1)
	_LDVAL(@626, 0)
	_RET()
