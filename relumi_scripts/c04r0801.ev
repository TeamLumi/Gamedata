	_OBJ_ANIME('C04R0801_UNDERGROUND', 'anm_c04r0801_j_anahori002')
	_OBJ_ANIME('HERO', 'anm_c04r0801_h_anahori002')
	_TIME_WAIT(60, @SCWK_ANSWER)
	_SE_PLAY('S_FI001')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_JUMP('ev_c04r0801_anahori_powered_s02')
	_JUMP('ev_c04r0801_anahori_powered_s02')
