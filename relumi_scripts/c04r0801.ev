ev_c04r0801_boy2:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0801', '18-msg_c04r0801_boy2_01', 'The Grand Underground sure is massive!\nYou’re gonna have a blast down there!')
	_END()
ev_c04r0801_assistantm:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C04R0801_ASSISTANTM_TALK, 'ev_c04r0801_assistantm_02')
	_FLAG_SET(#FE_C04R0801_ASSISTANTM_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_assistantm_01_1', 'Let’s dig up some treasure!\rI’m from Oreburgh. I work at the Mining Museum.\rI got advice from the Underground Man on\ndigging up Fossils and spheres.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_assistantm_01_2', 'Before I get digging, let me share his advice\nwith you—while you’re digging, you may uncover\fdark rocks.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_assistantm_01_3', 'They are very hard! If you keep hitting them, the\nwall will collapse.\rKeep that in mind, and you’ll be digging up\ntreasure in no time!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_assistantm_02:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_assistantm_02_1', 'Oh, you’d like more advice on digging up\ntreasure and spheres?\rWell, your Explorer Kit contains a sledgehammer\nand a pickax. Choose either of these tools and\fuse them to dig into walls.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_assistantm_02_2', 'You get to keep the stuff you fully uncover\nbefore the wall collapses.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_assistantm_02_3', 'Don’t forget, the dark rocks are impossible\nto break. If you hit them too often, the wall\fwill collapse.\rKeep that in mind, and you’ll be digging up\ntreasure in no time!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0801', '18-msg_c04r0801_poster_01', 'New and on sale: the underground radar!\rThe radar indicates possible treasure locations.\nUse this handy tool to track them down!')
	_END()
ev_c04r0801_woman1:
    _TALK_OBJ_START()
    _IF_FLAGON_JUMP(#2404, 'ev_c04r0801_woman_aero')
    _MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_woman1', 'Excuse me, are you a Trainer?\nYou are? Lovely!\rI have several fossils here that some of my \ncolleagues have collected from the tunnels \runderground.\nThere’s a machine in Oreburgh’s museum that\r can revive the Pokémon in these fossils.\nWould you be willing to take the fossils over \rthere? They’ll know what to do.')
    _YES_NO_WIN(@SCWK_ANSWER)
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04r0801_woman3')
    _MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_woman2', 'Lovely! There’s three of each. Except for the \nrare Old Amber.\rThere’s a lot of fossil types here, so please \nbear with me...')
    _FLAG_SET(#2404)
    _SE_PLAY('M_FI013')
	_LDVAL(@SCWK_TEMP0, 101)
	_LDVAL(@SCWK_TEMP1, 3)
	_LDVAL(@SCWK_TEMP2, 69420)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 99)
	_LDVAL(@SCWK_TEMP1, 3)
	_LDVAL(@SCWK_TEMP2, 69420)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 100)
	_LDVAL(@SCWK_TEMP1, 3)
	_LDVAL(@SCWK_TEMP2, 69420)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 104)
	_LDVAL(@SCWK_TEMP1, 3)
	_LDVAL(@SCWK_TEMP2, 69420)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 105)
	_LDVAL(@SCWK_TEMP1, 3)
	_LDVAL(@SCWK_TEMP2, 69420)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 103)
	_LDVAL(@SCWK_TEMP1, 1)
	_LDVAL(@SCWK_TEMP2, 69420)
	_CALL('ev_item_event')
    _JUMP('ev_c04r0801_woman_aero')
    _END()
ev_c04r0801_woman_aero:
    _IF_FLAGON_JUMP(#2405, 'ev_c04r0801_woman4')
    _MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_woman3', 'The reason I’m asking is because I really want \nto see an Aerodactyl.\rIf you can show me one, then I’ll give you \nanother gift for your trouble!')
    _TEMOTI_POKE_CHK(@SCWK_ANSWER, 142)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04r0801_woman2')
    _MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_woman5', 'Oh! That’s an Aerodactyl! Thank you so much!\nPlease accept this TM as a gift!')
	_LDVAL(@SCWK_TEMP0, 407); TM80 Rock Slide
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
    _FLAG_SET(#2405)
    _JUMP('ev_c04r0801_woman4')
    _END()
ev_c04r0801_woman2:
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c04r0801_woman3:
    _MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_woman4', 'Oh. That’s okay. Let me know if you change \nyour mind!')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c04r0801_woman4:
    _MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_woman6', 'TM80 contains Rock Slide. It would be a great \nmove to teach your Aerodactyl!')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c04r0801_youngboy_dig:
	_IF_FLAGON_JUMP(#2664, 'ev_c04r0801_youngboy_dig_done')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04r0801', '00_msg_c04r0801_youngboy_dig_01', 'Hey! Trainer!\nHey, listen!\rIf you’re here, I bet you like\nto dig around underground, right?\rDid you know your Pokémon can\nDig underground as well?\rYou can teach them how to with this\nTechnical Machine! Here!')
	_LDVAL(@SCWK_TEMP0, 355); Dig TM
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c04r0801', '00_msg_c04r0801_youngboy_dig_02', 'That isn’t all Dig is good for!\rIt lets the user dodge an opponent’s\nmove, then strike back at their\fopponent on the next turn!')
	_TALK_CLOSE()
	_FLAG_SET(#2664)
	_TALK_OBJ_END()
	_END()
ev_c04r0801_youngboy_dig_done:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0801', '00_msg_c04r0801_youngboy_dig_03', 'Don’t forget! You don’t need an\nEscape Rope when you can use Dig!')
	_END()