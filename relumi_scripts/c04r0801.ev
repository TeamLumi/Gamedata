ev_c04r0801_underground:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_C08R0401, 'GE', 9, 'ev_ug_mission_07_01')
	_IF_FLAGON_JUMP(#FE_TANKENSETTO_GET, 'ev_c04r0801_mission_common_chk')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_underground_01_1', 'I am the first one to have started digging out the\nGrand Underground.\rI am! You can call me the Underground Man.\nEveryone else does.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_underground_01_2', 'I’ll make a gift of this to you. You hold up your\nend of the deal and put it to good use!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP0, 428)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FE_TANKENSETTO_GET)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_IF_FLAGON_CALL(#FE_CYCLE_GET, 'ev_c04r0801_underground_announce02')
	_JUMP('ev_c04r0801_anahori_powered_s01')
	_END()
ev_c04r0801_underground_announce02:
	_RET()
ev_ug_mission_07_01:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_07_01', 'So, young spelunker, are you going underground\nwith your friends?\rThe Grand Underground is vast. It can be a place\nwhere you meet many others like you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_ug_mission_09_01:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_09_01_1', 'So, young spelunker, are you going underground?\rThe Grand Underground is vast. Enjoy it to your\nheart’s content!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_common_chk:
	_IFVAL_JUMP(@WK_SCENE_C08R0401, 'EQ', 1, 'ev_c04r0801_mission_02_chk')
	_IFVAL_JUMP(@WK_SCENE_C08R0401, 'EQ', 2, 'ev_c04r0801_mission_03_chk')
	_IFVAL_JUMP(@WK_SCENE_C08R0401, 'EQ', 3, 'ev_c04r0801_mission_04_chk')
	_IFVAL_JUMP(@WK_SCENE_C08R0401, 'EQ', 4, 'ev_c04r0801_mission_05_chk')
	_IFVAL_JUMP(@WK_SCENE_C08R0401, 'EQ', 5, 'ev_c04r0801_mission_06_chk')
	_JUMP('ev_ug_mission_07_01')
	_JUMP('ev_c04r0801_mission_02_chk')
ev_c04r0801_mission_02_chk:
	_IF_FLAGOFF_JUMP(#FE_UG_MISSION_TALK, 'ev_ug_mission_02_01')
	_IF_FLAGOFF_JUMP($16, 'ev_ug_mission_02_02')
	_JUMP('ev_c04r0801_mission_02_clear')
	_END()
ev_ug_mission_02_01:
	_FLAG_SET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_01_1', 'How was it down in the Grand Underground?\nBig and empty, I would think.\rBut that’s just because you’re a novice spelunker!')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_01_2', 'There are many hidden things down there that\nare invisible to the naked eye.\rFor my next test, I want you to dig up some\ntreasures for me.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_01_3', 'While underground, check the radar for any\nspots of yellow light.\rGo to such a location and search for treasure\nby pressing the A Button.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_ug_mission_02_02:
	_FLAG_SET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_02_1', 'You’ve not located any treasure yet?\rListen. Check the radar and go to any yellow\nspot of light you see. Next, press the A Button\fto identify places to dig.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_02_2', 'Try to get right atop the spot where a yellow\nlight is shown on your radar, OK?\rNow, off you go on your treasure hunt!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_02_clear:
	_LDVAL(@WK_SCENE_C08R0401, 2)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_03', 'Ah! I see you were able to use your radar\neffectively! Well done, indeed!\rHere’s your reward!')
	_LDVAL(@SCWK_TEMP0, 1810)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_04_1', 'Dig in the walls of the Grand Underground to\nunearth hidden things.\rTreasure you find will go straight into your Bag!')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_02_04_2', 'Spheres are special gems that can be exchanged\nfor goods down there.\rNow, what should I assign you next...?')
	_FLAG_SET(#FE_C04R0801_MISSION2)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_03_chk:
	_IF_FLAGOFF_JUMP(#FE_UG_MISSION_TALK, 'ev_ug_mission_03_01')
	_IF_FLAGOFF_JUMP($SYS_FLAG_UG_DIG, 'ev_ug_mission_03_02')
	_JUMP('ev_c04r0801_mission_03_clear')
	_END()
ev_ug_mission_03_01:
	_FLAG_SET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_01_1', 'Have you grown weary of repeatedly going back\nunderground? Well, it’s not over yet!\rNext up is your Secret Base. That’s right, I will\nteach you how to make your own Secret Base!')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_01_2', 'All you need is the Digger Drill I gave you earlier.\rSimply go to the Grand Underground and use\nthe Digger Drill wherever you like.\rIt will instantly create your very own Secret Base!')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_01_3', 'So, your next assignment is: make a Secret Base!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_ug_mission_03_02:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_02_1', 'Oh? You don’t know how to use the Digger Drill?\rOK, I’ll admit this test may have been a little\ntricky for you.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_02_2', 'All you must do is find the Digger Drill in your\nBag. Then, face a wall and use the Digger Drill.\fThat’s all it takes.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_02_3', 'Do that and you’ll have your Secret Base before\nyou can say...\r<size=250%>Boo!</size>\rNo, but seriously, there are some walls you can’t\ndig through, like those at the corners of a tunnel.\rFirst, try to dig into different walls!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_03_clear:
	_LDVAL(@WK_SCENE_C08R0401, 3)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_03', 'Ah, you’ve made your Secret Base. Excellent!\rI thought I might have been asking too much of\nyou, but you did it!\rWell done! Take these as your reward!')
	_TALK_CLOSE()
	_SE_PLAY('M_FI013')
	_LDVAL(@SCWK_TEMP0, 15)
	_LDVAL(@SCWK_TEMP1, 5)
	_LDVAL(@SCWK_TEMP2, 69420); Set this to 69420 so we skip the "You put into x pocket" message
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 13)
	_LDVAL(@SCWK_TEMP1, 5)
	_LDVAL(@SCWK_TEMP2, 69420); Set this to 69420 so we skip the "You put into x pocket" message
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 7)
	_LDVAL(@SCWK_TEMP1, 5)
	_LDVAL(@SCWK_TEMP2, 69420); Set this to 69420 so we skip the "You put into x pocket" message
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_04_04', 'By the by, a Digger Drill can only be used once.\rIf you wish to move your Secret Base, you will\nneed to obtain another Digger Drill.\rYou can trade spheres for one underground.\rNow, what should I have you do next...?')
	_TALK_CLOSE()
	_FLAG_SET(#FE_C04R0801_MISSION3)
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_04_chk:
	_IF_FLAGOFF_JUMP(#FE_UG_MISSION_TALK, 'ev_ug_mission_04_01')
	_IF_FLAGOFF_JUMP($SYS_FLAG_UG_GOODS, 'ev_ug_mission_04_02')
	_JUMP('ev_c04r0801_mission_04_clear')
	_END()
ev_ug_mission_04_01:
	_FLAG_SET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_05_01_1', 'You’ve made yourself a Secret Base, yes...\nBut it’s totally empty, is it not?')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_05_01_2', 'Not to worry. You can place statues in your own\nSecret Base as you see fit!')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_05_01_3', 'So! For my next test, I want you to decorate your\nSecret Base. Set up statues in there as you like!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_ug_mission_04_02:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_05_02_1', 'Ah, have I finally managed to stump you?\nPerhaps you don’t have any statues?')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_05_02_2', 'Statues can be found in the stone boxes you’ll\nfind while digging for Fossils!\rJust check your radar for yellow lights, press the\nA Button in the right spot, and dig up treasures!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_04_clear:
	_LDVAL(@WK_SCENE_C08R0401, 4)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_05_03_1', 'Aha! You managed to decorate your Secret Base.\nI knew I recognized a top-notch spelunker in you!\rWell done! This is your reward!')
	_SE_PLAY('M_FI013')
	_ADD_UG_ITEM(370, 1, @SCWK_ANSWER)
	_UG_ITEM_NAME(0, 370, 1)
	_TALKMSG('dialogue_c04r0801%91-msg_goods_get_01')
	_ME_WAIT()
	_TALK_CLOSE()
	_FLAG_SET(#FE_C04R0801_MISSION4)
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_05_chk:
	_IF_FLAGOFF_JUMP($SYS_FLAG_WILDCARD_000, 'ev_ug_mission_09_01')
	_IF_FLAGOFF_JUMP(#FE_UG_MISSION_TALK, 'ev_ug_mission_05_01')
	_JUMP('ev_c04r0801_mission_05_clear')
	_END()
ev_ug_mission_05_01:
	_FLAG_SET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_01_1', 'Ah! You’ve stuck it out to the end! This will be\nmy final test.\rThe Grand Underground attracts lots of people.\nYou’re not the only one down there!')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_01_2', 'Other spelunkers have Secret Bases of their own.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_01_3', 'Is what I would say!\nBut you’re playing a mod!\fAhahahaha!\rDon’t worry about it youngster.\nYou get a free pass this time.\rTalk to me again a little later,\nI’ll have something for you then.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_ug_mission_05_02:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_02_1', 'Ah! Have you found someone else’s Secret Base?')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_02_2', 'First, launch wireless communications, and then\ngo to the Grand Underground!\rOnce you find someone’s else’s Secret Base,\nmake sure to take a look inside!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_05_clear:
	_LDVAL(@WK_SCENE_C08R0401, 5)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_FLAG_RESET(#FE_C08R0401_GOODS)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_03_1', 'Oh! The look on your face tells me you found\nsomeone else’s Secret Base!\rWell done. Here’s your reward!')
	_TALK_CLOSE()
	_SE_PLAY('M_FI013')
	_ADD_UG_ITEM(375, 1, @SCWK_ANSWER)
	_UG_ITEM_NAME(0, 375, 1)
	_TALKMSG('dialogue_c04r0801%91-msg_goods_get_01')
	_ADD_UG_ITEM(378, 1, @SCWK_ANSWER)
	_UG_ITEM_NAME(0, 378, 1)
	_TALKMSG('dialogue_c04r0801%91-msg_goods_get_01')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_08_03_2', 'Statues set up in Secret Bases appear to impart\nmysterious effects.\rYou can even get the power from someone else’s\nSecret Base!\rDon’t be shy! Make the power of statues yours!')
	_TALK_CLOSE()
	_FLAG_SET(#FE_C04R0801_MISSION5)
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_06_chk:
	_IF_FLAGOFF_JUMP(#FE_UG_MISSION_TALK, 'ev_ug_mission_06_01')
	_IF_FLAGOFF_JUMP($SYS_FLAG_UG_FRIEND_KASEKIHORI_SUCCESS, 'ev_ug_mission_06_02')
	_JUMP('ev_c04r0801_mission_06_clear')
	_END()
ev_ug_mission_06_01:
	_FLAG_SET(#FE_UG_MISSION_TALK)
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_01_1', 'I’ve taught you all that I know. But if you insist,\nthere is one more thing I should tell you.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_01_2', 'Have you seen lights with different colors at\nthe spots where you can dig for treasure?\rAt these spots, you can dig into the walls more\nthan you could near the usual yellow lights...')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_01_3', 'It seems you can find differently-colored lights\nwhen you communicate with other spelunkers.\rIf you do find one, I’ll give you a rare pedestal.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_ug_mission_06_02:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_02_1', 'Oh, have you found a light of a different color?\rIt seems you can find differently-colored lights\nwhen you communicate with other spelunkers.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_02_2', 'You’re a natural-born spelunker, so I’m pretty\nsure that you’ll be able to find one!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_06_clear:
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_04_1', 'Wait, don’t tell me! You’ve found a light of a\ndifferent color?\rExcellent! Now you should be capable of digging\nfor more treasures than ever before.')
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_04_2', 'Well done! This is your reward!')
	_SE_PLAY('M_FI013')
	_ADD_UG_ITEM(384, 1, @SCWK_ANSWER)
	_UG_ITEM_NAME(0, 384, 1)
	_TALKMSG('dialogue_c04r0801%91-msg_goods_get_01')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_ug_mission_06_05', 'There really is nothing else that I can teach you.\rAdd more statues to your Secret Base, dig for\ntreasure, and become a master spelunker for me!')
	_LDVAL(@WK_SCENE_C08R0401, 9)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0801_mission_urouro_anime:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 5, 'ev_c04r0801_mission_urouro_anime_l')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_c04r0801_mission_urouro_anime_r')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 4, 'ev_c04r0801_mission_urouro_anime_u')
	_JUMP('ev_c04r0801_mission_urouro_anime_d')
	_JUMP('ev_c04r0801_mission_urouro_anime_l')
ev_c04r0801_mission_urouro_anime_l:
	_OBJ_ANIME('C04R0801_UNDERGROUND', 'anm_c04r0801_mission_l')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c04r0801_mission_urouro_anime_r:
	_OBJ_ANIME('C04R0801_UNDERGROUND', 'anm_c04r0801_mission_r')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c04r0801_mission_urouro_anime_u:
	_OBJ_ANIME('C04R0801_UNDERGROUND', 'anm_c04r0801_mission_u')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c04r0801_mission_urouro_anime_d:
	_OBJ_ANIME('C04R0801_UNDERGROUND', 'anm_c04r0801_mission_d')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c04r0801_anahori_powered_s01:
	_CALL('ev_block_doc')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(11, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2461); Grand Underground Chapter
	_EVENT_START()
	_MACRO_TALKMSG('dialogue_c04r0801', '18-msg_c04r0801_underground_02_2', 'Let me mentor you as you become a full-fledged\nspelunker. Just follow my lead!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_GET_REL_POS_HERO('C04R0801_UNDERGROUND', @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 7, 'ev_c04r0801_anahori_powered_007')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 8, 'ev_c04r0801_anahori_powered_008')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 9, 'ev_c04r0801_anahori_powered_009')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 1, 'ev_c04r0801_anahori_powered_001')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 2, 'ev_c04r0801_anahori_powered_002')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 3, 'ev_c04r0801_anahori_powered_003')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 6, 'ev_c04r0801_anahori_powered_006')
	_JUMP('ev_c04r0801_anahori_powered_004')
	_END()
