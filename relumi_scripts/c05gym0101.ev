ev_c05gym0101_flag_change:
	_SET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_CALL('ev_c05gym0101_lift_event')
	_INIT_GHOST_GYM()
	_END()
ev_c05gym0101_lift_event:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'GE', 20, 'ev_c05gym0101_lift_down')
	_JUMP('ev_c05gym0101_lift_up')
ev_c05gym0101_lift_down:
	_FLAG_RESET(#FE_SAVE_GIMMICK_001)
	_RET()
ev_c05gym0101_lift_up:
	_FLAG_SET(#FE_SAVE_GIMMICK_001)
	_RET()
ev_c05gym0101_scene_change:
	_EVENT_START()
	_JUMP('ev_c05gym0101_gym_first')
	_END()
pos_c05gym0101_lift:
	_MOVE_FLD_LIFT()
	_CALL('ev_c05gym0104_lift_event_set2')
	_CALL('ev_c05gym0106_lift_event_set2')
	_CALL('ev_c05gym0108_lift_event_set2')
	_END()
ev_c05gym0101_gym_first:
	_EVENT_START()
	_CALL('ev_block_doc')
	_IFVAL_JUMP(@WK_SCENE_C05GYM0101, 'NE', 0, 'ev_c05gym0101_gym_first_end')
	_JUMP('ev_c05gym0101_gym_first_end'); Ignore the event cameras completely for now.
	_EVENT_CAMERA_INDEX(118)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c05gym0101_gym_first01')
	_END()
ev_c05gym0101_gym_first01:
	_EVENT_CAMERA_INDEX(119)
	_LDVAL(@WK_SCENE_C05GYM0101, 1)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_c05gym0101_gym_first_end:
	_CALL('ev_block_doc_end')
	_IF_FLAGON_JUMP(#FE_C05GYM0101_SUNGLASSES_TALK, 'ev_c05gym0101_gym_common_end')
	_CALL('ev_c05gym0101_advice_start')
	_END()
ev_c05gym0101_gym_common_end:
	_END()
ev_c05gym0101_advice_start:
	_OBJ_ANIME('C05GYM0101_ADVICE', 'anm_c05gym0101_advice_start')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c05gym0101_advice')
anm_c05gym0101_advice_start:
	_AC_WAIT(16)
	_AC_MARK_GYOE()
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_ACMD_END()
ev_c05gym0101_advice:
	_TALK_OBJ_START() ; _IF_FLAGOFF_JUMP($45, 'ev_c05gym0101_advice_03')
	_FLAG_SET(#2549); Hide outside advice dude in case of people stuck in gym
	_SYS_FLAG_BADGE_GET($BADGE_ID_C05, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c05gym0101_advice_02')
	_MACRO_TALKMSG('dialogue_c05gym0101', '00_msg_c05gym0101_sunglasses_01_1', 'Hey there!\nHow’s it going, Champ-to-be?\rThe Gym Leader here is a user\nof eerie Ghost-type Pokémon!\rThat’s not all, though!\nThis Gym is set up like a puzzle, and you\fhave to solve every room to get to Fantina!\rIn each room, you’ll get a choice of doors\nto go through, and you have to figure out the\fcorrect one!\rIf you get it wrong, you’ll find yourself\nback here with me and have to try again!\rThe rugs in each room will tell you the\nreal door in the next room.\rWhen you step on them, listen closely...\nYou’ll hear the cry of a Pokémon!\rNot only that, but if you examine each\nrug closely, you’ll see a description\fstitched into the fabric.\rOh, and before I forget!\nYou’re gonna need this if you want to\fget ANYWHERE in this Gym! You can return\fit on the way out, once you’ve beaten\fFantina!\rGo get ‘em, challenger! I believe in you!')
	_TALK_CLOSE()
	_IF_FLAGOFF_CALL(#FE_C05GYM0101_SUNGLASSES_TALK, 'ev_c05gym0101_advice_move_back')
	_TALK_OBJ_END()
	_END()
ev_c05gym0101_advice_move_back:
	_FLAG_SET(#FE_C05GYM0101_SUNGLASSES_TALK)
	_OBJ_ANIME('C05GYM0101_ADVICE', 'anm_c05gym0101_advice_move_back')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c05gym0101_advice_move_back:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_ACMD_END()
ev_c05gym0101_advice_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_sunglasses_02', 'Oh! {0,1,0,0}!\nYou’ve beaten the Gym Leader!\rThere seems to be no end to how tough you\nare getting! At least that’s how I see it!\r...\rYou do realize I say that to everyone, right?', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05gym0101_advice_03:
	_IF_FLAGON_JUMP(#FE_C05GYM0101_SUNGLASSES_TALK, 'ev_c05gym0101_advice_04')
	_FLAG_SET(#FE_C05GYM0101_SUNGLASSES_TALK)
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_sunglasses_a_01_1', 'Hey there! How’s it going, Trainer?\rYou being here tells me you’re going to\nchallenge the Gym Leader.')
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_sunglasses_a_01_2', 'Well... I hate to break it to you, but\nthat’s impossible.\rYou’re wondering why, and the answer is:\nshe’s not here.')
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_sunglasses_a_01_3', 'Come back another time, OK? I’ll be right\nhere waiting.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05gym0101_advice_04:
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_sunglasses_a_02', 'So, where’s the Gym Leader, you ask?\rI can’t precisely say, but I have a hunch that she’ll\nreturn one day...\rBut only after you visit other places, I think.\rHey, I’m sorry I’m not more useful. My advice-\ngiving needs work...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05gym0101_statue:
	_FLAG_RESET(#1378)
	_MOVE_FLD_LIFT()
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C05, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c05gym0101_statue_02')
	_RIVAL_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_statue_01', 'Hearthome City Pokémon Gym\nGym Leader: Fantina\fCertified Trainers: {1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c05gym0101_statue_02:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_RIVAL_NAME(2)
	_MACRO_TALKMSG('dialogue_c05gym0101', '35-msg_c05gym0101_statue_02', 'Hearthome City Pokémon Gym\nGym Leader: Fantina\rCertified Trainers: {0,1,0,0}\n{1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
