ev_r221r0101_stopper:
	_MACRO_EASY_OBJ_MSG('dialogue_r221r0101', '00_msg_r221r0101_stopper_1', 'Sorry. So sorry! We’re very sorry.\nWe cannot let any bystanders into\fthe Park at this time.\rThere have been some absolutely\nfascinating—er, distressing readings\fcoming from inside lately.\rUnder Champion Cynthia’s authority,\nwe have asked to have it closed off to the\fpublic until we can determine its safety.\rSorry! So sorry!')
	_END()