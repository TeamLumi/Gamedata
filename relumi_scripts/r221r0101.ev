ev_r221r0101_flag_change:
	_FLAG_RESET($SYS_FLAG_BGM_D10)
	_LDVAL(@HIDEMAP_ID_D10R0101, 1)
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_R221R0101)
	_CALL('ev_r221r0101_zou_count')
	_IFVAL_CALL(@LOCALWORK11, 'GT', @WK_SCENE_R221R0101_ZOU, 'ev_r221r0101_zou_map')
	_IFVAL_JUMP(@WK_SCENE_D10R0101, 'NE', 0, 'ev_r221r0101_flag_change_01')
	_END()
ev_r221r0101_flag_change_01:
	_SXY_POS_CHANGE('R221R0101_ADMIN', 8, 9)
	_OBJ_DIR_CHANGE('R221R0101_ADMIN', 2)
	_END()
ev_r221r0101_zou_count:
	_LDVAL(@LOCALWORK10, 0)
	_LDVAL(@LOCALWORK11, 0)
	_IF_FLAGON_CALL(#FE_D10R0202POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0202POKE_02, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0202POKE_03, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0301POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0301POKE_02, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0301POKE_03, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0302POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0302POKE_02, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0302POKE_03, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0303POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0303POKE_02, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0401POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0402POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0403POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0501POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0502POKE_01, 'ev_r221r0101_zou_count_add')
	_IF_FLAGON_CALL(#FE_D10R0601POKE_01, 'ev_r221r0101_zou_count_add')
	_RET()
ev_r221r0101_zou_count_add:
	_ADD_WK(@LOCALWORK11, 1)
	_RET()
ev_r221r0101_zou_map:
	_PLAYER_POS_GET(@LOCALWORK12, @LOCALWORK13)
	_IFVAL_CALL(@LOCALWORK12, 'EQ', 7, 'ev_r221r0101_zou_map2')
	_RET()
ev_r221r0101_zou_map2:
	_IFVAL_JUMP(@LOCALWORK13, 'EQ', 8, 'ev_r221r0101_zou_map3')
	_RET()
ev_r221r0101_zou_map3:
	_LDVAL(@LOCALWORK12, @LOCALWORK11)
	_SUB_WK(@LOCALWORK12, @WK_SCENE_R221R0101_ZOU)
	_LDVAL(@LOCALWORK10, 10)
	_RET()
ev_r221r0101_admin:
	_TALK_OBJ_START()
	_CALL('ev_r221r0101_zou_count')
	_IFVAL_CALL(@LOCALWORK11, 'GT', @WK_SCENE_R221R0101_ZOU, 'ev_r221r0101_admin_zou_talk')
	_IF_FLAGON_JUMP(#FE_R221R0101ADMIN_FAST, 'ev_r221r0101_admin_b')
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_01', 'Welcome to Renegade Park!\rThis place is a tourist attraction that’s famous for\nthe Renegade roses blooming all over.\rIt’s also where top-notch Trainers gather from\nmany different regions.\rYou might say Renegade roses attract those who\nare strong—now that’s what I call flower power!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FE_R221R0101ADMIN_FAST)
	_END()
ev_r221r0101_admin_b:
	_IFVAL_CALL(@WK_SCENE_R221R0101_ZOU, 'GE', 14, 'ev_r221r0101_admin_c')
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_31', 'Have you met any of the Pokémon that are said\nto appear in Renegade Park yet?\rA staff member by the entrance is trading\nslates—there may be some meaning\fbehind them.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r221r0101_admin_c:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_31', 'Have you met any of the Pokémon that are said\nto appear in Renegade Park yet?\rA staff member by the entrance is trading\nslates—there may be some meaning\fbehind them.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r221r0101_admin_zou_talk:
	_OBJ_ANIME('R221R0101_ADMIN', 'anm_r221r0101_admin_02')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_r221r0101_admin_back2')
	_END()
ev_r221r0101_admin_back:
	_EVENT_START()
	_OBJ_ANIME('HERO', 'anm_r221r0101_player_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R221R0101_ADMIN', 'anm_r221r0101_admin_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R221R0101_ADMIN', 'anm_r221r0101_admin_02')
	_OBJ_ANIME('HERO', 'anm_r221r0101_player_02')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_r221r0101_admin_back2')
	_END()
ev_r221r0101_admin_back2:
	_IFVAL_CALL(@LOCALWORK12, 'EQ', 1, 'ev_r221r0101_admin_back2_talk01')
	_IFVAL_CALL(@LOCALWORK12, 'NE', 1, 'ev_r221r0101_admin_back2_talk02')
	_SE_PLAY('M_FI013')
	_IF_FLAGON_CALL(#FE_D10R0202POKE_01, 'ev_r221r0101_admin_check1')
	_IF_FLAGON_CALL(#FE_D10R0202POKE_02, 'ev_r221r0101_admin_check2')
	_IF_FLAGON_CALL(#FE_D10R0202POKE_03, 'ev_r221r0101_admin_check3')
	_IF_FLAGON_CALL(#FE_D10R0301POKE_01, 'ev_r221r0101_admin_check4')
