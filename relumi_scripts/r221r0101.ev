ev_r221r0101_scientist1:; Upper NPC
	_MACRO_EASY_OBJ_MSG('dialogue_r221r0101', '178-msg_r221r0101_scientist_01', 'Ahhh, nothing like a good ol’ cuppa while\nwe ponder the mysteries of the universe.')
	_END()
ev_r221r0101_scientist2:; Bottom Right NPC
	_MACRO_EASY_OBJ_MSG('dialogue_r221r0101', '178-msg_r221r0101_scientist_02', 'Huh, who’re you? A Trainer?\nYou know, a strong enough Trainer\fcould help us investigate...\rbut you don’t look that strong to me.\nCome back when you’re a little stronger.')
	_END()
ev_r221r0101_scientist3:; Bottom Left NPC
	_MACRO_EASY_OBJ_MSG('dialogue_r221r0101', '178-msg_r221r0101_scientist_03', 'My word, this data! I shall have to share these findings!')
	_END()
ev_r221r0101_scientist4:; Top Left NPC
	_TALK_START()
	_TURN_HERO_TALK_OBJ()
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_scientist_04', 'Is it... the flowers?')
	_TALK_CLOSE()
	_CALL('ev_r221r0101_gossifleur_constant_anim')
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_scientist_04_02', 'The flowers...\nHow can it be the flowers?!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r221r0101_gossifleur_constant_anim:
	_OBJ_ANIME('R221R0101_GOSSIFLEUR_SCIENTIST_04', 'anm_r221r0101_gossifleur_sparklies')
	_PLAY_EMO_SE(11)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R221R0101_GOSSIFLEUR_SCIENTIST_04', 'anm_r221r0101_gossifleur_spin_spin_spin')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SE_PLAY('PLAY_PV_829_00_00')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r221r0101_gossifleur_sparklies:
	_AC_MARK_EMO(11)
	_ACMD_END()
anm_r221r0101_gossifleur_spin_spin_spin:
	_AC_INDEX_ANIME(45)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
ev_r221r0101_gossifleur:
	_EASY_VOICE_MSG('dialogue_r221r0101%msg_r221r0101_gossifleur', 'PLAY_PV_829_00_00')
	_END()
