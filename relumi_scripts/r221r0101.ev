	_IF_FLAGON_CALL(#FE_D10R0301POKE_03, 'ev_r221r0101_admin_check6')
	_IF_FLAGON_CALL(#FE_D10R0302POKE_01, 'ev_r221r0101_admin_check7')
	_IF_FLAGON_CALL(#FE_D10R0302POKE_02, 'ev_r221r0101_admin_check8')
	_IF_FLAGON_CALL(#FE_D10R0302POKE_03, 'ev_r221r0101_admin_check9')
	_IF_FLAGON_CALL(#FE_D10R0303POKE_01, 'ev_r221r0101_admin_check10')
	_IF_FLAGON_CALL(#FE_D10R0303POKE_02, 'ev_r221r0101_admin_check11')
	_IF_FLAGON_CALL(#FE_D10R0401POKE_01, 'ev_r221r0101_admin_check12')
	_IF_FLAGON_CALL(#FE_D10R0402POKE_01, 'ev_r221r0101_admin_check13')
	_IF_FLAGON_CALL(#FE_D10R0403POKE_01, 'ev_r221r0101_admin_check14')
	_IF_FLAGON_CALL(#FE_D10R0501POKE_01, 'ev_r221r0101_admin_check15')
	_IF_FLAGON_CALL(#FE_D10R0502POKE_01, 'ev_r221r0101_admin_check16')
	_IF_FLAGON_CALL(#FE_D10R0601POKE_01, 'ev_r221r0101_admin_check17')
	_ME_WAIT()
	_IF_FLAGOFF_JUMP(#1752, 'ev_r221r0101_admin_back_fast')
	_IFVAL_CALL(@LOCALWORK12, 'EQ', 1, 'ev_r221r0101_admin_back2_talk03')
	_IFVAL_CALL(@LOCALWORK12, 'NE', 1, 'ev_r221r0101_admin_back2_talk04')
	_SXY_MV_CHANGE('R221R0101_ADMIN', 0)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r221r0101_admin_back_fast:
	_IFVAL_CALL(@LOCALWORK12, 'EQ', 1, 'ev_r221r0101_admin_back_fast_talk01')
	_IFVAL_CALL(@LOCALWORK12, 'NE', 1, 'ev_r221r0101_admin_back_fast_talk02')
	_FLAG_SET(#1752)
	_SXY_MV_CHANGE('R221R0101_ADMIN', 0)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r221r0101_admin_back2_talk01:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_02', 'What an amazing Pokémon you’ve caught!\nI’ll give you a statue that looks just like it!')
	_RET()
ev_r221r0101_admin_back2_talk02:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_02p', 'What amazing Pokémon you’ve caught!\nI’ll give you statues that look just like them!')
	_RET()
ev_r221r0101_admin_back2_talk03:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_29', 'Thanks for showing me a Pokémon that comes\nto see the Renegade roses.')
	_RET()
ev_r221r0101_admin_back2_talk04:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_29p', 'Thanks for showing me the Pokémon that come\nto see the Renegade roses.')
	_RET()
ev_r221r0101_admin_back_fast_talk01:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_28', 'This is a rare statue only available at Renegade\nPark. Please put it up in your Secret Base in the\fGrand Underground!')
	_RET()
ev_r221r0101_admin_back_fast_talk02:
	_MACRO_TALKMSG('dialogue_r221r0101', '178-msg_r221r0101_admin_28p', 'These are rare statues only available at Renegade\nPark. Please put them up in your Secret Base in\fthe Grand Underground!')
