ev_c04_gym0102_init_clock_camera:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_DUMMY_SET_POS(@SCWK_TEMP0, @SCWK_TEMP1)
	_CAMERA_TARGET_DUMMY()
	_DUMMY_ANIME('anm_c04gym0102_camera_1_on')
	_DUMMY_ANIME_WAIT()
	_RET()
ev_c04_gym0102_end_clock_camera:
	_DUMMY_ANIME('anm_c04gym0102_camera_1_off')
	_DUMMY_ANIME_WAIT()
	_CAMERA_TARGET_HERO()
	_RET()
ev_c04gym0102_rotate_clock_1:
	_CALL('ev_c04_gym0102_init_clock_camera')
	_OBJ_ANIME('C04GYM0102_CLOCK_HAND_2', 'anm_c04gym0102_clockhand_1_1')
	_OBJ_ANIME('C04GYM0102_CLOCK_HAND_1', 'anm_c04gym0102_clockhand_2_1')
	_OBJ_ANIME_WAIT()
	_TOGGLE_COLLISION_BOX('Wall1', 0)
	_TOGGLE_COLLISION_BOX('Wall2', 1)
	_TOGGLE_COLLISION_BOX('Wall3', 1)
	_TOGGLE_COLLISION_BOX('Wall4', 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CALL('ev_c04_gym0102_end_clock_camera')
	_RET()
ev_c04gym0102_rotate_clock_2:
	_CALL('ev_c04_gym0102_init_clock_camera')
	_OBJ_ANIME('C04GYM0102_CLOCK_HAND_2', 'anm_c04gym0102_clockhand_1_2')
	_OBJ_ANIME('C04GYM0102_CLOCK_HAND_1', 'anm_c04gym0102_clockhand_2_2')
	_OBJ_ANIME_WAIT()
	_TOGGLE_COLLISION_BOX('Wall1', 1)
	_TOGGLE_COLLISION_BOX('Wall2', 0)
	_TOGGLE_COLLISION_BOX('Wall3', 1)
	_TOGGLE_COLLISION_BOX('Wall4', 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CALL('ev_c04gym0102_remove_sprinkler_right')
	_CALL('ev_c04_gym0102_end_clock_camera')
	_RET()
ev_c04gym0102_rotate_clock_3:
	_CALL('ev_c04_gym0102_init_clock_camera')
	_OBJ_ANIME('C04GYM0102_CLOCK_HAND_2', 'anm_c04gym0102_clockhand_1_3')
