ev_c04gym0102_gym_first:
	_EVENT_START()
	_OBJ_DIR_CHANGE('C04GYM0102_CLOCK_HAND_1', 40)
	_OBJ_DIR_CHANGE('C04GYM0102_CLOCK_HAND_2', 320)
	_TOGGLE_COLLISION_BOX('Wall1', 1)
	_TOGGLE_COLLISION_BOX('Wall2', 1)
	_TOGGLE_COLLISION_BOX('Wall3', 1)
	_TOGGLE_COLLISION_BOX('Wall4', 1)
	_CALL('ev_c04gym0102_add_sprinkler_force_both')
	_EVENT_CAMERA_INDEX(401)
	_EVENT_CAMERA_END_WAIT()
	_EVENT_CAMERA_INDEX(400)
	_LDVAL(@WK_SCENE_C04GYM0101, 1)
	_EVENT_END()
	_END()
ev_c04gym0102_randomteam_gardenia:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 827)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 828)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 829)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 830)
	_RET()
ev_c04gym0102_randomteam_gardenia_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 895)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 896)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 897)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 898)
	_RET()
ev_c04gym0102_leader:
	_LDVAL(@WK_SCENE_C04GYM0102, 4)
	_LDVAL(@WK_SCENE_C04GYM0101, 2)
	_PLAYER_NAME(0)
	_SYS_FLAG_BADGE_GET($BADGE_ID_C04, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04gym0102_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 15, 1, 8.300000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(402)
	_FIND_BG_DISABLE(0, 'P_C_001_Tree_01_/P_C_001_Tree_01picup')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_01_1', 'You kept me waiting!\rI’m Eterna’s Gym Leader, Gardenia, the Grass-\ntype master!\rWhen I first saw you, I was convinced you’d find\nyour way to me.')
	_OBJ_ANIME('C04GYM0102_LEADER', 'anm_c04gym0102_leader_01_face04')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_01_2', 'My hunch was right on the money. You have a\nwinning aura about you.\rSo, anyway, this will be fun. Let’s have our battle!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(117)
	_OBJ_ANIME('C04GYM0102_LEADER', 'anm_c04gym0102_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_FIND_BG_ENABLE(0, 'P_C_001_Tree_01_/P_C_001_Tree_01picup')
	_BTL_ENCSEQ_LOAD('gym02')
	_LDVAL(@WK_PLAY_REPO_NO, 3)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c04gym0102_randomteam_gardenia')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_02_1', 'I might’ve said it before, but you’re really tough!\rWasn’t it hard for you to raise your Pokémon to\nbe so good?')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_02_2', 'I guess that’s a measure of how much you love\nyour Pokémon.\rIn recognition of that, I proudly grant you this!')
	_TALK_CLOSE()
	_BADGE_GET(1)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_03', 'You received the Forest Badge from Gardenia!')
	_ME_WAIT()
	_TALK_CLOSE()
	_SYS_FLAG_BADGE_SET($BADGE_ID_C04)
	_TRAINER_FLAG_SET(296)
	_TRAINER_FLAG_SET(297)
	_TRAINER_FLAG_SET(248)
	_TRAINER_FLAG_SET(269)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 5200)
	_FLAG_RESET(#FV_C04_DOCTOR)
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_04_1', 'With the Forest Badge, the hidden move Cut will\nbe available from your Pokétch.')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_04_2', 'Now that you have two Gym Badges, all\nPokémon you received in trades will obey\fyou up to Lv. 30.')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_04_3', 'I’ve also got something else for you. These are\na gift from me!')
	_CB_ITEM_NUM_ADD(50, 3)
	_CB_ITEM_NUM_ADD(53, 2)
	_CB_ITEM_NUM_ADD(37, 3)
	_CB_ITEM_NUM_ADD(38, 2)
	_CB_ITEM_NUM_ADD(39, 1)
	_CB_ITEM_NUM_ADD(40, 2)
	_CB_ITEM_NUM_ADD(41, 1)
	_SE_PLAY('M_FI014')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER2_01')
	_MACRO_TALKMSG('dialogue_c04gym0102', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c04gym0102_leader_item_get')
	_END()
anm_c04gym0102_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c04gym0102_leader_01_face04:
	_AC_FACE_INDEX(4)
	_ACMD_END()
ev_c04gym0102_leader_item_get:
	_LDVAL(@WK_SCENE_C04GYM0102, 5)
	_LDVAL(@SCWK_TEMP0, 413)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04gym0102_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C04_GYM_ITEM_GET)
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_ITEM_WAZA_NAME(1, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_05', '{0,1,9,0} contains the move {1,1,7,0}.\nIt’s one of my favorite moves.\rThe heavier the opposing Pokémon, the more\ndamage this move will cause.')
	_TALK_CLOSE()
	_CALL('ev_block_doc')
	_CALL('ev_c04gym0102_rotate_clock_finish')
	_CALL('ev_block_doc_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c04gym0102_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c04gym0102_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C04_GYM_ITEM_GET, 'ev_c04gym0102_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c04gym0102_leader_return_match')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_06', 'Yup! If there’s one thing I can tell about you,\nit’s this—you and your Pokémon are gonna get\feven tougher, and I mean seriously!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04gym0102_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C04_GYM_RETRUN_MATCH_FIRST, 'pos_c04gym0102_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C04_GYM_RETRUN_MATCH, 'pos_c04gym0102_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_07_01', 'You kept me waiting, {0,1,0,0}!\rWhen I first saw you, I just knew it—sooner or\nlater, this kid was gonna defeat the Champion.\rAnd now look at you! You’re just oozing with the\nwinning aura of a really tough Trainer!\rBut it makes me think... If I can beat you now,\nthen I’ll be the strongest Trainer there is!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym02')
	_LDVAL(@WK_PLAY_REPO_NO, 27)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c04gym0102_randomteam_gardenia_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_07_02', 'Wow, you really are strong! Just how did you\nraise your Pokémon to be that tough?')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_07_03', 'Well, anyway, here! As thanks for that battle,\nI’ll give you my favorite Sticker.')
	_LDVAL(@SCWK_TEMP0, 68)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C04_GYM_RETRUN_MATCH)
	_FLAG_SET(#FE_C04_GYM_RETRUN_MATCH_FIRST)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c04gym0102_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C04_GYM_RETRUN_MATCH, 'pos_c04gym0102_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_08_01', 'You kept me waiting, {0,1,0,0}!\nToday’s the day!\rI’ll finally prove I’m the strongest!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym02')
	_LDVAL(@WK_PLAY_REPO_NO, 27)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c04gym0102_randomteam_gardenia_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_08_02', 'You’re just so incredibly strong! How in the world\ndid you raise your Pokémon to be that tough?')
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_07_03', 'Well, anyway, here! As thanks for that battle,\nI’ll give you my favorite Sticker.')
	_LDVAL(@SCWK_TEMP0, 68)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C04_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c04gym0102_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_leader_07_04', 'But this doesn’t mean I’ve given up! I’m up for a\nPokémon battle every day if you are!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04gym0102_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c04gym0102_trainer1:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_C04GYM0102, 'GE', 1, 'ev_c04gym0102_trainer1_win')
	_MACRO_TALK_KEYWAIT('dialogue_c04gym0102', '17-msg_c04gym0102_mini09_01', 'Welcome!\nWithout further ado, let’s go!')
	_TALK_CLOSE()
	_SET_SYS_FLAG($SYS_FLAG_BTL_RETURN_CALL_SP)
	_LDVAL(@SCWK_TEMP3, 248)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_RESET_SYS_FLAG($SYS_FLAG_BTL_RETURN_CALL_SP)
	_MACRO_TALKMSG('dialogue_c04gym0102', '17-msg_c04gym0102_mini09_02', 'This gym’s floral clock...\nYou can walk on its hands.\fThat’s how you get to the next Trainer.')
	_TALK_CLOSE()
	_CALL('ev_c04gym0102_rotate_clock_1')
	_TALK_OBJ_END()
	_LDVAL(@WK_SCENE_C04GYM0102, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 4800)
	_END()
