	_TOGGLE_COLLISION_BOX('Wall1', 1)
	_TOGGLE_COLLISION_BOX('Wall2', 0)
	_TOGGLE_COLLISION_BOX('Wall3', 0)
	_TOGGLE_COLLISION_BOX('Wall4', 1)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CALL('ev_c04gym0102_remove_sprinkler_left')
	_CALL('ev_c04_gym0102_end_clock_camera')
	_RET()
ev_c04gym0102_rotate_clock_finish:
	_CALL('ev_c04_gym0102_init_clock_camera')
	_OBJ_ANIME('C04GYM0102_CLOCK_HAND_2', 'anm_c04gym0102_clockhand_1_4')
	_OBJ_ANIME_WAIT()
	_TOGGLE_COLLISION_BOX('Wall1', 0)
	_TOGGLE_COLLISION_BOX('Wall2', 1)
	_TOGGLE_COLLISION_BOX('Wall3', 0)
	_TOGGLE_COLLISION_BOX('Wall4', 1)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CALL('ev_c04_gym0102_end_clock_camera')
	_RET()
