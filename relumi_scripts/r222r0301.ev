ev_r222r0301_workman:
	_MACRO_EASY_OBJ_MSG('dialogue_r222r0301', '188-msg_r222r0301_workman_01', 'If I had to describe Sunyshore Gym in a word,\nit’d be...shockingly electric!\rWhoops, that’s two words!')
	_END()
ev_r222r0301_veteran:
	_MACRO_EASY_OBJ_MSG('dialogue_r222r0301', '188-msg_r222r0301_veteran_01', 'Sunyshore’s Gym Leader has been bored lately,\nI hear. Apparently, there’s been a lack of\fworthwhile challengers.')
	_END()