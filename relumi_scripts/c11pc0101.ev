ev_c11pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c11pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_c11pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c11pc0101_flag_change_del_stopper')
	_END()
ev_c11pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_c11pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_c11pc0101_man2:
	_MACRO_EASY_OBJ_MSG('dialogue_c11pc0101', '33-msg_c11pc0101_man2_01', 'The Battle Tower’s as tough as they say...\nIt’s no cakewalk, that’s for sure.')
	_END()
ev_c11pc0101_waitress:
	_MACRO_EASY_OBJ_MSG('dialogue_c11pc0101', '33-msg_c11pc0101_waitress_01', 'The best Trainers gather here—not just from this\nregion but from all around the world.')
	_END()
ev_c11pc0101_fighter:
	_MACRO_EASY_OBJ_MSG('dialogue_c11pc0101', '33-msg_c11pc0101_fighter_01', 'To strengthen myself! To strengthen my Pokémon!\nFor that alone, I have come!')
	_END()