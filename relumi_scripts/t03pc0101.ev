ev_t03pc0101_flag_change:
	_IF_FLAGON_JUMP($806, 'ev_t03pc0101_flag_change_end')
	_FLAG_RESET(#516)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_t03pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($124, @246)
	_IFVAL_JUMP(@246, 'EQ', 1, 'ev_t03pc0101_flag_change_del_stopper')
	_END()
ev_t03pc0101_flag_change_del_stopper:
	_FLAG_SET(#516)
	_END()
ev_t03pc0101_pcwoman1:; TODO Look into this
	_LDVAL(@SCWK_TEMP3, 'T03PC0101_PCWOMAN1')
	_JUMP('ev_heal_p01')
	_END()
ev_t03pc0101_middleman1:
	_MACRO_EASY_OBJ_MSG('dialogue_t03pc0101', '94-msg_t03pc0101_middleman1_01', 'If you’ve got Pokémon with you, it’s safe for even\na kid like you to go off traveling alone.')
	_END()
ev_t03pc0101_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_t03pc0101', '94-msg_t03pc0101_girl2_01', 'I had a battle the other day, and my Pokémon’s\nHP got low. I thought we were done for...\rBut then, all of a sudden, my Pokémon ate the\nBerry it was holding! Whew!')
	_END()
ev_t03pc0101_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_t03pc0101', '94-msg_t03pc0101_woman3_01', 'We’re kinda close to Eterna City, but it’s still\nquite far away.\rYou should be prepared for a long journey.')
	_END()