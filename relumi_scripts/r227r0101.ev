ev_r227r0101_oldwoman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r227r0101', '70-msg_r227r0101_oldwoman1_01', 'Oh, dear, are your Pokémon feeling tired?\nYou should rest up. Yes, good idea! Rest up here!')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'yes_r227r0101_oldwoman1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_r227r0101_oldwoman1')
	_END()
yes_r227r0101_oldwoman1:
	_MACRO_TALKMSG('dialogue_r227r0101', '70-msg_r227r0101_oldwoman1_02', 'Yes, yes, that’s right. Get some well-earned rest.')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_r227r0101', '70-msg_r227r0101_oldwoman1_03', 'Oh, you’re still looking tired. You’re still needing\nrest, are you?\rYou should rest up again. Yes, good idea!\nRest up here!')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'yes_r227r0101_oldwoman1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_r227r0101_oldwoman1')
	_END()
no_r227r0101_oldwoman1:
	_MACRO_TALKMSG('dialogue_r227r0101', '70-msg_r227r0101_oldwoman1_04', 'Is that right? You’re sure now?\rI’m only concerned for your sake. No need to\nworry about putting me out!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()