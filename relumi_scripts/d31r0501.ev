ev_d31r0501_man2:
	_TALK_OBJ_START_TURN_NOT()
	;_MACRO_TALKMSG('dp_scenario3', 'msg_d31r0501_man2_01', 'At first, you can only use CP for\nrestoring HP.\rYou can spend CP to rank up, though.\nDoing that, you can even restore PP.')
	_MACRO_TALKMSG('dialogue_d31r0501', 'msg_d31r0501_man2_01', 'At first, you can only use CP for\nrestoring HP.\rYou can spend CP to rank up, though.\nDoing that, you can even restore PP.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31r0501_bigman1:
	;_MACRO_EASY_OBJ_MSG('dp_scenario3', 'msg_d31r0501_bigman1_01', 'Before every battle, you should check\nthe opponent’s lineup.\rDon’t be cheap with your CP.\nIt’s like that old saying goes about\fknowing your enemy.\r“If you know yourself but not your\nenemy, for every victory gained\fyou will also suffer a defeat.”\rIn other words, it all goes up in smoke\nif you lose!')
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0501', 'msg_d31r0501_bigman1_01', 'Before every battle, you should check\nthe opponent’s lineup.\rDon’t be cheap with your CP.\nIt’s like that old saying goes about\fknowing your enemy.\r“If you know yourself but not your\nenemy, for every victory gained\fyou will also suffer a defeat.”\rIn other words, it all goes up in smoke\nif you lose!')
	_END()
ev_d31r0501_woman2:
	;_MACRO_EASY_OBJ_MSG('dp_scenario3', 'msg_d31r0501_woman2_01', 'Mr. Darach...\nOh, how I pine for thee...')
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0501', 'msg_d31r0501_woman2_01', 'Mr. Darach...\nOh, how I pine for thee...')
	_END()
ev_d31r0501_man3:
	;_MACRO_EASY_OBJ_MSG('dp_scenario3', 'msg_d31r0501_man3_01', 'I have a matter of grave importance\nto share with you.\rI can’t stress just how important\nthis is for me to say.\rIf you lose, your entire stock of CP\nis cleaned out to zero! How tragic!')
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0501', 'msg_d31r0501_man3_01', 'I have a matter of grave importance\nto share with you.\rI can’t stress just how important\nthis is for me to say.\rIf you lose, your entire stock of CP\nis cleaned out to zero! How tragic!')
	_END()
