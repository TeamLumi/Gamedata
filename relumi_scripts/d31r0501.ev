ev_d31r0501_pc_score:
	_EVENT_START()
	;_MACRO_TALKMSG('dp_scenario3', 'msg_d31r0501_pc_score_01', 'Which record would you like to see?')
	_MACRO_TALKMSG('dialogue_d31r0501', 'msg_d31r0501_pc_score_01', 'Which record would you like to see?')
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlecastle_pc_1', 'Single', 1)
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlecastle_pc_2', 'Double', 2)
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlecastle_pc_3', 'Multi', 3)
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlecastle_pc_cancel', 'Cancel', 0)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlecastle_pc_1', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlecastle_pc_2', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlecastle_pc_3', 3)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlecastle_pc_cancel', 0)
	_OPEN_CUSTUM_WIN_FIXED(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SWITCH(@SCWK_ANSWER)
	;TODO exefs needed
	_CASE_JUMP(1, 'ev_d31r0501_pc_single')
	_CASE_JUMP(2, 'ev_d31r0501_pc_double')
	_CASE_JUMP(3, 'ev_d31r0501_pc_multi')
	_EVENT_END()
	_END()
ev_d31r0501_lobby_sd_guide_start:
	;TODO exefs needed for all this. Dialogs are in but everything else is still a placeholder
	;_FTR_SET_CURRENT_FACILITY(4)
	_TALK_OBJ_START()
	;_MACRO_TALK_KEYWAIT('dp_scenario3', 'msg_d31r0501_lobby__1', 'Welcome to the Battle Castle!\rI am your guide to the Single and\nDouble Battle challenges.\rPlease be aware that these challenges\nare designed for a single Trainer.\r')
	_MACRO_TALK_KEYWAIT('dialogue_d31r0501', 'msg_d31r0501_lobby__1', 'Welcome to the Battle Castle!\rI am your guide to the Single and\nDouble Battle challenges.\rPlease be aware that these challenges\nare designed for a single Trainer.')
	_TALK_CLOSE()
	_JUMP('ev_d31r0501_lobby_sd_guide_challenge')
	_END()
ev_d31r0501_lobby_sd_guide_challenge:
	;_MACRO_TALKMSG('dp_scenario3', 'msg_d31r0501_lobby__2', 'Which challenge would you like to take?')
