	_MACRO_TALK_KEYWAIT('dialogue_d31r0501', 'msg_d31r0501_lobby_1_multi_1', 'Welcome to the Battle Castle!\rI am your guide to the Multi Battle\nchallenge.\rPlease be aware that this challenge\nrequires two Trainers.')
