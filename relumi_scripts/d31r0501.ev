	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_frontier_lobby_option_1', 1); Single Battle
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_frontier_lobby_option_2', 2); Double Battle
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_frontier_lobby_option_3', 3); Info
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_frontier_lobby_cancel', 0); Cancel
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'ev_d31r0501_lobby_select_poke')
	_CASE_JUMP(3, 'ev_d31r0501_lobby_info')
	;_MACRO_TALK_KEYWAIT('dp_scenario3', 'ftr_castle_lobby_dialogue_cancel', 'We hope to see you again!')
	_MACRO_TALK_KEYWAIT('dialogue_d31r0501', 'ftr_castle_lobby_dialogue_cancel', 'We hope to see you again!')
	_TALK_CLOSE()
	; _CASE_JUMP(1, xxx)
	; _CASE_JUMP(2, xxx)
	_TALK_OBJ_END()
	_END()
ev_d31r0501_lobby_info:
	;_MACRO_TALK_KEYWAIT('dp_scenario3', 'ev_d31r0501_lobby_dialogue_info', 'At the Battle Castle, you may take a\nSingle or Double Battle challenge.\rHere, you are provided with Castle\nPoints (CP) that you must manage.\rThe CP are used for healing Pokémon,\nrenting items or Berries, and so on.\rCP are earned by winning matches.\nThe amount varies by how you win.\rThe objective is to keep a winning\nstreak alive while managing your CP.\rIf you manage to win seven matches in\na row, you will earn Battle Points (BP).\rIf you want to interrupt your\nchallenge, please save the game.\rIf you don’t save, you will be\ndisqualified from your challenge.\rPlease be aware of that!')
	_MACRO_TALK_KEYWAIT('dialogue_d31r0501', 'ev_d31r0501_lobby_dialogue_info', 'At the Battle Castle, you may take a\nSingle or Double Battle challenge.\rHere, you are provided with Castle\nPoints (CP) that you must manage.\rThe CP are used for healing Pokémon,\nrenting items or Berries, and so on.\rCP are earned by winning matches.\nThe amount varies by how you win.\rThe objective is to keep a winning\nstreak alive while managing your CP.\rIf you manage to win seven matches in\na row, you will earn Battle Points (BP).\rIf you want to interrupt your\nchallenge, please save the game.\rIf you don’t save, you will be\ndisqualified from your challenge.\rPlease be aware of that!')
	_JUMP('ev_d31r0501_lobby_sd_guide_challenge')
	_END()
