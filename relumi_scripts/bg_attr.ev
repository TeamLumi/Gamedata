ev_little_rack1:
	_MACRO_EASY_OBJ_MSG('dialogue_bg_attr', '68-bg_msg_book1_01', 'It’s lined with colorful binders.')
	_END()
ev_rack1:
	_MACRO_EASY_OBJ_MSG('dialogue_bg_attr', '68-bg_msg_bookrack1_01', 'It’s chock-full of Pokémon books and\nphoto collections.')
	_END()
ev_rack2:
	_MACRO_EASY_OBJ_MSG('dialogue_bg_attr', '68-bg_msg_bookrack2_01', 'Pokémon magazines!\rPokémon Pal... Pokémon Handbook...\nAdorable Pokémon...')
	_END()
ev_trash_box:
	_MACRO_EASY_OBJ_MSG('dialogue_bg_attr', '68-bg_msg_scrap_01', 'The trash can is empty.')
	_END()
ev_shop_rack1:
	_MACRO_EASY_OBJ_MSG('dialogue_bg_attr', '68-bg_msg_shoprack1_01', 'The shelves are jammed with colorful\nPokémon goods.')
	_END()
ev_tmap_bg:
	_TALK_START()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_DEBUG_PRINT(1)
	_TMAP_BG_SET_PROC()
	_DEBUG_PRINT(2)
	_DEBUG_PRINT(3)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_FINISH_MAP_PROC()
	_TALK_END()
	_END()