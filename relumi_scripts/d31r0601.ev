	;_MACRO_TALKMSG('dp_scenario3', 'msg_d31r0601_woman2_01', 'The Brain has a peculiar fashion sense.\nShe flits around oddly, too.\rKind of like this.\nA little bump, a wiggle...\r...Please don’t look at me that way.\nIt’s not nice.')
