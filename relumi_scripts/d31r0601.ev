	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlearcade_pc_3', 3)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlearcade_pc_cancel', 0)
