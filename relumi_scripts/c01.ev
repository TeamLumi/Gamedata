	_AC_DIR_U(8)
	_ACMD_END()
ev_c01_crown1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C01_CROWN1_TICKET, 'ev_c01_crown1_ticket_get')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown1_01', 'Hi! I’m a Pokétch campaign clown!\nLet’s “rollout” my question!\rDoes a Pokémon grow by defeating others and\ngaining Exp. Points?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_crown1_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_crown1_01_no')
	_END()
ev_c01_crown1_01_yes:
	_SE_PLAY('S_PINPON')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown1_02', 'Ding-ding!\nYou’re absolutely correct!')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown1_04', 'Pokémon grow stronger by defeating other\nPokémon in battle.\rSome Pokémon even change into a different\nPokémon through a process known as Evolution.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown1_05', 'Here you go! Your Pokétch Coupon!')
	_LDVAL(@SCWK_TEMP0, 460)
	_LDVAL(@SCWK_TEMP1, 1)
	_FLAG_SET(#FE_C01_CROWN1_TICKET)
	_CALL('ev_item_event')
	_CALL('ev_c01_poketch_ticket_count')
	_CALL('ev_c01_ticket_check')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown1_01_no:
	_SE_PLAY('S_BOO')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown1_03', 'Bzzzzt!\nThat’s the wrong answer...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown1_ticket_get:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown1_06', 'Pokémon grow stronger through battling.\rSome Pokémon even change into a different\nPokémon through a process known as Evolution.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown2:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C01_CROWN2_TICKET, 'ev_c01_crown2_ticket_get')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown2_01', 'Hi! I’m a Pokétch campaign clown!\nLet’s “rollout” my question!\rJust like Pokémon, do the moves of Pokémon\nalso have types?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_crown2_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_crown2_01_no')
	_END()
ev_c01_crown2_01_yes:
	_SE_PLAY('S_PINPON')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown2_02', 'Ding-ding!\nYou’re absolutely correct!')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown2_04', 'If a Pokémon’s type matches the type of a move\nit uses, that move is made much more powerful!')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown2_05', 'Here you go! Your Pokétch Coupon!')
	_LDVAL(@SCWK_TEMP0, 461)
	_LDVAL(@SCWK_TEMP1, 1)
	_FLAG_SET(#FE_C01_CROWN2_TICKET)
	_CALL('ev_item_event')
	_CALL('ev_c01_poketch_ticket_count')
	_CALL('ev_c01_ticket_check')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown2_01_no:
	_SE_PLAY('S_BOO')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown2_03', 'Bzzzzt!\nThat’s the wrong answer...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown2_ticket_get:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown2_06', 'If a Pokémon’s type matches the type of a move\nit uses, that move is made much more powerful!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown3:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_C01_RIVAL, 'LT', 2, 'ev_c01_crown3_before')
	_IF_FLAGON_JUMP(#FE_C01_CROWN3_TICKET, 'ev_c01_crown3_ticket_get')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_01', 'Hi! I’m a Pokétch campaign clown!\nLet’s “rollout” my question!\rCan a Pokémon hold an item?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_crown3_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_crown3_01_no')
	_END()
ev_c01_crown3_01_yes:
	_SE_PLAY('S_PINPON')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_02', 'Ding-ding!\nYou’re absolutely correct!')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_04_1', 'A Pokémon may hold a single item.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_04_2', 'Some items become effective as soon as they are\nheld by a Pokémon.\rBerries are eaten by Pokémon as necessary\nduring battle.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_05', 'Here you go! Your Pokétch Coupon!')
	_OBJ_POS_CHANGE('C01_POKETCH', 174, 2, 771, 1)
	_LDVAL(@SCWK_TEMP0, 462)
	_LDVAL(@SCWK_TEMP1, 1)
	_FLAG_SET(#FE_C01_CROWN3_TICKET)
	_CALL('ev_item_event')
	_CALL('ev_c01_poketch_ticket_count')
	_CALL('ev_c01_ticket_check')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown3_01_no:
	_SE_PLAY('S_BOO')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_03', 'Bzzzzt!\nThat’s the wrong answer...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown3_ticket_get:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_07_1', 'A Pokémon may hold a single item.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_07_2', 'Some items become effective as soon as they are\nheld by a Pokémon.\rBerries are eaten by Pokémon as necessary\nduring battle.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_crown3_before:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_crown_06', 'Hi there. You should stick around.\nWe’re doing a Pokétch campaign soon.\rBefore it starts, I think you should brush up\nat the Trainers’ School.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_poketch_ticket_all_get_announce:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2500)
	_RET()
ev_c01_ticket_check:
	_IF_FLAGOFF_JUMP(#FE_C01_CROWN1_TICKET, 'ev_c01_ticket_no_3')
	_IF_FLAGOFF_JUMP(#FE_C01_CROWN2_TICKET, 'ev_c01_ticket_no_3')
	_IF_FLAGOFF_JUMP(#FE_C01_CROWN3_TICKET, 'ev_c01_ticket_no_3')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2500)
	_RET()
ev_c01_ticket_no_3:
	_RET()
ev_c01_boy1_a:
	_MACRO_EASY_OBJ_MSG('dialogue_c01', '27-msg_c01_boy1_a_01', 'I’m trading Pokémon with my buddy!')
	_END()
ev_c01_boy1_b:
	_MACRO_EASY_OBJ_MSG('dialogue_c01', '27-msg_c01_boy1_b_01', 'I gave my Pokémon an item to hold before\ntrading it.\rThat will make the other Trainer double happy!')
	_END()
ev_c01_woman3_iro:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_C01, 'EQ', 4, 'ev_c01_woman3_seen2')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_woman3_iro_01', 'I went to the Trainers’ School around here.\nStudy there, and you may come out stronger.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_woman3_seen2:
	_IF_FLAGON_JUMP(#FE_C01_SEAL_GET1, 'ev_c01_woman3_seen3')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_woman3_iro_02', 'Oh! You know about Capsule Decoration, too?\rAs a Trainer who studied in the Trainers’ School,\nI’ll give these to you.')
	_LDVAL(@SCWK_TEMP0, 36)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_SET_SYS_FLAG($SYS_FLAG_MIZUKI)
	_FLAG_SET(#FE_C01_SEAL_GET1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_woman3_seen3:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_woman3_iro_03', 'Yes, yes. You do look a bit stronger.\rKeep working toward that dream of becoming\nan Ace Trainer!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_woman1_iro:
	_MACRO_EASY_OBJ_MSG('dialogue_c01', '27-msg_c01_woman1_iro_01', 'The GWS connects people all over the world.\rI told that to my Budew, and now it looks\nso happy!')
	_END()
ev_c01_korinku:
	_EASY_VOICE_MSG('dialogue_c01%27-msg_c01_korinku', 'PLAY_PV_EV_403_00_00')
	_END()
ev_c01_subomi:
	_EASY_VOICE_MSG('dialogue_c01%27-msg_c01_subomi', 'PLAY_PV_EV_406_00_00')
	_END()
ev_c01_aroma1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C01_BIRTHDAY, 'ev_c01_aroma1_end')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_01', 'It’s another great day for fortune-telling, Budew!\rI’m a fortune-teller who can read the future in\nthe shape of Budew’s bud.\rWould you like to have your fortune told?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_aroma1_yes1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_aroma1_not1')
	_END()
ev_c01_aroma1_yes1:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_02', 'To begin, could you please tell me the month\nyou were born in?')
	_TALK_CLOSE()
	_BIRTH_MOUNTH_INPUT(@WK_PLAYER_BIRTH_MOUNTH)
	_IFVAL_JUMP(@WK_PLAYER_BIRTH_MOUNTH, 'EQ', 0, 'ev_c01_aroma1_not2')
	_LDVAL(@WK_PLAYER_BIRTH_DAY, @WK_PLAYER_BIRTH_MOUNTH)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_03', 'I see...\rAnd next, what day you were born on?')
	_TALK_CLOSE()
	_BIRTH_DAY_INPUT(@WK_PLAYER_BIRTH_DAY)
	_IFVAL_JUMP(@WK_PLAYER_BIRTH_DAY, 'EQ', 0, 'ev_c01_aroma1_not2')
	_NUMBER_NAME(0, @WK_PLAYER_BIRTH_MOUNTH)
	_NUMBER_NAME(1, @WK_PLAYER_BIRTH_DAY)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_04', 'I see...\rSo your birthday is {0,2,1,0}/{1,2,1,0}, yes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_aroma1_yes2')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_aroma1_another')
	_END()
ev_c01_aroma1_yes2:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_06', 'Now then, Budew, let me have a little look at\nyour bud...\rThe fortune for someone born on {0,2,1,0}/{1,2,1,0} is...\rHmm, I see...\nSuch distinctive swirls...\fAnd the petals are just barely visible...\fTwitching like it might bloom at any second...\fRight, then your fortune should be...\fvery happy!\rYour flowery future will burst into bloom,\nwrapping you in its joyful fragrance.\rIf you continue to blossom just as you are now,\nsomething good is sure to come your way!')
	_FLAG_SET(#FE_C01_BIRTHDAY)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_aroma1_another:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_05', 'Oh dear... It’s not?\rPerhaps you accidentally told me a loved one’s\nbirthday instead?\rPlease tell me your own birthday.')
	_JUMP('ev_c01_aroma1_yes1')
	_END()
ev_c01_aroma1_not1:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_07', 'All right. Let me know if you change your mind.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_aroma1_not2:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_08', 'You’d rather not, after all? Well then, just let me\nknow if you change your mind.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_aroma1_end:
	_NUMBER_NAME(0, @WK_PLAYER_BIRTH_MOUNTH)
	_NUMBER_NAME(1, @WK_PLAYER_BIRTH_DAY)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_aroma1_09', 'You’d like your fortune told again?\rGiven your birthday of {0,2,1,0}/{1,2,1,0}...\rAha! Today’s fortune is once again a happy one!\rPlease enjoy your fresh and floral day!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
