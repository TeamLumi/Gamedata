	_AC_UP(18, 8)
	_ACMD_END()
ev_c01_sunglasses:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_sunglasses_02')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_sunglasses_01', 'Jubilife City is built on land carved out of a\nmountain. The people and Pokémon of\fOreburgh City helped out with that undertaking.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_sunglasses_02:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_sunglasses_02_1', 'Hello! Let me ask you, have you paid a visit to\nthe TV station?\rIf you’ve never been, you owe it to yourself to\nmake the trip.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_sunglasses_02_2', 'And, if you’ve been there before, it never hurts\nto visit again.\rAfter all, you can be a star!\nOr at least dream of being one!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_shopm:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_shopwoman_02_1', 'Just past here is the GWS, which stands for\nGlobal Wonder Station.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_shopwoman_02_2', 'Trading Pokémon means connecting with friends,\nboth old and new. That’s awesome!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_gtc_stopper:
	_EVENT_START()
	_CALL('ev_another_out')
	_OBJ_ANIME('HERO', 'anm_c01_gtc_stopper_amendment')
	_OBJ_ANIME('C01_SHOPM', 'anm_c01_gtc_stopper_01')
	_OBJ_ANIME_WAIT()
	_IF_FLAGOFF_CALL($SYS_FLAG_WILDCARD_001, 'ev_c01_gtc_stopper_c')
	_IF_FLAGON_CALL($SYS_FLAG_WILDCARD_001, 'ev_c01_gtc_stopper_s')
	_OBJ_ANIME('C01_SHOPM', 'anm_c01_gtc_stopper_11')
	_OBJ_ANIME('HERO', 'anm_c01_gtc_stopper_player_01')
	_OBJ_ANIME_WAIT()
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
ev_c01_gtc_stopper_c:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_shopwoman_03', 'I’m so sorry. The GWS isn’t ready yet.')
	_TALK_CLOSE()
	_RET()
ev_c01_gtc_stopper_s:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_shopwoman_01_1', 'Just past here is the GWS, which stands for\nGlobal Wonder Station.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_shopwoman_01_2', 'Oh, you don’t have any Gym Badges.\rThe GWS is off-limits if you haven’t earned a\nGym Badge yet. Sorry!')
	_TALK_CLOSE()
	_RET()
anm_c01_gtc_stopper_amendment:
	_AC_WAIT(45)
	_AC_DIR_L(8)
	_ACMD_END()
anm_c01_gtc_stopper_01:
	_AC_MARK_GYOE()
	_AC_DIR_D(4)
	_AC_HERO_MATCH_Z(8)
	_AC_DIR_R(8)
	_ACMD_END()
anm_c01_gtc_stopper_11:
	_AC_RIGHT(1, 8)
	_AC_WAIT(8)
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_WORLD_Z(778, 8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_c01_gtc_stopper_player_01:
	_AC_RIGHT(1, 8)
	_ACMD_END()
