ev_c01_poketch_sp:
	_EVENT_START()
	_FLAG_SET(#FH_10)
	_OBJ_ANIME('C01_POKETCH', 'anm_c01_poketch_99')
	_OBJ_ANIME('HERO', 'anm_c01_player_99')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 172, 'pos_c01_poketch_01_01')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 173, 'pos_c01_poketch_01_02')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 174, 'pos_c01_poketch_01_03')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 175, 'pos_c01_poketch_01_04')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 176, 'pos_c01_poketch_01_05')
	_EVENT_CAMERA_INDEX(922)
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_poketch_01_01', 'Oh, oh, oh?\rYou call yourself a Pokémon Trainer?\nAnd yet you have no Pokétch?\rThat is, Pokémon Watch, or Pokétch for short!\rOh my, you are a rare case indeed!\nWell, this simply cannot do!\rHere, a Pokétch for you!\nWe’ve even partnered with a foreign company\fto add compatibility with the Pokémon Rotom!\rSo I guess the full, official name is...\nThe Rotom Pokétch!')
	_TALK_CLOSE()
	_GET_POKETCH()
	_LDVAL(@WK_SCENE_C01_RIVAL, 2)
	_LDVAL(@462, 1)
	_FLAG_SET(#FV_C01_ASSISTANTM)
	_OBJ_DEL('C01_ASSISTANTM')
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_poketch_01_02', '{0} received a Pokétch!')
	_ME_WAIT()
	_LDVAL(@SCWK_TEMP0, 2)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 5)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 6)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 7)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 8)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 9)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 10)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 11)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 12)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 13)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 14)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 15)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 16)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 17)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 18)
	_CALL('ev_poketch_app_get')
	_LDVAL(@SCWK_TEMP0, 19)
	_CALL('ev_poketch_app_get')
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_poketch_01_03', 'You’re a lucky one today!\nThat Pokétch has every app installed!\rTouch the Pokétch screen and find the\napps that are right for you!')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(12, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2462); Rotom Pokétch Chapter
	_IF_FLAGON_CALL(#FH_10, 'ev_c01_poketch_camera_end')
	_GET_REL_POS_HERO('C01_POKETCH', @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(150)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 8, 'ev_c01_poketch_dir_down')
	_JUMP('ev_c01_poketch_dir_up')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2200)
	_FLAG_SET(#2711); Got the Poketch apps
	_TALK_END()
	_END()
