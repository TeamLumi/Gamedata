ev_c01_flag_change:
	_IFVAL_CALL(@WK_SCENE_C01, 'GE', 3, 'ev_c01_flag_change_support_01')
	_SXY_EXIT_POS_CHANGE(4, -100000, -100000)
	_IF_FLAGON_CALL($SYS_FLAG_WILDCARD_001, 'ev_c01_flag_change_v')
	_GET_MY_SEX(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c01_male_flag_change_01')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_c01_female_flag_change_01')
	_END()
ev_c01_flag_change_support_01:
	_IFVAL_CALL(@SCWK_REG2, 'NE', 175, 'ev_c01_flag_change_support_p01')
	_IFVAL_CALL(@SCWK_REG2, 'EQ', 175, 'ev_c01_flag_change_support_p02')
	_RET()
ev_c01_flag_change_support_p01:
	_SXY_POS_CHANGE('C01_SUPPORT', 176, 739)
	_OBJ_DIR_CHANGE('C01_SUPPORT', 90)
	_SXY_MV_CHANGE('C01_SUPPORT', 'MV_LEFT')
	_RET()
ev_c01_flag_change_support_p02:
	_SXY_POS_CHANGE('C01_SUPPORT', 175, 739)
	_OBJ_DIR_CHANGE('C01_SUPPORT', 90)
	_SXY_MV_CHANGE('C01_SUPPORT', 'MV_LEFT')
	_JUMP('ev_c01_male_flag_change_01')
ev_c01_male_flag_change_01:
	_LDVAL(@OBJCHRWORK0, 'HEROINE')
	_END()
ev_c01_female_flag_change_01:
	_LDVAL(@OBJCHRWORK0, 'HERO')
	_END()
ev_c01_flag_change_v:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c01_flag_change_s')
	_RET()
ev_c01_flag_change_s:
	_IF_FLAGON_JUMP($BADGE_ID_C03, 'ev_c01_flag_change_t')
	_RET()
ev_c01_flag_change_t:
	_LDVAL(@WK_SCENE_C01_GTC, 1)
	_SXY_EXIT_POS_CHANGE(4, 149, 779)
	_RET()
ev_d02_door_bg_move:
	_DOOR_ENABLE_SET('D02R0101_D01', 1)
	_RET()
ev_d02_door_exit_move:
	_DOOR_ENABLE_SET('D02R0101_D01', 0)
	_RET()
pos_c01_support:; Start Jubilife Ayou First Interaction
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CALL('ev_another_out_door')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_POS_CHANGE_WORLD('HERO', 174, 2, 796)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_ANIME('HERO', 'anm_c01_support_face05')
	_EVENT_CAMERA_INDEX(570)
	_JUMP('ev_c01_ayou_start')
	_END()
ev_c01_ayou_start:
	_GET_COSTUME(@SCWK_TEMP0); Assigns the Current costume to TEMP0
	_GET_COSTUME_GENDER(@SCWK_TEMP0, @SCWK_TEMP1); Takes TEMP0 and checks the index and assigns TEMP1 to 0 if male and 1 if female
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 0, 'ev_c01_ayou_rei_enter')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 1, 'ev_c01_ayou_akari_enter')
	_END()
ev_c01_ayou_akari_enter:
	_OBJ_ADD('C01_AYOU_AKARI')
	_FLAG_RESET(#2918)
	_OBJ_DEL('C01_AYOU_REI')
	_FLAG_SET(#2919)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('C01_AYOU_AKARI', 'anm_c01_ayou_0')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C01_AYOU_AKARI', 'anm_c01_ayou_0_ex')
	_OBJ_ANIME_WAIT()
	_CALL('ev_ayou_theme_play')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C01_AYOU_AKARI', 'anm_c01_ayou_talking_ex')
	_CALL('ev_c01_ayou_give_hisui_prize')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C01_AYOU_AKARI', 'anm_c01_ayou_1_ex')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_MSG_c01_ayou_done', 'Whoops, looks like I’ve gotta go.\nI’m sure we’ll meet again.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(571)
	_OBJ_ANIME('HERO', 'anm_c01_ayou_watch_leave')
	_OBJ_ANIME('C01_AYOU_AKARI', 'anm_c01_ayou_02')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C01_AYOU_AKARI')
	_CALL('ev_character_theme_stop')
	_JUMP('pos_c01_support_01_common')
ev_c01_ayou_rei_enter:
	_OBJ_ADD('C01_AYOU_REI')
	_FLAG_RESET(#2919)
	_OBJ_DEL('C01_AYOU_AKARI')
	_FLAG_SET(#2918)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_ayou_0')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_ayou_0_ex')
	_OBJ_ANIME_WAIT()
	_CALL('ev_ayou_theme_play')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_ayou_talking_ex')
	_CALL('ev_c01_ayou_give_hisui_prize')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_ayou_1_ex')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_MSG_c01_ayou_done', 'Whoops, looks like I’ve gotta go.\nI’m sure we’ll meet again.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c01_ayou_watch_leave')
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_ayou_02')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C01_AYOU_REI')
	_CALL('ev_character_theme_stop')
	_JUMP('pos_c01_support_01_common')
ev_c01_ayou_give_hisui_prize:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_ayou_first_message', 'I’ve really missed this kind of scenery.\nIt’s very nostalgic.')
	_GET_COSTUME(@SCWK_TEMP0); Assigns the Current costume to TEMP0
	_GET_COSTUME_GENDER(@SCWK_TEMP0, @SCWK_TEMP1); Takes TEMP0 and checks the index and assigns TEMP1 to 0 if male and 1 if female
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 0, 'ev_c01_ayou_give_hisui_prize_rei_face_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 1, 'ev_c01_ayou_give_hisui_prize_akari_face_1')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_ayou_second_message', '...\rApologies, I really can’t afford to\nstick around here reminiscing.')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_c01_ayou_give_hisui_prize_no_tray_space'); Party and Boxes are full
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_ayou_pokemon_list', 'Please, take this.')
	_MACRO_TALK_KEYWAIT('dialogue_c01', '00_msg_c01_ayou_pokemon_obtain', 'Something about this Poké Ball-shaped\nrelic resonates with you.\rInside, you feel as if this Pokémon is...')
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Voltorb', 'Round and excited (Voltorb)', 0)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Growlithe', 'Fluffy and loyal (Growlithe)', 1)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Sneasel', 'Tricky and smug (Sneasel)', 2)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Qwilfish', 'Prickly and strong (Qwilfish)', 3)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Basculin', 'Reckless and fast (Basculin)', 4)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Zorua', 'Nimble and sly (Zorua)', 5)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ayou_prize_voltorb_hisui')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_ayou_prize_growlithe_hisui')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c01_ayou_prize_sneasel_hisui')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_c01_ayou_prize_qwilfish_hisui')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_c01_ayou_prize_basculin_white')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 5, 'ev_c01_ayou_prize_zorua_hisui')
	_END()
ev_c01_ayou_give_hisui_prize_rei_face_1:
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_support_face00')
	_OBJ_ANIME_WAIT()
	_RET()
