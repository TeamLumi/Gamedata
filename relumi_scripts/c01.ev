	_AC_DIR_U(8)
	_AC_UP(11, 8)
	_ACMD_END()
anm_c01_player_10:
	_AC_WAIT(16)
	_AC_DIR_L(8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_c01_player_11:
