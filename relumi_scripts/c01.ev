ev_c01_ayou_give_hisui_prize_no_tray_space:
	_TALK_CLOSE()
	_GET_COSTUME(@SCWK_TEMP0); Assigns the Current costume to TEMP0
	_GET_COSTUME_GENDER(@SCWK_TEMP0, @SCWK_TEMP1); Takes TEMP0 and checks the index and assigns TEMP1 to 0 if male and 1 if female
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 0, 'ev_c01_ayou_rei_emote')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 1, 'ev_c01_ayou_akari_emote')
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ayou_give_hisui_prize_no_tray_space', 'What?! I was going to give you a gift but\nyou’ve already filled up your Pokémon Boxes?!\r...\nAm I in the right timeline?')
	_TALK_CLOSE()
	_RET()
ev_c01_ayou_akari_emote:
	_OBJ_ANIME('C01_AYOU_AKARI', 'anm_c01_ayou_0_ex')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c01_ayou_rei_emote:
	_OBJ_ANIME('C01_AYOU_REI', 'anm_c01_ayou_0_ex')
	_OBJ_ANIME_WAIT()
	_RET()
pos_c01_support_01_common:
	_SXY_POS_CHANGE('C01_SUPPORT', 174, 788); Spawn Assistant
	_TIME_WAIT(10, @SCWK_ANSWER)
	_FLAG_RESET(#FV_C01_SUPPORT)
	_OBJ_ADD('C01_SUPPORT')
	_OBJ_PAUSE('C01_SUPPORT')
	_OBJ_PAUSE_ALL()
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_0')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_support_male_01')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_support_female_01')
	_END()
ev_c01_support_male_01:
	_PLAYER_NAME(0)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face01')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_00', 'Hi, {0,1,0,0}!\nWho were you talking to just now?', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c01_hero_shocked')
	_OBJ_ANIME_WAIT()
	_CALL('ev_the_boy_girl_play')
	_EVENT_CAMERA_INDEX(572)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_sad_face')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_01_1', 'Oh, I’m sorry.\nI didn’t mean to sneak up on you.')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_01_2', 'Anyways, how many Pokémon have you\ncaught?')
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_NUMBER_NAME(0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 4, 'ev_c01_support_male_01_num_4_6')
	_IFVAL_CALL(@SCWK_ANSWER, 'LE', 3, 'ev_c01_support_male_01_num_1_3')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_support_male_ayou_ball', 'Oh, what’s that? What an interesting looking\nPoké Ball. Do you know much about it?')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_support_001', 'Hey, that’s right! If you’re curious about Pokémon,\nthere’s this great place for that.\rCome on! It’s all right.\nFollow me!')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face00')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c01_01_support_common_01')
	_END()
ev_c01_support_male_01_num_4_6:
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face05')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_02', 'Wow! You’ve already got {0,2,0,0} Pokémon with you!\rAt that pace, your Pokédex should be full in no\ntime at all!', 1)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face00')
	_RET()
ev_c01_support_male_01_num_1_3:
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face00')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_03', 'Um...\rI think you’d feel a lot safer if you were to catch\nsome more.', 1)
	_RET()
ev_c01_support_female_01:
	_PLAYER_NAME(0)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face01')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_00', 'Hey, {0,1,0,0}!\nWho was that?', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c01_hero_shocked')
	_OBJ_ANIME_WAIT()
	_CALL('ev_the_boy_girl_play')
	_EVENT_CAMERA_INDEX(572)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_sad_face')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_01_1', 'Whoops, sorry.\nI didn’t mean to startle you.')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_01_2', 'Anyway, are you catching lots of Pokémon?')
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_NUMBER_NAME(0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 4, 'ev_c01_support_female_01_num_4_6')
	_IFVAL_CALL(@SCWK_ANSWER, 'LE', 3, 'ev_c01_support_female_01_num_1_3')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_support_female_ayou_ball', 'Oh, what’s that? What an interesting looking\nPoké Ball. Do you know much about it?')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_support_002', 'Hey, that’s right! If you’re curious about Pokémon,\nthere’s this great place for that.\rCome on! It’s all right.\nFollow me!')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_face00')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c01_01_support_common_01')
	_END()
ev_c01_support_female_01_num_4_6:
