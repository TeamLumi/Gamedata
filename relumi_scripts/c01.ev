	_TALK_OBJ_END()
	_END()
pos_c01_doctor:
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 173.626007, 2, 742.969971)
	_OBJ_POS_CHANGE_WORLD('C01_GINGA_01', 173.199997, 2, 739)
	_OBJ_POS_CHANGE_WORLD('C01_GINGA_02', 173.199997, 2, 740)
	_OBJ_POS_CHANGE_WORLD('C01_DOCTOR', 174.669998, 2, 740)
	_OBJ_POS_CHANGE_WORLD('C01_SUPPORT', 175.669998, 2, 739)
	_EVENT_CAMERA_INDEX(250)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_doctor_01_amendment')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c01_doctor_01_02')
	_END()
anm_c01_doctor_01_amendment:
	_AC_DIR_U(8)
	_ACMD_END()
pos_c01_doctor_01_01:
	_OBJ_ANIME('C01_DOCTOR', 'anm_c01_doctor_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_player_60')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c01_doctor_01_common')
	_END()
pos_c01_doctor_01_02:
	_OBJ_ANIME('C01_DOCTOR', 'anm_c01_doctor_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_player_61')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c01_doctor_01_common')
	_END()
pos_c01_doctor_01_03:
	_OBJ_ANIME('C01_DOCTOR', 'anm_c01_doctor_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_player_62')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c01_doctor_01_common')
	_END()
pos_c01_doctor_01_common:
	_PLAYER_NAME(0)
	_SUPPORT_NAME(1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_doctor_01', 'Ah, {0,1,0,0}.\nImpeccable timing, as always.\rThese miscreants are babbling utter nonsense\nthat I just can’t stomach.\rShow them some manners, if you will.', 0, 1)
	_OBJ_ANIME('C01_GINGA_01', 'anm_c01_ginga_01')
	_OBJ_ANIME('C01_DOCTOR', 'anm_c01_doctor_10')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(251)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_gingam_01_1', 'Oh, Professor, must you be so difficult?\nWe are approaching you strictly as businessmen.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_gingam_01_2', 'All you must do is provide us with all your\nresearch findings.\rIn return, we’ll see to it that your assistant\ndoesn’t become collateral damage.', 1)
	_CHARA_LOOK_LOCK('C01_SUPPORT', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C01_DOCTOR')
	_EVENT_CAMERA_INDEX(252)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c01_support_male_10')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c01_support_female_10')
	_END()
c01_support_male_10:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_05', '{1,1,0,0}, let’s battle together and\nteach these losers a lesson!', 1)
	_JUMP('pos_c01_gingakanbu')
	_END()
c01_support_female_10:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_05', '{1,1,0,0}, let’s battle together and\nteach these losers a lesson!', 1)
	_JUMP('pos_c01_gingakanbu')
	_END()
pos_c01_gingakanbu:
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('C01_SUPPORT')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_40')
	_OBJ_ANIME_WAIT()
	_LDVAL(@SCWK_REG2, 175)
	_EVENT_CAMERA_INDEX(50)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 3400)
	_LDVAL(@SCWK_TEMP1, 317)
	_LDVAL(@SCWK_TEMP2, 318)
	_CALL('ev_c01_get_support_id'); Updated to use SCWK_TEMP3
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_multi_battle'); Sets the IDs for SCWK_TEMP1, SCWK_TEMP2, and SCWK_TEMP3
	_TRAINER_MULTI_BTL_SET(@SCWK_TEMP3, @SCWK_TEMP1, @SCWK_TEMP2)
	_OBJ_ANIME('C01_GINGA_02', 'anm_c01_ginga_22')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_gingam_02', 'You leave us no option. We will retreat for now.\rBecause Team Galactic is benevolent to all,\nwe shall leave.')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_GINGA_01', 'anm_c01_ginga_11')
	_OBJ_ANIME('C01_GINGA_02', 'anm_c01_ginga_12')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C01_GINGA_01')
	_OBJ_DEL('C01_GINGA_02')
	_FLAG_SET(#FV_C01_GINGA)
	_OBJ_ANIME('C01_DOCTOR', 'anm_c01_doctor_51')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_51')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C01_DOCTOR', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C01_DOCTOR')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_doctor_02_1', 'So...\nThey call themselves Team Galactic, do they?\rWhen Pokémon evolve, they seem to release\nsome sort of energy.', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_doctor_02_2', 'I believe it’s a mystic power far beyond our\ncontrol. But Team Galactic seems to be trying\fto harness that power for something...', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_doctor_02_3', 'Anyway, {0,1,0,0}, well done!\nYou battle quite capably.', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_doctor_02_4', 'Seeing you Trainers battle side by side with\nyour Pokémon only makes me more confident\fin my decision to entrust you with a Pokédex!', 1)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_41')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('C01_DOCTOR')
	_CHARA_LOOK_RELEASE('HERO')
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'sub_c01_support_male_50')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'sub_c01_support_female_50')
	_END()
ev_c01_get_support_id:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_dawn_support_id')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_lucas_support_id')
	_END()
ev_c01_lucas_support_id:
	_SUPPORT_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 487); Support has Turtwig
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'sub_c01_get_support_id_ret')
	_LDVAL(@SCWK_TEMP3, 488); Support has Chimchar
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'sub_c01_get_support_id_ret')
	_LDVAL(@SCWK_TEMP3, 489); Support has Piplup
	_RET()
ev_c01_dawn_support_id:
	_SUPPORT_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 490); Support has Turtwig
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'sub_c01_get_support_id_ret')
	_LDVAL(@SCWK_TEMP3, 491); Support has Chimchar
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'sub_c01_get_support_id_ret')
	_LDVAL(@SCWK_TEMP3, 492); Support has Piplup
	_RET()
sub_c01_get_support_id_ret:
	_RET()
sub_c01_support_male_50:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_06_1', '{1,1,0,0}, did you know?\rThe professor studies the Evolution of\nPokémon, too.', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_06_2', 'According to his research, 90% of all Pokémon\nare somehow tied to Evolution!\rI guess that means some Pokémon must undergo\nstartling Evolutions.', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_heroine_06_3', 'So, {1,1,0,0}, let’s keep working on our\nPokédex project for the professor!', 1)
	_JUMP('sub_c01_01_support_common_50')
	_END()
sub_c01_support_female_50:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_06_1', '{1,1,0,0}, did you know that the\nprofessor studies the Evolution of Pokémon, too?', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_06_2', 'According to his research, 90% of all Pokémon\nare somehow tied to Evolution!\rI guess that means some unexpected Pokémon\nmust undergo Evolution, too...', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_hero_06_3', 'So, {1,1,0,0}, let’s keep working on our\nPokédex project for the professor!', 1)
	_JUMP('sub_c01_01_support_common_50')
	_END()
sub_c01_01_support_common_50:
	_TALK_CLOSE()
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_80')
	_OBJ_ANIME('C01_DOCTOR', 'anm_c01_doctor_80')
	_OBJ_ANIME('HERO', 'anm_c01_player_80')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c01_doctor_02_common')
	_END()
pos_c01_doctor_02_common:
	_OBJ_DEL('C01_SUPPORT')
	_OBJ_DEL('C01_DOCTOR')
	_FLAG_RESET(#FV_T02R0101_DOCTOR)
	_LDVAL(@WK_SCENE_C01, 4)
	_LDVAL(@WK_SCENE_C03, 3)
	_LDVAL(@SCWK_REG2, 0)
	_OBJ_DEL('C01_CROWN1')
	_OBJ_DEL('C01_CROWN2')
	_OBJ_DEL('C01_CROWN_03')
	_SXY_POS_CHANGE('C01_SUNGLASSES', 175, 750)
	_SXY_MV_CHANGE('C01_SUNGLASSES', 'MV_UP')
	_FLAG_RESET(#FV_C01_SUNGLASSES)
	_OBJ_ADD('C01_SUNGLASSES')
	_OBJ_PAUSE('C01_SUNGLASSES')
	_OBJ_ANIME('C01_SUNGLASSES', 'anm_c01_poketch_80')
	_TIME_WAIT(35, @SCWK_ANSWER)
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'C01_SUNGLASSES')
	_EVENT_CAMERA_INDEX(162)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_FIND_BG_DISABLE(0, 'Offset/C01/P_Object/P_C_001_StreetLights/P_C_001_StreetLight_picup')
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_mizuki_01_1', 'Whoooa, what was that just now?\nThat was amazing!\rThose guys looked awfully scary, but you sure\nshowed ’em!\rWhew, that was like a breath of fresh air!', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_mizuki_01_2', 'Anyway, my name’s Bebe, and I work as a system\nadministrator in Hearthome City east of here.\rHave you been using my super amazing\nportable PC technology?', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_mizuki_01_3', 'Now, as thanks for putting on such a good show,\nI’ll give these Ball Capsules to you!', 1)
	_CALL('ev_c01_assistantm_poketch_get_after_sub')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_mizuki_01_4', 'You can customize your own Capsule Decoration\nby placing Stickers on Ball Capsules.\rPut Stickers on your favorite Pokémon’s Ball\nCapsule, and it’ll look really pretty when it\fbursts open!', 1)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_mizuki_01_5', 'Stickers will also give you an edge in the Super\nContest Shows where I live in Hearthome City,\fso try to collect a bunch!\rAnyway, see ya later!', 1)
	_TALK_CLOSE()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(149)
	_OBJ_ANIME('C01_SUNGLASSES', 'anm_c01_poketch_81')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_FIND_BG_ENABLE(0, 'Offset/C01/P_Object/P_C_001_StreetLights/P_C_001_StreetLight_picup')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_DEL('C01_SUNGLASSES')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 3500)
	_RESET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_TALK_END()
	_END()
ev_c01_assistantm_poketch_get_after_sub:
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_mizuki_01_7', 'You got Ball Capsules!\rNow you can use the <color=#F01E1EFF>Capsule Decoration</color> feature\nfrom the <color=#F01E1EFF>Ball Capsules</color> menu!', 1)
	_ME_WAIT()
	_CB_ITEM_NUM_ADD(35, 3)
	_CB_ITEM_NUM_ADD(40, 3)
	_CB_ITEM_NUM_ADD(32, 3)
	_CB_ITEM_NUM_ADD(28, 3)
	_CB_ITEM_NUM_ADD(3, 3)
	_CB_ITEM_NUM_ADD(43, 3)
	_CB_ITEM_NUM_ADD(13, 3)
	_FLAG_SET(#FE_ACCE_CASE_GET)
	_RET()
imc_data_set_1:; Not called.
