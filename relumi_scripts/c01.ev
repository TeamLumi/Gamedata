ev_c01_ivy_hypertrainer:
	_TALK_OBJ_START()
	_IF_FLAGOFF_CALL(#2574, 'ev_c01_ivy_hypertrainer_greetings')
	_MACRO_TALK_KEYWAIT('dialogue_c01', 'msg_c01_ivy_hypertrainer_1', 'Howdy! Ya interested in my special hyper training?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ivy_hypertrainer_yes')
	_MACRO_TALK_KEYWAIT('dialogue_c01', 'msg_c01_ivy_hypertrainer_2', 'Sounds good.\nLemme know when you’re up for a little workout!'); No
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_ivy_hypertrainer_invalid:
	_MACRO_TALK_KEYWAIT('dialogue_c01', 'msg_c01_ivy_hypertrainer_invalid', 'Changed yer mind? I’ll be here whenever you\ncome back.'); No
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_ivy_hypertrainer_yes:
	_MACRO_TALK_KEYWAIT('dialogue_c01', 'msg_c01_ivy_hypertrainer_yes', 'All righty!\nShow me who we’ll be workin’ with today.')
	_TALK_CLOSE()
	_POKELIST_SET_PROC(2)
	_POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
	_LDVAL(@LOCALWORK1, 1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_c01_ivy_hypertrainer_invalid'); Jumps to this script if nothing selected
	_POKE_TARENT_POW_MAX(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_ivy_hypertrainer_trained'); Jumps to this script if the Pokemon is already Hyper Trained
	_JUMP('ev_c01_ivy_hypertrainer_check_gold_bottlecap')
	_END()
ev_c01_ivy_hypertrainer_trained:
	_NICK_NAME_ALL(1, @SCWK_TEMP0, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_trained', 'Oh! {1} is already so strong, it\ndoesn’t even need any training!')
	_JUMP('ev_c01_ivy_hypertrainer_yes')
ev_c01_ivy_hypertrainer_check_gold_bottlecap:
	_ITEM_CHK(796, 1, @SCWK_ANSWER); Check for Gold Bottlecap
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ivy_hypertrainer_check_bottlecap'); If the player doesn't have a Gold Bottlecap, jumps to check for regular
	_JUMP('ev_c01_ivy_hypertrainer_train')
	_END()
ev_c01_ivy_hypertrainer_check_bottlecap:
	_ITEM_CHK(795, 1, @SCWK_ANSWER); Checks for Bottlecap
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_ivy_hypertrainer_train'); If the player has a Bottlecap, jumps to next script
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_check_bottlecap', 'What’s this?\rSeems ya don’t have any Bottle Caps or\nGold Bottle Caps.'); "You dont have any"
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_ivy_hypertrainer_train:
	_GET_ITEM_COUNT(796, @LOCALWORK0)
	_GET_ITEM_COUNT(795, @LOCALWORK1)
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_train', 'Would ya like to use a Bottle Cap, or a Gold\nBottle Cap?')
	_IFVAL_CALL(@LOCALWORK0, 'NE', 0, 'ev_c01_ivy_hypertrainer_w_gold_bottlecap')
	_IFVAL_CALL(@LOCALWORK1, 'NE', 0, 'ev_c01_ivy_hypertrainer_w_bottlecap')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c01%43-msg_d31r0101_tokkun_08', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(2, 'ev_c01_ivy_hypertrainer_train_gold_bottlecap')
	_CASE_JUMP(1, 'ev_c01_ivy_hypertrainer_train_bottlecap')
	_CASE_JUMP(0, 'ev_c01_ivy_hypertrainer_end')
	_JUMP('ev_c01_ivy_hypertrainer_end')
	_END()
ev_c01_ivy_hypertrainer_w_gold_bottlecap:
	_ITEM_NAME(0, 796, 1)
	_NUMBER_NAME(1, @LOCALWORK0)
	_ADD_CUSTUM_WIN_LABEL('dialogue_c01%43-msg_d31r0101_tokkun_07', 2)
	_RET()
ev_c01_ivy_hypertrainer_w_bottlecap:
	_ITEM_NAME(2, 795, 1)
	_NUMBER_NAME(3, @LOCALWORK1)
	_ADD_CUSTUM_WIN_LABEL('dialogue_c01%43-msg_d31r0101_tokkun_07_1', 1)
	_RET()
ev_c01_ivy_hypertrainer_train_gold_bottlecap:
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_train_gold_bottlecap', 'Ya want me to hype up all of this Pokémon’s\nstats?')
	_TALK_CLOSE()
	_TRAINING_OPEN(@SCWK_TEMP0, @SCWK_TEMP1, 796)
	_TRAINING_OPEN_WAIT(0, 0, 0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ivy_hypertrainer_train')
	_JUMP('ev_c01_ivy_hypertrainer_train_start')
	_END()
ev_c01_ivy_hypertrainer_train_bottlecap:
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_train_bottlecap', 'Which stat should I hype up?')
	_TALK_CLOSE()
	_TRAINING_OPEN(@SCWK_TEMP0, @SCWK_TEMP1, 795)
	_TRAINING_OPEN_WAIT(0, 0, 0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ivy_hypertrainer_train')
	_JUMP('ev_c01_ivy_hypertrainer_train_start')
	_END()
ev_c01_ivy_hypertrainer_train_start:
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_train_start_1', 'The trainin’ starts now!')
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_TALK_CLOSE()
	_PLAY_REPORT_TRAINING()
	_SE_PLAY('S_TRAINING')
	_ME_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_NICK_NAME_ALL(0, @SCWK_TEMP0, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_train_start_2', 'Phew... {0} got stronger from the\nHyper Training!')
	_ITEM_CHK(796, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ivy_hypertrainer_retry_check')
	_JUMP('ev_c01_ivy_hypertrainer_retry')
	_END()
ev_c01_ivy_hypertrainer_retry_check:
	_ITEM_CHK(795, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_ivy_hypertrainer_retry')
	_JUMP('ev_c01_ivy_hypertrainer_end')
	_END()
ev_c01_ivy_hypertrainer_retry:
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_retry', 'Want to keep the hype goin’ with some more\nHyper Training?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_ivy_hypertrainer_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_ivy_hypertrainer_end')
	_END()
ev_c01_ivy_hypertrainer_greetings:
	_MACRO_TALKMSG('dialogue_c01', 'msg_c01_ivy_hypertrainer_greetings_1', 'Howdy there!\rName’s Ivy, honey.')
	_MACRO_TALK_KEYWAIT('dialogue_c01', 'msg_c01_ivy_hypertrainer_greetings_2', 'Ya look like an up-and-coming trainer with a\nbright future ahead of ya!\rSo, let me tell it to ya straight:\rI’m developing a new training regime for\ntrainers like you!\rI’ll pump up your Pokémon to be the best they\ncould ever be, and it don’t even matter how\fmuch you’ve raised ’em before we start.\rAll I need from you... is a few bottlecaps.\rWhy?\rWell, there’s somebody I wanted to make a\npresent for...\rBut that’s not the point!\rOne regular bottlecap and I’ll raise one stat\nfor ya, but a golden one?\rOh boy, I’ll do the whole set at once!\nIf yer interested, just lemme know!')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(10, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2460); IV Judge Chapter
	_FLAG_SET(#2574)
	_RET()
ev_c01_ivy_hypertrainer_end:
	_MACRO_TALK_KEYWAIT('dialogue_c01', 'msg_c01_ivy_hypertrainer_end', 'See ya.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()