	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_assistantm_player_01')
	_OBJ_ANIME('C01_ASSISTANTM', 'anm_c01_assistantm_03')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c01_assistantm_01_common')
