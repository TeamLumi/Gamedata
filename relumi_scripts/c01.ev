ev_c01_poketch:
	_TALK_OBJ_START()
	_LDVAL(@SCWK_TEMP0, 0)
	_CALL('ev_c01_poketch_ticket_count')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 3, 'ev_c01_poketch_ticket_all_get')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_pokecth_03_1', 'The three clowns will each ask you a\nsimple question.')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_pokecth_03_2', 'The questions will all have to do with Pokémon—\nAfter all, a Pokétch is a tool designed for\fdevoted Pokémon Trainers!\rCollect a Coupon from each clown,\nthen come see me, OK?', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_poketch_ticket_count:
	_IF_FLAGON_CALL(#FE_C01_CROWN1_TICKET, 'ev_c01_poketch_ticket_add')
	_IF_FLAGON_CALL(#FE_C01_CROWN2_TICKET, 'ev_c01_poketch_ticket_add')
	_IF_FLAGON_CALL(#FE_C01_CROWN3_TICKET, 'ev_c01_poketch_ticket_add')
	_RET()
ev_c01_poketch_ticket_add:
	_ADD_WK(@SCWK_TEMP0, 1)
	_RET()
ev_c01_poketch_ticket_all_get:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(922)
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_pokecth_04_1', 'OK, let me count your Coupons! I’ll just pull out\nmy Pokétch here and...\rOne...two...three! Bravo! I say, bravo!')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_pokecth_04_2', 'In return for these Coupons, I present you with\nthis Pokémon Watch, or Pokétch for short!')
	_LDVAL(@SCWK_TEMP0, 460)
	_LDVAL(@SCWK_TEMP1, 461)
	_LDVAL(@SCWK_TEMP2, 462)
	_SUB_ITEM(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_SUB_ITEM(@SCWK_TEMP1, 1, @SCWK_ANSWER)
	_SUB_ITEM(@SCWK_TEMP2, 1, @SCWK_ANSWER)
	_GET_POKETCH()
	_LDVAL(@WK_SCENE_C01, 2)
	_POKETCH_ADD(0)
	_POKETCH_ADD(1)
	_POKETCH_ADD(3)
	_POKETCH_ADD(4)
	_POKETCH_ADD(5)
	_POKETCH_ADD(6)
	_POKETCH_ADD(7)
	_POKETCH_ADD(8)
	_POKETCH_ADD(9)
	_POKETCH_ADD(10)
	_POKETCH_ADD(11)
	_POKETCH_ADD(12)
	_POKETCH_ADD(13)
	_POKETCH_ADD(14)
	_POKETCH_ADD(15)
	_POKETCH_ADD(16)
	_POKETCH_ADD(17)
	_POKETCH_ADD(18)
	_POKETCH_ADD(19)
	_POKETCH_ADD(20)
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_pokecth_05', 'You received a <color=#F01E1EFF>Pokétch</color>!')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_pokecth_06', 'You can add apps to your Pokétch to make it\neven more versatile!\rPlease press the R Button and try it out!')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(12, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2462); Rotom Pokétch Chapter
	_GET_REL_POS_HERO('C01_POKETCH', @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(150)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 8, 'ev_c01_poketch_dir_down')
	_JUMP('ev_c01_poketch_dir_up')
	_END()
ev_c01_poketch_dir_up:
	_JUMP('ev_c01_poketch_dir_right')
ev_c01_poketch_dir_left:
	_JUMP('ev_c01_poketch_dir_right')
ev_c01_poketch_dir_right:
	_OBJ_ANIME('C01_POKETCH', 'anm_c01_poketch_11')
	_OBJ_ANIME('HERO', 'anm_c01_player_11')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c01_poketch_dir')
	_END()
ev_c01_poketch_dir_down:
	_OBJ_ANIME('C01_POKETCH', 'anm_c01_poketch_10')
	_OBJ_ANIME('HERO', 'anm_c01_player_10')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c01_poketch_dir')
	_END()
common_c01_poketch_dir:
	_OBJ_DEL('C01_POKETCH')
	_FLAG_SET(#FE_POKETCH_GET)
	_FLAG_RESET(#FV_C01R0101_POKETCH)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2600)
	_TALK_OBJ_END()
	_TALK_END()
	_END()
anm_c01_poketch_10:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(11, 8)
	_ACMD_END()
