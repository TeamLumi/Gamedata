pos_c01_assistantm_01_04:
	_OBJ_ANIME('C01_ASSISTANTM', 'anm_c01_assistantm_00')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_assistantm_player_01')
	_OBJ_ANIME('C01_ASSISTANTM', 'anm_c01_assistantm_04')
