pos_c01_assistantm_01_common:
	_CALL('ev_c01_assistantm_talk')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c01_assistantm_player_30')
	_OBJ_ANIME('C01_ASSISTANTM', 'anm_c01_assistantm_30')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 757, 'pos_c01_assistantm_02_01')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 758, 'pos_c01_assistantm_02_02')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 759, 'pos_c01_assistantm_02_03')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 760, 'pos_c01_assistantm_02_04')
	_END()
ev_c01_assistantm_talk:
	_IF_FLAGOFF_JUMP(#FE_TOWNMAP_GET, 'ev_c01_townmap_nothing')
	_IF_FLAGOFF_JUMP(#FE_POKETCH_GET, 'ev_c01_poketch_nothing')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_lookerblocker_4', 'Ah, it is you! Have no fear.\nThere are no shady characters about.\rIncidentally, have you not obtained\na Gym Badge?\rI believe you receive one for defeating\nthe Gym Leader at a Pokémon Gym?')
	_RET()
ev_c01_lookerblocker_event:
	_TALK_OBJ_START()
	_FLAG_RESET(#2821)
	_OBJ_ADD('C01_LOOKERBLOCKER')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_OBJ_POS_CHANGE_WORLD('C01_LOOKERBLOCKER', 179, 2, @SCWK_TEMP1)
	_OBJ_ANIME('C01_LOOKERBLOCKER', 'anm_c01_lookerblocker_approach_player_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C01_LOOKERBLOCKER', 'anm_c01_lookerblocker_approach_player_02')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_c01_lookerblocker_player_face_left')
	_OBJ_ANIME_WAIT()
	_CALL('ev_c01_lookerblocker_no_poketch')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_LOOKERBLOCKER', 'anm_c01_lookerblocker_leave_player')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C01_LOOKERBLOCKER')
	_FLAG_SET(#2821); Hide Lookerblocker
	_FLAG_SET(#2710); Lookerblocker event is finished.
	_LDVAL(@462, 2)
	_LDVAL(@WK_SCENE_C01, 2)
	_TALK_OBJ_END()
	_END()
ev_c01_lookerblocker_no_poketch:
	_IF_FLAGON_JUMP(#FE_POKETCH_GET, 'ev_c01_lookerblocker_poketch')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_lookerblocker_3', 'Tell me, have you not obtained\na Pokétch?\rIs not a Pokétch free to anyone visiting\nthe city of Jubilife today?')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_LOOKERBLOCKER', 'anm_c01_lookerblocker_check_city')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_lookerblocker_2', 'Anyway, there appears to be no one\nshady in this Jubilife City.\rI shall therefore take my investigation\nelsewhere.\rBut, my friend, I suggest you remain\nvigilant for shady grown-ups!')
	_RET()
ev_c01_lookerblocker_end_talk: ; Possibly useless code?
	_TALK_OBJ_END()
	_END()
ev_c01_lookerblocker_poketch:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_lookerblocker_1', 'Ah, yes. I see that you have obtained\nit, a Pokétch for yourself.\rI myself, a member of the International\nPolice, the fighters of crime around the\fworld, have one also.\rFor it is what all internationally renowned Trainers\nwho partner with their Pokémon must have.\rTake that Pokétch and share your\nknowledge around the world!')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_LOOKERBLOCKER', 'anm_c01_lookerblocker_check_city')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_lookerblocker_2', 'Anyway, there appears to be no one\nshady in this Jubilife City.\rI shall therefore take my investigation\nelsewhere.\rBut, my friend, I suggest you remain\nvigilant for shady grown-ups!')
	_RET()
anm_c01_lookerblocker_approach_player_01:
	_AC_DIR_R(8)
	_AC_RIGHT(2, 8)
	_AC_MARK_GYOE()
	_ACMD_END()
anm_c01_lookerblocker_approach_player_02:
	_AC_RIGHT(6, 4)
	_ACMD_END()
anm_c01_lookerblocker_player_face_left:
