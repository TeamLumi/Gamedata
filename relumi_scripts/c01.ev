ev_c01_01_support_looker_lucas_dialogue_5:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0024', '{0,1,0,0}, here it is.\nIt’s the Trainers’ School.\fThe name says it all!')
	_RET()
ev_c01_01_support_looker_dawn_dialogue_5:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0027', '{0,1,0,0}, here we are.\nThis is the Trainers’ School.\fThe name says it all!')
	_RET()
ev_c01_01_support_looker_lucas_dialogue_6:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0025', 'I saw your friend {1,1,1,0} go in\nearlier.\rHe could still be in there studying.\nOK, bye now!')
	_RET()
ev_c01_01_support_looker_dawn_dialogue_6:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0028', 'Your pal {1,1,1,0} went in earlier.\nHe might still be studying in there.\rOK, see you around!')
	_RET()
ev_c01_01_looker:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_01_support_looker_dawn_dialogue_1')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_01_support_looker_lucas_dialogue_1')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 174.5, 2, 776)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_POS_CHANGE_WORLD('C01_SUPPORT', 173.5, 2, 776)
	_OBJ_DIR_CHANGE('C01_SUPPORT', 180)
	_OBJ_INVISIBLE('C01_OLDMAN1A')
	_OBJ_ANIME('HERO', 'anm_c01_look_right')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_look_right')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(573)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_Looker_047')
	_TIME_WAIT(35, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(574)
	_TIME_WAIT(20, @SCWK_ANSWER)
	_OBJ_ANIME('HERO', 'anm_c01_look_left')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_look_left')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C01_IVY_HYPER_TRAINER', 'anm_c01_ivy_think')
	_TIME_WAIT(4, @SCWK_ANSWER)
	_PLAY_EMO_SE(7)
	_TIME_WAIT(16, @SCWK_ANSWER)
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_Looker_048')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(575)
	_TIME_WAIT(25, @SCWK_ANSWER)
	_OBJ_ANIME('HERO', 'anm_c01_look_forward_left')
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_look_forward_right')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C01_IVY_HYPER_TRAINER', 'anm_c01_look_forward_ivy')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_01_support_looker_dawn_dialogue_2')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_01_support_looker_lucas_dialogue_2')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_Looker_051')
	_OBJ_ANIME_WAIT()
	_CALL('ev_looker_play')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0012', 'WHAAAT?!')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0013', '...How did you know?\rHow did you unmask me as a member of\nthe International Police?!')
	_TALK_CLOSE()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_01_support_looker_dawn_dialogue_3')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_01_support_looker_lucas_dialogue_3')
	_TALK_CLOSE()
	_OBJ_INVISIBLE('HERO')
	_OBJ_INVISIBLE('C01_SUPPORT')
	_EVENT_CAMERA_INDEX(576)
	_OBJ_VISIBLE('C01_OLDMAN1A')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C01_LOOKER', 1)
	_AC_ANIM_LOCK('C01_LOOKER')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_looker_think')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0016', '...Heh. You claim you were\nonly making conversation, do you?\rBut, I know better not to believe that.\nNo, no, no.\rYou recognized right away that I was\nsomeone extraordinary.\rThat is why you spoke to me, is it not?\nYour power of observation is fearsome!\rQuite admirable, you are!')
	_SET_FORCE_BLINK('C01_LOOKER', 0)
	_AC_ANIM_RELEASE('C01_LOOKER')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_00170', 'Now that my cover has been blown, let\nme introduce myself.')
	_TALK_CLOSE()
	_OBJ_VISIBLE('HERO')
	_OBJ_VISIBLE('C01_SUPPORT')
	_EVENT_CAMERA_INDEX(577)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_AC_ANIM_RELEASE('C01_LOOKER')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_looker_unthink')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_00171', 'I am a globe-trotting elite of the\nInternational Police.\rMy name... Ah, no, I shall inform you\nonly of my code name.')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_00172', 'My code name, it is Looker.\rIt is what they all call me.')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_looker_look_left')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_00175', 'Incidentally, is the saying, “Don’t be\na thief!” familiar to you?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SET_FORCE_BLINK('C01_LOOKER', 1)
	_AC_ANIM_LOCK('C01_LOOKER')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_look_forward')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_looker_think')
	_OBJ_ANIME_WAIT()
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_looker_answered_yes')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_looker_answered_no')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0020_1', 'Unfortunately, there are apparently\nthose who do not heed those words.\rIn Sinnoh, in fact, there are criminals\nstealing the Pokémon of others.\rI have, therefore, been on the lookout\nfor characters arousing my suspicion.')
	_SET_FORCE_BLINK('C01_LOOKER', 0)
	_AC_ANIM_RELEASE('C01_LOOKER')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_looker_unthink')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0020_2', 'Incidentally, you are Trainers, yes?\nPerhaps you can make use of this?')
	_LDVAL(@SCWK_TEMP0, 1822)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0021', 'That DS Sound, it is a nifty device\nfor listening to classic sounds.\rI obtained it because it is quite popular\nthese days.\rBut myself, I do not do music\nlistening very often.\rIt will be in better hands with you.')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_Looker_053')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0022', 'Also, I have a request.\rIf you were to see me again, I ask that\nyou not talk to me, for I am on duty.\r...Actually, yes, yes, you may speak to\nme. You must.')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_looker_look_left')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_name', 'Incidentally, I will need a name by which to refer\nto you. Your very own code name, yes, yes.\rWhat code name do you desire for yourself?')
	_SET_AYOU_NAME(); Set's Ayou's Name
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_leave', 'Remember, you must inform me of bad guys!\rYou must inform me of any happenings!\nNot because I am lonely, no no!\rBe vigiliant my young friends.\nI must take my leave.')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_look_forward')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(5, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(600); Return to default camera
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_054')
	_OBJ_ANIME('HERO', 'anm_c01_hero_055')
	_OBJ_ANIME('C01_LOOKER', 'anm_c01_Looker_056')
	_OBJ_ANIME_WAIT()
	_CALL('ev_character_theme_stop')
	_OBJ_DEL('C01_LOOKER')
	_FLAG_SET(#2760)
	_TIME_WAIT(20, @SCWK_ANSWER)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_01_support_looker_dawn_dialogue_4')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_01_support_looker_lucas_dialogue_4')
	_TALK_CLOSE()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_057')
	_OBJ_ANIME('HERO', 'anm_c01_hero_058')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_01_support_looker_dawn_dialogue_5')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_01_support_looker_lucas_dialogue_5')
	_TALK_CLOSE()
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_059')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(1)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_01_support_looker_dawn_dialogue_6')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_01_support_looker_lucas_dialogue_6')
	_TALK_CLOSE()
	_JUMP('ev_c01_01_support_common_03')
ev_c01_01_support_common_03:
	_OBJ_ANIME('C01_SUPPORT', 'anm_c01_support_060')
	_OBJ_ANIME('HERO', 'anm_c01_hero_061')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C01_SUPPORT')
	_CALL('ev_character_theme_stop')
	_CALL('ev_another_out_end')
	_LDVAL(@WK_SCENE_C01, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 2000)
	_TALK_END()
	_END()
ev_c01_looker_answered_yes:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0018', 'Yes, that is correct.\nTaking what belongs to others is wrong.')
	_RET()
ev_c01_looker_answered_no:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_meetLooker_0019', 'No? You claim to not know it?\nHow could that be?\rPerhaps your mama has said it, but you\nhave forgotten it, like usual?\rNow listen, my friends. It is wrong to\ntake what belongs to others.')
	_RET()
anm_c01_look_right:
	_AC_NECK_ROTATE(-40, 0, 0, 1)
	_ACMD_END()
