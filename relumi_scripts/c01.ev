	_ACMD_END()
anm_c01_lookerblocker_leave_player:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_LEFT(12, 4)
	_ACMD_END()
anm_c01_lookerblocker_check_city:
	_AC_DIR_L(4)
	_AC_LEFT(1, 4)
	_AC_WAIT(60)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 4)
	_ACMD_END()
ev_c01_townmap_nothing:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_townmap_nothing', 'Hello, my friend.\nHave you visited the Trainers’ School?\rDid your friend not guide you there\nearlier?')
	_RET()
ev_c01_poketch_nothing:
	_MACRO_TALKMSG('dialogue_c01', '00_msg_c01_poketch_nothing', 'Tell me, have you not obtained\na Pokétch?\rI believe a Pokétch is now free?')
	_RET()
ev_c01_townmap_nothing_keywait:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_assistantm_08', 'By the way, have you visited the\nTrainers’ School?\rNot yet, right? You really must visit there!')
	_RET()
ev_c01_poketch_nothing_keywait:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_assistantm_09', 'By the way, have you participated in the\nPokétch campaign?\rNot yet, right? You really must try!')
	_RET()
