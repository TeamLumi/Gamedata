ev_c01_boy1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_boy1_01', 'That look... You’re obviously a Trainer!\nWill you tell me what type of Pokémon you like?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_045')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_046')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_047')
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER, 0)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_c01_boy1a_01_sel000')
	_CASE_JUMP(1, 'ev_c01_boy1a_01_sel001')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_boy1_04', 'You chose Grass-type Pokémon?\nNo wonder you look so calm.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_boy1a_01_sel000:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_boy1_02', 'Fire-type Pokémon?\nYou must have a fiery personality.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_boy1a_01_sel001:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_boy1_03', 'A person who likes Water-type Pokémon must\nbe pretty cool.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_babygirl1:
	_MACRO_EASY_OBJ_MSG('dialogue_c01', '27-msg_c01_babygirl1_01', 'Did you see me on TV? I was in an interview!')
	_END()
ev_c01_man3a:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_man3a_01_1', 'Hiya, where’d you come from?\r...')
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_man3a_01_2', 'Twinleaf Town, huh...\nIt’s a nice place—quiet and all.\rJubilife City is a big place, so it might be a bit of\na shock to you.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_c01', '27-msg_c01_woman3_01', 'When you walk with your Pokémon,\nthey gradually grow friendlier.')
	_END()
ev_c01_oldman1a:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_oldman1a_01', 'Hello, Trainer!\nDo you know much about Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_oldman1a_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_oldman1a_03')
	_END()
ev_c01_oldman1a_02:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_oldman1a_02', 'Ah, I see! You’re quite well versed indeed!\rI imagine you wouldn’t see the need to visit the\nTrainers’ School, then.\rBut do visit if you have the time. You may\ndiscover something new!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_oldman1a_03:
	_MACRO_TALKMSG('dialogue_c01', '27-msg_c01_oldman1a_03', 'Oh, so you’re not very familiar with Pokémon...\nWell, don’t worry!\rYou can go visit the Trainers’ School, where\nyou’ll learn all about the basics of Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_boy1b:
	_MACRO_EASY_OBJ_MSG('dialogue_c01', '27-msg_c01_boy1b_01', 'One, two, three, four, five...six!\nThat should do it.\rYou can only have six Pokémon in your party\nat a time.')
	_END()
