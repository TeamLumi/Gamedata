ev_d31r0401_pc_score:
	_EVENT_START()
	;_MACRO_TALKMSG('dp_scenario3', 'msg_d31r0401_pc_score_01', 'Which record would you like to see?')
	_MACRO_TALKMSG('dialogue_d31r0401', 'msg_d31r0401_pc_score_01', 'Which record would you like to see?')
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlefactory_pc_1', 'Single', 1)
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlefactory_pc_2', 'Double', 2)
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlefactory_pc_3', 'Multi', 3)
	;_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_battlefactory_pc_cancel', 'Cancel', 0)
