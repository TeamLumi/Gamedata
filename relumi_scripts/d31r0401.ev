ev_d31r0401_clown1:
	;_MACRO_EASY_OBJ_MSG('dp_scenario3', 'msg_d31r0401_clown1_01', 'Howdy-do!\nDo you raise Pokémon?\rYou sure do.\nOf course you do.\rBut do you raise every kind of Pokémon?\nNo, no, no. Not likely you do.\rThis is a wonderful place.\nYou can challenge with nothing.\rOf course, all you can challenge with\nare rental Pokémon.\rRemember this, my favorite place to be.\nIts name: the Battle Factory!')
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0401', 'msg_d31r0401_clown1_01', 'Howdy-do!\nDo you raise Pokémon?\rYou sure do.\nOf course you do.\rBut do you raise every kind of Pokémon?\nNo, no, no. Not likely you do.\rThis is a wonderful place.\nYou can challenge with nothing.\rOf course, all you can challenge with\nare rental Pokémon.\rRemember this, my favorite place to be.\nIts name: the Battle Factory!')
	_END()
ev_d31r0401_woman3:
	;_MACRO_EASY_OBJ_MSG('dp_scenario3', 'msg_d31r0401_woman3_01', 'Oh, my goodness, what am I to do?\nI didn’t expect this to happen!\rThe Pokémon I battled with became my\nfavorites.\rBut I already have six favorites!')
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0401', 'msg_d31r0401_woman3_01', 'Oh, my goodness, what am I to do?\nI didn’t expect this to happen!\rThe Pokémon I battled with became my\nfavorites.\rBut I already have six favorites!')
	_END()
ev_d31r0401_man2:
	;_MACRO_EASY_OBJ_MSG('dp_scenario3', 'msg_d31r0401_man2_01', 'There were some Pokémon I hated\nbecause they were so tough to battle.\rBut when I had them on my side, they\nwon me over with their power.')
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0401', 'msg_d31r0401_man2_01', 'There were some Pokémon I hated\nbecause they were so tough to battle.\rBut when I had them on my side, they\nwon me over with their power.')
