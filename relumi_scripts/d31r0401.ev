	_MACRO_TALK_KEYWAIT('dialogue_d31r0401', 'msg_d31r0401_lobby__1', 'Welcome to the Battle Factory!\rI am your guide to the Single and\nDouble Battle challenges.\rPlease be aware that these challenges\nare designed for a single Trainer.')
