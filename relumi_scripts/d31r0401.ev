	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlefactory_pc_2', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlefactory_pc_3', 3)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_ranger_options_battlefactory_pc_cancel', 0)
	_OPEN_CUSTUM_WIN_FIXED(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SWITCH(@SCWK_ANSWER)
	;TODO exefs needed
	_CASE_JUMP(1, 'ev_d31r0401_pc_single')
	_CASE_JUMP(2, 'ev_d31r0401_pc_double')
	_CASE_JUMP(3, 'ev_d31r0401_pc_multi')
	_EVENT_END()
	_END()
ev_d31r0401_lobby_sd_guide_start:
	;TODO exefs needed for all this. Dialogs are in but everything else is still a placeholder
	;_FTR_SET_CURRENT_FACILITY(4)
