ev_d31r0401_lobby_multi_info:
	;_MACRO_TALK_KEYWAIT('dp_scenario3', 'msg_d31r0401_lobby_multi_dialogue_info', 'You may team up with a friend for a\nMulti Battle challenge using rental\fPokémon.\rBoth partners will be provided with two\nrental Pokémon each.\rOnce entered, you and your partner\nconduct Multi Battles until you lose.\rAfter each win, you or your partner\nmay trade a single rented Pokémon.\rIf you manage to win seven matches in\na row, you will earn Battle Points (BP).\rThe Level 50 option starts with rental\nPokémon that only know weak moves.\rThe Open Level option lets you rent\nLv. 100 Pokémon with powerful moves\ffrom the start.\rPlease note: a Battle Factory Multi\nBattle challenge can’t be interrupted.')
	_MACRO_TALK_KEYWAIT('dialogue_d31r0401', 'msg_d31r0401_lobby_multi_dialogue_info', 'You may team up with a friend for a\nMulti Battle challenge using rental\fPokémon.\rBoth partners will be provided with two\nrental Pokémon each.\rOnce entered, you and your partner\nconduct Multi Battles until you lose.\rAfter each win, you or your partner\nmay trade a single rented Pokémon.\rIf you manage to win seven matches in\na row, you will earn Battle Points (BP).\rThe Level 50 option starts with rental\nPokémon that only know weak moves.\rThe Open Level option lets you rent\nLv. 100 Pokémon with powerful moves\ffrom the start.\rPlease note: a Battle Factory Multi\nBattle challenge can’t be interrupted.')
	_JUMP('ev_d31r0401_lobby_multi_guide_challenge')
	_END()
ev_d31r0401_lobby_select_poke:
	_MACRO_TALK_KEYWAIT('dialogue_d31r0401', '44-msg_tower_09', 'Please select the Pokémon you wish to enter.')
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_TALK_CLOSE()
	_PC_KAIFUKU()
	_BTWR_SUB_SELECT_POKE()
	_BTWR_SUB_GET_ENTRY_POKE(@SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_JUMP('ev_d31r0401_lobby_streak_pokechk')
	_END()

ev_d31r0401_lobby_streak_pokechk:
	;_FTR_HALL_GET_STREAK_MON(@SCWK_ANSWER)
	;_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31r0401_lobby_streak_breakchk')
	;_FTR_HALL_SET_STREAK_MON()
	_JUMP('ev_d31r0401_local_savechk')
	_END()

ev_d31r0401_lobby_streak_breakchk:
	;_FTR_HALL_STREAK_MON_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_d31r0401', 'ftr_hall_lobby_streak_dialogue_1', 'Placeholder', 0)
	;_FTR_HALL_SELECTED_MON_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_d31r0401', 'ftr_hall_lobby_streak_dialogue_2', 'Placeholder', 0)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d31r0401_lobby_select_poke')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31r0401_local_savechk')
	_END()

ev_d31r0401_local_savechk:
	_CALL('ev_d31r0401_common_save')
	;If SCWK answer is 0, the player didn't save, so don't continue
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31r0401_local_savechk_no')
	_MACRO_TALKMSG('dialogue_d31r0401', '44-msg_tower_12', 'I will now show you to the Battle Room.')
	_TALK_CLOSE()
	_JUMP('ev_d31r0401_lobby_comanm_guide_out')
	; _TALK_KEYWAIT(dp_scenario3%ftr_hall_stage_dialogue_1)
	; _TALK_CLOSE()
	; _CALL(ev_d31r0401_hall_stage_select_typerank)
	; _JUMP(ev_d31r0401_hall_stage_sbtl_01)
	_END()

ev_d31r0401_local_savechk_no:
	;_MACRO_TALK_KEYWAIT('dp_scenario3', 'msg_d31r0401_savechk_no', 'We hope to see you again!')
	_MACRO_TALK_KEYWAIT('dialogue_d31r0401', 'msg_d31r0401_savechk_no', 'We hope to see you again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_d31r0401_common_save:
	_CHG_COMMON_SCR('ev_report_call')
	_LDWK(@SCWK_ANSWER, @LOCALWORK0)
	_RET()

ev_d31r0401_lobby_comanm_guide_out:
	_LDVAL(@3071, 1)
	_OBJ_ANIME('D31R0401_SD_GUIDE', 'anm_sd_guide_lobby_01')
	_OBJ_ANIME('HERO', 'anm_player_lobby_01')
	_OBJ_ANIME_WAIT()
	;_SET_DOOR_OBJ('D31R0401_D01')
	;_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI015')
	;_HIT_DOOR_ANIME_WAIT()
	_MAP_CHANGE('D31R0402', 0)
	_END()

anm_player_lobby_01:
	_AC_WAIT(25)
	_AC_DIR_U(8)
	_AC_UP(2, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_INVISIBLE_ON()
	_ACMD_END()

anm_sd_guide_lobby_01:
	_AC_DIR_U(8)
	_AC_UP(2, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_INVISIBLE_ON()
	_ACMD_END()