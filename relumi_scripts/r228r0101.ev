ev_r228r0101_girl3:
	_MACRO_EASY_OBJ_MSG('dialogue_r228r0101', '73-msg_r228r0101_girl3_01', 'I’m going to become number one in Sinnoh’s\nSuper Contest Shows!\rI’m going to win with a Pokémon that you can\nonly find here!')
