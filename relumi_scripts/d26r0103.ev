ev_d26r0103_obj_change:
	_IF_FLAGON_JUMP(#FV_D26R0103_DOOR, 'ev_d26r0103_obj_change_vanish')
	_END()
ev_d26r0103_obj_change_vanish:
	_SET_DOOR_OBJ('P_C_001_AutoDoor_01')
	_DOOR_FORCE_ANIME_END(0)
	_END()
ev_d26r0103_gingam:
	_MACRO_EASY_OBJ_MSG('dialogue_d26r0103', '82-msg_d26r0103_gingam_01', 'The locked doors only open with a special key.\rNow, if I was a comedy relief sort of bad guy,\nI’d tell you where the key is...\rBut I really don’t know!')
	_END()
ev_d26r0103_door:
	_TALK_OBJ_START()
	_ITEM_CHK(440, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d26r0103_door_02')
	_MACRO_TALKMSG('dialogue_d26r0103', '82-msg_d26r0103_door_01', 'The door is locked. A special key is needed.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0103_door_02:
	_MACRO_TALKMSG('dialogue_d26r0103', '82-msg_d26r0103_door_02', 'The door is locked. A special key is needed.\rWould you like to use the Galactic Key?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'yes_d26r0103_door')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_d26r0103_door')
	_END()
yes_d26r0103_door:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d26r0103', '82-msg_d26r0103_door_03', 'The door opened.')
	_SE_WAIT('UI_COMMON_SELECT')
	_SE_PLAY('S_FI014')
	_SET_DOOR_OBJ('P_C_001_AutoDoor_01')
	_HIT_DOOR_ANIME(0)
	_HIT_DOOR_ANIME_WAIT()
	_FLAG_SET(#FV_D26R0103_DOOR)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
no_d26r0103_door:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0103_paper1:
	_MACRO_EASY_OBJ_MSG('dialogue_d26r0103', '82-msg_d26r0103_paper1_01', 'The Team Galactic credo! Everything belongs to\nTeam Galactic!\rLook beyond the world—space will become\nTeam Galactic’s!')
	_END()