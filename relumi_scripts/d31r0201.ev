ev_d31r0201_flag_change:
	_GET_RECORD_TOWOR_WIN(0, @LOCALWORK5)
	_IFVAL_CALL(@LOCALWORK5, 'GE', 49, 'ev_d31r0201_ms_reopen')
	_FLAG_SET(#FV_D31R0201_PRIZEMAN)
	_FLAG_SET(#FV_TV_INTERVIEW_02)
	_IFVAL_CALL(@WK_SCENE_D31R0201, 'EQ', 1, 'ev_d31r0202_poketch_hook_reset')
	_IFVAL_CALL(@WK_SCENE_D31R0201, 'EQ', 3, 'ev_d31r0202_poketch_hook_reset')
	_IFVAL_CALL(@WK_SCENE_D31R0201, 'EQ', 255, 'ev_d31r0202_poketch_hook_reset')
	_CALL('ev_d31r0201_flag_prizeman_check')
	_CALL('ev_d31r0201_ball_deco_machine_on')
	_JUMP('ev_d31r0201_flag_interviewer')
ev_d31r0201_flag_interviewer:
	_TV_INTERVIEWER_CHECK(2, @LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'NE', 0, 'ev_d31r0201_flag_interviewer_on')
	_END()
ev_d31r0201_ms_reopen:
	_FLAG_SET(#FE_BT_DECO_PLAYER_SEE01)
	_SET_SYS_FLAG($SYS_FLAG_BATTLE_TOWER_M_S_OPEN)
	_RET()
ev_d31r0201_flag_prizeman_check:
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_10, 'ev_d31r0201_flag_prizeman_on')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_20, 'ev_d31r0201_flag_prizeman_on')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_30, 'ev_d31r0201_flag_prizeman_on')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_40, 'ev_d31r0201_flag_prizeman_on')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_50, 'ev_d31r0201_flag_prizeman_on')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_75, 'ev_d31r0201_flag_prizeman_check_2')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_100, 'ev_d31r0201_flag_prizeman_on')
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_GET_200, 'ev_d31r0201_flag_prizeman_on')
	_RET()
ev_d31r0201_flag_prizeman_check_2:
	_IF_FLAGON_JUMP(#FE_BT_M_WINS_PRESENT_LOOP, 'ev_d31r0201_flag_prizeman_on')
	_RET()
ev_d31r0201_flag_prizeman_on:
	_FLAG_RESET(#FV_D31R0201_PRIZEMAN)
	_OBJ_ADD(#FV_D31R0201_PRIZEMAN)
	_RET()
ev_d31r0201_flag_interviewer_on:
	_FLAG_RESET(#FV_TV_INTERVIEW_02)
	_END()
ev_d31r0202_poketch_hook_reset:
	_RET()
ev_d31r0201_ball_deco_machine_on:
	_FLAG_SET(#FH_OBJ01)
	_FLAG_SET(#FH_OBJ02)
	_FLAG_SET(#FH_OBJ03)
	_FLAG_SET(#FH_OBJ04)
	_OBJ_DEL('D31R0201_PC_SCORE_BALLA')
	_OBJ_DEL('D31R0201_PC_SCORE_BALLB')
	_OBJ_DEL('D31R0201_PC_SCORE_BALLA_OFF')
	_OBJ_DEL('D31R0201_PC_SCORE_BALLB_OFF')
	_FIND_BG_DISABLE(0, 'P_RO_055_Machine/P_D_048_BlueMonitor_01')
	_FIND_BG_DISABLE(0, 'P_RO_055_Machine/P_D_048_BlueMonitor_02')
	_IF_FLAGON_JUMP(#FE_BT_DECO_PLAYER_SEE01, 'ev_d31r0201_ball_deco_machine_use')
	_IF_FLAGON_JUMP(#FE_BT_DECO_PLAYER_SEE02, 'ev_d31r0201_ball_deco_machine_use')
	_IF_FLAGON_JUMP(#FE_BT_DECO_PLAYER_SEE03, 'ev_d31r0201_ball_deco_machine_use')
	_IF_FLAGON_JUMP(#FE_BT_DECO_PLAYER_SEE04, 'ev_d31r0201_ball_deco_machine_use')
	_IF_FLAGON_JUMP(#FE_BT_DECO_PLAYER_SEE05, 'ev_d31r0201_ball_deco_machine_use')
	_IF_FLAGON_JUMP(#FE_BT_DECO_PLAYER_SEE06, 'ev_d31r0201_ball_deco_machine_use')
	_FLAG_RESET(#FH_OBJ03)
	_FLAG_RESET(#FH_OBJ04)
	_OBJ_ADD('D31R0201_PC_SCORE_BALLA_OFF')
	_OBJ_ADD('D31R0201_PC_SCORE_BALLB_OFF')
	_RET()
ev_d31r0201_ball_deco_machine_use:
	_FIND_BG_ENABLE(0, 'P_RO_055_Machine/P_D_048_BlueMonitor_01')
	_FIND_BG_ENABLE(0, 'P_RO_055_Machine/P_D_048_BlueMonitor_02')
	_FLAG_RESET(#FH_OBJ01)
	_FLAG_RESET(#FH_OBJ02)
	_OBJ_ADD('D31R0201_PC_SCORE_BALLA')
	_OBJ_ADD('D31R0201_PC_SCORE_BALLB')
	_RET()
ev_d31r0201_tower_gate_local_01:
	_TALK_OBJ_START()
	_EVENT_START()
	_CALL('ev_block_doc')
	_SET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_IF_FLAGON_JUMP(#FE_BTLTW_N_SINGLE_SUSPENSION, 'ev_d31r0201_tower_continue_local_single')
	_IF_FLAGON_JUMP(#FE_BTLTW_N_DOUBLE_SUSPENSION, 'ev_d31r0201_tower_continue_local_double')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_01', 'Welcome to the Battle Tower!\rI am your guide to the Single and Double\nBattle Rooms.')
	_JUMP('ev_d31r0201_tower_gate_local_02')
ev_d31r0201_tower_gate_local_02:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_02', 'Would you like to take the\nBattle Room challenge?')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_00', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_01', 2)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'ev_d31r0201_tower_gate_local_03')
	_CASE_JUMP(2, 'ev_d31r0201_tower_gate_local_exp01')
	_CASE_JUMP(0, 'ev_d31r0201_tower_gate_common_exit')
	_JUMP('ev_d31r0201_tower_gate_common_exit')
	_END()
ev_d31r0201_tower_gate_local_exp01:
	_NUMBER_NAME(0, 4)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_04_1', 'The Battle Tower’s Single Battle Rooms are\nfacilities for conducting Single Battles with\fthree Pokémon.\rSimilarly, the Double Battle Rooms are facilities\nfor conducting Double Battles with\ffour Pokémon.', 0)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_04_2', 'There are many Battle Rooms in the Battle Tower\nfor team battles.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_04_3', 'In each of the Battle Rooms, seven Trainers await\nyour challenge.\rIf you manage to defeat all seven, you will earn\nBattle Points, or BP for short.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_04_4', 'Until you challenge the fifth Trainer, you can\ntake a break during the challenge to step out of\fthe Battle Room and reselect your Pokémon.\rIf you stop your challenge after defeating five\nTrainers, you’ll have to start your challenge\ffrom the beginning.\rEither way, please note that if you don’t save,\nyou will be disqualified from your challenge.', 1)
	_JUMP('ev_d31r0201_tower_gate_local_02')
	_END()
ev_d31r0201_tower_gate_local_03:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_05', 'Would you like to enter the Single Battle Room\nor the Double Battle Room?')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_main%SS_btl_tower_main_001', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_main%SS_btl_tower_main_003', 2)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_main%SS_btl_tower_main_029', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'ev_d31r0201_tower_gate_local_pchk_s')
	_CASE_JUMP(2, 'ev_d31r0201_tower_gate_local_pchk_d')
	_CASE_JUMP(0, 'ev_d31r0201_tower_gate_common_exit')
	_JUMP('ev_d31r0201_tower_gate_common_exit')
	_END()
ev_d31r0201_tower_gate_local_pchk_s:
	_LDVAL(@WK_BATTLE_TOWER_MODE, 0)
	_BTWR_TOOL_SET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_GET_POKE_COUNT5(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 3, 'ev_d31r0201_tower_gate_local_pokesel')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_06_1', 'Just a moment!\rYou don’t have three eligible Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_06_2', 'Make sure the three participating Pokémon are\ndifferent, and that none of them have the same\fheld item.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_06_4', 'Please come back once you’ve made\nyour preparations.', 1)
	_JUMP('ev_d31r0201_tower_gate_local_exit_mclose')
	_END()
ev_d31r0201_tower_gate_local_pchk_d:
	_LDVAL(@WK_BATTLE_TOWER_MODE, 1)
	_BTWR_TOOL_SET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_GET_POKE_COUNT5(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 4, 'ev_d31r0201_tower_gate_local_pokesel')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_07_1', 'Just a moment!\rYou don’t have four eligible Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_07_2', 'Make sure the four participating Pokémon are\ndifferent, and that none of them have the same\fheld item.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_07_4', 'Please come back once you’ve made\nyour preparations.', 1)
	_JUMP('ev_d31r0201_tower_gate_local_exit_mclose')
	_END()
ev_d31r0201_tower_gate_local_pokesel:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_09', 'Please select the Pokémon you wish to enter.')
	_BLACK_OUT()
	_FADE_WAIT()
	_TALK_CLOSE()
	_PC_KAIFUKU()
	_SXY_POS_CHANGE('HERO', 16, 7)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_DIR_CHANGE('TOWER_GATE_LOCAL_01', 0)
	_BTWR_SUB_SELECT_POKE()
	_BTWR_SUB_GET_ENTRY_POKE(@SCWK_ANSWER)
	_BLACK_IN()
	_FADE_WAIT()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_d31r0201_tower_gate_common_exit')
	_JUMP('ev_d31r0201_tower_gate_local_savechk')
	_END()
ev_d31r0201_tower_gate_local_exit_mclose:
	_TALK_CLOSE()
	_JUMP('ev_d31r0201_tower_gate_local_exit_direct')
	_END()
ev_d31r0201_tower_gate_local_exit_direct:
	_LDVAL(@WK_SCENE_D31R0201, 0)
	_LDVAL(@WK_SCENE_D31R0202, 0)
	_LDVAL(@WK_SCENE_D31R0203, 0)
	_LDVAL(@WK_SCENE_D31R0205, 0)
	_CALL('ev_block_doc_end')
	_RESET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_TALK_END()
	_END()
ev_d31r0201_tower_gate_local_savechk:
	_BTWR_SUB_INC_ROUND()
	_BTWR_TOOL_PUSH_NOW_LOCATION()
	_CALL('ev_d31r0201_tower_gate_common_newgame_sd_wkset')
	_CALL('ev_d31r0201_tower_gate_common_save')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31r0201_tower_gate_common_exit_play')
	_BTWR_SUB_UPDATE_RANDOM()
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_12', 'I will now show you to the Battle Room.')
	_TALK_CLOSE()
	_JUMP('ev_d31r0201_tower_gate_local_in01')
	_END()
ev_d31r0201_tower_gate_local_in01:
	_OBJ_ANIME('TOWER_GATE_LOCAL_01', 'anm_d31r0201_pcwoman2_01')
	_OBJ_ANIME('HERO', 'anm_d31r0201_player_01')
	_OBJ_ANIME_WAIT()
	_SET_DOOR_OBJ('D31R0201_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI015')
	_HIT_DOOR_ANIME_WAIT()
	_OBJ_ANIME('TOWER_GATE_LOCAL_01', 'anm_d31r0201_pcwoman2_01_01')
	_OBJ_ANIME('HERO', 'anm_d31r0201_player_01_01')
	_OBJ_ANIME_WAIT()
	_HIT_DOOR_ANIME(1)
	_SE_PLAY('S_FI015')
	_HIT_DOOR_ANIME_WAIT()
	_MAP_CHANGE('D31R0202', 0)
	_TALK_END()
	_END()
ev_d31r0201_tower_continue_local_single:
	_LDVAL(@WK_BATTLE_TOWER_MODE, 0)
	_FLAG_RESET(#FE_BTLTW_N_SINGLE_SUSPENSION)
	_BTWR_TOOL_SET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_JUMP('ev_d31r0201_tower_continue_common_02')
	_END()
ev_d31r0201_tower_continue_local_double:
	_LDVAL(@WK_BATTLE_TOWER_MODE, 1)
	_FLAG_RESET(#FE_BTLTW_N_DOUBLE_SUSPENSION)
	_BTWR_TOOL_SET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_JUMP('ev_d31r0201_tower_continue_common_02')
	_END()
ev_d31r0201_tower_gate_mclass_01:
	_TALK_OBJ_START()
	_EVENT_START()
	_CALL('ev_block_doc')
	_SET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_IF_FLAGON_JUMP(#FE_BTLTW_M_SINGLE_SUSPENSION, 'ev_d31r0201_tower_continue_mclass_single')
	_IF_FLAGON_JUMP(#FE_BTLTW_M_DOUBLE_SUSPENSION, 'ev_d31r0201_tower_continue_mclass_double')
	_FLAG_SET(#1755)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_200', 'Welcome to the Battle Tower!\rI’m here to guide you to a Master Class Battle\nRoom, either for Single or Double Battles.')
	_IF_FLAGON_JUMP($SYS_FLAG_BATTLE_TOWER_M_S_OPEN, 'ev_d31r0201_tower_gate_mclass_02')
	_IF_FLAGON_JUMP($SYS_FLAG_BATTLE_TOWER_M_D_OPEN, 'ev_d31r0201_tower_gate_mclass_02')
	_MACRO_TALKMSG('dialogue_d31r0201', '45-msg_tower_80', 'In order to enter Master Class, you’ll have to win\n49 times in a row in either the Single Battles or\fDouble Battles of the regular Battle Tower.\rGood luck!')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_RESET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_TALK_END()
	_END()
ev_d31r0201_tower_gate_mclass_02:
	_IF_FLAGOFF_CALL(#FE_BT_M_FIRST_TALK, 'ev_d31r0201_tower_mclass_first_talk')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_201', 'Would you like to enter a Master Class\nBattle Room?')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_00', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_01', 2)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_menu_ui_text%msg_tower_choice_02', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'ev_d31r0201_tower_gate_mclass_03')
	_CASE_JUMP(2, 'ev_d31r0201_tower_gate_mclass_exp01')
	_CASE_JUMP(0, 'ev_d31r0201_tower_gate_common_exit')
	_JUMP('ev_d31r0201_tower_gate_common_exit')
	_END()
ev_d31r0201_tower_gate_mclass_exp01:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_203', 'We have two Master Class Battle Rooms: one for\nSingle Battles and one for Double Battles.', 0)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_204', 'Seven Trainers will arrive in each Battle Room.\nThey are stronger than the Trainers you’d face\fin regular Single Battles or Double Battles.\rYou’ll earn extra BP if you can defeat them all.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_205', 'Also, we use a rank system for the Master Class.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_206', 'Master Class Single and Double Battles each\nhave 10 ranks. When you get a seven-win streak,\fyour rank will go up by one.\rOn the other hand, if you lose a certain number\nof times in a row depending on the rank, your\frank will go down by one.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_207', 'As your rank rises, your opponents will be\nstronger, but you’ll also earn more BP.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_208', 'If you decide to take a break during a challenge\nthat is already underway, be sure to save your\fprogress, or your challenge won’t be counted.\fPlease don’t forget!', 1)
	_JUMP('ev_d31r0201_tower_gate_mclass_02')
	_END()
ev_d31r0201_tower_gate_mclass_03:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_209', 'Would you like to enter the Single Battle Room\nor the Double Battle Room?')
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_main%SS_btl_tower_main_001', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_main%SS_btl_tower_main_003', 2)
	_ADD_CUSTUM_WIN_LABEL('ss_btl_tower_main%SS_btl_tower_main_029', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'ev_d31r0201_tower_gate_mclass_pchk_s')
	_CASE_JUMP(2, 'ev_d31r0201_tower_gate_mclass_pchk_d')
	_CASE_JUMP(0, 'ev_d31r0201_tower_gate_common_exit')
	_JUMP('ev_d31r0201_tower_gate_common_exit')
	_END()
ev_d31r0201_tower_gate_mclass_pchk_s:
	_LDVAL(@WK_BATTLE_TOWER_MODE, 2)
	_BTWR_TOOL_SET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_GET_POKE_COUNT5(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 3, 'ev_d31r0201_tower_gate_mclass_pokesel')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_210', 'Just a moment!\rYou don’t have three eligible Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_211', 'Make sure the three participating Pokémon are\ndifferent, and that none of them have the same\fheld item.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_213', 'Please come back once you’ve made\nyour preparations.', 1)
	_JUMP('ev_d31r0201_tower_gate_mclass_exit_mclose')
	_END()
ev_d31r0201_tower_gate_mclass_pchk_d:
	_LDVAL(@WK_BATTLE_TOWER_MODE, 3)
	_BTWR_TOOL_SET_PLAY_MODE(@WK_BATTLE_TOWER_MODE)
	_GET_POKE_COUNT5(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 4, 'ev_d31r0201_tower_gate_mclass_pokesel')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_214', 'Just a moment!\rYou don’t have four eligible Pokémon.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_215', 'Make sure the four participating Pokémon are\ndifferent, and that none of them have the same\fheld item.', 1)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_217', 'Please come back once you’ve made\nyour preparations.', 1)
	_JUMP('ev_d31r0201_tower_gate_mclass_exit_mclose')
	_END()
ev_d31r0201_tower_gate_mclass_pokesel:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_219', 'Please select the Pokémon you wish to enter.')
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_TALK_CLOSE()
	_PC_KAIFUKU()
	_SXY_POS_CHANGE('HERO', 20, 7)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_DIR_CHANGE('TOWER_GATE_MCLASS_01', 0)
	_BTWR_SUB_SELECT_POKE()
	_BTWR_SUB_GET_ENTRY_POKE(@SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_d31r0201_tower_gate_common_exit')
	_JUMP('ev_d31r0201_tower_gate_mclass_savechk')
	_END()
ev_d31r0201_tower_gate_mclass_exit_mclose:
	_TALK_CLOSE()
	_JUMP('ev_d31r0201_tower_gate_mclass_exit_direct')
	_END()
ev_d31r0201_tower_gate_mclass_exit_direct:
	_LDVAL(@WK_SCENE_D31R0201, 0)
	_LDVAL(@WK_SCENE_D31R0202, 0)
	_LDVAL(@WK_SCENE_D31R0203, 0)
	_LDVAL(@WK_SCENE_D31R0205, 0)
	_CALL('ev_block_doc_end')
	_RESET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_TALK_END()
	_END()
ev_d31r0201_tower_gate_mclass_same_poke:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_220', 'Your Pokémon must all be different.')
	_JUMP('ev_d31r0201_tower_gate_common_exit')
	_END()
ev_d31r0201_tower_gate_mclass_same_item:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_221', 'Held items must all be different.')
	_JUMP('ev_d31r0201_tower_gate_common_exit')
	_END()
ev_d31r0201_tower_gate_mclass_savechk:
	_BTWR_SUB_INC_ROUND()
	_BTWR_TOOL_PUSH_NOW_LOCATION()
	_CALL('ev_d31r0201_tower_gate_common_newgame_sd_wkset')
	_CALL('ev_d31r0201_tower_gate_common_save')
