ev_d31r0201_msg_boy:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '98-msgboy_str_01', 'Excuse me, do you have a moment?\rHave you ever tried the Master Class battles?\nEveryone’s so strong in them, I can’t win at all.')
	_END()
ev_d31r0201_woman1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_woman1_01', 'Yeah, I used to live in a place called Hoenn.\rThere was a place like this back there, too.')
	_END()
ev_d31r0201_gorggeousm1a:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_gorggeousm1a_01', 'Only a handful of Trainers are tough enough for\nMaster Class battles.\rI’d love to take on that challenge someday!')
	_END()
ev_d31r0201_idol:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_idol_01', 'They profile you on TV if you set a good\nrecord here.\rThis is my only chance to regain my glory as\nan Idol!')
	_END()
ev_d31r0201_gorggeousm1b:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_gorggeousm1b_01', 'I trained my little guy till we couldn’t take\nany more.\rHe’s going to do a hundred-win streak for sure.\rRight, Pikachu?')
	_END()
ev_d31r0201_pokemona:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_pokemona_01', '...')
	_END()
ev_d31r0201_artist:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_artist_01', 'Ooh-la-la! You look tremendously powerful!\rVerily, I shall look forward to engaging you in\na battle.')
	_END()
ev_d31r0201_boy1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31r0201', '44-msg_d31r0201_boy1_01', 'There are so many tough Trainers around...\rIt’s scary, but let’s do our best, Pikachu!')
	_END()
ev_d31r0201_pokemonb:
	_EASY_VOICE_MSG('dialogue_d31r0201%55-msg_c01r0801_pikachu_01', 'PLAY_PV_EV_025_00_02')
	_END()
ev_d31r0201_tower_judge:
	_TALK_OBJ_START()
	_IF_FLAGON_CALL(#FE_D31R0201_JUDGE_TALK, 'ev_d31r0201_tower_judge_talked')
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_judge_01', 'Hmm? You look like something of an expert!\rI’ll bet you’re just longing to know everything\nthere is about Pokémon, right?\rYes, I can tell just by looking at you!\rWell, you’re in luck—I’d like to give you a\npresent that will let you see straight through\fto a Pokémon’s innate strengths!\rIt’s called the Judge function.\rAfter selecting a Pokémon in a Box, press the\n+ Button or - Button to see its potential.\rWith this, you will truly be an expert!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FE_D31R0201_JUDGE_TALK)
	_END()
ev_d31r0201_tower_judge_talked:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_judge_02', 'So, what do you think? Have you been using the\nJudge function?\rI think it’s fascinating to see how even the same\nkind of Pokémon can be so different!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
