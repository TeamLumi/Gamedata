ev_d31r0201_tower_continue_common_02:
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_17', 'We’ve been waiting for you!\rBefore entering a Battle Room, your progress will\nbe saved.')
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_TALK_CLOSE()
	_PC_KAIFUKU()
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 0, 'ev_d31r0201_tower_continue_common_02_nomal')
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 1, 'ev_d31r0201_tower_continue_common_02_nomal')
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 2, 'ev_d31r0201_tower_continue_common_02_master')
	_IFVAL_CALL(@WK_BATTLE_TOWER_MODE, 'EQ', 3, 'ev_d31r0201_tower_continue_common_02_master')
	_BTWR_SUB_SELECT_POKE()
	_BTWR_SUB_GET_ENTRY_POKE(@SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_d31r0201_tower_gate_common_exit_before')
	_CALL('ev_d31r0201_tower_gate_common_continue_sd_wkset')
	_BTWR_TOOL_PUSH_NOW_LOCATION()
	_AUTO_MSG(1, 0)
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_15', 'Saving...\nDon’t turn off the power.')
	_FLAG_SET(#1754)
	_CALL('ev_d31r0201_tower_gate_common_auto_save'); Used
	_AUTO_MSG_STOP()
	_BTLTWR_CONTINUE_ROUND()
	_MACRO_TALKMSG('dialogue_d31r0201', '44-msg_tower_12', 'I will now show you to the Battle Room.')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_JUMP('ev_d31r0201_tower_gate_comanm_entry')
	_END()
