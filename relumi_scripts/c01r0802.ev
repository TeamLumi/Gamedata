ev_c01r0802_man3:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0802', '56-msg_c01r0802_man3_01', 'We came here because I wanted to see the place\nwhere the Pokémon I got from a trade grew up.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0802_woman2:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0802', '56-msg_c01r0802_woman2_01', 'I think about my friends every time I see the\nPokémon I traded with them!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0802_bigman:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0802', '56-msg_c01r0802_bigman_01', 'You can trade Pokémon with people around the\nworld using the Global Wonder Station, right?\rJust hearing that gets my heart racing.\nSuch exciting times!')
	_END()
ev_c01r0802_girl1:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0802', '56-msg_c01r0802_girl1_01', 'When you connect with people on the internet,\nit’s hard to tell if the world’s big or small.')
	_END()