ev_r202_flag_change:
	_IFVAL_CALL(@WK_SCENE_C01, 'EQ', 0, 'ev_r202_player_pos_check'); Calls a check ensuring the player isn't entering from Jubilife City
	_END()
ev_r202_player_pos_check:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'GT', 800, 'ev_r202_ayou_set_gender'); Enables the correct placedata for AYou in Jubilife City
	_RET()
ev_r202_ayou_set_gender:
	_GET_COSTUME(@SCWK_TEMP0); Assigns the Current costume to TEMP0
	_GET_COSTUME_GENDER(@SCWK_TEMP0, @SCWK_TEMP1); Takes TEMP0 and checks the index and assigns TEMP1 to 0 if male and 1 if female
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 0, 'ev_r202_ayou_rei_set')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 1, 'ev_r202_ayou_akari_set')
	_RET()
ev_r202_ayou_rei_set:
	_OBJ_ADD('C01_AYOU_REI')
	_FLAG_RESET(#2919)
	_OBJ_DEL('C01_AYOU_AKARI')
	_FLAG_SET(#2918)
	_RET()
ev_r202_ayou_akari_set:
	_OBJ_ADD('C01_AYOU_AKARI')
	_FLAG_RESET(#2918)
	_OBJ_DEL('C01_AYOU_REI')
	_FLAG_SET(#2919)
	_RET()
ev_r202_boy2:
	_MACRO_EASY_OBJ_MSG('dialogue_r202', '10-msg_r202_boy2_01', 'Some Pokémon only appear in the morning.\nSome only come out at night.\rI’m going to keep waiting right here till I’ve\nseen every last one of ’em!')
	_END()
ev_r202_sign1:
	_EASY_BOARD_MSG('dialogue_r202%10-msg_r202_sign1_01', 'BOARD_TYPE_ROAD', 0, 4)
	_END()
ev_r202_sign2:
	_EASY_BOARD_MSG('dialogue_r202%10-msg_r202_sign2_01', 'BOARD_TYPE_ROAD', 0, 3)
	_END()
ev_r202_sign3:
	_EASY_INFOBOARD_MSG('dialogue_r202%10-msg_r202_sign3_01_1', 'BOARD_TYPE_INFO', 0)
	_EASY_INFOBOARD_MSG('dialogue_r202%10-msg_r202_sign3_01_2', 'BOARD_TYPE_INFO', 0)
	_END()
pos_r202_support:
	_EVENT_START()
	_OBJ_ANIME('R202_SUPPORT', 'anm_01_r202_support_00')
	_OBJ_ANIME('HERO', 'anm_01_r202_player_00')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 825, 'pos_r202_support_z01')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 826, 'pos_r202_support_z02')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 827, 'pos_r202_support_z03')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 828, 'pos_r202_support_z04')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 829, 'pos_r202_support_z05')
	_END()
pos_r202_support_z01:
	_OBJ_ANIME('R202_SUPPORT', 'anm_r202_support_01')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r202_support_02_common')
	_END()
pos_r202_support_z02:
	_OBJ_ANIME('R202_SUPPORT', 'anm_r202_support_02')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r202_support_02_common')
	_END()
pos_r202_support_z03:
	_OBJ_ANIME('R202_SUPPORT', 'anm_r202_support_03')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r202_support_02_common')
	_END()
pos_r202_support_z04:
	_OBJ_ANIME('R202_SUPPORT', 'anm_r202_support_04')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r202_support_02_common')
	_END()
pos_r202_support_z05:
	_OBJ_ANIME('R202_SUPPORT', 'anm_r202_support_05')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r202_support_02_common')
	_END()
pos_r202_support_02_common:
	_CHARA_LOOK_LOCK('R202_SUPPORT', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'R202_SUPPORT')
	_IF_FLAGOFF_JUMP(#FE_BOUKENNOOTO_GET, 'pos_r202_support_stop')
	_EVENT_CAMERA_INDEX(922)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_block_doc')
	_JUMP('ev_r202_support_requests_fight')
ev_r202_support_requests_fight:
	_PLAYER_NAME(1)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_support_requests_fight_male_1')
	_JUMP('ev_r202_support_requests_fight_female_1')
ev_r202_support_requests_fight_male_1:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_01', '{1,1,0,0}, let’s have a\nPokémon battle!\rI’ll heal your Pokémon first...', 1)
	_JUMP('ev_r202_support_requests_fight_2')
ev_r202_support_requests_fight_female_1:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_01_hero', '{1,1,0,0}, we should have a\nPokémon battle!\rLet me heal your Pokémon...', 1)
	_JUMP('ev_r202_support_requests_fight_2')
ev_r202_support_requests_fight_2:
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_support_requests_fight_male_2')
	_JUMP('ev_r202_support_requests_fight_female_2')
ev_r202_support_requests_fight_male_2:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_02', 'Now, this is gonna be fun!', 1)
	_JUMP('ev_r202_support_requests_fight_3')
ev_r202_support_requests_fight_female_2:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_02_hero', 'Now, I hope you’re ready\nto battle!', 1)
	_JUMP('ev_r202_support_requests_fight_3')
ev_r202_support_requests_fight_3:
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(923)
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_RELEASE('R202_SUPPORT')
	_CHARA_LOOK_RELEASE('HERO')
	_CALL('ev_r202_support_battle')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_JUMP('ev_r202_01_support_battle_over')
ev_r202_01_support_battle_over:
	_EVENT_START()
	_CALL('ev_character_theme_stop')
	_PLAYER_NAME(1)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_01_support_battle_over_male_1')
	_JUMP('ev_r202_01_support_battle_over_female_1')
ev_r202_01_support_battle_over_male_1:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_03', 'Wow, you’re that strong already, {1,1,0,0}?\rI’ll give you 30 Poké Balls to get started!', 1)
	_JUMP('ev_r202_01_support_battle_over_1')
ev_r202_01_support_battle_over_female_1:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_03_hero', 'Woah, you’re that strong already, {1,1,0,0}?\rI’ll give you 30 Poké Balls to get started!', 1)
	_JUMP('ev_r202_01_support_battle_over_1')
ev_r202_01_support_battle_over_1:
	_LDVAL(@SCWK_TEMP0, 4)
	_LDVAL(@SCWK_TEMP1, 30)
	_CALL('ev_item_event')
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_01_support_battle_over_male_2')
	_JUMP('ev_r202_01_support_battle_over_female_2')
ev_r202_01_support_battle_over_male_2:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_04', 'If you have lots of Pokémon with you,\nyou’ll be able to travel farther.\rThat way, you’ll have a better shot\nat meeting more Pokémon.\rSee you later!', 1)
	_MACRO_TALK_KEYWAIT('dialogue_r202', '00_msg_r202_incense_tutorial_00', 'Oh, and if you burn special flowers in that\nIncense Burner, you might find some rare\fPokémon anywhere you go!')
	_JUMP('ev_r202_01_support_battle_over_2')
ev_r202_01_support_battle_over_female_2:
	_MACRO_TALKMSG('dialogue_r202', '84-msg_catching_tutorial_04_hero', 'If you have lots of Pokémon with you,\nyou’ll be able to travel farther.\rThat way, you’ll have a better shot\nat meeting more Pokémon.\rSee you around!', 1)
	_MACRO_TALK_KEYWAIT('dialogue_r202', '00_msg_r202_incense_tutorial_00_hero', 'Oh, and if you burn special flowers in that\nIncense Burner, you might find some rare\fPokémon anywhere you go!')
	_JUMP('ev_r202_01_support_battle_over_2')
ev_r202_01_support_battle_over_2:
	_TALK_CLOSE()
	_OBJ_ANIME('R202_SUPPORT', 'anm_03_r202_support_01')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('R202_SUPPORT')
	_BOUKENNOOTO_TIPS_OPEN(7, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2457); Move Reminder Chapter
	_LDVAL(@WK_SCENE_R202, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 1900)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_r202_support_battle:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_dawn_battle')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r202_lucas_battle')
ev_r202_dawn_battle:
	_SUPPORT_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 691); Support has Turtwig
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_support_return')
	_LDVAL(@SCWK_TEMP3, 692); Support has Chimchar
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r202_support_return')
	_LDVAL(@SCWK_TEMP3, 690); Support has Piplup
	_RET()
ev_r202_lucas_battle:
	_SUPPORT_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 685); Support has Turtwig
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r202_support_return')
	_LDVAL(@SCWK_TEMP3, 686); Support has Chimchar
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r202_support_return')
	_LDVAL(@SCWK_TEMP3, 684); Support has Piplup
	_RET()
ev_r202_support_return:
	_RET()
pos_r202_support_stop:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'r202_support_male_50')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'r202_support_female_50')
	_END()
r202_support_male_50:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_IF_FLAGOFF_CALL(#FE_R202_SUPPORT_TALK, 'r202_support_male_50_off')
	_IF_FLAGON_CALL(#FE_R202_SUPPORT_TALK, 'r202_support_male_50_on')
	_JUMP('r202_01_support_common_50')
	_END()
r202_support_male_50_off:
	_MACRO_TALKMSG('dialogue_r202', '10-msg_r202_heroine_01_1', '{1,1,0,0}?!\rDid you tell your family that you’re helping\nthe professor?\r...You didn’t, did you?')
	_MACRO_TALKMSG('dialogue_r202', '10-msg_r202_heroine_01_2', 'I know that you’re really eager to see all kinds of\nPokémon, but you shouldn’t make your mom\fworry that you’ve disappeared.', 1)
	_RET()
r202_support_male_50_on:
	_MACRO_TALKMSG('dialogue_r202', '10-msg_r202_heroine_04', 'You should go tell your family that you’re helping\nthe professor. The faster the better, too.')
	_RET()
r202_support_female_50:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_IF_FLAGOFF_CALL(#FE_R202_SUPPORT_TALK, 'r202_support_female_50_off')
	_IF_FLAGON_CALL(#FE_R202_SUPPORT_TALK, 'r202_support_female_50_on')
	_JUMP('r202_01_support_common_50')
	_END()
r202_support_female_50_off:
	_MACRO_TALKMSG('dialogue_r202', '10-msg_r202_hero_01_1', '{1,1,0,0}?!\rDid you tell your family that you’re helping\nthe professor?\r...I bet you didn’t, did you?')
	_MACRO_TALKMSG('dialogue_r202', '10-msg_r202_hero_01_2', 'I know that you’re eager to see all kinds of\nPokémon, but you shouldn’t make your mom\fworry that you’ve upped and left.', 1)
	_RET()
r202_support_female_50_on:
	_MACRO_TALKMSG('dialogue_r202', '10-msg_r202_hero_04', 'Why don’t you go tell your family that the\nprofessor asked for your help?\rYou should do it right away.')
	_RET()
r202_01_support_common_50:
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R202_SUPPORT')
	_CHARA_LOOK_RELEASE('HERO')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
