ev_t02_hyouta:
	_EVENT_START()
	_OBJ_ADD('T02_HYOUTA')
	_TIME_WAIT(24, @SCWK_ANSWER )
	_AG_TRANSITION_HOYUTA('T02_HYOUTA', 1, 0)
	_TIME_WAIT(10, @SCWK_ANSWER )
	_OBJ_ANIME('T02_HYOUTA', 'anm_t02_hyouta_02')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T02_HYOUTA', 'anm_t02_hyouta_02_g')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hyota_01', 'Hi there! It’s been a while!\rWhen I heard that you’d defeated the Elite Four\nand entered the Hall of Fame, I rushed straight\fhere to congratulate you! I mean it—great job!\rAll the other Gym Leaders are really happy for\nyou too.')
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hyota_02', 'But you know, we Gym Leaders aren’t going to\ntake this lying down.\rLosing to you was rough on all of us, yet we still\nhave our pride as Sinnoh’s eight Gym Leaders.\rNow we’re all determined to beat you this time!\rSo if you don’t mind, could you give us all\nanother chance with a Pokémon battle?\rWe’ll each be waiting for you at our own Gyms.\nYou know where to find me—Oreburgh Gym!')
	_TALK_CLOSE()
	_OBJ_ANIME('T02_HYOUTA', 'anm_t02_hyouta_04')
	_OBJ_ANIME_WAIT()
	_AG_TRANSITION_HOYUTA('T02_HYOUTA', -20, 1)
	_TIME_WAIT(10, @SCWK_ANSWER )
	_OBJ_DEL('T02_HYOUTA')
	_FLAG_SET(#1334)
	_FLAG_SET(#1335)
	_LDVAL(@49, 4)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
anm_t02_hyouta_00:
	_AC_INVISIBLE_ON()
	_ACMD_END()
anm_t02_hyouta_01:
	_AC_INVISIBLE_OFF()
	_AC_INDEX_ANIME(15)
	_AC_WAIT(80)
	_ACMD_END()
anm_t02_hyouta_02:
	_AC_DIR_U(4)
	_ACMD_END()
anm_t02_hyouta_02_g:
	_AC_MARK_GYOE(1)
	_AC_WAIT(16)
	_AC_UP(1, 8)
	_ACMD_END()
anm_t02_hyouta_04:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_WAIT(8)
	_ACMD_END()
anm_t02_hyouta_05:
	_AC_INDEX_ANIME(15)
	_AC_WAIT(80)
	_AC_VANISH_ON()
	_ACMD_END()