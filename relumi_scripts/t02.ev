	_OBJ_ANIME('T02_SUPPORT', 'anm_t02_support_80')
	_OBJ_ANIME_WAIT()
	_GET_MY_SEX(@SCWK_ANSWER )
	_IFVAL_JUMP(@SCWK_ANSWER , 'EQ', 0, 'ev_t02_support_male_54')
	_IFVAL_JUMP(@SCWK_ANSWER , 'EQ', 1, 'ev_t02_support_female_54')
	_END()
ev_t02_support_male_54:
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_poke_radar_1', 'That reminds me, I wanted to give you this.')
	_LDVAL(@SCWK_TEMP0, 431)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_poke_radar_2', 'That’s a Pokémon Radar. Or Poké Radar for\nshort.\rIt can be a bit tricky to get the hang of but\nyou can use it to encounter the same wild\fPokémon species consistently.\rIt works really well with that Infinite Repel\nthat I gave you before.')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(15, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2465); Poké Radar Chapter
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_07_1', 'Oh, that’s right! {0,1,0,0}...\rDon’t you need to let your family know that\nyou’re going to be helping Professor Rowan\fwith the Pokédex?')
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_07_2', 'You may need to travel pretty far, so I think you\nshould let someone know.', 1)
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_07_3', 'Oh, but before you go, heal up your Pokémon at\nthe Pokémon Center.\rIt will be a lot less scary that way. OK, bye now!', 1)
	_JUMP('ev_t02_01_support_common_08')
ev_t02_support_female_54:
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hero_poke_radar_1', 'Speaking of which, you should take this.')
	_LDVAL(@SCWK_TEMP0, 431)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hero_poke_radar_2', 'That’s a Pokémon Radar. Or Poké Radar for\nshort.\rIt can be a bit tricky to get the hang of but\nyou can use it to encounter the same wild\fPokémon species consistently.\rIt works really well with that Infinite Repel\nthat I gave you before.')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(15, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2465); Poké Radar Chapter
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hero_07_1', 'Oh, yeah, right! {0,1,0,0}...\rYou should let your family know you’re helping\nProfessor Rowan put together his Pokédex.')
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hero_07_2', 'You may have to travel pretty far, so you should\nlet someone know.', 1)
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_hero_07_3', 'Oh, but first, go heal up your Pokémon at the\nPokémon Center.\rYou’ll be safe, then. OK, be seeing you!', 1)
	_JUMP('ev_t02_01_support_common_08')
ev_t02_01_support_common_08:
	_TALK_CLOSE()
	_OBJ_ANIME('T02_SUPPORT', 'anm_t02_support_85')
	_OBJ_ANIME('HERO', 'anm_t02_player_85')
	_OBJ_ANIME_WAIT()
	_CALL('ev_character_theme_stop')
	_OBJ_DEL('T02_SUPPORT')
	_LDVAL(@49, 2)
	_LDVAL(@249, 1700)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
