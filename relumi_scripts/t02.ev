ev_t02_support_male_51:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_04_1', 'OK, {1,1,0,0}, I’ll act as your mentor.')
	_MACRO_TALKMSG('dialogue_t02', '12-msg_t02_heroine_04_2', 'I’ve got a bit more experience than you as a\nTrainer and as the professor’s assistant.\rOK, follow me!', 1)
	_JUMP('ev_t02_01_support_common_05')
ev_t02_support_female_51:
	_SUPPORT_NAME(0)
	_PLAYER_NAME(1)
