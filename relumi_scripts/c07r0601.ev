ev_c07r0601_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0601', '105-msg_c07r0601_woman3_01', 'A myth says that Mount Coronet parted Sinnoh\ninto halves.\rSeeing the Pokémon Shellos makes me\nthink that maybe the myth is real.')
	_END()
ev_c07r0601_oldwoman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0601', '105-msg_c07r0601_oldwoman2_01', 'If there are people who desire to see them,\nPokémon will appear in many different guises.')
	_END()
