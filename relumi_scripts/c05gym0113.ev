ev_c05gym0113_leader:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C05, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c05gym0113_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 4, 0, 9)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_DIR_CHANGE('C05GYM0113_LEADER', 1)
	_EVENT_CAMERA_INDEX(120)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_AC_ANIM_LOCK('C05GYM0113_LEADER')
	_OBJ_ANIME('C05GYM0113_LEADER', 'anm_c05gym0113_leader_sptrun')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_RELEASE('C05GYM0113_LEADER')
	_OBJ_ANIME('C05GYM0113_LEADER', 'idleanime')
	_OBJ_ANIME_WAIT()
	_NONE_USE_NUMBER('idleanime')
	_OBJ_ANIME('C05GYM0113_LEADER', 'anm_C05GYM0113_leader_01_face04')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_01_1', '<size=250%>Ohohoho!</size>\rFinally, you have arrived!\rSince I came to this region, I always try to learn\nnew things.')
	_OBJ_ANIME('C05GYM0113_LEADER', 'anm_C05GYM0113_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_01_2', 'They hold contest shows in this city?\nI say to myself, enfin, I will excel.\rThat is why I dress this way.\nC’est une performance!\rAlso, I study Pokémon very much. I have come to\nbe Gym Leader.')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_01_3', 'And, uh, so it shall be that you challenge me.\rBut I shall win. That is what a Gym Leader\ndoes, non?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(121)
	_BTL_ENCSEQ_LOAD('gym05')
	_LDVAL(@WK_PLAY_REPO_NO, 9)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c05gym0113_randomteam_fantina')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_EVENT_CAMERA_INDEX(442)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_02', 'I am dumbfounded!\rSo very, very strong! You, your Pokémon,\nso strong!\rYour power is admirable! I shall honor it with this\nGym Badge!')
	_TALK_CLOSE()
	_BADGE_GET(4)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_03', 'You received the Relic Badge from Fantina!')
	_ME_WAIT()
	_SYS_FLAG_BADGE_SET($BADGE_ID_C05)
	_TRAINER_FLAG_SET('CAMPB_11')
	_TRAINER_FLAG_SET('ELITEM_08')
	_TRAINER_FLAG_SET('ELITEW_08')
	_TRAINER_FLAG_SET('MINI_10')
	_TRAINER_FLAG_SET('PICNICG_07')
	_TRAINER_FLAG_SET('SCHOOLB_02')
	_TRAINER_FLAG_SET('SCHOOLG_02')
	_TRAINER_FLAG_SET('TANPAN_15')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6500)
	_LDVAL(@WK_SCENE_C05_MAIN, 1)
	_FLAG_SET(#FV_C05_STOPPER)
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_04', 'That Badge will let you use the hidden move\nDefog from your Pokétch.\rPlease take these Stickers, too. I know you’ll\nmake good use of them.')
	_CB_ITEM_NUM_ADD(51, 1)
	_CB_ITEM_NUM_ADD(52, 1)
	_CB_ITEM_NUM_ADD(55, 3)
	_CB_ITEM_NUM_ADD(84, 2)
	_CB_ITEM_NUM_ADD(12, 3)
	_CB_ITEM_NUM_ADD(33, 1)
	_CB_ITEM_NUM_ADD(34, 1)
	_CB_ITEM_NUM_ADD(36, 1)
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER5_01')
	_SE_PLAY('M_FI014')
	_MACRO_TALKMSG('dialogue_c05gym0113', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c05gym0113_leader_item_get')
anm_C05GYM0113_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_C05GYM0113_leader_01_face04:
	_AC_FACE_INDEX(4)
	_ACMD_END()
	_JUMP('ev_c05gym0113_leader_item_get')
ev_c05gym0113_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 357)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05gym0113_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C05_GYM_ITEM_GET)
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_05', 'That Technical Machine...\nIt contains Shadow Ball.\rA very startling move it is.\nIts hits can reduce Special Defense!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(443)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_EVENT_START()
	_END()
ev_c05gym0113_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c05gym0113_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C05_GYM_ITEM_GET, 'ev_c05gym0113_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c05gym0113_leader_return_match')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_06', 'Three Gym Badges...\rBut you must not forget this: there are many\nother Trainers.\rStrong Trainers, too. There are many more\nin Sinnoh.\rHave patience! You must become stronger,\none at a time.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_c05gym0113_leader_sptrun:
	_AC_INDEX_ANIME(17)
	_AC_WAIT(20)
	_ACMD_END()
ev_c05gym0113_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C05_GYM_RETRUN_MATCH_FIRST, 'pos_c05gym0113_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C05_GYM_RETRUN_MATCH, 'ev_c05gym0113_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_07_01', '<size=250%>Ohohoho!</size>\rWe meet again!\rYou beat the Champion and joined the Hall of\nFame! That is what I heard.\rI lost before. Déplorable! And so I studied more.\nI must have my...how do you say...“revenge”?\rRight now, I will have my revenge!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym05')
	_LDVAL(@WK_PLAY_REPO_NO, 30)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c05gym0113_randomteam_fantina_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_07_02', 'Zut! I am dumbfounded!\rI grew strong. But you grew much, much stronger!')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_07_03', 'Really, you are magnifique!\rI give you the gift of my Sticker!')
	_LDVAL(@SCWK_TEMP0, 51)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C05_GYM_RETRUN_MATCH_FIRST)
	_FLAG_SET(#TMFLG_C05_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c05gym0113_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C05_GYM_RETRUN_MATCH, 'ev_c05gym0113_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_08_01', '<size=250%>Ohohoho!</size>\rToday, yes today, I shall finally have my revenge!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym05')
	_LDVAL(@WK_PLAY_REPO_NO, 30)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c05gym0113_randomteam_fantina_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_08_02', 'Zut! I am dumbfounded!\rI grew strong. But you grew much, much stronger!')
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_07_03', 'Really, you are magnifique!\rI give you the gift of my Sticker!')
	_LDVAL(@SCWK_TEMP0, 51)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C05_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05gym0113_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c05gym0113', '39-msg_c05gym0113_leader_07_04', 'Next time, I shall win! Until then, au revoir!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05gym0113_common_battle_lose:
	_TALK_OBJ_END()
	_EVENT_START()
	_END()
ev_c05gym0113_randomteam_fantina:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 831)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 832)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 833)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 834)
	_RET()
ev_c05gym0113_randomteam_fantina_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 899)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 900)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 901)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 902)
	_RET()