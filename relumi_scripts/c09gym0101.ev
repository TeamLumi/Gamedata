ev_c09gym0101_flag_change:
	_SET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 9500, 'ev_c09gym0101_guide_upd')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 9600, 'ev_c09gym0101_guide_upd')
	_IF_FLAGON_JUMP(#FE_C09_GYMLEADER_DEL, 'ev_c09gym0101_flag_change_gymleader')
	_CALL('ev_block_doc_end')
	_END()
ev_c09gym0101_flag_change_gymleader:
	_CALL('ev_block_doc_end')
	_FLAG_SET(#FV_C09_GYMLEADER)
	_END()
ev_c09gym0101_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 9650)
	_RET()
ev_c09gym0101_guide_upd2:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 9700)
	_RET()
ev_c09gym0101_gym_first:
	_EVENT_START()
	_CALL('ev_block_doc')
	_IFVAL_JUMP(@WK_SCENE_C09GYM0101, 'NE', 0, 'ev_c09gym0101_gym_first_end')
	_EVENT_CAMERA_INDEX(81)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c09gym0101_gym_first01')
	_END()
ev_c09gym0101_gym_first01:
	_EVENT_CAMERA_INDEX(82)
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@WK_SCENE_C09GYM0101, 1)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_c09gym0101_gym_first_end:
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_c09gym0101_randomteam_candice:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 847)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 848)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 849)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 850)
	_RET()
ev_c09gym0101_randomteam_candice_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 915)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 916)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 917)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 918)
	_RET()
ev_c09gym0101_leader:
	_PLAYER_NAME(0)
	_SYS_FLAG_BADGE_GET($BADGE_ID_C09, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c09gym0101_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 11, 4, 4.170000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(83)
	_CALL('ev_block_doc')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('C09GYM0101_LEADER', 'anm_c09gym0101_leader_01_face02')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_01_1', 'You want to challenge Candice?\rSure thing! I was waiting for someone tough!\rBut I should tell you, I’m tough because I know\nhow to focus.')
	_OBJ_ANIME('C09GYM0101_LEADER', 'anm_c09gym0101_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_01_2', 'Pokémon, fashion, romance... It’s all about focus!\nI’ll show you just what I mean. Get ready to lose!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(84)
	_BTL_ENCSEQ_LOAD('gym07')
	_LDVAL(@WK_PLAY_REPO_NO, 14)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c09gym0101_randomteam_candice')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_02_1', 'Wow! You’re great! You’ve earned my respect!\nI think your focus and will bowled us over totally.')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_02_2', 'Oh, that’s right! I’m supposed to give you this!')
	_TALK_CLOSE()
	_BADGE_GET(6)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_03', 'You received the Icicle Badge from Candice.')
	_ME_WAIT()
	_SYS_FLAG_BADGE_SET($BADGE_ID_C09)
	_TRAINER_FLAG_SET('COLDELITEM_06')
	_TRAINER_FLAG_SET('COLDELITEM_07')
	_TRAINER_FLAG_SET('COLDELITEM_09')
	_TRAINER_FLAG_SET('COLDELITEW_06')
	_TRAINER_FLAG_SET('COLDELITEW_07')
	_TRAINER_FLAG_SET('COLDELITEW_09')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 9650, 'ev_c09gym0101_guide_upd2')
	_FLAG_SET(#FV_C07_GINGAM)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_04', 'That Icicle Badge I just gave you?\rBecause you have it, you can use the hidden\nmove Rock Climb from your Pokétch.\rOh, and take these, too.')
	_CB_ITEM_NUM_ADD(57, 6)
	_CB_ITEM_NUM_ADD(58, 4)
	_CB_ITEM_NUM_ADD(10, 2)
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER6_01')
	_SE_PLAY('M_FI014')
	_MACRO_TALKMSG('dialogue_c09gym0101', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c09gym0101_leader_item_get')
	_JUMP('ev_c09gym0101_leader_item_get')
ev_c09gym0101_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 399)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c09gym0101_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C09_GYM_ITEM_GET)
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_ITEM_WAZA_NAME(1, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_05_1', '{0,1,9,0} contains the move\n{1,1,7,0}.', 0, 1)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_05_2', 'If the user takes damage, the move’s power\nis doubled!\rCan you imagine what sort of focus you’d need\nto pull it off?')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
anm_c09gym0101_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c09gym0101_leader_01_face02:
	_AC_FACE_INDEX(2)
	_ACMD_END()
ev_c09gym0101_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_CALL('ev_block_doc_end')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c09gym0101_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C09_GYM_ITEM_GET, 'ev_c09gym0101_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c09gym0101_leader_return_match')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_06', 'Do you think I should try to act more like an\nIce-type Gym Leader? Like, do you think I should\fbe more cool and distant?\rThat sort of thing I have trouble with.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c09gym0101_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C09_GYM_RETRUN_MATCH_FIRST, 'pos_c09gym0101_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C09_GYM_RETRUN_MATCH, 'ev_c09gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_07_01', '{0,1,0,0}! Congrats on getting into the\nHall of Fame!\rI’ve been waiting for you to show up here! After\nall, you not only beat me, you also took out the\fElite Four and basically became an overnight\fcelebrity! That’s about as cool as it gets!\rThanks to you, I’m more focused than ever!\rI still like fashion and romance, but right now I’m\nway more obsessed with you, {0,1,0,0}!\fI really wanna beat you, so get ready for it!', 0, 1)
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym07')
	_LDVAL(@WK_PLAY_REPO_NO, 32)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c09gym0101_randomteam_candice_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_07_02', 'Wow! You really are incredible!\rYou’re even stronger than my high expectations\nof you, {0,1,0,0}!\rIt takes more than focus to be that awesome.\nI guess you call it technique? Something like that!')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_07_03', 'Here, I’ll give you my Sticker. Now we can\nbe twinsies!')
	_LDVAL(@SCWK_TEMP0, 57)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C09_GYM_RETRUN_MATCH_FIRST)
	_FLAG_SET(#TMFLG_C09_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c09gym0101_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C09_GYM_RETRUN_MATCH, 'ev_c09gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_08_01', '{0,1,0,0}! I’ve been waiting for you to\nshow up here!\rAnd I think my technique and focus have gotten\na little better, maybe?', 0, 1)
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym07')
	_LDVAL(@WK_PLAY_REPO_NO, 32)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c09gym0101_randomteam_candice_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_08_02', 'Wow! You really are incredible!\rThat’s some high-level battle technique you’ve\ngot there, {0,1,0,0}!')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_07_03', 'Here, I’ll give you my Sticker. Now we can\nbe twinsies!')
	_LDVAL(@SCWK_TEMP0, 57)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C09_GYM_RETRUN_MATCH_FIRST)
	_FLAG_SET(#TMFLG_C09_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
	_NONE_USE_NUMBER()
ev_c09gym0101_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_leader_07_04', 'Anyway, come back here any time you like!\rI wanna learn more about technique and focus\nfrom you, {0,1,0,0}, so I can get\feven stronger!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c09gym0101_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c09gym0101_advice:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C09, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c09gym0101_advice_02')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_sunglaases_01_1', 'Hey there!\nHow’s it going, Champ-to-be?\rDo you see the big snowballs placed here and there?\rYou need to slide on the ice with enough\nmomentum to crush them.')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_sunglaases_01_2', 'The Gym Leader is a user of\nIce-type Pokémon.\rDue to all the ice around,\nthey’re great with avoiding weird stuff thrown out on the ground!\rIce-type Pokémon don’t even flinch at the Hail\nalways flying around, either!')
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_sunglaases_01_3', 'It’s all about focus with this Gym.\nBear down and focus!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c09gym0101_advice_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_sunglaases_02', 'Oh! {0,1,0,0}! You’ve beaten the\nGym Leader!\rYou were more focused than her, and your\nPokémon picked up on it!', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c09gym0101_statue:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C09, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c09gym0101_statue_02')
	_RIVAL_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_statue_01', 'Snowpoint City Pokémon Gym\nGym Leader: Candice\fCertified Trainers: {1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c09gym0101_statue_02:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_RIVAL_NAME(2)
	_MACRO_TALKMSG('dialogue_c09gym0101', '194-msg_c09gym0101_statue_02', 'Snowpoint City Pokémon Gym\nGym Leader: Candice\rCertified Trainers: {0,1,0,0}\n{1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()