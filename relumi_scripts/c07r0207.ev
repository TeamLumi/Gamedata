ev_c07r0207_shop4_no_stock:
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop4_no_stock', 'I am so upset!\rOne of the other merchants took my Lava\nCookie business!\rI’ll have to find something else to sell, I\nguess...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
