ev_c07r0207_shop4_start:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2401, 'ev_c07r0207_shop4_no_stock')
	_MONEY_OPEN()
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop4_start', 'Hello, there.\rWould you like some Lava Cookies?\nThey’re 200 each.')
	_EVENT_CAMERA_INDEX(300)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Lava_1', 'I’ll buy 1 for 240', 3)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Lava_10', 'I’ll buy 10 for 2,400', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_844', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(3, 'ev_c07r0207_shop4_buy_1')
	_CASE_JUMP(2, 'ev_c07r0207_shop4_buy_10')
	_CASE_JUMP(1, 'ev_c07r0207_shop4_no')
	_JUMP('ev_c07r0207_shop4_no')
	_END()
ev_c07r0207_shop4_buy_1:
	_COMP_GOLD(@SCWK_ANSWER, 240)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0207_shop4_no_money')
	_LDVAL(@SCWK_TEMP0, 42)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0207_shop4_item_full')
	_SE_PLAY('S_ME050')
	_SE_WAIT('S_ME050')
	_SUB_GOLD(240)
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c07r0207', 'ev_c07r0207_shop4_buy_1', 'Here you go, one Lava Cookie.\nThank you.')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop4_buy_10:
	_COMP_GOLD(@SCWK_ANSWER, 2400)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0207_shop4_no_money')
	_LDVAL(@SCWK_TEMP0, 42)
	_LDVAL(@SCWK_TEMP1, 10)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0207_shop4_item_full')
	_SE_PLAY('S_ME050')
	_SE_WAIT('S_ME050')
	_SUB_GOLD(2400)
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c07r0207', 'ev_c07r0207_shop4_buy_10', 'Here you go, ten Lava Cookies.\nThank you.')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop4_no:
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop3_no', 'Please come again.')
