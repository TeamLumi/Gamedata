ev_c07r0207_flag_change:
	_LDVAL(@WK_ELEVATOR_FLOOR, 0)
	_END()
ev_c07r0207_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0207', 'msg_c07r0207_poster_01', 'This is the <color=#F01E1EFF>basement</color>.\rB1F: Food & Produce\n1F: Trainers’ Zone\f2F: Battle Collection\f3F: TM Corner\f4F: Pedestal Floor\f5F: Rooftop Plaza')
	_END()
ev_c07r0207_woman1:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0207', 'msg_c07r0207_woman1', 'Have you ever planted Berries, then promptly\nforgotten about them?\rIf that’s you, we have Berries on sale, too.')
	_END()
ev_c07r0207_woman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0207', 'msg_c07r0207_woman2', 'Welcome to the basement—the food and\nproduce section.\rWe offer a fine and pleasing selection of\nPokémon food and treats.')
	_END()
ev_c07r0207_shop1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2401, 'ev_c07r0207_shop1_restock')
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop1', 'Hello!\nRage Candy Bars...\rI’m all sold out.\nI’m terribly sorry.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop1_restock:
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop1_restock', 'Hello!\nRage Candy Bars...\rI’ve got ’em!\rI’ve also got a new and improved range of\nRegional Delicacies to select from!\rWhat’ll it be?')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c07r0207_shop1_restock_window')
	_END()
ev_c07r0207_shop1_restock_window:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c07r0207_shop1_restock_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c07r0207_shop1_restock_buy')
	_CASE_JUMP(1, 'ev_c07r0207_shop1_restock_sell')
	_CASE_JUMP(2, 'ev_c07r0207_shop1_restock_end')
	_JUMP('ev_c07r0207_shop1_restock_end')
	_END()
ev_c07r0207_shop1_restock_sonohoka:
	_MACRO_TALKMSG('dialogue_c07r0207', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c07r0207_shop1_restock_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_GET_GOLD(@LOCALWORK10)
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(18)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_GET_GOLD(@LOCALWORK11)
	_IFVAL_CALL(@LOCALWORK10, 'GT', @LOCALWORK11, 'ev_c07r0207_depart_count')
	_JUMP('ev_c07r0207_shop1_restock_window')
	_END()
ev_c07r0207_shop1_restock_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_c07r0207_shop1_restock_window')
	_END()
ev_c07r0207_shop1_restock_end:
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop1_restock_end', 'Please shop with me again soon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_lady1:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0207', 'msg_c07r0207_lady1', 'I’m hopeless at cooking Poffins, so I buy\nthem here.\rI wish I could feed my babies Poffins that I\nmade myself, though.')
	_END()
ev_c07r0207_lady2:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0207', 'msg_c07r0207_lady2', 'Pay attention, please.\rThe flavors of Poffins affect the condition of\nPokémon.\rSpicy Poffins enhance coolness.\rDry Poffins enhance beauty.\rSweet Poffins enhance cuteness.\rBitter Poffins enhance smartness.\rAnd Sour Poffins enhance toughness.\rSigh...\nPoffins are wonderful, aren’t they?')
	_END()
ev_c07r0207_gentleman1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2401, 'ev_c07r0207_gentleman1_no_sale')
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_gentleman1', 'I didn’t expect to find paradise in the\ndepartment store’s basement.\rI got carried away and bought up all the\nRage Candy Bars!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_gentleman1_no_sale:
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_gentleman1_no_sale', 'My subterranean paradise is no more.\rThey will no longer allow me to buy up all of\nthe Rage Candy Bar stock.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_depart_count:
	_ADD_WK(@SYS_WORK_DEPART_COUNT, 1)
	_RET()
