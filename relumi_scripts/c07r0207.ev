ev_c07r0207_shop3_start:
	_TALK_OBJ_START()
	_MONEY_OPEN()
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop3_start', 'Hello!\nI sell Poffins.\rThe ones I sell go for 6,400 each.\nWould you like one?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_041', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_042', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(2, 'ev_c07r0207_shop3_check')
	_CASE_JUMP(1, 'ev_c07r0207_shop3_no')
	_JUMP('ev_c07r0207_shop3_no')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop3_check:
	_ITEM_CHK(449, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0207_shop3_porutocase')
	_CHECK_POFIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0207_shop3_poruto')
	_JUMP('ev_c07r0207_shop3_buy')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop3_porutocase:
	_MACRO_TALKMSG('dialogue_c07r0207', 'ev_c07r0207_shop3_porutocase', 'I’m so sorry.\rWe can’t sell Poffins if you don’t have a Poffin\nCase for them.')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop3_poruto:
	_TALKMSG('dp_poffin_main%DP_poffin_main_099')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0207_shop3_buy:
	_MACRO_TALKMSG('dialogue_c07r0207', 'msg_c07r0207_shop3_buy', 'Which Poffin would you like?')
	_EVENT_CAMERA_INDEX(300)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Spicy_Dry', 'Spicy-Dry Poffin', 11)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Spicy_Sweet', 'Spicy-Sweet Poffin', 10)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Spicy_Bitter', 'Spicy-Bitter Poffin', 9)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Spicy_Sour', 'Spicy-Sour Poffin', 8)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Dry_Sweet', 'Dry-Sweet Poffin', 7)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Dry_Bitter', 'Dry-Bitter Poffin', 6)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Dry_Sour', 'Dry-Sour Poffin', 5)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Sweet_Bitter', 'Sweet-Bitter Poffin', 4)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Sweet_Sour', 'Sweet-Sour Poffin', 3)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Poffin_Bitter_Sour', 'Bitter-Sour Poffin', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_844', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 11, 'ev_c07r0207_shop3_poruto_spicy_dry')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 10, 'ev_c07r0207_shop3_poruto_spicy_sweet')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 9, 'ev_c07r0207_shop3_poruto_spicy_bitter')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 8, 'ev_c07r0207_shop3_poruto_spicy_sour')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_c07r0207_shop3_poruto_dry_sweet')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 6, 'ev_c07r0207_shop3_poruto_dry_bitter')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 5, 'ev_c07r0207_shop3_poruto_dry_sour')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'ev_c07r0207_shop3_poruto_sweet_bitter')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 3, 'ev_c07r0207_shop3_poruto_sweet_sour')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'ev_c07r0207_shop3_poruto_bitter_sour')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_c07r0207_shop3_cancel')
	_JUMP('ev_c07r0207_shop3_cancel')
	_MONEY_CLOSE()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
