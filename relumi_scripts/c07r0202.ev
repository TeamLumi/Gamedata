ev_c07r0202_depart:
	_TALK_OBJ_START()
	_REGULAR_CHECK(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c07r0202_regular_check')
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_01', 'Hello. May I help you with anything?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_229', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_228', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'c07r0202_randam_osusume')
	_CASE_JUMP(0, 'ev_c07r0202_depart_03')
	_JUMP('c07r0202_randam_osusume')
c07r0202_regular_check:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_02', 'Hello, {0,1,0,0}.\nMay I help you with anything?', 0, 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_229', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_228', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'c07r0202_randam_osusume')
	_CASE_JUMP(0, 'ev_c07r0202_depart_03')
	_JUMP('c07r0202_randam_osusume')
c07r0202_randam_osusume:
	_GET_RND(@SCWK_ANSWER, 4)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0202_depart_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07r0202_depart_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c07r0202_depart_06')
	_JUMP('ev_c07r0202_depart_07')
	_END()
ev_c07r0202_depart_03:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_03', 'Please enjoy yourself.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_depart_04:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_04', 'Would you care for a bottle of Protein?\rIt’s a drink that boosts the base points of a\nPokémon’s Attack stat.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_depart_05:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_05', 'May I suggest a bottle of Carbos?\rIt’s a drink that boosts the base points of a\nPokémon’s Speed stat.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_depart_06:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_06', 'If you need to make sure that your Pokémon’s\nattacks hit hard, then Dire Hit is for you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_depart_07:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_depart_07', 'If your Pokémon has trouble landing attacks,\ntry treating it to an X Accuracy.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_gorggeousw:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0202', '97-msg_c07r0202_gorggeousw_01', 'Where can I find a dress that looks great in a\nSuper Contest Show?')
	_END()
ev_c07r0202_boy3:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0202', '97-msg_c07r0202_boy3_01', 'I’m going to give an HP Up to my Kricketot.\rThis is going to raise its base HP, huh?')
	_END()
ev_c07r0202_shopm:
	_TALK_OBJ_START()
	_LDVAL(@SCWK_ANSWER, 0)
	_POKETCH_CHECK(9, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07r0202_shoopm_03')
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_shopwoman_01', 'We’re giving away a Pokétch app for free as\na promotion.\rI can give you the Counter app over the counter.\nWould you like it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07r0202_shoopm_04')
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_shopwoman_02', 'OK, here’s the app. Now go forth and count!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_shoopm_03:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_shopwoman_03', 'I hope you’re using that Counter app I gave you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_shoopm_04:
	_MACRO_TALKMSG('dialogue_c07r0202', '97-msg_c07r0202_shopwoman_04', 'You’re not interested? Please come back if you\nchange your mind.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0202_shopm_01:
	_EASY_OBJ_MSG('97-msg_c07r0202_shopm_01')
	_END()
ev_c07r0202_fix_shop_01:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c07r0202_01_fix_shop_re')
	_END()
ev_c07r0202_01_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c07r0202_01_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c07r0202_01_fix_shop_buy')
	_CASE_JUMP(1, 'ev_c07r0202_01_fix_shop_sell')
	_CASE_JUMP(2, 'ev_c07r0202_01_fix_shop_end')
	_JUMP('ev_c07r0202_01_fix_shop_end')
	_END()
ev_c07r0202_01_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c07r0202', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c07r0202_01_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_GET_GOLD(@LOCALWORK10)
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(5)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_GET_GOLD(@LOCALWORK11)
	_IFVAL_CALL(@LOCALWORK10, 'GT', @LOCALWORK11, 'ev_c07r0202_depart_count')
	_JUMP('ev_c07r0202_01_fix_shop_re')
	_END()
ev_c07r0202_depart_count:
	_ADD_WK(@SYS_WORK_DEPART_COUNT, 1)
	_RET()
ev_c07r0202_01_fix_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_c07r0202_01_fix_shop_re')
	_END()
ev_c07r0202_01_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
