ev_namechange:
	_TALK_OBJ_START_TURN_NOT()
	_EVENT_START()
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_01', 'Hello, hello! I am the official Name Rater!\rWant me to rate the nicknames of\nyour Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_namechange_yes_01')
	_JUMP('ev_namechange_no_01')
	_END()
ev_namechange_yes_01:
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_02', 'Which Pokémon’s nickname should I critique?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_POKELIST_SET_PROC(13)
	_POKELIST_GET_RESULT(@SCWK_PARAM2, @SCWK_PARAM3)
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@SCWK_ANSWER, @SCWK_PARAM2)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_namechange_no_01')
	_LDVAL(@SCWK_TEMP1, @SCWK_ANSWER)
	_ALL_MONSNO(@SCWK_PARAM2, @SCWK_PARAM3, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_namechange_tamago')
	_ALL_MONS_OWN_CHK(@SCWK_PARAM2, @SCWK_PARAM3, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_namechange_other')
	_NICK_NAME_ALL(0, @SCWK_PARAM2, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_03', '{0,1,2,0}, is it? That’s a\ndecent nickname!\rBut would you like to give it an even\nbetter name? How about it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_namechange_yes_02')
	_JUMP('ev_namechange_no_01')
	_END()
ev_namechange_no_01:
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_06', 'I see. Please come visit again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_namechange_tamago:
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_09', 'Now, now. That is merely an Egg! An Egg can go\nby no other name!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_namechange_other:
	_NICK_NAME_ALL(0, @SCWK_PARAM2, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_08', '{0,1,2,0}, is it? That is a truly\nimpeccable name!\rTake good care of {0,1,2,0}!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_namechange_yes_02:
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_04', 'Ah, good. Then what shall the new nickname be?')
	_TALK_CLOSE()
	_LDVAL(@SCWK_ANSWER, 0)
	_EVENT_CAMERA_INDEX(115)
	_NAMEIN_POKE(@SCWK_PARAM2, @SCWK_PARAM3, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_namechange_no_02')
	_TV_ENTRY_WATCH_CHANGE_NAME(@SCWK_PARAM2, @SCWK_PARAM3)
	_NICK_NAME_ALL(0, @SCWK_PARAM2, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_05', 'Done! From now on, this Pokémon shall be\nknown as {0,1,2,0}!\rThat’s a better name than before! How fortunate\nfor you!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_namechange_no_02:
	_NICK_NAME_ALL(0, @SCWK_PARAM2, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_namechange_07', 'Done! From now on, this Pokémon shall be\nknown as {0,1,2,0}!\rThe name looks no different from before, and\nyet it is vastly superior! How fortunate for you!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c04r0301_babyboy1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_c04r0301_babyboy1_01', 'Snorunt is my favorite Pokémon!\nIt is both a Grass-type and an Ice-type.\rThat means that it will resist Gym Leader\nGardenia’s most powerful moves and it can\fdeal super-effective damage to her Pokémon\fwith some of its most powerful moves!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_middleman1:
	_TALK_OBJ_START()
	_GET_TIME_ZONE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_c04r0301_middleman1_02')
	_JUMP('ev_c04r0301_middleman1_01')
	_END()
ev_c04r0301_middleman1_01:
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_c04r0301_middleman1_01', 'Hi! I’m the building superintendent. I maintain a\nvigilant 24-hour watch!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_middleman1_02:
	_MACRO_TALKMSG('dialogue_c04r0301', '9-msg_c04r0301_middleman1_02', 'I’m...building...superintendent... Maintain...\n24-hour watch... Zzz...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy:
	_TALK_OBJ_START_TURN_NOT()
	_IF_FLAGON_JUMP(#2638, 'ev_c04r0301_mint_guy_common')
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_01', 'Hello, hello!\nI love the Pokémon Abra!\rFor every Abra that you gift to me, I will give\nyou as many mints as you can handle, that\fmatch the boosted statistic of that Abra.\rMints are an incredibly powerful item indeed!\rThey can change the Nature of any Pokémon\nthat you feed them to.\rDo we have a deal, youngster?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04r0301_mint_guy_yes')
	_JUMP('ev_c04r0301_mint_guy_no')
ev_c04r0301_mint_guy_yes:
	_FLAG_SET(#2638)
	_JUMP('ev_c04r0301_mint_guy_common')
ev_c04r0301_mint_guy_no:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_no', 'Very well.\rI’ll be here if you change your mind.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy_quest_complete:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_quest_complete', 'My, my! I think that may just be every stat\nboosting Abra that I was looking for.\rI am deeply grateful to you for uniting me with\nso many creatures with such a variety of traits.')
	_FLAG_SET(#2645); Abra Man Mint Guy Quest complete
	_RET()
ev_c04r0301_mint_guy_common:
	_IF_FLAGON_JUMP(#2645, 'ev_c04r0301_mint_guy_common_complete')
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_show', 'Oh! Do you have an Abra to give me?\nOr would you like some mints?')
	_JUMP('ev_c04r0301_mint_guy_common_options')
ev_c04r0301_mint_guy_common_again:
	_IF_FLAGON_JUMP(#2645, 'ev_c04r0301_mint_guy_common_again_complete')
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_show_again', 'Have you another Abra to give me?\nOr would you like some mints?')
	_JUMP('ev_c04r0301_mint_guy_common_options')
ev_c04r0301_mint_guy_common_complete:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_common_complete', 'Hello, my young friend!\nWould you like some mints?')
	_JUMP('ev_c04r0301_mint_guy_common_options')
ev_c04r0301_mint_guy_common_again_complete:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_common_again_complete', 'Would you like any more mints?')
	_JUMP('ev_c04r0301_mint_guy_common_options')
ev_c04r0301_mint_guy_common_options:
	_IF_FLAGOFF_CALL(#2645, 'ev_c04r0301_mint_guy_common_options_give')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_mintguy_get_mints', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_training_cancel', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(2, 'ev_c04r0301_mint_guy_give_abra')
	_CASE_JUMP(1, 'ev_c04r0301_mint_guy_get_mints')
	_CASE_JUMP(0, 'ev_c04r0301_mint_guy_cancel')
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy_common_options_give:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_mintguy_give', 2)
	_RET()
ev_c04r0301_mint_guy_cancel:
	_MACRO_TALK_KEYWAIT('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_cancel_2', 'Oh, bye bye!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy_not_abra:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_invalid_abra', 'That’s not an Abra.\nPlease come back when you have an Abra to give me.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy_invalid_abra_nature:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_invalid_abra_nature', 'I’m sorry, but you have already given me an\nAbra with a Nature that boosts this stat.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy_last_chance:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_last_chance', 'Are you sure that you want to give me this\nlovely Abra?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04r0301_mint_guy_no')
	_IFVAL_CALL(@LOCALWORK1, 'EQ', -1, 'ev_c04r0301_mint_guy_party_check')
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_last_chance_yes_1', 'Thank you!\nI promise to cherish it dearly.')
	_VOICE_PLAY(63, 0, 0)
	_NICK_NAME_ALL(0, @LOCALWORK0, @LOCALWORK1)
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_last_chance_yes_2', '{0} went with The Abra Man.')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_RELEASE_BOX_POKE(@LOCALWORK0, @LOCALWORK1)
	_RET()
ev_c04r0301_mint_guy_party_check:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 2, 'ev_c04r0301_mint_guy_party_last_poke')
	_RET()
ev_c04r0301_mint_guy_party_last_poke:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_party_last_poke', 'Oh, I am sorry but I couldn’t possibly deprive\nyou of the only Pokémon in your party.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0301_mint_guy_give_abra:
	_POKELIST_SET_PROC(33); Sets BoxOpenParam to any Abra
	_POKELIST_GET_RESULT(@LOCALWORK0, @LOCALWORK1); Opens Box Pokémon Selection
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', -1, 'ev_c04r0301_mint_guy_cancel'); If the player cancels without selecting a Pokémon, jump to cancel script
    _TEMOTI_BOX_MONSNO(@LOCALWORK0, @LOCALWORK1, @LOCALWORK2); Gets the MonsNo of the given Pokémon and stores the result in @LOCALWORK2
	_TEMOTI_BOX_SHINY(@LOCALWORK0, @LOCALWORK1, @LOCALWORK3); Gets the Shinyness of the given Pokémon and stores the result in @LOCALWORK3
	_GET_BOX_POKE_SEIKAKU(@LOCALWORK0, @LOCALWORK1, @LOCALWORK4); Gets the Nature of the given Pokémon and stores the result in @LOCALWORK4
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 63, 'ev_c04r0301_mint_guy_nature_check'); If the selected Pokémon was Abra, jump to Nature check
    _JUMP('ev_c04r0301_mint_guy_not_abra'); If the selected Pokémon was not Abra, jump to invalid Pokémon script
ev_c04r0301_mint_guy_nature_check:
	_SWITCH(@LOCALWORK4)
	_CASE_CALL(0, 'ev_c04r0301_mint_guy_found_abra_neutral')
	_CASE_CALL(1, 'ev_c04r0301_mint_guy_found_abra_attack')
	_CASE_CALL(2, 'ev_c04r0301_mint_guy_found_abra_attack')
	_CASE_CALL(3, 'ev_c04r0301_mint_guy_found_abra_attack')
	_CASE_CALL(4, 'ev_c04r0301_mint_guy_found_abra_attack')
	_CASE_CALL(5, 'ev_c04r0301_mint_guy_found_abra_defense')
	_CASE_CALL(6, 'ev_c04r0301_mint_guy_found_abra_neutral')
	_CASE_CALL(7, 'ev_c04r0301_mint_guy_found_abra_defense')
	_CASE_CALL(8, 'ev_c04r0301_mint_guy_found_abra_defense')
	_CASE_CALL(9, 'ev_c04r0301_mint_guy_found_abra_defense')
	_CASE_CALL(10, 'ev_c04r0301_mint_guy_found_abra_speed')
	_CASE_CALL(11, 'ev_c04r0301_mint_guy_found_abra_speed')
	_CASE_CALL(12, 'ev_c04r0301_mint_guy_found_abra_neutral')
	_CASE_CALL(13, 'ev_c04r0301_mint_guy_found_abra_speed')
	_CASE_CALL(14, 'ev_c04r0301_mint_guy_found_abra_speed')
	_CASE_CALL(15, 'ev_c04r0301_mint_guy_found_abra_spatk')
	_CASE_CALL(16, 'ev_c04r0301_mint_guy_found_abra_spatk')
	_CASE_CALL(17, 'ev_c04r0301_mint_guy_found_abra_spatk')
	_CASE_CALL(18, 'ev_c04r0301_mint_guy_found_abra_neutral')
	_CASE_CALL(19, 'ev_c04r0301_mint_guy_found_abra_spatk')
	_CASE_CALL(20, 'ev_c04r0301_mint_guy_found_abra_spdef')
	_CASE_CALL(21, 'ev_c04r0301_mint_guy_found_abra_spdef')
	_CASE_CALL(22, 'ev_c04r0301_mint_guy_found_abra_spdef')
	_CASE_CALL(23, 'ev_c04r0301_mint_guy_found_abra_spdef')
	_CASE_CALL(24, 'ev_c04r0301_mint_guy_found_abra_neutral')
	_JUMP('ev_c04r0301_mint_guy_common_again')
ev_c04r0301_mint_guy_found_abra_neutral:
	_IF_FLAGON_JUMP(#2639, 'ev_c04r0301_mint_guy_invalid_abra_nature')
	_CALL('ev_c04r0301_mint_guy_found_abra_common')
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_no_mint_for_nature', '{0} actually happens to be a neutral nature.\nIt will not increase or decrease any stats.\rI can still give you Neutral Mints in return for\nthis beautiful Abra, though!')
	_CALL('ev_c04r0301_mint_guy_last_chance')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 0, 'ev_c04r0301_mint_guy_create_neutral_placedata')
	_IFVAL_CALL(@LOCALWORK3, 'GE', 1, 'ev_c04r0301_mint_guy_create_neutral_placedata_shiny')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_found_abra_neutral', 'Neutral mints are now unlocked!')
	_FLAG_SET(#2639); Enable neutral mints
	_ADD_WK(@522, 1)
	_IFVAL_CALL(@522, 'EQ', 6, 'ev_c04r0301_mint_guy_quest_complete')
	_RET()
ev_c04r0301_mint_guy_found_abra_attack:
	_IF_FLAGON_JUMP(#2640, 'ev_c04r0301_mint_guy_invalid_abra_nature')
	_CALL('ev_c04r0301_mint_guy_found_abra_common')
	_CALL('ev_c04r0301_mint_guy_last_chance')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 0, 'ev_c04r0301_mint_guy_create_attack_placedata')
	_IFVAL_CALL(@LOCALWORK3, 'GE', 1, 'ev_c04r0301_mint_guy_create_attack_placedata_shiny')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_found_abra_attack', 'Attack boosting mints are now unlocked!')
	_FLAG_SET(#2640); Enable attack mints
	_ADD_WK(@522, 1)
	_IFVAL_CALL(@522, 'EQ', 6, 'ev_c04r0301_mint_guy_quest_complete')
	_RET()
ev_c04r0301_mint_guy_found_abra_defense:
	_IF_FLAGON_JUMP(#2641, 'ev_c04r0301_mint_guy_invalid_abra_nature')
	_CALL('ev_c04r0301_mint_guy_found_abra_common')
	_CALL('ev_c04r0301_mint_guy_last_chance')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 0, 'ev_c04r0301_mint_guy_create_defense_placedata')
	_IFVAL_CALL(@LOCALWORK3, 'GE', 1, 'ev_c04r0301_mint_guy_create_defense_placedata_shiny')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_found_abra_defense', 'Defense boosting mints are now unlocked!')
	_FLAG_SET(#2641); Enable defense mints
	_ADD_WK(@522, 1)
	_IFVAL_CALL(@522, 'EQ', 6, 'ev_c04r0301_mint_guy_quest_complete')
	_RET()
ev_c04r0301_mint_guy_found_abra_speed:
	_IF_FLAGON_JUMP(#2642, 'ev_c04r0301_mint_guy_invalid_abra_nature')
	_CALL('ev_c04r0301_mint_guy_found_abra_common')
	_CALL('ev_c04r0301_mint_guy_last_chance')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 0, 'ev_c04r0301_mint_guy_create_speed_placedata')
	_IFVAL_CALL(@LOCALWORK3, 'GE', 1, 'ev_c04r0301_mint_guy_create_speed_placedata_shiny')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_found_abra_speed', 'Speed boosting mints are now unlocked!')
	_FLAG_SET(#2642); Enable speed mints
	_ADD_WK(@522, 1)
	_IFVAL_CALL(@522, 'EQ', 6, 'ev_c04r0301_mint_guy_quest_complete')
	_RET()
ev_c04r0301_mint_guy_found_abra_spatk:
	_IF_FLAGON_JUMP(#2643, 'ev_c04r0301_mint_guy_invalid_abra_nature')
	_CALL('ev_c04r0301_mint_guy_found_abra_common')
	_CALL('ev_c04r0301_mint_guy_last_chance')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 0, 'ev_c04r0301_mint_guy_create_spatk_placedata')
	_IFVAL_CALL(@LOCALWORK3, 'GE', 1, 'ev_c04r0301_mint_guy_create_spatk_placedata_shiny')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_found_abra_spatk', 'Sp. Attack boosting mints are now unlocked!')
	_FLAG_SET(#2643); Enable spatk mints
	_ADD_WK(@522, 1)
	_IFVAL_CALL(@522, 'EQ', 6, 'ev_c04r0301_mint_guy_quest_complete')
	_RET()
ev_c04r0301_mint_guy_found_abra_spdef:
	_IF_FLAGON_JUMP(#2644, 'ev_c04r0301_mint_guy_invalid_abra_nature')
	_CALL('ev_c04r0301_mint_guy_found_abra_common')
	_CALL('ev_c04r0301_mint_guy_last_chance')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 0, 'ev_c04r0301_mint_guy_create_spdef_placedata')
	_IFVAL_CALL(@LOCALWORK3, 'GE', 1, 'ev_c04r0301_mint_guy_create_spdef_placedata_shiny')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_c04r0301_mint_guy_found_abra_spdef', 'Sp. Defense boosting mints are now unlocked!')
	_FLAG_SET(#2644); Enable spdef mints
	_ADD_WK(@522, 1)
	_IFVAL_CALL(@522, 'EQ', 6, 'ev_c04r0301_mint_guy_quest_complete')
	_RET()
ev_c04r0301_mint_guy_found_abra_common:
	_SEIKAKU_NAME(0, @LOCALWORK4); Stores the Nature name in tag 0
	_IFVAL_JUMP(@LOCALWORK4, 'EQ', 3, 'ev_c04r0301_mint_guy_found_an_abra_common'); Adamant
	_IFVAL_JUMP(@LOCALWORK4, 'EQ', 8, 'ev_c04r0301_mint_guy_found_an_abra_common'); Impish
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_mintguy_found_unique_abra', 'Oh! That’s a {0} Abra! I’m so happy!')
	_RET()
ev_c04r0301_mint_guy_found_an_abra_common:
	_MACRO_TALKMSG('dialogue_c04r0301', '00_msg_mintguy_found_an_unique_abra', 'Oh! That’s an {0} Abra! I’m so happy!')
	_RET()
ev_c04r0301_mint_guy_create_neutral_placedata:
	_OBJ_ADD('C04R0301_NEUTRAL_ABRA')
	_FLAG_RESET(#2897)
	_RET()
ev_c04r0301_mint_guy_create_neutral_placedata_shiny:
	_OBJ_ADD('C04R0301_NEUTRAL_ABRA_SHINY')
	_FLAG_RESET(#2898)
	_RET()
ev_c04r0301_mint_guy_create_attack_placedata:
	_OBJ_ADD('C04R0301_ATTACK_ABRA')
