	_AC_LEFT(3, 8)
	_AC_DIR_D(8)
	_AC_DOWN(10, 8)
	_ACMD_END()
anm_c04_champ_outside_gym_face_right:
	_AC_DIR_R(8)
	_ACMD_END()
