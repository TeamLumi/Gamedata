	_AC_LEFT(1, 8)
	_ACMD_END()
ev_c04_champ_outside_gym_2: ; Check if needed
	_TALK_OBJ_START()
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champ_outside_gym_face_right')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c04_champ_outside_gym_blocker')
ev_c04_champ_outside_gym_blocker:
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_4', 'Oh, wait!\rDon’t leave without this Pokémon Egg.\nPlease? I want you to have it.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c04_champ_outside_gym_blocker')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET(#FV_C04_CHAMP)
	_TALK_OBJ_END()
	_END()
ev_c04_champ_outside_gym_3:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_C04, 'EQ', 4, 'ev_c04_champ_outside_gym_talk')
	_TALK_OBJ_END()
	_END()
ev_c04_champ_outside_gym_talk:
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_5', 'Well?\nWill you accept this Pokémon Egg?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04_champ_outside_gym_decline_3')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_c04_champ_outside_gym_full_party_3'); Party and Boxes are full
	_CALL('ev_c04_champ_outside_gym_give_egg')
	_PLAYER_DIR_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04_champ_outside_gym_exit_1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04_champ_outside_gym_exit_2')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c04_champ_outside_gym_exit_3')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_c04_champ_outside_gym_exit_4')
	_JUMP('ev_c04_champ_outside_gym_exit_4')
	_END()
ev_c04_champ_outside_gym_decline_3:
	_CALL('ev_c04_champ_outside_gym_decline_2')
	_JUMP('ev_c04_champ_outside_gym_event_end_2')
ev_c04_champ_outside_gym_full_party_3:
	_CALL('ev_c04_champ_outside_gym_full_party_2')
	_JUMP('ev_c04_champ_outside_gym_event_end_2')
ev_c04_champ_outside_gym_give_egg:
	_SE_PLAY('M_FI013')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c01r0701', 'msg_c04_champ_outside_gym_give_egg', '{0,1,0,0} received a Pokémon Egg!')
	_CALL('ev_c04_champion_get_valid_egg'); (Putting this before the _ME_WAIT gives the game some time to do the RNG loops and read from the JSONs)
	_ME_WAIT()
	_ADD_TAMAGO_EXTRA(@SCWK_TEMP0, @SCWK_TEMP1, 60011); MonsNo, FormNo, RecievedFrom
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_6', 'That’s wonderful!\rThe Pokémon inside the Egg is happy, too.\nI’m sure of it!')
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_7', 'Keep that Egg with you in your party of\nPokémon.\rA Pokémon will hatch from it while you\nare traveling.\rI would be happy to know that it will\nhelp fill another page of your Pokédex.\rSee you again!')
	_TALK_CLOSE()
	_LDVAL(@WK_SCENE_C04, 5)
	_FLAG_SET(#2779); Cynthia egg event finished
	_FLAG_SET(#2618); Kill the R206R0101 blockers
	_RET()
ev_c04_champion_get_valid_egg:
	_TIME_WAIT(1, @SCWK_ANSWER)
	_GET_TABLE_POKE(19, @SCWK_TEMP0, @SCWK_TEMP1); Table, MonsNo, FormNo
	_TIME_WAIT(1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', @465, 'ev_c04_champion_get_valid_egg_loop')
	_RET()
ev_c04_champion_get_valid_egg_loop:
	_TIME_WAIT(1, @SCWK_ANSWER)
	_GET_TABLE_POKE(19, @SCWK_TEMP0, @SCWK_TEMP1); Table, MonsNo, FormNo
	_TIME_WAIT(1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', @465, 'ev_c04_champion_get_valid_egg')
	_RET()
