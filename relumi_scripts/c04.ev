ev_c04_ev_trainer:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04', '00_msg_c04_ev_trainer_1', 'Hey there!\nI’m Evey, the best darn rancher in Sinnoh.\rI’m here to help you get your\nPokémon in fightin’ shape!')
	_MACRO_TALKMSG('dialogue_c04', '00_msg_c04_ev_trainer_2', 'Do you want to fight my Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_evtrain_xp25')
	_MACRO_TALKMSG('dialogue_c04', '00_msg_c04_ev_trainer_3', 'See ya!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()