ev_c04_rival_statue:
	_RIVAL_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_rival_3', 'What the...')
	_TALK_CLOSE()
	;_DUMMY_SET_POS(323, 524)
	_DUMMY_SET_POS_HERO()
	_CAMERA_TARGET_DUMMY()
	_DUMMY_ANIME('anm_c04_camera_move_to_statue')
	_DUMMY_ANIME_WAIT()
	;_DUMMY_ANIME('anm_c04_rival_action_64')
	;_DUMMY_ANIME_WAIT()
	; Lock Camera to 323, 524
	; Pan Camera per Action#64
	; Wait for Camera movement
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_rival_4', '...So, this is Eterna’s Pokémon\nstatue...\rShaping our world are time and space\nin an intertwining spiral.\rRevered in Sinnoh are the Pokémon of\ntime and space...\rSinnoh’s myth...\nIts truth needs investigation...')
	_TALK_CLOSE()
	_TIME_WAIT(60, @SCWK_ANSWER)
	_OBJ_ANIME('C04_CYRUS', 'anm_c04_cyrus_leave_statue')
	_DUMMY_ANIME('anm_c04_camera_return_to_player')
	_DUMMY_ANIME_WAIT()
	; Animate the camera per Action#66
	_OBJ_ANIME_WAIT(); Cyrus flag is 2717
	_CAMERA_TARGET_HERO()
	; Release camera
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_rival_5', '...Pardon me.\nStand aside.')
	_TALK_CLOSE()
	_OBJ_ANIME('C04_CYRUS', 'anm_c04_cyrus_exit')
	_OBJ_ANIME('C04_RIVAL', 'anm_c04_rival_clear_path_1')
	_OBJ_ANIME('HERO', 'anm_c04_player_clear_path_1')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C04_CYRUS')
	_FLAG_SET(#2717)
	_TIME_WAIT(60, @SCWK_ANSWER)
	_OBJ_ANIME('C04_RIVAL', 'anm_c04_rival_clear_path_2')
	_OBJ_ANIME('HERO', 'anm_c04_player_clear_path_2')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_rival_6', 'Oh, hey!\rWhen we smacked together, a brilliant\nflash of inspiration came to me!\rAn easy way to become a great Trainer!\nYeah, that!\rAll right.\nListen close...\rMake certain all your attacks hit!\nAvoid enemy attacks for sure!\rYou do that, you’d never lose!\nYou’d be the invincible Trainer!\rAnyway, go check out the Pokémon\nstatue. See you around!')
	_TALK_CLOSE()
	_OBJ_ANIME('C04_RIVAL', 'anm_c04_rival_exit')
	_OBJ_ANIME('HERO', 'anm_c04_player_face_rival_exit')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C04_RIVAL')
	_FLAG_SET(#2823)
	_LDVAL(@WK_SCENE_C04, 1)
	_TALK_END()
	_END()
