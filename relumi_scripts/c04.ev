ev_c04_flag_change:
	_CALL('ev_box_close')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 4400, 'ev_c04_guide_upd')
	_FLAG_SET(#FV_C04_TANKEN_OJISAN)
	_FLAG_SET(#FV_WALL_PUT2)
	_OBJ_DEL('C04_WALL04')
	_OBJ_DEL('C04_WALL05')
	_OBJ_DEL('C04_WALL06')
	_IFVAL_CALL(@WK_SCENE_C08R0401, 'EQ', 99, 'ev_c04_underground_set_flag_on')
	_NONE_USE_NUMBER()
	_IFVAL_CALL(@WK_SCENE_C08R0401, 'EQ', 99, 'ev_c04_underground_set_flag_on')
	_ITEM_CHK(450, 1, @LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c04_woman1a_stopper_flag_not')
	_ITEM_CHK(428, 1, @LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c04_woman1a_stopper_flag_set')
	_FLAG_RESET(#FV_WALL_PUT)
	_OBJ_DEL('C04_WALL01')
	_OBJ_DEL('C04_WALL02')
	_OBJ_DEL('C04_WALL03')
	_END()
ev_c04_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 4500)
	_RET()
ev_c04_woman1a_stopper_flag_not:
	_END()
ev_c04_woman1a_stopper_flag_set:
	_END()
ev_c04_underground_set_flag_on:
	_FLAG_RESET(#FV_C04_TANKEN_OJISAN)
	_OBJ_ADD('C04_UNDERGROUND')
	_RET()
pos_c04_explorer_kit_ranger:
	_LDVAL(@439, 1)
	_EVENT_START()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_OBJ_ANIME('CO4_LUMI_RANGER', 'anm_c04_ranger_emote')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 531, 'ev_c04_explorer_kit_ranger_top')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 532, 'ev_c04_explorer_kit_ranger_almost_top')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 533, 'ev_c04_explorer_kit_ranger_almost_bottom')
	_JUMP('ev_c04_explorer_kit_ranger_bottom')
	_END()
anm_c04_ranger_emote:
	_AC_MARK_GYOE(1)
	_ACMD_END()
ev_c04_explorer_kit_ranger_top:
	_CHARA_LOOK_LOCK('C04_LUMI_RANGER', 'HERO')
	_OBJ_ANIME('HERO', 'anm_c04_hero_look_to_ranger')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c04_ranger_explorer_kit_quest')
ev_c04_explorer_kit_ranger_almost_top:
	_CHARA_LOOK_LOCK('C04_LUMI_RANGER', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C04_LUMI_RANGER')
	_JUMP('ev_c04_ranger_explorer_kit_quest')
ev_c04_explorer_kit_ranger_almost_bottom:
	_CHARA_LOOK_LOCK('C04_LUMI_RANGER', 'HERO')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_exp_kit_come_closer', 'Hey, come a little closer so I can talk to you.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'anm_c04_hero_exp_kit_walk1')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'C04_LUMI_RANGER')
	_JUMP('ev_c04_ranger_explorer_kit_quest')
ev_c04_explorer_kit_ranger_bottom:
	_CHARA_LOOK_LOCK('C04_LUMI_RANGER', 'HERO')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_exp_kit_come_closer', 'Hey, come a little closer so I can talk to you.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'anm_c04_hero_exp_kit_walk2')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'C04_LUMI_RANGER')
	_JUMP('ev_c04_ranger_explorer_kit_quest')
anm_c04_hero_look_to_ranger:
	_AC_DIR_R(8)
	_ACMD_END()
anm_c04_hero_exp_kit_walk1:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
anm_c04_hero_exp_kit_walk2:
	_AC_DIR_U(8)
	_AC_UP(2, 8)
	_ACMD_END()
ev_c04_ranger_explorer_kit_quest:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2008, 'ev_c04_ranger_met_message')
	_IF_FLAGON_JUMP(#2011, 'ev_c04_ranger_met_message')
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_rangers_not_met', 'Hi there! I don’t suppose you’re interested\nin collecting rare Pokémon, are you?\rWell if it’s rare Pokémon that you’re\nafter then the Underground is the place to be!\rYou’ll find all sorts down there that\nare harder to come by up here on the surface.\rIs that perhaps why you were heading inside?')
	_JUMP('ev_c04_ranger_exp_kit_ugm_intro')
	_END()
ev_c04_ranger_met_message:
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_rangers_met', 'Oh, you might be...\rI’ve been told by a colleague of mine that\na rising star of a trainer had helped\fthem out with some of their field work.\rIt can’t be anyone else but you.\rYou have my sincere gratitude for your help.')
	_JUMP('ev_c04_ranger_exp_kit_ugm_intro')
ev_c04_ranger_exp_kit_ugm_intro:
	; Maybe add a surprise expression here?
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_ranger_intro', '...Oh, excuse my manners, you must be here\nto speak to the Underground Man and here I am\fchatting your ear off like you’ve got all\fthe time in the world.\rExcuse me.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C04_LUMI_RANGER')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 310, 'ev_c04_ranger_hero_on_left')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 311, 'ev_C04_ranger_hero_on_right')
	_OBJ_ANIME('C04_LUMI_RANGER', 'anm_c04_ranger_call_ugm_man')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_ranger_call_ugm_man', 'Hey, UGM,\ncome on out here, would ya!')
	_TALK_CLOSE()
	_OBJ_ANIME('C04_LUMI_RANGER', 'anm_c04_ranger_move_from_door')
	_OBJ_ANIME_WAIT()
	_AC_WAIT(60)
	_SET_DOOR_OBJ('C04R0801_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI012')
	_HIT_DOOR_ANIME_WAIT()
	_CALL('ev_c04_underground_set_flag_on')
	_OBJ_ANIME('C04_UNDERGROUND', 'anm_c04_ugm_exits_house')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C04_UNDERGROUND', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C04_UNDERGROUND')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C04_UNDERGROUND')
	_HIT_DOOR_ANIME(1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SE_PLAY('s_fi013')
	_HIT_DOOR_ANIME_WAIT()
	_JUMP('ev_c04_ranger_exp_kit_ugm_give_kit')
ev_c04_ranger_hero_on_left:
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 531, 'ev_c04_ranger_hero_blocking_door')
	_OBJ_ANIME('HERO', 'anm_c04_hero_look_up')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c04_ranger_hero_blocking_door:
	_OBJ_ANIME('HERO', 'anm_c04_hero_blocking_door')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c04_hero_blocking_door:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_c04_hero_look_up:
	_AC_DIR_U(8)
	_ACMD_END()
ev_C04_ranger_hero_on_right:
	_OBJ_ANIME('HERO', 'anm_c04_look_to_door')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c04_look_to_door:
	_AC_DIR_VAL(8, 135)
	_ACMD_END()
anm_c04_ranger_call_ugm_man:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_c04_ranger_move_from_door:
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_c04_ugm_exits_house:
	_AC_DOWN(1, 16)
	_ACMD_END()
ev_c04_ranger_exp_kit_ugm_give_kit:
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_underground_man_intro', 'Hello, my young friend.\nYou can call me The Underground Man.\rEverybody else does.')
	_OBJ_ANIME('C04_UNDERGROUND', 'anm_c04_ugm_turns_exasperatedly_right')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04', 'msg_co4_ugm_youngster', 'Well, almost everyone. The youngsters\nthese days do like to abbreviate.')
	_OBJ_ANIME('C04_UNDERGROUND', 'anm_c04_ugm_turns_exasperatedly_back')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_lumi_ranger_ugm_started_digging', 'UGM was the first person to have started\ndigging out the Grand Underground, y’know.\rYou won’t find a better mentor for spelunking\nthan him!')
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_ugm_venture_ug', 'Oh, you want to venture into the\nGrand Underground, eh?')
	_MACRO_TALK_KEYWAIT('dialogue_c04', '18-msg_c04r0801_underground_01_2', 'I’ll make a gift of this to you. You hold up your\nend of the deal and put it to good use!')
	_LAST_KEYWAIT()
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP0, 428)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FE_TANKENSETTO_GET)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(11, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2461); Grand Underground Chapter
	_JUMP('ev_c04_anahori')
ev_c04_man1:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_man1_01', 'Since you’re visiting Eterna, you need to\nget yourself a bike and take a ride down\fCycling Road.')
	_END()
ev_c04_woman1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C04R0204_WIN, 'ev_c04_woman1_02')
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_woman1_01', 'Since that Team Galactic building went up,\nthe city’s atmosphere has gotten all creepy\fand tense.\rI don’t know what those people are doing up in\nthat place...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04_woman1_02:
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_woman1_02', 'With Team Galactic gone, what’s going to\nhappen to their building?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04_boy3:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C04R0204_WIN, 'ev_c04_boy3_02')
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_boy3_01', 'My friend said Team Galactic took his favorite\nPokémon away. I don’t think he’s telling the truth.\rTeam Galactic looks so cool. They don’t look like\ncommon ruffians.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04_boy3_02:
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_boy3_02', 'Do you use bike stands?\rIt looks so cool to hop off your bike and then\nlean on it. It looks so smooth!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04_sign1:
	_EVENT_START()
	_IF_FLAGOFF_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c01_sign1_01')
	_EVENT_CAMERA_INDEX(331)
	_EASY_BOARD_MSG('dialogue_c04%0-msg_c04_sign1_01', 'BOARD_TYPE_TOWN', 0)
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c04_sign1_2:
	_EASY_BOARD_MSG('dialogue_c04%0-msg_c04_sign1_01', 'BOARD_TYPE_TOWN', 0)
	_END()
ev_c04_sign2:
	_EASY_INFOBOARD_MSG('dialogue_c04%0-msg_c04_sign2_01', 'BOARD_TYPE_INFO', 0)
	_END()
ev_c04_sign3:
	_EASY_BOARD_MSG('dialogue_c04%0-msg_c04_sign3_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_c04_sign4:
	_EASY_BOARD_MSG('dialogue_c04%0-msg_c04_sign4_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_c04_sign5:
	_EASY_BOARD_MSG('dialogue_c04%0-msg_c04_sign5_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_c04_sign6:
	_EASY_BOARD_MSG('dialogue_c04%0-msg_c04_sign6_01', 'BOARD_TYPE_POST', 0)
	_END()
pos_c04_champ:
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 303, 7, 523.500000)
	_OBJ_DIR_CHANGE('HERO', 270)
	_FLAG_RESET(#FV_C04_CHAMP)
	_OBJ_ADD('C04_CHAMP')
	_OBJ_POS_CHANGE_WORLD('C04_CHAMP', 310, 7, 523.500000)
	_OBJ_DIR_CHANGE('C04_CHAMP', 90)
	_EVENT_CAMERA_INDEX(65)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_JUMP('common_c04_champion_01')
	_END()
common_c04_champion_01:
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_01_g')
	_OBJ_ANIME_WAIT()
	_OBJ_POS_CHANGE_WORLD('C04_CHAMP', 307.500000, 7, 523.500000)
	_EVENT_CAMERA_INDEX(66)
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_01_02')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_chanpion_01_1', 'Oh, is that a Pokédex? You must be helping\nProfessor Rowan.\rWhat’s your name?\r...')
	_EVENT_CAMERA_INDEX(67)
	_SET_FORCE_BLINK('C04_CHAMP', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C04_CHAMP', 0)
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_chanpion_01_2', 'OK—hello, {0,1,0,0}. I’ll be sure to\nremember that name!\rMy name is Cynthia. I’m a Trainer just like you.\rI’ve been studying Pokémon mythology lately,\njust out of curiosity.', 0, 1)
	_TALK_CLOSE()
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_02')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(68)
	_SET_FORCE_BLINK('C04_CHAMP', 1)
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_chanpion_02_1', 'Here in Eterna City, there is a statue of an\nancient Pokémon.')
	_SET_FORCE_BLINK('C04_CHAMP', 0)
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_chanpion_02_2', 'According to myth, it was an extremely\npowerful Pokémon.\rWho knows? You may encounter something like\nit while you’re traveling with your Pokédex.')
	_SET_FORCE_BLINK('C04_CHAMP', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C04_CHAMP', 0)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_02_01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_chanpion_02_3', 'Try using this. It should help you on\nyour way.')
	_EVENT_CAMERA_INDEX(69)
	_LDVAL(@SCWK_TEMP0, 420)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_chanpion_03', 'Remember, you can use the hidden move Cut\nfrom your Pokétch in the field.\rIt will let you go places that were previously\ninaccessible to you.\rThat’s important for filling up your Pokédex,\nright? Then luck be with you, young Trainer!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(70)
	_PLAYER_POS_GET(@238, @239)
	_IFVAL_JUMP(@239, 'EQ', 523, 'pos_c04_champion_z11')
	_IFVAL_JUMP(@239, 'EQ', 524, 'pos_c04_champion_z12')
	_IFVAL_JUMP(@239, 'EQ', 525, 'pos_c04_champion_z13')
	_END()
pos_c04_champion_z11:
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_11')
	_OBJ_ANIME('HERO', 'anm_c04_player_11')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c04_champion_02')
	_END()
pos_c04_champion_z12:
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_11')
	_OBJ_ANIME('HERO', 'anm_c04_player_11')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c04_champion_02')
	_END()
pos_c04_champion_z13:
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champion_13')
	_OBJ_ANIME('HERO', 'anm_c04_player_13')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c04_champion_02')
	_END()
common_c04_champion_02:
	_OBJ_DEL('C04_CHAMP')
	_FLAG_SET(#FV_C04_CHAMP)
	_LDVAL(@WK_SCENE_C04, 2); Should be 2
	_FLAG_SET(#FE_HIDEN_01_GET)
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 4500, 'ev_c04_champion_guide_upd')
	_TALK_END()
	_END()
ev_c04_champion_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 4600)
	_RET()
anm_c04_champion_01:
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_c04_champion_01_g:
	_AC_MARK_GYOE(1)
	_AC_WORLD_X(307, 8)
	_ACMD_END()
anm_c04_champion_01_02:
	_AC_LEFT(3, 8)
	_ACMD_END()
anm_c04_champion_02:
	_AC_DIR_R(8)
	_ACMD_END()
anm_c04_champion_02_01:
	_AC_DIR_L(8)
	_ACMD_END()
anm_c04_champion_11:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_AC_DIR_L(8)
	_AC_LEFT(5, 8)
	_AC_DIR_D(8)
	_AC_DOWN(8, 8)
	_ACMD_END()
anm_c04_champion_13:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_L(8)
	_AC_LEFT(5, 8)
	_AC_DIR_D(8)
	_AC_DOWN(9, 8)
	_ACMD_END()
anm_c04_player_11:
	_AC_WAIT(2)
	_AC_DIR_D(8)
	_AC_WAIT(8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_c04_player_13:
	_AC_WAIT(2)
	_AC_DIR_U(8)
	_AC_WAIT(8)
	_AC_DIR_L(8)
	_ACMD_END()
ev_c04_gingam:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_gingam_01', 'Hey! You there, kid! Stay away from that\nPokémon statue!\rTeam Galactic is conducting an official\ninvestigation here!')
	_END()
ev_c04_gingam2:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_gingam2_01', 'Hey, you! Yeah, you, Trainer!\rErrr... It’s OK. Never mind. You look tough.\rI won’t take— Um, I’ll just let you keep your\nPokémon. Carry on!')
	_END()
ev_c04_gingam3:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_gingam3_01', 'Have you seen our building?\rTeam Galactic is so stinking rich that we can\nhave one built instantly!')
	_END()
ev_c04_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_woman3_01', 'They say this is an old city.\rIt doesn’t look it, though. Not with all these\ntall buildings.')
	_END()
ev_c04_oldman1:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_oldman1_01', 'Eterna City’s not anything like it was before, way\nback in the day.')
	_END()
ev_c04_babyboy1:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_babyboy1_01', 'They say this is a Pokémon that lived long,\nlong ago.')
	_END()
ev_c04_statue1:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(244)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04','00_msg_c04_statue_01_rp', 'It’s Eterna City’s Pokémon statue.\rThere seems to have been a descriptive\nplate, but it appears it was torn off.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(245)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c04_statue1_diamond:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_statue_01_1', 'There is some writing on the Pokémon statue...\rDia..., once created,\nbrought time into being.')
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_statue_01_2', '...in laughter or in tears,\nthe same time flows...\rSuch is the blessing of Dia...')
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_statue_01_3', 'The text is barely legible and has faded\ncompletely in places...')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(245)
	_EVENT_CAMERA_END_WAIT()
	_EVENT_START()
	_END()
ev_c04_woman1a:
	_IFVAL_JUMP(@WK_SCENE_C04_STOPPER, 'EQ', 0, 'ev_c04_woman1a_stopper_occ')
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '0-msg_c04_woman1a_03', 'Going underground with the Explorer Kit is a\nblast, isn’t it?')
	_END()
