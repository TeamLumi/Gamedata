ev_c04_anahori:
	_OBJ_ANIME('C04_LUMI_RANGER', 'anm_c04_lumi_ranger_asks_ugm')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_lumi_ranger_ug_tutorial', 'Say, UGM. How about I show this kiddo the ropes?\nI could take them down and show them how things work.')
	_OBJ_ANIME('C04_LUMI_RANGER', 'anm_c04_lumi_ranger_turns_back')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_ugm_exp_kit_tutorial', 'Yes, yes.\nThat would be just fine.\rMy young friend, use your Explorer Kit and you will\nmeet our Ranger companion here down there.\rRemember though that it can’t be used\nindoors or in a cave.')
	_MACRO_TALK_KEYWAIT('dialogue_c04', '18-msg_ug_mission_01_03', 'Have fun! Take these as a gift!')
	_ME_PLAY('M_FI013')
	_LDVAL(@SCWK_TEMP0, 1710)
	_LDVAL(@SCWK_TEMP1, 10)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c04', 'msg_c04_ugm_give_vintage_pokeball', 'An old friend of mine crafted those Balls out of some\nmaterials that I found in the Grand Underground.\rPerhaps you’ll be able to craft more for yourself\nsomeday, but you’ll need to do some digging first.\rNow, best of luck to you!')
	_TALK_CLOSE()
	_OBJ_ADD('C04_LUMI_RANGER')
	_OBJ_ANIME('C04_LUMI_RANGER', 'anm_c04_lumi_ranger_goes_ug')
	_OBJ_ANIME('HERO', 'anm_c04_player_watches_ranger_go_ug')
	_OBJ_ANIME_WAIT()
	_AG_TRANSITION_HOYUTA('C04_LUMI_RANGER', 0, 1)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_DEL('C04_LUMI_RANGER')
	_FLAG_SET(#1758); Eterna City Ranger Introducing the Explorer Kit
	_OBJ_ANIME('HERO', 'anm_c04_anahori_p_s02')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_EVENT_END()
	_LDVAL(@WK_SCENE_C04_STOPPER, 2)
	_LDVAL(@WK_SCENE_C08R0401, 1)
	_FLAG_RESET(#FE_UG_MISSION_TALK)
	_AUTO_TANKEN_SET()
	_AUTO_TANKEN_SET_WAIT()
	_USE_TANKENSET(2, 0)
	_END()
