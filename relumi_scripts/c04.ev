ev_c04_advice:
	_MACRO_EASY_OBJ_MSG('dialogue_c04', '00_msg_c04_advice_1_01', 'Hey, there!\nHow’s it going, Champ-to-be?\rSorry to disappoint you after you’ve\ncome such a long way, but...\rThe Gym Leader, Gardenia, isn’t here\nat the moment.\rGardenia went over to Route 216 to\nlook for some Grass-type Pokémon.\rI’m sure she’d come back to the Gym\nif you go and talk to her.\rRoute 216 is to the northeast of\nhere, through Mt. Coronet.\rIncidentially, you’ll likely find plenty\nof Ice-type Pokémon in Route 216.\rAs an exclusive tip from me to you...\nThe Pokémon in this Gym hate Ice-types!')
	_CALL('ev_c04_find_gardenia_guide_upd')
	_END()
ev_c04_find_gardenia_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 4550)
	_RET()
ev_c04_grunt_blocker:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 1, 'ev_c04_grunt_blocker_pass')
	_MACRO_TALK_KEYWAIT('dialogue_c04','00_msg_c04_grunt_blocker_haha', 'You! Kid!\rBehind me is the one, the only,\nTeam Galactic Eterna Building!\rYou can see it on the sign, yeah?\nIt’s no place for a kid like you.\rYou don’t have a Forest Badge either,\nso your Pokémon must be weak!\rWe don’t want them, either!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04_grunt_blocker_pass:
	_MACRO_TALK_KEYWAIT('dialogue_c04','00_msg_c04_grunt_blocker_badge', 'You! Kid!\rYou have the Forest Badge from the\nPokémon Gym here?\rThen your Pokémon must be plenty\nstrong, yeah?\rThen they’ll be perfect for\nTeam Galactic!\rI’ll be taking them now!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 948)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_MACRO_TALK_KEYWAIT('dialogue_c04','00_msg_c04_grunt_blocker_defeat', 'These Pokémon are very strong...\rWait, was I meant to collect weak\nPokémon instead?\rIs this kid planning to raid our\nbuilding and take the Pokémon back?\rI must inform Commander Jupiter...')
	_TALK_CLOSE()
	_SE_PLAY('S_FI012')
	_SET_DOOR_OBJ('C04R0201_D01')
	_HIT_DOOR_ANIME(0)
	_OBJ_ANIME('C04_GRUNT_BLOCKER', 'anm_c04_grunt_blocker')
	_OBJ_ANIME_WAIT()
	_HIT_DOOR_ANIME_WAIT()
	_SE_PLAY('S_FI013')
	_SET_DOOR_OBJ('C04R0201_D01')
	_HIT_DOOR_ANIME(1)
	_OBJ_DEL('C04_GRUNT_BLOCKER')
	_FLAG_SET(#2685)
	_TALK_OBJ_END()
	_END()
anm_c04_grunt_blocker:
	_AC_DIR_U(4)
	_AC_UP(1, 8)
	_AC_VANISH_ON()
	_ACMD_END()
