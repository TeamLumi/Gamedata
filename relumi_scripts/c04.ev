ev_c04_stop_01:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_CYCLE_GET, 'ev_c04_stop_03')
	_IFVAL_JUMP(@WK_SCENE_R207, 'GE', 1, 'ev_c04_stop_03')
	_MACRO_TALKMSG('dialogue_c04', '0-msg_c04_stop_02', 'Oh wow! You got a bike!\rYou can ride down Cycling Road and end up in\nHearthome City.\rIt’s a fast and fun ride. You should check it out!')
	_TALK_CLOSE()
	_OBJ_ANIME('C04_STOP_01', 'anm_c04_stop_turn')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
