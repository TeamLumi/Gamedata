	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_rival_2', 'Hey, {1}!\rYou came to see the Pokémon statue,\nright? I’ll take you there!')
