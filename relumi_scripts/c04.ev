ev_c04_champ_outside_gym:
	_EVENT_START()
	_FLAG_RESET(#FV_C04_CHAMP)
	_OBJ_ADD('C04_CHAMP')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_ADD_WK(@SCWK_TEMP1, 8)
	_OBJ_POS_CHANGE_WORLD('C04_CHAMP', 304, 7, @SCWK_TEMP1)
	_JUMP('ev_c04_champ_outside_gym_approach_player')
ev_c04_champ_outside_gym_approach_player:
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champ_approach_player')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'C04_CHAMP')
	_CHARA_LOOK_LOCK('C04_CHAMP', 'HERO')
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_1', 'Oh, there you are!\rI was looking for you.\nI’ve got something nice.\rI wanted you to have this Pokémon Egg.\nWill you accept it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'ev_c04_champ_outside_gym_decline_1')
	_TALK_CLOSE()
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_c04_champ_outside_gym_full_party_1'); Party and Boxes are full
	_CALL('ev_c04_champ_outside_gym_give_egg')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C04_CHAMP')
	_OBJ_ANIME('C04_CHAMP', 'anm_c04_champ_outside_gym_exit_1')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C04_CHAMP')
	_FLAG_SET(#FV_C04_CHAMP)
	_JUMP('ev_c04_champ_outside_gym_event_end_1')
ev_c04_champ_outside_gym_decline_1:
	_CALL('ev_c04_champ_outside_gym_decline_2')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C04_CHAMP')
	_JUMP('ev_c04_champ_outside_gym_event_end_1')
ev_c04_champ_outside_gym_full_party_1:
	_CALL('ev_c04_champ_outside_gym_full_party_2')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C04_CHAMP')
	_JUMP('ev_c04_champ_outside_gym_event_end_1')
ev_c04_champ_outside_gym_event_end_1:
	_TALK_END()
	_END()
ev_c04_champ_outside_gym_decline_2:
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_2', 'Oh...?\nYou don’t need to feel obligated.\rIt’s hard filling the pages of the\nPokédex, isn’t it?\rI only want to lend you a little hand,\nthat’s all.')
	_TALK_CLOSE()
	_LDVAL(@WK_SCENE_C04, 4)
	_RET()
ev_c04_champ_outside_gym_event_end_2:
	_TALK_OBJ_END()
	_END()
ev_c04_champ_outside_gym_full_party_2:
	_MACRO_TALK_KEYWAIT('dialogue_c04', '00_msg_c04_champ_outside_gym_3', 'Oh?\nYou don’t have room for this Egg.\rI’ll give you this Egg when you’ve made\nroom for it.\rI’ll be waiting right here.')
	_TALK_CLOSE()
	_LDVAL(@WK_SCENE_C04, 4)
	_RET()
