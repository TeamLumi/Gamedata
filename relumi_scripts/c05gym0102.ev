	;_MACRO_TALKMSG('dp_trainer_msg', '1-MINI_10_TRMSG_FIGHT_LOSE', 'Uh, whoopsie!\nThat didn’t end well!')
	;_MACRO_TALKMSG('dp_trainer_msg', '1-TANPAN_15_TRMSG_FIGHT_START', 'Hey, now!\nYou’re not even close to the door yet.\rYou have to beat me before you can go, you\nknow?')
	;_MACRO_TALKMSG('dp_trainer_msg', '1-TANPAN_15_TRMSG_FIGHT_LOSE', 'Argh! I should’ve dazzled you by shining my\nlight in your eyes!')
	;_MACRO_TALKMSG('dp_trainer_msg', '1-TANPAN_15_TRMSG_FIGHT_AFTER', 'Just walk around and look for the blue marks\non the tiles.')
	;_END()
