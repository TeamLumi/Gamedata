	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_gardenia_no_1', 'Oh, right.\nYou must have plans already.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07_villa_maylene:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_maylene_1', '...Um, your Villa...\nWould it be OK if I took a look around?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t07_villa_maylene_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07_villa_maylene_no')
	_END()
ev_t07_villa_maylene_yes:
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_maylene_yes_1', 'Oh, thank you.')
	_TALK_CLOSE()
	_BLACK_OUT()
	_FADE_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	;TODO once the inside of the Villa is ready, deactivate this PlaceData, activate the inside one
	_BLACK_IN()
