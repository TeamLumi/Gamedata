	_TALK_OBJ_END()
	_END()
ev_t07_villa_roark_no:
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_roark_no_1', '...Oh, sorry.\nAm I intruding on something?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t07_villa_gardenia:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_gardenia_1', 'Listen, listen!\nI came for a visit! Can I go in?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t07_villa_gardenia_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07_villa_gardenia_no')
	_END()
ev_t07_villa_gardenia_yes:
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_gardenia_yes_1', 'Yes!\nNo time to waste!')
	_TALK_CLOSE()
	_BLACK_OUT()
	_FADE_WAIT()
