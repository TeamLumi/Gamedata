	_END()
ev_t07_villa_byron:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_byron_1', 'Guhahahaha!\rHow’s your Villa?\nCan you give me a tour?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t07_villa_byron_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t07_villa_byron_no')
	_END()
ev_t07_villa_byron_yes:
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_byron_yes_1', 'All right!\nLet’s have a look, then!')
	_TALK_CLOSE()
	_BLACK_OUT()
	_FADE_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	;TODO once the inside of the Villa is ready, deactivate this PlaceData, activate the inside one
	_BLACK_IN()
	_FADE_WAIT()
	_TALK_OBJ_END()
	_END()
ev_t07_villa_byron_no:
	_MACRO_TALKMSG('dialogue_t07', '00_msg_t07_villa_byron_no_1', 'Well!\nHow cold can you be?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()