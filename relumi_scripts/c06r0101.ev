ev_c06r0101_bringm:
	_END()
pos_c06r0101_bringm:
	_EVENT_START()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_turn_01')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@LOCALWORK0, @LOCALWORK1)
	_IFVAL_CALL(@LOCALWORK0, 'EQ', 5, 'ev_c06r0101_player_move')
	_MONEY_OPEN()
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_01', 'Welcome to the Great Marsh, the home of\nPastoria’s Safari Game!\rAll you can catch for just 500!\nWould you like to play a Safari Game?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'pos_c06r0101_bringm_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'pos_c06r0101_bringm_no')
	_END()
pos_c06r0101_bringm_yes:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 6, 'pos_c06r0101_bringm_check_money')
	_COUNT_MONSBOX_SPACE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'pos_c06r0101_bringm_check_money')
	_JUMP('pos_c06r0101_bringm_box_full')
	_JUMP('pos_c06r0101_bringm_check_money')
pos_c06r0101_bringm_check_money:
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_02', 'That will be 500, please.')
	_COMP_GOLD(@SCWK_ANSWER, 500)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'pos_c06r0101_bringm_no_money')
	_SE_PLAY('s_me050')
	_SUB_GOLD(500)
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_03', 'Here are your Safari Balls.')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_04', 'You received 30 Safari Balls.')
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_05', 'We’ll let you know when your game is over.\rUntil then, enjoy yourself, please! Off you go on\nyour wild excursion!')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	; A new tooltip for the Great Marsh could be added here
	_FLAG_SET(#FE_SAFARI_START)
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'pos_c06r0101_anime_start_01')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 5, 'pos_c06r0101_anime_start_02')
	_END()
pos_c06r0101_anime_start_01:
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_go_01')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c06r0101_safari_start')
	_JUMP('pos_c06r0101_safari_start')
pos_c06r0101_anime_start_02:
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_go_02')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_c06r0101_safari_start')
	_JUMP('pos_c06r0101_safari_start')
pos_c06r0101_safari_start:
	_LDVAL(@WK_SCENE_SAFARI_ZONE, 1)
	_SAFARI_START()
	_SE_PLAY('S_FI001')
	_MAP_CHANGE('D06R0206', 0)
	_END()
ev_c06r0101_safari_tips:
	_RET()
pos_c06r0101_bringm_no_money:
	_MONEY_CLOSE()
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_07', 'You don’t have enough money. Sorry.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_back_01')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
pos_c06r0101_bringm_no:
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_06', 'OK. Please come again!')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_back_01')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
pos_c06r0101_bringm_box_full:
	_MONEY_CLOSE()
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_01_08', 'I’m sorry, but you don’t have enough room to\ncatch any more Pokémon.\rPlease manage the Pokémon in your party or in\nPokémon Boxes to make room, then try again!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_back_01')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
ev_c06r0101_player_move:
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_move_01')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c06r0101_player_move_01:
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_c06r0101_player_turn_01:
	_AC_DIR_L(8)
	_ACMD_END()
anm_c06r0101_player_go_01:
	_AC_DIR_U(8)
	_AC_UP(3, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_VANISH_ON(1)
	_ACMD_END()
anm_c06r0101_player_go_02:
	_AC_DIR_U(8)
	_AC_UP(4, 8)
	_AC_VANISH_ON(1)
	_ACMD_END()
anm_c06r0101_player_back_01:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_ACMD_END()
ev_c06r0101_announce:
	_EVENT_START()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_to_counter_00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_02_01', 'You still have time left. Are you sure you want to\nexit the Great Marsh?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06r0101_announce_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06r0101_announce_no')
	_END()
ev_c06r0101_announce_yes:
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_to_counter_01')
	_OBJ_ANIME_WAIT()
	_LDVAL(@WK_SCENE_SAFARI_ZONE, 0)
	_SAFARI_END()
	_TALK_END()
	_END()
ev_c06r0101_announce_yes_koe:
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_02_02', 'OK. I’ll relieve you of your remaining Safari Balls.\nThank you for playing.\rWe hope to see you again.')
	_TALK_CLOSE()
	_RET()
ev_c06r0101_announce_no:
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringm_02_03', 'Please enjoy the rest of your wild Safari\nGame adventure!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_to_safari_01')
	_OBJ_ANIME_WAIT()
	_MAP_CHANGE('D06R0206', 0)
	_END()
anm_c06r0101_player_to_counter_00:
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_c06r0101_player_to_counter_01:
	_AC_DOWN(5, 8)
	_ACMD_END()
anm_c06r0101_player_to_safari_01:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_VANISH_ON(1)
	_ACMD_END()
ev_c06r0101_safari_end:
	_EVENT_START()
	_OBJ_ANIME('HERO', 'anm_c06r0101_player_to_counter_01')
	_OBJ_ANIME_WAIT()
	_RESET_SYS_FLAG($SYS_FLAG_BTL_RETURN_CALL_SP)
	_LDVAL(@WK_SCENE_SAFARI_ZONE, 0)
	_SAFARI_END()
	_TALK_END()
	_END()
ev_c06r0101_bringw:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringw_01', 'Welcome to the Great Marsh! Is this your first\nSafari Game?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06r0101_bringw_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06r0101_bringw_03')
	_END()
ev_c06r0101_bringw_02:
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringw_02_1', 'When you enter the Great Marsh, you receive\n30 Safari Balls. That’s the only kind of ball you’re\fallowed to use in the Safari Game.')
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringw_02_2', 'The game is over when you run out of Safari\nBalls or when you’ve walked 500 steps.\rPlease do enjoy the untamed nature of the\nGreat Marsh!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0101_bringw_03:
	_MACRO_TALKMSG('dialogue_c06r0101', '123-msg_c06r0101_bringw_03', 'I see. Enjoy your Safari Game!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0101_bringwf1:
	_OBJ_ANIME('C06R0101_BRINGW', 'anm_c06r0101_bringwf1')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c06r0101_bringwf2:
	_OBJ_ANIME('C06R0101_BRINGW', 'anm_c06r0101_bringwf2')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c06r0101_bringwf1:
	_AC_DIR_R(8)
	_ACMD_END()
anm_c06r0101_bringwf2:
	_AC_DIR_D(8)
	_ACMD_END()
ev_c06r0101_protect:
	_JUMP('ev_c06r0101_protect_hotfix')
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2680, 'ev_c06r0101_protect_done')
	_MACRO_TALKMSG('dialogue_c06r0101', '00_msg_ev_c06r0101_protect', 'Howdy.\nYou’re playing the Safari Game?\rHow would you like to try my game out\nat the same time?\rThe rule—yep, there’s only one—is\nreal simple.\rAll you have to do is capture five or more\nnew Pokémon in one Safari Game.\rIf you can do that, I’ll give you a\nfancy Technical Machine.')
	_TALK_CLOSE()
	_CALL('ev_c06r0101_start_minigame')
	_TALK_OBJ_END()
	_END()
ev_c06r0101_protect_lose:
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_ev_c06r0101_protect_not_yet', 'I’m sorry, it seems you haven’t\nbeaten the mini-game yet.\rYou’ll have to catch five or more new\nPokémon in one Safari Game.\rIf you can do that, I’ll give you a\nfancy Technical Machine.')
	_TALK_CLOSE()
	_FLAG_RESET(#2679); Reset the game
	_LDVAL(@473, 0)
	_LDVAL(@472, 0)
	_TALK_OBJ_END()
	_END()
ev_c06r0101_protect_hotfix:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06r0101', '00_msg_ev_c06r0101_protect_hotfix', 'Howdy\nYou’re a trainer right?\rHere, you’re gonna need this.')
	_IF_FLAGON_JUMP(#2680, 'ev_c06r0101_protect_done')
	_LDVAL(@SCWK_TEMP0, 344); Protect TM
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_ev_c06r0101_protect_2', 'Protect is a move that will prevent\nyour Pokémon from being hurt.\rIt’s similar to how the Great Marsh\nprotects rare species of Pokémon!')
	_FLAG_SET(#2680)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0101_protect_win:
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_ev_c06r0101_protect_1', 'So, how many Pokémon did you catch in\nyour Safari Game? At least five?\rAyup! You’ve done that all right!\nIsn’t that something!\rWell, here you are, then. The\nTechnical Machine containing Protect.')
	_LDVAL(@SCWK_TEMP0, 344); Protect TM
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_ev_c06r0101_protect_2', 'Protect is a move that will prevent\nyour Pokémon from being hurt.\rIt’s similar to how the Great Marsh\nprotects rare species of Pokémon!')
	_FLAG_SET(#2680)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0101_protect_done:
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_ev_c06r0101_protect_3', 'Howdy there, buddy.\rHope you’re having a good time in the\nSafari Game.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0101_pc_full:
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_c06r0601_full_pc', 'Oh, slow down ’er partner.\nYou ain’t got no space in your boxes.\rYou’re gonna need to make some space for\nthis here game.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0101_start_minigame:
	_COUNT_MONSBOX_SPACE(@473)
	_IFVAL_JUMP(@473, 'EQ', 0, 'ev_c06r0101_pc_full')
	_FLAG_SET(#2679)
	_RET()
ev_c06r0101_minigame_check_result:
	_MACRO_TALK_KEYWAIT('dialogue_c06r0101', '00_msg_ev_c06r0101_testing', 'Let’s see how many you got...')
	_IFVAL_JUMP(@473, 'EQ', 0, 'ev_c06r0101_protect_lose')
	_COUNT_MONSBOX_SPACE(@472)
	_SUB_WK(@472, @473)
	_IFVAL_JUMP(@472, 'GE', 5, 'ev_c06r0101_protect_win')
	_JUMP('ev_c06r0101_protect_lose')