	_GET_RND(@SCWK_ANSWER, 6)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_d11r0101_info_mes_01')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_d11r0101_info_mes_02')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_d11r0101_info_mes_03')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_d11r0101_info_mes_04')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 4, 'ev_d11r0101_info_mes_05')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 5, 'ev_d11r0101_info_mes_06')
	_IFVAL_JUMP(@LOCALWORK10, 'EQ', 0, 'ev_d11r0101_info_girl_01_end')
	_JUMP('ev_d11r0101_info_girl_02_end')
	_JUMP('ev_d11r0101_info_mes_01')
ev_d11r0101_info_mes_01:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_07', 'Your {0,1,2,0} looks quite pleased\nfollowing you around. It really is adorable!')
	_RET()
ev_d11r0101_info_mes_02:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_08', 'The owner of Amity Square? I’m sure the owner\nis somewhere on the grounds.\rSeeing Trainers with their Pokémon makes our\nowner happy.')
	_RET()
ev_d11r0101_info_mes_03:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_09', 'You may find useful items on the ground.\nThey’re quite small, however.\rYour Pokémon may also find items. You should\ntry talking to your Pokémon every so often. OK?')
	_RET()
ev_d11r0101_info_mes_04:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_10', 'Are you enjoying your stroll?\rYou should try talking to your Pokémon.\nIt will be happy you did.')
	_RET()
ev_d11r0101_info_mes_05:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_11', 'It makes me happy seeing all the cute Pokémon\nand their kind Trainers.')
	_RET()
ev_d11r0101_info_mes_06:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_12', 'You may spend all the time you like in\nAmity Square. OK?')
	_RET()
ev_d11r0101_info_girl_01_end:
	_TALK_CLOSE()
	_OBJ_ANIME('D11R0101_INFO_GIRL_01', 'anm_d11r0101_info_girl_01')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
ev_d11r0101_info_girl_02_end:
	_TALK_CLOSE()
	_OBJ_ANIME('D11R0101_INFO_GIRL_02', 'anm_d11r0101_info_girl_02')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
anm_d11r0101_info_girl_01:
	_AC_DIR_R(1)
	_ACMD_END()
anm_d11r0101_info_girl_02:
	_AC_DIR_L(1)
	_ACMD_END()
ev_d11r0101_man1:
	_IF_FLAGOFF_JUMP(#3121, 'ev_d11r0101_man1_tinkatuff')
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', '58-msg_d11r0101_man1_01', 'Those are ruins from a time long, long ago.')
	_END()
ev_d11r0101_man1_tinkatuff:
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', 'ev_d11r0101_man1_tinkatuff', 'This Tinkatuff seems to really like these houses...')
	_END()
ev_d11r0101_balloon:
	_EASY_VOICE_MSG('dialogue_d11r0101%58-msg_d11r0101_balloon_01', 'PLAY_PV_EV_425_00_00')
	_END()
ev_d11r0101_woman1:
	_IF_FLAGOFF_JUMP(#3121, 'ev_d11r0101_woman1_tinkatuff')
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', '58-msg_d11r0101_woman1_01', 'I come here with my Happiny every single day!\nI can let it run free without any worries at all.')
	_END()
ev_d11r0101_woman1_tinkatuff:
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', 'ev_d11r0101_woman1_tinkatuff', 'This Tinkatuff is really cute.\nBut why does it have to be so pushy?')
	_END()
ev_d11r0101_kolucky:
	_EASY_VOICE_MSG('dialogue_d11r0101%58-msg_d11r0101_kolucky_01', 'PLAY_PV_EV_440_00_00')
	_END()
ev_d11r0101_bigman:
	_IF_FLAGOFF_JUMP(#3121, 'ev_d11r0101_bigman_tinkatuff')
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', '58-msg_d11r0101_bigman_01', 'Ooh, I just can’t believe it! I’m so overjoyed with\nmy Pikachu! Wherever I go, my Pikachu follows\fme without hesitation!\rAhaha! It’s just the two of us! Woohoo!')
	_END()
ev_d11r0101_bigman_tinkatuff:
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', 'ev_d11r0101_bigman_tinkatuff', 'I heard there is a Tinkatuff going around here\ncausing chaos! I wonder where it is.')
	_END()
ev_d11r0101_bigman2:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#4100, 'ev_d11r0101_bigman2_completed')
	;Sets the item id based on the randomly generated number
	_SWITCH(@517)
	_CASE_CALL(0, 'ev_d11r0101_bigman2_cornnberry')
	_CASE_CALL(1, 'ev_d11r0101_bigman2_magostberry')
	_CASE_CALL(2, 'ev_d11r0101_bigman2_rabutaberry')
	_CASE_CALL(3, 'ev_d11r0101_bigman2_nomelberry')
	_CASE_CALL(4, 'ev_d11r0101_bigman2_spelonberry')
	_CASE_CALL(5, 'ev_d11r0101_bigman2_pamtreberry')
	_CASE_CALL(6, 'ev_d11r0101_bigman2_watmelberry')
	_CASE_CALL(7, 'ev_d11r0101_bigman2_durinberry')
	_CASE_CALL(8, 'ev_d11r0101_bigman2_belueberry')
	_CASE_CALL(9, 'ev_d11r0101_bigman2_sticker1')
	_CASE_CALL(10, 'ev_d11r0101_bigman2_sticker2')
	_CASE_CALL(11, 'ev_d11r0101_bigman2_sticker3')
	_CASE_CALL(12, 'ev_d11r0101_bigman2_sticker4')
	_CASE_CALL(13, 'ev_d11r0101_bigman2_sticker5')
	_CASE_CALL(14, 'ev_d11r0101_bigman2_sticker6')
	_CASE_CALL(15, 'ev_d11r0101_bigman2_sticker7')
	;If the chosen item is a berry
	_IFVAL_CALL(@517, 'LE', 8, 'ev_d11r0101_bigman2_name_berry')
	;If the chosen item is a sticker
	_IFVAL_CALL(@517, 'GE', 9, 'ev_d11r0101_bigman2_name_sticker')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d11r0101_bigman2_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d11r0101_bigman2_no')
	_END()

ev_d11r0101_bigman2_name_berry:
	;To get the name of the berry
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	;Tag id has to be 10
	_MACRO_TALKMSG('dialogue_d11r0101', 'msg_d11r0101_bigman_02_berry', 'Hello, how do you do!\rI love this park.\nIt’s why I try to keep it neat and tidy.\rI don’t mind the cleaning at all.\nI find all sorts of items doing so.\rIt’s quite fun, even exciting.\nOh, I know.\rDo you know the item {0,1,10,0}?\nI found some. Would you like them?')
	_RET()

ev_d11r0101_bigman2_name_sticker:
	;To get the name of the sticker
	_SEAL_NAME(0, @SCWK_TEMP0, 1)
	;Tag id has to be 77
	_MACRO_TALKMSG('dialogue_d11r0101', 'msg_d11r0101_bigman_02_sticker', 'Hello, how do you do!\rI love this park.\nIt’s why I try to keep it neat and tidy.\rI don’t mind the cleaning at all.\nI find all sorts of items doing so.\rIt’s quite fun, even exciting.\nOh, I know.\rDo you know the item {0,1,77,0}?\nI found some. Would you like them?')
	_RET()

ev_d11r0101_bigman2_yes:
	_TALK_CLOSE()
	;If the chosen item is a berry
	_IFVAL_JUMP(@517, 'LE', 8, 'ev_d11r0101_bigman2_give_berry')
	;If the chosen item is a sticker
	_JUMP('ev_d11r0101_bigman2_give_sticker')
	_END()

ev_d11r0101_bigman2_cornnberry:
	_LDVAL(@SCWK_TEMP0, 175)
	_RET()

ev_d11r0101_bigman2_magostberry:
	_LDVAL(@SCWK_TEMP0, 176)
	_RET()

ev_d11r0101_bigman2_rabutaberry:
	_LDVAL(@SCWK_TEMP0, 177)
	_RET()

ev_d11r0101_bigman2_nomelberry:
	_LDVAL(@SCWK_TEMP0, 178)
	_RET()

ev_d11r0101_bigman2_spelonberry:
	_LDVAL(@SCWK_TEMP0, 179)
	_RET()

ev_d11r0101_bigman2_pamtreberry:
	_LDVAL(@SCWK_TEMP0, 180)
	_RET()

ev_d11r0101_bigman2_watmelberry:
	_LDVAL(@SCWK_TEMP0, 181)
	_RET()

ev_d11r0101_bigman2_durinberry:
	_LDVAL(@SCWK_TEMP0, 182)
	_RET()

ev_d11r0101_bigman2_belueberry:
	_LDVAL(@SCWK_TEMP0, 183)
	_RET()

ev_d11r0101_bigman2_sticker1:
	_LDVAL(@SCWK_TEMP0, 40)
	_RET()

ev_d11r0101_bigman2_sticker2:
	_LDVAL(@SCWK_TEMP0, 41)
	_RET()

ev_d11r0101_bigman2_sticker3:
	_LDVAL(@SCWK_TEMP0, 42)
	_RET()

ev_d11r0101_bigman2_sticker4:
	_LDVAL(@SCWK_TEMP0, 43)
	_RET()

ev_d11r0101_bigman2_sticker5:
	_LDVAL(@SCWK_TEMP0, 44)
	_RET()

ev_d11r0101_bigman2_sticker6:
	_LDVAL(@SCWK_TEMP0, 45)
	_RET()

ev_d11r0101_bigman2_sticker7:
	_LDVAL(@SCWK_TEMP0, 46)
	_RET()


ev_d11r0101_bigman2_give_berry:
	_LDVAL(@SCWK_TEMP1, 5) ;Amount
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	;If the player bag is full, display a "your bag is full" message
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d11r0101_bigman2_item_event_fail')
	;If the bag is not full, give the berries
	_CALL('ev_item_event')
	_FLAG_SET(#4100)
	_JUMP('ev_d11r0101_bigman2_completed')
	_END()

ev_d11r0101_bigman2_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_d11r0101_bigman2_give_sticker:
	;TODO decide which stickers to give, or if giving any sticker from the full list
	_CB_ITEM_NUM_ADD(@SCWK_TEMP0, 1)
	_MACRO_TALKMSG('dialogue_d11r0101', 'msg_d11r0101_bigman_02_give_sticker', 'You obtained a Sticker!')
	_FLAG_SET(#4100)
	_JUMP('ev_d11r0101_bigman2_completed')
	_END()

ev_d11r0101_bigman2_no:
	_MACRO_TALKMSG('dialogue_d11r0101', 'msg_d11r0101_bigman_02_no', 'Oh, it’s no problem to me.\nThey’re yours if you want, OK?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_d11r0101_bigman2_completed:
	_MACRO_TALKMSG('dialogue_d11r0101', 'msg_d11r0101_bigman_02_completed', 'Hahahah!\nPerhaps I’ll see you again tomorrow!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

