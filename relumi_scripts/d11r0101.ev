	_EASY_INFOBOARD_MSG('dialogue_d11r0101%58-msg_d11r0101_sign1', 'BOARD_TYPE_INFO', 0)
	_END()
ev_d11r0101_sign4:
	_EASY_INFOBOARD_MSG('dialogue_d11r0101%58-msg_d11r0101_sign2', 'BOARD_TYPE_INFO', 0)
	_END()
ev_d11r0101_tinkatuff_one:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d11r0101', '00_msg_d11r0101_tinkatuff_one', 'Inka! Uff!')
	_VOICE_PLAY(958, 0, 0)
	_VOICE_WAIT()
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('PORUTO_SCR_FUREAI', 'D11R0101_TINKATUFF_ONE')
	_PLAYER_POS_GET(@SCWK_PARAM0, @SCWK_PARAM1)
	_IFVAL_CALL(@SCWK_PARAM1, 'LT', 60, 'ev_d11r0101_hero_pushback_check')
	_JUMP('ev_d11r0101_tinkatuff_one_move_up_right')
ev_d11r0101_hero_pushback_check:
	_IFVAL_CALL(@SCWK_PARAM0, 'GT', 3, 'ev_d11r0101_hero_pushback')
	_RET()
ev_d11r0101_hero_pushback:
	;Bump sound
	_SE_PLAY('S_FI003')
	_OBJ_ANIME('HERO', 'anm_d11r0101_hero_pushback')
	_OBJ_ANIME_WAIT()
	_RET()
ev_d11r0101_tinkatuff_one_move_up_right:
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_TINKATUFF_ONE')
	_OBJ_ANIME('D11R0101_TINKATUFF_ONE', 'anm_d11r0101_tinkatuff_one_move_up_right')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_d11r0101_tinkatuff_one_end')
ev_d11r0101_tinkatuff_one_end:
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('PORUTO_SCR_FUREAI')
	_OBJ_ANIME('PORUTO_SCR_FUREAI', 'anm_d11r0101_poffin_lady_look_after_tinkatuff')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'PORUTO_SCR_FUREAI')
	_CHARA_LOOK_LOCK('PORUTO_SCR_FUREAI', 'HERO')
	_MACRO_TALKMSG('dialogue_d11r0101', '00_msg_d11r0101_poffin_lady_notice', 'Tinkatuff was eating my poffins.\rThanks for helping me out.\rSeems like Tinkatuff went into one\nof the houses up there.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('PORUTO_SCR_FUREAI')
	_FLAG_SET(#3122)
	_OBJ_DEL('D11R0101_TINKATUFF_ONE')
	_FLAG_RESET(#2930)
	_OBJ_ADD('D11R0101_TINKATUFF_TWO')
	_TALK_OBJ_END()
	_END()
anm_d11r0101_hero_pushback:
	_AC_UP(1, 6)
	_ACMD_END()
anm_d11r0101_tinkatuff_one_move_up_right:
	_AC_DIR_U(6)
	_AC_UP(1, 6)
	_AC_DIR_R(6)
	_AC_RIGHT(12, 6)
	_ACMD_END()
anm_d11r0101_poffin_lady_look_after_tinkatuff:
	_AC_WAIT(16)
	_AC_MARK_GYOE()
	_AC_DIR_R(8)
	_ACMD_END()
ev_d11r0101_tinkatuff_two:
	_EVENT_START()
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_TINKATUFF_TWO')
	_CHARA_LOOK_LOCK('D11R0101_TINKATUFF_TWO', 'HERO')
	_OBJ_ANIME('D11R0101_TINKATUFF_TWO', 'anm_d11r0101_tinkatuff_two_leave_house')
	_OBJ_ANIME_WAIT()
	;Plays the sound of a Warp
	_SE_PLAY('S_FI001')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('D11R0101_TINKATUFF_TWO')
	_FLAG_SET(#2930)
	_OBJ_DEL('D11R0101_TINKATUFF_TWO')
	_JUMP('pos_d11r0101_tinkatuff_two_end')
anm_d11r0101_tinkatuff_two_leave_house:
	_AC_MARK_GYOE()
	_AC_DIR_R(6)
	_ACMD_END()
pos_d11r0101_tinkatuff_two_end:
	;Had to change from 488 to 518 since the one originally used in Lumi is used somewhere else
	_LDVAL(@518, 1)
	_FLAG_RESET(#2932)
	_OBJ_ADD('D11R0101_TINKATUFF_THREE')
	_END()
pos_d11r0101_tinkatuff_stopper_left_river:
	_EVENT_START()
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_TINKATUFF_THREE')
	_VOICE_PLAY(958, 0, 0)
	_VOICE_WAIT()
	_OBJ_ANIME('D11R0101_TINKATUFF_THREE', 'anm_d11r0101_tinkatuff_three_leave_right_river')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_d11r0101_tinkatuff_three_end')
anm_d11r0101_tinkatuff_three_leave_right_river:
	_AC_DIR_U(6)
	_AC_UP(1, 6)
	_AC_DIR_L(6)
	_AC_LEFT(1, 6)
	_AC_DIR_U(6)
	_AC_WAIT(4)
	_AC_MARK_GYOE()
	_AC_UP(4, 6)
	_AC_DIR_R(6)
	_AC_RIGHT(5, 6)
	_AC_DIR_D(6)
	_AC_DOWN(1, 6)
	_AC_DIR_R(6)
	_AC_RIGHT(3, 6)
	_AC_DIR_U(6)
	_AC_UP(10, 6)
	_ACMD_END()
pos_d11r0101_tinkatuff_stopper_right_river:
	_EVENT_START()
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_TINKATUFF_THREE')
	_VOICE_PLAY(958, 0, 0)
	_VOICE_WAIT()
	_OBJ_ANIME('D11R0101_TINKATUFF_THREE', 'anm_d11r0101_tinkatuff_three_leave_left_river')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_d11r0101_tinkatuff_three_end')
anm_d11r0101_tinkatuff_three_leave_left_river:
	_AC_DIR_U(6)
	_AC_UP(1, 6)
	_AC_DIR_L(6)
	_AC_LEFT(1, 6)
	_AC_DIR_U(6)
	_AC_WAIT(4)
	_AC_MARK_GYOE()
	_AC_UP(2, 6)
	_AC_DIR_L(6)
	_AC_LEFT(5, 6)
	_AC_DIR_D(6)
	_AC_DOWN(1, 6)
	_AC_DIR_L(6)
	_AC_LEFT(1, 6)
	_ACMD_END()
pos_d11r0101_tinkatuff_three_end:
	_CHARA_LOOK_RELEASE('HERO')
	_FLAG_SET(#2932)
	_LDVAL(@518, 0)
	_OBJ_DEL('D11R0101_TINKATUFF_THREE')
	_FLAG_RESET(#2933)
	_OBJ_ADD('D11R0101_TINKATUFF_FOUR')
	_END()
ev_d11r0101_tinkatuff_four:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d11r0101', '00_msg_d11r0101_tinkatuff_four', 'Inka! Uff....')
	_VOICE_PLAY(958, 0, 0)
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET(958, 30)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 958)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_d11_r0101_tinkatuff_event_end')
	_TALK_OBJ_END()
	_END()
ev_d11_r0101_tinkatuff_event_end:
	_FLAG_SET(#3121)
	_FLAG_SET(#3128)
	_FLAG_SET(#2933)
	_OBJ_DEL('D11R0101_TINKATUFF_FOUR')
	_RET()