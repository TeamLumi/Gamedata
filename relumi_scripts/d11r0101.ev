ev_d11r0101_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D11R0101)
	_FLAG_SET(#FV_D11R0101_PIKACHU)
	_FLAG_SET(#FV_D11R0101_ATYAMO)
	_FLAG_SET(#FV_D11R0101_PIPPI)
	_FLAG_SET(#FV_D11R0101_KODAKKU)
	_FLAG_SET(#FV_D11R0101_PATIRISSU)
	_FLAG_SET(#FV_D11R0101_HUUSEN)
	_FLAG_SET(#FV_D11R0101_MIMITTO)
	_FLAG_SET(#FV_D11R0101_KORAKII)
	_FLAG_SET(#FV_D11R0101_PURIN)
	_FLAG_SET(#FV_D11R0101_ENEKO)
	_FLAG_SET(#FV_D11R0101_KINOKOKO)
	;TODO Random location change not working from map script, the NPC is always at the default position, but the commands are being called. Changed this part to be called when the info lady is triggered
	;Flag is turned off after each day
	;_IF_FLAGOFF_CALL(#4100, 'ev_d11r0101_bigman2_reset')
	_END()

ev_d11r0101_bigman2_reset:
	;Chooses a random item and moves to a random location
	_GET_RND(@517, 16) ;Determines the item that the NPC will give
	_GET_RND(@SCWK_TEMP0, 5) ;Determines the position of the NPC
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_d11r0101_bigman2_change_position_1')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 2, 'ev_d11r0101_bigman2_change_position_2')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 3, 'ev_d11r0101_bigman2_change_position_3')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 4, 'ev_d11r0101_bigman2_change_position_4')
	_RET()

ev_d11r0101_bigman2_change_position_1:
	;_SXY_POS_CHANGE('D11R0101_BIGMAN2', 49, 40)
	_OBJ_POS_CHANGE_WORLD('D11R0101_BIGMAN2', 49, 1, 40)
	_RET()

ev_d11r0101_bigman2_change_position_2:
	;_SXY_POS_CHANGE('D11R0101_BIGMAN2', 38, 8)
	_OBJ_POS_CHANGE_WORLD('D11R0101_BIGMAN2', 38, 4, 8)
	_RET()

ev_d11r0101_bigman2_change_position_3:
	;_SXY_POS_CHANGE('D11R0101_BIGMAN2', 28, 14)
	_OBJ_POS_CHANGE_WORLD('D11R0101_BIGMAN2', 25, 5, 13)
	_RET()

ev_d11r0101_bigman2_change_position_4:
	;_SXY_POS_CHANGE('D11R0101_BIGMAN2', 40, 21)
	_OBJ_POS_CHANGE_WORLD('D11R0101_BIGMAN2', 40, 2, 21)
	_RET()

pos_d11r0101_info_01:
	_EVENT_START()
	;Chooses a random item and moves the bigman to a random location. The flag resets every day cycle
	;TODO reset not tested yet
	_IF_FLAGOFF_CALL(#4100, 'ev_d11r0101_bigman2_reset')
	_LDVAL(@SCWK_PARAM1, 1)
	_OBJ_ANIME('HERO', 'anm_d11r0101_player_turn_left')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_d11r0101_choice')
	_END()
pos_d11r0101_info_03:
	_EVENT_START()
	;Chooses a random item and moves the bigman to a random location. The flag resets every day cycle
	_IF_FLAGOFF_CALL(#4100, 'ev_d11r0101_bigman2_reset')
	_LDVAL(@SCWK_PARAM1, 2)
	_OBJ_ANIME('HERO', 'anm_d11r0101_player_turn_right')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_d11r0101_choice')
	_END()
ev_d11r0101_choice:
	_OBJ_ANIME('D11R0101_INFO_GIRL_01', 'anm_d11r0101_uketsuke_01')
	_OBJ_ANIME('D11R0101_INFO_GIRL_02', 'anm_d11r0101_uketsuke_02')
	_OBJ_ANIME_WAIT()
	_IF_FLAGOFF_CALL(#3121, 'ev_d11r0101_info_tinkatuff')
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 1, 'ev_d11r0101_choice_talk1')
	_IFVAL_CALL(@SCWK_PARAM1, 'EQ', 2, 'ev_d11r0101_choice_talk2')
	_MACRO_TALKMSG('dp_poffin_main', 'DP_poffin_main_178', 'Would you like to go on a stroll with your Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d11r0101_choice_yes')
	_JUMP('ev_d11r0101_cancel')
	_END()
ev_d11r0101_info_tinkatuff:
	_MACRO_TALKMSG('dialogue_d11r0101', '00_msg_d11r0101_info_girl_tinkatuff', 'Oh? I see you have quite a few badges.\nMaybe you can help us!\rWe let a Tinkatink into Amity Square.\nBut it seems like it evolved and is causing\ftrouble now.\rWould you kindly help us with the Tinkatuff\nplease?')
	_TALK_CLOSE()
	_RET()
ev_d11r0101_choice_talk1:
	_MACRO_TALKMSG('dialogue_d11r0101', '45-msg_c05r0301_woman6_01', 'In Amity Square, you may go for a stroll with a\ncute Pokémon.')
	_RET()
ev_d11r0101_choice_talk2:
	_MACRO_TALKMSG('dialogue_d11r0101', '46-msg_c05r0401_woman6_01', 'You can take a cute Pokémon out for a stroll in\nAmity Square.')
	_RET()
ev_d11r0101_cancel:
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_05', 'I see. Please come back if you happen to have a\nchange of heart. OK?')
	_JUMP('ev_d11r0101_end')
	_END()
ev_d11r0101_end:
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_d11r0101_player_down')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
ev_d11r0101_choice_yes:
	_LDVAL(@WK_SCENE_D11R0101_TNO, 0); @WK_SCENE_D11R0101_TNO = Party index of the Pokemon to spawn
	_TEMOTI_MONSNO(@WK_SCENE_D11R0101_TNO, @WK_SCENE_D11R0101_MONSNO); @WK_SCENE_D11R0101_MONSNO = Natdex number of the Pokemon to spawn
	_NICK_NAME(0, @WK_SCENE_D11R0101_TNO)
	_PC_KAIFUKU()
	_JUMP('ev_d11r0101_spawn_first_pokemon')
	_END()
ev_d11r0101_spawn_first_pokemon:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_SUB_WK(@SCWK_ANSWER, 1)
	_NATURAL_PARK_POKE_CREATE(@WK_SCENE_D11R0101_TNO)
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d11r0101_pkedash_single')
	_JUMP('ev_d11r0101_pkedash_multi')
	_END()
ev_d11r0101_pkedash_single:
	_LDVAL(@SCWK_TEMP0, 0)
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_13', 'Please do enjoy your time with {0,1,2,0},\njust the two of you! OK?')
	_TALK_CLOSE()
	_JUMP('ev_d11r0101_pkedash_player')
	_END()
ev_d11r0101_pkedash_multi:
	_TALKMSG('dp_poffin_main%DP_poffin_main_179b')
	_TALK_CLOSE()
	_NATURAL_PARK_POKE_KAISAN()
	_LDVAL(@SCWK_TEMP0, 0)
	_TALKMSG('dp_poffin_main%DP_poffin_main_180b')
	_TALK_CLOSE()
	_JUMP('ev_d11r0101_pkedash_player')
	_END()
ev_d11r0101_pkedash_player:
	_OBJ_ANIME('HERO', 'anm_d11r0101_player_up')
	_OBJ_ANIME('SCWK_PARAM10', 'anm_d11r0101_player_up')
	_OBJ_ANIME_WAIT()
	_LDVAL(@WK_SCENE_D11R0101, 2)
	_SYS_FLAG_PAIR_SET()
	_MOVE_CODE_CHANGE('SCWK_PARAM10', 'MV_PAIR')
	_TALK_END()
	_END()
ev_d11r0101_left_gate_01:
	_OBJ_POS_CHANGE(@SCWK_PARAM2, 12, 2, 47, 2)
	_RET()
ev_d11r0101_right_gate_01:
	_OBJ_POS_CHANGE(@SCWK_PARAM2, 51, 2, 47, 3)
	_RET()
pos_d11r0101_info_02:
	_LDVAL(@LOCALWORK15, 1)
	_JUMP('pos_d11r0101_info_w')
	_END()
pos_d11r0101_info_04:
	_LDVAL(@LOCALWORK15, 2)
	_JUMP('pos_d11r0101_info_w')
	_END()
pos_d11r0101_info_w:
	_EVENT_START()
	_SYS_FLAG_PAIR_RESET()
	_JUMP('common_pos_d11r0101_info_02')
	_END()
common_pos_d11r0101_info_02:
	_LDVAL(@WK_SCENE_D11R0101, 1)
	_NATURAL_PARK_POKE_SYUUGOU()
	_IF_FLAGON_JUMP(#3128, 'pos_d11r0101_info_tinkatuff_reward')
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_06', 'Are you feeling refreshed? Please come\nagain! OK?')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_d11r0101_player_down')
	_OBJ_ANIME_WAIT()
	_IF_FLAGOFF_CALL(#FE_DONE_FUREAI, 'ev_d11r0101_tips')
	_FLAG_SET(#FE_DONE_FUREAI)
	_SET_SYS_FLAG($SYS_FUREAI_EXIT)
	_TALK_END()
	_END()
pos_d11r0101_info_tinkatuff_reward:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP0, 'LT', 14, 'pos_d11r0101_info_tinkatuff_reward_west'); Player is at the west entrance
	_IFVAL_CALL(@SCWK_TEMP0, 'GT', 49, 'pos_d11r0101_info_tinkatuff_reward_east'); Player is at the east entrance
	_TIME_WAIT(15, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('HERO')
	_MACRO_TALKMSG('dialogue_d11r0101', '00_msg_d11r0101_info_tinkatuff_reward', 'Thanks for your help with the Tinkatuff.\nHere’s a little reward.')
	_TALK_CLOSE()
	_ADD_MAROYAKA_POFFIN()
	_ME_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_d11r0101', 'pos_d11r0101_info_mild_poffin', 'You received a Mild Poffin!\nYou put away the Mild Poffin in the Poffin Case.')
	_ME_WAIT()
	_TALK_CLOSE()
	_FLAG_RESET(#3128)
	_RET()
pos_d11r0101_info_tinkatuff_reward_west:
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_INFO_GIRL_01')
	_RET()
pos_d11r0101_info_tinkatuff_reward_east:
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_INFO_GIRL_02')
	_RET()
ev_d11r0101_tips:
	_CHARA_LOOK_LOCK('D11R0101_INFO_GIRL_01', 'HERO')
	_TIME_WAIT(1, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('D11R0101_INFO_GIRL_02', 'HERO')
	_TIME_WAIT(4, @SCWK_ANSWER)
	_OBJ_ANIME('D11R0101_INFO_GIRL_01', 'anm_d11r0101_gyoe')
	_OBJ_ANIME('D11R0101_INFO_GIRL_02', 'anm_d11r0101_gyoe')
	_OBJ_ANIME_WAIT()
	_IFVAL_CALL(@LOCALWORK15, 'EQ', 1, 'ev_d11r0101_tips_w')
	_IFVAL_CALL(@LOCALWORK15, 'EQ', 2, 'ev_d11r0101_tips_e')
	_MACRO_TALKMSG('dialogue_d11r0101', '58-msg_d11r0101_info_15', 'Oh, it looks like the Pokémon that was taking a\nstroll with you wants to go out!\rOnly special Trainers can make their Pokémon\nfeel that way!\rI’m pretty sure that your Pokémon would be\ndelighted if you let them out of their Poké Balls\foutside the square, too!')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('D11R0101_INFO_GIRL_01')
	_CHARA_LOOK_RELEASE('D11R0101_INFO_GIRL_02')
	_TALK_CLOSE()
	_RET()
ev_d11r0101_tips_w:
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_INFO_GIRL_01')
	_RET()
ev_d11r0101_tips_e:
	_CHARA_LOOK_LOCK('HERO', 'D11R0101_INFO_GIRL_02')
	_RET()
anm_d11r0101_gyoe:
	_AC_MARK_GYOE(1)
	_AC_WAIT(12)
	_ACMD_END()
anm_d11r0101_player_turn_left:
	_AC_DIR_L(8)
	_ACMD_END()
anm_d11r0101_player_turn_right:
	_AC_DIR_R(8)
	_ACMD_END()
anm_d11r0101_player_down:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_d11r0101_player_up:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
anm_d11r0101_poke_move_01:
	_AC_DOWN(2, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_d11r0101_uketsuke_01:
	_AC_DIR_R(8)
	_ACMD_END()
anm_d11r0101_uketsuke_02:
	_AC_DIR_L(8)
	_ACMD_END()
ev_d11r0101_talk_poke:
	_TALK_OBJ_START()
	_TALK_POKE_GET_TEMOTI_INDEX(@WK_SCENE_D11R0101_TNO)
	_FUREAI_TALK_START(@WK_SCENE_D11R0101_TNO)
	_TEMOTI_MONSNO(@WK_SCENE_D11R0101_TNO, @WK_SCENE_D11R0101_MONSNO)
	_GET_NATSUKI(@SCWK_TEMP0, @WK_SCENE_D11R0101_TNO, -1)
	_NICK_NAME(0, @WK_SCENE_D11R0101_TNO)
	_NATURAL_PARK_GET_MONOHIROI_ITEM_NO(@WK_SCENE_D11R0101_PRESENT_KINOMI_NO, @WK_SCENE_D11R0101_PRESENT_ACCE_NO)
	_IFVAL_JUMP(@WK_SCENE_D11R0101_PRESENT_KINOMI_NO, 'GE', 0, 'ev_d11r0101_present_kinomi_set')
	_IFVAL_JUMP(@WK_SCENE_D11R0101_PRESENT_ACCE_NO, 'GE', 0, 'ev_d11r0101_present_accessory_set')
	_JUMP('ev_d11r0101_pokemon_rnd_mes_check')
	_END()
ev_d11r0101_pokemon_rnd_mes_check:
	_GET_RND(@SCWK_ANSWER, 9)
	_GET_RND(@SCWK_TEMP2, 2)
	_LDVAL(@SCWK_TEMP2, 0)
	_GET_RND(@SCWK_TEMP3, 0)
	_GET_RND(@LOCALWORK4, 4)
	_LDVAL(@SCWK_REG0, 0)
	_IFVAL_CALL(@WK_SCENE_D11R0101_MONSNO, 'EQ', 25, 'ev_d11r0101_sp_voice_pokemon')
	_IFVAL_CALL(@WK_SCENE_D11R0101_MONSNO, 'EQ', 133, 'ev_d11r0101_sp_voice_pokemon')
	_IFVAL_JUMP(@SCWK_TEMP0, 'GE', 255, 'ev_d11r0101_pokemon_rnd_mes_s')
	_IFVAL_JUMP(@SCWK_TEMP0, 'GE', 200, 'ev_d11r0101_pokemon_rnd_mes_a')
	_IFVAL_JUMP(@SCWK_TEMP0, 'GE', 150, 'ev_d11r0101_pokemon_rnd_mes_b')
	_IFVAL_JUMP(@SCWK_TEMP0, 'GE', 70, 'ev_d11r0101_pokemon_rnd_mes_c')
	_IFVAL_JUMP(@SCWK_TEMP0, 'GE', 35, 'ev_d11r0101_pokemon_rnd_mes_d')
	_JUMP('ev_d11r0101_pokemon_rnd_mes_e')
	_END()
ev_d11r0101_sp_voice_pokemon:
	_LDVAL(@SCWK_REG0, 1)
	_RET()
