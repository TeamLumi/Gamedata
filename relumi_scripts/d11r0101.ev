	_EASY_VOICE_MSG('dialogue_d11r0101%58-msg_d11r0101_pikachu_01', 'PLAY_PV_EV_025_00_02')
	_END()
ev_d11r0101_babygirl1:
	_IF_FLAGOFF_JUMP(#3121, 'ev_d11r0101_babygirl1_tinkatuff')
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', '58-msg_d11r0101_babygirl1_01', 'You should talk to your Pokémon.\nIt can occasionally find things.')
	_END()
ev_d11r0101_babygirl1_tinkatuff:
	_MACRO_EASY_OBJ_MSG('dialogue_d11r0101', 'ev_d11r0101_babygirl1_tinkatuff', 'My Clefairy is so much cuter than Tinkatuff!')
	_END()
ev_d11r0101_pippib:
	_EASY_VOICE_MSG('dialogue_d11r0101%58-msg_d11r0101_pippi_01', 'PLAY_PV_EV_035_00_00')
	_END()
