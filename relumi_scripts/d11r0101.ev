	_TIME_WAIT(20, @LOCALWORK19)
	_OBJ_ANIME_FUREAI(@WK_SCENE_D11R0101_TNO, 'anm_d11r0101_poke_s_02')
	_PLAY_FUREAI_VOICE_NAKAYOSHIRANK(@WK_SCENE_D11R0101_TNO)
	_PLAY_EMO_SE(2)
	_TIME_WAIT(60, @LOCALWORK19)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d11r0101_pokemon_s_01')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d11r0101_pokemon_s_02')
