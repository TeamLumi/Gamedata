ev_c05pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c05pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_c05pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c05pc0101_flag_change_del_stopper')
	_END()
ev_c05pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_c05pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_c05pc0101_boy2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05pc0101', '40-msg_c05pc0101_boy2_01', 'Have you seen the globe at the GWS in\nJubilife City?\rIt’s so awesomely awesome! I can’t really explain\nit well, but it’s downright wicked!')
	_END()
ev_c05pc0101_lady:
	_MACRO_EASY_OBJ_MSG('dialogue_c05pc0101', '40-msg_c05pc0101_lady_01', 'Hello, do you have a Poffin Case?\rIf you haven’t got one, you really must visit the\nPokémon Fan Club.')
	_END()
ev_c05pc0101_man2:
	_JUMP('ev_c05pc0101_man2_rp')
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_T05_GINGABOSS_TALK, 'ev_c05pc0101_man2_02')
	_MACRO_TALKMSG('dialogue_c05pc0101', '40-msg_c05pc0101_man2_01', 'They’re saying that Gym Leader Fantina’s\nnot around.\rHeh! She must’ve heard I’m around and\nchickened out!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05pc0101_man2_02:
	_MACRO_TALKMSG('dialogue_c05pc0101', '40-msg_c05pc0101_man2_02', 'Yeah, so the Gym Leader came back, and I\nchallenged her.\rShe wiped the floor with us. I have to heal up\nmy team now...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05pc0101_man2_rp:
	_MACRO_EASY_OBJ_MSG('dialogue_c05pc0101', '00_c05pc0101_man2_rp_01', 'Fantina, the Gym Leader, likes\nContests, too.\rThat lady has a huge appetite for\nexperiencing everything in life!')
	_END()