ev_c07r0203_flag_change:
	_LDVAL(@WK_ELEVATOR_FLOOR, 3)
	_END()
ev_c07r0203_depart_01:
	_TALK_OBJ_START()
	_REGULAR_CHECK(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c07r0203_regular_check')
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_01', 'Hello. May I help you with anything?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_229', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_228', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'c07r0203_randam_osusume')
	_CASE_JUMP(0, 'ev_c07r0203_depart_03')
	_JUMP('ev_c07r0203_depart_03')
c07r0203_regular_check:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_02', 'Hello, {0,1,0,0}.\nMay I help you with anything?', 0, 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_229', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_228', 0)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(1, 'c07r0203_randam_osusume')
	_CASE_JUMP(0, 'ev_c07r0203_depart_03')
	_JUMP('ev_c07r0203_depart_03')
c07r0203_randam_osusume:
	_GET_RND(@SCWK_ANSWER, 4)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07r0203_depart_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07r0203_depart_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c07r0203_depart_06')
	_JUMP('ev_c07r0203_depart_07')
	_JUMP('ev_c07r0203_depart_03')
ev_c07r0203_depart_03:
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_03', 'Please enjoy yourself.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_depart_04:
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_04', 'False Swipe makes wild Pokémon easier to catch.\rMany customers have confided that to\nme recently.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_depart_05:
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_05', 'For Fire-type Pokémon, may I suggest Fire Blast?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_depart_06:
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_06', 'The move Protect is the perfect solution for\ndodging attacks. Please be aware that repeated\fuse can result in failure.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_depart_07:
	_MACRO_TALKMSG('dialogue_c07r0203', '98-msg_c07r0203_depart_07', 'When it is raining, the accuracy of Thunder\nbecomes precise. Please do be careful about\fthe weather.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_babygirl1:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0203', '98-msg_c07r0203_babygirl1_01', 'A friend traded me a Machoke using a\ncommunication feature.\rBut instead of a Machoke, I got\na different Pokémon!')
	_END()
ev_c07r0203_man2:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0203', '98-msg_c07r0203_man2_01', 'I love TMs, so I come here to window shop all\nthe time...')
	_END()
ev_c07r0203_fix_shop_01:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c07r0203_01_fix_shop_re')
	_END()
ev_c07r0203_01_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c07r0203_01_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c07r0203_01_fix_shop_buy')
	_CASE_JUMP(1, 'ev_c07r0203_01_fix_shop_sell')
	_CASE_JUMP(2, 'ev_c07r0203_01_fix_shop_end')
	_JUMP('ev_c07r0203_01_fix_shop_end')
	_END()
ev_c07r0203_01_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c07r0203', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c07r0203_01_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_GET_GOLD(@LOCALWORK10)
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(7)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_GET_GOLD(@LOCALWORK11)
	_IFVAL_CALL(@LOCALWORK10, 'GT', @LOCALWORK11, 'ev_c07r0203_depart_count')
	_JUMP('ev_c07r0203_01_fix_shop_re')
	_END()
ev_c07r0203_01_fix_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_c07r0203_01_fix_shop_re')
	_END()
ev_c07r0203_01_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_fix_shop_02:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c07r0203_02_fix_shop_re')
	_END()
ev_c07r0203_02_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c07r0203_02_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c07r0203_02_fix_shop_buy')
	_CASE_JUMP(1, 'ev_c07r0203_02_fix_shop_sell')
	_CASE_JUMP(2, 'ev_c07r0203_02_fix_shop_end')
	_JUMP('ev_c07r0203_02_fix_shop_end')
	_END()
ev_c07r0203_02_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c07r0203', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c07r0203_02_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_GET_GOLD(@LOCALWORK10)
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(8)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_GET_GOLD(@LOCALWORK11)
	_IFVAL_CALL(@LOCALWORK10, 'GT', @LOCALWORK11, 'ev_c07r0203_depart_count')
	_JUMP('ev_c07r0203_02_fix_shop_re')
	_END()
ev_c07r0203_depart_count:
	_ADD_WK(@SYS_WORK_DEPART_COUNT, 1)
	_RET()
ev_c07r0203_02_fix_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_c07r0203_02_fix_shop_re')
	_END()
ev_c07r0203_02_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0203_board:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0203', '98-msg_c07r0203_board_01', 'This is the <color=#F01E1EFF>third floor</color>.\rB1F: Food & Produce\n1F: Trainers’ Zone\f2F: Battle Collection\f3F: TM Corner\f4F: Pedestal Floor\f5F: Rooftop Plaza')
	_END()