ev_r205ar0101_middlewoman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r205ar0101', '103-msg_r205ar0101_middlewoman1_01', 'You seem to be tired...\nRest a while.')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r205ar0101_middlewoman1_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r205ar0101_middlewoman1_03')
	_END()
ev_r205ar0101_middlewoman1_02:
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SE_PLAY('M_FI002')
	_ME_WAIT()
	_PC_KAIFUKU()
	_TIME_WAIT(60, @SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_r205ar0101', '103-msg_r205ar0101_middlewoman1_02', 'You and your Pokémon look\ncompletely refreshed!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_middlewoman1_03:
	_MACRO_TALKMSG('dialogue_r205ar0101', '103-msg_r205ar0101_middlewoman1_03', 'Just because you’re young doesn’t mean you\nshould push yourself.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_seven1:
	_MACRO_EASY_OBJ_MSG('dialogue_r205ar0101', '103-msg_r205ar0101_seven1_04', 'You think you can get through Eterna Forest\nby yourself?')
	_END()
ev_r205ar0101_dj:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#1782, 'ev_r205ar0101_dj_tray_space_recheck')
	_IF_FLAGON_JUMP(#1800, 'ev_r205ar0101_dj_badge_two')
	_IF_FLAGON_JUMP(#1801, 'ev_r205ar0101_dj_badge_one_again')
	_JUMP('ev_r205ar0101_dj_intro')
ev_r205ar0101_dj_intro:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_intro_1', 'I’m here in search of a special rock for a\nspecial Pokémon of mine.\rDo you know it?\rEevee evolves inside Eterna Forest because of\nthe energy there.\rNo other evolution can overpower that\nreaction!')
	_GET_DEX_STATUS(133, @SCWK_ANSWER); Checks if Eevee is registered as caught in the dex
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_r205ar0101_dj_badge_check')
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_intro_2', 'I’ll be here studying Eevee’s reactions for a\nwhile.\rCome see me again if you learn anything about\nEevees, okay?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_badge_check:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_badge_check_1', 'Oh... You know about Eevees, huh?\nCan I see how many badges you’ve got?')
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 2, 'ev_r205ar0101_dj_badge_one'); Jumps to an exit script if the player has fewer than 2 badges
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_badge_check_2', 'Mhmm, okay. Two badges.\rHow about we make a deal?')
	_JUMP('ev_r205ar0101_dj_badge_two')
ev_r205ar0101_dj_badge_one:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_badge_one', 'Hmm, one. Okay.\rCome back when you’ve gotten your next one.\nI want to propose a deal to you.')
	_FLAG_SET(#1801)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_badge_one_again:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 1, 'ev_r205ar0101_dj_badge_two_again'); Jumps an altnernate dialogue if the player has obtained their second badge since the first encounter
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_badge_one_again', 'Do you have your Forest Badge yet? No?\rOkay, I’ll be here for a while longer.\nCome see me again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_badge_two:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_badge_two', 'Can I meet your Pokémon?')
	_FLAG_SET(#1800)
	_TALK_CLOSE()
	_JUMP('ev_r205ar0101_dj_box_check')
ev_r205ar0101_dj_badge_two_again:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_badge_two_again', 'Do you have your Forest Badge yet? Yes?\rHow about we make a deal?')
	_JUMP('ev_r205ar0101_dj_badge_two')
ev_r205ar0101_dj_box_check:
    _POKELIST_SET_PROC(21); This only highlight a specific list of mons detailed in UIDatabase.BoxOpenParam
  	_POKELIST_GET_RESULT(@SCWK_PARAM0, @SCWK_PARAM3); Argument 1 is the bag/box position, Argument 2 is the box number (-1 = Party)
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', -1, 'ev_r205ar0101_dj_box_check_no'); If SCK_PARAM0 is -1, it means you chose nothing.
    _TEMOTI_BOX_MONSNO(@SCWK_PARAM0, @SCWK_PARAM3, @SCWK_PARAM1); Get the MonsNo of the selected Pokemon, SCWK_PARAM1
	_SWITCH(@SCWK_PARAM1)
	_CASE_JUMP(133, 'ev_r205ar0101_dj_box_check_eevee'); Eevee
	_CASE_JUMP(134, 'ev_r205ar0101_dj_box_check_vaporeon'); Vaporeon
	_CASE_JUMP(135, 'ev_r205ar0101_dj_box_check_jolteon'); Jolteon
	_CASE_JUMP(136, 'ev_r205ar0101_dj_box_check_flareon'); Flareon
	_CASE_JUMP(196, 'ev_r205ar0101_dj_box_check_espeon'); Espeon
	_CASE_JUMP(197, 'ev_r205ar0101_dj_box_check_umbreon'); Umbreon
	_CASE_JUMP(470, 'ev_r205ar0101_dj_box_check_leafeon'); Leafeon
	_CASE_JUMP(471, 'ev_r205ar0101_dj_box_check_glaceon'); Glaceon
	_CASE_JUMP(700, 'ev_r205ar0101_dj_box_check_sylveon'); Sylveon
	_CASE_JUMP(0, 'ev_r205ar0101_dj_box_check_egg'); Egg
	_JUMP('ev_r205ar0101_dj_box_check_invalid'); Everything else
    _END()
ev_r205ar0101_dj_box_check_no:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_no', 'No rush! I’m not going to force you to show me\nyour friends or anything.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_box_check_egg:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_egg', 'If I had a Luxray to look inside, maybe...\nBut I don’t, so I can’t see in the egg!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_box_check_invalid:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_invalid', 'You have a Pokédex, right?\rMaybe you should search for Eevee to see\nwhat I’m looking for.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_box_check_eeveelution_no_move:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_eeveelution_no_move', 'You need some more time to decide?\rThat’s okay but I’ve gotta make a move.\rI’m done investigating the Mossy Rock, so I’m\nheaded to Hearthome to check out that cutie\fpark.\rYou can find me there. Bye!')
	_JUMP('ev_r205ar0101_dj_no_move_end')
ev_r205ar0101_dj_box_check_eeveelution_invalid_no_move:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_eeveelution_invalid_no_move', 'That isn’t my special Eevee...\rY’know what,\nI can teach you that special move later.\rI’m done investigating the Mossy Rock, so I’m\nheaded to Hearthome to check out that cutie\fpark.\rYou can find me there. Bye!')
	_JUMP('ev_r205ar0101_dj_no_move_end')
ev_r205ar0101_dj_box_check_eeveelution:
	_CALL('ev_r205ar0101_dj_eevee_give')
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_eeveelution_1', 'You’ve already got {0}, so you\ncan have this before I move on.')
	_TALK_CLOSE()
	_POKELIST_SET_PROC(20) ; Setup Pokémon list with an argument of 20 to be able to select Eevees
	_POKELIST_GET_RESULT(@SCWK_PARAM0, @SCWK_PARAM1) ; Open the Pokémon list and get its result. Argument 1 is the bag/box position, Argument 2 is the box number (-1 = Party)
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', -1, 'ev_r205ar0101_dj_box_check_eeveelution_no_move') ; If SCK_PARAM0 is -1, the player chose nothing
	_TEMOTI_BOX_MONSNO(@SCWK_PARAM0, @SCWK_PARAM1, @SCWK_PARAM2) ; Get the MonsNo of the selected Pokémon -> SCWK_PARAM2
	_TEMOTI_BOX_FORMNO(@SCWK_PARAM0, @SCWK_PARAM1, @SCWK_PARAM3); Get the FormNo of the selected Pokemon, -> SCWK_PARAM3
	_IFVAL_JUMP(@SCWK_PARAM2, 'NE', 133, 'ev_r205ar0101_dj_box_check_eeveelution_invalid_no_move')
	_IFVAL_JUMP(@SCWK_PARAM3, 'EQ', 0, 'ev_r205ar0101_dj_box_check_eeveelution_invalid_no_move')
	_IFVAL_JUMP(@SCWK_PARAM3, 'EQ', 2, 'ev_r205ar0101_dj_box_check_eeveelution_invalid_no_move')
	_IF_FLAGOFF_CALL(#1790, 'ev_lumi_move_tutor_add_dev_dj_1_table')
	_IF_FLAGOFF_CALL(#1789, 'ev_lumi_move_tutor_add_dev_dj_2_table')
	_IF_FLAGOFF_CALL(#1788, 'ev_lumi_move_tutor_add_dev_dj_3_table')
	_IF_FLAGOFF_CALL(#1787, 'ev_lumi_move_tutor_add_dev_dj_4_table')
	_IF_FLAGOFF_CALL(#1786, 'ev_lumi_move_tutor_add_dev_dj_5_table')
	_IF_FLAGOFF_CALL(#1785, 'ev_lumi_move_tutor_add_dev_dj_6_table')
	_IF_FLAGOFF_CALL(#1784, 'ev_lumi_move_tutor_add_dev_dj_7_table')
	_IF_FLAGOFF_CALL(#1783, 'ev_lumi_move_tutor_add_dev_dj_8_table')
	_MOVE_TUTOR_UI(@SCWK_ANSWER, @SCWK_PARAM0, @SCWK_PARAM1) ; Open the move tutor UI with the stored tables and put the result into SCWK_ANSWER
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_r205ar0101_dj_box_check_eeveelution_invalid_no_move') ; -1 if no moves in the stored tables can be learned by the selected Pokémon
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r205ar0101_dj_box_check_eeveelution_no_move') ; 0 if the relearning was canceled
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 733, 'ev_lumi_move_tutor_disable_dev_dj_1_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 734, 'ev_lumi_move_tutor_disable_dev_dj_2_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 735, 'ev_lumi_move_tutor_disable_dev_dj_3_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 736, 'ev_lumi_move_tutor_disable_dev_dj_4_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 737, 'ev_lumi_move_tutor_disable_dev_dj_5_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 738, 'ev_lumi_move_tutor_disable_dev_dj_6_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 739, 'ev_lumi_move_tutor_disable_dev_dj_7_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 740, 'ev_lumi_move_tutor_disable_dev_dj_8_table')
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_box_check_eeveelution_2', 'And there you go!')
	_LDVAL(@506, 1)
	_JUMP('ev_r205ar0101_dj_end')
ev_r205ar0101_dj_box_check_eevee:
	_CALL('ev_r205ar0101_dj_eevee_give')
	_LDVAL(@506, 0)
	_JUMP('ev_r205ar0101_dj_end')
ev_r205ar0101_dj_eevee_give:
	_NICK_NAME_ALL(0, @SCWK_PARAM0, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_eevee_give_1', 'Oh my gosh! {0}, hi!\nLook at how sweet it is.\rOkay, I’m decided. Here’s an Eevee for you.')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_r205ar0101_dj_trays_full'); Party and Boxes are full
	_JUMP('ev_r205ar0101_dj_eevee_give_gift')
ev_r205ar0101_dj_eevee_give_gift:
	_ADD_POKEMON_UI_EXTRA(133, 1, 20, 0, 3, 22); MonsNo, FormNo, Level, Item, MaxIvs, BallId
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_eevee_give_2', 'This is a special Eevee.\rIt’s got a ton of hidden potential but it turns\nout it can’t evolve at all.\rI was going to take it on an adventure with me,\nbut I think it would get a lot more out of going\fwith you while you’re on your gym challenge!\rI’m developing some special moves with the\nrest of my sweeties, so here’s the deal:\rShow me your love for all Eevees!\rFor every Eevee you raise to a new evolution,\nI’ll let you in on the secrets of our cool moves.')
	_RET()
ev_r205ar0101_dj_tray_space_recheck:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_tray_space_recheck', 'I’m decided. Here’s an Eevee for you.')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_r205ar0101_dj_trays_full'); Party and Boxes are full
	_CALL('ev_r205ar0101_dj_eevee_give_gift')
	_LDVAL(@506, 0)
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_tray_space_recheck_no_move', 'I’ve gotta get going, so I can teach you that\nspecial move later.\rI’m done investigating the Mossy Rock, so I’m\nheaded to Hearthome to check out that cutie\fpark.\rYou can find me there. Bye!')
	_JUMP('ev_r205ar0101_dj_no_move_end')
ev_r205ar0101_dj_trays_full:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_trays_full', 'Oh, you have a ton of friends already!\rThat’s okay, this one will wait with me until\nyou’ve got room.')
	_TALK_CLOSE()
	_FLAG_SET(#1782); Dev DJ is holding onto Partner Eevee until the player has room in their trays.
	_TALK_OBJ_END()
	_END()
ev_r205ar0101_dj_end:
	_MACRO_TALKMSG('dialogue_r205ar0101', 'msg_r205ar0101_dj_end', 'By the way, it’s one move per badge.\rGotta make sure my little partner gets all the\nway to the end of your journey somehow!\rI’m done investigating the Mossy Rock, so I’m\nheaded to Hearthome to check out that cutie\fpark.\rYou can find me there. Bye!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_DEL('R205AR0101_DJ')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_FLAG_RESET(#2922)
	_FLAG_SET(#1802)
	_END()
ev_r205ar0101_dj_no_move_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_DEL('R205AR0101_DJ')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_FLAG_RESET(#2922)
	_FLAG_SET(#1802)
	_FLAG_SET(#1791)
	_END()
ev_r205ar0101_dj_box_check_vaporeon:
	_FLAG_SET(#1799)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_jolteon:
	_FLAG_SET(#1798)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_flareon:
	_FLAG_SET(#1797)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_espeon:
	_FLAG_SET(#1796)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_umbreon:
	_FLAG_SET(#1795)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_leafeon:
	_FLAG_SET(#1794)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_glaceon:
	_FLAG_SET(#1793)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')
ev_r205ar0101_dj_box_check_sylveon:
	_FLAG_SET(#1792)
	_JUMP('ev_r205ar0101_dj_box_check_eeveelution')