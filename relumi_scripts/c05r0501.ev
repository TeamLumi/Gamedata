ev_c05r0501_aaron_exit_5:
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_exit_5')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c05r0501_aaron_exit_1:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_AC_DIR_L(8)
	_AC_LEFT(3, 8)
	_ACMD_END()
anm_c05r0501_aaron_exit_2:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_AC_DIR_L(8)
	_AC_LEFT(3, 8)
	_ACMD_END()
anm_c05r0501_aaron_exit_3:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_L(8)
	_AC_LEFT(3, 8)
	_ACMD_END()
anm_c05r0501_aaron_exit_4:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(2, 8)
	_AC_DIR_L(8)
	_AC_LEFT(3, 8)
	_ACMD_END()
anm_c05r0501_aaron_exit_5:
