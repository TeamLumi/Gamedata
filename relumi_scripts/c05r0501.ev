anm_c05r0501_action_turn_right: ; Not called
	_AC_DIR_R(4)
	_ACMD_END()
anm_c05r0501_aaron_better:
	_AC_DIR_R(4)
	_AC_RIGHT(3, 8)
	_ACMD_END()
anm_c05r0501_aaron_better_up:
	_AC_DIR_D(4)
	_AC_HERO_MATCH_Z(8)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c05r0501_aaron_better_down:
	_AC_DIR_U(4)
	_AC_HERO_MATCH_Z(8)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c05r0501_hero_turn_left:
	_AC_DIR_L(4)
	_ACMD_END()
ev_c05r0501_aaron_intro_up:
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_better_up')
	_OBJ_ANIME('HERO', 'anm_c05r0501_hero_turn_left')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r0501_aaron_intro_down:
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_better_down')
	_OBJ_ANIME('HERO', 'anm_c05r0501_hero_turn_left')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r0501_aaron_decide_path_intro:
	_IFVAL_JUMP(@SCWK_TEMP1, 'GT', 7, 'ev_c05r0501_aaron_intro_up')
	_IFVAL_JUMP(@SCWK_TEMP1, 'LT', 7, 'ev_c05r0501_aaron_intro_down')
	_OBJ_ANIME('HERO', 'anm_c05r0501_hero_turn_left')
	_OBJ_ANIME_WAIT()
	_RET()
pos_c05r0501_aaron_trigger:
	_TALK_OBJ_START()
	_FLAG_RESET(#2853); This is the Placedata for Aaron's Chibi.
	_OBJ_ADD('C05R0501_AARON')
	_LDVAL(@489, 1); This is the flag for the Stopdata Trigger.
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1); Get's the player position and uses it in ev_c05r0501_aaron_decide_path_intro
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_better')
	_OBJ_ANIME_WAIT()
	_CALL('ev_c05r0501_aaron_decide_path_intro')
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_greeting', 'Hello! You’re a Trainer, aren’t you?\rOh, your Pokémon look hurt.\nLet me heal them for you...!')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_PC_KAIFUKU()
	_SE_PLAY('M_FI002')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_question', 'Your name is {0,1,0,0}?\nI’m Aaron of the Elite Four.\nIt’s good to meet you.\rI’m a huge fan of Bug-type Pokémon.\nThey’re nasty-mean, and yet beautiful.\rDo you get what I mean?\nSome of them are really strong, too.\rI just can’t help but gush about\nthem to everyone!\rIn fact, how about I show you some\nbeautiful bugs right now?\rI’ll try and fight closer to your level,\nbut don’t worry if you lose!\rSo, shall I show you my beautiful\nbugs in an unofficial battle?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05_aaron_yes_battle')
	_JUMP('ev_c05_aaron_no_battle')
ev_c05_aaron_no_battle:
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_no', 'Really? I’d reconsider.\rI’ll make it worth your while,\nand it’s fine if you lose.\rSo, shall I show you my beautiful\nbugs in an unofficial battle?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05_aaron_yes_battle')
	_JUMP('ev_c05_aaron_no_battle')
ev_c05_aaron_yes_battle:
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_yes', 'Brilliant! Here come my nasty,\nmean, yet beautiful partners!')
	_TALK_CLOSE()
	_SET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_LDVAL(@SCWK_TEMP3, 943)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_RESET_SYS_FLAG($SYS_ZENMETU_MUSI)
	;If the player loses the battle
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05_aaron_battle_lose')
	_OBJ_DIR_CHANGE('HERO', 90)
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_win', 'Wow! Your Pokémon are\ntrained seriously well.\rI expect I’ll see you at the\nPokémon League for an official battle!')
	_JUMP('ev_c05_aaron_post_battle')
ev_c05_aaron_battle_lose:
	_TIME_WAIT(5, @SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 6)
	;Heal party
	_PC_KAIFUKU()
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_lose', 'Don’t sweat about losing.\nI’m an Elite Four member, after all!')
	_JUMP('ev_c05_aaron_post_battle')
ev_c05_aaron_post_battle:
	_OBJ_DIR_CHANGE('HERO', 90)
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_1', 'So, have I shown you the greatness\nof Bug-type Pokémon?\rEither way, I’ve got a TM for you\nfor listening to my spiel!\rIt’s the purely offensive Bug-type\nmove, X-Scissor!')
	_LDVAL(@SCWK_TEMP0, 408)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c05r0501', '00_msg_c05_aaron_2', 'Alright! It was great to meet\nyou. See you another time!')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 5, 'ev_c05r0501_aaron_exit_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 6, 'ev_c05r0501_aaron_exit_2')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 7, 'ev_c05r0501_aaron_exit_5')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 8, 'ev_c05r0501_aaron_exit_3')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 9, 'ev_c05r0501_aaron_exit_4')
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C05R0501_AARON')
	_SE_WAIT('S_FI001')
	_FLAG_SET(#2853)
	_TALK_OBJ_END()
	_END()
ev_c05r0501_aaron_exit_1:
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_exit_1')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r0501_aaron_exit_2:
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_exit_2')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r0501_aaron_exit_3:
	_OBJ_ANIME('C05R0501_AARON', 'anm_c05r0501_aaron_exit_3')
