ev_r212ar0103_flag_change:
	_GET_NOW_HOUR(@LOCALWORK0)
	_IF_FLAGOFF_CALL(#FH_01, 'r212ar0103_batler_01_pos')
	_IF_FLAGON_CALL(#FH_01, 'r212ar0103_batler_01_del')
	_IF_FLAGOFF_CALL(#2540, 'ev_r212ar0103_maid_movecode')
	_IF_FLAGON_CALL(#2540, 'ev_r212ar0103_egg_del')
	_IFVAL_JUMP(@479, 'EQ', 1, 'ev_r212ar0103_manaphy')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'r212ar0103_policeman_01_set')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'r212ar0103_policeman_01_set')
	_IFVAL_JUMP(@LOCALWORK0, 'LE', 5, 'r212ar0103_policeman_01_del')
	_JUMP('r212ar0103_policeman_01_set')
	_JUMP('r212ar0103_policeman_01_set')
ev_r212ar0103_maid_movecode:
	_SXY_POS_CHANGE('R212AR0103_BUTLER', 14, 8)
	_SXY_POS_CHANGE('R212AR0103_RICH', 15, 8)
	_SXY_POS_CHANGE('R212AR0103_MAID', 17, 8)
	_MOVE_CODE_CHANGE('R212AR0103_MAID', 'MV_DOWN')
	_OBJ_DIR_CHANGE('R212AR0103_MAID', 0)
	_RET()
ev_r212ar0103_egg_del:
	_FIND_BG_DISABLE(0, 'MANAPHY_EGG')
	_RET()
r212ar0103_policeman_01_set:
	_FLAG_RESET(#FV_R212AR0103_POLICEMAN)
	_LDVAL(@WK_SCENE_R212AR0101_POLICEMAN, 0)
	_FLAG_SET(#FH_02)
	_OBJ_DEL('R212AR0103_STATUE')
	_END()
r212ar0103_policeman_01_del:
	_FLAG_SET(#FV_R212AR0103_POLICEMAN)
	_LDVAL(@WK_SCENE_R212AR0101_POLICEMAN, 1)
	_FLAG_RESET(#FH_02)
	_OBJ_ADD('R212AR0103_STATUE')
	_END()
r212ar0103_batler_01_del:
	_OBJ_DEL('R212AR0103_BUTLER')
	_RET()
r212ar0103_batler_01_pos:
	_IFCOORDS_JUMP('R212AR0103_RICH', 15, 8, 'r212ar0103_batler_01_pos_alt'); If the player saved and reset in the room while Mr. Backlot is in the Butler's spot, move the Butler to his alternate spot.
	_SXY_POS_CHANGE('R212AR0103_BUTLER', 15, 8)
	_RET()
r212ar0103_batler_01_pos_alt:
	_SXY_POS_CHANGE('R212AR0103_BUTLER', 14, 8)
	_RET()
ev_r212ar0103_rich:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#TMFLG_URANIWA_ENCOUNT, 'ev_r212ar0103_rich_09')
	_IFVAL_JUMP(@LOCALWORK11, 'EQ', 1, 'ev_r212ar0103_rich_09')
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_rich_02')
	_JUMP('ev_r212ar0103_rich_01')
ev_r212ar0103_rich_01:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_01_1', 'Hello, hello! Welcome to my opulent mansion!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_01_2', 'Er-hem!\rThere’s a lot for me to be proud of inside and\noutside of this home...\rBut what makes me the most proud is my trophy\ngarden in the back!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_01_3', 'Why bother traveling afar when Pokémon are\nattracted by my garden? They come to me!\rYou’re welcome to join them and marvel at\nmy garden!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_rich_02:
	_IF_FLAGON_JUMP(#FV_R212AR0103_RICH, 'ev_r212ar0103_rich_03')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_01_1', 'Hello, hello! Welcome to my opulent mansion!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_10_1', 'I’ve been always proud of my trophy garden,\nbut to be able to brag about it even more, I’ve\fupgraded it!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_10_2', 'That means there are way more Pokémon you’ve\nnever seen before, such as this Pokémon and\fthat Pokémon!')
	_JUMP('ev_r212ar0103_rich_03')
	_END()
ev_r212ar0103_rich_03:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_03_1', 'Er-hem!\rThere’s a lot for me to be proud of inside and\noutside of this home...\rBut what makes me the most proud is my trophy\ngarden in the back!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_03_2', 'Why bother traveling afar when Pokémon are\nattracted by my garden? They come to me!\rWell, doesn’t that make you envious? You are\nenvious, yes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r212ar0103_rich_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_rich_04')
	_END()
ev_r212ar0103_rich_04:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_04', 'I know you’re really envious... You’re not\nfooling anyone...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_rich_05:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_05_1', 'Muhohoho... I bet you are! I knew you would be!\rBut I don’t mind! I enjoy sharing my stories\nwith you!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_05_2', 'So! When I go out into my prized garden,\nPokémon come running to me.\rThey sidle up, happy as they can be, to see me!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_05_3', 'Well? Doesn’t that make you envious? You are\nenvious, yes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r212ar0103_rich_06')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_rich_04')
	_END()
ev_r212ar0103_rich_06:
	_URAYAMA_ENCOUNT_SET()
	_URAYAMA_ENCOUNT_NO_CHK(@SCWK_PARAM0)
	_POKEMON_NAME_EXTRA(0, @SCWK_PARAM0, 0, 0)
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_06_1', 'Muhohoho... I bet you are! I knew you would be!\rBut I don’t mind! I enjoy sharing my stories\nwith you!')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_06_2', 'So! This is what happened this morning when I\nwent into my trophy garden.\rI noticed a cute-eyed {0,1,1,0}, which\njoyously ran over to me.\rThe {0,1,1,0} ran up and gave me a\nsmooch on my cheek...')
	_PLAYER_POS_GET(@SCWK_PARAM1, @SCWK_PARAM2)
	_OBJ_ANIME('R212AR0103_BUTLER', 'anm_r212ar0103_butler_to_urayama')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_01', 'M-Master! Th-that Pokémon you mentioned...\nIt doesn’t exist in the garden...')
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_urayama_turn_to_butler')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_07', 'Wha—?\rErm... Wh-what are you saying? I’m no blowhard!\rListen...\n*mutter mutter* *whisper whisper*')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_02', 'Yes, Master! Right away, sir!')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0103_BUTLER', 'anm_r212ar0103_butler_to_exit_l')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('R212AR0103_BUTLER')
	_FLAG_SET(#FH_01)
	_LDVAL(@LOCALWORK11, 1)
	_CALL('ev_r212ar0103_urayama_turn_to_hero')
	_FLAG_SET(#FV_R212AR0103_RICH)
	_FLAG_SET(#TMFLG_URANIWA_ENCOUNT)
	_JUMP('ev_r212ar0103_rich_09')
	_JUMP('ev_r212ar0103_rich_09')
ev_r212ar0103_rich_09:
	_URAYAMA_ENCOUNT_NO_CHK(@SCWK_PARAM0)
	_POKEMON_NAME_EXTRA(0, @SCWK_PARAM0, 0, 0)
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_rich_09', '...It’s true, I tell you! No lies ever leave these lips!\rThere really are cute {0,1,1,0} in my\ntrophy garden! Honest truth!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_urayama_turn_to_hero:
	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 4, 'anm_r212ar0103_urayama_turn_to_hero_l')
	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 6, 'anm_r212ar0103_urayama_turn_to_hero_r')
	_IFVAL_JUMP(@SCWK_PARAM2, 'EQ', 6, 'anm_r212ar0103_urayama_turn_to_hero_u')
	_JUMP('anm_r212ar0103_urayama_turn_to_hero_d')
	_JUMP('anm_r212ar0103_urayama_turn_to_hero_l')
anm_r212ar0103_urayama_turn_to_hero_l:
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_urayama_turn_to_hero_l')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r212ar0103_urayama_turn_to_hero_r:
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_urayama_turn_to_hero_r')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r212ar0103_urayama_turn_to_hero_u:
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_urayama_turn_to_hero_u')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r212ar0103_urayama_turn_to_hero_d:
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_urayama_turn_to_hero_d')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r212ar0103_butler_normal_dir:
	_AC_DIR_D(8)
	_ACMD_END()
anm_r212ar0103_butler_to_urayama:
	_AC_MARK_GYOE(1)
	_AC_WAIT(1)
	_AC_DIR_R(8)
	_ACMD_END()
anm_r212ar0103_urayama_turn_to_butler:
	_AC_MARK_GYOE(1)
	_AC_DIR_L(8)
	_ACMD_END()
anm_r212ar0103_butler_to_exit_l:
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_AC_VANISH_ON(1)
	_ACMD_END()
anm_r212ar0103_urayama_turn_to_hero_l:
	_AC_DIR_L(8)
	_ACMD_END()
anm_r212ar0103_urayama_turn_to_hero_r:
	_AC_DIR_R(8)
	_ACMD_END()
anm_r212ar0103_urayama_turn_to_hero_u:
	_AC_DIR_U(8)
	_ACMD_END()
anm_r212ar0103_urayama_turn_to_hero_d:
	_AC_DIR_D(8)
	_ACMD_END()
ev_r212ar0103_butler:
	_TALK_OBJ_START()
	_ZENKOKU_ZUKAN_FLAG(2, @SCWK_ANSWER); 1 = Set, 2 = Get
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_butler_07_2')
	_JUMP('ev_r212ar0103_butler_talk_chk')
	_END()
ev_r212ar0103_butler_07_2:
	_IF_FLAGON_JUMP(#FE_R212AR0103_BUTLER_TALK, 'ev_r212ar0103_butler_talk_chk')
	_JUMP('ev_r212ar0103_butler_07')
	_END()
ev_r212ar0103_butler_07:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_07_1', 'How do you find it? Master’s upgraded\ntrophy garden, I mean.')
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_07_2', 'You did notice the influx of quite rare\nPokémon, yes?\rBut that’s only to be expected. It’s Master’s\ntrophy garden.')
	_FLAG_SET(#FE_R212AR0103_BUTLER_TALK)
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0103_BUTLER', 'anm_r212ar0103_butler_normal_dir')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_butler_talk_chk:
	_IF_FLAGON_JUMP(#TMFLG_URANIWA_ENCOUNT, 'ev_r212ar0103_butler_06')
	_SYS_FLAG_GAME_CLEAR_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_butler_05')
	_GET_RND(@SCWK_ANSWER, 2)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_r212ar0103_butler_03_0')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_butler_03_1')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0103_BUTLER', 'anm_r212ar0103_butler_normal_dir')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_butler_03_0:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_03', 'Master is a truly wonderful and generous person!\rIt’s on his orders that the garden, his pride and\njoy, is open to all, even Trainers.')
	_RET()
ev_r212ar0103_butler_03_1:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_04', 'Master actually quite enjoys showing his prized\ngarden to strong Trainers.')
	_RET()
ev_r212ar0103_butler_05:
	_GET_RND(@SCWK_ANSWER, 2)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_r212ar0103_butler_05_0')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_butler_05_1')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0103_BUTLER', 'anm_r212ar0103_butler_normal_dir')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_butler_05_0:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_03', 'Master is a truly wonderful and generous person!\rIt’s on his orders that the garden, his pride and\njoy, is open to all, even Trainers.')
	_RET()
ev_r212ar0103_butler_05_1:
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_05', 'Master took a stroll in his trophy garden today,\nlike usual.')
	_RET()
ev_r212ar0103_butler_06:
	_URAYAMA_ENCOUNT_NO_CHK(@SCWK_PARAM0)
	_POKEMON_NAME_EXTRA(0, @SCWK_PARAM0, 0, 0)
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_butler_06', 'Did you see them? There were some\n{0,1,1,0}, weren’t there?\rBut that’s only to be expected. It’s Master’s\ntrophy garden.')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0103_BUTLER', 'anm_r212ar0103_butler_normal_dir')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_policeman:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_policeman_01', 'You may look, but please refrain from touching\nthis Pokémon statue.')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0103_POLICEMAN', 'anm_r212ar0103_policeman_01_turn')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
anm_r212ar0103_policeman_01_turn:
	_AC_DIR_D(8)
	_ACMD_END()
anm_r212ar0103_policeman_02_turn:
	_AC_DIR_L(8)
	_ACMD_END()
pos_r212ar0103_policeman_01:
	_EVENT_START()
	_OBJ_ANIME('R212AR0103_POLICEMAN', 'anm_r212ar0103_policeman_02_turn')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0103', '141-msg_r212ar0103_policeman_02', 'I’m very sorry. But please refrain from touching\nthis statue.')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_r212ar0103_hero_back_01_statue_01')
	_OBJ_ANIME('R212AR0103_POLICEMAN', 'anm_r212ar0103_policeman_01_turn')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
anm_r212ar0103_hero_back_01_statue_01:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_AC_DIR_U(8)
	_ACMD_END()
ev_r212ar0103_statue:
	_MACRO_EASY_OBJ_MSG('dialogue_r212ar0103', '141-msg_r212ar0103_statue_01', 'It’s a very expensive-looking Pokémon statue...\rOh! You got fingerprints on it...')
	_END()
ev_r212ar0103_books:
	_MACRO_EASY_OBJ_MSG('dialogue_r212ar0103', '141-msg_r212ar0103_books_01', 'It’s a very expensive-looking book on Pokémon.')
	_END()
ev_r212ar0103_maid_over:
	_MACRO_TALKMSG('dialogue_r212ar0103', 'msg_r212ar0103_maid_over', 'Please take good care of that Egg.\rMaster worked extremely hard to\nlocate it. It is truly one of a kind.\rI must return to my duties.\nI bid you adieu, Trainer.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_maid:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2729, 'ev_r212ar0103_maid_over')
	_MACRO_TALKMSG('dialogue_r212ar0103', '00_msg_r212ar0103_03', 'Trainer, thank you for defeating the\nawful man just outside this room.\rI would be beside myself if this\nprecious Egg was taken by them...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_r212ar0103_action_1:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_r212ar0103_action_2:
	_AC_UP(1, 8)
	_ACMD_END()
anm_r212ar0103_action_3:
	_AC_DIR_R(4)
	_ACMD_END()
anm_r212ar0103_action_4:
	_AC_DIR_L(4)
	_ACMD_END()
anm_r212ar0103_action_5:
	_AC_DIR_D(4)
	_AC_WAIT(2)
	_ACMD_END()
ev_r212ar0103_manaphy:
	_EVENT_START()
	_CHARA_LOOK_LOCK('HERO', 'R212AR0103_RICH')
	_CHARA_LOOK_LOCK('R212AR0103_RICH', 'HERO')
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_action_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0103', '00_msg_r212ar0103_manaphy_0', 'Aha, trainer!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_r212ar0103_action_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_r212ar0103', '00_msg_r212ar0103_manaphy_1', 'I trust you’re here to collect on the\npromised Pokémon Egg.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R212AR0103_RICH')
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_action_3')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_r212ar0103', '00_msg_r212ar0103_manaphy_2', 'Muhohoho! My lovely assistant\nbeside me has been taking care of the\fEgg I mentioned.')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('R212AR0103_RICH', 'HERO')
	_CHARA_LOOK_LOCK('R212AR0103_MAID', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'R212AR0103_MAID')
	_MACRO_TALK_KEYWAIT('dialogue_r212ar0103', '00_msg_r212ar0103_manaphy_3', 'As per my master’s wishes, we shall\nbequeath this Egg to you, Trainer.')
	_MACRO_TALK_KEYWAIT('dialogue_r212ar0103', '00_msg_r212ar0103_manaphy_4', 'Please take it whenever you are ready and I\nbeseech you to take good care of it.\rMaster worked extremely hard to locate it.\nIt is truly one of a kind.\rI must return to my duties.\nI bid you adieu, Trainer.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R212AR0103_RICH')
	_CHARA_LOOK_RELEASE('R212AR0103_MAID')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('R212AR0103_RICH', 'anm_r212ar0103_action_5')
	_OBJ_ANIME('R212AR0103_MAID', 'anm_r212ar0103_action_5')
	_OBJ_ANIME_WAIT()
	_LDVAL(@479, 2)
	_FLAG_SET(#FV_R212AR0103_RICH)
	_FLAG_SET(#TMFLG_URANIWA_ENCOUNT)
	_TALK_END()
	_END()
ev_r212ar0103_manaphy_egg:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2729, 'ev_r212ar0103_manaphy_egg_receive')
	_MACRO_TALKMSG('dialogue_r212ar0103', 'msg_r212ar0103_manaphy_egg', 'It’s a strange, blue... Egg?\nBetter not disturb it.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r212ar0103_manaphy_egg_receive:
	_MACRO_TALKMSG('dialogue_r212ar0103', 'msg_r212ar0103_manaphy_egg_receive_1', 'Do you want to take the Pokémon Egg with\nyou?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0103_manaphy_finished')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_r212ar0103_manaphy_egg_temoti_max'); Party and Boxes are full
	_SE_PLAY('M_FI013')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r212ar0103', 'msg_r212ar0103_manaphy_egg_receive_2', '{0,1,0,0} received a Pokémon Egg!')
	_ME_WAIT()
	_ADD_TAMAGO_EXTRA(490, 0, 60012); MonsNo, FormNo, RecievedFrom
	_CALL('ev_r212ar0103_egg_del')
	_FLAG_SET(#2540); Manaphy Egg Received
	_JUMP('ev_r212ar0103_manaphy_finished')
