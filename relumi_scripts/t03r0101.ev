ev_t03r0101_woman1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#TMFLG_T03R0101_SEED_PRESENT, 'ev_t03r0101_woman1_02')
	_MACRO_TALKMSG('dialogue_t03r0101', '95-msg_t03r0101_woman1_01', 'A single Berry will grow into a plant that makes\nseveral Berries.\rBy planting one, there will be more and more\nBerries in the world.\rI hope you will help us spread more\nBerries everywhere!')
	_GET_RND(@SCWK_TEMP0, 5)
	_ADD_WK(@SCWK_TEMP0, 149)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t03r0101_woman1_item_event_fail')
	_FLAG_SET(#TMFLG_T03R0101_SEED_PRESENT)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03r0101_woman1_02:
	_MACRO_TALKMSG('dialogue_t03r0101', '95-msg_t03r0101_woman1_02', 'Please come by again tomorrow. I’ll pick a\ndifferent Berry for you.\rPlease plant that Berry in soft, earthy soil!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03r0101_woman1_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03r0101_girl1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_FLOWER_ITEM_GET, 'ev_t03_t03r0101_02')
	_MACRO_TALKMSG('dialogue_t03r0101', '95-msg_t03r0101_girl1_01', 'Trainer, please water Berries using this Sprayduck\nwatering can.')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP0, 448)
	_LDVAL(@SCWK_TEMP1, 1)
	_FLAG_SET(#FE_FLOWER_ITEM_GET)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_t03r0101_02:
	_MACRO_TALKMSG('dialogue_t03r0101', '95-msg_t03r0101_girl1_02', 'Use that Sprayduck to water the soil where\nyou’ve planted Berries.\rYou should also water Berry plants while they\nare growing.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03r0101_woman2:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t03r0101', '95-mes_accessory_01_01', 'Hello! Would you like to exchange your Berries\nfor some Stickers?')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_t03r0101_shop_re')
	_END()
ev_t03r0101_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_t03r0101_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_022', 0)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_259', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_t03r0101_shop_buy')
	_CASE_JUMP(1, 'ev_t03r0101_shop_sell')
	_CASE_JUMP(2, 'ev_t03r0101_shop_end')
	_JUMP('ev_t03r0101_shop_end')
	_END()
ev_t03r0101_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_t03r0101', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_t03r0101_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FLOWER()
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_t03r0101_shop_re')
	_END()
ev_t03r0101_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_t03r0101_shop_re')
	_END()
ev_t03r0101_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()