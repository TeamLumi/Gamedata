ev_btl_searcher:
	_EVENT_START()
	_CALL('ev_block_doc')
	_LDVAL(@SCWK_ANSWER, 0)
	_BTL_SEARCHER_EVENT_CALL(@SCWK_ANSWER, @SCWK_TEMP0)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_ok_battery')
	_CASE_JUMP(1, 'ev_no_battery')
	_CASE_JUMP(2, 'ev_no_trainer')
	_JUMP('ev_no_lottery')
	_JUMP('ev_ok_battery')
ev_ok_battery:
	_TALK_END()
	_END()
ev_no_battery:
	_NUMBER_NAME(0, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_saisen', '99-mes_saisen_01_01', 'The battery isn’t charged enough.\rNumber of steps required to fully charge\nthe battery: {0,2,1,0}')
	_JUMP('common_btl_searcher_end')
	_JUMP('common_btl_searcher_end')
ev_no_trainer:
	_MACRO_TALKMSG('dialogue_saisen', '99-mes_saisen_01_02', 'There are no Trainers within range who\ncan battle...\rThe Vs. Seeker was turned off.')
	_JUMP('common_btl_searcher_end')
	_JUMP('common_btl_searcher_end')
ev_no_lottery:
	_TIME_WAIT(30, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_saisen', '99-mes_saisen_01_03', 'The other Trainers don’t appear to be ready\nfor battle.\rLet’s wait till later.')
	_JUMP('common_btl_searcher_end')
	_JUMP('common_btl_searcher_end')
common_btl_searcher_end:
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()