ev_c08r0201_week:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#TMFLG_C08R0201_RIBBON_GET, 'ev_c08r0201_week_chk_01')
	_IF_FLAGON_JUMP(#TMFLG_C08R0201_FIRST_DAY, 'ev_c08r0201_week_02')
	_IF_FLAGOFF_JUMP(#FE_C08R0201_WEEK_TALK, 'ev_c08r0201_week_01')
	_FRONT_POKEMON(@SCWK_PARAM2)
	_CALL('ev_c08r0201_week_rbbon_chk')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08r0201_week_09')
	_JUMP('ev_c08r0201_week_chk_02')
	_JUMP('ev_c08r0201_week_01')
ev_c08r0201_week_01:
	_FLAG_SET(#FE_C08R0201_WEEK_TALK)
	_FLAG_SET(#TMFLG_C08R0201_FIRST_DAY)
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_01_1', 'Oh, hello. You’re quite the nifty Trainer.\rMy husband is a sailor, and he’s off working\nsomewhere far away.\rI long for the day he comes back to me.')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_01_2', 'All that waiting every day gets to be very\nboring, though...\rI know! How about you visit me and I will tell you\nstories every so often?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0201_week_02:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_02', 'Starting tomorrow, please visit and I will tell you\nsome of my stories.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0201_week_chk_01:
	_JUMP('ev_c08r0201_week_08')
	_JUMP('ev_c08r0201_week_sunday_ribbon_chk')
ev_c08r0201_week_rbbon_chk:
	_CHK_WEEK(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c08r0201_week_sunday_ribbon_chk')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08r0201_week_monday_ribbon_chk')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c08r0201_week_tuesday_ribbon_chk')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_c08r0201_week_wednesday_ribbon_chk')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_c08r0201_week_thursday_ribbon_chk')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 5, 'ev_c08r0201_week_friday_ribbon_chk')
	_JUMP('ev_c08r0201_week_saturday_ribbon_chk')
	_JUMP('ev_c08r0201_week_sunday_ribbon_chk')
ev_c08r0201_week_sunday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 14)
	_RET()
ev_c08r0201_week_monday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 8)
	_RET()
ev_c08r0201_week_tuesday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 9)
	_RET()
ev_c08r0201_week_wednesday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 10)
	_RET()
ev_c08r0201_week_thursday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 11)
	_RET()
ev_c08r0201_week_friday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 12)
	_RET()
ev_c08r0201_week_saturday_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 13)
	_RET()
ev_c08r0201_week_common_ribbon_get_01:
	_POKEMON_NAME(1, @SCWK_PARAM2)
	_PLAYER_NAME(2)
	_RIBBON_NAME(3, @SCWK_PARAM3)
	_SE_PLAY('M_FI010')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_06', 'You received the {3,1,38,0}.')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_07', 'You put the {3,1,38,0}\non {1,1,1,0}.', 0, 1)
	_JUMP('ev_c08r0201_week_08')
ev_c08r0201_week_08:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_08', 'Let’s talk again tomorrow.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0201_week_09:
	_POKEMON_NAME(1, @SCWK_PARAM2)
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_09', 'Hello!\rOh, this is the {1,1,1,0} I gave a Ribbon\nto before.\rI’ve got lots of Ribbons, so you should bring\nother Pokémon to see me.', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08r0201_week_chk_02:
	_CHK_WEEK(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c08r0201_week_sunday')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08r0201_week_monday')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c08r0201_week_tuesday')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_c08r0201_week_wednesday')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 4, 'ev_c08r0201_week_thursday')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 5, 'ev_c08r0201_week_friday')
	_JUMP('ev_c08r0201_week_saturday')
ev_c08r0201_week_sunday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_20_1', 'Oh, hello! You’re on your adventure even though\nit’s Sunday!')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_20_2', 'When I was younger, I remember that every day\nwas like an adventure.\rIt was always fun. I loved the people around me.\nI was happy...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_20_3', 'I wonder if I have a story that’d make you smile...\rOoh, I know! You know how there’s a Pokémon\ncalled Chansey, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_21_1', 'Chansey is said to share its healing eggs with\ninjured people. Consider yourself lucky if you\fever have the Chansey to meet a Pokémon\flike that!\fYou get it, right? Hmm.\f...\f...\f...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_21_2', 'Did I get you to crack a smile?\r...\n...\f...\fI did, right?\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 14)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')
ev_c08r0201_week_monday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_03_1', 'Today is Monday!\rIt’s time to get going on a brand-new week.')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_03_2', 'Is there a story that might help perk us up?\rOoh, I know! You know how there’s a Pokémon\ncalled Exeggutor, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_04', 'Apparently, when Exeggutor absorb sunlight,\nit makes them grow. On Mondays, depending on\fwhether it’s rainy or sunny, we ourselves will have\fa totally different mood, right?\rI’d never Exegg-tly thought about that until\njust now! You get it, right? Ahaha!\f...\f...\f...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_05', 'Did that help you perk up?\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 8)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')
ev_c08r0201_week_tuesday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_10_1', 'Today is Tuesday!\rThe first date I went on with my husband was on\nTuesday, too. I remember my heart thumping!')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_10_2', 'Hmm, heart-thumping stories...\rOoh, I know! You know how there’s a Pokémon\ncalled Drifloon, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_11_1', 'You might be outside chatting, totally absorbed,\nuntil you realize it’s right behind you and get a\fhuge shock.\fThat’ll Drif-initely get your heart racing!\fYou get it, right? Ahaha!\f...\f...\f...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_11_2', 'Did that startle you?\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 9)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')
ev_c08r0201_week_wednesday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_12_1', 'Looks like today’s Wednesday!\n*sigh*\rMy husband bought me a dress, but I put it in the\nwash by accident and it shrunk.\fOh, how I weep for it still...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_12_2', 'Misery does love company. Should we have a\ngloomy story?\rOoh, I know! You know how there’s a Pokémon\ncalled Cherubi, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_13_1', 'I was talking to a Cherubi I know. I guess it was\non the verge of evolving when, suddenly, a Starly\fplucked off Cherubi’s nutrient-filled ball.\fOf course, the Cherubi was really down about\fthe whole thing, so I tried to boost its spirits,\fcrying, “Cher-up, you can do it!”\fYou get it, right? Ahaha!\f...\f...\f...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_13_2', 'I hope that’s not too gloomy for you.\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 10)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')
ev_c08r0201_week_thursday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_14_1', 'It’s Thursday already? I lost track of time!\rMy favorite magazine comes out today.\nI’d better go buy it quick!')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_14_2', 'Do I know any stories about being\nabsent-minded?\rOoh, I know! You know how there’s a Pokémon\ncalled Slowbro, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_15_1', 'Slowbro is said to have evolved by carelessly\ngetting its tail bitten by Shellder. I guess that\fShellder can be a bit bro-blematic, eh?\fYou get it, right? Ahaha!\f...\f...\f...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_15_2', 'Ahh, I’m so absent-minded!\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 11)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')
ev_c08r0201_week_friday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_16_1', 'Today is Friday!\rMy meager store of anecdotes is about to\nrun out!')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_16_2', 'Is there a story that would help me get my\nthoughts in order?\rOoh, I know! You know how there’s a Pokémon\ncalled Shinx, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_17_1', 'I once encountered a Shinx and it lit up with this\ntotally blinding light. I could practically feel it in\fmy head! Honestly, it wasn’t the most pleasant\fexperience I’ve had...\fThere are some Shinx I’d like to forget.\fYou get it, right? Ahaha!\f...\f...\f...')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_17_2', 'I bet your thoughts are in order now, right?\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 12)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')
ev_c08r0201_week_saturday:
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_18', '*yawn*\nToday’s Saturday.\fI’m feeling lazy and sleepy.\rI wonder if I have a story that would help\nsomeone sleep well?\rOoh, I know! You know how there’s a Pokémon\ncalled Abra, right?')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_19_1', 'Abra are fine with sleeping up to 18 hours\na day, Abra-rently.\f...Oops! I said the pun too early! I guess I’m still\fhalf asleep myself!\rWhat a whoopsie. What a whopper of\na whoopsie!')
	_MACRO_TALKMSG('dialogue_c08r0201', '2-msg_c08r0201_week_19_2', 'I’m not gonna sleep well if I keep going like this.\rHere, you can give this to your Pokémon.')
	_FLAG_SET(#TMFLG_C08R0201_RIBBON_GET)
	_LDVAL(@SCWK_PARAM3, 13)
	_SET_RIBBON(@SCWK_PARAM2, @SCWK_PARAM3)
	_JUMP('ev_c08r0201_week_common_ribbon_get_01')