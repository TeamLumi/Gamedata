ev_c01pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c01pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_c01pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01pc0101_flag_change_del_stopper')
	_END()
ev_c01pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_c01pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_c01pc0101_babygirl1a:
	_MACRO_EASY_OBJ_MSG('dialogue_c01pc0101', '31-msg_c01pc0101_babygirl1a_01', 'You know how Pokémon have types, like Water,\nFire, and Grass?\rThey say that types have strengths and\nweaknesses against other types.')
	_END()
ev_c01pc0101_boy1a:
	_MACRO_EASY_OBJ_MSG('dialogue_c01pc0101', '31-msg_c01pc0101_boy1a_01', 'In the Local Room upstairs, you can battle and\ntrade with other people.')
	_END()
ev_c01pc0101_woman3a:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01pc0101', '31-msg_c01pc0101_woman3a_01_1', 'You can still catch Pokémon if you already have\nsix traveling with you.\rA new Pokémon can be sent to a Pokémon Box!')
	_MACRO_TALKMSG('dialogue_c01pc0101', '31-msg_c01pc0101_woman3a_01_2', 'Knowing that, I can keep on catching more and\nmore Pokémon!\rIt’ll make it more fun to check my Boxes!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()