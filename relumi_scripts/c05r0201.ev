ev_c05r0201_flag_change:
	_TV_INTERVIEWER_CHECK(4, @LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c05r0301_flagchange_vanish')
	_FLAG_RESET(#FV_TV_INTERVIEW_04)
	_END()
ev_c05r0301_flagchange_vanish:
	_FLAG_SET(#FV_TV_INTERVIEW_04)
	_END()
ev_c05r0201_gentleman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C05R0201_ITEM_GET, 'ev_c05r0201_gentleman_02')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_01_1', 'Hello, hello! How, I say, do you do?\rI am the Pokémon Fan Club Chairman! Indeed,\nyes I am!')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_01_2', 'When you wish to treat your Pokémon to a treat,\nwhat, I say, do you do?\rIf I may say so, and I will, I feed Poffins to\nmy Pokémon!')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_01_3', 'And why, I say, would I do that?\rWhen you give Poffins, I say, it’s the deepest\nexpression of your love as a Trainer!')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_01_4', 'For example! If I were to give a Sweet Poffin, the\nPokémon eating it would become more cute!\rFor example! A Spicy Poffin will add to the\ncoolness of a Pokémon, most certainly!')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_01_5', 'In such ways I say that Poffins have nothing but\ngoodness for Pokémon!\rTherefore!\rI declare these Poffins to be a gift from me, to\nyou!')
	_TALK_CLOSE()
	_CALL('ev_c05r0201_gentleman_check')
	_GIVE_POFFIN(0, 20, 20, 0, 0, 0, 0, 10)
	_GIVE_POFFIN(5, 20, 0, 20, 0, 0, 0, 10)
	_GIVE_POFFIN(10, 20, 0, 0, 20, 0, 0, 10)
	_GIVE_POFFIN(15, 20, 0, 0, 0, 20, 0, 10)
	_GIVE_POFFIN(20, 20, 0, 0, 0, 0, 20, 10)
	_CALL('ev_play_pocket_fanfare')
	_MACRO_TALKMSG('dialogue_c05r0201', 'msg_c05r0201_gentleman_poffins', 'You obtained some Poffins!')
	_ME_WAIT()
	_FLAG_SET(#FE_C05R0201_ITEM_GET)
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_02', 'I urge you to be generous in dispensing Poffins\nto your Pokémon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_gentleman_02:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_03_1', 'Nationwide, there are other fan clubs, but we are\nnumber one!')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_gentleman_03_2', 'And why are we number one? Because I brag\nmore than anyone!\rBut now I can’t brag as much...\rPeople started complaining, so I’ve had to curtail\nmy bragging...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_gentleman_check:
	_ITEM_CHK(449, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05r0201_gentleman_porutocase')
	_CHECK_POFIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05r0201_gentleman_poruto')
	_RET()
ev_c05r0201_gentleman_porutocase:
	_MACRO_TALKMSG('dialogue_c05r0201', 'msg_c05r0201_gentleman_porutocase', 'It seems you lack the necessary container for\nsuch a treat!\rNormally, I say, I would have a Poffin Case to\ngive you without concern...\rBut I do believe I have given my very last case\nto a woman who intended to hand them out\fto students at her Contest Class!\rShe made for the Contest Hall post-haste!\rI do believe you can obtain a Poffin Case from\nher if you hurry to class!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_gentleman_poruto:
	_MACRO_TALKMSG('dialogue_c05r0201', 'msg_c05r0201_gentleman_poruto', 'Sharing the delicious treats therein, I say.\nIt is the only solution to this conundrum.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2:
	_TALK_OBJ_START()
	_FRONT_POKEMON(@SCWK_PARAM0)
	_NICK_NAME(0, @SCWK_PARAM0)
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_01', 'Welcome to the Pokémon Fan Club!\nOh, your {0,1,1,0}...')
	_GET_NATSUKI(@SCWK_ANSWER, @SCWK_PARAM0, -1)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 255, 'ev_c05r0201_woman2_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 200, 'ev_c05r0201_woman2_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 150, 'ev_c05r0201_woman2_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 100, 'ev_c05r0201_woman2_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 50, 'ev_c05r0201_woman2_06')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 1, 'ev_c05r0201_woman2_07')
	_JUMP('ev_c05r0201_woman2_08')
	_END()
ev_c05r0201_woman2_02:
	_CHK_RIBBON(@SCWK_ANSWER, 0, 3)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c05r0201_woman2_02_end')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_09', 'It simply adores you! Why, I feel like\nI’m intruding!\rI’ll give you something good as a token of your\nstrong friendship!')
	_SET_RIBBON(@SCWK_PARAM0, 3)
	_LDVAL(@SCWK_PARAM1, 3)
	_POKEMON_NAME(1, @SCWK_PARAM0)
	_PLAYER_NAME(2)
	_RIBBON_NAME(3, @SCWK_PARAM1)
	_SE_PLAY('M_FI010')
	_MACRO_TALKMSG('dialogue_c05r0201', '2-msg_c08r0201_week_06', 'You received the {3,1,38,0}.')
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r0201', '2-msg_c08r0201_week_07', 'You put the {3,1,38,0}\non {1,1,1,0}.', 0, 1)
	_JUMP('ev_c05r0201_woman2_02_end_2')
	_END()
ev_c05r0201_woman2_02_end:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_02', 'It simply adores you! Why, I feel like\nI’m intruding!')
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_10', 'The Best Friends Ribbon looks great on your\nPokémon! I’m sure you’ll be best friends forever!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_02_end_2:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_03:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_03', 'It’s very friendly toward you. I can tell you\ntreat it kindly.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_04:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_04', 'It’s quite friendly to you. It must be happy\nbeing with you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_05:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_05', 'It’s warming up to you. That’s my impression.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_06:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_06', 'It’s feeling neutral toward you. It’s up to you to\nchange that.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_07:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_07', 'Hmm... It seems to dislike you a little.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_woman2_08:
	_MACRO_TALKMSG('dialogue_c05r0201', '44-msg_c05r0201_woman2_08', 'Oh, my... I think this one really hasn’t taken too\nkindly to you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0201_koduck:
	_EASY_VOICE_MSG('dialogue_c05r0201%44-msg_c05r0201_koduck_01', 'PLAY_PV_EV_054_00_00')
	_END()
ev_c05r0201_maril:
	_EASY_VOICE_MSG('dialogue_c05r0201%44-msg_c05r0201_maril_01', 'Play_PV_EV_427_00_00')
	_END()
ev_c05r0201_pippi:
	_EASY_VOICE_MSG('dialogue_c05r0201%44-msg_c05r0201_pippi_01', 'PLAY_PV_EV_035_00_00')
	_END()