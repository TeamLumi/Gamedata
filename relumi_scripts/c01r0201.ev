ev_c01r0201_flag_change:
	_LDVAL(@WK_ELEVATOR_FLOOR, 0)
	_IF_FLAGON_JUMP(#TMFLG_C01R0201_BATTLE_END, 'ev_c01r0201_fc_battle_skip')
	_TRAINER_FLAG_RESET('IDOL_01')
	_TRAINER_FLAG_RESET('REPORTER_01')
	_TRAINER_FLAG_RESET('CAMERAMAN_01')
	_TRAINER_FLAG_RESET('PIERROT_02')
	_TRAINER_FLAG_RESET('INTERVIEW_01')
	_TRAINER_FLAG_RESET('POKEGIRL_03')
	_TRAINER_FLAG_RESET('GUITARIST_07')
	_JUMP('ev_c01r0201_fc_battle_skip')
ev_c01r0201_fc_battle_skip:
	_FLAG_SET(#FV_C01R0201_SUNDAY)
	_FLAG_SET(#FV_C01R0201_MONDAY)
	_FLAG_SET(#FV_C01R0201_TUESDAY)
	_FLAG_SET(#FV_C01R0201_WEDNESDAY)
	_FLAG_SET(#FV_C01R0201_THURSDAY)
	_FLAG_SET(#FV_C01R0201_THURSDAY2)
	_FLAG_SET(#FV_C01R0201_FRIDAY)
	_FLAG_SET(#FV_C01R0201_SATURDAY)
	_CHK_WEEK(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c01r0201_fc_sunday')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_c01r0201_fc_monday')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 2, 'ev_c01r0201_fc_tuesday')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 3, 'ev_c01r0201_fc_wednesday')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 4, 'ev_c01r0201_fc_thursday')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 5, 'ev_c01r0201_fc_friday')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 6, 'ev_c01r0201_fc_saturday')
	_END()
ev_c01r0201_fc_sunday:
	_FLAG_RESET(#FV_C01R0201_SUNDAY)
	_END()
ev_c01r0201_fc_monday:
	_FLAG_RESET(#FV_C01R0201_MONDAY)
	_END()
ev_c01r0201_fc_tuesday:
	_FLAG_RESET(#FV_C01R0201_TUESDAY)
	_END()
ev_c01r0201_fc_wednesday:
	_FLAG_RESET(#FV_C01R0201_WEDNESDAY)
	_END()
ev_c01r0201_fc_thursday:
	_FLAG_RESET(#FV_C01R0201_THURSDAY)
	_FLAG_RESET(#FV_C01R0201_THURSDAY2)
	_END()
ev_c01r0201_fc_friday:
	_FLAG_RESET(#FV_C01R0201_FRIDAY)
	_END()
ev_c01r0201_fc_saturday:
	_FLAG_RESET(#FV_C01R0201_SATURDAY)
	_END()
ev_c01r0201_sunglasses_first:
	_END()
ev_c01r0201_sunglasses:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_sunglasses_01_1', 'Do you use Stickers to decorate Ball Capsules?')
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_sunglasses_01_2', 'Go to the gallery on the second floor, and you\ncan see various Ball Capsules burst open.\fThey were customized by Gym Leaders.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0201_sunglasses_after:
	_END()
ev_c01r0201_kuji:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_KUJI_AZUKE_ITEM, 'NE', 0, 'ev_c01r0201_kuji_14')
	_IF_FLAGON_JUMP(#TMFLG_KUJI_DAY, 'ev_c01r0201_kuji_02')
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_01_1', 'This is the Pokémon Lottery Corner.')
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_01_2', 'If your drawn number matches the ID No. of any\nof your Pokémon, starting with the far right digit,\fyou will receive a fabulous gift!\rWould you like to save and draw a Pokémon\nLoto Ticket?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0201_kuji_04')
	_JUMP('ev_c01r0201_kuji_03')
	_JUMP('ev_c01r0201_kuji_02')
ev_c01r0201_kuji_02:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_02', 'You’ve already drawn a Loto Ticket today.\nPlease come back tomorrow.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0201_kuji_03:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_03', 'Oh. I see. Please do visit us again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0201_kuji_04:
	_FLAG_SET(#TMFLG_KUJI_DAY)
	_REPORT_SAVE(@SCWK_ANSWER)
	_REPORT_SAVE_CHECK(@SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_04', 'Please draw a Loto Ticket.\r...')
	_GET_KUJI_ATARI_NUM(@SCWK_ANSWER)
	_NUMBER_NAME_EX(0, @SCWK_ANSWER, 2, 5)
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_05', 'Your Loto Ticket number is {0,2,4,0}.\rNow, let’s see if it matches the ID No. of any of\nyour Pokémon.')
	_KUJI_ATARI_CHK(@SCWK_PARAM1, @SCWK_PARAM2, @SCWK_PARAM3, @SCWK_PARAM0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 0, 'ev_c01r0201_kuji_08')
	_IFVAL_JUMP(@SCWK_PARAM3, 'EQ', -1, 'ev_c01r0201_kuji_06')
	_JUMP('ev_c01r0201_kuji_07')
	_END()
ev_c01r0201_kuji_08:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_08', 'I’m sorry. You didn’t get a match...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0201_kuji_06:
	_NICK_NAME(0, @SCWK_PARAM0)
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_06', 'Congratulations!\rThe ID No. of {0,1,2,0} in your party\nmatches your Loto Ticket number!')
	_JUMP('ev_c01r0201_kuji_atari_chk_01')
	_JUMP('ev_c01r0201_kuji_atari_chk_01')
ev_c01r0201_kuji_07:
	_NICK_NAME_ALL(0, @SCWK_PARAM0, @SCWK_PARAM3)
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_07', 'Congratulations!\rThe ID No. of {0,1,2,0} in your Pokémon\nBoxes matches your Loto Ticket number!')
	_JUMP('ev_c01r0201_kuji_atari_chk_01')
	_JUMP('ev_c01r0201_kuji_atari_chk_01')
ev_c01r0201_kuji_atari_chk_01:
	_SWITCH(@SCWK_PARAM2)
	_CASE_JUMP(1, 'ev_c01r0201_kuji_19')
	_CASE_JUMP(2, 'ev_c01r0201_kuji_09')
	_CASE_JUMP(3, 'ev_c01r0201_kuji_10')
	_CASE_JUMP(4, 'ev_c01r0201_kuji_11')
	_CASE_JUMP(5, 'ev_c01r0201_kuji_12')
	_END()
ev_c01r0201_kuji_19:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_16', 'The last digit matched, so you win prize\nnumber four!')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
ev_c01r0201_kuji_09:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_09', 'The last two digits matched, so you win prize\nnumber three!')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
ev_c01r0201_kuji_10:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_10', 'The last three digits matched, so you win prize\nnumber two!')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
ev_c01r0201_kuji_11:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_11', 'The last four digits matched, so you win prize\nnumber one!')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
ev_c01r0201_kuji_12:
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_12', 'Oh my goodness, all five digits matched!\nThis is just so incredible!\r...Oh, right! Your prize! I’m sorry—I got carried\naway there.\rHere you go!')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
ev_c01r0201_kuji_atari_chk_02:
	_SWITCH(@SCWK_PARAM2)
	_CASE_JUMP(1, 'ev_c01r0201_kuji_no_4')
	_CASE_JUMP(2, 'ev_c01r0201_kuji_no_3')
	_CASE_JUMP(3, 'ev_c01r0201_kuji_no_2')
	_CASE_JUMP(4, 'ev_c01r0201_kuji_no_1')
	_CASE_JUMP(5, 'ev_c01r0201_kuji_no_0')
	_END()
ev_c01r0201_kuji_no_4:
	_LDVAL(@SCWK_PARAM3, 2)
	_JUMP('ev_c01r0201_kuji_item_get_chk')
	_JUMP('ev_c01r0201_kuji_13')
ev_c01r0201_kuji_no_3:
	_LDVAL(@SCWK_PARAM3, 51)
	_JUMP('ev_c01r0201_kuji_item_get_chk')
	_JUMP('ev_c01r0201_kuji_13')
