	_JUMP('ev_c01r0201_kuji_13')
ev_c01r0201_kuji_item_get_chk:
	_LDVAL(@SCWK_TEMP0, @SCWK_PARAM3)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0201_kuji_13')
	_CALL('ev_item_event')
	_JUMP('ev_c01r0201_kuji_15')
	_JUMP('ev_c01r0201_kuji_13')
ev_c01r0201_kuji_13:
	_LDVAL(@WK_SCENE_KUJI_AZUKE_ITEM, @SCWK_PARAM2)
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_13', '...Oh? You seem to have no room for this.\rPlease make room in your Bag and then let\nme know.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0201_kuji_14:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c01r0201', '35-msg_c01r0201_kuji_14', '{0,1,0,0}? Yes, we’ve been expecting you.\rThis is the prize we’ve been holding for you.\nHere you go!')
	_LDVAL(@SCWK_PARAM2, @WK_SCENE_KUJI_AZUKE_ITEM)
	_JUMP('ev_c01r0201_kuji_atari_chk_02')
	_JUMP('ev_c01r0201_kuji_15')
