	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0201_woman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0201', '35-msg_c01r0201woman2_01', 'They keep records of things like how many\nbattles you’ve won in a row or how many\fPokémon you’ve caught.\rYou can check everyone’s records up on the\nthird floor.')
	_END()
