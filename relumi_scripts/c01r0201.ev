	_TALK_OBJ_END()
	_END()
ev_c01r0201_friday:
	_TALK_OBJ_START()
	_IF_TR_FLAGON_JUMP('POKEGIRL_03', 'ev_c01r0201_friday_battle_after')
	_TALKMSG('dp_trainer_msg_sub%35-msg_c01r0201_pokegirl_01')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01r0201_friday_cancel')
	_TALKMSG('dp_trainer_msg_sub%35-msg_c01r0201_pokegirl_02')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 350)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_TRAINER_FLAG_SET(@SCWK_TEMP3)
	_FLAG_SET(#TMFLG_C01R0201_BATTLE_END)
	_TALK_OBJ_END()
	_END()
