ev_c01r0201_man3_01:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0201', '35-msg_c01r0201_man3_01', 'The Trainers that gather over there are looking\nfor battles.\rThat area used to be for karaoke, but now it’s\nall battling!')
	_END()
ev_c01r0201_facade:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2682, 'ev_c01r0201_facade_done')
	_MACRO_TALK_KEYWAIT('dialogue_c01r0201', 'msg_c01r0201_facade', 'Sigh...\nActing is hard sometimes.\rYou can’t really be yourself.\nYou have to put on a facade...\rJust like how a Pokémon can when\nafflicted by a status effect...\rOh, you’re a Trainer, right?\nThat means you have Pokémon.\rTake this as an apology for having\nto listen to my rambling.')
	_LDVAL(@SCWK_TEMP0, 369); TM42
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_MACRO_TALK_KEYWAIT('dialogue_c01r0201', 'msg_c01r0201_facade_2', 'Facade is a move that has double\nthe power if the Pokémon using it is\fpoisoned, paralyzed or burned.\rIt works especially well if your\nPokémon has Guts...')
	_FLAG_SET(#2682)
	_JUMP('ev_c01r0201_facade_end')
ev_c01r0201_facade_done:
	_MACRO_TALK_KEYWAIT('dialogue_c01r0201', 'msg_c01r0201_facade_3', 'Sigh...\nMaybe I should sing instead.\rThen I can be myself on the stage!\nAt least, I’d like to think so.')
	_JUMP('ev_c01r0201_facade_end')
ev_c01r0201_facade_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()