ev_c01r0103_middlewoman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0103', '34-msg_c01r0103_middlewoman1_01_1', 'My husband is the president.\rWe started out in a small workshop where he\nmade whatever he liked.')
	_MACRO_TALKMSG('dialogue_c01r0103', '34-msg_c01r0103_middlewoman1_01_2', 'Now we’re making something that makes the\nworld happy. Imagine that!')
	_TALK_CLOSE()
