ev_c10r0109_flag_change:
	_IF_FLAGON_JUMP(#FE_BIGFOUR4_WIN, 'ev_c10r0109_bigfour4_set1')
	_IF_FLAGOFF_JUMP(#FE_BIGFOUR4_WIN, 'ev_c10r0109_bigfour4_set2')
	_END()
ev_c10r0109_bigfour4_set1:
	_IF_FLAGOFF_JUMP(#FH_02, 'ev_c10r0109_bigfour4_set1_end')
	_DOOR_ENABLE_SET('C10R0109_D02', 0)
	_DOOR_ENABLE_SET('C10R0109_D01', 0)
	_SET_DOOR_OBJ('C10R0109_D02')
	_HIT_DOOR_ANIME(0)
	_SXY_EXIT_POS_CHANGE(0, 7, 2)
	_END()
ev_c10r0109_bigfour4_set1_end:
	_END()
ev_c10r0109_bigfour4_set2:
	_DOOR_ENABLE_SET('C10R0109_D02', 0)
	_DOOR_ENABLE_SET('C10R0109_D01', 0)
	_SXY_EXIT_POS_CHANGE(0, 7, 0)
	_END()
ev_c10r0109_bigfour4:
	_IF_FLAGON_JUMP(#FE_BIGFOUR4_WIN, 'ev_c10r0109_bigfour4_02')
	_BGM_PLAY('EV214')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE3, 'ev_c10r0109_bigfour4_pupl3')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE2, 'ev_c10r0109_bigfour4_pupl2')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CALL('ev_block_doc')
	_OBJ_POS_CHANGE_WORLD('HERO', 8, 0, 6.700000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(200)
	_SET_FORCE_BLINK('C10R0109_BIGFOUR4', 1)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C10R0109_BIGFOUR4', 0)
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_01_1', 'Ah, you timed your arrival well. I’ve just finished\nreading a book, you see.')
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_01_2', 'Allow me to introduce myself.\rI am Lucian. I am a user of Psychic types.')
	_TALK_CLOSE()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C10R0109_BIGFOUR4', 1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C10R0109_BIGFOUR4', 0)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_01_3', 'I must say, you’ve already proven yourself to be\noutstanding by coming this far.\rThey say I am the toughest of the Elite Four.\nI’m afraid I will have to go all out against you\fto live up to that reputation.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(201)
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league04')
	_LDVAL(@WK_PLAY_REPO_NO, 24)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0109_randomteam_lucian')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0109_bigfour4_win_common')
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_02_1', 'Congratulations. You’ve now beaten the\nElite Four.\rHowever, that doesn’t mean you’re done with the\nPokémon League.')
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_02_2', 'There remains the Champion.\rI should warn you—the Champion is far stronger\nthan the Elite Four.')
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_02_3', 'Now, go on. Step through the doorway to your\nfinal battle.')
	_TALK_CLOSE()
	_CALL('ev_c10r0109_bigfour4_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0109_randomteam_lucian:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 867)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 868)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 869)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 870)
	_RET()
ev_c10r0109_randomteam_lucian_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 935)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 936)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 937)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 938)
	_RET()
ev_c10r0109_bigfour4_win_common:
	_FLAG_SET(#FE_BIGFOUR4_WIN)
	_RET()
ev_c10r0109_bigfour4_win_dooropen:
	_SET_DOOR_OBJ('C10R0109_D02')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI116')
	_HIT_DOOR_ANIME_WAIT()
	_SXY_EXIT_POS_CHANGE(0, 7, 2)
	_FLAG_SET(#FH_02)
	_RET()
anm_c10r0109_bigfour4_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c10r0109_bigfour4_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
ev_c10r0109_bigfour4_pupl2:
	_TALK_OBJ_START()
	_EVENT_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c10r0109', '20-msg_c10r0109_bigfour4_11_1', 'Just a moment, please. The book I’m reading has\nnearly reached its thrilling climax...\rThe hero has obtained a mystic sword and is\nabout to face their final trial...\rAh, never mind. Since you’ve made it this far,\nI’ll put that aside and battle you.\rLet me see if you’ll achieve as much glory as\nthe hero of my book!')
	_TALK_CLOSE()
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league04')
	_LDVAL(@WK_PLAY_REPO_NO, 37)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0109_randomteam_lucian_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0109_bigfour4_win_common')
	_MACRO_TALKMSG('dialogue_c10r0109', '20-msg_c10r0109_bigfour4_11_2', 'Truly outstanding. You took full control of the\nnarrative without a moment’s hesitation.\rNow then, the final page has yet to be written.\rGo and show us who shall emerge victorious.')
	_TALK_CLOSE()
	_CALL('ev_c10r0109_bigfour4_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0109_bigfour4_pupl3:
	_TALK_OBJ_START()
	_EVENT_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c10r0109', '20-msg_c10r0109_bigfour4_21_1', 'Ah, you’ve timed your arrival perfectly. I’m still\nquite worked up from the book I just finished.\rAfter seeing all you’ve accomplished thus far,\n{0,1,0,0}, I can certainly tell you this:\fyou are the protagonist of your own story.\rAnd perhaps that just makes me an obstacle\nstanding in the way of your heroic journey.\rThen again, maybe in this retelling I’ll finally trip\nyou up! Wouldn’t that be an intriguing plot twist?')
	_TALK_CLOSE()
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league04')
	_LDVAL(@WK_PLAY_REPO_NO, 42)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0109_randomteam_lucian_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0109_bigfour4_win_common')
	_MACRO_TALKMSG('dialogue_c10r0109', '20-msg_c10r0109_bigfour4_21_2', 'I concede defeat...\rI used every stratagem at my command, but you\npersevered through them all.\rNow all that remains is for you to write your\nown epilogue!')
	_TALK_CLOSE()
	_CALL('ev_c10r0109_bigfour4_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0109_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0109_bigfour4_02:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE3, 'ev_c10r0109_bigfour4_pupl3w')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE2, 'ev_c10r0109_bigfour4_pupl2w')
	_MACRO_TALKMSG('dialogue_c10r0109', '23-msg_c10r0109_bigfour4_03', 'I’ll be reading books until the next challenger\narrives. That will calm my nerves so that I may\fdeal with all situations without panicking.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0109_bigfour4_pupl2w:
	_MACRO_TALKMSG('dialogue_c10r0109', '20-msg_c10r0109_bigfour4_11_3', 'Now then, I can return to the last remaining\nchapter of my book.\rReading allows me to learn from my mistakes.\nKnowledge keeps me from making more.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0109_bigfour4_pupl3w:
	_MACRO_TALKMSG('dialogue_c10r0109', '20-msg_c10r0109_bigfour4_21_3', 'Next I think I’d like to read a book about a star...\none small light, illuminating a galaxy of darkness.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0109_room_in:
	_EVENT_START()
	_SET_DOOR_OBJ('C10R0109_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI116')
	_OBJ_ANIME('HERO', 'anm_c10r0109_roomin_01')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET('C10R0109_D01')
	_SE_PLAY('S_FI117')
	_HIT_DOOR_ANIME(1)
	_HIT_DOOR_ANIME_WAIT()
	_DOOR_ENABLE_SET('C10R0109_D02', 0)
	_DOOR_ENABLE_SET('C10R0109_D01', 0)
	_SXY_EXIT_POS_CHANGE(0, 7, 0)
	_LDVAL(@WK_SCENE_CL_DOOR, 2)
	_TALK_END()
	_END()
anm_c10r0109_roomin_01:
	_AC_DIR_U(4)
	_AC_UP(2, 8)
	_ACMD_END()