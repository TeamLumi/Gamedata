	_AC_DIR_L(4)
	_AC_LEFT(4, 8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_t05_player_50:
	_AC_DIR_L(8)
	_AC_WAIT(24)
	_AC_DIR_D(8)
	_ACMD_END()
anm_t05_player_51:
	_AC_WAIT(24)
	_AC_DIR_D(8)
	_ACMD_END()
anm_t05_player_52:
	_AC_DIR_D(8)
	_ACMD_END()
anm_t05_player_01:
	_AC_WAIT(64)
	_AC_DIR_R(8)
	_ACMD_END()
anm_t05_player_11:
	_AC_WAIT(64)
