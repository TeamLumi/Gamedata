ev_t05_pichu_event_valid:
	_FLAG_RESET(#2894)
	_OBJ_ADD('T05_NOTCHED_PICHU')
	_VOICE_PLAY(172, 0, 0)
	_CALL_EFFECT(0, 0, -464, 9, 530)
	_OBJ_ADD('T05_PLAYER_PICHU')
	_STOP_EFFECT(0, 0)
	_RELEASE_EFFECT(0)
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_1')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(172, 0, 0)
	_VOICE_WAIT()
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_2')
	_OBJ_ANIME('HERO', 'anm_t05_notched_3')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'T05_NOTCHED_PICHU')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_4')
	_OBJ_ANIME('HERO', 'anm_t05_notched_5')
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_6')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(172, 0, 0)
	_MACRO_TALKMSG('dialogue_t05', '00_msg_t05_notched_pichu_1', 'It’s a Pichu...!\nOne of its ears is spiky!')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_7')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_8')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_9')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(172, 0, 0)
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_10')
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_11')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_12')
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_13')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET(#2895)
	_OBJ_ADD('T05_PICHU_OLDMAN')
	_OBJ_ANIME('T05_PICHU_OLDMAN', 'anm_t05_notched_14')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_12_1')
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_13_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_2', 'Hey, hey!\nYou should not tamper with that shrine!\fPeople are said to disappear.')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_PICHU_OLDMAN', 'anm_t05_notched_15')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_3', 'Kids and Pokémon sometimes disappear\naround this shrine.\rIt is believed that a Pokémon which\nwanders across time does that.\rIt is truly a strange thing...')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_PICHU_OLDMAN', 'anm_t05_notched_17')
	_OBJ_ANIME('HERO', 'anm_t05_notched_16')
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_15')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_4', 'Well, well, this must be...\nThis must be the Pichu that has lived in\fthis town for some time.\rWhen I saw it the first time, it looked\nlonely. It is full of energy today.')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_NOTCHED_PICHU', 'anm_t05_notched_18')
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_19')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_5', 'I see.\nIt seems that these old friends\ffinally meet again after a long time.')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_20')
	_OBJ_ANIME('HERO', 'anm_t05_notched_3')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('T05_PLAYER_PICHU', 'anm_t05_notched_22')
	_OBJ_ANIME('HERO', 'anm_t05_notched_21')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_6', 'It wants to join your party.\nLet it join you!')
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_7', 'Zapzap-chu!')
	_CHARA_LOOK_LOCK('HERO', 'T05_PICHU_OLDMAN')
	_CHARA_LOOK_LOCK('T05_PICHU_OLDMAN', 'HERO')
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_8', 'Oh, here it is!\nYoung Pokémon Trainer,\fI will give you this Poké Ball.\rI used to use them when I was younger.\rDon’t worry.\nIt’s still in good condition.')
	_LDVAL(@SCWK_TEMP0, 2); Poké Ball
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('T05_PICHU_OLDMAN')
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_9', 'It seems that Spiky-eared Pichu\nwants to stay in your Poké Ball.')
	_TALK_CLOSE()
	_OBJ_DEL('T05_NOTCHED_PICHU')
	_ADD_POKEMON_UI(172, 40, 300, @SCWK_ANSWER, 5, 1)
	_MACRO_TALK_KEYWAIT('dialogue_t05', '00_msg_t05_notched_pichu_10', 'Being with friends should make it happy.\nTake good care of it.')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_PICHU_OLDMAN', 'anm_t05_notched_23')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('T05_PICHU_OLDMAN')
	_FLAG_SET(#2895)
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_DEL('T05_PLAYER_PICHU')
	_FLAG_SET(#2894)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_FLAG_SET(#2544); Event is over
	_FLAG_SET(#2892); Kill event
	_TALK_OBJ_END()
	_END()
