	_ACMD_END()
pos_t05_oldwoman:
	_EVENT_START()
	_CALL('ev_another_out')
	_EVENT_CAMERA_INDEX(922)
	_EVENT_CAMERA_END_WAIT()
	_OBJ_ANIME('HERO', 'anm_t05_player_00')
	_OBJ_ANIME('T05_OLDWOMAN', 'anm_t05_oldwoman_00')
	_OBJ_ANIME_WAIT()
	_CALL('common_ev_t05_oldwoman_first')
	_TALK_END()
	_EVENT_CAMERA_INDEX(923)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_END()
common_ev_t05_oldwoman_first:
	_LDVAL(@WK_SCENE_T05_OLDWOMAN, 1)
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_01_1', 'There’s an odd spaceman in front of the ruins.\rThere isn’t anything there, but that only seemed\nto make him angry. He’s saying he will blow\fthe town up with a bomb...')
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_01_2', 'The nerve of it all!\rIf only I were younger, I’d punish that spaceman\nwith my Pokémon...')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7700)
	_TALK_CLOSE()
	_RET()
anm_t05_oldwoman_00:
	_AC_DIR_R(8)
	_ACMD_END()
anm_t05_player_00:
	_AC_DIR_L(8)
	_ACMD_END()
ev_t05_oldwoman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_T05_OLDWOMAN_TALK, 'ev_t05_oldwoman_02')
	_CALL('common_ev_t05_oldwoman_first')
	_TALK_OBJ_END()
	_END()
ev_t05_oldwoman_02:
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_05', 'You’ve gone to the trouble of visiting Celestic\nTown, so why not take a little more time to\fexamine the ruins?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05_gingaboss:
	_EVENT_START()
	_OBJ_POS_CHANGE_WORLD('T05_GINGABOSS', 460.500000, 5, 523)
	_CALL('ev_another_out')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 8000)
	_EVENT_CAMERA_INDEX(268)
	_OBJ_ANIME('HERO', 'anm_t05_player_300')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingaboss_01', 'There appears to have been an insignificant\nstruggle here. Everyone should step back and\fview things from a bigger perspective.\rYes, a bigger perspective—one that is on a\nuniversal scale.')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_GINGABOSS', 'anm_t05_gingaboss_00')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(269)
	_OBJ_ANIME('T05_GINGABOSS', 'anm_t05_gingaboss_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingaboss_02_1', 'My name is Cyrus.\rI seek the power to create a new world—a world\nwithout strife.')
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_OBJ_ANIME('T05_GINGABOSS', 'anm_t05_gingaboss_face00')
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('T05_GINGABOSS', 1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SET_FORCE_BLINK('T05_GINGABOSS', 0)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingaboss_02_2', 'However...\nThat power seems to be unavailable here.\rWe’ve met before, yes? It was at Mount Coronet.\nIf you discover any power derived from the\flegends of Sinnoh, inform me.')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('T05_GINGABOSS', 1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SET_FORCE_BLINK('T05_GINGABOSS', 0)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingaboss_02_3', 'For that power is what I need to create my\nnew world.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(148)
	_OBJ_ANIME('T05_GINGABOSS', 'anm_t05_gingaboss_01')
	_OBJ_ANIME('HERO', 'anm_t05_player_301')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('T05_GINGABOSS')
	_OBJ_DEL('T05_SP4')
	_OBJ_DEL('T05_SP3')
	_OBJ_DEL('T05_SP2')
	_OBJ_DEL('T05_SP1')
	_OBJ_DEL('T05_STOPPER1')
	_FLAG_SET(#2200)
	_FLAG_SET(#FE_T05_GINGABOSS_TALK)
	_LDVAL(@WK_SCENE_T05, 2)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 8100)
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
anm_t05_gingaboss_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_t05_gingaboss_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
anm_t05_player_300:
	_AC_DOWN(1, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_t05_player_301:
	_AC_WAIT(24)
	_AC_DIR_D(8)
	_ACMD_END()
anm_t05_gingaboss_00:
	_AC_DIR_R(4)
	_AC_WORLD_X(461.399994, 8)
	_ACMD_END()
anm_t05_gingaboss_01:
	_AC_DIR_L(4)
	_AC_LEFT(2, 8)
	_AC_DIR_D(4)
	_AC_DOWN(9, 8)
	_ACMD_END()
ev_t05_oldman1:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', '154-msg_t05_oldman1_01', 'Howdy!\nStudying up on local history?')
	_END()
ev_t05_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', '154-msg_t05_woman3_01', 'There’s no Poké Mart in this town...\rInstead, you can buy and sell items in the house\nright next to me.')
	_END()
ev_t05_babyboy1:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', '154-msg_t05_babyboy1_01', 'Hey, do you know what they say?\rThey say a Pokémon created the Sinnoh region.')
	_END()
ev_t05_sign1:
	_EASY_BOARD_MSG('dialogue_t05%154-msg_t05_sign1_01', 'BOARD_TYPE_TOWN', 0)
	_END()
ev_t05_wall_01:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', '154-msg_t05_wall_01', 'A giant etching of a Pokémon-like creature\ncovers the wall...\rThere is some fading text etched in as well...\r“The flow of time never stops...\nThe past, future, and present...”')
	_END()
ev_t05_wall_02:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', '154-msg_t05_wall_02', 'A giant etching of a Pokémon-like creature\ncovers the wall...\rThere is some fading text etched in as well...\r“Space is ever-expanding dimensions...\nOur spirits, too, are as space...”')
	_END()
ev_t05_stopper1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#1760, 'ev_t05_stopper1_2') ; Salesman has been talked to once
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_stopper1_01', 'Hey, kid. Wanna buy a Slowpoke Tail?\nIt’s only 1 million!')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_KURT', 'anm_t05_kurt_angry')
	_PLAY_EMO_SE(12) ; Play angry sound
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_01', 'Hey! I was in the middle of telling you off and\nnow you’re trying to push this youngster into\fillegal purchases?!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T05_STOPPER1', 'T05_KURT')
	_OBJ_ANIME('T05_STOPPER1', 'anm_t05_salesman_question')
	_PLAY_EMO_SE(7) ; Play sound
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_02', 'Hey now, kids are loaded these days.\nThere’s nothing illegal about my prices.')
	_CHARA_LOOK_RELEASE('T05_STOPPER1')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_02', 'Wha— Why I oughta... If my back weren’t shot\nthen I’d box your ears so good that you\fwouldn’t be able to hear the horseradish that\fyou’re spouting!')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_kurt_2', 'Pay no attention to this good for nothing\nscoundrel, kid. I’ll deal with him soon enough.')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_03', 'Scoundrel?')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_STOPPER1', 'anm_t05_salesman_sad')
	_PLAY_EMO_SE(8) ; Play sound
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_04', 'Words can hurt, you know...?')
	_TALK_CLOSE()
	_FLAG_SET(#1760) ; Salesman has been talked to once
	_TALK_OBJ_END()
	_END()
ev_t05_stopper1_2:
	_CHARA_LOOK_LOCK('T05_STOPPER1', 'HERO') ; Needed for the PlaceData to not turn away before the message closes, for some reason TALK_OBJ_START is not enough here to lock him, I guess it's movecode related, but I changed it to 0 and it didn't work either, so, this solves it
	_MACRO_TALK_KEYWAIT('dialogue_t05', 'msg_t05_stopper1_05', 'Sigh... Can’t an honest businessman make a\nliving in this world without being sermonized\fby the elderly?')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T05_STOPPER1', 'T05_KURT')
	_TALK_OBJ_END()
	_END()
; If the player goes all the way around and speaks to Kurt from the other side
