ev_t05_flag_change:
	_SET_SYS_FLAG($SYS_FLAG_BS_LV2)
	; Disable the PlaceDatas after the Kurt intro event has been completed and the map is reloaded (only if not accessing from route 211)
	_IF_FLAGON_CALL(#1761, 'ev_t05_disable_kurt_intro_check')
	_IF_FLAGOFF_JUMP(#2575, 'ev_t05_pichu_event_check')
	_END()
ev_t05_disable_kurt_intro_check:
	_OBJ_ANIME('T05_KURT2', 'anm_t05_kurt_invisible') ; This is needed to prevent Kurt from appearing back when the map is exited through route 211, since the flag is not yet disabled
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_DEBUG_LOG(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'GT', 449, 'ev_t05_disable_kurt_intro') ; The entry to Route 211 is 447-448
	_RET()
ev_t05_disable_kurt_intro:
	_FLAG_SET(#2926)
	_RET()
anm_t05_kurt_invisible:
	_AC_INVISIBLE_ON()
	_ACMD_END()
ev_t05_flag_change01:
	_IFVAL_JUMP(@WK_SCENE_T05, 'EQ', 1, 'ev_t05_flag_change01_end')
	_EVENT_CAMERA_INDEX(267)
	_END()
ev_t05_flag_change01_end:
	_END()
ev_t05_gingam:
	_TALK_OBJ_START()
	_EVENT_START()
	_CALL('ev_another_out')
	_EVENT_CAMERA_INDEX(440)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingam_01_1', 'This town is insignificant!\rThere’s nothing of value here. It doesn’t need to\nexist, so I’ll blow it up with a Galactic Bomb!')
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingam_01_2', 'If you try to mess with me, I’ll shut you down with\na Pokémon battle.\rSo, what’s it going to be?\nAre you going to mess with me?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05_gingam_01_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_t05_gingam_01_no')
	_END()
ev_t05_gingam_01_no:
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingam_03', 'That’s right! Very smart! You know what’s good\nfor you! Team Galactic has come out to the\fboonies like this for everyone’s sake.\rYour cooperation is appreciated.\rNow, where is my partner?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(441)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_t05_gingam_01_yes:
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingam_02', 'You dare to oppose Team Galactic?\nThat means you’re taking on the world—\rNo, the universe, even!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 319)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_gingam_04', 'Too much...to handle...\rWhatever! I’m out of this one-horse town!\nThere’s nothing to do here anyways!')
	_TALK_CLOSE()
	_GET_REL_POS_HERO('T05_GINGAM', @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 2, 'ev_t05_gingam_dir_up')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 6, 'ev_t05_gingam_dir_left')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 4, 'ev_t05_gingam_dir_right')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 3, 'ev_t05_gingam_dir_upl')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 1, 'ev_t05_gingam_dir_upr')
	_END()
ev_t05_gingam_dir_up:
	_OBJ_ANIME('T05_GINGAM', 'anm_t05_gingam_01')
	_OBJ_ANIME('HERO', 'anm_t05_player_50')
	_OBJ_ANIME_WAIT()
	_CALL('common_t05_oldwoman')
	_OBJ_ANIME('T05_OLDWOMAN', 'anm_t05_oldwoman_01')
	_OBJ_ANIME('HERO', 'anm_t05_player_01')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t05_gingam_01')
	_JUMP('common_t05_oldwoman')
ev_t05_gingam_dir_upl:
	_OBJ_ANIME('T05_GINGAM', 'anm_t05_gingam_01')
	_OBJ_ANIME('HERO', 'anm_t05_player_50')
	_OBJ_ANIME_WAIT()
	_CALL('common_t05_oldwoman')
	_OBJ_ANIME('T05_OLDWOMAN', 'anm_t05_oldwoman_02')
	_OBJ_ANIME('HERO', 'anm_t05_player_01')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t05_gingam_01')
	_JUMP('common_t05_oldwoman')
ev_t05_gingam_dir_upr:
	_OBJ_ANIME('T05_GINGAM', 'anm_t05_gingam_01')
	_OBJ_ANIME('HERO', 'anm_t05_player_50')
	_OBJ_ANIME_WAIT()
	_CALL('common_t05_oldwoman')
	_OBJ_ANIME('T05_OLDWOMAN', 'anm_t05_oldwoman_03')
	_OBJ_ANIME('HERO', 'anm_t05_player_01')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t05_gingam_01')
	_JUMP('common_t05_oldwoman')
ev_t05_gingam_dir_left:
	_OBJ_ANIME('T05_GINGAM', 'anm_t05_gingam_01')
	_OBJ_ANIME('HERO', 'anm_t05_player_51')
	_OBJ_ANIME_WAIT()
	_CALL('common_t05_oldwoman')
	_OBJ_ANIME('T05_OLDWOMAN', 'anm_t05_oldwoman_11')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t05_gingam_01')
	_JUMP('common_t05_oldwoman')
ev_t05_gingam_dir_right:
	_OBJ_ANIME('T05_GINGAM', 'anm_t05_gingam_02')
	_OBJ_ANIME('HERO', 'anm_t05_player_52')
	_OBJ_ANIME_WAIT()
	_CALL('common_t05_oldwoman')
	_OBJ_ANIME('T05_OLDWOMAN', 'anm_t05_oldwoman_12')
	_OBJ_ANIME_WAIT()
	_JUMP('common_t05_gingam_01')
	_JUMP('common_t05_oldwoman')
common_t05_oldwoman:
	_OBJ_DEL('T05_GINGAM')
	_OBJ_DEL('T05_OLDWOMAN')
	_SXY_POS_CHANGE('T05_OLDWOMAN', 466, 532)
	_OBJ_DIR_CHANGE('T05_OLDWOMAN', 0)
	_SXY_MV_CHANGE('T05_OLDWOMAN', 'MV_UP')
	_FLAG_RESET(#FV_T05_OLDWOMAN)
	_OBJ_ADD('T05_OLDWOMAN')
	_OBJ_PAUSE('T05_OLDWOMAN')
	_RET()
common_t05_gingam_01:
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_02_1', 'Well aren’t you quite the Trainer!\nThat was magnificent!\rAs the elder of Celestic Town,\nI give you my thanks.')
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_02_2', 'Oh? That Old Charm... May I see that, dear?\rWhat’s that? You say Cynthia entrusted you with\nit to deliver to me?\rThat Cynthia... She’s my granddaughter.')
	_LDVAL(@SCWK_TEMP0, 439)
	_PLAYER_NAME(0)
	_ITEM_NAME(1, @SCWK_TEMP0, 1)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_03', 'You handed over the {1,1,9,0}\nto the elder.', 0, 1)
	_ME_WAIT()
	_SUB_ITEM(@SCWK_TEMP0, 1, @SCWK_ANSWER)
	_FLAG_SET(#FE_T05_OLDWOMAN_TALK)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7800)
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_04_1', 'This Old Charm is something made in\nCelestic Town long, long ago.\rIt was made in honor of a mythical deity said to\nhave created Sinnoh. These Old Charms are still\fdiscovered now and again.')
	_MACRO_TALKMSG('dialogue_t05', '154-msg_t05_oldwoman_04_2', 'Since you’re in Celestic Town, why not look\naround inside the ruins?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(441)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
anm_t05_gingam_01:
	_AC_DIR_L(4)
	_AC_LEFT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(10, 8)
	_ACMD_END()
anm_t05_gingam_02:
	_AC_DIR_D(4)
	_AC_DOWN(2, 8)
	_AC_DIR_L(4)
	_AC_LEFT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(8, 8)
	_ACMD_END()
