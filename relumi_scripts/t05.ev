ev_t05_pichu_event:
	_TALK_OBJ_START()
	_CALL('ev_another_out')
	_IF_FLAGON_JUMP(#2892, 'ev_t05_pichu_event_valid'); If the player has completed the Pichu event, return
	_TEMOTI_POKE_CHK(@SCWK_ANSWER, 172)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05_pichu_event_invalid')
	_JUMP('ev_t05_pichu_event_valid')
ev_t05_gsball_event:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_00', 'It’s an ancient shrine.\nThere is some text engraved on it.\rIn honor of the forest’s protector.')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_01', 'There is a mysterious gold and silver\ncolored Poké Ball inside the shrine.')
	_IFVAL_JUMP(@WK_SCENE_T05, 'LT', 2, 'ev_t05_gsball_event_not_yet')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_02', 'Do you want to take the Poké Ball\nfrom the shrine?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05_gsball_event_yes')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05_gsball_event_yes:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_yes', '{0,1,0,0} reached into the shrine and took out the \nmysterious Poké Ball ')
	_LDVAL(@SCWK_TEMP0, 1291); GS Ball
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_FLAG_SET(#2604); Kill 'ev_gsball_event' placedata
	_FLAG_RESET(#2605); Old man's work flag
	_OBJ_ADD('T05_EVENT_OLDMAN')
	_OBJ_ANIME('T05_EVENT_OLDMAN', 'anm_gsball_oldman_walkto_player')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_03', 'Hm? What’s this? ')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_04', 'Did you take that strange Poké Ball\nout of the shrine, child?')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_05', 'Well, never mind.\nIt is of no consequence.')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_06', 'That Gold-Silver Ball was an offering\nto the guardian of the forest.')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_07', 'There’s no forest near here, though.\nJust a lot of mountains.')
	_MACRO_TALKMSG('dialogue_t05', '00-msgt05_gs_event_08', 'Perhaps it could better serve its\npurpose if it were taken to a forest?\rWell, take care of that relic.\nOh, and yourself, too.')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_EVENT_OLDMAN', 'anm_gsball_oldman_walkfrom_player')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_FLAG_SET(#2605); Hide old man again
	_CALL('ev_t05_ensure_celebi_flags')
	_OBJ_DEL('T05_EVENT_OLDMAN')
	_LDVAL(@102, 555)
	_FLAG_SET(#2616); Celebi event is in progress
	_FLAG_SET(#2543)
	_FLAG_RESET(#2892)
	_OBJ_DEL('T05_SHRINE_ITEM')
	_OBJ_ADD('T05_PICHU_EVENT')
	_TALK_OBJ_END()
	_END()
ev_t05_ensure_celebi_flags:
	_FLAG_SET(#2606);Hide Celebi 1
	_FLAG_SET(#2607);Hide Portal 1
	_FLAG_SET(#2608);Hide Celebi 2
	_FLAG_SET(#2609);Hide Portal 3
	_FLAG_SET(#2610);Hide Celebi 4
	_FLAG_SET(#2611);Hide Portal 5
	_FLAG_SET(#2612);Hide Celebi 6
	_FLAG_SET(#2613);Hide Portal 7
	_FLAG_SET(#2614);Hide Celebi 8
	_FLAG_SET(#2615);Hide Final Celebi
	_RET()
