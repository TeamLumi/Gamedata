anm_t05_oldwoman_02:
	_AC_DIR_U(4)
	_AC_UP(9, 8)
	_AC_DIR_L(4)
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_t05_oldwoman_03:
	_AC_DIR_U(4)
	_AC_UP(9, 8)
	_AC_DIR_L(4)
	_AC_LEFT(3, 8)
	_ACMD_END()
anm_t05_oldwoman_11:
	_AC_DIR_U(4)
	_AC_UP(9, 8)
	_AC_DIR_L(4)
	_AC_LEFT(2, 8)
	_AC_DIR_U(8)
