	;_MACRO_TALKMSG('dp_scenario2', 'msg_t05_stopper1_02', 'Hey now, kids are loaded these days.\nThere’s nothing illegal about my prices.')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_02', 'Hey now, kids are loaded these days.\nThere’s nothing illegal about my prices.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('T05_STOPPER1')
