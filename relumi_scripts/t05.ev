	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_02', 'Wha— Why I oughta... If my back weren’t shot\nthen I’d box your ears so good that you\fwouldn’t be able to hear the horseradish that\fyou’re spouting!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T05_KURT', 'HERO')
	;_MACRO_TALKMSG('dp_scenario2', 'msg_t05_stopper1_kurt_2', 'Pay no attention to this good for nothing\nscoundrel, kid. I’ll deal with him soon enough.')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_kurt_2', 'Pay no attention to this good for nothing\nscoundrel, kid. I’ll deal with him soon enough.')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T05_KURT', 'T05_STOPPER1')
	_TIME_WAIT(5, @SCWK_ANSWER)
	;_MACRO_TALKMSG('dp_scenario2', 'msg_t05_stopper1_03', 'Scoundrel?')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_03', 'Scoundrel?')
	_TALK_CLOSE()
	_OBJ_ANIME('T05_STOPPER1', 'anm_t05_salesman_sad')
	_PLAY_EMO_SE(8) ; Play sound
	_OBJ_ANIME_WAIT()
	;_MACRO_TALKMSG('dp_scenario2', 'msg_t05_stopper1_04', 'Words can hurt, you know...?')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_04', 'Words can hurt, you know...?')
	_TALK_CLOSE()
	_FLAG_SET(#1760) ; Salesman has been talked to once
	_TALK_OBJ_END()
	_END()
ev_t05_stopper1_kurt_2:
	_CHARA_LOOK_LOCK('T05_KURT', 'HERO') ; Needed for the PlaceData to not turn away before the message closes, for some reason TALK_OBJ_START is not enough here to lock him, I guess it's movecode related, but I changed it to 0 and it didn't work either, so, this solves it
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_stopper1_kurt_2', 'Pay no attention to this good for nothing\nscoundrel, kid. I’ll deal with him soon enough.')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T05_KURT', 'T05_STOPPER1')
	_TALK_OBJ_END()
	_END()
ev_t05_stopper2:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', '154-msg_t05_stopper2_01', 'Sllooowwwww...')
	_VOICE_PLAY(79, 0, 0)
	_END()
ev_t05_stopper2_2:
	_MACRO_EASY_OBJ_MSG('dialogue_t05', 'msg_t05_stopper2_02', '...pooooooooooke.')
	_VOICE_PLAY(79, 0, 0)
	_END()
ev_t05_kurt_intro:
	_TALK_OBJ_START_LOOK_NONE()
	_CHARA_LOOK_LOCK('HERO', 'T05_KURT2')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_intro_01', 'That’s a lesson to you, whippersnapper!\nIf I see you hocking your shady wares around\fhere again then you’ll be begging me to go as\feasy on you as I just did.')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('T05_KURT2', 'HERO')
	_IF_FLAGON_CALL(#1760, 'ev_t05_kurt_intro_talkedbefore') ; Player had already interacted with the Salesman
	_IF_FLAGOFF_CALL(#1760, 'ev_t05_kurt_intro_nottalkedbefore') ; Player had not interacted with the Salesman
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_intro_04', 'My back was killing me earlier but I’m fighting\nfit again now.\rI suppose I ought to make acquaintances all\nformal like, now that that business is out of the\fway.')
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_intro_05', 'The name’s Kurt. I’m just in town to pay a visit\nto an old friend, but I figure I’d may as well\fmake myself useful while I’m around.\rCome visit me in the Celestic Town store if\nyou’re wanting some special Poké Balls\ffabricated.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('T05_KURT2')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('HERO', 'anm_t05_player_stepback')
	_OBJ_ANIME_WAIT()
	; Walk to door
	_TIME_WAIT(1, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('HERO', 'T05_KURT2')
	_OBJ_ANIME('T05_KURT2', 'anm_t05_kurt_walk_away')
	_OBJ_ANIME_WAIT()
	;Open the door
	_SE_PLAY('S_FI012')
	_SET_DOOR_OBJ('T05R0201_D01')
	_HIT_DOOR_ANIME(0)
	; Walk inside
	_OBJ_ANIME('T05_KURT2', 'anm_t05_kurt_door')
	_OBJ_ANIME_WAIT()
	_HIT_DOOR_ANIME_WAIT()
	; Close door
	_SE_PLAY('S_FI013')
	_SET_DOOR_OBJ('T05R0201_D01')
	_HIT_DOOR_ANIME(1)
	_HIT_DOOR_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_FLAG_SET(#1761) ; Kurt intro event completed
	_TALK_OBJ_END()
	_END()
ev_t05_kurt_intro_talkedbefore:
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_intro_02', 'There you are, young’n! I told you I’d give that\nno good poacher what for, didn’t I?')
	_RET()
ev_t05_kurt_intro_nottalkedbefore:
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_kurt_intro_03', 'This degenerate poacher was trying to sell the\ntails of these gentle Slowpoke. I gave him what\ffor, I tell you what!')
	_RET()
ev_t05_dying_salesman:
	_TALK_OBJ_START_LOOK_NONE()
	_MACRO_TALKMSG('dialogue_t05', 'msg_t05_dying_salesman_01', 'Nnnghh... That old man really packs a wallop\ndespite his age.\rAll I’m askin’ to do is sell some Slowpoke Tails,\nand he beat me up!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
