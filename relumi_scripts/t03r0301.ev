ev_t03r0301_woman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t03r0301', '00_msg_t03r0301_woman1_01', 'Don’t you think Skorupi has a wonderful bit of\nmature charm to it?\rPerfect for a lady like myself.\nI knew you agreed with me!\r...Sorry?\nOh, I thought you were someone else!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03r0301_aerialace:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2681, 'ev_t03r0301_aerialace_done')
	_MACRO_TALK_KEYWAIT('dialogue_t03r0301', '00_msg_ev_t03r0301_aerialace', 'Santoryu?\rNitoryu?\rAll you need is one sword to\nperform the Turning Swallow Cut!\rYour enemies will be cut down\nbefore they can even blink!\rBut swordsmanship is difficult in\nmy old age...\rYour Pokémon can perform a similar\ntechnique too, you know.\rTake this TM, youngster.')
	_LDVAL(@SCWK_TEMP0, 367); Aerial Ace TM
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_MACRO_TALK_KEYWAIT('dialogue_t03r0301', '00_msgev_t03r0301_aerialace_2', 'That TM contains Aerial Ace.\rWith its swiftness and accuracy, the\nmove will never miss its target.')
	_FLAG_SET(#2681)
	_JUMP('ev_t03r0301_aerialace_end')
ev_t03r0301_aerialace_done:
	_MACRO_TALK_KEYWAIT('dialogue_t03r0301', '00_msgev_t03r0301_aerialace_3', 'Ah, I do miss practicing the way\nof the sword in my youth.')
	_JUMP('ev_t03r0301_aerialace_end')
ev_t03r0301_aerialace_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()