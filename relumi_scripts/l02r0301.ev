ev_l02r0301_flag_change:
	_FLAG_SET(#FV_L02R0301_GUITER)
	_IF_FLAGON_CALL($SYS_FLAG_GAME_CLEAR, 'ev_l02r0301_guiter_open')
	_END()
ev_l02r0301_guiter_open:
	_FLAG_RESET(#FV_L02R0301_GUITER)
	_OBJ_ADD('L02R0301_GUITER')
	_RET()
ev_l02r0301_masuda:
	_TALK_OBJ_START()
	_ZUKAN_CHK_NATIONAL(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_l02r0301_masuda02')
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_l02r0301_masuda01')
	_JUMP('ev_l02r0301_masuda03')
	_END()
ev_l02r0301_masuda01:
	_IF_FLAGON_JUMP(#FH_02, 'ev_l02r0301_masuda03')
	_JUMP('ev_l02r0301_masuda_sinou_celebration')
	_END()
ev_l02r0301_masuda02:
	_IF_FLAGON_JUMP(#FH_03, 'ev_l02r0301_masuda03')
	_JUMP('ev_l02r0301_masuda_zenkoku_celebration')
	_END()
ev_l02r0301_masuda03:
	_CASSET_VERSION_GET(@SCWK_ANSWER, 0)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 10, 'ev_l02r0301_masuda03_1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 11, 'ev_l02r0301_masuda03_1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 12, 'ev_l02r0301_masuda03_1')
	_JUMP('ev_l02r0301_masuda05')
	_END()
ev_l02r0301_masuda03_1:
	_IF_FLAGON_JUMP(#FH_04, 'ev_l02r0301_masuda04')
	_JUMP('ev_l02r0301_masuda_tokikake_celebration1')
	_END()
ev_l02r0301_masuda04:
	_CASSET_VERSION_GET(@SCWK_ANSWER, 0)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 10, 'ev_l02r0301_masuda04_1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 11, 'ev_l02r0301_masuda04_1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 12, 'ev_l02r0301_masuda04_1')
	_JUMP('ev_l02r0301_masuda05')
	_END()
ev_l02r0301_masuda04_1:
	_FRONT_POKEMON(@SCWK_PARAM0)
	_TEMOTI_MONSNO(@SCWK_PARAM0, @LOCALWORK11)
	_LDVAL(@LOCALWORK13, 1)
	_TEMOTI_PER_RND(@SCWK_PARAM0, @LOCALWORK13)
	_IFVAL_JUMP(@LOCALWORK11, 'EQ', @LOCALWORK10, 'ev_l02r0301_masuda05_y')
	_JUMP('ev_l02r0301_masuda_tokikake_celebration2')
	_END()
ev_l02r0301_masuda05_y:
	_IFVAL_JUMP(@LOCALWORK13, 'EQ', @LOCALWORK12, 'ev_l02r0301_masuda05')
	_JUMP('ev_l02r0301_masuda_tokikake_celebration2')
	_END()
ev_l02r0301_masuda05:
	_IF_FLAGOFF_JUMP(#FH_01, 'ev_l02r0301_masuda_talk00')
	_IF_FLAGON_JUMP(#FH_05, 'ev_l02r0301_masuda_talk01')
	_IF_FLAGON_JUMP(#FH_04, 'ev_l02r0301_masuda_talk01')
	_IF_FLAGON_JUMP(#FH_03, 'ev_l02r0301_masuda_talk02')
	_IF_FLAGON_JUMP(#FH_02, 'ev_l02r0301_masuda_talk02')
	_JUMP('ev_l02r0301_masuda_sinou_celebration')
ev_l02r0301_masuda_sinou_celebration:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_02_1', 'Ciao! I’m a game director!')
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_02_2', 'Your Pokédex is looking great!\rYou’ve already met every Pokémon there is to\nmeet in this region.\rI’m really impressed! Let me give you an award!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_TIME_WAIT(1, @SCWK_ANSWER)
	_ZUKAN_RECONGNIZE_SHINOU()
	_RECONGNIZE_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_FLAG_SET(#FE_RECONGNIZE_SHINOU)
	_FLAG_SET(#FH_01)
	_FLAG_SET(#FH_02)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_masuda_zenkoku_celebration:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_03_1', 'Ciao! I’m a game director!\rYou’ve finally collected all the Pokémon in\nthe world!\rYour Pokédex is completed!')
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_03_2', 'That’s outstanding work! The effort you went\nthrough getting this Pokédex together...\rIt’s fantastic! Totally cool! Thank you very much!\rPlease allow GAME FREAK to honor you with\nan award!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_TIME_WAIT(1, @SCWK_ANSWER)
	_ZUKAN_RECONGNIZE_NATIONAL()
	_RECONGNIZE_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_FLAG_SET(#FE_RECONGNIZE_NATIONAL)
	_FLAG_SET(#FH_01)
	_FLAG_SET(#FH_03)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_masuda_tokikake_celebration1:
	_FRONT_POKEMON(@SCWK_PARAM0)
	_TEMOTI_MONSNO(@SCWK_PARAM0, @LOCALWORK10)
	_LDVAL(@LOCALWORK12, 1)
	_TEMOTI_PER_RND(@SCWK_PARAM0, @LOCALWORK12)
	_NICK_NAME(0, 0)
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_05_1a', 'Let’s see your Pokédex... Hey, wait a second!\rC-could that be?!\rThis {0,1,1,0}, here! Did it really come\nall this way?!', 0, 1)
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_05_2', 'You’ve really treasured that {0,1,1,0},\nhaven’t you?\rI just want you to know how much that means\nto me!', 0, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_TIME_WAIT(1, @SCWK_ANSWER)
	_RECONGNIZE_TOKIKAKE()
	_RECONGNIZE_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_FLAG_SET(#FH_01)
	_FLAG_SET(#FH_04)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_masuda_tokikake_celebration2:
	_NICK_NAME(0, 0)
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_05_1b', 'Oh! Has this {0,1,1,0} been on a\nremarkably long journey, as well?!')
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_05_2', 'You’ve really treasured that {0,1,1,0},\nhaven’t you?\rI just want you to know how much that means\nto me!', 0, 1)
	_TALK_CLOSE()
	_FRONT_POKEMON(@SCWK_PARAM0)
	_TEMOTI_MONSNO(@SCWK_PARAM0, @LOCALWORK10)
	_LDVAL(@LOCALWORK12, 1)
	_TEMOTI_PER_RND(@SCWK_PARAM0, @LOCALWORK12)
	_EVENT_CAMERA_INDEX(115)
	_TIME_WAIT(1, @SCWK_ANSWER)
	_RECONGNIZE_TOKIKAKE()
	_RECONGNIZE_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_FLAG_SET(#FH_01)
	_FLAG_SET(#FH_05)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_masuda_talk00:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_01_1', 'Ciao! I’m a game director!\rYou’re working on filling a Pokédex, aren’t you?')
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_01_2', 'It’s awesome that you’re going to meet lots\nof Pokémon.\rCome show me your Pokédex when you’ve filled\nit with tons of entries!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_masuda_talk01:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_05_3', 'I’ll send this certificate to your heart!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_masuda_talk02:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_04_1', 'How did you meet all the Pokémon that filled\nyour Pokédex?')
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_04_2', 'Did you work long and hard to catch and\nraise them?\rDid you receive them as gifts from friends?\rMaybe you got some in trades from around\nthe world?')
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_masuda_04_3', 'Though everyone’s Pokédexes may look the\nsame, the stories they contain are all unique.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda:
	_TALK_OBJ_START()
	_ZUKAN_CHK_SHINOU(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_l02r0301_ueda03')
	_JUMP('ev_l02r0301_ueda01')
	_END()
ev_l02r0301_ueda01:
	_IF_FLAGON_JUMP(#FE_HOKAKU_OMAMORI_GET, 'ev_l02r0301_ueda02')
	_JUMP('ev_l02r0301_ueda_sinou_celebration')
	_END()
ev_l02r0301_ueda02:
	_ZUKAN_CHK_NATIONAL(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_l02r0301_ueda03')
	_IF_FLAGON_JUMP(#FE_HIKARU_OMAMORI_GET, 'ev_l02r0301_ueda03')
	_JUMP('ev_l02r0301_ueda_sinou_zenkoku_celebration')
	_END()
ev_l02r0301_ueda03:
	_IF_FLAGON_JUMP(#FH_08, 'ev_l02r0301_ueda_talk02')
	_IF_FLAGON_JUMP(#FH_07, 'ev_l02r0301_ueda_talk01')
	_JUMP('ev_l02r0301_ueda04')
ev_l02r0301_ueda04:
	_IF_FLAGON_JUMP(#FE_UEDA_BTW_CELEBRATION, 'ev_l02r0301_ueda05')
	_IF_FLAGON_JUMP(#FE_BTW_ALL_CREAR, 'ev_l02r0301_ueda_btw_celebration1')
	_IF_FLAGON_JUMP(#FH_09, 'ev_l02r0301_ueda_talk00_1')
	_JUMP('ev_l02r0301_ueda_talk00')
	_END()
ev_l02r0301_ueda05:
	_ZUKAN_CHK_NATIONAL(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_l02r0301_ueda_btw_celebration3')
	_JUMP('ev_l02r0301_ueda_btw_celebration2')
	_END()
ev_l02r0301_ueda_sinou_celebration:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_01a', 'Hi there! I’m the director who really\nloves Gengar.\rCongratulations on completing your\nSinnoh Pokédex!\rNow keep on collecting even more Pokémon!')
	_LDVAL(@SCWK_TEMP0, 1267)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FH_07)
	_FLAG_SET(#FE_HOKAKU_OMAMORI_GET)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda_sinou_zenkoku_celebration:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_02a', 'Hi there! It’s me, the Gengar-loving director.\rOh, wow! I see you’ve completed your National\nPokédex. Congratulations!\rHere, I’ve got a present for you!')
	_LDVAL(@SCWK_TEMP0, 632)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FH_08)
	_FLAG_SET(#FE_HIKARU_OMAMORI_GET)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda_btw_celebration1:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_04a', 'Hi there! It’s me, the Gengar-loving director.\rWow! You triumphed over the entire\nBattle Tower!\rThe bond between you and your Pokémon really\nis something else! Congratulations!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FE_UEDA_BTW_CELEBRATION)
	_END()
ev_l02r0301_ueda_btw_celebration2:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_04b', 'I’m sure there are even stronger Trainers\nsomewhere out there in the world.\rBut knowing you and your Pokémon, I’m sure you\nwould have a blast battling them, too!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda_btw_celebration3:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_03b', 'Battles are great and all, but filling up your\nPokédex is a lot of fun, too!\rIf you keep finding Pokémon from a variety of\ndifferent places, please come show me.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda_talk00:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_03a', 'Hi there! It’s me, the Gengar-loving director.\rBattling other Trainers sure is exciting, isn’t it?\rKeep building up those bonds with your Pokémon\nso you can take on tougher Trainers!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FH_09)
	_END()
ev_l02r0301_ueda_talk00_1:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_03b', 'Battles are great and all, but filling up your\nPokédex is a lot of fun, too!\rIf you keep finding Pokémon from a variety of\ndifferent places, please come show me.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda_talk01:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_01b', 'When you’ve got a Catching Charm, it becomes\neasier to get a critical catch.\rGo ahead and try it out!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_ueda_talk02:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02r0301_ueda_02b', 'When you’ve got a Shiny Charm, you’ll be more\nlikely to run into Shiny Pokémon.\rGo ahead and give it a try!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sound_creater_ds:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02R0301_GUITER, 'ev_sound_creater_ds_geted')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02_sounddesigner_01', 'I am the Sound Designer! I compose music\nfor games.\rWow! You beat the Sinnoh Champion!\nThat’s great!\rI’ll give you something cool for that.')
	_SE_PLAY('M_FI012')
	_LDVAL(@SCWK_TEMP0, 1822); DS Sounds
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_FLAG_SET(#FE_L02R0301_GUITER)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sound_creater_ds_geted:
	_MACRO_TALKMSG('dialogue_l02r0301', '117-msg_l02_sounddesigner_03', 'DS is a thing with two screens that opens up...\nOh, wait! That was a Nintendo DS!\rTurn it on and DS Sounds will let you hear some\nsounds from the old days.\rEnjoy the nostalgia of those sparkling memories!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_kodakku:
	_EASY_VOICE_MSG('dialogue_l02r0301%117-msg_l02r0301_kodaku', 'PLAY_PV_EV_054_00_00')
	_END()
ev_l02r0301_genga:
	_EASY_VOICE_MSG('dialogue_l02r0301%117-msg_l02r0301_genga', 'PLAY_PV_EV_094_00_00')
	_END()
ev_l02r0301_dray:
	_TALK_OBJ_START_TURN_NOT()
	_SYS_FLAG_GAME_CLEAR_GET(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_l02r0301_dray_come_back_later')
	_IF_FLAGON_JUMP(#2757, 'ev_l02r0301_dray_beaten')
	_MACRO_TALKMSG('dialogue_l02r0301', '00_msg_l02r0301_dray_1', 'Congratulations on becoming\nthe Champion in Renegade Platinum!\rYour team must be super strong, now.\nDo you want to have a battle?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_l02r0301_dray_yes')
	_JUMP('ev_l02r0301_dray_no')
ev_l02r0301_dray_come_back_later:
	_MACRO_TALKMSG('dialogue_l02r0301', '00_msg_l02r0301_dray_2', 'Hey! Call me Dray.\nI created Renegade Platinum.\rAre you having fun playing\nLuminescent Platinum?\rCome back if you become the Champion.\nWe can have a fun battle together.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_dray_no:
	_MACRO_TALKMSG('dialogue_l02r0301', '00_msg_l02r0301_dray_3', 'No worries. Come back any time.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_l02r0301_dray_yes:
	_MACRO_TALKMSG('dialogue_l02r0301', '00_msg_l02r0301_dray_4', 'Alright, great.\nLet’s get started!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 949)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_MACRO_TALKMSG('dialogue_l02r0301', '00_msg_l02r0301_dray_5', 'Oof! You’re pretty good.\nI didn’t expect you’d be so strong!\rThanks for playing Renegade Platinum.\nI hope you found it to be a lot of fun!')
	_TALK_CLOSE()
	_FLAG_SET(#2757)
	_TALK_OBJ_END()
	_END()
ev_l02r0301_dray_beaten:
	_MACRO_TALKMSG('dialogue_l02r0301', '00_msg_l02r0301_dray_6', 'Hey!\nIt’s good to see you.\rThanks for playing Luminescent Platinum.\nI hope you found it to be a lot of fun!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()