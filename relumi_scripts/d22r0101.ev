ev_d22r0101_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D22R0101)
	_END()
ev_d22r0101_mania:
	_TALK_OBJ_START()
	_ANOON_SEE_NUM(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 10, 'ev_r22r0101_mania_02')
	_MACRO_TALKMSG('dialogue_d22r0101', '111-msg_d22r0101_mania_01_1', 'Everyone calls me a Ruin Maniac. I don’t care\nwhat they call me.\rI’ll just keep on chipping away at the rock wall\nlittle by little.')
	_MACRO_TALKMSG('dialogue_d22r0101', '111-msg_d22r0101_mania_01_2', 'Do you know why? I’m a Ruin Maniac who is\nfascinated by the Unown.\rI know it’s a little sudden, but how about you\nand me have a race?')
	_MACRO_TALKMSG('dialogue_d22r0101', '111-msg_d22r0101_mania_01_3', 'You go and catch the Unown, and I’ll keep\ndigging away.\rWe’ll have a race to see who can get done faster.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r22r0101_mania_02:
	_MACRO_TALKMSG('dialogue_d22r0101', '111-msg_d22r0101_mania_02_1', 'Everyone calls me a Ruin Maniac. I don’t care\nwhat they call me.\rI’ll just keep on chipping away at the rock wall\nlittle by little.')
	_MACRO_TALKMSG('dialogue_d22r0101', '111-msg_d22r0101_mania_02_2', 'Do you know why? I’m a Ruin Maniac who is\nfascinated by the Unown.')
	_MACRO_TALKMSG('dialogue_d22r0101', '111-msg_d22r0101_mania_02_3', 'Well, I need to bear down and dig through the\nbedrock now.\rI want to search out some rare Unown. It’s going\nto be messy. You’d better go outside.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()