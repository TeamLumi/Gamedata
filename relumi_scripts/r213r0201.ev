	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 30, 'ev_r213r0201_footmark_d1_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 20, 'ev_r213r0201_footmark_d1_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 10, 'ev_r213r0201_footmark_d1_03')
