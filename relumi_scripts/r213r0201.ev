	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 30, 'ev_r213r0201_footmark_d2_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 20, 'ev_r213r0201_footmark_d2_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 10, 'ev_r213r0201_footmark_d2_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 5, 'ev_r213r0201_footmark_d2_02')
	_JUMP('ev_r213r0201_footmark_d2_01')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a1_01:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_a1_01_1')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a1_02:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_a1_02')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a1_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_a1_03', 'This adventure with {1,1,0,0} is lots\nof fun.\rI get to go places where I can’t go by myself.\rI get to battle Pokémon I’ve never ever\nseen before.\rI’m gonna get stronger and stronger\nfor {1,1,0,0}!', 0, 1)
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a1_04:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_a1_04')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a1_05:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_a1_05', 'If I said there can be friendship between\nPokémon and people, would my\ffriends understand?\rBut if you see {1,1,0,0} and me, you\nwill understand.\rBecause {1,1,0,0} and I are friends!', 0, 1)
	_JUMP('ev_r213r0201_footmark_ashi_ari_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a2_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_a2_01', 'I’m bored... Play with me more, more...\r{2,1,2,0}, let’s play nicer...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a2_02:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_a2_02', 'Gonna go with {1,1,0,0} all over\nthe place...\rBe nice to me... Warm and cuddly...', 0, 1)
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a2_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_a2_03', 'I get strong, make {1,1,0,0} happy.\rRound ones, square ones, triangle ones,\nwobbly ones...\rI want to see different kinds of Pokémon...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a2_04:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_a2_04')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_a2_05:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_a2_05')
	_JUMP('ev_r213r0201_footmark_ashi_nashi_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b1_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_01_1', 'Why does {1,1,0,0} use only\nother Pokémon? Am I not needed much?')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_01_2', 'Would I have been better off if I remained in\nthe wild?\rNo, I should give this Trainer a little more of\na chance...')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b1_02:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_02_1', 'Humans can’t understand the cries of Pokémon\nor our feelings.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_02_2', 'However, there are some among us that\nunderstand human speech...\rHehehe, {1,1,0,0}, you’re not bad for\na human.', 0, 1)
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b1_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_03_1', 'If a Pokémon were to travel alone, it would be\nlimited as to where it could go.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_03_2', 'But traveling with a human, a Pokémon would be\nable to travel farther afield to more distant cities\fand lands.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_03_3', 'Traveling with {1,1,0,0} has been\nrewarding and reassuring. And very entertaining...')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b1_04:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_04_1', 'Some wild Pokémon frown upon others for\ntraveling with humans.\rThey jeer that the caught Pokémon have\n“forgotten the wild.”')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_04_2', 'But that view is mistaken. They have just never\nmet a Trainer who could be a great partner.\rA great partner like {1,1,0,0}, in\nother words...', 0, 1)
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b1_05:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_05_1', '{1,1,0,0} is...a remarkable human\nand Trainer.\rThat I can always perform the best any\n{0,1,1,0} possibly can...\rI attribute that entirely to my\npartner {1,1,0,0}.', 0, 1)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b1_05_2', 'When we travel, I can see wild Pokémon eyeing\nus enviously...')
	_JUMP('ev_r213r0201_footmark_ashi_ari_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b2_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b2_01', 'Does {1,1,0,0} intend to ignore me\nforever? Give me more opportunities to shine...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b2_02:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b2_02', 'If a Pokémon is treated as a friend, it will return\nthe sentiment.\rWe grow fonder of humans that treat us with\nkindness... Does {1,1,0,0} even like me?')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b2_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_b2_03', 'Did I get stronger? Who is responsible for\nmaking me so?\rIs it {1,1,0,0}’s doing? Is the Trainer\nowed my thanks?', 0, 1)
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b2_04:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_b2_04')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_b2_05:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_b2_05')
	_JUMP('ev_r213r0201_footmark_ashi_nashi_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c1_01:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_c1_01_1')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c1_01_2', 'Am I considered useless? Is the Trainer regretting\nhaving me?\rDoes the Trainer dare disrespect this\n{0,1,1,0} so easily?')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c1_02:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_c1_02_1')
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_c1_02_2')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c1_03:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_c1_03')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c1_04:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c1_04_1', 'Not for a moment did I think I would be traveling\nwith a human.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c1_04_2', 'If my {0,1,1,0} friends were to see me\nnow, they would be shocked!\rOr would they be envious of me?')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c1_05:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c1_05_1', 'That {1,1,0,0} is the most impressive\nof humans—\rIt takes a lot to make me, {2,1,2,0},\nsunny and cheerful!', 0, 1)
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_c1_05_2')
	_JUMP('ev_r213r0201_footmark_ashi_ari_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c2_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c2_01', 'Wooooooh... I have nothing to do...\rKeep me too bored, and I’m liable to sneak up\nand bite.')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c2_02:
	_TALKMSG('dialogue_r213r0201%146-msg_footmark_c2_02')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c2_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c2_03', '{1,1,0,0} treats me, {2,1,2,0},\nnicely without being scared. But I will be even\fscarier from now on.\rThat’s just what we {0,1,1,0} do...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c2_04:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c2_04', 'I’m starting to forget a little about being in\nthe wild...\rBut I’m not feeling sad. It’s never boring when\nI’m together with {1,1,0,0}...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_c2_05:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c2_05_1', 'There are no Pokémon that dislike humans, only\nhumans that dislike Pokémon...')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_c2_05_2', 'We {0,1,1,0} are especially shunned...\rBut {1,1,0,0} always treats me as a\nfriend and partner...')
	_JUMP('ev_r213r0201_footmark_ashi_nashi_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d1_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_01_1', 'Hnurrrr... Hunh? This is...where?\r{1,1,0,0}’s house, is this?\nIt’s not? Hnurrr...', 0, 1)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_01_2', 'If you don’t need me for anything, can I go back\nto my Poké Ball?\rHnurrr...')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d1_02:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_02_1', 'Hnurrr... Me? Uhm...\nI like to sleep most the time.\fOh, I like to eat, too. That’s next.\rBut what I really like is to think. I’m a very\ndeep thinker.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_02_2', 'When I think about the future of the\n{0,1,1,0} species...\rHnurrr...hunh?\rOh, I forget where the time goes.\nHnurrrr...')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d1_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_03z_1', 'Hnurrr... Me? Uhm...\nThere are lots of kinds of moves.\rI like those Dark-type moves.\nOh, and Dragon-type moves, too...')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_03_2', 'How would they be for this {0,1,1,0}?\rWill they be for me? Or a no-no sort of thing?\rHnurrr...')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d1_04:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_04_1', 'Hnurrr... I don’t know how to begin saying this...\rBefore I met {1,1,0,0}, I liked living\nquietly. Sssh.\rBut I’m getting to like traveling\nwith {1,1,0,0}.', 0, 1)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_04_2', 'I think I’m getting sort of funky.\nDo you think I’m sort of funky?\rNo? No funk for me?\nHnurrr...')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d1_05:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_05_1', 'Hnurrr... Me? Uhm...\nOther Pokémon, they say to me...\r“You’re not thinking, are you?”\rHow insulting they should say so. It isn’t true\nwhat they say. Think, think, think, I do that.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d1_05_2', 'All the time, I think hard how to help\n{1,1,0,0}. I concentrate!\rHnurrr...')
	_JUMP('ev_r213r0201_footmark_ashi_ari_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d2_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d2_01', 'Hnurrr...\nI did not know that?\fI really don’t? What is this?\fI don’t know what to say?\fHnurrr...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d2_02:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d2_02', 'Hnurrr... Well, I...I think I’m motivated.\rAs motivated as the average.\nBut it’s not so simple as that.\fHnurrr...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d2_03:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d2_03', 'Hnurrr... How should I say this?\rWe both look out for each other.\nThat’s what we try to do, I think.\fThat is for the best.\fHnurrrr...')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d2_04:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d2_04', 'Hnurrr... How do I say? How should I describe us?\rWe are the sound of both hands clapping.\r{1,1,0,0} and I are together in\nsynchronicity like twins.\rHnurrr...', 0, 1)
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_d2_05:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_d2_05', 'Hnurrr...\nWhat is left to say, I say?\rWe have come so far now, where can we go but\nto see this through?\rHall of Fame...\nWords so sweet fall from my mouth.\rHnurrr...')
	_JUMP('ev_r213r0201_footmark_ashi_nashi_ribbon_chk')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_ashi_ari_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 19)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213r0201_footmark_06')
	_JUMP('ev_r213r0201_footmark_03')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_ashi_nashi_ribbon_chk:
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 19)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213r0201_footmark_07')
	_JUMP('ev_r213r0201_footmark_04')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_un_01:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_un_01', 'Sssshhnnn...\nSsshhhnnn...\fSsshhhnnn...')
	_GET_NATSUKI(@SCWK_ANSWER, @SCWK_PARAM2, -1)
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 255, 'ev_r213r0201_footmark_05')
	_CHK_RIBBON(@SCWK_ANSWER, @SCWK_PARAM2, 19)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213r0201_footmark_08')
	_JUMP('ev_r213r0201_footmark_05')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_03:
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CALL('ev_r213r0201_footmark_move_forward')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_03', 'And that is what your {0,1,1,0}\nthinks of you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0201_footmark_04:
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CALL('ev_r213r0201_footmark_move_forward')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_04', 'Hmmm... {0,1,1,0} doesn’t leave\nany footprints.\rIt’s somewhat difficult for me to determine what\nits thoughts are.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0201_footmark_05:
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CALL('ev_r213r0201_footmark_move_forward')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_05', 'Hmm... {0,1,1,0} happens to be quite\nthe silent type!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0201_footmark_06:
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CALL('ev_r213r0201_footmark_move_forward')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_06', 'And that is what your {0,1,1,0} thinks\nof you.\rI must say, your {0,1,1,0} and you share\na very close bond. This is for you.')
	_SE_PLAY('M_FI010')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_09', 'You received the Footprint Ribbon.')
	_ME_WAIT()
	_SET_RIBBON(@SCWK_PARAM2, 19)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_10', 'You put the Footprint Ribbon\non {0,1,1,0}.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
