	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', 1, 'ev_r213r0201_footmark_kawaii_ashi_ari')
	_JUMP('ev_r213r0201_footmark_kawaii_ashi_nashi')
	_JUMP('ev_r213r0201_footmark_03')
