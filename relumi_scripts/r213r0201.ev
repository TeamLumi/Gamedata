ev_r213r0201_spade_trade:
    _TALK_OBJ_START()
    _CALL('ev_r213r0201_spade_trade_values')
    _IF_FLAGON_JUMP(#3078, 'ev_r213r0201_spade_trade_over')
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _POKEMON_NAME_FORM(1, @LOCALWORK2, @LOCALWORK3)
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_spade_trade_1', 'Hey you, big kid!\nCould you do me a big, big favor?\rI was at the beach building sandcastles, when\nsuddenly, this weird Pokémon appeared!\rI thought it would be mean or scary, but it’s\nactually really nice!\rThe only thing is... my mommy is really scared\nof it.\rIt’s called {1,1,1,0}, and it’s a Ghost-type.\nMommy really doesn’t like those...\rIt’s a really good digging buddy, but mommy\nsays I should get a {0,1,1,0} instead.')
    _TALK_CLOSE()
    _POKE_WINDOW_PUT(@LOCALWORK0, @LOCALWORK1)
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _POKEMON_NAME_FORM(1, @LOCALWORK2, @LOCALWORK3)
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_spade_trade_2', 'You look like a really good Trainer!\nCould you trade a {0,1,1,0} for my\f{1,1,1,0}?')
    _YES_NO_WIN(@SCWK_ANSWER)
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213r0201_spade_trade_yes')
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r213r0201_spade_trade_no')
ev_r213r0201_spade_trade_values:
    _LDVAL(@LOCALWORK0, 50); Given trade MonsNo
    _LDVAL(@LOCALWORK1, 0); Given trade FormNo
    _LDVAL(@LOCALWORK2, 769); Received trade MonsNo
    _LDVAL(@LOCALWORK3, 0); Received trade FormNo
    _RET()
ev_r213r0201_spade_trade_yes:
    _TALK_CLOSE()
    _POKELIST_SET_PROC(34)
    _POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
    _IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_r213r0201_spade_trade_no'); If nothing was selected
    _TEMOTI_BOX_MONSNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
    _TEMOTI_BOX_FORMNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2)
    _IFVAL_JUMP(@SCWK_ANSWER, 'NE', @LOCALWORK0, 'ev_r213r0201_spade_trade_wrong_mon'); If a species other than the target was selected
    _IFVAL_JUMP(@SCWK_TEMP2, 'NE', @LOCALWORK1, 'ev_r213r0201_spade_trade_wrong_form'); If an incorrect form of the correct species was selected
    _TEMOTI_BOX_SHINY(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2)
    _TEMOTI_BOX_GENDER(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP3)
    _TALK_CLOSE()
    _LOCALKOUKAN_APPLY(7, @SCWK_TEMP1, @SCWK_TEMP0)
	_SXY_POS_CHANGE('HERO', 5, 6)
	_SXY_DIR_CHANGE('HERO', 180)
	_SXY_DIR_CHANGE('R213R0201_SPADE', 0)
    _IFVAL_CALL(@SCWK_TEMP2, 'EQ', 0, 'ev_r213r0201_spade_trade_placedata')
    _IFVAL_CALL(@SCWK_TEMP2, 'GE', 1, 'ev_r213r0201_spade_trade_placedata_shiny')
	_CALL('ev_r213r0201_diglett_cry')
    _JUMP('ev_r213r0201_spade_trade_over')
ev_r213r0201_spade_trade_no:
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_spade_trade_no', 'Aww, do you not have one to trade...?\rWell, it’s okay.\nIf you find one or change your mind, please\fcome back!\rI want to go digging in the sand with a buddy\nagain...')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_r213r0201_spade_trade_wrong_mon:
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_spade_trade_wrong_mon', 'Uh... That’s not what I’m looking for.\nI wanted a {0,1,1,0}, remember?\rWait, now that I think about it, wouldn’t it dig\nholes in the floor at my house?\rWell, mommy said I should get a {0,1,1,0},\nso that’s what I need!\fCome back if you get one, okay big kid?')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_r213r0201_spade_trade_wrong_form:
    _POKEMON_NAME_FORM(0, @LOCALWORK0); Just species name for brevity
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_spade_trade_wrong_form', 'Whoa!\nI’ve never seen that kind of {0,1,1,0} before!\rIt looks cool, but my mommy said to get the\nother form.\rPlease could you get the other {0,1,1,0}?\nI know this is a lot of rules, but you can figure\fit out!')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_r213r0201_spade_trade_placedata:
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 0, 'ev_r213r0201_spade_trade_placedata_male')
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 1, 'ev_r213r0201_spade_trade_placedata_female')
	_RET()
ev_r213r0201_spade_trade_placedata_male:
    _OBJ_ADD('R213R0201_DIGLETT_MALE')
    _FLAG_RESET(#2957)
    _RET()
ev_r213r0201_spade_trade_placedata_female:
    _OBJ_ADD('R213R0201_DIGLETT_FEMALE')
    _FLAG_RESET(#2958)
    _RET()
ev_r213r0201_spade_trade_placedata_shiny:
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 0, 'ev_r213r0201_spade_trade_placedata_shiny_male')
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 1, 'ev_r213r0201_spade_trade_placedata_shiny_female')
ev_r213r0201_spade_trade_placedata_shiny_male:
    _OBJ_ADD('R213R0201_DIGLETT_SHINY_MALE')
    _FLAG_RESET(#2959)
    _RET()
ev_r213r0201_spade_trade_placedata_shiny_female:
    _OBJ_ADD('R213R0201_DIGLETT_SHINY_FEMALE')
