	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 20, 'ev_r213r0201_footmark_c2_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 10, 'ev_r213r0201_footmark_c2_03')
