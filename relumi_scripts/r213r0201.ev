ev_r213r0201_spade_trade_over:
    _POKEMON_NAME_FORM(0, @LOCALWORK0); Just species name for brevity
    _POKEMON_NAME_FORM(1, @LOCALWORK2); Just species name for brevity
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_spade_trade_over', 'Yay! Thank you so much!\nI promise I’ll take good care of {0,1,1,0}!\rI hope {1,1,1,0} has a great time with you!\nBe sure to take it to the beach sometimes to\flet it play in the sand!')
    _FLAG_SET(#3078)
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_r213r0201_diglett:
	_TALK_OBJ_START()
    _CALL('ev_r213r0201_spade_trade_values')
	_CALL('ev_r213r0201_diglett_cry')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0201_diglett_cry:
    _VOICE_PLAY(@LOCALWORK0, @LOCALWORK1, 0)
    _MACRO_TALKMSG('dialogue_r213r0201', 'msg_r213r0201_diglett_cry', 'Digle-dig, Digle-dig!')
    _VOICE_WAIT()
	_RET()