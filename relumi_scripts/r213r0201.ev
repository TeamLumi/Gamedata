	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_07_1', 'Hmmm... {0,1,1,0} doesn’t leave\nany footprints.\rIt’s somewhat difficult for me to determine what\nits thoughts are.')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_07_2', 'However, your {0,1,1,0} and you\nobviously share a close bond. This is for you.')
	_SE_PLAY('M_FI010')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_09', 'You received the Footprint Ribbon.')
	_ME_WAIT()
	_SET_RIBBON(@SCWK_PARAM2, 19)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_10', 'You put the Footprint Ribbon\non {0,1,1,0}.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0201_footmark_08:
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CALL('ev_r213r0201_footmark_move_forward')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_08', 'Hmm... {0,1,1,0} happens to be quite\nthe silent type!\rHowever, your {0,1,1,0} and you\nobviously share a close bond. This is for you.')
	_SE_PLAY('M_FI010')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_09', 'You received the Footprint Ribbon.')
