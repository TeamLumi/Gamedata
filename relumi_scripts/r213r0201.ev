	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 1, 'ev_r213r0201_footmark_kawaii')
	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 2, 'ev_r213r0201_footmark_kakkoii')
	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 3, 'ev_r213r0201_footmark_kowai')
	_IFVAL_JUMP(@SCWK_PARAM1, 'EQ', 4, 'ev_r213r0201_footmark_otoboke')
	_JUMP('ev_r213r0201_footmark_un_01')
	_JUMP('ev_r213r0201_footmark_03')
