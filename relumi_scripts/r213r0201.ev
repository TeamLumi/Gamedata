ev_r213r0201_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_R213R0201)
	_END()
ev_r213r0201_footmark:
	_TALK_OBJ_START()
	_FRONT_POKEMON(@SCWK_PARAM2)
	_POKEMON_NAME(0, @SCWK_PARAM2)
	_PLAYER_NAME(1)
	_NICK_NAME(2, @SCWK_PARAM2)
	_ASHIATO_CHK(@SCWK_PARAM0, @SCWK_PARAM1, @SCWK_PARAM2)
	_IF_FLAGON_JUMP(#FE_R213R0201_FOOTMARK, 'ev_r213r0201_footmark_02')
	_FLAG_SET(#FE_R213R0201_FOOTMARK)
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_01_1', 'Pokémon are quite easy for me to read.\rI need only to see their footprints, and their\ninnermost thoughts are revealed to me!')
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_01_2', 'Oh? You are skeptical of my claim?\rThen, let your {0,1,1,0} walk in front of\nme, right here.\rFrom its footprints, I will determine how it feels\nabout you.')
	_TALK_CLOSE()
	_JUMP('ev_r213r0201_footmark_move_01')
	_JUMP('anm_r213r0201_call_footmark_back_l')
ev_r213r0201_footmark_02:
	_MACRO_TALKMSG('dialogue_r213r0201', '146-msg_footmark_02', 'Do you want to check the feelings of your\nPokémon again?\rThen let your {0,1,1,0} walk in front of\nme, right here.\rFrom its footprints, I will determine how it feels\nabout you.')
	_TALK_CLOSE()
	_JUMP('ev_r213r0201_footmark_move_01')
	_JUMP('anm_r213r0201_call_footmark_back_l')
ev_r213r0201_footmark_move_01:
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_TIME_WAIT(40, @SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_CALL('ev_r213r0201_footmark_move_back')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_JUMP('ev_r213r0201_footmark_chk_01')
	_JUMP('anm_r213r0201_call_footmark_back_l')
ev_r213r0201_footmark_move_back:
	_PLAYER_POS_GET(@SCWK_TEMP1, @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 4, 'anm_r213r0201_call_footmark_back_l')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 5, 'anm_r213r0201_call_footmark_back_r')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 5, 'anm_r213r0201_call_footmark_back_u')
	_JUMP('anm_r213r0201_call_footmark_back_d')
	_JUMP('anm_r213r0201_call_footmark_back_l')
anm_r213r0201_call_footmark_back_l:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_back_l')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r213r0201_call_footmark_back_r:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_back_r')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r213r0201_call_footmark_back_u:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_back_u')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r213r0201_call_footmark_back_d:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_back_d')
	_OBJ_ANIME_WAIT()
	_RET()
ev_r213r0201_footmark_move_forward:
	_PLAYER_POS_GET(@SCWK_TEMP1, @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 4, 'anm_r213r0201_call_footmark_forward_l')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 5, 'anm_r213r0201_call_footmark_forward_r')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 5, 'anm_r213r0201_call_footmark_forward_u')
	_JUMP('anm_r213r0201_call_footmark_forward_d')
	_JUMP('anm_r213r0201_call_footmark_forward_l')
anm_r213r0201_call_footmark_forward_l:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_forward_l')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r213r0201_call_footmark_forward_r:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_forward_r')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r213r0201_call_footmark_forward_u:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_forward_u')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r213r0201_call_footmark_forward_d:
	_OBJ_ANIME('R213R0101_FOOTMARK_01', 'anm_r213r0201_footmark_forward_d')
	_OBJ_ANIME_WAIT()
	_RET()
