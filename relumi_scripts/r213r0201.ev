	_POKE_LVUP_HOW_MANY(@SCWK_PARAM2, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 30, 'ev_r213r0201_footmark_a1_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 20, 'ev_r213r0201_footmark_a1_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 10, 'ev_r213r0201_footmark_a1_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 5, 'ev_r213r0201_footmark_a1_02')
	_JUMP('ev_r213r0201_footmark_a1_01')
	_JUMP('ev_r213r0201_footmark_03')
ev_r213r0201_footmark_kawaii_ashi_nashi:
	_POKE_LVUP_HOW_MANY(@SCWK_PARAM2, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 30, 'ev_r213r0201_footmark_a2_05')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 20, 'ev_r213r0201_footmark_a2_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 10, 'ev_r213r0201_footmark_a2_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 5, 'ev_r213r0201_footmark_a2_02')
