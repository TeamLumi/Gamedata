	_ACMD_END()
ev_r213_looker_event_part_1:
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 832, 'ev_r213_looker_event_func_22'); If the player is at 683, 832 when interacting with the Grunt
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 834, 'ev_r213_looker_event_func_23'); If the player is at 683, 834 when interacting with the Grunt
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 683, 'ev_r213_looker_event_func_20'); If the player is at 683, 833 when interacting with the Grunt
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 684, 'ev_r213_looker_event_func_21'); If the player is at 684, 833 when interacting with the Grunt
	_JUMP('ev_r213_looker_event_galactic_numpad_pos_9'); If the player is at 685, 833 when interacting with the Grunt
ev_r213_looker_event_part_2:
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 832, 'ev_r213_looker_event_func_26'); If the player is at 683, 832 when interacting with the Grunt
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 834, 'ev_r213_looker_event_func_27'); If the player is at 683, 834 when interacting with the Grunt
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 683, 'ev_r213_looker_event_func_24'); If the player is at 683, 833 when interacting with the Grunt
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 684, 'ev_r213_looker_event_func_25'); If the player is at 684, 833 when interacting with the Grunt
	_JUMP('ev_r213_looker_event_func_25'); If the player is at 685, 833 when interacting with the Grunt
ev_r213_looker_event:
	_FLAG_RESET(#2839)
	_OBJ_ADD('R213_LOOKER')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_CALL('ev_r213_looker_event_part_1')
	_CHARA_LOOK_LOCK('R213_LOOKER', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'R213_LOOKER')
	_MACRO_TALK_KEYWAIT('dialogue_r213', '00_msg_r213_looker_event_4', 'Hello, my friend!\rThe cargo that the Team Galactic\nbrought is worrisome, so I have come.\r...You say the cargo, it was a bomb?\nAnd there was an explosion?\fThe explosion was at the Great Marsh?\rFurthermore, you are pursuing a man...\nA man with funny bowl-cut hair.\fIn an outfit that is very strange?\rIn other words, that is the Team\nGalactic!')
	_CHARA_LOOK_RELEASE('R213_LOOKER')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('R213_LOOKER', 'anm_r213_action_9')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_r213', '00_msg_r213_looker_event_5', 'Oh, no, no, no!\nHow did I miss it?\rAh, Looker, this time you have made a\nmistake of the ages!\rThe man, who I have seen running away,\nhe was the bearer of the bomb!')
	_MACRO_TALK_KEYWAIT('dialogue_r213', '00_msg_r213_looker_event_6', 'Ach! This will not do!\nWait! Wait, I say!')
	_TALK_CLOSE()
	_CALL('ev_r213_looker_event_part_2')
	_FLAG_SET(#2839)
	_OBJ_DEL('R213_LOOKER')
	_FLAG_RESET(#2840); Enable next Looker
	_FLAG_SET(#2753); Enable next Looker event
	_RET()
