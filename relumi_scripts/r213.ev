pos_r213_gingam_stop_data:
	_EVENT_START()
	_JUMP('ev_r213_gingam')
ev_r213_gingam_talk_start:
	_TALK_OBJ_START()
	_JUMP('ev_r213_gingam')
ev_r213_gingam:
	_CALL('ev_another_out')
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_gingam_01', 'We needed the energy from the Valley\nWindworks to make this...\rIt would take a scientific genius to make\nsomething like this...\rTherefore, our boss, who made this, is\na scientific genius!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('HERO', 'R213_GINGAM')
	_CHARA_LOOK_LOCK('R213_GINGAM', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('R213_GINGAM')
	_OBJ_ANIME('R213_GINGAM', 'anm_r213_gingam_01')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(436)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_gingam_02', 'Graw! You were eavesdropping! I was just\nthinking out loud!\rYou’re a persistent pest... I’m getting tired of\nrunning away...\rBut I’m not going to waste my energy knocking\nyou around...')
	_TALK_CLOSE()
	_GET_REL_POS_HERO('R213_GINGAM', @SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 8, 'ev_r213_gingam_dir_d')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'ev_r213_gingam_dir_right')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_r213_gingam_dir_lu')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 9, 'ev_r213_gingam_dir_ru')
	_JUMP('ev_r213_gingam_dir_right')
	_END()
ev_r213_gingam_dir_d:
	_OBJ_ANIME('R213_GINGAM', 'anm_r213_gingam_02')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_r213_gingam_dir_common')
	_END()
ev_r213_gingam_dir_lu:
	_OBJ_ANIME('R213_GINGAM', 'anm_r213_gingam_03')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_r213_gingam_dir_common')
	_END()
