ev_r213_woman2:
	_MACRO_EASY_OBJ_MSG('dialogue_r213', '144-msg_r213_woman2_01', 'I’d rather be in a pool than the sea.\rThe salty tang of the sea tastes like my tears\nafter a hard day at work...')
	_END()
ev_r213_bigman:
	_MACRO_EASY_OBJ_MSG('dialogue_r213', '144-msg_r213_bigman_01', 'There’s something on top of this big cliff here!\rMy instincts tell me that, but how am I supposed\nto climb up?')
	_END()
ev_r213_fishing1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_fishing_01', 'There’s a fancy hotel in a fancy place with a\nfancy restaurant.\rThe fancy restaurant’s filled with fancy people\nwho think of themselves as being too fancy to\fbattle alone.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_sign1:
	_EASY_BOARD_MSG('dialogue_r213%144-msg_r213_sign1_01', 'BOARD_TYPE_ROAD', 0, 2)
	_END()
ev_r213_sign2:
	_EASY_BOARD_MSG('dialogue_r213%144-msg_r213_sign2_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_r213_sign3:
	_EASY_BOARD_MSG('dialogue_r213%144-msg_r213_sign2_02', 'BOARD_TYPE_POST', 0)
	_END()
ev_r213_gorggeousm_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_R213_GORGGEOUSM_TALK01, 'ev_r213_gorggeousm_talk01')
	_IF_FLAGON_JUMP(#FE_R213_NAMINORI_CLEAR, 'ev_r213_gorggeousm_iro_01_seen02')
	_JUMP('ev_r213_gorggeousm_talk01')
ev_r213_gorggeousm_talk01:
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_gorggeousm_iro_01', 'I stand stoically in front of the deep blue sea.\nWhy? Because I’m a rich boy.\rThe seaside suits me better than the sea.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FE_R213_GORGGEOUSM_TALK01)
	_END()
ev_r213_gorggeousm_iro_01_seen02:
	_IF_FLAGON_JUMP(#FE_R213_SEAL_GET6, 'ev_r213_gorggeousm_iro_01_seen03')
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_gorggeousm_iro_02', 'I saw you surfing courageously over the water.\nThe sight of your elegance was inspiring.\rPlease take these as a token of my appreciation.')
	_LDVAL(@SCWK_TEMP0, 10)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R213_SEAL_GET6)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_gorggeousm_iro_01_seen03:
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_gorggeousm_iro_03', 'My Shellos and I will venture out to sea someday.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_morimoto:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#TMFLG_R213_POOL, 'ev_r213_morimoto3')
	_IF_FLAGOFF_JUMP($SYS_FLAG_GAME_CLEAR, 'ev_r213_morimoto10')
	_IF_FLAGON_JUMP(#FE_R213_POOL_TALKED, 'ev_r213_morimoto1_2')
	_JUMP('ev_r213_morimoto1_1')
	_END()
ev_r213_morimoto1_1:
	_TUREARUKI_POKE_DELETE(1)
	_MACRO_TALKMSG('dialogue_r213', '114-msg_l02_morimoto_02', 'Well, blow me over! You beat the Champion?\nNow, that’s something worth writing home about!\rThe name’s Morimoto. I’ve been waiting for a\nstrong Trainer like you to come find me.\rIf you’ve got faith in your own skill, care to join\nme in a match?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213_morimoto_b')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r213_morimoto2')
	_END()
ev_r213_morimoto1_2:
	_TUREARUKI_POKE_DELETE(1)
	_TALKMSG('dialogue_r213%114-msg_l02_morimoto_03')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r213_morimoto_b')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r213_morimoto2')
	_END()
ev_r213_morimoto_b:
	_MACRO_TALKMSG('dialogue_r213', '114-msg_l02_morimoto_04-01', 'That’s the ticket!\rNow watch out! Because Morimoto’s got more\nthan enough to motor right over you!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP3, 706); Formerly MORIMOTO_01
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGOFF_CALL(#FE_R213_POOL_TALKED, 'ev_r213_morimoto_get')
	_FLAG_SET(#FE_R213_POOL_TALKED)
	_FLAG_SET(#TMFLG_R213_POOL)
	_JUMP('ev_r213_morimoto3')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_morimoto2:
	_MACRO_TALKMSG('dialogue_r213', '114-msg_l02_morimoto_04-02', 'Is that so? Well, that’s a right shame.')
	_TALK_CLOSE()
	_TUREARUKI_POKE_CREATE()
	_TALK_OBJ_END()
	_END()
ev_r213_morimoto3:
	_MACRO_TALKMSG('dialogue_r213', '114-msg_l02_morimoto_06', 'Let’s have ourselves a rematch someday!')
	_TALK_CLOSE()
	_TUREARUKI_POKE_CREATE()
	_TALK_OBJ_END()
	_END()
ev_r213_morimoto10:
	_MACRO_TALKMSG('dialogue_r213', '114-msg_l02_morimoto_01', 'Come on back here after you’ve defeated\nthe Champion.\rDon’t forget about me here, OK?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_morimoto_get:
	_MACRO_TALKMSG('dialogue_r213', '114-msg_l02_morimoto_05', 'You’re really strong! I should’ve known!\rSince you’ve managed to trounce me, I guess\nyou’ve earned yourself a reward.')
	_LDVAL(@SCWK_TEMP0, 631)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_RET()
