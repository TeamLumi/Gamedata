ev_r213_suicune:
	_TALK_OBJ_START()
	_VOICE_PLAY(245, 0, 0)
	_MACRO_TALK_KEYWAIT('dlp_rotom_message', 'msg_r213_suicune_cry', 'Gyaoo!')
	_TALK_CLOSE()
	_VOICE_WAIT()
	_SET_SYS_FLAG($SYS_FLAG_BTL_RETURN_CALL_SP)
	_SET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_SP_WILD_BTL_SET(245, 60)
	_RESET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_RESET_SYS_FLAG($SYS_FLAG_BTL_RETURN_CALL_SP)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 245)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_r213_suicune_capture')
	_TALK_OBJ_END()
	_END()
ev_r213_suicune_capture:
	_OBJ_DEL('R213_SUICUNE')
	_FLAG_SET(#2805) ; Suicune Caught
	_TALK_OBJ_END()
	_END()
ev_r213_fisherman_script_16:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_r213', '00_msg_r213_fisherman_20', 'Oh, no! My fishing line broke!\nIs this the work of an enemy Palossand?!\rAh, no, never mind.\nPalossand aren’t in Sinnoh...')
	_TALK_CLOSE()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('R213_FISHING', 'HERO')
	_MACRO_TALKMSG('dialogue_r213', '00_msg_r213_fisherman_21', '...\rWhat’s your problem?\nGive me a break.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R213_FISHING')
	_OBJ_ANIME('R213_FISHING', 'anm_r213_action_2')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
