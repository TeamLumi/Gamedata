	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7200)
	_CALL('ev_r213_looker_event')
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(437)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
