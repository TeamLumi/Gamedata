	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_R213_SEAL_GET4, 'ev_r213_swimmerw2_iro_02')
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_swimmerw2_iro_01', 'Check this out! A synchronized crawl with\nmy Floatzel!\rPowerful, isn’t it? As thanks for watching\nus swim, take these.')
	_LDVAL(@SCWK_TEMP0, 2)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R213_SEAL_GET4)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_swimmerw2_iro_02:
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_swimmerw2_iro_02', 'See how heartily it moves its arms?\nSo powerful...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_swimmerw3_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_R213_SEAL_GET3, 'ev_r213_swimmerw3_iro_02')
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_swimmerw3_iro_01', 'Get out of my way! I’ll give these to you\nin return.')
	_LDVAL(@SCWK_TEMP0, 14)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R213_SEAL_GET3)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_swimmerw3_iro_02:
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_swimmerw3_iro_02', 'We’re competing to see who can keep swimming\nthe longest!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_swimmerm_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#1269, 'ev_r213_swimmerm_iro_02')
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_swimmerm_iro_01', 'Whroooar! I’m in the middle of something here!\nYou can have these if you stay away.')
	_LDVAL(@SCWK_TEMP0, 16)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R213_SEAL_GET2)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_swimmerm_iro_02:
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_swimmerm_iro_02', 'We’re competing to see who can swim faster!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_ukiwaw_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_R213_SEAL_GET1, 'ev_r213_ukiwaw_iro_02')
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_ukiwaw_iro_01', 'Hehehe. Welcome to my private beach!\nThis place is wonderful, isn’t it?\rI’ll give this to you as a token of our friendship.')
	_LDVAL(@SCWK_TEMP0, 34)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_R213_SEAL_GET1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213_ukiwaw_iro_02:
	_MACRO_TALKMSG('dialogue_r213', '144-msg_r213_ukiwaw_iro_02', 'Don’t go telling anyone else about this place.\nIt’ll be our little secret.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
