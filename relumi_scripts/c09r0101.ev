ev_c09r0101_atamo:
	_EASY_VOICE_MSG('dialogue_c09r0101%161-msg_C09R0101_achamo', 'PLAY_PV_EV_255_00_00')
	_END()
ev_c09r0101_shopkeeper:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c09r0101', '00_msg_c09r0101_trader', 'Hi, I’m Mindy! I sell rare items that can\nevolve Pokémon. See any you like?')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c09r0101_fix_shop_re')
	_END()
ev_c09r0101_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c09r0101_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c09r0101_fix_shop_buy')
	_CASE_JUMP(1, 'ev_c09r0101_fix_shop_end')
	_JUMP('ev_c09r0101_fix_shop_end')
	_END()
ev_c09r0101_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c09r0101', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c09r0101_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(14)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c04r0501_fix_shop_re')
	_END()
ev_c09r0101_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()

ev_c09r0101_punch_trade:
    _TALK_OBJ_START()
    _CALL('ev_c09r0101_punch_trade_values')
    _IF_FLAGON_JUMP(#3080, 'ev_c09r0101_punch_trade_over')
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_punch_trade_1', 'Hey, guy! The stoic look on your face tells me\nyou’re just the kind of trainer I was looking for!\rSee, the thing is, I’ve been on the hunt for\nan {0,1,1,0}.')
    _TALK_CLOSE()
    _POKE_WINDOW_PUT(@LOCALWORK0, @LOCALWORK1)
    _POKEMON_NAME_FORM(1, @LOCALWORK2, @LOCALWORK3)
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_punch_trade_2', 'This {1,1,1,0} is cute, but it just isn’t cutting\nit.\rAnd since you look all cool and mighty, I bet\nthere’s already one sitting pretty in your\farsenal.\rSo what do you say?\nWill you indulge me with a trade?')
    _YES_NO_WIN(@SCWK_ANSWER)
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c09r0101_punch_trade_yes')
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c09r0101_punch_trade_no')
ev_c09r0101_punch_trade_values:
    _LDVAL(@LOCALWORK0, 224); Given trade MonsNo
    _LDVAL(@LOCALWORK1, 0); Given trade FormNo
    _LDVAL(@LOCALWORK2, 852); Received trade MonsNo
    _LDVAL(@LOCALWORK3, 0); Received trade FormNo
    _RET()
ev_c09r0101_punch_trade_yes:
    _TALK_CLOSE()
    _POKELIST_SET_PROC(37)
    _POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
    _IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_c09r0101_punch_trade_no'); If nothing was selected
    _TEMOTI_BOX_MONSNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
    _TEMOTI_BOX_FORMNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2)
    _IFVAL_JUMP(@SCWK_ANSWER, 'NE', @LOCALWORK0, 'ev_c09r0101_punch_trade_wrong_mon'); If a species other than the target was selected
    _IFVAL_JUMP(@SCWK_TEMP2, 'NE', @LOCALWORK1, 'ev_c09r0101_punch_trade_wrong_form'); If an incorrect form of the correct species was selected
    _TEMOTI_BOX_SHINY(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2)
    _TEMOTI_BOX_GENDER(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP3)
    _TALK_CLOSE()
    _LOCALKOUKAN_APPLY(10, @SCWK_TEMP1, @SCWK_TEMP0)
	_SXY_POS_CHANGE('HERO', 3, 4)
	_SXY_DIR_CHANGE('HERO', 180)
	_SXY_DIR_CHANGE('C09R0101_PUNCH', 0)
    _IFVAL_CALL(@SCWK_TEMP2, 'EQ', 0, 'ev_c09r0101_punch_trade_placedata')
    _IFVAL_CALL(@SCWK_TEMP2, 'GE', 1, 'ev_c09r0101_punch_trade_placedata_shiny')
	_CALL('ev_c09r0101_octillery_cry')
    _JUMP('ev_c09r0101_punch_trade_over')
ev_c09r0101_punch_trade_no:
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_punch_trade_no', 'No, no, I get it. You want to keep your prized\npossession to yourself.\rOr maybe you just haven’t found one yet...?\rRegardless, I’ll be here, awaiting an awesome\ntrainer’s generosity...')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c09r0101_punch_trade_wrong_mon:
    _POKEMON_NAME_FORM(0, @LOCALWORK0, @LOCALWORK1)
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_punch_trade_wrong_mon', 'Hey, what the- what are you trying to pull?!\nAre you asleep?!\rGet back to me when you have an {0,1,1,0},\nand maybe you’ll still be cool in my eyes...\fMAYBE.')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c09r0101_punch_trade_wrong_form:
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_punch_trade_wrong_form', 'Nice, thanks! I couldn’t have done it witho-\rHey, wait a minute!\nThis isn’t the form I was looking for!\fIt’s cool and all, but I need the other!\rI’ll be here waiting on you to return with the\nother form, cool guy!')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c09r0101_punch_trade_placedata:
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 0, 'ev_c09r0101_punch_trade_placedata_male')
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 1, 'ev_c09r0101_punch_trade_placedata_female')
	_RET()
ev_c09r0101_punch_trade_placedata_male:
    _OBJ_ADD('C09R0101_OCTILLERY_MALE')
    _FLAG_RESET(#2961)
    _RET()
ev_c09r0101_punch_trade_placedata_female:
    _OBJ_ADD('C09R0101_OCTILLERY_FEMALE')
    _FLAG_RESET(#2962)
    _RET()
ev_c09r0101_punch_trade_placedata_shiny:
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 0, 'ev_c09r0101_punch_trade_placedata_shiny_male')
	_IFVAL_JUMP(@SCWK_TEMP3, 'EQ', 1, 'ev_c09r0101_punch_trade_placedata_shiny_female')
ev_c09r0101_punch_trade_placedata_shiny_male:
    _OBJ_ADD('C09R0101_OCTILLERY_SHINY_MALE')
    _FLAG_RESET(#2963)
    _RET()
ev_c09r0101_punch_trade_placedata_shiny_female:
    _OBJ_ADD('C09R0101_OCTILLERY_SHINY_FEMALE')
    _FLAG_RESET(#2964)
    _RET()
ev_c09r0101_punch_trade_over:
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_punch_trade_over', 'Aw, sweet! This is all I have ever wanted!\nWe’re gonna do some real damage now!\rThanks, guy!')
    _FLAG_SET(#3080)
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c09r0101_octillery:
	_TALK_OBJ_START()
    _CALL('ev_c09r0101_punch_trade_values')
	_CALL('ev_c09r0101_octillery_cry')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c09r0101_octillery_cry:
    _VOICE_PLAY(@LOCALWORK0, @LOCALWORK1, 0)
    _MACRO_TALKMSG('dialogue_c09r0101', 'msg_c09r0101_octillery_cry', 'Bobobo-Bobo!!')
    _VOICE_WAIT()
	_RET()