ev_c07gym0101_flag_change:
	_SET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_INIT_COMBAT_GYM()
	_END()
ev_c07gym0101_gym_first:
	_EVENT_START()
	_CALL('ev_block_doc')
	_IFVAL_JUMP(@WK_SCENE_C07GYM0101, 'NE', 0, 'ev_c07gym0101_gym_first_end')
	_EVENT_CAMERA_INDEX(73)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c07gym0101_gym_first01')
	_END()
ev_c07gym0101_gym_first01:
	_EVENT_CAMERA_INDEX(23)
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@WK_SCENE_C07GYM0101, 1)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_c07gym0101_gym_first_end:
	_CALL('ev_block_doc_end')
	_END()
ev_c07gym0101_randomteam_maylene:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 835)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 836)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 837)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 838)
	_RET()
ev_c07gym0101_randomteam_maylene_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 903)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 904)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 905)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 906)
	_RET()
ev_c07gym0101_leader:
	_PLAYER_NAME(0)
	_SYS_FLAG_BADGE_GET($BADGE_ID_C07, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07gym0101_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 12, 1, 5.070000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(74)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_OBJ_ANIME('C07GYM0101_LEADER', 'anm_c07gym0101_leader_01_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_01_1', 'Hello, I’m pleased to meet you.\rI’m Maylene, and I’m the Gym Leader.')
	_OBJ_ANIME('C07GYM0101_LEADER', 'anm_c07gym0101_leader_01_face03')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_01_2', 'I don’t really know what it means to be strong or\nhow I got to be the Gym Leader.')
	_OBJ_ANIME('C07GYM0101_LEADER', 'anm_c07gym0101_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07GYM0101_LEADER', 1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C07GYM0101_LEADER', 0)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_01_3', 'But I will do the best I can as the Gym Leader.\rI take battling very seriously.\nWhenever you’re ready!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(75)
	_BTL_ENCSEQ_LOAD('gym03')
	_LDVAL(@WK_PLAY_REPO_NO, 6)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c07gym0101_randomteam_maylene')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_02', 'OK, you win.\rThat was a tough loss. I learned a lot from it.\rPlease, accept this Gym Badge.')
	_TALK_CLOSE()
	_BADGE_GET(2)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_03', 'You received the Cobble Badge from Maylene.')
	_ME_WAIT()
	_SET_SYS_FLAG($SYS_HUSIGINAOKURIMONO_OPEN_FLAG)
	_SYS_FLAG_BADGE_SET($BADGE_ID_C07)
	_TRAINER_FLAG_SET('KARATE_11')
	_TRAINER_FLAG_SET('KARATE_12')
	_TRAINER_FLAG_SET('KARATE_13')
	_TRAINER_FLAG_SET('KARATE_14')
	_FLAG_RESET(#FV_C07_SUPPORT)
	_LDVAL(@WK_SCENE_C07, 1)
	_LDVAL(@WK_SCENE_C07_SUPPORT_GYM_AFTER, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6500)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_04', 'Um... I should explain about that Badge.\rIf you have that official Pokémon League Badge,\nyou can use the hidden move Fly from\fyour Pokétch.\rOh, and please take these as well.')
	_CB_ITEM_NUM_ADD(41, 2)
	_CB_ITEM_NUM_ADD(42, 2)
	_CB_ITEM_NUM_ADD(13, 2)
	_CB_ITEM_NUM_ADD(15, 2)
	_CB_ITEM_NUM_ADD(36, 2)
	_CB_ITEM_NUM_ADD(73, 1)
	_SE_PLAY('M_FI014')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER4_01')
	_MACRO_TALKMSG('dialogue_c07gym0101', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c07gym0101_leader_item_get')
	_END()
anm_c07gym0101_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c07gym0101_leader_01_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
anm_c07gym0101_leader_01_face03:
	_AC_FACE_INDEX(3)
	_ACMD_END()
ev_c07gym0101_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 387)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07gym0101_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C07_GYM_ITEM_GET)
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_ITEM_WAZA_NAME(1, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_05', '{0,1,9,0} contains the move\n{1,1,7,0}.\rUm... That move inflicts damage, and it robs the\ntarget’s HP.', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c07gym0101_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c07gym0101_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C07_GYM_ITEM_GET, 'ev_c07gym0101_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c07gym0101_leader_return_match')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_06_1', 'Gee, I’m hungry...\rOh, sorry, it’s nothing. I didn’t say anything.')
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_06_2', '{0,1,0,0}, I can’t explain what it means\nto be strong, or how much effort goes into it...')
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_06_3', 'But being with Pokémon lets us keep making the\neffort, doesn’t it?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07gym0101_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C07_GYM_RETRUN_MATCH_FIRST, 'pos_c07gym0101_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C07_GYM_RETRUN_MATCH, 'pos_c07gym0101_leader_return_match_won')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_07_01', '{0,1,0,0}, I’ve been waiting for you.\rI hear you’ve defeated Cynthia and entered the\nHall of Fame. I truly respect you for that.\rBut I haven’t been idle all this time.\rI’ve come to challenge you now, and I won’t hold\nanything back. Please prepare yourself for battle!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym03')
	_LDVAL(@WK_PLAY_REPO_NO, 28)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c07gym0101_randomteam_maylene_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_07_02', 'I see... I’ve lost again.\r{0,1,0,0}, you truly live up to\nyour reputation.\rI trained as best I could to become stronger, but\nit seems you’ve reached even loftier heights.\rThere is still so much to learn about what\nstrength truly is.', 0, 1)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_07_03', 'It’s not much, but please accept this token of\nmy gratitude.')
	_LDVAL(@SCWK_TEMP0, 60)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C07_GYM_RETRUN_MATCH_FIRST)
	_FLAG_SET(#TMFLG_C07_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c07gym0101_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C07_GYM_RETRUN_MATCH, 'pos_c07gym0101_leader_return_match_won')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_08_01', '{0,1,0,0}, I’ve been waiting for you.\rToday, as always, I’ll be going all out—so please\nprepare yourself for battle!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym03')
	_LDVAL(@WK_PLAY_REPO_NO, 28)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c07gym0101_randomteam_maylene_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_08_02', 'I see... I’ve lost again.\r{0,1,0,0}, you truly live up to\nyour reputation.\rThere is still so much to learn about what\nstrength truly is.', 0, 1)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_07_03', 'It’s not much, but please accept this token of\nmy gratitude.')
	_LDVAL(@SCWK_TEMP0, 60)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C07_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c07gym0101_leader_return_match_won:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_leader_07_04', 'When I’m battling you, {0,1,0,0}, I feel\nas though I’m drawing closer to the true meaning\fof strength.\rPlease come back tomorrow and battle with\nme again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07gym0101_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c07gym0101_advice:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C07, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07gym0101_advice_02')
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_sunglasses_01_1', 'Hey there!\rHow’s it going, Champ-to-be?\rThe Gym Leader uses Fighting-type Pokémon.\rShe’s always training, so she’s taught her Pokémon\nhow to pick themselves back up better\fthan before if they fumble a move.')
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_sunglasses_01_2', 'She’s especially focused on her favorite Pokémon,\nmaking sure it’s perfect!\rAnd when the chips are down, they eat their\nberries and get a bigger boost than usual back!\rIs that the power of protein shakes?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07gym0101_advice_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_sunglasses_02', 'Oh! {0,1,0,0}!\nYou’ve beaten the Gym Leader!\rOf course, I thought you’d win.', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07gym0101_statue:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C07, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07gym0101_statue_02')
	_RIVAL_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_statue_01', 'Veilstone City Pokémon Gym\nGym Leader: Maylene\fCertified Trainers: {1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c07gym0101_statue_02:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_RIVAL_NAME(2)
	_MACRO_TALKMSG('dialogue_c07gym0101', '91-msg_c07gym0101_statue_02', 'Veilstone City Pokémon Gym\nGym Leader: Maylene\rCertified Trainers: {0,1,0,0}\n{1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c07gym0101_athletic_a1:
	_EVENT_START()
	_MOVE_COMBAT_GYM_WALL()
	_TALK_END()
	_END()