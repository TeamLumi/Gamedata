ev_t05r0201_woman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_woman1_01', 'Oh, hello!\nIt’s been a while since our last customer!')
	_CALL('ev_shop_start_talk')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05r0201_shop:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_t05r0201_shop_re')
	_END()
ev_t05r0201_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_t05r0201_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_t05r0201_shop_buy')
	_CASE_JUMP(1, 'ev_t05r0201_shop_sell')
	_CASE_JUMP(2, 'ev_t05r0201_shop_end')
	_JUMP('ev_t05r0201_shop_end')
	_END()
ev_t05r0201_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_t05r0201', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_t05r0201_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_DPR_SHOP_OPEN('T05R0201')
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_t05r0201_shop_re')
	_END()
ev_t05r0201_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_t05r0201_shop_re')
	_END()
ev_t05r0201_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05r0201_fix_shop:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_t05r0201_fix_shop_re')
	_END()
ev_t05r0201_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_t05r0201_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_t05r0201_fix_shop_buy')
	_CASE_JUMP(1, 'ev_t05r0201_fix_shop_sell')
	_CASE_JUMP(2, 'ev_t05r0201_fix_shop_end')
	_JUMP('ev_t05r0201_fix_shop_end')
	_END()
ev_t05r0201_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_t05r0201', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_t05r0201_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(1)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_t05r0201_fix_shop_re')
	_END()
ev_t05r0201_fix_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_t05r0201_fix_shop_re')
	_END()
ev_t05r0201_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05r0201_glasses:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_01', 'Putting on a pair of glasses changes how the\nworld looks.\rTaking off a pair of glasses changes how the\nworld looks, too. Deep, man.')
	_GET_NOW_HOUR(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 4, 'ev_t05r0201_megane_03_check')
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 10, 'ev_t05r0201_megane_01_check')
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 20, 'ev_t05r0201_megane_02_check')
	_JUMP('ev_t05r0201_megane_03_check')
	_JUMP('ev_t05r0201_glasses_06')
ev_t05r0201_megane_01_check:
	_IF_FLAGON_JUMP(#FE_T05R0201_MEGANE_01_GET, 'ev_t05r0201_glasses_06')
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_02', 'So, would you like to change how the world\nlooks to your Pokémon?')
	_LDVAL(@SCWK_TEMP0, 267)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05r0201_glasses_09')
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 297)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05r0201_glasses_09')
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 240)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05r0201_glasses_09')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_T05R0201_MEGANE_01_GET)
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_03', 'Morning is the start of a new day.\rPut on Choice Specs and make the\nright choices.')
	_JUMP('ev_t05r0201_glasses_06')
	_JUMP('ev_t05r0201_glasses_06')
ev_t05r0201_megane_02_check:
	_IF_FLAGON_JUMP(#FE_T05R0201_MEGANE_02_GET, 'ev_t05r0201_glasses_07')
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_02', 'So, would you like to change how the world\nlooks to your Pokémon?')
	_LDVAL(@SCWK_TEMP0, 240)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05r0201_glasses_09')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_T05R0201_MEGANE_02_GET)
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_04', 'The sunlight is bright in the daytime. How about\na pair of Black Glasses?')
	_JUMP('ev_t05r0201_glasses_07')
	_JUMP('ev_t05r0201_glasses_06')
ev_t05r0201_megane_03_check:
	_IF_FLAGON_JUMP(#FE_T05R0201_MEGANE_03_GET, 'ev_t05r0201_glasses_08')
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_02', 'So, would you like to change how the world\nlooks to your Pokémon?')
	_LDVAL(@SCWK_TEMP0, 267)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t05r0201_glasses_09')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_T05R0201_MEGANE_03_GET)
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_05', 'At night, reflect on what you’ve learned with\nWise Glasses.')
	_JUMP('ev_t05r0201_glasses_08')
	_JUMP('ev_t05r0201_glasses_06')
ev_t05r0201_glasses_06:
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_06', 'Choice Specs make the Pokémon use only one\nkind of move. But they also raise the Pokémon’s\fSp. Atk stat.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05r0201_glasses_07:
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_07', 'Black Glasses raise the power of\nDark-type moves.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05r0201_glasses_08:
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_08', 'Wise Glasses boost the power of special moves.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t05r0201_glasses_09:
	_MACRO_TALKMSG('dialogue_t05r0201', '157-msg_t05r0201_glasses_09', 'Your Bag is full!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()