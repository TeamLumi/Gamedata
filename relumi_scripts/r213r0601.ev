ev_r213r0601_gorggeousm:
	_TALK_OBJ_START()
	_JUMP('ev_r213r0601_gorggeousm_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'ev_r213r0601_gorggeousm_02')
	_MACRO_TALKMSG('dialogue_r213r0601', '150-msg_r213r0601_gorggeousm_01_1', 'The reservations were full up, but they managed\nto get us in here.\rWe’re finally alone, the two of us—if you’d leave,\nthat is.')
	_MACRO_TALKMSG('dialogue_r213r0601', '150-msg_r213r0601_gorggeousm_01_2', 'This is something we don’t need anymore.\nWill you take it?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0601_gorggeousm_02:
	_MACRO_TALKMSG('dialogue_r213r0601', '150-msg_r213r0601_gorggeousm_02', 'I’ve always relied on the old Coin Toss app to\nmake any decision.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0601_gorggeousw:
	_TALK_OBJ_START()
	_JUMP('ev_r213r0601_gorggeousw_02')
	_JUMP('ev_r213r0601_gorggeousw_02')
ev_r213r0601_gorggeousw_01:
	_MACRO_TALKMSG('dialogue_r213r0601', '150-msg_r213r0601_gorggeousw_01', 'That Coin Toss app is why we ended up in this\nmusty, old, and stinky suite...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0601_gorggeousw_02:
	_MACRO_TALKMSG('dialogue_r213r0601', '150-msg_r213r0601_gorggeousw_02', 'We wanted to be together alone so we could\ntalk without being disturbed.\rWe really need this time together...\nJust the two of us...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r213r0601_drop_item_58:
	_IF_FLAGON_JUMP(#FT_DROP_ITEM_58, 'ev_trash_box')
	_IF_FLAGOFF_JUMP(#FT_DROP_ITEM_58, 'ev_hide_item_58')
	_END()