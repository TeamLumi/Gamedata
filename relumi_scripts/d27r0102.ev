ev_d27r0102_flag_change:
	_IF_FLAGON_CALL(#FE_D27R0102_GKANBU_WIN, 'ev_d27r0102_flag_change_pos3')
	_IF_FLAGOFF_CALL(#FE_D27R0102_GKANBU_WIN, 'ev_d27r0102_flag_change_pos2')
