ev_d27r0102_gkanbu:
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_CALL('ev_another_out')
	_OBJ_POS_CHANGE_WORLD('HERO', 55, 0, 39.500000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(277)
	_CHARA_LOOK_LOCK('D27R0102_SUPPORT', 'HERO')
	_CHARA_LOOK_LOCK('D27R0102_GKANBU', 'HERO')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('D27R0102_GKANBU', 'anm_d27r0102_gkanbu_face05')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_OBJ_ANIME('D27R0102_GKANBU', 'anm_d27r0102_gkanbu_face00')
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('D27R0102_GKANBU', 1)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D27R0102_GKANBU', 0)
	_OBJ_ANIME('D27R0102_GKANBU', 'anm_d27r0102_gkanbu_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_01_1', 'That face... It brings back bad memories!\rI’m talking about the Valley Windworks! I caught\na whole lot of trouble for that little incident.')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('D27R0102_GKANBU', 'anm_d27r0102_gkanbu_face02')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_01_2', 'What’s with that look on your face? You do\nremember me, don’t you?\rFine, whatever. I’ll tell you who I am again!', 1)
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('D27R0102_GKANBU', 'anm_d27r0102_gkanbu_face04')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_01_3', 'I’m Mars, one of Team Galactic’s Commanders.', 1)
	_OBJ_ANIME('D27R0102_GKANBU', 'anm_d27r0102_gkanbu_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_01_4', 'How cute! You two think you can save the day\nin your little game of hero?\rNot a chance! Not even a teeny one!\nYou’re all going down!', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('D27R0102_SUPPORT')
	_CHARA_LOOK_RELEASE('D27R0102_GKANBU')
	_EVENT_CAMERA_INDEX(278)
	_LDVAL(@WK_PLAY_REPO_NO, 13)
	_FLAG_SET(#FE_PLAY_REPO)
	_LDVAL(@SCWK_TEMP3, 881)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_02_1', 'I lost again...\rSo, first it was the Valley Windworks, and now it’s\nLake Verity that I owe you for! This shouldn’t be\fhappening to a Team Galactic Commander...')
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_02_2', 'Calm down, Mars...\rI’ve done my part in all of this. My mission was to\ntransport the lake’s Pokémon to our HQ...', 1)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_02_3', 'That’s right! I accomplished my mission without\na problem!', 1)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_03', 'Team! We’re pulling out! The boss is waiting at\nthe HQ!')
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_04_1', 'The Pokémon of the three lakes are\nconnected somehow.\rThanks to Saturn’s grandstanding at Lake Valor,\na cavern appeared here. It was the cavern where\fthe Pokémon Mesprit slept.')
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_04_2', 'Mesprit appeared, too, probably to go help\nits friends.\rThat worked out well for us. It was super easy\nto catch.', 1)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_gkanbu_04_3', 'So, now we’ve got them all:\nMesprit, the Being of Emotion.\fAzelf, the Being of Willpower.\fUxie, the Being of Intelligence.\rNow that we have all three, you can look forward\nto what Team Galactic has in store for them!', 1)
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_OBJ_DEL('D27R0102_GKANBU')
	_OBJ_DEL('D27R0102_GINGAM')
	_OBJ_DEL('TR_GINGAM_14')
	_OBJ_DEL('TR_GINGAM_15')
	_OBJ_DEL('TR_GINGAW_06')
	_OBJ_DEL('TR_GINGAW_07')
	_SET_SYS_FLAG($SYS_FLAG_BGM_D27)
	_SXY_POS_CHANGE('D27R0102_DOCTOR', 53, 39)
	_OBJ_DIR_CHANGE('D27R0102_DOCTOR', 3)
	_OBJ_ANIME('D27R0102_SUPPORT', 'anm_d27r0102_support_110')
	_OBJ_ANIME('HERO', 'anm_d27r0102_player_110')
	_OBJ_ANIME('D27R0102_DOCTOR', 'anm_d27r0102_doctor_0100')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_MOVE_CODE_CHANGE('D27R0102_SUPPORT', 'MV_DOWN')
	_FLAG_SET(#FE_D27R0102_GKANBU_WIN)
	_FLAG_RESET(#FV_D29R0102_GKANBU2)
	_FLAG_RESET(#FV_L03_GINGAM)
	_LDVAL(@441, 1) ; Enable StopData for the Darmanitan blocker in R216
	_FLAG_RESET(#2408) ; Enable second NPC at R216
	_LDVAL(@WK_SCENE_D29R0102, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 9300)
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_doctor_b_05_1', 'I see... This also occurred at Lake Valor...\rAnother Legendary Pokémon was taken away by\nTeam Galactic...')
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_doctor_b_05_2', 'Both of you went up against full-fledged\ncriminals—the fact that you’re unharmed\fis reason enough to celebrate.\r...But what about Lake Acuity?\nIs {0,1,0,0} safe?', 1, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
