	_END()
d27r0102_after_male_01:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_doctor_b_01', 'Ah, {0,1,0,0}! What timing!\rThose Team Galactic scoundrels are after the\nLegendary Pokémon! You’ve got to help Dawn!')
	_JUMP('common_d27r0102_doctor')
	_END()
d27r0102_after_female_01:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_doctor_b_02_1', 'Ah, {0,1,0,0}! What timing!\rThose Team Galactic scoundrels are after the\nLegendary Pokémon!')
	_MACRO_TALKMSG('dialogue_d27r0102', '84-msg_d27r0102_doctor_b_02_2', '{0,1,0,0}, hurry! You’ve got to\nhelp Lucas!', 1, 1)
	_JUMP('common_d27r0102_doctor')
	_END()
