	_SXY_MV_CHANGE('D27R0102_DOCTOR', 'MV_LEFT')
	_OBJ_DIR_CHANGE('D27R0102_DOCTOR', 90)
	_SXY_POS_CHANGE('D27R0102_SUPPORT', 50, 39)
	_SXY_MV_CHANGE('D27R0102_SUPPORT', 'MV_LEFT')
	_OBJ_DIR_CHANGE('D27R0102_SUPPORT', 90)
	_RET()
