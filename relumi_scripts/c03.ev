ev_c03_flag_change:
	_CALL('ev_box_close')
	_END()
ev_c03_rival:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C03_RIVAL_TALK, 'ev_c03_rival_talk')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_01_1', 'Hunh?\rOh, it’s you, {1,1,0,0}! You finally got\nhere? You’re slow like always.', 0, 1)
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_01_2', 'You’re so slow, the Gym Leader’s long gone now.\rHe said he had to go to... Uh... Oh yeah—\nto Oreburgh Mine!', 1)
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_01_3', 'I got my Badge already, so it’s no big deal to\nme, but...', 1)
	_FLAG_SET(#FE_C03_RIVAL_TALK)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_rival_talk:
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_02_1', 'I told you—the Gym Leader isn’t here.\rIf you want to challenge the Gym, you’d better\ngo down to the mine and ask him.')
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_02_2', 'But, wow, a Gym Leader is in a different class of\ntoughness. Even I’m feeling run down.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_boy2:
	_IFVAL_JUMP(@WK_SCENE_C03, 'EQ', 0, 'ev_c03_boy2_end')
	_TALK_OBJ_START()
	_IF_FLAGOFF_CALL(#2624, 'ev_c03_boy2_oval_stone')
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c03_boy2_badge_get')
	_IF_FLAGON_JUMP(#FE_D01R0102_LEADER_TALK, 'ev_c03_boy2_leader_talk')
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_boy2_03', 'Is that guy in front of the Gym your friend?\nHe’s sort of twitchy and impatient.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_boy2_oval_stone:
	_MACRO_TALKMSG('dialogue_c03', '00_msg_c03_boy_oval_stone', 'Howdy, Trainer!\nWelcome to Oreburgh City!\rI’ve got a super cool stone that was\nexcavated from Oreburgh Mine.\rTo celebrate your arrival, I’ll give it\nto you as a gift!')
	_LDVAL(@SCWK_TEMP0, 110); Oval Stone
	_LDVAL(@SCWK_TEMP1, 1); 1
	_CALL('ev_item_event')
	_FLAG_SET(#2624); Oval Stone event finished
	_RET()
ev_c03_boy2_badge_get:
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_boy2_05', 'Can I see your Trainer Case?\nThe Gym Badge you just won is in it, right?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_boy2_leader_talk:
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_boy2_04', 'Oh, hi—you’re back! The Gym Leader’s waiting\nfor you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_boy2_end:
	_END()
