ev_c03_mount:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '66-msg_c03_mount_01', 'Up ahead there’s a huge mountain that towers\nabove everything.\rIt divides Sinnoh into two distinct halves.')
	_END()
ev_c03_workman_a:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '66-msg_c03_workman_a_01', 'These vents exchange the hot air down below\nwith fresh air from outside.\rLooking down them gives me the urge to start\nyelling into ’em! Hello!')
	_END()
ev_c03_workman_b:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C03_ITEM_GET, 'ev_c03_workman_b_02')
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_workman_b_01', 'There’s no question that this is hard, hard work.\nBut working alongside Pokémon... It gives me a\fboost somehow. Here, take one of these.')
	_LDVAL(@SCWK_TEMP0, 26)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c03_workman_b_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C03_ITEM_GET)
	_JUMP('ev_c03_workman_b_02')
	_END()
ev_c03_workman_b_02:
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_workman_b_02', 'Feeling hale and hearty puts a smile on my face.\nAnd that makes me happy.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_workman_b_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_workman_c:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_workman_c_01_1', 'This pile of dirty sand is called a slag heap.')
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_workman_c_01_2', 'It’s the waste from sorting coal.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_workman_d:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '66-msg_c03_workman_d_01', 'Chop, chop, Machop!\nChop, chop away on rocks! ♪')
	_END()
