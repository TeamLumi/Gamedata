	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 749, 'pos_c03_rival_01_02')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 750, 'pos_c03_rival_01_03')
	_JUMP('pos_c03_rival_01_04')
	_END()
