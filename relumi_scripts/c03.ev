pos_c03_rival_01_common:
	_SE_PLAY('S_FI003')
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_03', '<size=250%>*thud*</size>')
	_TALK_CLOSE()
	_CALL('ev_the_rival_play')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_OPEN()
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_04', 'Whoops! {1,1,0,0}! You got the Gym\nBadge, huh?\rEterna City is the next place with a Gym that\ngives away Badges, right?', 0, 1)
	_TALK_CLOSE()
	_OBJ_ANIME('C03_RIVAL', 'anm_c03_rival_20')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_OPEN()
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_05', 'So, yeah, I went to Route 207, but you can’t\nget through that mess even with a bike.\rI made my team battle and toughened them\nup, so it wasn’t a waste.')
	_OBJ_ANIME('C03_RIVAL', 'anm_c03_rival_21')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_rival_06', 'So, I’m going back to Jubilife City. Next stop,\nthe Eterna Gym Badge!\rTen seconds before I dash!\rNine...\rBah! Who’s got time to count?!', 1)
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 748, 'pos_c03_rival_01_11')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 749, 'pos_c03_rival_01_12')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 750, 'pos_c03_rival_01_13')
	_JUMP('pos_c03_rival_01_14')
	_END()
