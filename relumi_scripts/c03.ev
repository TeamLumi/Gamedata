ev_c03_girl3:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_D01R0102_LEADER_TALK, 'ev_c03_girl3_02')
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_girl3_01', 'The Gym Leader went off to work in the mine.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_girl3_02:
	_MACRO_TALKMSG('dialogue_c03', '66-msg_c03_girl3_02', 'The Gym Leader is young, but he’s the safety\nsupervisor of the mine.\rHe’s an expert in more than just one field!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03_man2:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '66-msg_c03_man2_01', 'Have you seen the vents? They release steam\nfrom down below.')
	_END()
ev_c03_middlewoman:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '66-msg_c03_middlewoman_01', 'Everyone’s proud of the mine.\rThey’re digging for coal under the sea as we\nspeak... It’s amazing how they do it!')
	_END()
ev_c03_campboy:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '66-msg_c03_campboy_01', 'When I run around with my Running Shoes on,\nit feels like I’m the center of attention!')
	_END()
