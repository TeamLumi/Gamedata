ev_c03_clown_script_10:
	_MACRO_EASY_OBJ_MSG('dialogue_c03', '00_msg_c03_clown_script_10_01', 'Hey, Trainer! I see you’ve got a fancy new\nRotom Pokétch on you!\rDid you know you can use the new second\nbutton to go BACK through the apps?\rOr even the Left Stick?\r...You did?\rOh. You’re pretty ahead of the times, kid.')
	_END()