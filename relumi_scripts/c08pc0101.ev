ev_c08pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c08pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_c08pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08pc0101_flag_change_del_stopper')
	_END()
ev_c08pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_c08pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_c08pc0101_oldman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c08pc0101', '0-msg_c08pc0101_oldman2_01', 'I once dreamed of becoming a Gym Leader...\rThough that dream never came true, I got to live\nwith Pokémon all this time.\rIt’s been a blessed life.')
	_END()
ev_c08pc0101_babyboy1:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C08, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08pc0101_babyboy_02')
	_MACRO_TALKMSG('dialogue_c08pc0101', '0-msg_c08pc0101_babyboy1_01', 'Wow, you’re really cool! You have seven\nGym Badges!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08pc0101_babyboy_02:
	_MACRO_TALKMSG('dialogue_c08pc0101', '0-msg_c08pc0101_babyboy1_02', 'Wow! You’re awesomely cool! You have all eight\nGym Badges!\rNow you have to challenge the Pokémon League!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08pc0101_middleman2:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c08pc0101', '0-msg_c08pc0101_middleman2_01_1', 'Sunyshore City is situated on a narrow spit of\nland bordered by the sea and mountains.')
	_MACRO_TALKMSG('dialogue_c08pc0101', '0-msg_c08pc0101_middleman2_01_2', 'To make up for the lack of space, the city built\nsolar panels to provide power and use as roads.\rIt’s a place where nature, Pokémon, and people\nare as one!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()