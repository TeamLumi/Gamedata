	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_5', 'You can probably get in, though. Just a hunch.\nMaybe Shaymin wanted to investigate the\fweird energy, too? Don’t let it down!')
	_TALK_CLOSE()
	;TODO Add Arc Phone Notification sound effect
	_OBJ_ANIME('R214_AYOU_AKARI', 'anm_r214_music_emote')
