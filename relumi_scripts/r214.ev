ev_r214_init_change:
	; Sets the correct AYou depending on player gender
	_IF_FLAGOFF_JUMP(#1759, 'ev_r214_ayou_set_gender')
	_END()
ev_r214_door_exit_move_2:
	_SXY_EXIT_POS_CHANGE(4, 710, 670)
	_SXY_EXIT_POS_CHANGE(5, 710, 670)
	_END()
ev_r214_door_exit_move_1:
	_SXY_EXIT_POS_CHANGE(4, 710, 670)
	_SXY_EXIT_POS_CHANGE(6, 710, 670)
	_END()
ev_r214_door_exit_move_0:
	_SXY_EXIT_POS_CHANGE(5, 710, 670)
	_SXY_EXIT_POS_CHANGE(6, 710, 670)
	_END()
ev_r214_flag_change:
	_ANOON_SEE_NUM(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'GE', 26, 'ev_r214_door_exit_move_2')
	_IFVAL_JUMP(@LOCALWORK0, 'GE', 10, 'ev_r214_door_exit_move_1')
	_IFVAL_JUMP(@LOCALWORK0, 'LT', 10, 'ev_r214_door_exit_move_0')
	_END()
ev_r214_ayou_set_gender:
	_GET_COSTUME(@SCWK_TEMP0); Assigns the Current costume to TEMP0
	_GET_COSTUME_GENDER(@SCWK_TEMP0, @SCWK_TEMP1); Takes TEMP0 and checks the index and assigns TEMP1 to 0 if male and 1 if female
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 0, 'ev_r214_ayou_rei_set')
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 1, 'ev_r214_ayou_akari_set')
	_END()
ev_r214_ayou_rei_set:
	_FLAG_RESET(#2924); Show Ayou Rei
	_END()
ev_r214_ayou_akari_set:
	_FLAG_RESET(#2925); Show Ayou Akari
	_END()
pos_r214_ayou_grottoes_start:
	_EVENT_START()
	_LDVAL(@442, 1) ; Disable StopData
	_IF_FLAGOFF_CALL(#2924, 'ev_r214_ayou_grottoes_rei')
	_IF_FLAGOFF_CALL(#2925, 'ev_r214_ayou_grottoes_akari')
	_FLAG_SET(#1759); R214 Ayou Grottoes event completed
	_FLAG_SET(#2765); Enable Grottos
	_EVENT_END()
	_END()
ev_r214_ayou_grottoes_rei:
	_CHARA_LOOK_LOCK('R214_AYOU_REI', 'HERO')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_exclamation_emote')
	_CHARA_LOOK_LOCK('HERO', 'R214_AYOU_REI')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_1', 'Oh, {0,1,0,0}! There you are!\rI was just thinking about you. C’mere a sec.\nThere’s something I wanna show you.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R214_AYOU_REI')
	_OBJ_ANIME('HERO', 'anm_r214_player_dir_left')
	;Check player position and only move if they are not in the same X
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP0, 'GE', 718, 'ev_r214_ayou_rei_matchX')
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_ayou_left')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_2', 'I’ve been seeing a lot of these disturbances\naround Sinnoh lately. New underbrush and\frock formations...')
	_CHARA_LOOK_LOCK('R214_AYOU_REI', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'R214_AYOU_REI')
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_3', 'Have you noticed it too? A lot of them\nresemble the Gracidea plant, or even the\fRamanas Roses.\rThe Gratitude Pokémon, Shaymin, is very fond\nof those.\rWherever a Shaymin goes, it tends to leave\nhuge swathes of growth and prosperity in its\fwake.\rWhat drew it to these places is probably...\nJust a little further now.\fOver here. Do you see it?')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R214_AYOU_REI')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_ayou_walk_grotto')
	_OBJ_ANIME('HERO', 'anm_r214_player_walk_grotto')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_4', 'It can be tricky to make out, but there’s this...\nshadow... that doesn’t fit.\rIt’s full of distortion energy.\nEvery time I try to get close, it feels like I’m\ftaking a wrong turn and end up where I started.\rI don’t think it’s the same as the distortions\nI’m used to, not exactly, but...')
	_CHARA_LOOK_LOCK('R214_AYOU_REI', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'R214_AYOU_REI')
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_5', 'You can probably get in, though. Just a hunch.\nMaybe Shaymin wanted to investigate the\fweird energy, too? Don’t let it down!')
	_TALK_CLOSE()
	;TODO Add Arc Phone Notification sound effect
	_OBJ_ANIME('R214_AYOU_AKARI', 'anm_r214_music_emote')
	_SE_PLAY('M_FI012'); Placeholder
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_exclamation_emote')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_6', 'Looks like I’ve gotta go. Keep up the good\nwork, I bet your adventure has been lots of fun\fso far!\rDon’t forget to keep your eyes peeled for any\nother strange geographical features for more\fdistortions, okay? See ya, {0,1,0,0}!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R214_AYOU_REI')
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_ayou_walk_away')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('HERO', 'anm_r214_question_emote')
	_PLAY_EMO_SE(7) ; Play question emote sound
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('R214_AYOU_REI', 'HERO')
	_AYOU_NAME(1)
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_7', 'Oh, what’s my name?\nHm... how about you call me {1,1,0,0}?\fI always liked the sound of that!')
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_8', 'I have to go now, but I’ll see you later!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('HERO', 'R214_AYOU_REI')
	_CHARA_LOOK_RELEASE('R214_AYOU_REI')
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_ayou_leave')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_FLAG_SET(#2924); Disable Rei
	_RET()
ev_r214_ayou_grottoes_akari:
	_CHARA_LOOK_LOCK('R214_AYOU_AKARI', 'HERO')
