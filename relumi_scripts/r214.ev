	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r214', 'msg_r214_ayou_grottoes_start_6', 'Looks like I’ve gotta go. Keep up the good\nwork, I bet your adventure has been lots of fun\fso far!\rDon’t forget to keep your eyes peeled for any\nother strange geographical features for more\fdistortions, okay? See ya, {0,1,0,0}!')
