ev_r214_ayou_akari_matchX:
	_OBJ_ANIME('R214_AYOU_AKARI', 'anm_r214_ayou_matchX')
	_OBJ_ANIME_WAIT()
	_RET()
ev_r214_ayou_rei_matchX:
	_OBJ_ANIME('R214_AYOU_REI', 'anm_r214_ayou_matchX')
	_OBJ_ANIME_WAIT()
	_RET()
anm_r214_exclamation_emote:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_r214_question_emote:
	_AC_MARK_EMO(7)
	_ACMD_END()
anm_r214_music_emote:
	_AC_MARK_EMO(13)
	_ACMD_END()
anm_r214_ayou_matchX:
	_AC_DIR_R(8)
	_AC_HERO_MATCH_X(8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_r214_ayou_left:
	_AC_DIR_L(8)
	_ACMD_END()
anm_r214_player_dir_left:
	_AC_WAIT(5)
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_r214_ayou_walk_grotto:
	_AC_DIR_L(8)
	_AC_WORLD_X(713, 8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_r214_player_walk_grotto:
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_AC_DIR_L(8)
	_AC_WORLD_X(714, 8)
	_AC_DIR_U(8)
	_ACMD_END()
anm_r214_ayou_walk_away:
	_AC_DIR_D(8)
	_AC_DOWN(1, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_ACMD_END()
anm_r214_ayou_leave:
	_AC_DIR_R(8)
	_AC_RIGHT(10, 6) ; Faster since they may be in a hurry
	_AC_INVISIBLE_ON()
	_ACMD_END()
ev_r214_sign1:
	_EASY_BOARD_MSG('dialogue_r214%109-msg_r214_sign1_01', 'BOARD_TYPE_ROAD', 0, 3)
	_END()
ev_r214_sign2:
	_EASY_BOARD_MSG('dialogue_r214%109-msg_r214_sign2_01', 'BOARD_TYPE_ROAD', 0, 4)
	_END()
ev_r214_blocker_1:
	_TALK_OBJ_START()
	_MACRO_TALK_KEYWAIT('dialogue_r214', '00_msg_ev_r214_blocker_1', '...\r...\r...')
	_MACRO_TALK_KEYWAIT('dialogue_r214', '00_msg_ev_r214_blocker_2', 'Excuse me, I’m painting a picture.\nA beautiful work of art.\rI won’t have you interrupting it!\rGo explore Veilstone or whatever.\nI’ll be done before long.')
	_TALK_CLOSE()
	_OBJ_ANIME('R214_BLOCKER1', 'anm_r214_blocker_1')
	_OBJ_ANIME_WAIT()
	_TALK_OBJ_END()
	_END()
ev_r214_blocker_2:
	_VOICE_PLAY(54, 0, 0)
	_MACRO_EASY_OBJ_MSG('dialogue_r214', '00_msg_ev_r214_blocker_psy', 'Gwa gwah?!')
	_END()
anm_r214_blocker_1:
	_AC_DIR_D(8)
	_ACMD_END()
ev_r214_choiceitem:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2752, 'ev_r214_choiceitem_done')
	_MACRO_TALKMSG('dialogue_r214', '00_msg_r214_choice_item_1', 'Hoo! Hah!\nHoo! Hah!\rFocus!\nFocus is important!\rGive this to your Pokémon!\nFocus their power!')
	_LDVAL(@SCWK_TEMP0, 220)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_FLAG_SET(#2752)
	_TALK_OBJ_END()
	_END()
ev_r214_choiceitem_done:
	_MACRO_TALKMSG('dialogue_r214', '00_msg_r214_choice_item_2', 'Hoo! Hah!\nAre you and your Pokémon focusing?!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r214_grotto_warp_0:
	_TALK_OBJ_START()
	_CALL('ev_grotto_warp')
	_MAP_CHANGE('GROTTOR0301', 0)
	_TALK_OBJ_END()
	_END()
ev_r214_grotto_warp_1:
	_TALK_OBJ_START()
	_CALL('ev_grotto_warp')
	_MAP_CHANGE('GROTTOR0301', 1)
	_TALK_OBJ_END()
	_END()