ev_d22r0102_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D22R0101)
	_END()
ev_d22r0102_mania:
	_TALK_OBJ_START()
	_ANOON_SEE_NUM(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 'ANOON_SEE_NUM_2', 'ev_r22r0102_mania_02')
	_MACRO_TALKMSG('dialogue_d22r0102', '112-msg_d22r0102_mania_01_1', 'Everyone calls me a Ruin Maniac. Or they used\nto call me that.\fNow they call me the Digging Maniac.\rI’ll just go on chipping away at the rock wall a\nlittle at a time.')
	_MACRO_TALKMSG('dialogue_d22r0102', '112-msg_d22r0102_mania_01_2', 'Do you know why? I’m a Ruin Maniac who is\nfascinated by the Unown and who also loves\fto dig!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r22r0102_mania_02:
	_MACRO_TALKMSG('dialogue_d22r0102', '112-msg_d22r0102_mania_02_1', 'Everyone calls me a Ruin Maniac. Or they used\nto call me that.\fNow they call me the Digging Maniac.\rI’ll just go on chipping away at the rock wall a\nlittle at a time.')
	_MACRO_TALKMSG('dialogue_d22r0102', '112-msg_d22r0102_mania_02_2', 'Do you know why? I’m a Ruin Maniac who also\nloves to dig!')
	_MACRO_TALKMSG('dialogue_d22r0102', '112-msg_d22r0102_mania_02_3', 'I need to bear down and pound my way through\nthe bedrock now.\rI think I’m getting close to some exciting and\nmysterious Unown.\rIt’s going to be messy. You’d better go outside.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()