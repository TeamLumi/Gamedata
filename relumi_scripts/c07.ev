	_FLAG_SET(#2835)
	_OBJ_DEL('C07_SUPPORT_02')
	_OBJ_DEL('C07_WALL01')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6700)
	_SYS_FLAG_BADGE_GET($BADGE_ID_C06, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'common_c07_support_anaunce_upd')
	_SET_TELEPORT_ID(135, 0)
	_TELEPORT()
	_JUMP('ev_c07r0301_looker_scene')
ev_c07_get_support_id:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_lucas_support_id')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_dawn_support_id')
	_END()
ev_c07_lucas_support_id:
	_SUPPORT_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 499); Support has Turtwig
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_support_team_ret')
	_LDVAL(@SCWK_TEMP3, 500); Support has Chimchar
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_support_team_ret')
	_LDVAL(@SCWK_TEMP3, 498); Support has Piplup
	_RET()
ev_c07_dawn_support_id:
	_SUPPORT_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 496); Support has Turtwig
