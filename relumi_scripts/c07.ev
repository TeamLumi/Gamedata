	_AC_DIR_U(4)
	_AC_UP(5, 4)
	_AC_INVISIBLE_ON()
	_ACMD_END()
ev_c07_support_insult_1:
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_03', 'Oh...\nIt’s that funny man from Jubilife...\r')
	_RET()
ev_c07_support_insult_2:
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_04', 'Hey...\nIt’s that weirdo from Jubilife.')
	_RET()
ev_c07_support_apology_1:
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_05', 'I’m terribly sorry.\rTeam Galactic took my Pokédex, so I was\nvery irritated...\rI just blurted it out...\r...I should be going now.\nBe wary of Team Galactic.')
	_RET()
ev_c07_support_apology_2:
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_06', 'Oh, sorry. Honestly.\rI was upset from having my Pokédex\nripped off by Team Galactic.\rI didn’t even think when I spoke up.\rI’ll be going now.\nUh... Watch out for Team Galactic.')
	_RET()
ev_c07_looker_player_face_eachother_1:
	_OBJ_ANIME('HERO', 'anm_c07_player_face_looker_2')
	_OBJ_ANIME('C07_LOOKER', 'anm_c07_looker_face_player_1')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_investigation')
ev_c07_looker_player_face_eachother_2:
	_OBJ_ANIME('HERO', 'anm_c07_player_face_looker_3')
	_OBJ_ANIME('C07_LOOKER', 'anm_c07_looker_face_player_2')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_investigation')
ev_c07_looker_investigation:
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_07', 'It is of no matter.\rOf more interest is the criminal\nbehavior of the Team Galactic.\rThey attempt to steal the belongings of\na child?\rThe scale of their criminality, it seems\nrather minuscule.\rThe triviality of their action makes\nthem more sinister, perhaps.\rTheir warehouse needs investigation.\nCome with me, and we’ll take a look!')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 595, 'ev_c07_looker_player_enter_galactic_hq_1')
	_JUMP('ev_c07_looker_player_enter_galactic_hq_2')
ev_c07_looker_player_enter_galactic_hq_1:
	_OBJ_ANIME('C07_LOOKER', 'anm_c07_looker_enter_galactic_hq')
	_OBJ_ANIME('HERO', 'anm_c07_player_follow_looker_1')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_setup_flags')
ev_c07_looker_player_enter_galactic_hq_2:
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('C07_LOOKER', 'anm_c07_looker_enter_galactic_hq')
	_SE_WAIT('S_FI001')
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('HERO', 'anm_c07_player_follow_looker_2')
	_SE_WAIT('S_FI001')
	_OBJ_ANIME_WAIT()
