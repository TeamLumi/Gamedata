ev_c07_vita_reward_end:
	_IF_FLAGOFF_CALL(#4013, 'ev_c07_vita_first_time_reward_end')
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_reward_end_1', 'Check back after you get your next badge.\nI should have the next one ready by then.\rRemember, my device is top of the line!\rThere’s absolutely no difference in the end\nbetween store-bought Vitamins, and pumping\fup your Pokémon’s power with the\fPro-Vitamins.')
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_first_time_reward_end:
	_FLAG_SET(#4013)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_first_time_reward_end', 'After using it, the Capsulizer has to be reset\nto default specs by hand.\rI should have the machine recalibrated to scan\na new Pokémon after a while.')
	_RET()
ev_c07_vita_reward_last_end:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_reward_last_end', 'Wow, {0}! I’m not surprised\na Trainer as impressive as you was able to\fmaster every aspect of the battlefield.\fOne day, my Capsules will help the whole\nworld unleash the latent potential of their\fPokémon, all thanks to the data you provided.\rKeep battling, {0},\nthere are surely more secrets to uncover!')
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_FLAG_RESET(#4012); Stop checking Pokémon when you come back
	_FLAG_SET(#4020); Vita quest completed
	_TALK_OBJ_END()
	_END()
ev_c07_vita_quest_completed:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_quest_completed', 'Thank you so much for helping me realize\nmy dream!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_heart')
	_PLAY_EMO_SE(2)
	_OBJ_ANIME_WAIT()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
anm_c07_vita_neck_down:
	;Look down
	_AC_NECK_ROTATE(0, 15, 0, 4); Yaw Pitch Roll Speed
	_ACMD_END()
anm_c07_vita_neck_normal:
	_AC_NECK_ROTATE(0, 0, 0, 4); Yaw Pitch Roll Speed
	_ACMD_END()
anm_c07_vita_neck_to_player:
	_AC_NECK_ROTATE(-45, 0, 0, 4); Yaw Pitch Roll Speed
	_ACMD_END()
anm_c07_vita_happy:
	_AC_FACE_INDEX(4)
	_AC_MARK_EMO(5)
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c07_vita_exclamation:
	_AC_FACE_INDEX(5)
	_AC_MARK_EMO(0)
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c07_vita_sad:
	_AC_FACE_INDEX(2)
	_AC_MARK_EMO(8)
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c07_vita_happy_face:
	_AC_FACE_INDEX(4)
	_ACMD_END()
anm_c07_vita_sad_face:
	_AC_FACE_INDEX(2)
	_ACMD_END()
anm_c07_vita_normal_face:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c07_vita_heart:
	_AC_FACE_INDEX(4)
	_AC_MARK_EMO(2)
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c07_vita_think:
	_AC_MARK_EMO(9)
	_ACMD_END()
anm_c07_vita_eureka:
	_AC_FACE_INDEX(4)
	_AC_MARK_EMO(1)
	_AC_FACE_INDEX(0)
	_ACMD_END()
ev_c07_min:
	_SE_PLAY('PLAY_PV_312_00_00')
	_IF_FLAGON_JUMP(#4020, 'ev_c07_min_completed'); Quest completed
	_IF_FLAGON_JUMP(#4010, 'ev_c07_min_nametag'); Vita has already introduced Min's name
	_IF_FLAGON_JUMP(#4011, 'ev_c07_min_nametag'); Vita has already introduced Min's name
	_IF_FLAGON_JUMP(#4012, 'ev_c07_min_nametag'); Vita has already introduced Min's name
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_min', 'Miiii! Minmimimiiiiiiiinun!')
	_TALK_CLOSE()
	_END()
ev_c07_min_nametag:
	;Separate message to add the MsgWindowData
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_min_nametag', 'Miiii! Minmimimiiiiiiiinun!')
	_TALK_CLOSE()
	_END()
ev_c07_min_completed:
	_OBJ_ANIME('C07_MIN', 'anm_c07_vita_heart')
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_min_completed', 'Mimiminun! Miiiiinun!')
	_TALK_CLOSE()
	_END()
ev_c07_vita_camera_end:
	_EVENT_CAMERA_INDEX(111)
	_OBJ_ANIME('HERO', 'anm_c07_vita_neck_normal')
	_EVENT_CAMERA_END_WAIT()
	_RET()