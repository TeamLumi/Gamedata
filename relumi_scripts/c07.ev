ev_c07_gorggeousm_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C07_ITEM_GET1, 'ev_c07_gorggeousm_iro_02')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gorggeousm_iro_01', 'Ticktock, ticktock...\rIt swings its pendulum at the same interval.\nHow beautiful...\rI’ll give this to you.')
	_LDVAL(@SCWK_TEMP0, 277)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
