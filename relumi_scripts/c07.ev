ev_c07_flag_change:
	_CALL('ev_box_close')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 6200, 'ev_c07_guide_upd')
	_LDVAL(@LOCALWORK31, 0)
	_IFVAL_CALL(@WK_SCENE_C07_SUPPORT_GYM_AFTER, 'GE', 2, 'ev_c07_flag_change_support_set_02')
	_FLAG_SET(#FV_WALL_PUT)
	_OBJ_DEL('C07_WALL01')
	_IF_FLAGOFF_CALL(#FV_C07_SUPPORT2, 'ev_c07_wall_change')
	_GET_MY_SEX(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'c07_male_flag_change_01')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'c07_female_flag_change_01')
	_END()
ev_c07_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6300)
	_RET()
ev_c07_flag_change_support_set_02:
	_SXY_POS_CHANGE('C07_SUPPORT', 696, 596)
	_SXY_MV_CHANGE('C07_SUPPORT', 'MV_RIGHT')
	_OBJ_DIR_CHANGE('C07_SUPPORT', 270)
	_RET()
c07_male_flag_change_01:
	_LDVAL(@OBJCHRWORK0, 'HEROINE')
	_END()
c07_female_flag_change_01:
	_LDVAL(@OBJCHRWORK0, 'HERO')
	_END()
ev_c07_wall_change:
	_FLAG_RESET(#FV_WALL_PUT)
	_OBJ_ADD('C07_WALL01')
	_RET()
ev_c07_support_pre_gym:
	_EVENT_START()
	_CALL('ev_another_out_sp')
	_CHARA_LOOK_LOCK('C07_SUPPORT', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C07_SUPPORT')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C07_SUPPORT', 'ev_c07_support_gym_exclamation')
	_OBJ_ANIME_WAIT()
	_CALL('ev_the_boy_girl_play')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CHARA_LOOK_RELEASE('C07_SUPPORT')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_POS_CHANGE_WORLD('HERO', 682, 2, 616.5)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_POS_CHANGE_WORLD('C07_SUPPORT', 682, 2, 615.5)
	_OBJ_DIR_CHANGE('C07_SUPPORT', 0)
	_EVENT_CAMERA_INDEX(560)
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_face_happy')
	_EVENT_CAMERA_END_WAIT()
	_OBJ_ANIME_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_male_dialogue_3')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_female_dialogue_3')
	_TALK_CLOSE()
	_CALL('ev_c07_wake_scene')
	_EVENT_CAMERA_INDEX(600)
	_CALL('ev_c07_support_gym_exit_2')
	_EVENT_CAMERA_END_WAIT()
	_OBJ_DEL('C07_SUPPORT')
	_CALL('ev_character_theme_stop')
	_OBJ_ANIME('HERO', 'anm_c07_dir_up')
	_OBJ_ANIME_WAIT()
	_LDVAL(@WK_SCENE_C07_SUPPORT, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6400)
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
ev_c07_support_male_dialogue_3:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_06_1', '{0,1,0,0}, are you going to take the\nGym challenge?\rGee, you keep getting tougher and tougher,\ndon’t you?', 0, 1)
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_face_normal')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_06_2', 'Me? Well, I went shopping at the department\nstore, and—I mean, well, of course I’ve been\fworking on my Pokédex, but, uh, well...\rI’ll catch you later!')
	_RET()
ev_c07_support_female_dialogue_3:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_07_1', 'Hey! {0,1,0,0}, are you going to take on\nthe Gym Leader?\rWow, you just keep getting tougher and tougher.', 0, 1)
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_face_normal')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_07_2', 'Me? Well, I took a look in the department store,\nand—I mean, yeah, of course I’ve been working\fon my Pokédex, but, well, uh...\rAnyways, keep it up! I’ll see you around!')
	_RET()
ev_c07_support_gym_exit_1:
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_support_gym_exit_1')
	_OBJ_ANIME('HERO', 'anm_c07_player_face_support_gym_2')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c07_support_gym_exit_2:
