	_AC_DIR_D(8)
	_ACMD_END()
anm_c07_gingnam_exclamation_1:
	_AC_MARK_GYOE(1)
	_ACMD_END()
anm_c07_gingnam_push_player:
	_AC_DOWN(1, 8)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_L(8)
	_ACMD_END()
anm_c07_player_pushed_back:
	_AC_LEFT(1, 8)
	_ACMD_END()
ev_c07_gingam_1:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C07, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_gingam_1_badge_get')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_1_05', 'Hey, you! Yeah, you!\rThis is Team Galactic’s warehouse! It ain’t no\nplayground for kids!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gingam_1_badge_get:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_1_02', 'What? Now you’ve brought your buddy along so\nyou can get your Pokédex back?\rWe’ll be just as happy to send both of you crying\nhome to your mommies!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gingam_2:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C07, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_gingam_2_badge_get')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_2_01', 'This is the awesome Team Galactic’s awesome\nwarehouse! A little kid like you should be playing\fat the Pokémon Gym.\rAfter all, the Gym Leader happens to be a kid\njust like you!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gingam_2_badge_get:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_2_02', 'You’re trying to get the Pokédex back from us?\nNot when we, Team Galactic, can make so much\fbetter use of it!\rBut, OK, guarding the warehouse does get\nboring! We’ll take you on two-on-two!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gingam_3:
	_TALK_OBJ_START_TURN_NOT()
	_CALL('ev_another_out')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_3_01', 'There! Would you look at those antennae?\rI don’t know what they do, but those are some\nmighty impressive antennae!')
	_TALK_CLOSE()
	_TURN_HERO_SITE()
	_CHARA_LOOK_RELEASE('C07_GINGAM_3')
	_OBJ_ANIME('C07_GINGAM_3', 'anm_c07_gingnam_exclamation_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_3_02_1', 'Hey! It’s you!\rI bet you don’t remember me, but I sure\nremember you!')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_3_02_2', 'Because of you, they took my Clefairy away...\rMy partner called it quits and went back to\nhis hometown...\rI don’t know anything about any Storage Key!')
	_TALK_CLOSE()
	_GET_REL_POS_HERO('C07_GINGAM_3', @SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 8, 'ev_c07_gingnam_exit_1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'ev_c07_gingnam_exit_2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'ev_c07_gingnam_exit_3')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 6, 'ev_c07_gingnam_exit_4')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_c07_gingnam_exit_2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_gingnam_exit_1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 9, 'ev_c07_gingnam_exit_2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 3, 'ev_c07_gingnam_exit_5')
	_END()
ev_c07_gingnam_exit_2:
	_OBJ_ANIME('HERO', 'anm_c07_player_watch_gingnam_1')
	_OBJ_ANIME('C07_GINGAM_3', 'anm_c07_gingnam_exit_1')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_key')
	_END()
ev_c07_gingnam_exit_1:
	_OBJ_ANIME('C07_GINGAM_3', 'anm_c07_gingnam_exit_1')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_key')
	_END()
ev_c07_gingnam_exit_3:
	_OBJ_ANIME('HERO', 'anm_c07_player_watch_gingnam_2')
	_OBJ_ANIME('C07_GINGAM_3', 'anm_c07_gingnam_exit_1')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_key')
	_END()
ev_c07_gingnam_exit_4:
	_OBJ_ANIME('HERO', 'anm_c07_player_watch_gingnam_3')
	_OBJ_ANIME('C07_GINGAM_3', 'anm_c07_gingnam_exit_2')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_key')
	_END()
ev_c07_gingnam_exit_5:
	_OBJ_ANIME('HERO', 'anm_c07_player_watch_gingnam_4')
	_OBJ_ANIME('C07_GINGAM_3', 'anm_c07_gingnam_exit_1')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c07_looker_key')
	_END()
ev_c07_looker_key:
	_OBJ_DEL('C07_GINGAM_3')
	_CALL('ev_another_out_end')
	_FLAG_RESET(#2866)
	_OBJ_ADD('C07_LOOKER_2')
	_AYOU_NAME(0)
	_MACRO_TALKMSG('dialogue_c07', '00_msg_c07looker2_0', '{0}!')
	_OBJ_ANIME('C07_LOOKER_2', 'anm_c07_looker_key_entrance')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'C07_LOOKER_2')
	_CHARA_LOOK_LOCK('C07_LOOKER_2', 'HERO')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07looker2_1', 'Ah-hah!\nYou leave this to me!\rThe Storage Key for entering the Team\nGalactic hideout, I have right here.\rA frontal assault, it is not possible.\nBut we can enter their hideout.\rWell? Will you enter the hideout?\nYou have your reasons, yes?')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07looker2_2', 'Very well.\nInside the Team Galactic warehouse.\fWe will meet there.\rPrepare the best you can.\nI shall join you shortly.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('C07_LOOKER_2')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('C07_LOOKER_2', 'anm_c07_looker_key_exit')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C07_LOOKER_2')
	_SET_SYS_FLAG($SYS_FLAG_BGM_D26)
	_FLAG_SET(#2866)
	_FLAG_SET(#2793)
	_TALK_OBJ_END()
	_END()
anm_c07_looker_key_entrance:
	_AC_DIR_U(4)
	_AC_UP(8, 4)
	_ACMD_END()
anm_c07_looker_key_exit:
	_AC_DIR_D(4)
	_AC_DOWN(10, 4)
	_ACMD_END()
anm_c07_gingnam_exclamation_2:
	_AC_MARK_GYOE(1)
	_ACMD_END()
anm_c07_gingnam_exit_1:
	_AC_RIGHT(1, 8)
