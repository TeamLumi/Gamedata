ev_c07_support:
	_TALK_OBJ_START()
	_EVENT_START()
	_CALL('ev_another_out')
	_EVENT_CAMERA_INDEX(430)
	_EVENT_CAMERA_END_WAIT()
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_male_help')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_female_help')
	_END()
ev_c07_support_male_help:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_01', 'Hi, {0,1,0,0}! Please, can you help me?\rI dropped my Pokédex by accident, and Team\nGalactic found it. Now they won’t give it back.\rPlease, I need your help. Team up and battle\nwith me!')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_support_male_help_yes')
	_JUMP('ev_c07_support_male_help_no')
	_END()
ev_c07_support_male_help_yes:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_02', 'You and your Pokémon together with me and\nmy Pokémon...\rUnited like this, our dream team has no chance\nof losing!\rI’m not letting Team Galactic get away with this!')
	_JUMP('ev_c07_get_player_position')
	_END()
ev_c07_support_male_help_no:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_03', 'I’ll be waiting. Please get ready and\ncome quickly.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(431)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
ev_c07_support_female_help:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_01', 'Hey! {0,1,0,0}! Listen, I need your help...\rI dropped my Pokédex by accident, and Team\nGalactic found it.\rNow they won’t give it back. Please, I need you\nto help me.\rWill you team up with me to take them on?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_support_female_help_yes')
	_JUMP('ev_c07_support_female_help_no')
	_END()
ev_c07_support_female_help_yes:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_02', 'You and your Pokémon together with me and\nmy Pokémon...\rOur dream team’s not going to lose. Not with the\nway we work together!\rI’m not letting those criminals get away with this!')
	_JUMP('ev_c07_get_player_position')
	_END()
ev_c07_support_female_help_no:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_03', 'I’ll be waiting! Get ready and come quick!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(431)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_TALK_END()
	_CALL('ev_another_out_end')
	_END()
ev_c07_get_player_position:
	_TALK_CLOSE()
	_GET_REL_POS_HERO('C07_SUPPORT_02', @SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 8, 'ev_c07_support_battle_fighting_positions_1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'ev_c07_support_battle_fighting_positions_2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'ev_c07_support_battle_fighting_positions_3')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_c07_support_battle_fighting_positions_4')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_battle_fighting_positions_5')
	_END()
ev_c07_support_battle:
	_LDVAL(@SCWK_TEMP1, 674)
	_LDVAL(@SCWK_TEMP2, 675)
	_CALL('ev_c07_get_support_id')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_multi_battle')
	_TRAINER_MULTI_BTL_SET(@SCWK_TEMP3, @SCWK_TEMP1, @SCWK_TEMP2)
	_OBJ_DIR_CHANGE('HERO', 270)
	_OBJ_DIR_CHANGE('C07_SUPPORT_02', 270)
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_1_03_1', 'Aww, that stinks! Our Pokémon are weak!\nWe should get new ones from headquarters.')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_1_03_2', 'Humph!\nWho cares about some Pokédex anyways?\rTeam Galactic is going to own all the Pokémon in\nthe world—no, in the universe!')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 595, 'ev_c07_gingam_face_left_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 597, 'ev_c07_gingam_face_left_2')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_1_04', 'There! Take it! Take your Pokédex!')
	_TALK_CLOSE()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 595, 'ev_c07_gingam_exit_1_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 597, 'ev_c07_gingam_exit_1_2')
	_OBJ_DEL('C07_GINGAM_1')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_2_03', 'Those things we had in the warehouse have\nalready been moved to Pastoria City anyway.\rSo, we’ll say “You’ll get yours!” and run like the\ngrunts we are.')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 595, 'ev_c07_gingam_exit_2_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 597, 'ev_c07_gingam_exit_2_2')
	_OBJ_DEL('C07_GINGAM_2')
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_male_dialogue_1')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_female_dialogue_1')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 595, 'ev_c07_support_player_face_eachother_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 597, 'ev_c07_support_player_face_eachother_2')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_male_dialogue_2')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_female_dialogue_2')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(431)
	_EVENT_CAMERA_END_WAIT()
	_FLAG_RESET(#2835);_SXY_POS_CHANGE('C07_LOOKER', 692, 606);Looker event starts
	_OBJ_ADD('C07_LOOKER')
	_OBJ_ANIME('C07_LOOKER', 'anm_c07_looker_enter')
	_OBJ_ANIME_WAIT()
	_AYOU_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_01', 'Have no fear, I have come\nrunning.\rI heard of children feuding with the\nTeam Galactic.\rIt turns out, of course, to be\nyou, {0,1,0,0}.')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_SUPPORT_02', 'anm_c07_support_face_looker')
	_OBJ_ANIME('HERO', 'anm_c07_player_face_looker_1')
	_OBJ_ANIME_WAIT()
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_insult_1')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_insult_2')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_looker_02', 'You insult me to my face?\nHow very uncouth of you.')
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_apology_1')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_apology_2')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_SUPPORT_02', 'anm_c07_support_exit')
	_OBJ_ANIME('C07_LOOKER', 'anm_c07_looker_face_support')
	_OBJ_ANIME_WAIT()
	_FLAG_SET(#FE_C07_SUPPORT)
	_FLAG_SET(#FV_C07_SUPPORT2)
	_FLAG_SET(#FV_WALL_PUT)
	_FLAG_SET(#2704); Kill R214 Blockers and Route 212 North Blockers to get to 212 South
	_OBJ_DEL('C07_SUPPORT_02')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 595, 'ev_c07_looker_player_face_eachother_1')
	_JUMP('ev_c07_looker_player_face_eachother_2')
anm_c07_looker_enter:
	_AC_DIR_U(4)
	_AC_UP(10, 4)
	_AC_DIR_R(4)
	_AC_RIGHT(3, 4)
	_ACMD_END()
