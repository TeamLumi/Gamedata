ev_c07_man2a:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_man2a_01', 'Yeah, Team Galactic is hiding all sorts of good\nstuff in their warehouse.\rI hear they even have a Technical Machine for\nthe move Fly in there!')
	_END()
ev_c07_man2b:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_man2b_01', 'One day, a meteorite came screamin’ outta\nnowhere, and where it landed, a town popped\fup and flourished. What a rockin’ story!')
	_END()
ev_c07_middlem1:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_badman2_01', 'Veilstone is the city of stone. We even\nhave meteorites!')
	_END()
ev_c07_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_girl2_01', 'Business at the new Style Shop has really\nbeen booming!')
	_END()
ev_c07_badman:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_badman_01', 'Maylene is Veilstone’s Gym Leader.\nWake’s the Gym Leader in Pastoria.\fThen there’s Fantina in Hearthome...\rThey’re all way too tough. I can’t even come\nclose to them.')
	_END()
ev_c07_badman2:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_WAZAMASIN63_GET, 'ev_c07_badman_02')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_badman1_01', 'Veilstone is the city of stone. We even\nhave meteorites!\rThis has nothing to do with anything, but take\nthis Technical Machine!')
	_LDVAL(@SCWK_TEMP0, 390)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_badman_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_WAZAMASIN63_GET)
	_JUMP('ev_c07_badman_02')
	_END()
ev_c07_badman_02:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_badman1_02', 'If a Pokémon uses Nasty Plot, the Pokémon’s\nSp. Atk stat sharply increases!\rAnyway, enjoy your visit to Veilstone, the city\nof...well, stone.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_badman_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gorggeousw:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_gorggeousw_01', 'I came to this city just so I could go shopping at\nthe department store.\rBut with all these rock walls around, this place\nfeels kind of cold.')
	_END()
ev_c07_ambrella:
	_MACRO_EASY_OBJ_MSG('dialogue_c07', '108-msg_c07_ambrella_01', 'I bought a new parasol. But I don’t want it to get\nrained on, so I watch the TV weather reports.')
	_END()
pos_c07_gingam:
	_EVENT_START()
	_CALL('ev_another_out')
	_OBJ_ANIME('C07_GINGAM_1', 'anm_c07_gingnam_face_player')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_GINGAM_1', 'anm_c07_gingnam_exclamation_1')
	_OBJ_ANIME('HERO', 'anm_c07_player_face_gingam')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gingam_1_01', 'Hey, you! Yeah, you!\rThis is Team Galactic’s warehouse! It ain’t no\nplayground for kids!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_GINGAM_1', 'anm_c07_gingnam_push_player')
	_OBJ_ANIME('HERO', 'anm_c07_player_pushed_back')
	_OBJ_ANIME_WAIT()
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
anm_c07_player_face_gingam:
	_AC_DIR_U(8)
	_ACMD_END()
