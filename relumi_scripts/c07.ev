	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gorggeousw_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C07_ITEM_REPORT1, 'ev_c07_gorggeousw_iro_03')
	_IF_FLAGON_JUMP(#FE_C07_ITEM_GET4, 'ev_c07_gorggeousw_iro_02')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gorggeousw_iro_01', 'My scarf was blown away by the wind. I wonder\nwhere it went...')
	_FLAG_RESET(#FV_FLD_ITEM_256)
	_OBJ_ADD('FLD_ITEM_256')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gorggeousw_iro_02:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gorggeousw_iro_02', 'Thank you very much for finding my scarf. But I’d\nlike you to have it.\rMy attachment to the scarf seems to have blown\naway, too.')
	_FLAG_SET(#FE_C07_ITEM_REPORT1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gorggeousw_iro_03:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gorggeousw_iro_03', 'If you let a Pokémon hold a Silk Scarf, it boosts\nthe power of Normal-type moves.\rPlease put it to good use.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovem_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C07_ITEM_REPORT2, 'ev_c07_lovelovem_iro_03')
	_IF_FLAGON_JUMP(#FE_C07_ITEM_GET3, 'ev_c07_lovelovem_iro_02')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_lovelovem_iro_01', 'Hmm. Where did it go?\rI lost my lens, but without my lens, how can I\nsearch for it?')
	_FLAG_SET(#FH_04)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovem_iro_02:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_lovelovem_iro_02', 'Stunky! It was you!\rIt seems I focused my search on the ground too\nmuch. Well, I’ll let you have it.')
	_FLAG_SET(#FE_C07_ITEM_REPORT2)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovem_iro_03:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_lovelovem_iro_03', 'If a Pokémon with a Zoom Lens uses a move\nafter its target, the accuracy of the move will\fbe boosted.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovew_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C07_ITEM_GET2, 'ev_c07_lovelovew_iro_03')
	_IF_FLAGON_JUMP(#FE_C07_ITEM_GET3, 'ev_c07_lovelovew_iro_02')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_lovelovew_iro_01', 'Hmm. My boyfriend lost his lens. Where did\nit go?\rI’ve been looking for it with my Wide Lens, but...')
	_FLAG_SET(#FH_03)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovew_iro_02:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_lovelovew_iro_02', 'Oh, Stunky had his lens. Sorry for getting you\ninvolved in this.\rPlease take this.')
	_LDVAL(@SCWK_TEMP0, 265)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_lovelovew_iro_01_item_event_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C07_ITEM_GET2)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovew_iro_03:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_lovelovew_iro_03', 'Just let a Pokémon hold a Wide Lens, and the\naccuracy of its moves will go up.\rBut a Zoom Lens boosts the accuracy more than\na Wide Lens, so use them wisely depending on\fthe situation.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_lovelovew_iro_01_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
