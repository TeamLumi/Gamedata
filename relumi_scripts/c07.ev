ev_c07_wake_scene:
	_SET_DOOR_OBJ('C07GYM0101_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI020_OPEN')
	_HIT_DOOR_ANIME_WAIT()
	_OBJ_ADD('C07_WAKE')
	_FLAG_RESET(#2834)
	_OBJ_ANIME('C07_WAKE', 'anm_c07_wake_exit_building')
	_OBJ_ANIME_WAIT()
	_SET_DOOR_OBJ('C07GYM0101_D01')
	_HIT_DOOR_ANIME(1)
	_SE_PLAY('S_FI020_CLOSE')
	_HIT_DOOR_ANIME_WAIT()
	_SE_PLAY('S_FI020')
	_EVENT_CAMERA_INDEX(561)
	_CHARA_LOOK_LOCK('HERO', 'C07_WAKE')
	_CHARA_LOOK_LOCK('C07_SUPPORT', 'C07_WAKE')
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C07_SUPPORT')
	_OBJ_ANIME('HERO', 'anm_c07_face_shock')
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_face_shock')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'C07_WAKE')
	_CHARA_LOOK_LOCK('C07_SUPPORT', 'C07_WAKE')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_wake_1', 'The ring is my roiling sea. ♪\nThe towering waves shaped me.\rCrash! Crash! Crasher Wake!\nCrash! Crash! Crasher Wake!\rI’m the tidal wave of power to wash\nyou away!\rPut out the fire, Crasher Wake!\nRun from electricity, Crasher Wake!\rAh, ah, aaaah!\nThe ring is my sea. ♪')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(562)
	_OBJ_ANIME('C07_WAKE', 'anm_c07_wake_approach_player_2')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C07_SUPPORT')
	_OBJ_ANIME('HERO', 'anm_c07_hero_wake_neck_up')
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_support_wake_neck_up')
	_OBJ_ANIME('C07_WAKE', 'anm_c07_wake_neck_down')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_common_trans_check'); Prevents Wake from misgendering the player
	_IFVAL_CALL(@552, 'EQ', 0, 'ev_c07_wake_cis')
	_IFVAL_CALL(@552, 'EQ', 1, 'ev_c07_wake_trans')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_wake_2', 'Let me tell you now, she’s young, but\nshe’s a born genius.\rI tried training with her, and I was\nstunned by how tough she was!')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_wake_3', 'Whoops!\nI’d better tell you who I am!\rI’m the triple-threat Gym Leader in\nPokémon, wrestling, and song.')
	_MACRO_TALK_KEYWAIT('dialogue_c07', '00_msg_c07_wake_4', 'I’m Crasher Wake of Pastoria Gym!\nWe’ll meet again!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(563)
	_CALL('ev_c07_wake_exit_2')
	_OBJ_DEL('C07_WAKE')
	_FLAG_SET(#2834)
	_OBJ_ANIME('HERO', 'anm_c07_face_normal')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_GET_MY_SEX(@SCWK_TEMP0)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_c07_support_female_dialogue_4')
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_c07_support_male_dialogue_4')
	_TALK_CLOSE()
	_RET()
ev_c07_wake_cis:
	_MACRO_TALKMSG('dialogue_c07', 'msg_c07_wake_cis', 'Hello, dude and young lady!\nYou’re challenging the Gym Leader,\fare you?')
	_RET()
