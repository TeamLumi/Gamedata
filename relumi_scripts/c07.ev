	_CALL('ev_item_event')
	_FLAG_SET(#FE_C07_ITEM_GET1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_gorggeousm_iro_02:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_gorggeousm_iro_02', 'If you let a Pokémon hold a Metronome, every\ntime that Pokémon uses the same move, the\fMetronome boosts the power of that move.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
