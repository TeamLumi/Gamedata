ev_c07_support_male_dialogue_1:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_04', 'What’s going on? Why is Team Galactic out in\nthe streets like they own the place?')
	_RET()
ev_c07_support_female_dialogue_1:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_04', 'What’s going on here? Why is Team Galactic out\nin the streets like they own the place?')
	_RET()
ev_c07_support_male_dialogue_2:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_05_1', '{0,1,0,0}, thank you, sincerely.\rIf Professor Rowan ever finds out that I lost\nmy Pokédex...\rEwww... I don’t want to think about it.')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_heroine_05_2', 'So, {0,1,0,0}, what are you going\nto do now?\rI’m thinking of going to Pastoria City.\rThe Great Marsh there is home to many kinds\nof Pokémon.', 0, 1)
	_RET()
ev_c07_support_female_dialogue_2:
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_05_1', '{0,1,0,0}, thanks, honestly.\rIf Professor Rowan ever hears that I lost\nmy Pokédex...\rOh, man, that’s something I do not want to\nthink about!')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_05_2', 'So, {0,1,0,0}, what are your\nplans now?\rI’m going off to Pastoria City. The Great Marsh\nthere has all kinds of Pokémon.', 0, 1)
	_RET()
