pos_c07_deoxys:
	_EVENT_START()
	_CALL('ev_block_doc')
	_WHITE_OUT('SCR_WIPE_DIV', 6)
	_VOICE_PLAY(386, 0, 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_WHITE_IN('SCR_WIPE_DIV', 6)
	_FADE_WAIT()
	_TIME_WAIT(5, @SCWK_ANSWER)
	_CALL_EFFECT(0, 247, -731, 0, 628)
	_EFF_SCALE(1, 1, 1, 1)
	_TIME_WAIT(90, @SCWK_ANSWER)
	_OBJ_ADD('C07_DEOXYS')
	_FLAG_RESET(#2865)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_STOP_EFFECT(0)
	_RELEASE_EFFECT(0)
	_OBJ_ANIME('C07_DEOXYS', 'anm_c07_deoxys')
	_OBJ_ANIME_WAIT()
	_LDVAL(@467, 3)
	_TALK_END()
	_JUMP('pos_c07_deoxys_battle')
