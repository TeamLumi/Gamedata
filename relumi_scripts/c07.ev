c07_support_female_500:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_08_1', 'Hey! {0,1,0,0}! Listen, I need your help—\rI dropped my Pokédex by accident, and Team\nGalactic took it.')
	_MACRO_TALKMSG('dialogue_c07', '108-msg_c07_hero_08_2', 'Now they won’t give it back. Please, I need you\nto help me.\rI’ll be waiting in front of the warehouse.\nPlease come!')
