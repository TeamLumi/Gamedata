	_MACRO_TALKMSG('dialogue_c07', 'msg_c07_support_male_dialogue_4_1', 'That Gym Leader is huge!\n...')
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_face_normal')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07', 'msg_c07_support_male_dialogue_4_2', 'So, uh, {0,1,0,0}.\nGood luck on your Gym challenge.')
	_RET()
ev_c07_support_female_dialogue_4:
	_MACRO_TALKMSG('dialogue_c07', 'msg_c07_support_female_dialogue_4_1', 'He is so big!\n...')
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_face_normal')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07', 'msg_c07_support_female_dialogue_4_2', 'Oh, umm...\nGood luck with the Gym. See ya!')
	_RET()
ev_c07_wake_exit_2:
	_OBJ_ANIME('C07_WAKE', 'anm_c07_wake_exit_2')
	_OBJ_ANIME('C07_SUPPORT', 'anm_c07_support_gym_face_wake_6')
	_OBJ_ANIME('HERO', 'anm_c07_player_face_wake_5')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c07_hero_wake_neck_up:
	_AC_DIR_VAL(4, 245)
	_AC_WAIT(1)
	_AC_NECK_ROTATE(0, -10, 0, 4)
	_ACMD_END()
anm_c07_support_wake_neck_up:
	_AC_DIR_VAL(4, 295)
	_AC_WAIT(1)
	_AC_NECK_ROTATE(0, -10, 0, 4)
	_ACMD_END()
anm_c07_wake_neck_down:
	_AC_NECK_ROTATE(0, 15, 0, 4)
	_ACMD_END()
anm_c07_wake_exit_building:
	_AC_FACE_INDEX(1)
	_AC_DIR_D(4)
	_AC_DOWN(1, 4)
	_ACMD_END()
anm_c07_dir_up:
	_AC_DIR_U(8)
	_AC_WAIT(2)
	_ACMD_END()
anm_c07_wake_exclamation:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_c07_wake_approach_player_1:
	_AC_DOWN(4, 4)
	_AC_DIR_L(4)
	_AC_LEFT(2, 4)
	_ACMD_END()
anm_c07_support_gym_face_wake_2:
	_AC_WAIT(32)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_player_face_wake_1:
	_AC_WAIT(32)
	_AC_WAIT(4)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_wake_approach_player_2:
	_AC_DOWN(4, 8)
	_AC_WAIT(2)
	_AC_FACE_INDEX(0)
	_AC_MARK_GYOE()
	_AC_DIR_L(8)
	_AC_WAIT(2)
	_ACMD_END()
anm_c07_support_gym_face_wake_3:
	_AC_WAIT(24)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_player_face_wake_2:
	_AC_WAIT(24)
	_AC_WAIT(4)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_wake_approach_player_3:
	_AC_DIR_D(4)
	_AC_DOWN(4, 4)
	_AC_DIR_L(4)
	_ACMD_END()
anm_c07_support_gym_face_wake_4:
	_AC_WAIT(16)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_player_face_wake_3:
	_AC_WAIT(16)
	_AC_WAIT(4)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_wake_approach_player_4:
	_AC_DIR_D(4)
	_AC_DOWN(1, 4)
	_AC_DIR_L(4)
	_AC_LEFT(1, 4)
	_AC_DIR_D(4)
	_AC_DOWN(3, 4)
	_AC_DIR_R(4)
	_ACMD_END()
anm_c07_support_gym_face_wake_5:
	_AC_WAIT(32)
	_AC_DIR_L(4)
	_ACMD_END()
anm_c07_player_face_wake_4:
	_AC_WAIT(32)
	_AC_WAIT(4)
	_AC_DIR_L(4)
	_ACMD_END()
anm_c07_wake_exit_1:
	_AC_DIR_D(4)
	_AC_DOWN(8, 8)
	_ACMD_END()
anm_c07_support_gym_face_wake_6:
	_AC_WAIT(6)
	_AC_NECK_ROTATE(0, 0, 0, 4)
	_AC_DIR_VAL(8, 350)
	_AC_WAIT(34)
	_AC_DIR_D(4)
	_ACMD_END()
anm_c07_player_face_wake_5:
	_AC_WAIT(6)
	_AC_NECK_ROTATE(0, 0, 0, 4)
	_AC_DIR_VAL(8, 340)
	_AC_WAIT(30)
	_AC_DIR_U(8)
	_ACMD_END()
anm_c07_wake_exit_2:
	_AC_DIR_D(4)
	_AC_DOWN(8, 8)
	_ACMD_END()
ev_c07_sketchy_shopkeeper:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_sketchy_trader_1', 'Hey kid, wanna buy some wares?\nI got some stuff for ya.\rJust don’t ask me where they’re from.')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c07_sketchy_fix_shop_re')
	_END()
ev_c07_sketchy_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c07_sketchy_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c07_sketchy_fix_shop_buy')
	_CASE_JUMP(1, 'ev_c07_sketchy_fix_shop_end')
	_JUMP('ev_c07_sketchy_fix_shop_end')
	_END()
ev_c07_sketchy_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c07', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c07_sketchy_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(17)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c04r0501_fix_shop_re')
	_END()
ev_c07_sketchy_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07_vita:
	_TALK_OBJ_START_TURN_NOT()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SXY_POS_CHANGE('HERO', 687, 591)
	_SXY_DIR_CHANGE('HERO', 180)
	_OBJ_ANIME('HERO', 'anm_c07_vita_neck_down')
	_EVENT_CAMERA_INDEX(558)
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_IF_FLAGON_JUMP(#4010, 'ev_c07_vita_intro_no_return'); Vita has been talked to once but rejected
	_IF_FLAGON_JUMP(#4011, 'ev_c07_vita_return_first_time'); Vita has been talked to once and accepted
	_IF_FLAGON_JUMP(#4012, 'ev_c07_vita_return'); Vita has already introduced themselves after coming back (skip introduction)
	_IF_FLAGON_JUMP(#4020, 'ev_c07_vita_quest_completed'); Vita quest has been completed, all capsules received
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_1', 'Oh, hello! I’m a scientist who used to work for\nTeam Galactic.\rDo you think that makes me a bad person?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_vita_intro') ;No
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_sad_face')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_2', 'Wait, you haven’t even heard what I’m working\non yet!') ;Yes
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_normal_face')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_intro:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_1', 'Phew. Hear that, Min? Someone still believes\nin us!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('C07_MIN', 'C07_VITA')
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_down'); Look to Min
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_happy')
	_OBJ_ANIME('C07_MIN', 'anm_c07_vita_happy')
	_PLAY_EMO_SE(11)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_to_player'); Look back to player
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_2', 'You’ll be glad you listened, Trainer! I’m\nworking on a new way to enhance a Pokémon’s\fnatural potential much faster than battles.\rUnlike buying pricy vitamins at the department\nstore my device uses special technology to\fmake the capsules out of thin air!\rI’m sure you’re wondering how it does such a\nmiraculous thing. Well...')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_exclamation')
	_PLAY_EMO_SE(0)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_3', 'Wait a minute! I’m not telling! If I told you,\nit wouldn’t be a secret anymore, would it?\rBut that’s not important right now\nI have a pressing matter that needs to be\fattended to, and I can’t lollygag!\rI need to collect much more data if I’m ever to\nfinish the Pro-Vitamins themselves.\rUnfortunately, as good as I am at developing\nbreakthroughs, I struggle to figure out battle\fstrategies...')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_down'); Look to Min
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_sad')
	_OBJ_ANIME('C07_MIN', 'anm_c07_vita_sad')
	_PLAY_EMO_SE(8)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_to_player'); Look back to player
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_4', 'I even tried asking those trainers at the\nBattle Café to the south, but they wouldn’t\feven give me the time of day unless I battled\fthem first! What do you say, can you help me?!')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_vita_intro_yes'); Yes
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_vita_intro_no'); No
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_intro_yes:
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_happy_face')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_yes', 'Excellent! To get started, I’ll need you to bring\nme a Pokémon who’s put everything they have\finto a specific aspect of battling.\rOnce you do, I can analyze it, archive its data,\nand that should allow the pack to produce\funlimited Pro-Vitamins of that kind.')
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_normal_face')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET(#4010)
	_FLAG_SET(#4011)
	_RET()
ev_c07_vita_intro_no:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_no', 'Wh-what?! But just think of all the latent power\nhiding inside your Pokémon!')
	_FLAG_SET(#4010)
	_RET()
ev_c07_vita_intro_no_return:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_intro_no_return', 'Oh, you’re back! Does that mean you’re going\nto help me achieve my dream?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c07_vita_intro_yes') ; Yes
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c07_vita_intro_no') ; No
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_return_first_time:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_return_first_time_1', 'Welcome back, uhm... I just realized, we never\nintroduced ourselves!\rMy name is Vita! This cutie next to me is my\npartner in crime—Oops, maybe just my partner,\fnow.\rSay hello, Min!')
	_SE_PLAY('PLAY_PV_312_00_00')
	_OBJ_ANIME('C07_MIN', 'anm_c07_vita_happy')
	_PLAY_EMO_SE(5)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_return_first_time_2', 'Miiiiiiinun!')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_return_first_time_3', 'And you are...?\r{0}, I see!\nNow that we all know each other, let’s get\fright to it!\rDo you have a Pokémon to show me?')
	_TALK_CLOSE()
	_FLAG_SET(#4012); Skip first time introduction next time
	_FLAG_RESET(#4011)
	_JUMP('ev_c07_vita_check_pkmn')
	_END()
ev_c07_vita_return:
	; Check how many badges have already been received, compared to how many capsules have been received
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER)
	_SUB_WK(@SCWK_ANSWER, 2); Substract 2 since you only count from badge 3 to 8
	_IFVAL_JUMP(@SCWK_ANSWER, 'LE', @571, 'ev_c07_vita_no_badge') ; If the player comes back after already submitting a maxed Pokémon but without a new badge
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_return_1', 'Let’s get right to it!\nDo you have a Pokémon to show me?')
	_TALK_CLOSE()
	_JUMP('ev_c07_vita_check_pkmn')
	_END()
ev_c07_vita_no_badge:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_no_badge', 'Check back after you get your next badge.\nI should be all finished by then.')
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_check_pkmn:
	;Open Pokémon box selection
	_POKELIST_SET_PROC(0); Any Pokémon from Box or Party
	_POKELIST_GET_RESULT(@SCWK_TEMP0, @SCWK_TEMP1)
	; If selection was interrupted (both resulting works are -1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', -1, 'ev_c07_vita_check_pkmn_close')
	_TEMOTI_BOX_MONSNO(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2); Save the selected Pokémon number to be referenced later
	_TEMOTI_BOX_EV_IV(@SCWK_TEMP0, @SCWK_TEMP1, 0, @LOCALWORK0, @LOCALWORK7); HP
	_TEMOTI_BOX_EV_IV(@SCWK_TEMP0, @SCWK_TEMP1, 1, @LOCALWORK1, @LOCALWORK7); Attack
	_TEMOTI_BOX_EV_IV(@SCWK_TEMP0, @SCWK_TEMP1, 2, @LOCALWORK2, @LOCALWORK7); Defense
	_TEMOTI_BOX_EV_IV(@SCWK_TEMP0, @SCWK_TEMP1, 3, @LOCALWORK3, @LOCALWORK7); Sp.Atk
	_TEMOTI_BOX_EV_IV(@SCWK_TEMP0, @SCWK_TEMP1, 4, @LOCALWORK4, @LOCALWORK7); Sp.Def
	_TEMOTI_BOX_EV_IV(@SCWK_TEMP0, @SCWK_TEMP1, 5, @LOCALWORK5, @LOCALWORK7); Speed
	_IFVAL_CALL(@LOCALWORK0, 'GE', 252, 'ev_c07_vita_max_hp'); If HP maxed
	_IFVAL_CALL(@LOCALWORK1, 'GE', 252, 'ev_c07_vita_max_atk'); If Attack maxed
	_IFVAL_CALL(@LOCALWORK2, 'GE', 252, 'ev_c07_vita_max_defense'); If Defense maxed
	_IFVAL_CALL(@LOCALWORK3, 'GE', 252, 'ev_c07_vita_max_spatk'); If Sp. Attack maxed
	_IFVAL_CALL(@LOCALWORK4, 'GE', 252, 'ev_c07_vita_max_spdefense'); If Sp. Defense maxed
	_IFVAL_CALL(@LOCALWORK5, 'GE', 252, 'ev_c07_vita_max_speed'); If Speed maxed
	;If no stat is maxed
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_check_pkmn_no_max', 'Uh, {0}...\nI don’t think this one is ready yet.\rIs there another one you meant to show me\ninstead?')
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_check_pkmn_close:
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_check_pkmn_no_select', 'What’s wrong, forget where you put them or\nsomething?\rCome back when you’re ready, but please\nhurry! The anticipation is too much!')
	_TALK_CLOSE()
	_CALL('ev_c07_vita_camera_end')
	_TALK_OBJ_END()
	_END()
ev_c07_vita_max_common:
	;If first time reward
	_IF_FLAGOFF_CALL(#4013, 'ev_c07_vita_first_time_reward')
	_POKEMON_NAME_EXTRA(0, @SCWK_TEMP2, 0, 0); Pokémon number stored when the Pokémon was selected
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max', 'Now, let’s see exactly what area of battle\nthis {0} is the peak of.')
	_RET()
ev_c07_vita_first_time_reward:
	_POKEMON_NAME_EXTRA(0, @SCWK_TEMP2, 0, 0); Pokémon number stored when the Pokémon was selected
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_first_time_reward_1', 'Yes! That’s exactly what I mean!\nThis {0} has reached a pinnacle!\rPerfect timing, too, as I just finished up\nthe Pro-Vitamin Pack. Here!')
	_LDVAL(@SCWK_TEMP0, 1308); Pro-Vitamins
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_first_time_reward_2', 'That colorful contraption is exactly what will\nmake all of your Pro-Vitamins for you.\rJust input the value you want, and it will do\nthe rest!')
	_RET()
ev_c07_vita_max_hp:
	_IF_FLAGOFF_JUMP(#4014, 'ev_c07_vita_max_hp_reward'); If the maxed HP stat hasn't been submited already
	_RET(); If it has been submited, return to check the next stat
ev_c07_vita_max_hp_reward:
	_CALL('ev_c07_vita_max_common')
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_hp_reward_1', 'Oh, {1}, your {0}!\nIt’s got as much vitality as I’ve ever seen,\fit’s positively brimming with energy!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_exclamation')
	_PLAY_EMO_SE(0)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_hp_reward_2', 'That gives me an idea...')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_down'); Look to Min
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07_VITA', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_think')
	_PLAY_EMO_SE(9)
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07_VITA', 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_eureka')
	_PLAY_EMO_SE(1)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_to_player'); Look back to player
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_hp_reward_3', 'Voila! An HP Up Capsule, ready for testing!')
	;TODO give HP Up capsule
	_FLAG_SET(#4014); HP Capsule received
	_ADD_WK(@571, 1); +1 to the number of capsules already received
	_IFVAL_JUMP(@571, 'EQ', 6, 'ev_c07_vita_reward_last_end'); If all 6 capsules have already been received
	_JUMP('ev_c07_vita_reward_end')
	_END()
ev_c07_vita_max_atk:
	_IF_FLAGOFF_JUMP(#4015, 'ev_c07_vita_max_atk_reward'); If the maxed Atk stat hasn't been submited already
	_RET(); If it has been submited, return to check the next stat
ev_c07_vita_max_atk_reward:
	_CALL('ev_c07_vita_max_common')
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_atk_reward_1', '{1}, this {0} \ncould knock me over with just a glance!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_exclamation')
	_PLAY_EMO_SE(0)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_atk_reward_2', 'How did it take me this long?!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_down'); Look to Min
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07_VITA', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_think')
	_PLAY_EMO_SE(9)
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07_VITA', 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_eureka')
	_PLAY_EMO_SE(1)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_to_player'); Look back to player
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_atk_reward_3', 'Tada! Here’s the brand new Protein Capsule,\nready for testing!')
	;TODO give Atk Up capsule
	_FLAG_SET(#4015); Atk Capsule received
	_ADD_WK(@571, 1); +1 to the number of capsules already received
	_IFVAL_JUMP(@571, 'EQ', 6, 'ev_c07_vita_reward_last_end'); If all 6 capsules have already been received
	_JUMP('ev_c07_vita_reward_end')
	_END()
ev_c07_vita_max_defense:
	_IF_FLAGOFF_JUMP(#4016, 'ev_c07_vita_max_defense_reward'); If the maxed Defense stat hasn't been submited already
	_RET(); If it has been submited, return to check the next stat
ev_c07_vita_max_defense_reward:
	_CALL('ev_c07_vita_max_common')
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_defense_reward_1', 'I’ve never seen a sturdier {0}, {1}.\nI could probably Tackle it myself and not even\fsee it budge!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_exclamation')
	_PLAY_EMO_SE(0)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_defense_reward_2', 'Of course!')
	_TALK_CLOSE()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_down'); Look to Min
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07_VITA', 1)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_think')
	_PLAY_EMO_SE(9)
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('C07_VITA', 0)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_eureka')
	_PLAY_EMO_SE(1)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C07_VITA', 'anm_c07_vita_neck_to_player'); Look back to player
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c07','00_msg_c07_vita_max_defense_reward_3', 'Check it out! The Iron Capsule is completed!')
	;TODO give Defense Up capsule
	_FLAG_SET(#4016); Defense Capsule received
	_ADD_WK(@571, 1); +1 to the number of capsules already received
	_IFVAL_JUMP(@571, 'EQ', 6, 'ev_c07_vita_reward_last_end'); If all 6 capsules have already been received
	_JUMP('ev_c07_vita_reward_end')
	_END()
