ev_c02_doctor:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_doctor_03_1', 'Hmm... What is taking place at Lake Valor?\nYou must find out!')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_doctor_03_2', 'But before you go, I can’t stress this enough:\ndon’t get in over your head.\rWe will try to join you as soon as we inspect\nLake Verity.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02_support:
	_TALK_OBJ_START()
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02_male_support_01')
	_JUMP('c02_female_support_01')
	_JUMP('common_c02_doctor_20')
c02_male_support_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_heroine_02', 'We’re going off to Lake Verity first. If there turns\nout to be trouble, don’t do anything rash.')
	_JUMP('common_c02_doctor_20')
	_JUMP('common_c02_doctor_20')
c02_female_support_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_hero_02', 'We’re going to investigate Lake Verity before we\njoin you. Don’t be a hero if things go south.')
	_JUMP('common_c02_doctor_20')
	_JUMP('common_c02_doctor_20')
common_c02_doctor_20:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02_bigman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02_bigman_02')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_bigman_01', 'What’s up? Your clothes look damp. Were you\nswimming at the beach right by Sandgem Town?')
	_JUMP('common_c02_l02_news_end')
	_JUMP('common_c02_l02_news_end')
ev_c02_bigman_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_bigman_02', 'That tremor sure didn’t feel like an earthquake...\nIt felt more like an explosion.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('common_c02_l02_news_end')
common_c02_l02_news_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02_man1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02_man1_02')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_man1_01', 'Welcome to Canalave, the canal city!\rIn the old days, this port used to be a hub\nfor cargo transportation.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_man1_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_man1_02', 'What was that tremor? For a moment I thought\nMount Coronet had erupted!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_woman3:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02_woman3_02')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_woman3_01', 'I’m going to study at the library. Aren’t books\njust lovely?\rI love how reading takes me to places far away\nin time and space.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_woman3_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_woman3_02', 'An explosion at Lake Valor? But there isn’t\nanything there, is there?')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_girl1a:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02_girl1_02')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_girl1_01', 'My Psyduck is very smart. It can use the move\nFuture Sight!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_girl1_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_girl1_02', 'N-not even m-my Psyduck’s Future Sight could\nforetell that tremor!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_koduck:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02_koduck_02')
	_VOICE_PLAY(54, 0, 0)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_koduck_01', 'Gua?')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_koduck_02:
	_VOICE_PLAY(54, 0, 0)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_koduck_02', 'Gua! Gua! Gwa? Guaa! Guuagwa?!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_oldman2:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02_oldman2_02')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_oldman2_01', 'The Gym Leader and Trainers of this Gym often\ngo out to Iron Island. They not only train their\fPokémon there but work out as well.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_oldman2_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_oldman2_02', 'I’m flabbergasted!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_mini:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C02_SEAL_GET1, 'ev_c02_mini_02')
	_IF_FLAGON_JUMP(#FE_C02R0301_MONOWASURE_FIRST, 'ev_c02_mini_01')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_girl1_iro_01', 'I hear that there is a man who is very forgetful\nhere in Canalave City.\rHe even makes Pokémon forget their moves.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_mini_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_girl1_iro_02', 'You met the guy that everyone is talking about!\rWow! He really does make Pokémon forget\ntheir moves.\rThank you for letting me know. Here, please\ntake these.')
	_LDVAL(@SCWK_TEMP0, 54)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C02_SEAL_GET1)
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_mini_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_girl1_iro_03', 'Oh... I forgot what I was talking about just now.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_campboy:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C02_SEAL_GET2, 'ev_c02_campboy_02')
	_IF_FLAGON_JUMP(#FV_FLD_ITEM_134, 'ev_c02_campboy_01')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_campboy_iro_01', 'My brilliant instinct tells me that there is a secret\npath somewhere in this city, and there is treasure\fbeyond the path!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_campboy_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_campboy_iro_02', 'Whoa! There was actually something there?\nI mean, my instinct about my brilliant instinct\fbeing correct turned out to be correct!\rThese are my thank-you gift.')
	_LDVAL(@SCWK_TEMP0, 62)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C02_SEAL_GET2)
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_campboy_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_campboy_iro_03', 'Hmmm... My brilliant instinct tells me that you’ll\naccomplish something great in the future.')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_caranakushi:
	_TALK_OBJ_START()
	_SE_PLAY('PLAY_PV_EV_422_00_00')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_karakunasi', 'Shelli nooo!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
ev_c02_camome:
	_TALK_OBJ_START()
	_SE_PLAY('PLAY_PV_EV_278_00_00', 0, 0)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_kyamome', 'Gullgullooo!')
	_JUMP('common_c02_l02_news_end')
	_JUMP('ev_c02_sign1')
