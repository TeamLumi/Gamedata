	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_rival_03_2', 'Of course, I’m tougher, so that’s not actually\ngoing to happen.\rAnyways, {1,1,0,0}, come with me to\nthe library.', 1, 1)
