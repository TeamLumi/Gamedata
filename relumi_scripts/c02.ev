	_JUMP('common_c02_doctor_10')
	_JUMP('common_c02_doctor_10')
c02_female_doctor_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_hero_01', 'What happened at Lake Valor? I wonder...')
	_JUMP('common_c02_doctor_10')
	_JUMP('common_c02_doctor_10')
