ev_c02_ship:
	_CALL('ev_another_out')
	_TALK_OBJ_START()
	_CALL('ev_block_doc')
	_PLAYER_DIR_GET(@SCWK_TEMP0)
	_TURN_HERO_SITE()
	_IFVAL_JUMP(@WK_SCENE_C02R0501, 'EQ', 2, 'ev_c02_seaman_event_a')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_01', 'Do you wanna set sail?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_213', 0)
	_IF_FLAGON_CALL(#FE_D15_UNSEAL, 'ev_c02_ship_03')
	_IF_FLAGON_CALL(#FE_D30R0101_LEGEND_CLEAR, 'ev_c02_ship_04')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_218', 3)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c02_ship_in1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02_ship_in2')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c02_ship_in3')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 3, 'ev_c02_ship_end')
	_JUMP('ev_c02_ship_end')
	_END()
ev_c02_ship_04:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_215', 2)
	_RET()
ev_c02_ship_03:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_214', 1)
	_RET()
