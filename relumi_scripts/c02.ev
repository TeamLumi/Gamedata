	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_rival_02_1', 'Yeah, yeah... You’re just a bit better than me,\nas usual. But listen up!')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_rival_02_2', 'Let me tell you who’s going to take on the\nPokémon League and become the Champion.\rYou guessed right—it’s going to be me!', 1)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_rival_02_3', 'Anyway, you should go to Iron Island\nand toughen up some more.\rYeah, train at Iron Island! That’s what\nI did before going to the Gym!')
