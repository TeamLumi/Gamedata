	_CALL_SHIP_DEMO('P_C_001_Ship_02', 0)
	_TIME_WAIT(27, @SCWK_TEMP1)
	_TIME_WAIT(3, @SCWK_TEMP1)
	_SE_PLAY('S_FI228')
	_EVENT_ENTITY_CLIP_PLAY('P_T_012_Drawbridge_02', 1)
	_EVENT_ENTITY_CLIP_PLAY('P_T_012_Drawbridge_02_2', 1)
	_EVENT_ENTITY_CLIP_WAIT('P_T_012_Drawbridge_02')
	_TIME_WAIT(15, @SCWK_TEMP1)
	_BLACK_OUT()
	_RET()
ev_c02_ship_in1:
	_CALL('ev_c02_seaman02_ship_in')
	_GET_REL_POS_HERO('C02_SHIP', @SCWK_TEMP2)
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 4, 'ev_c02_seaman02_R1_004')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 2, 'ev_c02_seaman02_R1_002')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 8, 'ev_c02_seaman02_R1_008')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 7, 'ev_c02_seaman02_R1_007')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_c02_seaman02_R1_001')
	_CALL('ev_c02_ship_in_common')
	_LDVAL(@SCWK_REG1, 101)
	_MAP_CHANGE('SEA01', 0)
	_TALK_OBJ_END()
	_CALL('ev_another_out_end')
	_END()
ev_c02_ship_in2:
	_CALL('ev_c02_seaman02_ship_in')
	_GET_REL_POS_HERO('C02_SHIP', @SCWK_TEMP2)
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 4, 'ev_c02_seaman02_R1_004')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 2, 'ev_c02_seaman02_R1_002')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 8, 'ev_c02_seaman02_R1_008')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 7, 'ev_c02_seaman02_R1_007')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_c02_seaman02_R1_001')
	_CALL('ev_c02_ship_in_common')
	_CALL('ev_another_out_end')
	_LDVAL(@SCWK_REG1, 102)
	_MAP_CHANGE('SEA01', 0)
	_TALK_OBJ_END()
	_END()
ev_c02_ship_in3:
	_GET_REL_POS_HERO('C02_SHIP', @SCWK_TEMP2)
	_CALL('ev_c02_seaman02_ship_in')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 4, 'ev_c02_seaman02_R1_004')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 2, 'ev_c02_seaman02_R1_002')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 8, 'ev_c02_seaman02_R1_008')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 7, 'ev_c02_seaman02_R1_007')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_c02_seaman02_R1_001')
	_CALL('ev_c02_ship_in_common')
	_CALL('ev_another_out_end')
	_LDVAL(@SCWK_REG1, 103)
	_MAP_CHANGE('SEA01', 0)
	_TALK_OBJ_END()
	_END()
ev_c02_ship_end:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_03', 'You just tell me whenever you need to set sail!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_CALL('ev_block_doc_end')
	_CALL('ev_another_out_end')
	_END()
ev_c02_seaman02_ship_in:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_02', 'Aye, aye! Anchors aweigh!')
	_TALK_CLOSE()
	_OBJ_ANIME('C02_SHIP', 'anm_c02_ship_seaman_02')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('C02_SHIP', 'anm_c02_ship_vanish_in')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c02_seaman02_R1_008:
	_OBJ_ANIME('HERO', 'anm_c02_ship_player_d')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('HERO', 'anm_c02_ship_vanish_in')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c02_seaman02_R1_007:
	_OBJ_ANIME('HERO', 'anm_c02_ship_player_d2')
	_OBJ_ANIME_WAIT()
