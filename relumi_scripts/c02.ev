ev_c02_flag_change:
	_CALL('ev_box_close')
	_IF_FLAGON_CALL(#FE_USE_SHIP, 'ev_c02_init_ship')
	_OBJ_DIR_CHANGE('C02_RIVAL', 270)
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 8300, 'ev_c02_guide_upd')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 8350, 'ev_c02_guide_upd')
	_IFVAL_CALL(@WK_SCENE_C02R0401, 'EQ', 2, 'ev_c04_flag_change_c02r0401_reset')
	_IFVAL_CALL(@WK_SCENE_C02R0401, 'EQ', 4, 'ev_c04_flag_change_c02r0401_reset')
