ev_c02_doctor_l02_news:
	_EVENT_START()
	_CALL('ev_another_out')
	_OBJ_ANIME('C02_DOCTOR', 'anm_c02_doctor_01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_doctor_01', 'Whoa!\nThat tremor... That wasn’t a natural occurrence.')
	_TALK_CLOSE()
	_FLAG_RESET(#FV_C02_SEAMAN)
	_OBJ_ADD('C02_SEAMAN')
	_OBJ_PAUSE('C02_SEAMAN')
	_OBJ_ANIME('C02_SEAMAN', 'anm_c02_seaman_01')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C02_RIVAL', 'C02_SEAMAN')
	_CHARA_LOOK_LOCK('HERO', 'C02_SEAMAN')
	_EVENT_CAMERA_INDEX(271)
	_OBJ_ANIME('C02_SEAMAN', 'anm_c02_seaman_01a')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(272)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman1_01_1', 'Hey, hey! Old dude and kids! Something big\njust happened!\rThey’re saying there was a huge explosion at\nLake Valor!')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman1_01_2', '<size=250%>Ka-boom!!!</size>\rLike that!', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C02_RIVAL')
	_OBJ_ANIME('C02_SEAMAN', 'anm_c02_seaman_02')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C02_SEAMAN')
	_CHARA_LOOK_LOCK('C02_RIVAL', 'C02_DOCTOR')
	_CHARA_LOOK_LOCK('C02_DOCTOR', 'C02_RIVAL')
	_CHARA_LOOK_LOCK('HERO', 'C02_RIVAL')
	_CHARA_LOOK_LOCK('C02_SUPPORT', 'C02_RIVAL')
	_EVENT_CAMERA_INDEX(273)
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_rival_04', 'Gramps, I’m going to the lake! I have a bad\nfeeling about this!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(274)
	_CHARA_LOOK_RELEASE('C02_RIVAL')
	_OBJ_ANIME('C02_RIVAL', 'anm_c02_rival_10')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C02_DOCTOR')
	_CHARA_LOOK_RELEASE('C02_SUPPORT')
	_OBJ_ANIME('C02_RIVAL', 'anm_c02_rival_10a')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C02_RIVAL')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_doctor_02_1', 'Hmph! That {0,1,0,0} can’t sit still...\r{1,1,0,0}, I’m worried about Lake Valor.')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('C02_DOCTOR', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C02_DOCTOR')
	_EVENT_CAMERA_INDEX(275)
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_doctor_02_2', 'However, I have no idea what is taking place.\nYou must find out!\rBut before you go, I can’t stress this enough:\ndon’t get in over your head.\rWe will try to join you as soon as we inspect\nLake Verity.', 1)
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('C02_SUPPORT', 'HERO')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02_male_doctor_01')
	_JUMP('c02_female_doctor_01')
	_JUMP('common_c02_doctor_10')
