	_ACMD_END()
anm_c02_ship_player_d:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_R(8)
	_AC_WAIT(15)
	_ACMD_END()
anm_c02_ship_player_d2:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_WAIT(15)
	_ACMD_END()
anm_c02_ship_player_r:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_WAIT(15)
	_ACMD_END()
anm_c02_ship_player_u:
	_AC_DIR_U(4)
	_AC_UP(1, 8)
	_AC_DIR_R(4)
	_AC_WAIT(15)
	_ACMD_END()
anm_c02_ship_player_u2:
	_AC_DIR_U(4)
	_AC_UP(1, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_WAIT(15)
	_ACMD_END()
ev_c02_seaman_event_a:
	_ITEM_CHK(453, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02_seaman_a_02')
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_a_01', 'I’ve lost my love of sailing since my son fell into\nthat horrid nightmare... I need the Lunar Feather\ffrom Fullmoon Island to awaken him!\rWould you go to Fullmoon Island for me?\nIf not for me, then for my son?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'yes_c02_seaman_a_01')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_c02_seaman_a_01')
	_CALL('ev_block_doc_end')
	_END()
yes_c02_seaman_a_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_a_02', 'Only you can awaken my son from his awful\nnightmare. We’re both counting on you!\rPlease, I need the Lunar Feather from Fullmoon\nIsland to awaken him!')
	_TALK_CLOSE()
	_JUMP('ev_c02_ship_in2')
	_JUMP('no_c02_seaman_a_01')
no_c02_seaman_a_01:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_a_03', 'Do you need to get ready? I’ll be waiting here.\nWe’re desperate for your help.')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
ev_c02_seaman_a_02:
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_a_05', 'Please! Take the Lunar Feather to my son...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_CALL('ev_block_doc_end')
	_CALL('ev_another_out_end')
	_END()
ev_c02_seaman_event_b:
	_EVENT_START()
	_CALL('ev_another_out')
	_OBJ_ANIME('C02_SEAMAN', 'anm_c02_seaman_50')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02', '161-msg_c02_seaman_a_04', 'You’ve been asleep for a long, long time...\nWhat happened to you?\rAnd what were you doing here? No one has lived\nhere for 50 years.')
	_TALK_CLOSE()
	_OBJ_ANIME('C02_SEAMAN', 'anm_c02_seaman_51')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C02_SEAMAN')
	_FLAG_SET(#FV_C02_SEAMAN)
	_LDVAL(@WK_SCENE_C02R0401, 4)
	_CALL('ev_another_out_end')
	_TALK_END()
	_END()
anm_c02_seaman_50:
	_AC_MARK_GYOE(1)
	_AC_DIR_R(4)
	_AC_RIGHT(3, 8)
	_AC_DIR_U(4)
	_AC_UP(1, 8)
	_ACMD_END()
anm_c02_seaman_51:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_L(4)
	_AC_LEFT(3, 8)
	_AC_DIR_D(4)
	_AC_DOWN(8, 8)
	_ACMD_END()
anm_c02_ship_end:
	_AC_INVISIBLE_OFF()
	_ACMD_END()
ev_c02_rival_blocker:
	_IF_FLAGON_JUMP(#FE_HIDEN_04_GET, 'ev_c02_rival_blocker_got_strength')
	_RIVAL_NAME(0)
	_MACRO_EASY_OBJ_MSG('dialogue_c02', '00_msg_c02_rival_blocker_1', 'Too slow!\rCome on!\nLet’s move it!')
	_END()
ev_c02_rival_blocker_got_strength:
	_RIVAL_NAME(0)
	_MACRO_EASY_OBJ_MSG('dialogue_c02', '00_msg_c02_rival_blocker_1', 'Too slow!\rCome on!\nLet’s move it!')
	_OBJ_ANIME('C02_RIVAL_BLOCKER', 'anm_c02_rival_blocker_face_up')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI012')
	_SET_DOOR_OBJ('C02R0101_D01')
	_HIT_DOOR_ANIME(0)
	_OBJ_ANIME('C02_RIVAL_BLOCKER', 'anm_c02_rival_blocker_walk_up')
	_OBJ_ANIME_WAIT()
	_HIT_DOOR_ANIME_WAIT()
	_SE_PLAY('S_FI013')
	_SET_DOOR_OBJ('C02R0101_D01')
	_HIT_DOOR_ANIME(1)
	_OBJ_DEL('C02_RIVAL_BLOCKER')
	_FLAG_SET(#2825)
	_END()
anm_c02_rival_blocker_face_up:
	_AC_DIR_U(4)
	_ACMD_END()
anm_c02_rival_blocker_walk_up:
	_AC_UP(1, 8)
	_AC_INVISIBLE_ON()
	_ACMD_END()
ev_c02_advice_dude:
	_MACRO_EASY_OBJ_MSG('dialogue_c02', '00_msg_c02_advice_dude_1', 'How’s it going, Champ-to-be?\nThe Gym Leader isn’t here right now.\rAfter our last challenger bolted off,\nByron went over to Iron Island for\fa break.\rYou can go over there to look for him,\nif you’d like.\rJust talk to Eldritch!\nHe’s the sailor at the port.\rYou should get some training in, too.\nIron Island is a popular spot for it!')
	_END()