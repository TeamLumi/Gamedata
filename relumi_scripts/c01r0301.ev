ev_c01r0301_man3:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0301', '43-msg_c01r0301_man3_01', 'Pokémon are wonderful, deeply\nmysterious creatures.\rBut to Trainers, it seems the only thing that\nmatters is battling!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0301_girl1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0301', '43-msg_c01r0301_girl1_01_1', 'Hello there, Trainer!\rIf you get stumped and don’t know what to do...')
	_MACRO_TALKMSG('dialogue_c01r0301', '43-msg_c01r0301_girl1_01_2', 'Talk to people! Talk to everyone you see!\rGo places! Go wherever you can!\rYou’ll find many new places by doing just that.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()