ev_r212ar0101_script_17:
	_OBJ_DEL('R212AR0101_RIVAL_OW23')
	_SXY_POS_CHANGE('R212AR0101_RIVAL_OW23', 42, 7)
	_OBJ_ADD('R212AR0101_RIVAL_OW23')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_60', '{0,1,0,0}!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_r212ar0101_action_14')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R212AR0101_RIVAL_OW23', 'anm_r212ar0101_action_23')
	_OBJ_ANIME('HERO', 'anm_r212ar0101_action_24')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_61', 'Whew! I thought that wouldn’t\never end!\rKeeping to turn limits is hard!\rSo, have we beat all the goons?\nOr are there still more?')
	_TALK_CLOSE()
	_OBJ_DEL('R212AR0101_SATURN_OW24')
	_SXY_POS_CHANGE('R212AR0101_SATURN_OW24', 33, 3)
	_OBJ_ADD('R212AR0101_SATURN_OW24')
	_SE_PLAY('S_FI013')
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_action_14')
	_OBJ_ANIME('R212AR0101_RIVAL_OW23', 'anm_r212ar0101_action_25')
	_OBJ_ANIME('HERO', 'anm_r212ar0101_action_25')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_62', 'Hm? Who are you children?\nWhere are the grunts I left?')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_action_26')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_63', 'Come along, Mr. Backlot.')
	_TALK_CLOSE()
	_OBJ_DEL('R212AR0101_OWNER_OW25')
	_SXY_POS_CHANGE('R212AR0101_OWNER_OW25', 33, 3)
	_SE_PLAY('S_FI013')
	_OBJ_ADD('R212AR0101_OWNER_OW25')
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_64', 'Yes, yes, I suppose I must...\nAh... My poor Pokémon Mansion...')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(569)
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_action_28')
	_OBJ_ANIME('R212AR0101_OWNER_OW25', 'anm_r212ar0101_action_27')
	_TIME_WAIT(45, @SCWK_ANSWER)
	_FIND_BG_DISABLE(0, 'P_C_001_Statue_01/P_C_001_Statue_01 (2)')
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('R212AR0101_SATURN_OW24', 1)
	_TIME_WAIT(25, @SCWK_ANSWER)
	_SET_FORCE_BLINK('R212AR0101_SATURN_OW24', 0)
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_1', 'You...\nI recognise your face from the security footage!')
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_face_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_2', 'You’re the child who raided the Team Galactic\nBuilding in Eterna!')
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_face_1')
	_OBJ_ANIME_WAIT()
	_SET_FORCE_BLINK('R212AR0101_SATURN_OW24', 1)
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_3', 'Humph! Jupiter should be ashamed of herself,\nbeing beaten by a child like that.')
	_SET_FORCE_BLINK('R212AR0101_SATURN_OW24', 0)
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_face_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_4', 'But anything that continues to oppose\nTeam Galactic must be crushed!')
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_face_1')
	_OBJ_ANIME_WAIT()
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_saturn_neck_left')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_66', 'Come, Mr. Backlot. You’ll help me eject\nthese children from your home, yes?')
	_OBJ_ANIME('R212AR0101_OWNER_OW25', 'anm_r212ar0101_backlot_neck_down')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_67', 'Ahh! I would prefer not...\nBut I suppose I must...\rMy poor beautiful Pokémon, used for\nsuch a boorish task...')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_saturn_neck_normal')
	_OBJ_ANIME('R212AR0101_RIVAL_OW23', 'anm_r212ar0101_action_30')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_68', 'OK, {0,1,0,0}, no problem!\nLet’s team up and win this!\rWe can just heal the old man’s Pokémon\nafterwards! Don’t worry about him!!')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0101_RIVAL_OW23', 'anm_r212ar0101_action_31')
	_OBJ_ANIME('R212AR0101_OWNER_OW25', 'anm_r212ar0101_backlot_neck_normal')
	_OBJ_ANIME_WAIT()
	_LDVAL(@SCWK_TEMP1, 877)
	_LDVAL(@SCWK_TEMP2, 878)
	_CALL('pos_r212ar0101_rival_support')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_multi_battle')
	_EVENT_CAMERA_INDEX(111)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_FIND_BG_ENABLE(0, 'P_C_001_Statue_01/P_C_001_Statue_01 (2)')
	_EVENT_CAMERA_END_WAIT()
	_TRAINER_MULTI_BTL_SET(@SCWK_TEMP3, @SCWK_TEMP1, @SCWK_TEMP2)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_face_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_5', 'Gah! What makes you so tough?')
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_action_24')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_6', 'Not to mention this old man is\ncompletely useless.')
	_OBJ_ANIME('R212AR0101_SATURN_OW24', 'anm_r212ar0101_saturn_down_face_normal')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_7', 'Fine, we’ll leave. We’ve bargained with\nthis old man for the riches we need.')
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_saturn_8', 'Next time, I, Commander Saturn, will make\nsure your luck runs out.')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_DEL('R212AR0101_SATURN_OW24')
	_FLAG_SET(#2733)
	_FLAG_SET(#2734)
	_FLAG_SET(#2735)
	_FLAG_SET(#2736)
	_FLAG_SET(#2738)
	_FLAG_SET(#2737)
	_FLAG_SET(#2714)
	_FLAG_SET(#2715)
	_FLAG_SET(#2716)
	_FLAG_SET(#2747)
	_FLAG_SET(#2713)
	_LDVAL(@479, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6200)
	_FLAG_RESET(#2728)
	_OBJ_DEL('R212AR0101_RIVAL_OW20')
	_OBJ_DEL('R212AR0101_GRUNT_OW9')
	_OBJ_DEL('R212AR0101_GRUNT_OW8')
	_OBJ_ADD('R212AR0101_MAID_03')
	_OBJ_ADD('R212AR0101_MAID_04')
	_FLAG_SET(#2729)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('HERO', 'anm_hero_action_32')
	_OBJ_ANIME('R212AR0101_RIVAL_OW23', 'anm_r212ar0101_action_33')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_70', 'There, {0,1,0,0}, all sorted!\nNow it’s time to dash!\rI’m off to Solaceon Town!\nSee ya!\rYou’ll be shocked by my growth the\nnext time we meet!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('HERO', 'R212AR0101_RIVAL_OW23')
	_OBJ_ANIME('R212AR0101_RIVAL_OW23', 'anm_r212ar0101_action_34')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_OBJ_DEL('R212AR0101_RIVAL_OW23')
	_SE_WAIT('S_FI001')
	_CHARA_LOOK_RELEASE('HERO')
	_TIME_WAIT(5,@SCWK_ANSWER)
	_CHARA_LOOK_LOCK('HERO', 'R212AR0101_OWNER_OW25')
	_OBJ_ANIME('R212AR0101_OWNER_OW25', 'anm_r212ar0101_action_35')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_71', 'That friend of yours takes\noff very quickly, doesn’t he?\rThank you for coming to the aid\nof my Pokémon Mansion.\rThose Team Galactic people wanted some\nof my most valuable objects.\rWith their threats against my lovely\nstaff and the people of this mansion,\fI had no choice but to co-operate...\rAlas, I’m sure things will mostly\nreturn to normal, now.\rThere’s one particularly valuable item\nthat was not taken by them.\rIt is an unusual deep blue Pokémon Egg.\nLooking at it is like looking straight\finto the sea.\rI’m mentioning this because I’d like\nyou to have it as a reward for your\fbold actions and bravery today.\rPlease come to my office on the\nright when you’re ready.\rOh, and please do visit the\nTrophy Garden in the back.\rThe wild Pokémon in there are\nsimply exquisite!')
	_TALK_CLOSE()
	_OBJ_ANIME('R212AR0101_OWNER_OW25', 'anm_r212ar0101_action_36')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_DEL('R212AR0101_OWNER_OW25')
	_SE_WAIT('S_FI001')
	_TALK_END()
	_CALL('ev_block_doc_end')
	_END()
