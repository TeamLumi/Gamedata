ev_r212ar0101_grunt_challenge_return:
	_MACRO_TALKMSG('dialogue_r212ar0101', 'msg_r212ar0101_grunt_challenge_return', 'Come back to try again, eh?\rRemember, you need to beat three of us\nin a row, and in exactly 6 turns.\rFwahahaha!\nAre you up to the challenge?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0101_func_9')
	_RET()
ev_r212ar0101_grunt_challenge_initialise:
	_MACRO_TALKMSG('dialogue_r212ar0101', '00_msg_r212ar0101_msg_30', 'You’re not allowed through here!\rUnless you can beat three of us,\nin a row, and in exactly 6 turns.\rFwahahaha!\nAre you up to the challenge?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r212ar0101_func_9')
	_LDVAL(@450, 0); Initialises the 6 Turns Grunt Challenge pity system
	_FLAG_SET(#2745); 6 Turns Grunt has been spoken to once
	_RET()
