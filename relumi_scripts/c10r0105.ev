ev_c10r0105_flag_change:
	_IF_FLAGON_JUMP(#FE_BIGFOUR2_WIN, 'ev_c10r0105_bigfour2_set1')
	_IF_FLAGOFF_JUMP(#FE_BIGFOUR2_WIN, 'ev_c10r0105_bigfour2_set2')
	_END()
ev_c10r0105_bigfour2_set1:
	_IF_FLAGOFF_JUMP(#FH_02, 'ev_c10r0105_bigfour2_set1_end')
	_DOOR_ENABLE_SET('C10R0105_D02', 0)
	_DOOR_ENABLE_SET('C10R0105_D01', 0)
	_SET_DOOR_OBJ('C10R0105_D02')
	_HIT_DOOR_ANIME(0)
	_SXY_EXIT_POS_CHANGE(0, 7, 2)
	_END()
ev_c10r0105_bigfour2_set1_end:
	_END()
ev_c10r0105_bigfour2_set2:
	_DOOR_ENABLE_SET('C10R0105_D02', 0)
	_DOOR_ENABLE_SET('C10R0105_D01', 0)
	_SXY_EXIT_POS_CHANGE(0, 7, 0)
	_END()
ev_c10r0105_bigfour2:
	_IF_FLAGON_JUMP(#FE_BIGFOUR2_WIN, 'ev_c10r0105_bigfour2_02')
	_BGM_PLAY('EV214')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE3, 'ev_c10r0105_bigfour2_pupl3')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE2, 'ev_c10r0105_bigfour2_pupl2')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CALL('ev_block_doc')
	_OBJ_POS_CHANGE_WORLD('HERO', 8, 0, 6.600000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(88)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('C10R0105_BIGFOUR2', 'anm_c10r0105_bigfour2_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c10r0105', '21-msg_c10r0105_bigfour2_01_1', 'Well, well.\rYou’re quite the adorable Trainer, but you’ve also\ngot a spine.')
	_MACRO_TALKMSG('dialogue_c10r0105', '21-msg_c10r0105_bigfour2_01_2', 'Ahaha!\nI’m Bertha.\rI have a preference for Ground-type Pokémon.')
	_TALK_CLOSE()
	_OBJ_ANIME('C10R0105_BIGFOUR2', 'anm_c10r0105_bigfour2_face00')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c10r0105', '21-msg_c10r0105_bigfour2_01_3', 'Well, would you show this old lady how much\nyou’ve learned?')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(89)
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league02')
	_LDVAL(@WK_PLAY_REPO_NO, 22)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c10r0105_randomteam_bertha')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0105_bigfour2_win_common')
	_MACRO_TALKMSG('dialogue_c10r0105', '21-msg_c10r0105_bigfour2_02_1', 'You’re quite something, youngster. I like how you\nand your Pokémon earned the win by working\fas one.\rThat’s what makes you so strong.')
	_MACRO_TALKMSG('dialogue_c10r0105', '21-msg_c10r0105_bigfour2_02_2', 'Ahahaha!\nI think that you can go as far as you want.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0105_bigfour2_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0105_randomteam_bertha:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 859)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 860)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 861)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 862)
	_RET()
ev_c10r0105_randomteam_bertha_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 927)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 928)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 929)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 930)
	_RET()
ev_c10r0105_bigfour2_win_common:
	_FLAG_SET(#FE_BIGFOUR2_WIN)
	_RET()
ev_c10r0105_bigfour2_win_dooropen:
	_SET_DOOR_OBJ('C10R0105_D02')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI116')
	_HIT_DOOR_ANIME_WAIT()
	_SXY_EXIT_POS_CHANGE(0, 7, 2)
	_FLAG_SET(#FH_02)
	_RET()
anm_c10r0105_bigfour2_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c10r0105_bigfour2_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
ev_c10r0105_bigfour2_pupl2:
	_TALK_OBJ_START()
	_EVENT_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c10r0105', '20-msg_c10r0105_bigfour2_11_1', 'Well, well. I see you’ve returned, dear child.\rIt looks as though you’ve grown more confident\nsince the last time we met.\rBut don’t forget—with age comes the power to\nshake the earth, and a force of will that can split\fthe ground beneath your feet!\rAhahaha! Let this old lady show you what a little\nlife experience can do.')
	_TALK_CLOSE()
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league02')
	_LDVAL(@WK_PLAY_REPO_NO, 35)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c10r0105_randomteam_bertha_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0105_bigfour2_win_common')
	_MACRO_TALKMSG('dialogue_c10r0105', '20-msg_c10r0105_bigfour2_11_2', 'No matter how the world shifts, you and your\nPokémon will always be sure-footed.\rYou’re steadier today than all the days before!')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0105_bigfour2_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0105_bigfour2_pupl3:
	_TALK_OBJ_START()
	_EVENT_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c10r0105', '20-msg_c10r0105_bigfour2_21_1', 'Oh, if it isn’t {0,1,0,0}!\nYou sure look different from last time we met.\rWhy, now you hold yourself just like an adult.\nYou remind me of when I was young...\rAhahaha!\rBut I know you’re not here to hear an old lady’s\nramblings. Let’s let the battle do the talking.')
	_TALK_CLOSE()
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league02')
	_LDVAL(@WK_PLAY_REPO_NO, 40)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c10r0105_randomteam_bertha_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0105_bigfour2_win_common')
	_MACRO_TALKMSG('dialogue_c10r0105', '20-msg_c10r0105_bigfour2_21_2', 'Now then, let me leave you with a last little bit\nof advice....\rEven if you find yourself losing someday, and\neven if your feelings are crushed, remember to\fremain as strong as the earth beneath your feet.')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0105_bigfour2_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0105_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0105_bigfour2_02:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE3, 'ev_c10r0105_bigfour2_pupl3w')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE2, 'ev_c10r0105_bigfour2_pupl2w')
	_MACRO_TALKMSG('dialogue_c10r0105', '21-msg_c10r0105_bigfour2_03', 'The Trainer in the next room is a much more\nformidable opponent.\rYou really must have your wits about you.\rHowever, I think you can go as far as you desire.\rAhahaha!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0105_bigfour2_pupl2w:
	_MACRO_TALKMSG('dialogue_c10r0105', '20-msg_c10r0105_bigfour2_11_3', 'Ahahaha! Now continue to go as far as you want!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0105_bigfour2_pupl3w:
	_MACRO_TALKMSG('dialogue_c10r0105', '20-msg_c10r0105_bigfour2_21_3', 'Ahahaha!\rI look forward to seeing just how far you go!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0105_room_in:
	_EVENT_START()
	_SET_DOOR_OBJ('C10R0105_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI116')
	_OBJ_ANIME('HERO', 'anm_c10r0105_roomin_01')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET('C10R0105_D01')
	_SE_PLAY('S_FI117')
	_HIT_DOOR_ANIME(1)
	_HIT_DOOR_ANIME_WAIT()
	_DOOR_ENABLE_SET('C10R0105_D02', 0)
	_DOOR_ENABLE_SET('C10R0105_D01', 0)
	_SXY_EXIT_POS_CHANGE(0, 7, 0)
	_LDVAL(@WK_SCENE_CL_DOOR, 2)
	_TALK_END()
	_END()
anm_c10r0105_roomin_01:
	_AC_DIR_U(4)
	_AC_UP(2, 8)
	_ACMD_END()