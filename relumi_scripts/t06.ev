ev_t06_boy2:
	_MACRO_EASY_OBJ_MSG('dialogue_t06', '56-msg_t06_boy2_01', 'Hey, traveling Trainer. Is your Bag full of items?\nOr is it full of dreams?')
	_END()
ev_t06_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_t06', '56-msg_t06_girl2_01', 'Trainers who lose at the Battle Tower come here\nto hone their skills.')
	_END()
ev_t06_explore:
	_MACRO_EASY_OBJ_MSG('dialogue_t06', '56-msg_t06_explore_01', 'I’ve been exploring a long time, but I know when\nI’m beaten.\rIt takes a better Trainer than me to explore the\nvolcano thoroughly!')
	_END()
ev_t06_cameraman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_HIIDORAN_SEE, 'ev_t06_cameraman_03')
	_IF_FLAGON_JUMP(#FE_KAZANNOOKIISI_GET, 'ev_t06_cameraman_02')
	_MACRO_TALKMSG('dialogue_t06', '56-msg_t06_cameraman_01_1', 'I’m a cameraman, obviously.')
	_MACRO_TALKMSG('dialogue_t06', '56-msg_t06_cameraman_01_2', 'Have you ever seen the TV program called\n“Search for the Red Gyarados: The Mysterious\fAppearance of the Furious Pokémon in a Lake”?\rYou know, that outstanding documentary?\nYeah, I filmed that!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t06_cameraman_02:
	_MACRO_TALKMSG('dialogue_t06', '56-msg_t06_cameraman_02', 'Oh man! Oh jeez! Oh, this is bad!\rBut I’m a cameraman, obviously! I have to stand\nfirm and get this on film for the world to see!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t06_cameraman_03:
	_MACRO_TALKMSG('dialogue_t06', '56-msg_t06_cameraman_03_1', 'I’m a cameraman, obviously.\r“The Eruption of Stark Mountain? The Mystery of\nthe Fiery Pokémon Asleep Deep in the Volcano!”')
	_MACRO_TALKMSG('dialogue_t06', '56-msg_t06_cameraman_03_2', 'I’ve had that documentary all mapped out in my\nhead for a long time...\rBut I have nothing on film as of yet. So much for\nthat show.\rOh well. The world’s a huge place. There are\nplenty of other mysteries to catch on camera!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t06_sign01:
	_EASY_BOARD_MSG('dialogue_t06%56-msg_t06_sign01_01', 'BOARD_TYPE_TOWN', 0)
	_END()