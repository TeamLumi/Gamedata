ev_c05r0801_flag_change:
	_LDVAL(@WK_ELEVATOR_FLOOR, 0)
	_LDVAL(@LOCALWORK1, 0)
	_END()
ev_c05r0801_door_exit:
	_SET_DOOR_OBJ('C05R0103_D01')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 3, 'door_exit_elevator')
	_END()
ev_c05r0801_middlewoman1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c05r0801', '50-msg_c05r0801_middlewoman1_01_1', 'Well, now, you’re a Trainer? That makes you both\npapa and mama to your Pokémon.')
	_MACRO_TALKMSG('dialogue_c05r0801', '50-msg_c05r0801_middlewoman1_01_2', 'You know how having Pokémon around leads to\nnew discoveries?\rIt’s the same for parents and kids. I’m always\nlearning from my kids.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0801_baby:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c05r0801', '50-msg_c05r0801_baby_01', 'Kuufu fuu!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0801_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0801', '50-msg_c05r0801_girl2_01', 'Babies and Pokémon get along\nperfectly together.\rWhen babies take naps, Pokémon go to sleep\nright next to them.')
	_END()
ev_c05r0801_babyboy1:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0801', '50-msg_c05r0801_babyboy1_01', 'When I get bigger, I’m going to be a Trainer, too!')
	_END()
ev_c05r0801_babygirl:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0801', '50-msg_c05r0801_babygirl_01', 'When I grow up, I want to become a\nPokémon Coordinator.')
	_END()
ev_c05r0801_boy1:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0801', '50-msg_c05r0801_boy1_01', 'My sisters get all the attention. No one even\nnotices me.')
	_END()
ev_c05r0801_girl1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c05r0801', '50-msg_c05r0801_girl1_01', 'Oh, wow, you’re a Pokémon Trainer.\rHaving lots of Pokémon around is a lot\nof responsibility.\rBut that also comes with a lot of fun!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0801_pikatyuu:
	_EASY_VOICE_MSG('dialogue_c05r0801%50-msg_c05r0801_achamo_01', 'PLAY_PV_EV_025_00_02')
	_END()