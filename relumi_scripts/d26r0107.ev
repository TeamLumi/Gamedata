ev_d26r0107_gkanbu:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP($SYS_FLAG_REIAIHAI, 'ev_d26r0107_gkanbu_machine')
	_IF_FLAGON_JUMP(#FE_D26R0107_GKANBU_WIN, 'ev_d26r0107_gkanbu_win')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_01_1', 'You...you came all the way here just to save\nsome Pokémon?\rThough it’s nothing new, I can’t say I understand\nour boss.')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_01_2', 'Why would he let a kid like you come and\ngo freely?\rWe, Team Galactic, take all that we need and\neliminate what we do not.')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_01_3', 'But anyway, you’ve taken the trouble to come.\nLet me welcome you!\rConsider it payback for your insulting me at\nthe lake.')
	_TALK_CLOSE()
	_LDVAL(@WK_PLAY_REPO_NO, 16)
	_FLAG_SET(#FE_PLAY_REPO)
	_LDVAL(@SCWK_TEMP3, 883)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_FLAG_SET(#FE_D26R0107_GKANBU_WIN)
	_LDVAL(@WK_SCENE_D26R0107, 1)
	_EVENT_CAMERA_INDEX(455)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_02', 'Gah! What makes you so tough?\rFine... Do whatever you want with those\nthree Pokémon.\rPress the button on that machine to set\nthem free.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(456)
	_EVENT_CAMERA_END_WAIT()
	_GET_REL_POS_HERO('D26R0107_GKANBU', @SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'ev_d26r0107_gkanbu_dir_up')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 9, 'ev_d26r0107_gkanbu_dir_left')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 3, 'ev_d26r0107_gkanbu_dir_left')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 6, 'ev_d26r0107_gkanbu_dir_left')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'ev_d26r0107_gkanbu_dir_right')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_d26r0107_gkanbu_dir_right')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'ev_d26r0107_gkanbu_dir_right')
	_END()
ev_d26r0107_gkanbu_dir_up:
	_OBJ_ANIME('D26R0107_GKANBU', 'anm_d26r0107_gkanbu_01')
	_OBJ_ANIME_WAIT()
	_LDVAL(@LOCALWORK2, 2)
	_JUMP('common_d26r0107_gkanbu')
	_JUMP('common_d26r0107_gkanbu')
ev_d26r0107_gkanbu_dir_left:
	_OBJ_ANIME('D26R0107_GKANBU', 'anm_d26r0107_gkanbu_02')
	_OBJ_ANIME_WAIT()
	_LDVAL(@LOCALWORK2, 1)
	_JUMP('common_d26r0107_gkanbu')
	_JUMP('common_d26r0107_gkanbu')
ev_d26r0107_gkanbu_dir_right:
	_OBJ_ANIME('D26R0107_GKANBU', 'anm_d26r0107_gkanbu_03')
	_OBJ_ANIME_WAIT()
	_LDVAL(@LOCALWORK2, 2)
	_JUMP('common_d26r0107_gkanbu')
	_JUMP('common_d26r0107_gkanbu')
common_d26r0107_gkanbu:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 10600)
	_TALK_OBJ_END()
	_END()
ev_d26r0107_gkanbu_machine:
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_04_1', 'Our boss crafted a Red Chain from crystals he\ntook from the three Pokémon.')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_04_2', 'That Red Chain is what he needed to shackle\nsomething on Mount Coronet.')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_04_3', 'But that’s all I know. Who knows what he’s\nplanning to do up there.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0107_gkanbu_win:
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_03', 'Press the button and set them free. Isn’t that why\nyou came?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0107_common_battle_lose:
	_TALK_OBJ_END()
	_END()
