ev_d26r0107_charon_doubt:
	_MACRO_TALKMSG('dialogue_d26r0107', '00_msg_d26r0107_charon_3', 'Humph. Saturn and even Cyrus\nfall to a mere child...\rTeam Galactic’s state of affairs is\nworrying...\rThat plan of Cyrus’s atop Mt. Coronet,\ntoo... Who knows if it will work.\r...Hmm. Perhaps another option needs\nto be considered.\rOne befitting the genius of Charon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_d26r0107_charon_1:
	_AC_DIR_U(4)
	_ACMD_END()
anm_d26r0107_action_4:
	_AC_DIR_L(4)
	_ACMD_END()
ev_d26r0107_charon:
	_TALK_OBJ_START_TURN_NOT()
	_IF_FLAGON_JUMP(#FE_D26R0107_GKANBU_WIN, 'ev_d26r0107_charon_doubt')
	_OBJ_ANIME('D26R0107_CHARON', 'anm_d26r0107_charon_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d26r0107', '00_msg_d26r0107_charon_0', 'Fuhyahya!\rThose Pokémon of the lakes, where do\nyou suppose they would go?')
	_TALK_CLOSE()
	_OBJ_ANIME('D26R0107_GKANBU', 'anm_d26r0107_action_4')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d26r0107', '00_msg_d26r0107_saturn_1', 'What are you trying to say?')
	_MACRO_TALK_KEYWAIT('dialogue_d26r0107', '00_msg_d26r0107_charon_2', 'Nothing.\nPay it no heed.\rA new world isn’t overly interesting.\nWhat of it?\rIf Cyrus is right, then Team Galactic\nwill rule that new world.\rThat’s when it will be interesting.\nA chance to enjoy its sweets.\rI surely hope that our visionary Cyrus\nrealizes his dream.\rI look forward to whatever our beloved\nleader has planned atop Mt. Coronet.')
	_TALK_CLOSE()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('D26R0107_GKANBU', 'anm_d26r0107_charon_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_d26r0107', '00_msg_d26r0107_saturn_2', 'Gramps.\rOur boss can do without your kind of\nmoral support.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()