ev_d26r0107_button:
	_TALK_OBJ_START_LOOK_NONE()
	_IF_FLAGON_JUMP($SYS_FLAG_REIAIHAI, 'ev_d26r0107_button_02')
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 8, 0, 6)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(228)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_button_01', 'Would you like to press the button and set the\nPokémon free?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d26r0107_button_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d26r0107_button_no')
	_END()
ev_d26r0107_button_yes:
	_FIND_BG_ENABLE(0, 'BoxCollision_yukushi2')
	_FIND_BG_ENABLE(0, 'BoxCollision_agunomu2')
	_FIND_BG_ENABLE(0, 'BoxCollision_emulit2')
	_LDVAL(@WK_SCENE_D26R0107, 0)
	_EVENT_CAMERA_INDEX(229)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_button_02', 'You pressed the button and set the\nPokémon free.')
	_TALK_CLOSE()
	_FIND_BG_DISABLE(0, 'P_D_006_MachineLight_01')
	_FLAG_RESET(#601); Show extra blockers in Mt. Coronet for Eterna City entrance
	_FLAG_SET(#2727); Hide rock climb blockers in Mt. Coronet
	_FLAG_RESET(#FV_D05R0110_GINGAM); Hide Galactic Grunts in Mt. Coronet pre Galactic HQ
	_LDVAL(@488, 1); Enable Looker stopdata
	_SET_SYS_FLAG($SYS_FLAG_REIAIHAI)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ANIME('D26R0107_POKE1', 'anm_d26r0107_poke1_01')
	_OBJ_ANIME('D26R0107_POKE2', 'anm_d26r0107_poke2_01')
	_OBJ_ANIME('D26R0107_POKE3', 'anm_d26r0107_poke3_01')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_SE_PLAY('S_YARI_EV_12')
	_CALL_EFFECT(0, 'EF_F_CS_CHAP110_KIRA_YELLOW_END', -14, 0.500000, 6)
	_OBJ_DEL('D26R0107_POKE3')
	_TIME_WAIT(1, @SCWK_ANSWER)
	_CALL_EFFECT(1, 'EF_F_CS_CHAP110_KIRA_RED_END', -8, 0.500000, 11)
	_OBJ_DEL('D26R0107_POKE1')
	_TIME_WAIT(1, @SCWK_ANSWER)
	_CALL_EFFECT(2, 'EF_F_CS_CHAP110_KIRA_BLUE_END', -2, 0.500000, 6)
	_OBJ_DEL('D26R0107_POKE2')
	_TIME_WAIT(1, @SCWK_ANSWER)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_FIND_BG_DISABLE(0, 'BoxCollision_yukushi2')
	_FIND_BG_DISABLE(0, 'BoxCollision_agunomu2')
	_FIND_BG_DISABLE(0, 'BoxCollision_emulit2')
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 1, 'ev_d26r0107_gkanbu_dir_left2_cam')
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 2, 'ev_d26r0107_gkanbu_dir_right2_cam')
	_END()
ev_d26r0107_gkanbu_dir_left2_cam:
	_EVENT_CAMERA_INDEX(232)
	_JUMP('ev_d26r0107_button01')
	_END()
ev_d26r0107_gkanbu_dir_right2_cam:
	_EVENT_CAMERA_INDEX(230)
	_JUMP('ev_d26r0107_button01')
	_END()
ev_d26r0107_button01:
	_CHARA_LOOK_LOCK('D26R0107_GKANBU', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'D26R0107_GKANBU')
	_JUMP('common_d26r0107_gkanbu_02')
	_END()
common_d26r0107_gkanbu_02:
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_04_1', 'Our boss crafted a Red Chain from crystals he\ntook from the three Pokémon.')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_04_2', 'That Red Chain is what he needed to shackle\nsomething on Mount Coronet.')
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_gkanbu_04_3', 'But that’s all I know. Who knows what he’s\nplanning to do up there.')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_RELEASE_EFFECT(0)
	_RELEASE_EFFECT(1)
	_RELEASE_EFFECT(2)
	_EVENT_CAMERA_INDEX(231)
	_TIME_WAIT(5, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D26R0107_GKANBU')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_DEL('D26R0107_GKANBU')
	_FLAG_SET(#FV_D26R0107_GKANBU)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_FLAG_SET(#FV_D05R0102_STOPPER)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 10700)
	_TALK_END()
	_TALK_END()
	_END()
ev_d26r0107_button_no:
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(294)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_TALK_END()
	_END()
ev_d26r0107_button_02:
	_MACRO_TALKMSG('dialogue_d26r0107', '86-msg_d26r0107_button_03', 'The button has been pressed already. You have\nto leave.')
	_TALK_CLOSE()
	_TALK_END()
	_END()
