ev_c02r0102_boy1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02r0102_boy1_02')
	_MACRO_TALKMSG('dialogue_c02r0102', '166-msg_c02r0102_boy1_01', 'The books on the third floor are easy to read.\rThe ones down here are all too tough for me\nto understand...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0102_boy1_02:
	_MACRO_TALKMSG('dialogue_c02r0102', '166-msg_c02r0102_boy1_02', 'Before I knew it, I was looking up a book called\n“Surviving Disasters”!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0102_books1:
	_MACRO_EASY_OBJ_MSG('dialogue_c02r0102', '166-msg_c02r0102_books1_01', 'The ceiling-high bookshelves are crammed\nwith books.')
	_END()
ev_c02r0102_books2:
	_MACRO_EASY_OBJ_MSG('dialogue_c02r0102', '166-msg_c02r0102_books2_01', 'The shelves are lined with books worn from being\nread by many people.')
	_END()
ev_c02r0102_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c02r0102', '166-msg_c02r0102_poster_01', 'Please refrain from bringing food or beverages\ninto the library.')
	_END()
ev_c02r0102_hon:
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0102', '167-msg_c02r0103_books8_01', 'This book is titled “The Sea’s Legend.” It’s a text\nthat was only recently discovered, and its ancient\fletters were decoded. Would you like to read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02r0102_hon_end')
	_MACRO_TALKMSG('dialogue_c02r0102', '167-msg_c02r0103_books8_03', 'Once upon a time in the East Sea, there was a\nPokémon known as the prince.\rA brave human asked Pokémon living in the sea\nto let them see the prince.\rWould you like to keep reading?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02r0102_hon_end')
	_MACRO_TALKMSG('dialogue_c02r0102', '167-msg_c02r0103_books8_04', 'Mantyke, Buizel, and a Qwilfish with huge\nspikes acknowledged the human’s bravery and\fjoined them.\rTogether, they set off in a boat over the sunset-\nstreaked sea, sailing through the ocean gate\fstretched over the waves.\rWould you like to keep reading?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02r0102_hon_end')
	_MACRO_TALKMSG('dialogue_c02r0102', '167-msg_c02r0103_books8_05', 'News of this reached the ears of the prince, who\nwent to meet the brave little party at the\fSeaside Hollow.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0102_hon_end:
	_MACRO_TALKMSG('dialogue_c02r0102', '167-msg_c02r0103_books8_02', 'You put the book back.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0102_skillswap:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2683, 'ev_c02r0102_skillswap_done')
	_MACRO_TALK_KEYWAIT('dialogue_c02r0102', '00_msg_ev_c02r0102_skillswap', 'Hello, Trainer!\nThis is something I found.\rIt was mixed in with a load of cargo\nfrom another country.\rIt’s not anything that I can use,\nso I think you should take it.')
	_LDVAL(@SCWK_TEMP0, 375); Skill Swap
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_MACRO_TALK_KEYWAIT('dialogue_c02r0102', '00_msgev_c02r0102_skillswap_2', 'Somewhere far beyond the vast sea...\rThere are other lands populated by\nPokémon and Trainers.')
	_FLAG_SET(#2683)
	_JUMP('ev_c02r0102_skillswap_end')
ev_c02r0102_skillswap_done:
	_MACRO_TALK_KEYWAIT('dialogue_c02r0102', '00_msgev_c02r0102_skillswap_3', 'You know how Pokémon have their\nown abilities?\rWell, the move Skill Swap exchanges\nthe user’s ability with that of its target.\rHow you use Skill Swap is a measure\nof your expertise as a Trainer.')
	_JUMP('ev_c02r0102_skillswap_end')
ev_c02r0102_skillswap_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
