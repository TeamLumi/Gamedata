ev_c07r0901_explore:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_R210A_CLEAR, 'ev_c07r0901_explore_02')
	_MACRO_TALKMSG('dialogue_c07r0901', '79-msg_c07r0901_explore_01', 'I wanted to go to Celestic Town, but there are\nsome Pokémon in the way.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c07r0901_explore_02:
	_MACRO_TALKMSG('dialogue_c07r0901', '79-msg_c07r0901_explore_02', 'There was a group of Pokémon blocking the way\nup to Celestic Town. I think they’re gone now.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()