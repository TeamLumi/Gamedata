ev_t01r0101_rivalmama:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#105, 'ev_t01r0101_rivalmama_zukan')
	_IFVAL_JUMP(@81, 'GE', 1, 'ev_t01r0101_rivalmama_poke_get')
	_IF_FLAGON_JUMP(#73, 'ev_t01r0101_rivalmama_talk')
	_IF_FLAGON_JUMP(#195, 'ev_t01r0101_rivalmama_rivaltalk')
	_GET_MY_SEX(@246)
	_IFVAL_JUMP(@246, 'EQ', 0, 't01r0101_rivalmama_male')
	_IFVAL_JUMP(@246, 'EQ', 1, 't01r0101_rivalmama_female')
	_END()
t01r0101_rivalmama_male:
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_01_1', 'Oh, hi, {0,1,0,0}. Are you looking\nfor {1,1,0,0}?\rMy husband, Palmer, is home for once.\nHave you spoken to him?\r{1,1,0,0} and him are so alike.\nNeither of them can ever sit still...', 0, 1)
	_JUMP('common_t01r0101_rivalmama_01')
t01r0101_rivalmama_female:
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_04_1', 'Oh, hi, {0,1,0,0}. Did you come calling\non {1,1,0,0}?\rMy husband, Palmer, is home for once.\nHave you spoken to him?\r{1,1,0,0} and him are so alike.\nNeither of them can ever sit still...', 0, 1)
	_JUMP('common_t01r0101_rivalmama_01')
common_t01r0101_rivalmama_01:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0101_rivalmama_poke_get:
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_03', 'Oh, you’ve become friends with a Pokémon, too.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0101_rivalmama_talk:
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_02_1', '{1,1,0,0} should be out on Route 201\nby now.\rHe just can’t sit still, that boy. I wonder who he\ntakes after.', 0, 1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_02_2', 'He just can’t sit still, that boy. I wonder who he\ntakes after.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0101_rivalmama_rivaltalk:
	_FLAG_SET(#73)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_05_1', 'That kid rocketed off again like usual.')
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_05_2', 'I’d guess he would be out on Route 201 by now?\rHe just can’t sit still, that boy. I wonder who he\ntakes after.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0101_rivalmama_zukan:
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_06_1', '{1,1,0,0} took off like a rocket as usual.\rHe was shouting something about becoming the\ngreatest Trainer ever...')
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivalmama_06_2', 'He just can’t sit still, that boy. I wonder who he\ntakes after.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t01r0101_rivaldad:
	_TALK_OBJ_START()
	_JUMP('t01r0101_rivaldad_male')
	_END()
t01r0101_rivaldad_male:
	_PLAYER_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_t01r0101', '21-msg_t01r0101_rivaldad_01_1', 'You came over here to play with my son, \nright, {0,1,0,0}?\rGreat! Enjoy yourselves! \nDon’t get into too much trouble! ', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()