ev_c03gym0101_flag_change:
	_SET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_END()
ev_c03gym0101_scene_change:
	_EVENT_START()
	_JUMP('ev_c03gym0101_gym_first')
	_END()
ev_c03gym0101_gym_first:
	_IFVAL_JUMP(@WK_SCENE_C03GYM0101, 'NE', 0, 'ev_c03gym0101_gym_first_end')
	_CALL('ev_block_doc')
	_EVENT_START()
	_EVENT_CAMERA_INDEX(22)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c03gym0101_gym_first01')
	_END()
ev_c03gym0101_firstentry_anim:
	_AC_MARK_GYOE()
	_AC_WAIT(8)
	_AC_DIR_L(4)
	_AC_LEFT(1, 8)
	_AC_DIR_D(4)
	_ACMD_END()
ev_c03gym0101_firstentry_restore:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(4)
	_ACMD_END()
ev_c03gym0101_gym_first01:
	_EVENT_CAMERA_INDEX(23)
	_EVENT_CAMERA_END_WAIT()
	_OBJ_ANIME('C03GYM0101_ADVICE', 'ev_c03gym0101_firstentry_anim')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_sunglasses_01_1', 'I’m the Gym Guide and it’s my job\nto make sure up-and-coming trainers\fare ready for their Gym Challenges!\rOur tough Leaders here in Sinnoh have\nbeen learning some new tricks.\rSo make sure to talk me when\nyou want to some interesting info!')
	_TALK_CLOSE()
	_OBJ_ANIME('C03GYM0101_ADVICE', 'ev_c03gym0101_firstentry_restore')
	_OBJ_ANIME_WAIT()
	_LDVAL(@WK_SCENE_C03GYM0101, 1)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_c03gym0101_gym_first_end:
	_CALL('ev_block_doc_end')
	_END()
ev_c03gym0101_randomteam_roark:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 823)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 824)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 825)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 826)
	_RET()
ev_c03gym0101_leader:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'pos_c03gym0101_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 5, 4, 4.500000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(24)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CALL('ev_block_doc')
	_OBJ_ANIME('C03GYM0101_LEADER', 'anm_c03gym0101_leader_01_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_01_1', 'Welcome! This is the Oreburgh Pokémon Gym!\rI’m Roark, the Gym Leader!\rI’m but one Trainer who decided to walk proudly\nwith Rock-type Pokémon!')
	_TALK_CLOSE()
	_OBJ_ANIME('C03GYM0101_LEADER', 'anm_c03gym0101_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_01_2', 'As the Gym Leader, I need to see your potential\nas a Trainer.\rAnd I’ll need to see the toughness of the\nPokémon that battle with you!', 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(50)
	_LDVAL(@WK_PLAY_REPO_NO, 1)
	_FLAG_SET(#FE_PLAY_REPO)
	_BTL_ENCSEQ_LOAD('gym01')
	_CALL('ev_c03gym0101_randomteam_roark')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_02_1', 'This is embarrassing...\rI went and lost to a Trainer who didn’t have a\nsingle Gym Badge...')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_02_2', 'But that’s the story. You were strong,\nand I was weak. That’s all there is.', 1)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_02_3', 'According to Pokémon League rules, I have to\ngive you our Gym Badge since you’ve beaten me,\fthe Gym Leader.', 1)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_02_4', 'Here’s your official Pokémon League\nCoal Badge.', 1)
	_TALK_CLOSE()
	_BADGE_GET(0)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_03', 'You received the Coal Badge from Roark!')
	_ME_WAIT()
	_TRAINER_FLAG_SET('TANPAN_11')
	_TRAINER_FLAG_SET('TANPAN_12')
	_SYS_FLAG_BADGE_SET($BADGE_ID_C03)
	_TRAINER_FLAG_SET('TANPAN_11')
	_TRAINER_FLAG_SET('TANPAN_12')
	_LDVAL(@WK_SCENE_C03, 2)
	_SET_WARP_ID(41)
	_SET_TELEPORT_ID(38, 0)
	_LDVAL(@WK_SCENE_C01, 3)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 3200)
	_FLAG_RESET(#FV_C01_SUPPORT)
	_FLAG_RESET(#FV_C01_DOCTOR)
	_FLAG_RESET(#FV_C01_GINGA)
	_FLAG_SET(#FV_T02R0101_DOCTOR)
	_FLAG_SET(#2623)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_04', 'Having that Coal Badge means you can now use\nthe hidden move Rock Smash from your Pokétch.\rYou should also take these, too.')
	_TALK_CLOSE()
	_JUMP('pos_c03gym0101_leader_item_get')
	_END()
anm_c03gym0101_heropos:
	_AC_OFFSET(0, 0, 0.500000)
	_ACMD_END()
anm_c03gym0101_hero01:
	_AC_INVISIBLE_ON()
	_ACMD_END()
anm_c03gym0101_hero02:
	_AC_INVISIBLE_OFF()
	_ACMD_END()
anm_c03gym0101_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c03gym0101_leader_01_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
pos_c03gym0101_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 403)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'pos_c03gym0101_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C03_GYM_ITEM_GET)
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_ITEM_WAZA_NAME(1, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_05_1', '{0,1,9,0} contains the move\nStealth Rock.\rIt’s a move that inflicts damage on opponents\nthat switch into battle.', 0, 1)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_05_3', 'And these are the Stickers I use.\nHere, take some!')
	_CB_ITEM_NUM_ADD(18, 3)
	_CB_ITEM_NUM_ADD(65, 3)
	_CB_ITEM_NUM_ADD(67, 1)
	_SE_PLAY('M_FI014')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER1_01')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_05_2', 'Incidentally, a TM will teach its move to a\nPokémon instantly.\rTMs will not break when you use them, so\nyou can use them as often as you’d like.', 1)
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_exec_item_seal_get:
	_CB_ITEM_NUM_ADD(@SCWK_TEMP0, @SCWK_TEMP1)
	_CB_ITEM_NUM_GET(@SCWK_TEMP0, @SCWK_ANSWER)
	_SEAL_NAME(0, @SCWK_TEMP0, @SCWK_TEMP1)
	_SE_PLAY('M_FI014')
	_NUMBER_NAME(1, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_c03gym0101', '28-mes_shop_03_03', 'You obtained {1,2,2,0} {0,1,77,0}!')
	_ME_WAIT()
	_RET()
pos_c03gym0101_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
pos_c03gym0101_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C03_GYM_ITEM_GET, 'pos_c03gym0101_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'pos_c03gym0101_leader_return_match')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_06', 'In this region of Sinnoh, there are seven other\nGym Leaders.\rI should warn you—they’re a lot tougher than\nI am!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03gym0101_randomteam_roark_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 891)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 892)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 893)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 894)
	_RET()
pos_c03gym0101_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C03_GYM_RETRUN_MATCH_FIRST, 'pos_c03gym0101_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C03_GYM_RETRUN_MATCH, 'pos_c03gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_07_01', 'Hey, you actually came!\rWelcome once more to Oreburgh Gym.\rEver since the day I lost to you, I’ve been\nrethinking everything I know about the strengths\fand weaknesses of Rock-type Pokémon...\rOver and over and over... And then it hit me—\nRock-type Pokémon are simply the best!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym01')
	_LDVAL(@WK_PLAY_REPO_NO, 26)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c03gym0101_randomteam_roark_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_07_02', 'I’ve gotta hand it to you... I gave that battle all\nI had, but you still beat me fair and square.\rI can see how you made it into the Hall of Fame.\nYou really are a top Trainer!')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_07_03', 'Here’s the Sticker I always use. Now you can use\nit too, if you want!')
	_LDVAL(@SCWK_TEMP0, 65)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C03_GYM_RETRUN_MATCH)
	_FLAG_SET(#FE_C03_GYM_RETRUN_MATCH_FIRST)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c03gym0101_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C03_GYM_RETRUN_MATCH, 'pos_c03gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_08_01', 'Thanks for coming to see me!\rLet me show you again just how strong Rock-type\nPokémon are!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym01')
	_LDVAL(@WK_PLAY_REPO_NO, 26)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c03gym0101_randomteam_roark_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_08_02', 'I’ve gotta hand it to you... I gave that battle all\nI had, but you still beat me fair and square.')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_07_03', 'Here’s the Sticker I always use. Now you can use\nit too, if you want!')
	_LDVAL(@SCWK_TEMP0, 65)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C03_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c03gym0101_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_leader_07_04', 'Nothing will ever weaken the bond between me\nand Rock-type Pokémon!\rI hope you come visit again sometime!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03gym0101_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c03gym0101_advice:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c03gym0101_advice_02')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_sunglasses_01_2', 'The Gym Leader is a user\nof Rock-type Pokémon.\rHe’s taken to setting up Sandstorms to\nboost their Special Defenses,\rand gave his Pokémon some fancy goggles\nto protect them from spore moves!\rI hear if you can get your hands on\nthem in the fight,\rthose goggles can protect you\nfrom the effects of weather, too... ')
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_sunglasses_01_3', 'That’s all the advice I can give.\nThanks for listening!')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c03gym0101_advice_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_sunglasses_02', 'Oh! {0,1,0,0}! You’ve taken care of the\nGym Leader!\rSo, did my advice come in handy or what?\rIf my advice was useful, it’d be great if you’d\nbecome my fan!', 0, 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c03gym0101_statue:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c03gym0101_statue_02')
	_RIVAL_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_statue_01', 'Oreburgh Pokémon Gym\nGym Leader: Roark\fCertified Trainers: {1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c03gym0101_statue_02:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_RIVAL_NAME(2)
	_MACRO_TALKMSG('dialogue_c03gym0101', '84-msg_c03gym0101_statue_02', 'Oreburgh Pokémon Gym\nGym Leader: Roark\rCertified Trainers: {0,1,0,0}\n{1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()