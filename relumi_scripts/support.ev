ev_support_lucas_battle_hard_piplup:
	_LDVAL(@SCWK_TEMP3, 1068)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_JUMP('ev_support_lucas_battle_over')
