ev_support_lucas_battle_over:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_support', '11-msg_heroine_17_04', 'Wow, I should have known I didn’t stand a\nchance against you, {0,1,0,0}...\rThanks so much for teaching me more about\nPokémon battles today!\rI hope we can battle again sometime!')
	_FLAG_SET(#TMFLG_T02_SUP_RETRUN_MATCH)
	_FLAG_SET(#FE_T02_SUP_BTL_WIN)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
