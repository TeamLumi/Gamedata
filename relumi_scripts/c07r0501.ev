ev_c07r0501_clown:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0501', '108-msg_c07r0501_clown_01', 'Have you been to the Veilstone Gym?\rIt’s pretty cool! Reminds me of an\nathletics center.')
	_END()
ev_c07r0501_fighter:
	_MACRO_EASY_OBJ_MSG('dialogue_c07r0501', '104-msg_c07r0501_fighter_01', 'There are many magicians in the world.\nYou know, the performance artists?\rDon’t you think, that maybe, say, five percent are\nactually psychics?')
	_END()