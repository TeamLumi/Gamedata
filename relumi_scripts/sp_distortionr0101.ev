ev_distortionr0101_worldstate_attach_transform_camera:
	_IFVAL_CALL(@637, 'EQ', 1, 'ev_distortionr0101_fast_clouds')
	_IFVAL_CALL(@637, 'EQ', 2, 'ev_distortionr0101_reverse_clouds')
	_ATTACH_TRANSFORM('DWSkyBox', 'HERO', 0)
	_ATTACH_TRANSFORM('DWSkyBox', 'Main Camera', 1)
	_RET()
ev_distortionr0101_fast_clouds:
	_FIND_BG_DISABLE(0, 'DWSkyBox/CloudStormNormal')
	_FIND_BG_ENABLE(0, 'DWSkyBox/CloudStormFast')
	_RET()
ev_distortionr0101_reverse_clouds:
	_FIND_BG_DISABLE(0, 'DWSkyBox/CloudStormNormal')
	_FIND_BG_ENABLE(0, 'DWSkyBox/CloudStormReverse')
	_RET()
