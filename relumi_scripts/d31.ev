ev_d31_statue1:
	_TALK_OBJ_START_LOOK_NONE()
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_statue1_01', 'A Trainer who just caught a Pokémon.\nThat’s what this statue represents.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_statue2:
	_TALK_OBJ_START_LOOK_NONE()
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_statue2_01', '“Boastful of Capture”...\nThat seems to be the title.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_battlefrontier_model:
	_TALK_OBJ_START_LOOK_NONE()
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_battlefrontier_model_01', 'This...!\nA scale model of the Battle Frontier.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_woman1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman1_01', 'There are five facilities in the Battle\nFrontier.\rAt every one, you can win your way\nthrough to challenge the boss.\rI think they’re called Brains, and\nthey’re out-of-this-world tough!')
	_END()
ev_d31_woman2:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman2_01', 'You know, when I lose, the first thing\nI do is look for who to blame.\rLike, the opponent cheated, or I was\nunlucky, or it’s my Pokémon’s fault...\rBut I know I shouldn’t do that.\nI won’t get better unless I change.')
	_END()
ev_d31_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman3_01', 'People expect so much from a maid.\nCooking, cleaning, and laundry...\rNot to mention being good at training\nPokémon!')
	_END()
ev_d31_man1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_man1_01', 'I know it’s no revelation now, but...\nThe way of Pokémon is deep.')
	_END()
ev_d31_student1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_student1_01', 'At the Battle Factory, you have to\nkeep winning with rental Pokémon.\rIt’s a real test of your knowledge.\nIt’s perfect for a student like me!')
	_END()
ev_d31_boy1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_boy1_01', 'My inflatable tube lets me ride out\nthe ebbs and flows of life.')
	_END()
ev_d31_oldman1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_oldman1_01', 'I treat every battle as if it were my\nlast.\rGoing into battle willing to accept\na loss? Unforgivable!\rBut losing is also inevitable.\nA good Trainer learns from it.')
	_END()
ev_d31_man3:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_man3_01', 'The Battle Hall is where I want to be.\rEven the MAGIKARP I caught fishing\nhas a shot at no. 1!')
	_END()
ev_d31_girl1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_girl1_01', 'The most important person in the Battle\nCastle is a lady.\rLady, like a princess, I mean.')
	_END()
ev_d31_woman4:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman4_01', 'What makes me the most happy being\na Trainer?\rThe fact that Pokémon will always be\nwith me!')
	_END()
ev_d31_woman5:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman5_01', 'To be strong is to be weak.\nTo be weak is to be strong.\rI was told that a long time ago.\nNot that I have any clue what it means.')
	_END()
ev_d31_man4:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_man4_01', 'There are those who love battling from\ndeep in the cockles of their hearts.\rThe people that gather here?\nThat would be them.')
	_END()
ev_d31_man5:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_man5_01', 'I wonder how many years it’s been since\nI first met a Pokémon?\rHow much time has passed for you and\nyour Pokémon?')
	_END()
ev_d31_man6:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_man6_01', 'All the places in the Battle Frontier\nlet you team up with a friend!')
	_END()
ev_d31_bigman1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_bigman1_01', 'Trainers can command Pokémon to\nuse moves in battle with confidence.\rThey can do that because Trainers\nbelieve in their Pokémon.\rIn turn, Pokémon repay that trust\nby using moves the best they can.\rThis may seem obvious, but it’s actually\nincredibly amazing!')
	_END()
ev_d31_boy2:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_boy2_01', 'Battle Tower... Its height is a symbol\nof its challenge to Trainers.')
	_END()
ev_d31_woman6:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman6_01', 'I don’t think it’s good enough for an\nIdol to just be cute, sing, and dance.\rI should learn more about Pokémon so\nI can attract the Poké maniacs.')
	_END()
ev_d31_woman8:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_woman8_01', 'There are five facilities in the Battle\nFrontier.\rAt every one, you can win your way\nthrough to challenge the boss.\rI think they’re called Brains, and\nthey’re out-of-this-world tough!')
	_END()
ev_d31_exchangewoman1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman1_01', 'Welcome to the Exchange Service\nCorner!\rWould you like to trade in your BP for\nsome prizes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31_exchangewoman1_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d31_exchangewoman1_no')
	_END()
ev_d31_exchangewoman1_yes:
	;TODO Exchange shop
	_JUMP('ev_d31_exchangewoman1_no')
	_END()
ev_d31_exchangewoman1_no:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman1_01_no', 'Please save some BP and come see us\nagain.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_exchangewoman2:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman2_01', 'Welcome to the Exchange Service\nCorner!\rWould you like to trade in your BP for\nsome prizes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31_exchangewoman2_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d31_exchangewoman2_no')
	_END()
ev_d31_exchangewoman2_yes:
	;TODO Exchange shop
	_JUMP('ev_d31_exchangewoman2_no')
	_END()
ev_d31_exchangewoman2_no:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman2_01_no', 'Please save some BP and come see us\nagain.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_exchangewoman3:
	_TALK_OBJ_START()
	_IF_FLAGON_CALL(#3070, 'ev_d31_exchangewoman3_2'); She has been talked to once
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_01', 'Welcome!\nWould you like some Scratch-Off Cards?\rYou may buy three Scratch-Off Cards\nfor 1 BP.\rHidden on each Scratch-Off Card are\nicons of Pokémon.\rYou may scratch the obscuring film off \na card three times.\rIf the same icon appears three times,\nyou will win a prize, like a Berry.\rAlso, DITTO’s icon can transform into\nany other Pokémon.\rGood luck matching Pokémon icons!\rWill you buy some Scratch-Off Cards?')
	_FLAG_SET(#3070)
	_JUMP('ev_d31_exchangewoman3_shop')
	_END()
ev_d31_exchangewoman3_2:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_02', 'Welcome!\rWould you like some Scratch-Off Cards?\rYou may buy three Scratch-Off Cards\nfor 1 BP.\rWill you buy some Scratch-Off Cards?')
	_JUMP('ev_d31_exchangewoman3_shop')
	_END()
ev_d31_exchangewoman3_shop:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_scratch', 'Scratch', 0)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_info', 'Info', 1)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_cancel', 'Cancel', 2)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31_exchangewoman3_shop_scratch')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d31_exchangewoman3_shop_info')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_d31_exchangewoman3_shop_cancel')
	_END()
ev_d31_exchangewoman3_shop_cancel:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_shop_cancel', 'Please visit again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
ev_d31_exchangewoman3_shop_info:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_shop_info', 'You may buy three Scratch-Off Cards\nfor 1 BP.\rHidden on each Scratch-Off Card are\nicons of Pokémon.\rYou may scratch the obscuring film off \na card three times.\rIf the same icon appears three times,\nyou will win a prize, like a Berry.\rAlso, DITTO’s icon can transform into\nany other Pokémon.\rGood luck matching Pokémon icons!\rWill you buy some Scratch-Off Cards?')
	_JUMP('ev_d31_exchangewoman3_shop')
	_END()
ev_d31_exchangewoman3_shop_scratch:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_shop_scratch', 'It will be 1 BP for three\nScratch-Off Cards. Is that OK?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_d31_exchangewoman3_shop_scratch_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d31_exchangewoman3_shop_scratch_no')
	_END()
ev_d31_exchangewoman3_shop_scratch_yes:
	;TODO add scratch off cards
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_shop_scratch_yes', 'I’m sorry, but you don’t have enough\nBP. Please come again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_exchangewoman3_shop_scratch_no:
	_MACRO_TALKMSG('dialogue_d31', '42-msg_d31_exchangewoman3_shop_scratch_no', 'Please visit again.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d31_oldwoman1:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_oldwoman1_01', 'Behind every Pokémon, there is a\nstory. Isn’t that right, dear?')
	_END()
ev_d31_oldman2:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_oldman2_01', 'Like a Pokémon and Trainer, we have\nbeen together for a long time.\rEventually, we will be parted...\rUntil then, I will cherish the time we\nhave, dearest.')
	_END()
ev_d31_man2:
	_MACRO_EASY_OBJ_MSG('dialogue_d31', '42-msg_d31_man2_01', 'The Pokémon’s type!\rThe moves to be learned!\rThe items to be held!\rIf your aim is to be no. 1 here,\nyou can’t overlook a single detail.')
	_END()
ev_d31_sign1:
	_EASY_BOARD_MSG('dialogue_d31%42-msg_d31_sign1_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_d31_sign2:
	_EASY_BOARD_MSG('dialogue_d31%42-msg_d31_sign1_02', 'BOARD_TYPE_POST', 0)
	_END()
ev_d31_sign3:
	_EASY_BOARD_MSG('dialogue_d31%42-msg_d31_sign3_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_d31_sign4:
	_EASY_BOARD_MSG('dialogue_d31%42-msg_d31_sign4_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_d31_sign5:
	_EASY_BOARD_MSG('dialogue_d31%42-msg_d31_sign5_01', 'BOARD_TYPE_POST', 0)
	_END()