ev_r201_flag_change:
	_CALL('ev_r201_flag_change_col_del')
	_CALL('ev_l01_flag_change_col_del')
	_IFVAL_CALL(@WK_SCENE_R201, 'EQ', 1, 'ev_r201_flag_change_col_set')
	_IFVAL_CALL(@WK_SCENE_R201, 'EQ', 2, 'ev_l01_flag_change_col_set')
	_IFVAL_CALL(@WK_SCENE_R201, 'EQ', 2, 'ev_r201_rival_flag_change_01')
	_IFVAL_CALL(@477, 'EQ', 1, 'ev_r201_rival_setup')
	_GET_MY_SEX(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_r201_male_flag_change_01')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_r201_female_flag_change_01')
	_END()
