ev_r201_boy1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_boy1_01_1', 'Wild Pokémon lurk in tall grass. They can come\nbursting out at any time.')
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_boy1_01_2', 'So, if you’re wanting to battle wild Pokémon,\njust walk in tall grass.\rIf you want to avoid wild Pokémon, then stay out\nof the tall grass.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r201_pachirisu_mew:
	_TALK_OBJ_START()
	_VOICE_PLAY(417, 0, 0)
	_MACRO_TALKMSG('dialogue_r201', '18-msg_mew_20', 'Pachipachi pacchipach!')
	_TALK_CLOSE()
	_WHITE_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_OBJ_DEL('R201_PACHIRISU_MEW')
	_FLAG_SET(#2818)
	_TIME_WAIT(30, @SCWK_ANSWER)
	_OBJ_ADD('R201_MEW')
	_FLAG_RESET(#2819)
	_WHITE_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_VOICE_PLAY(151, 0, 0)
	_MACRO_TALKMSG('dialogue_r201', '18-msg_mew_21', 'Myuu.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r201_mew_battle:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_r201', '18-msg_mew_04', 'Myuu...')
	_VOICE_PLAY(151, 0, 0)
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_SP_WILD_BTL_SET(151, 50)
	_RESET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 151)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_r201_mew_legend_capture_ng')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'ev_r201_mew_legend_event_clear')
	_END()
ev_r201_mew_legend_event_clear:
	_FLAG_SET(#2819)
	_OBJ_DEL('R201_MEW')
	_TALK_OBJ_END()
	_END()
ev_r201_mew_legend_capture_ng:
	_VOICE_PLAY(151, 0, 0)
	_MACRO_TALKMSG('dialogue_r201', '18-msg_mew_04', 'Myuu...')
