pos_r201_stop:
	_EVENT_START()
	_SYS_FLAG_PAIR_RESET()
	_MOVE_CODE_CHANGE('R201_RIVAL', 'MV_DOWN')
	_IFVAL_JUMP(@WK_SCENE_L01, 'EQ', 4, 'pos_r201_stop_fix')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201stop_01_1', 'Remember what your mother said?')
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201stop_01_2', '“{0,1,0,0}! Don’t go into the tall grass.\nWild Pokémon might attack you.\r“It would be OK if you had your own Pokémon,\nbut you don’t, so...”', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'pos_r201_stop_player_back')
	_OBJ_ANIME_WAIT()
	_LDVAL(@SYS_WORK_PAIR_TRAINER_ID, 8)
	_CALL('ev_set_trainer_id_for_current_gamemode_partner_id')
	_SYS_FLAG_PAIR_SET()
	_MOVE_CODE_CHANGE('R201_RIVAL', 'MV_PAIR')
