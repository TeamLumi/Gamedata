pos_r201_rival_200_common:
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_rival_a_01_1', 'Too slow! ', 1)
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_rival_a_01_2', 'I’m sick of waiting! I’m going to go see \nProf. Rowan, so I can thank him properly.\rSo, I had this great idea. ', 1)
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_rival_a_01_3', 'Listen up, OK? \nYou know that lake where we always play at?\rYou know how they say a legendary \nPokémon lives there?\rYou guessed it!', 1)
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_rival_a_01_4', 'We’re going to catch that Pokémon.\nThat’ll make Prof. Rowan happy.\rI’m sure of that! ', 1)
	_TALK_CLOSE()
	_SYS_FLAG_PAIR_SET()
	_CALL('ev_r201_flag_change_col_set')
	_MOVE_CODE_CHANGE('R201_RIVAL', 'MV_PAIR')
	_PAIR_OBJID_SET('R201_RIVAL')
	_LDVAL(@WK_SCENE_R201, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 800)
	_END()
pos_r201_rival_03_common:
	_JUMP('pos_r201_rival_02_x107')
pos_r201_rival_04_common:
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_03', 'What? \nDon’t go into the grass, right? \rNo worries! No problem! \rIt doesn’t matter that we don’t have any \nPokémon. \rTrust me on this one. \nI’ve got an idea! \rNow listen. You know how wild Pokémon \njump out when you go into tall grass? ')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_04', 'So, what you do is, you scoot to the next patch \nof grass before any wild Pokémon can appear. \rIf we just keep dashing, we can get to Sandgem \nTown without running into wild Pokémon! \rOK, stick with me! ')
	_TALK_CLOSE()
	_JUMP('pos_r201_rival_02_x108')
pos_r201_rival_05_common:
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_05', 'OK, here goes! \rOn your marks... ')
	_TALK_CLOSE()
	_JUMP('pos_r201_rival_02_x109')
