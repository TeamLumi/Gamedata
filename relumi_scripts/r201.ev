pos_r201_doctor:
	_EVENT_START()
	_JUMP('pos_r201_doctor_z1')
	_END()
pos_r201_doctor_z1:
	_BGM_PLAY('B_OTH003')
	_PLAYER_NAME(0)
	_OBJ_ANIME('FLDOBJ_ID_PAIR', 'anm_r201_rival_50')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('FLDOBJ_ID_PAIR', 'anm_r201_rival_50_g')
	_OBJ_ANIME('HERO', 'anm_r201_hero_111')
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_114')
	_INVISIBLE_OBJ_PROP('R201_DOCTOR', 'fc2003_00_bagskin')
	_SET_VISIBILITY('R201_DOCTOR', 0, 0)
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_02', 'You two don’t seem to have any Pokémon \nbetween you? \rThen, what is the meaning of going into the \ntall grass?! ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_111')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_06', '...\n...\r...\n...\r...\n...\rHey, \n{0,1,0,0}.\rThis old guy... \nIt’s Prof. Rowan, isn’t it? \rWhat’s he doing here...? ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_110')
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_100')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_03', '...\n...\rThey tried to go into the tall grass because \nthey wanted Pokémon... \rHmm... \nWhat to do...? \rTheir world would surely change if they \nwere to meet Pokémon... \rIs it right for me to put them on that \npath...? ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_101')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_04', 'You two. You truly love Pokémon, do you \nnot? ')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'pos_r201_doctor_z1_retry')
	_JUMP('pos_r201_doctor_z1_after')
	_END()
pos_r201_doctor_z1_retry:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_111')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_07', 'Whoa, hold up! \nYou’re not making any sense here! ')
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_110')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_05', 'Er-hem! \nI didn’t quite catch that, so I will ask again. \rYou two. \nYou truly love Pokémon, do you not? ')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'pos_r201_doctor_z1_retry')
	_JUMP('pos_r201_doctor_z1_after')
	_END()
pos_r201_doctor_z1_after:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_08', 'Me, too! \nI love Pokémon, too! ')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_06', 'I will ask you once again. \nYou two. \rYou truly love Pokémon, do you not? ')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_09', 'What?! \nYou can ask a hundred times! \rThe answer will never change! We’ll both \nanswer a hundred times, yes!')
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_111')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_r201_hero_109')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_10', 'Right, {0,1,0,0}?', 0, 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'pos_r201_doctor_z1_retry2')
	_JUMP('pos_r201_doctor_z1_after2')
	_END()
pos_r201_doctor_z1_retry2:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_11', '... \nThat joke’s getting old! ')
	_JUMP('pos_r201_doctor_z1_after2')
	_END()
pos_r201_doctor_z1_after2:
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_07', '...A pair of reckless kids who foolishly try\nto enter tall grass without Pokémon of\ftheir own...?\rIt worries me what people\nlike that would do with Pokémon.')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_110')
	_OBJ_ANIME('HERO', 'anm_r201_hero_108')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_12', '...Uh...\nWell, I, uh...\r...\n...\rWell, then forget about me, but give\na Pokémon to my friend here!\rI mean, it was me who tried to go into\nthe tall grass and all...')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_08', 'Oh?! \nHow big of you... \rVery well, then! \nI will entrust you two with Pokémon! \rI apologize for putting you through \nthat exercise. \rHowever! \rYou must promise me that you will never \nrecklessly endanger yourselves again. \rNow, then... \rHm? \nNow, where...? ')
	_TALK_CLOSE()
	_CALL('ev_the_boy_girl_play')
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_102')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_103')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R201_SUPPORT', 'anm_r201_support_100')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_SUPP_01', 'Professor Rowan. \nYou left your briefcase at the lake! \rOh? \nIs something wrong here? ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_102')
	_JUMP('ev_r201_common_100')
ev_r201_common_100:
	_FLAG_RESET(#FV_D27R0101_KABAN)
	_FLAG_RESET(#FV_R201_DOCTOR)
	_FLAG_RESET(#FV_R201_SUPPORT)
	_OBJ_ADD('D27R0101_KABAN')
	_OBJ_ADD('R201_WALL_NORUNAWAY')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_09', 'Ah! There it is! \nNice work. \rWhat I was about to do was to entrust \nthese two with their own Pokémon. ')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_SUPP_02', 'Wha...?! \rThose Pokémon are crucial. \rYou’re giving them away? ')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_10', 'Hm! \nWe exist side by side with Pokémon. \rThere comes a time when people should \nmeet Pokémon. \rThere is a world that should be explored \ntogether. \rFor them, today is that time. \nThe place, right here. ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_103')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_11', 'Go on! Open the briefcase and \nchoose a Pokémon! ')
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_13', 'Really?! \nProf. Rowan! \rI can’t believe it! I’m so happy now \nthat I can’t keep a straight face! ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_111')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_14', 'Hey, {0,1,0,0}. \nYou can choose first. \rHey, I’m practically a grown-up. \nI have to show some class here. ', 0, 1)
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_110')
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_104')
	_OBJ_ANIME_WAIT()
	_SYS_FLAG_PAIR_RESET()
	_CALL('ev_character_theme_stop')
	_TALK_OBJ_END()
	_LDVAL(@477, 1)
	_END()
pos_r201_starter_script_4:
	_AC_ANIM_LOCK('HERO')
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_startled_leaving')
	_OBJ_ANIME_WAIT()
	_MACRO_EASY_OBJ_MSG('dialogue_r201', '00_msg_r201_no_leave', 'What’s up with you?\nOpen the briefcase and pick a Pokémon!')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'GE', 115, 'pos_r201_starter_func_8')
	_JUMP('pos_r201_starter_func_9')
pos_r201_starter_func_8:
	_OBJ_ANIME('HERO', 'anm_r201_hero_leaving')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r201_starter_func_30')
pos_r201_starter_func_9:
	_OBJ_ANIME('HERO', 'anm_r201_hero_leaving_2')
	_OBJ_ANIME_WAIT()
	_JUMP('pos_r201_starter_func_30')
pos_r201_starter_func_30:
	_AC_ANIM_RELEASE('HERO')
	_END()
anm_r201_rival_startled_leaving:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_r201_hero_leaving:
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_r201_hero_leaving_2:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_ACMD_END()
ev_r201_common_100_2:
	_TALK_OBJ_START()
	_LDVAL(@477, 2)
	_FLAG_RESET(#FV_D27R0101_POKE)
	_PLAYER_NAME(0)
	_TALK_CLOSE()
	_FIRST_POKE_SELECT_PROC(@SCWK_ANSWER)
	_FLAG_SET(#FE_INIT_CHANGE_OBJ_DEL)
	_FLAG_RESET(#FE_INIT_CHANGE_OBJ_DEL)
	_OBJ_DEL('D27R0101_KABAN')
	_OBJ_DEL('R201_WALL_NORUNAWAY')
	_FLAG_SET(#FV_D27R0101_KABAN)
	_OBJ_ADD('D27R0101_KABAN_02')
	_FLAG_RESET(#2844)
	_FIRST_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_d27r0101_bagball_vanish_nae')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_d27r0101_bagball_vanish_hiko')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_d27r0101_bagball_vanish_potya')
	_BGM_PLAY('EV_end')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 1000)
	_TIME_WAIT(3, @SCWK_ANSWER)
	_RESET_SYS_FLAG($SYS_BOX_SYSTEM_OFF); Allow you to access the Box from anywhere
	_LDVAL(@WK_SCENE_L01, 4)
	_JUMP('ev_r201_common_101')
	_END()
ev_d27r0101_bagball_vanish_nae:
	_INVISIBLE_OBJ_PROP('D27R0101_KABAN_02', 'P_C_001_BagBall_01')
	_INVISIBLE_OBJ_PROP('D27R0101_KABAN_02', 'P_C_001_BagBall_02')
	_RET()
ev_d27r0101_bagball_vanish_hiko:
	_INVISIBLE_OBJ_PROP('D27R0101_KABAN_02', 'P_C_001_BagBall_02')
	_INVISIBLE_OBJ_PROP('D27R0101_KABAN_02', 'P_C_001_BagBall_03')
	_RET()
ev_d27r0101_bagball_vanish_potya:
	_INVISIBLE_OBJ_PROP('D27R0101_KABAN_02', 'P_C_001_BagBall_03')
	_INVISIBLE_OBJ_PROP('D27R0101_KABAN_02', 'P_C_001_BagBall_01')
	_RET()
ev_r201_common_101:
	_PC_KAIFUKU()
	_RIVAL_NAME(0)
	_FIRST_POKEMON_NAME(1)
	_RIVAL_POKEMON_NAME(2)
	_OBJ_DEL('D27R0101_POKE_01')
	_OBJ_DEL('D27R0101_POKE_02')
	_OBJ_DEL('D27R0101_DOCTOR')
	_OBJ_DEL('D27R0101_SUPPORT')
	_OBJ_ANIME('HERO', 'anm_r201_hero_109')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_104')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_d27r0101_rival_13_1', 'Then, I choose you! \nI’m picking this {2,1,1,0}!', 1, 1)
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_DOCTOR_12', 'Very well! Both of you have chosen a good \nPokémon, it seems. \rNow, listen well! \rThe Pokémon you have been entrusted with \nare unfamiliar with the world. \rIn that regard, they’re much like you. \rAs fellow newcomers to the world, I hope \nyou’ll do well together. \rIf you have any trouble, come see me at my \nlab in Sandgem Town. \rAnd now, we’ll be on our way. ')
	_TALK_CLOSE()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_112')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R201_DOCTOR', 'anm_r201_doctor_105')
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_113')
	_OBJ_ANIME('HERO', 'anm_r201_hero_107')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_SUPP_03', 'Professor! \nWait for me! ')
	_TALK_CLOSE()
	_OBJ_DEL('D27R0101_KABAN_02')
	_FLAG_SET(#2844)
	_OBJ_ANIME('R201_SUPPORT', 'anm_r201_support_101')
	_OBJ_ANIME('HERO', 'anm_r201_hero_109')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_SUPP_04', 'Here, you should take this to keep yourself\nsafe while you are still new.')
	_LDVAL(@SCWK_TEMP0, 1303)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_BOUKENNOOTO_TIPS_OPEN(3, @SCWK_ANSWER)
	_BOUKENNOOTO_TIPS_WAIT()
	_FLAG_SET(#2453); Infinite Repel Chapter
	_OBJ_ANIME('R201_SUPPORT', 'anm_r201_support_102')
	_OBJ_ANIME('HERO', 'anm_r201_hero_107')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('R201_DOCTOR')
	_OBJ_DEL('R201_SUPPORT')
	_OBJ_DEL('R201_WALL05')
	_OBJ_DEL('R201_WALL06')
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_15', 'How do you like that? \nProf. Rowan’s really nice. \nOn TV, he seems so stern and scary. ')
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_111')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_r201_hero_109')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('R201_RIVAL', 'anm_r201_rival_115')
	_OBJ_ANIME_WAIT()
	_AC_ANIM_LOCK('HERO')
	_SYS_FLAG_PAIR_RESET()
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_16', 'Heheh, {1,1,0,0}. \rWe’ve both got Pokémon now. \nThere’s only one thing to do, right? \rAre you up for this? ')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r201_common_110_retry')
	_JUMP('ev_r201_common_110_after')
	_END()
ev_r201_common_110_retry:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_17', 'What’s with that attitude? \nDon’t be that way! ')
	_JUMP('ev_r201_common_110_after')
	_END()
ev_r201_common_110_after:
	_LDVAL(@SCWK_ANSWER, 0)
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_r201_0_hero1')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_18', 'I’ve always wanted to \nsay this... \rThe time has finally come! \n{1,1,0,0}, I challenge you to a battle! ')
	_CALL('ev_the_rival_play')
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_CALL('ev_block_doc')
	_SET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_LDVAL(@WK_SCENE_T01R0201, 3)
	_FLAG_SET(#2269)
	_AC_ANIM_RELEASE('HERO')
	_OBJ_ANIME_WAIT()
	_CALL('ev_r201_barry_battle')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_DIR_CHANGE('R201_RIVAL', 0)
	;If the player loses the battle
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_r201_barry_battle_lose')
	_JUMP('ev_r201_common_102')
	_END()
ev_r201_barry_battle_lose:
	_MACRO_TALKMSG('dialogue_r201', '83-msg_r0201_RIVAL_BATTLE_LOSE', 'Aha...\nAhaha... I won? I won!\rBut that battle, it could’ve gone\neither way. It was that close!\rI can tell you one thing: battling is\nawesomely fun!')
	_RET()
ev_r201_barry_battle:
	_RIVAL_POKE_NO_GET(@SCWK_ANSWER)
	_LDVAL(@SCWK_TEMP3, 663); Barry has Turtwig
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r201_barry_ret')
	_LDVAL(@SCWK_TEMP3, 664); Barry has Chimchar
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r201_barry_ret')
	_LDVAL(@SCWK_TEMP3, 665); Barry has Piplup
	_RET()
ev_r201_barry_ret:
	_RET()
ev_r201_common_102:
	_RESET_SYS_FLAG($SYS_ZENMETU_MUSI)
	_PC_KAIFUKU()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_r201', '00_msg_r201_barry_48', 'Whew!\nLet’s go home.\rI’m beat after that battle.\nMy Pokémon needs rest, too.\rSee ya, {1,1,0,0}.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R201_RIVAL')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_OBJ_DEL('R201_SUPPORT')
	_OBJ_DEL('R201_DOCTOR')
	_MAP_CHANGE('T01R0201', 2)
	_CALL('ev_block_doc_end')
	_BGM_NOW_MAP_PLAY()
	_TALK_END()
	_END()
