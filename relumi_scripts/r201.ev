	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_r201', '00_msg_l01_stopfix_1', 'Heheh, {1,1,0,0}.\nThe lake’s not that way!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'pos_r201_stop_player_back')
	_OBJ_ANIME_WAIT()
