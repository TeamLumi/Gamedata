	_SXY_POS_CHANGE('R201_DOCTOR', 113, 853)
	_OBJ_DIR_CHANGE('R201_DOCTOR', 270)
	_SXY_POS_CHANGE('R201_SUPPORT', 112, 853)
	_OBJ_DIR_CHANGE('R201_SUPPORT', 270)
	_RET()
