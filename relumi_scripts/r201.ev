	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r201_mew_legend_lose:
	_TALK_OBJ_END()
	_END()
ev_r201_boy1a:
	_MACRO_EASY_OBJ_MSG('dialogue_r201', '9-msg_r201_boy1a_01', 'That ledge is one way. Jump down for a shortcut\nto Twinleaf Town!')
	_END()
ev_r201_girl1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_ZUKAN_GET, 'ev_r201_girl1_zukan')
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_girl1_01', 'If your Pokémon’s health—its HP—is getting low,\nyou should go home and get some rest.')
	_JUMP('common_r201_girl1_end')
	_JUMP('common_r201_girl1_end')
common_r201_girl1_end:
