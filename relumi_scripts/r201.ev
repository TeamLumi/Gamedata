	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_girl1_02', 'If your Pokémon’s health—its HP—is getting low,\nyou should go to a Pokémon Center!')
	_JUMP('common_r201_girl1_end')
	_JUMP('ev_r201_shopman')
ev_r201_shopman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_R201_KIZUGUSURI_GET, 'ev_r201_shopman_02')
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_shopwoman_01_1', 'Hi! I work at a Poké Mart.')
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_shopwoman_01_2', 'Did you know that a Pokémon’s health is\nmeasured by Hit Points—HP for short?\rIf a Pokémon runs out of HP, it faints and can’t\nbattle anymore.\rIf a Pokémon’s HP gets low, you should heal it\nwith a Potion.', 1)
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_shopwoman_01_3', 'Here, let me give you some Potions as a sample.\nThese ones are free!\rThey will automatically go in your Bag’s\nMedicine pocket.', 1)
	_LDVAL(@SCWK_TEMP0, 17)
	_LDVAL(@SCWK_TEMP1, 10)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r201_shopman_01_item_event_fail')
	_FLAG_SET(#FE_R201_KIZUGUSURI_GET)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r201_shopman_02:
	_MACRO_TALKMSG('dialogue_r201', '9-msg_r201_shopwoman_02', 'You can find a Poké Mart in cities and most\nmajor towns.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r201_shopman_01_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r201_sign1:
	_EASY_BOARD_MSG('dialogue_r201%9-msg_r201_sign1_01', 'BOARD_TYPE_ROAD', 0, 4)
	_END()
ev_r201_sign2:
	_EASY_BOARD_MSG('dialogue_r201%9-msg_r201_sign2_01', 'BOARD_TYPE_ROAD', 0, 1)
	_END()
ev_r201_sign3:
	_EASY_INFOBOARD_MSG('dialogue_r201%9-msg_r201_sign3_01_1', 'BOARD_TYPE_INFO', 0)
	_EASY_INFOBOARD_MSG('dialogue_r201%9-msg_r201_sign3_01_2', 'BOARD_TYPE_INFO', 0)
	_END()
ev_r201_doctor:
	_MACRO_EASY_OBJ_MSG('dialogue_r201', 'msg_r201_doctor', 'Go on! Open the briefcase and choose a\nPokémon!')
	_END()