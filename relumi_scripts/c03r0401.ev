	_RET()
ev_c03r0401_assistantm_itemno_check_12_1:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_192', 11) ; Quit option
	_RET()
ev_c03r0401_one_kaseki:
	_KASEKI_ITEMNO(@SCWK_PARAM2, @SCWK_TEMP0, 1)
	_ITEMNO_TO_MONSNO(@SCWK_PARAM2, @WK_SCENE_KASEKI_MONSNO, @491) ; ItemNo, MonsNo, FormNo
	_SUB_ITEM(@SCWK_PARAM2, 1, @SCWK_ANSWER)
	_JUMP('ev_c03r0401_assistantm_06')
	_JUMP('ev_c03r0401_assistantm_06')
ev_c03r0401_assistantm_06:
	_FLAG_SET(#FH_01)
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_06', 'I am in the process of extracting your Pokémon\nfrom a Fossil.\rYou go outside, yes, please. Now! Time alone is\nwhat I now need. NOW!!!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0401_assistantm_05:
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_05', 'You don’t wish that I extract any Pokémon from a\nFossil. Fine, then!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
c03r0401_uketori_chk:
	_POKEMON_NAME_EXTRA(0, @WK_SCENE_KASEKI_MONSNO, 0, 0)
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_07', 'You were gone too long! You kept us\nwaiting! Unacceptable!\rThis is your {0,1,1,0}! You be good to\nit! OK!')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 0, 'ev_c03r0401_assistantm_08'); Party and Boxes are not full
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_08', 'But, no, I cannot do this! You have too many\nPokémon with you!\rI must hold this Pokémon for you, so come back,\nyou, and take it away, please.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0401_assistantm_08:
	_POKEMON_NAME_EXTRA(1, @WK_SCENE_KASEKI_MONSNO, 0, 0)
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_11', 'You received {1,1,1,0}!')
	_ME_WAIT()
	_ADD_POKEMON_UI_EXTRA(@WK_SCENE_KASEKI_MONSNO, @491, 1, 0, 3, 4) ; MonsNo, FormNo, Level, Item, MaxIVs, BallId
	_LDVAL(@WK_SCENE_KASEKI_MONSNO, 0) ; Resets Fossil MonsNo
	_LDVAL(@491, 0) ; Resets Fossil FormNo
	_END()
ev_c03r0401_assistantm_09:
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_09', 'If it is a Fossil that you obtain, bring it to me if\nyou must.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0401_assistantm_10:
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_10', 'On the verge of a breakthrough, I am, to achieve\nextraction from Fossils.\rFrom Fossils I can extract Pokémon, but not yet,\nnot yet.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0401_mount:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_mount_01', 'Whoa! So this is coal? I never expected\nsomething this big!')
	_END()
ev_c03r0401_babygirl1:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_babygirl1_01', 'Wow! The Pokémon that carried this must be\nterribly strong!')
	_END()
ev_c03r0401_boy1:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_boy1_01', 'Well, how about that! Oreburgh Mine extends\nunder the seafloor!')
	_END()
ev_c03r0401_rack1:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_rack1_01', 'How Coal Is Made: Part 1\r“In a time long before history, vegetative matter\nwas swept along by rain and rivers. It came to be\fburied under the ground.”')
	_END()
ev_c03r0401_rack2:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_rack2_01', 'How Coal Is Made: Part 2\r“The buried plant matter was forced ever deeper\nunderground due to tremors and fissures\fcaused by the shifting landmasses.”')
	_END()
ev_c03r0401_rack3:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_rack3_01', 'How Coal Is Made: Part 3\r“Deep underground, the plant matter was\nsubjected to heavy pressure and the heat\fof magma. It gradually turned into coal.”')
	_END()
ev_c03r0401_case1:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_case1_01', 'Samples of coal from different regions\nare displayed.')
	_END()
ev_c03r0401_case2:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_case2_01', 'The box contains categorized samples of coal.')
	_END()
ev_c03r0401_case3:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_case3_01', 'Different kinds of lamps are displayed.\rThey appear to have been worn on someone’s\nhead while the person was underground.')
	_END()
ev_c03r0401_case4:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_case4_01', 'Badly scarred wooden tools are displayed.\rThey apparently dug out coal using these tools in\nthe olden days.')
	_END()
ev_c03r0401_case5:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_case5_01', 'The everyday items and tools of past mine\nworkers are displayed.')
	_END()
ev_c03r0401_script_14:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '00_msg_c03r0401_script_14_1', 'It’s a little far from here, but there\nis a city called Eterna City.\rI’ve heard a curious person named the\nUnderground Man lives there.\rWith a name like that, he must be an\nauthority on the Underground.')
	_END()
ev_c03r0401_script_15:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '00_msg_c03r0401_script_15_1', 'Mining must take a strong mind, not\njust a tough body.\rThink about it. You’re in darkness,\ndigging desperately through rock.')
	_END()
ev_c03r0401_script_16:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '00_msg_c03r0401_script_16_1', 'The history of Oreburgh Mine...\rYou could call it a history of effort and\nfriendship between people and Pokémon.')
	_END()