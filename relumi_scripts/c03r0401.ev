ev_c03r0401_menu_skip2_1:
	_ITEMNO_TO_MONSNO(@SCWK_PARAM2, @WK_SCENE_KASEKI_MONSNO, @491) ; ItemNo, MonsNo, FormNo
	_IFVAL_JUMP(@WK_SCENE_KASEKI_MONSNO, 'EQ', 0, 'ev_c03r0401_assistantm_05') ; The player rejects the transformation?
	_SUB_ITEM(@SCWK_PARAM2, 1, @SCWK_ANSWER)
	_JUMP('ev_c03r0401_assistantm_06')
	_JUMP('ev_c03r0401_assistantm_itemno_check_1_1')
ev_c03r0401_assistantm_itemno_check_1_1:
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_156', 0)
	_RET()
