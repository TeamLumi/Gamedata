	_RET()
ev_c03r0401_assistantm_itemno_check_8_1:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_coverfossil', 'Cover Fossil', 7)
	_RET()
ev_c03r0401_assistantm_itemno_check_9_1:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_plumefossil', 'Plume Fossil', 8)
	_RET()
ev_c03r0401_assistantm_itemno_check_10_1:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_jawfossil', 'Jaw Fossil', 9)
	_RET()
