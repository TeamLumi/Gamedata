ev_c03r0401_woman6:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0401', '78-msg_c03r0401_woman6_01', 'Hello! Welcome to the Oreburgh\nMining Museum!')
	_END()
ev_c03r0401_assistantm:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FH_01, 'ev_c03r0401_assistantm_06')
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_01', 'Hello, hello! How are you?\nI study Pokémon Fossils! Me! Right here and now!')
	_IF_FLAGOFF_JUMP(#FE_TANKENSETTO_GET, 'ev_c03r0401_assistantm_10')
	_IFVAL_JUMP(@WK_SCENE_KASEKI_MONSNO, 'NE', 0, 'c03r0401_uketori_chk') ; If there is a pending fossil to be received (Pokémon ID stored in @WK_SCENE_KASEKI_MONSNO)
	_KASEKI_COUNT(@SCWK_PARAM0)
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', 0, 'ev_c03r0401_assistantm_09')
	_MACRO_TALKMSG('dialogue_c03r0401', '78-msg_c03r0401_assistantm_02', 'You have a Fossil for me, yes? Shall I turn it into\na Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c03r0401_assistantm_05_yes_2')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_05')
	_JUMP('ev_c03r0401_assistantm_05_yes_2')
ev_c03r0401_assistantm_05_yes_2:
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', 1, 'ev_c03r0401_assistantm_05_yes_3') ; This triggers when you only have one fossil
	_JUMP('ev_c03r0401_assistantm_05_yes_4')
	_END()
ev_c03r0401_assistantm_05_yes_3:
	_ITEM_CHK(103, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork1_itemno_get_sin')
	_ITEM_CHK(101, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork2_itemno_get_sin')
	_ITEM_CHK(102, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork3_itemno_get_sin')
	_ITEM_CHK(99, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork4_itemno_get_sin')
	_ITEM_CHK(100, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork5_itemno_get_sin')
	_ITEM_CHK(104, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork6_itemno_get_sin')
	_ITEM_CHK(105, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork7_itemno_get_sin')
	_ITEM_CHK(572, 1, @SCWK_ANSWER); Cover Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork8_itemno_get_sin')
	_ITEM_CHK(573, 1, @SCWK_ANSWER); Plume Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork9_itemno_get_sin')
	_ITEM_CHK(710, 1, @SCWK_ANSWER); Jaw Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork10_itemno_get_sin')
	_ITEM_CHK(711, 1, @SCWK_ANSWER); Sail Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_localwork11_itemno_get_sin')
	_END()
ev_c03r0401_assistantm_05_yes_4:
	_ITEM_CHK(103, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_1_1')
	_ITEM_CHK(101, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_2_1')
	_ITEM_CHK(102, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_3_1')
	_ITEM_CHK(99, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_4_1')
	_ITEM_CHK(100, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_5_1')
	_ITEM_CHK(104, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_6_1')
	_ITEM_CHK(105, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_7_1')
	_ITEM_CHK(572, 1, @SCWK_ANSWER); Cover Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_8_1')
	_ITEM_CHK(573, 1, @SCWK_ANSWER); Plume Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_9_1')
	_ITEM_CHK(710, 1, @SCWK_ANSWER); Jaw Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_10_1')
	_ITEM_CHK(711, 1, @SCWK_ANSWER); Sail Fossil
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c03r0401_assistantm_itemno_check_11_1')
	_CALL('ev_c03r0401_assistantm_itemno_check_12_1') ; Quit option
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c03r0401_assistantm_localwork1_itemno_get_sin')
	_CASE_JUMP(1, 'ev_c03r0401_assistantm_localwork2_itemno_get_sin')
	_CASE_JUMP(2, 'ev_c03r0401_assistantm_localwork3_itemno_get_sin')
	_CASE_JUMP(3, 'ev_c03r0401_assistantm_localwork4_itemno_get_sin')
	_CASE_JUMP(4, 'ev_c03r0401_assistantm_localwork5_itemno_get_sin')
	_CASE_JUMP(5, 'ev_c03r0401_assistantm_localwork6_itemno_get_sin')
	_CASE_JUMP(6, 'ev_c03r0401_assistantm_localwork7_itemno_get_sin')
	_CASE_JUMP(7, 'ev_c03r0401_assistantm_localwork8_itemno_get_sin')
	_CASE_JUMP(8, 'ev_c03r0401_assistantm_localwork9_itemno_get_sin')
	_CASE_JUMP(9, 'ev_c03r0401_assistantm_localwork10_itemno_get_sin')
	_CASE_JUMP(10, 'ev_c03r0401_assistantm_localwork11_itemno_get_sin')
	_CASE_JUMP(11, 'ev_c03r0401_assistantm_05')
	_JUMP('ev_c03r0401_assistantm_05')
	_END()
ev_c03r0401_assistantm_localwork1_itemno_get_sin:
	_LDVAL(@SCWK_PARAM2, 103)
	_JUMP('ev_c03r0401_menu_skip2_1')
	_JUMP('ev_c03r0401_assistantm_itemno_check_1_1')
