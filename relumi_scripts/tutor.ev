	_LOAD_MOVE_TUTOR_TABLE(11)
	_RET()
ev_lumi_move_tutor_disable_dev_dj_4_table: ; Disables adding Glitzy Glow to the UI after learning it from Dev DJ
	_FLAG_SET(#1787)
	_RET()

ev_lumi_move_tutor_add_dev_dj_5_table: ; Baddy Bad #1786
	_LOAD_MOVE_TUTOR_TABLE(12)
	_RET()
ev_lumi_move_tutor_disable_dev_dj_5_table: ; Disables adding Baddy Bad to the UI after learning it from Dev DJ
	_FLAG_SET(#1786)
	_RET()

ev_lumi_move_tutor_add_dev_dj_6_table: ; Sappy Seed #1785
	_LOAD_MOVE_TUTOR_TABLE(13)
	_RET()
ev_lumi_move_tutor_disable_dev_dj_6_table: ; Disables adding Sappy Seed to the UI after learning it from Dev DJ
	_FLAG_SET(#1785)
	_RET()

ev_lumi_move_tutor_add_dev_dj_7_table: ; Freezy Frost #1784
	_LOAD_MOVE_TUTOR_TABLE(14)
	_RET()
ev_lumi_move_tutor_disable_dev_dj_7_table: ; Disables adding Freezy Frost to the UI after learning it from Dev DJ
	_FLAG_SET(#1784)
	_RET()

ev_lumi_move_tutor_add_dev_dj_8_table: ; Sparkly Swirl #1783
	_LOAD_MOVE_TUTOR_TABLE(15)
	_RET()
ev_lumi_move_tutor_disable_dev_dj_8_table: ; Disables adding Sparkly Swirl to the UI after learning it from Dev DJ
	_FLAG_SET(#1783)
	_RET()

ev_lumi_move_tutor_open_menu: ; Now we open the UI
	_MOVE_TUTOR_UI(@SCWK_ANSWER, @SCWK_PARAM0, @SCWK_PARAM1) ; Open the move tutor UI with the stored tables and put the result into SCWK_ANSWER
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_lumi_move_tutor_no_moves') ; -1 if no moves in the stored tables can be learned by the selected Pokémon
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_lumi_move_tutor_cancel') ; 0 if the relearning was canceled
	_JUMP('ev_lumi_move_tutor_success')

ev_lumi_move_tutor_success: ; Player has successfully taught a move
	_POKEMON_NAME_EXTRA(0, @SCWK_PARAM2)
	_WAZA_NAME(1, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_tutor', 'lumi_move_tutor_success', 'Your {0,1,1,0} now knows the move\n{1,1,7,0}!')
	_MACRO_TALKMSG('dialogue_tutor', 'lumi_move_tutor_again', 'Would you like me to teach\nanother move to this Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_lumi_move_tutor_cancel')
	_TALK_CLOSE()
	_JUMP('ev_lumi_move_tutor_prepare')