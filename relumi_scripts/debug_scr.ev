ev_debug_ug_mount_off:
	_FLAG_SET(#FV_UG_MOUNT)
	_LDVAL(@WK_SCENE_UG, 1)
	_END()
ev_debug_d27r0101_off:
	_FLAG_RESET(#FV_R201_DOCTOR)
	_FLAG_RESET(#FV_R201_SUPPORT)
	_LDVAL(@WK_SCENE_D27R0101, 1)
	_LDVAL(@WK_SCENE_L01, 2)
	_FLAG_RESET(#FV_L01_RIVAL)
	_LDVAL(@WK_SCENE_R201, 2)
	_LDVAL(@WK_SCENE_T01R0201, 3)
	_END()
ev_debug_c07_soukonokagi:
	_FLAG_RESET(#FV_FLD_ITEM_238)
	_END()
ev_debug_l01_l02_l03_lake:
	_FLAG_RESET(#FV_D27R0101_SUPPORT)
	_FLAG_RESET(#FV_D27R0101_DOCTOR)
	_LDVAL(@WK_SCENE_D27R0101, 1)
	_FLAG_SET(#FV_D27R0101_KABAN)
	_FLAG_SET(#FV_D27R0101_RIVAL)
	_FLAG_SET(#FV_L02_GINGAM)
	_FLAG_RESET(#FV_D29R0101_RIVAL)
	_END()
ev_debug_pc_ug:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_LDVAL(@WK_SCENE_C01_GTC, 1)
	_LDVAL(@WK_SCENE_PC0103, 1)
	_END()

ev_c01_debug_give_all_pokemon:
	;Flag 2909 has to be reset via the debug menu for the PlaceData to appear
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_give_all_pokemon', 'I will give you all Pokémon, but first, make\nsure to have completed the following steps:\r- Register all Pokémon in the dex with the\nDebug Menu.\r- Turn off the nickname feature in Settings.\n- Turn on auto send to boxes in Settings.\f- Set background Music to 0.\rHave you completed all steps?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_give_all_pokemon_yes')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_debug_give_all_pokemon_yes:
	;Sets a work value to determine shininess
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_give_all_pokemon_shiny', 'Do you want the Pokémon to be shiny?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_042', 0) ; No
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_041', 1) ; Yes
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_shiny_square', 'Square Shinies Please (The sparkles look the same)', 2)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_shiny_surprise', 'Surprise me (Normal Random)', -1)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_give_all_pokemon_shiny_no')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_debug_give_all_pokemon_shiny_yes')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_c01_debug_give_all_pokemon_shiny_square')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', -1, 'ev_c01_debug_give_all_pokemon_shiny_surprise')
	;Select a gen to receive all Pokémon from it
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_give_all_pokemon_yes', 'Which generation would you like?')
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen1', 'Gen 1', 0)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen2', 'Gen 2', 1)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen3', 'Gen 3', 2)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen4', 'Gen 4', 3)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen5', 'Gen 5', 4)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen6', 'Gen 6', 5)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen7', 'Gen 7', 6)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen8', 'Gen 8', 7)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_gen9', 'Gen 9', 8)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_debug_all', 'Gotta catch ’em all!', 9)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_give_all_pokemon_yes_gen1')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_debug_give_all_pokemon_yes_gen2')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_c01_debug_give_all_pokemon_yes_gen3')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_c01_debug_give_all_pokemon_yes_gen4')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 4, 'ev_c01_debug_give_all_pokemon_yes_gen5')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 5, 'ev_c01_debug_give_all_pokemon_yes_gen6')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 6, 'ev_c01_debug_give_all_pokemon_yes_gen7')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 7, 'ev_c01_debug_give_all_pokemon_yes_gen8')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 8, 'ev_c01_debug_give_all_pokemon_yes_gen9')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 9, 'ev_c01_debug_give_all_pokemon_yes_all')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_debug_give_all_pokemon_shiny_no:
	_LDVAL(@SCWK_TEMP0, 0)
	_RET()
ev_c01_debug_give_all_pokemon_shiny_yes:
	_LDVAL(@SCWK_TEMP0, 1)
	_RET()
ev_c01_debug_give_all_pokemon_shiny_square:
	_LDVAL(@SCWK_TEMP0, 2)
	_RET()
ev_c01_debug_give_all_pokemon_shiny_surprise:
	_LDVAL(@SCWK_TEMP0, -1)
	_RET()
ev_c01_debug_give_all_pokemon_yes_all:
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen1')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen2')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen3')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen4')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen5')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen6')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen7')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen8')
	_CALL('ev_c01_debug_give_all_pokemon_yes_gen9')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
