	_RET()


ev_c01_debug_fight_all_pokemon:
	;Flag 2909 has to be reset via the debug menu for the PlaceData to appear
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_fight_all_pokemon', 'You can fight all Pokémon, but first, I suggest\nthat you put a Level 100 Pokémon with the\fability Scrappy and a normal type move, at\fthe lead of your party.\rYou may also want to turn off battle effects.\rYou will be healed automatically between each\nfight.\rThis process will take some time.\nDo you wish to proceed?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_fight_all_pokemon_yes')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_debug_fight_all_pokemon_yes:
	;Sets a work value to determine shininess
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_give_all_pokemon_shiny', 'Do you want the Pokémon to be shiny?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_042', 0) ; No
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_041', 1) ; Yes
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_shiny_square', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_shiny_surprise', -1)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_fight_all_pokemon_shiny_no')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_debug_fight_all_pokemon_shiny_yes')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_c01_debug_fight_all_pokemon_shiny_square')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', -1, 'ev_c01_debug_fight_all_pokemon_shiny_surprise')
	;Select a gen to fight all Pokémon from it
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_give_all_pokemon_yes', 'Which generation would you like?')
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen1', 0)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen2', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen3', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen4', 3)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen5', 4)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen6', 5)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen7', 6)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen8', 7)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_gen9', 8)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_debug_all', 9)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_TALK_CLOSE()
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_fight_all_pokemon_yes_gen1')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c01_debug_fight_all_pokemon_yes_gen2')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_c01_debug_fight_all_pokemon_yes_gen3')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_c01_debug_fight_all_pokemon_yes_gen4')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 4, 'ev_c01_debug_fight_all_pokemon_yes_gen5')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 5, 'ev_c01_debug_fight_all_pokemon_yes_gen6')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 6, 'ev_c01_debug_fight_all_pokemon_yes_gen7')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 7, 'ev_c01_debug_fight_all_pokemon_yes_gen8')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 8, 'ev_c01_debug_fight_all_pokemon_yes_gen9')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 9, 'ev_c01_debug_fight_all_pokemon_yes_all')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_debug_fight_all_pokemon_shiny_no:
	_LDVAL(@SCWK_TEMP0, 0)
	_RET()
ev_c01_debug_fight_all_pokemon_shiny_yes:
	_LDVAL(@SCWK_TEMP0, 1)
	_RET()
ev_c01_debug_fight_all_pokemon_shiny_square:
	_LDVAL(@SCWK_TEMP0, 2)
	_RET()
ev_c01_debug_fight_all_pokemon_shiny_surprise:
	_LDVAL(@SCWK_TEMP0, -1)
	_RET()
ev_c01_debug_fight_all_pokemon_yes_all:
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen1')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen2')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen3')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen4')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen5')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen6')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen7')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen8')
	_CALL('ev_c01_debug_fight_all_pokemon_yes_gen9')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
