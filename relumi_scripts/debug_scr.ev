ev_c01_debug_mirror_wild_battle:
	;Flag 2909 has to be reset via the debug menu for the PlaceData to appear
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle', 'Do you want to take part in a mirror battle?\nBe warned that your party will be wiped.')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01_debug_mirror_wild_battle_remove_party')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01_debug_mirror_wild_battle_remove_party:
	_RELEASE_BOX_POKE(5, -1)
	_RELEASE_BOX_POKE(4, -1)
	_RELEASE_BOX_POKE(3, -1)
	_RELEASE_BOX_POKE(2, -1)
	_RELEASE_BOX_POKE(1, -1)
	_RELEASE_BOX_POKE(0, -1)
	_JUMP('ev_c01_debug_mirror_wild_battle_choose_pokemon')
ev_c01_debug_mirror_wild_battle_choose_pokemon:
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle_choose_pokemon_species', 'What species do you want?')
	_CUSTOM_NUMBER_INPUT(@LOCALWORK0, 9999, 'SS_strinput_debug_species')
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle_choose_pokemon_form', 'What form do you want?')
	_CUSTOM_NUMBER_INPUT(@LOCALWORK1, 999, 'SS_strinput_debug_form')
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle_choose_pokemon_level', 'What level do you want?')
	_CUSTOM_NUMBER_INPUT(@LOCALWORK2, 100, 'SS_strinput_debug_level')
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle_choose_pokemon_gender', 'What gender do you want?')
	_CALL('ev_c01_debug_mirror_wild_battle_choose_gender')
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle_choose_pokemon_variant', 'What variant do you want?')
	_CUSTOM_NUMBER_INPUT(@LOCALWORK4, 999, 'SS_strinput_debug_variant')
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_c01_debug_mirror_wild_battle_choose_pokemon_shiny', 'Do you want them to be shiny?')
	_CALL('ev_c01_debug_mirror_wild_battle_choose_shiny')
	_TALK_CLOSE()
	_ADD_POKEMON_EXTRA(@LOCALWORK0, @LOCALWORK1, @LOCALWORK2, 0, 0, 4, @LOCALWORK5, @LOCALWORK3, @LOCALWORK4)
	_SP_WILD_BTL_SET_EXTRA(@LOCALWORK0, @LOCALWORK1, @LOCALWORK2, 0, @LOCALWORK5, @LOCALWORK3, @LOCALWORK4, -1, -1, 0, 'LUMI_BGM_BATTLE_004')
	_TALK_OBJ_END()
	_END()
ev_c01_debug_mirror_wild_battle_choose_gender:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Male', 'Male', 0)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Female', 'Female', 1)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Genderless', 'Genderless', 2)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Random', 'Random', -1)
	_OPEN_CUSTUM_WIN(@LOCALWORK3)
	_RET()
ev_c01_debug_mirror_wild_battle_choose_shiny:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Not_Shiny', 'Not Shiny', 0)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Shiny', 'Shiny', 1)
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_options_Random', 'Random', -1)
	_OPEN_CUSTUM_WIN(@LOCALWORK5)
	_RET()

ev_player_sit_debug:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_PLAYER_DIR_GET(@SCWK_TEMP2)
	_GET_NOW_ZONE_ID(@SCWK_TEMP3)
	_DEBUG_LOG('PLAYERX', -1, @SCWK_TEMP0)
	_DEBUG_LOG('PLAYERY', 1, @SCWK_TEMP1)
	_DEBUG_LOG('PLAYERDIR', 1, @SCWK_TEMP2)
	_DEBUG_LOG('PLAYERZONE', 1, @SCWK_TEMP3)
	_END()
ev_get_tile_attribute_debug:
	_EVENT_START()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_GET_TILE_ATTRIBUTE(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_TEMP2, @SCWK_TEMP3)
	_NUMBER_NAME(0, @SCWK_TEMP2)
	_NUMBER_NAME(1, @SCWK_TEMP3)
	_MACRO_TALKMSG('dialogue_debug_scr', 'msg_get_tile_attribute_debug', 'Code: {0,2,1,0}, Stop: {1,2,1,0}')
	_TALK_CLOSE()
	_EVENT_END()
	_END()