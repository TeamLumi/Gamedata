ev_c04r0101_middlem:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_CYCLE_GET, 'ev_c04r0101_middlem1a_02')
	_EVENT_CAMERA_INDEX(514)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0101', '4-msg_c04r0101_middlem_01', 'Thanks for rescuing me. I can’t thank you enough!\nSay, let me give you a bike to show my gratitude!')
	_MACRO_TALKMSG('dialogue_c04r0101', '4-msg_c04r0101_middlem_02', 'Oh, what’s that? You already own\nthis exact bicycle?\rHah! Looks like your mother has some\ngood taste in vehicles!\rThen, I’ll let you have this rare stone\nmy Clefairy found instead!')
	_LDVAL(@SCWK_TEMP0, 109); Assign dawn stone
	_LDVAL(@SCWK_TEMP1, 1); Assign quantity of 1
	_CALL('ev_item_event')
	_CALL('ev_c04r0101_middlem1a_03')
	_TALK_CLOSE()
	_FLAG_SET(#FE_CYCLE_GET)
	_FLAG_SET(#2618); Disable the stoppers at the bottom of the cycling road
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 5600)
	_EVENT_CAMERA_INDEX(515)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_END()
	_END()
ev_c04r0101_middlem1a_02:
	_CALL('ev_c04r0101_middlem1a_03')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0101_middlem1a_03:
	_MACRO_TALKMSG('dialogue_c04r0101', '18-msg_c04r0101_middlemla_04', 'That beautiful stone shines like the rising sun, and\ncan make certain species of Pokémon evolve!')
	_RET()
ev_c04r0101_pippi:
	_EASY_VOICE_MSG('dialogue_c04r0101%4-msg_c04r0101_pippi_02', 'PLAY_PV_EV_035_00_00')
	_END()
ev_c04r0101_boy2:
	_TALK_OBJ_START_TURN_NOT()
	_IF_FLAGON_JUMP(#FE_C04R0204_WIN, 'ev_c04r0101_boy2_02')
	_MACRO_TALKMSG('dialogue_c04r0101', '4-msg_c04r0101_boy2_01', 'The manager’s gone off to the Team Galactic\nbuilding and hasn’t returned.\rI wonder what’s holding him up.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0101_boy2_02:
	_MACRO_TALKMSG('dialogue_c04r0101', '4-msg_c04r0101_boy2_02', 'What was Team Galactic trying to do with other\npeople’s Pokémon?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0101_rack1:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0101', '4-msg_c04r0101_rack1_01', 'There is a manual on the latest model of bicycle.\rThird gear for steering.\nFourth gear for all-out speed!\rChange gears with the B Button for\nexhilarating cycling!')
	_TALK_CLOSE()
	_END()
ev_c04r0101_rack2:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0101', '4-msg_c04r0101_rack2_01_1', 'There’s a catalog on bikes...\rThe Mach Bike—a folding bike built solely for\nblazing speed!')
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0101', '4-msg_c04r0101_rack2_01_2', 'The Acro Bike—a folding bike designed for stunts\nlike jumps and wheelies!')
	_TALK_CLOSE()
	_END()