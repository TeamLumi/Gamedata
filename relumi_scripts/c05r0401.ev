ev_c05r0401_flag_change:
	_TV_INTERVIEWER_CHECK(13, @LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c05r0401_flag_change_vanish')
	_FLAG_RESET(#FV_TV_INTERVIEW_13)
	_END()
ev_c05r0401_flag_change_vanish:
	_FLAG_SET(#FV_TV_INTERVIEW_13)
	_END()
ev_c05r0401_woman6:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0401', '46-msg_c05r0401_woman6_01', 'You can take a cute Pokémon out for a stroll in\nAmity Square.')
	_END()
ev_c05r0401_fighter:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0401', '46-msg_c05r0401_fighter_01', 'I’m appalled! They refused entry to my Pokémon!\nOh, my poor Gyarados and Steelix!')
	_END()