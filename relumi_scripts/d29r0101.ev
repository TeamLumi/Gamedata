ev_d29r0101_flag_change:
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_d29r0101_flag_change_bgm')
	_END()
ev_d29r0101_flag_change_bgm:
	_END()
ev_d29r0101_rival:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_D29R0101_RIVAL_TALK, 'ev_d29r0101_rival_02')
	_FLAG_SET(#FE_D29R0101_RIVAL_TALK)
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_d29r0101', '189-msg_d29r0101_rival_a_01_1', 'What are you doing? You’re not supposed to\nbe here.\rThere’s nothing here anyway. If anything were to\nhappen, it’s in my good hands.')
	_MACRO_TALKMSG('dialogue_d29r0101', '189-msg_d29r0101_rival_a_01_2', 'I’ve got my trusty Pokémon with me, for one.\rAnd more than anything, I’m tough—and you\nknow it!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d29r0101_rival_02:
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_d29r0101', '189-msg_d29r0101_rival_a_02_1', 'What’d I say? There’s nothing here!\nGo check out the other lake.')
	_MACRO_TALKMSG('dialogue_d29r0101', '189-msg_d29r0101_rival_a_02_2', 'Even if something happens, I’m here.\nSo no worries!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()