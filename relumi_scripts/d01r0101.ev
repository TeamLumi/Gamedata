ev_d01r0101_workman:
	_MACRO_EASY_OBJ_MSG('dialogue_d01r0101', '85-msg_d01r0101_workman_01', 'Everyone who works in the coal mine keeps their\nown Pokémon with them.\rYou may be challenged to battles! Hahaha!')
	_END()
ev_d01r0101_babygirl:
	_MACRO_EASY_OBJ_MSG('dialogue_d01r0101', '85-msg_d01r0101_babygirl1_01', 'There were Pokémon that looked just like rocks!\nThey sure surprised me!')
	_END()