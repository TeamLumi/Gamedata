ev_c08r0401_oldman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c08r0401', '5-msg_c08r0401_oldman2_01', 'I’d heard that Team Galactic was up to no good.\rBut here in Sunyshore, we’ve never even seen any\nof them around.')
	_END()
ev_c08r0401_oldwoman2:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c08r0401', '5-msg_c08r0401_oldwoman2_01', 'A long time ago, there was a boy named Cyrus\nwho lived here.\rHe seemed to shun others, and he preferred the\ncompany of machines.\rHe was a brilliant student, I recall. I often wonder\nwhat became of him.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()