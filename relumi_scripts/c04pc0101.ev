ev_c04pc0101_flag_change:
	_IF_FLAGON_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c04pc0101_flag_change_end')
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(2, 80, 80)
	_END()
ev_c04pc0101_flag_change_end:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C03, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04pc0101_flag_change_del_stopper')
	_END()
ev_c04pc0101_flag_change_del_stopper:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_END()
ev_c04pc0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()
ev_c04pc0101_badman:
	_MACRO_EASY_OBJ_MSG('dialogue_c04pc0101', '2-msg_c04pc0101_badman_01', 'After all, to be strong, you need to raise\ndifferent types of Pokémon!')
	_END()
ev_c04pc0101_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_c04pc0101', '2-msg_c04pc0101_girl2_01', 'When a Pokémon faints, use a Revive on the\nPokémon. It’ll be able to battle again!')
	_END()
ev_c04pc0101_boy1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C04R0204_WIN, 'ev_c04pc0101_boy1_02')
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_boy1_01', 'Team Galactic took my Pokémon away.\nThey took other people’s, too.\rSomething should be done, but Team Galactic\ncreeps everyone out...\rWhat are they doing to my Pokémon?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_boy1_02:
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_boy1_02', 'I got my Pokémon back!\rI’m so happy, I feel like riding my bike down\nCycling Road together with it!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_gonbe:
	_EASY_VOICE_MSG('dialogue_c04pc0101%2-msg_c04pc0101_gonbe_01', 'PLAY_PV_EV_427_00_00')
	_END()
ev_c04pc0101_woman1:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'ev_c04pc0101_woman1_02')
	_POKETCH_CHECK(5, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04pc0101_woman1_01')
	_FRONT_POKEMON(@SCWK_PARAM0)
	_POKEMON_NAME(0, @SCWK_PARAM0)
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_woman1_03', 'Hi, you cute little Trainer! What kinds of\nPokémon are with you?\rOh, your {0,1,1,0}...')
	_GET_NATSUKI(@SCWK_ANSWER, @SCWK_PARAM0, -1)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 120, 'ev_c04pc0101_woman1_04')
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 70, 'ev_c04pc0101_woman1_05')
	_JUMP('ev_c04pc0101_woman1_06')
	_END()
ev_c04pc0101_woman1_01:
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_woman1_01', 'Hi, you cute little Trainer! What kinds of\nPokémon are with you?\rThis Pokétch app will show how close your\nPokémon feel to you.')
	_LDVAL(@LOCALWORK0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_woman1_02:
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_woman1_02', 'If you spend enough time with them, all Pokémon\nwill open up to you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_woman1_04:
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_woman1_04', 'It seems to like you. It must be happy being\nwith you.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_woman1_05:
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_woman1_05', 'It’s becoming comfortable around you, I think.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_woman1_06:
	_MACRO_TALKMSG('dialogue_c04pc0101', '2-msg_c04pc0101_woman1_06', 'Hmm... It needs to get used to you more.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_jirachi_event:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2669, 'ev_c04pc0101_jirachi_event_done')
	_MACRO_TALKMSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_jirachi_event_1', 'Hello, Trainer!\nI have a dream.\rCould you help my Clefairy\nlearn Dazzling Gleam?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04pc0101_jirachi_event_no')
	_ITEM_CHK(348, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c04pc0101_jirachi_event_no')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_jirachi_event_2', '{0} booted up the TM.\r...\r...')
	_SE_PLAY('M_FI014')
	_MACRO_TALKMSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_jirachi_event_3', 'Clefairy learned\nDazzling Gleam!')
	_TALK_CLOSE()
	_VOICE_PLAY(35, 0, 0)
	_VOICE_WAIT()
	_WHITE_OUT('SCR_WIPE_DIV', 6)
	_FADE_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_VOICE_PLAY(385, 0, 0)
	_WHITE_IN()
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_jirachi_event_4', 'Someone, somewhere, saw that you\nmade somebody’s wish come true.')
	_FLAG_SET(#2669)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_jirachi_event_no:
	_MACRO_TALKMSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_jirachi_event_no', 'Oh...\rYou can’t teach my Clefairy\nDazzling Gleam?\rOr you simply don’t want to?\rSigh...\nWill my Clefairy ever sparkle?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_jirachi_event_done:
	_MACRO_TALKMSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_jirachi_event_done', 'Ah! My dream has been realized!\nThank you ever so much, Trainer!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04pc0101_clefairy:
	_VOICE_PLAY(35, 0, 0)
	_MACRO_EASY_OBJ_MSG('dialogue_c04pc0101', '00_msg_ev_c04pc0101_clefairy', 'Pip piiih!')
	_END()