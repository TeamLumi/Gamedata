ev_c03r0102_workman:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0102', '70-msg_c03r0102_workman_01', 'Giving nicknames to Pokémon is the way to go.\nIt makes you feel as if they’re your very own.')
	_END()
ev_c03r0102_girl3:
	_MACRO_EASY_OBJ_MSG('dialogue_c03r0102', '70-msg_c03r0102_girl3_01', 'He named our Psyduck “Yellow” just because of\nits color...\rI don’t understand the logic behind that at all.')
	_END()
ev_c03r0102_girl1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C03R0102_ITEM_GET, 'ev_c03r0102_girl1_02')
	_LDVAL(@SCWK_TEMP0, 13)
	_LDVAL(@SCWK_TEMP1, 1)
	_ITEM_NAME(0, @SCWK_TEMP0, @SCWK_TEMP1)
	_MACRO_TALKMSG('dialogue_c03r0102', '70-msg_c03r0102_girl1_01', 'Are you catching Pokémon? Here, take this if\nyou’d like.')
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c03r0102_girl1_item_event_fail')
	_FLAG_SET(#FE_C03R0102_ITEM_GET)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0102_girl1_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0102_girl1_02:
	_MACRO_TALKMSG('dialogue_c03r0102', '70-msg_c03r0102_girl1_02', 'The Dusk Ball is a Poké Ball designed for use\nin darkness.\rIt works better if you use it at night or in a cave.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c03r0102_koduck:
	_EASY_VOICE_MSG('dialogue_c03r0102%70-msg_c03r0102_koduck_01', 'PLAY_PV_EV_054_00_00')
	_END()