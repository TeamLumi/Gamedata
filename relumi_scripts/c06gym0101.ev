	_EVENT_START()
	_PUSH_WATER_GYM_BUTTON()
	_TALK_END()
	_END()
ev_c06gym0101_gym_first:
	_EVENT_START()
	_CALL('ev_block_doc')
	_IFVAL_JUMP(@WK_SCENE_C06GYM0101, 'NE', 0, 'ev_c06gym0101_gym_first_end')
	_EVENT_CAMERA_INDEX(76)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c06gym0101_gym_first01')
	_END()
ev_c06gym0101_gym_first01:
	_EVENT_CAMERA_INDEX(78)
	_LDVAL(@WK_SCENE_C06GYM0101, 1)
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_c06gym0101_gym_first_end:
	_CALL('ev_block_doc_end')
	_END()
ev_c06gym0101_randomteam_wake:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 839)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 840)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 841)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 842)
	_RET()
ev_c06gym0101_randomteam_wake_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 907)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 908)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 909)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 910)
	_RET()
ev_c06gym0101_leader:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C06, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06gym0101_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 13, 4, 5.800000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_ANIME('C06GYM0101_LEADER', 'anm_c06gym0101_leader_01_face_rot')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(77)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_OBJ_ANIME('C06GYM0101_LEADER', 'anm_c06gym0101_leader_01_face04')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_01_1', 'Welcome! I don’t get challenged very often!\rThe glory you are now beholding is the Pastoria\nGym Leader! That’s right, I’m Crasher Wake!')
	_OBJ_ANIME('C06GYM0101_LEADER', 'anm_c06gym0101_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_01_2', 'My Pokémon were toughened up by stormy\nwhite waters! They’ll take everything you can\fthrow at them and then pull you under!\rVictory will be ours! Come on, let’s get it done!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(75)
	_BTL_ENCSEQ_LOAD('gym04')
	_LDVAL(@WK_PLAY_REPO_NO, 7)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c06gym0101_randomteam_wake')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_EVENT_CAMERA_INDEX(432)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_02', 'It seems the undertow pulled me under...\nBut I had a great time battling with you!\rYou’ve earned this!')
	_TALK_CLOSE()
	_BADGE_GET(3)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_03', 'You received the Fen Badge from Wake!')
	_ME_WAIT()
	_SYS_FLAG_BADGE_SET($BADGE_ID_C06)
	_TRAINER_FLAG_SET('FISHING_18')
	_TRAINER_FLAG_SET('SAILOR_07')
	_TRAINER_FLAG_SET('FISHING_19')
	_TRAINER_FLAG_SET('SAILOR_09')
	_TRAINER_FLAG_SET('UKIWAB_04')
	_TRAINER_FLAG_SET('UKIWAG_04')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 6800, 'ev_c06gym0101_guide_upd')
	_LDVAL(@WK_SCENE_C06, 1)
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_04_1', 'You need that Fen Badge to use the hidden\nmove Surf from your Pokétch.')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_04_2', 'These are a special reward from me in recognition\nof your team’s power.')
	_CB_ITEM_NUM_ADD(43, 2)
	_CB_ITEM_NUM_ADD(46, 1)
	_CB_ITEM_NUM_ADD(56, 1)
	_CB_ITEM_NUM_ADD(26, 2)
	_CB_ITEM_NUM_ADD(10, 2)
	_CB_ITEM_NUM_ADD(14, 2)
	_SE_PLAY('M_FI014')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER3_01')
	_MACRO_TALKMSG('dialogue_c06gym0101', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c06gym0101_leader_item_get')
	_END()
anm_c06gym0101_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c06gym0101_leader_01_face04:
	_AC_FACE_INDEX(4)
	_ACMD_END()
anm_c06gym0101_leader_01_face_rot:
	_AC_NECK_ROTATE(0, 15, 0, 4)
	_ACMD_END()
anm_c06gym0101_leader_01_face_rot_cancel:
	_AC_NECK_ROTATE(0, 0, 0, 4)
	_ACMD_END()
ev_c06gym0101_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6900)
	_RET()
ev_c06gym0101_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 426)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06gym0101_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C06_GYM_ITEM_GET)
	_FLAG_SET(#FE_HIDEN_07_GET)
	_FLAG_SET(#2750)
	_FLAG_SET(#2758)
	_FLAG_RESET(#2841)
	_LDVAL(@484, 1)
	_MACRO_TALKMSG('dialogue_c06gym0101', '00_msg_d24r0105_seven4_strength', 'That TM contains the\nmove Waterfall.\rIt’s a strong Water-type move that\ncan flinch the opponent.\rIt has its use in the field too, but\nmy Badge won’t help with that! Ha!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_OBJ_ANIME('C06GYM0101_LEADER', 'anm_c06gym0101_leader_01_face_rot_cancel')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(433)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c06gym0101_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c06gym0101_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C06_GYM_ITEM_GET, 'ev_c06gym0101_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c06gym0101_leader_return_match')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_06_1', 'The styles of battling and winning are as widely\nvaried as Trainers are.')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_06_2', 'Do you want to know how I battle?\nI battle so I can say I had fun at the end,\fwhether I win or lose!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06gym0101_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C06_GYM_RETRUN_MATCH_FIRST, 'pos_c06gym0101_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C06_GYM_RETRUN_MATCH, 'ev_c06gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_07_01', 'Aha, you’re here to see Crasher Wake\nonce more!\rI heard, you know—you defeated the Champion!\nLike the raging rapids you are, or the surging sea!\rBut I’ll take everything you can throw at me and\nthen pull you under! Come at me with all the\fpower you can muster!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym04')
	_LDVAL(@WK_PLAY_REPO_NO, 29)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c06gym0101_randomteam_wake_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_08_02', 'Well, the results are as clear as a pristine pond,\nbut I had the most outstanding time battling you!')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_07_03', 'This maximum Sticker is just steaming with the\nheat of my passionate spirit! Here, take it!')
	_LDVAL(@SCWK_TEMP0, 56)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C06_GYM_RETRUN_MATCH)
	_FLAG_SET(#FE_C06_GYM_RETRUN_MATCH_FIRST)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c06gym0101_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C06_GYM_RETRUN_MATCH, 'ev_c06gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_08_01', 'Aha, you’re here! And Crasher Wake has once\nagain appeared!\rWith all of your strength and all of mine, we’re\nsure to have another battle of maximum fun!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym04')
	_LDVAL(@WK_PLAY_REPO_NO, 29)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c06gym0101_randomteam_wake_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_08_02', 'Well, the results are as clear as a pristine pond,\nbut I had the most outstanding time battling you!')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_07_03', 'This maximum Sticker is just steaming with the\nheat of my passionate spirit! Here, take it!')
	_LDVAL(@SCWK_TEMP0, 56)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C06_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06gym0101_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_leader_07_04', 'Of course! You and I will continue to battle\ntogether, like the endless raging tides!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06gym0101_common_battle_lose:
	_TALK_OBJ_END()
	_EVENT_START()
	_END()
ev_c06gym0101_advice:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C06, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06gym0101_advice_02')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_01_1', 'The Gym Leader Wake—uh, I mean Crasher Wake—\nis a master of Water-type Pokémon.')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_01_2', 'He loves them so much that he keeps\nthe sprinklers on at all times!\rI’ve heard a Pokémon’s weather moves can overpower them\nfor a little while, though.\rNow, Crasher Wake’s a real aggressive guy,\nso once he settles on a move,\fhe and his Pokémon are totally invested!\rIf they aren’t, then they’re going so hard that\nsome of that power bounces back on them!\rHow some of them can do that while floating,\nI have no idea...')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_01_3', 'But that part,\nI’ll leave up to you to figure out.\rGo and have some good battles!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06gym0101_advice_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_02_1', 'Oh, {0,1,0,0}! You’ve beaten the\nGym Leader!', 0, 1)
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_02_2', 'So, how was it? Did you enjoy your battle against\nWake—I mean Crasher Wake?')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_02_3', 'Sure, winning is important, but don’t forget to\nhave fun, too!')
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_sunglaases_02_4', 'I think Wake—I mean Crasher Wake—showed you\nwhat I mean by fun.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06gym0101_statue:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C06, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06gym0101_statue_02')
	_RIVAL_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_statue_01', 'Pastoria City Pokémon Gym\nGym Leader: Crasher Wake\fCertified Trainers: {0,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c06gym0101_statue_02:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_RIVAL_NAME(2)
	_MACRO_TALKMSG('dialogue_c06gym0101', '120-msg_c06gym0101_statue_02', 'Pastoria City Pokémon Gym\nGym Leader: Crasher Wake\rCertified Trainers: {0,1,0,0}\n{1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()