ev_d24r0107_regi_statue:
	_MACRO_EASY_OBJ_MSG('dialogue_d24r0107', 'msg_regi_statue_1', 'It’s a statue of a Pokémon.\nIt seems to exude power...\rFrom somewhere, something spoke out.\r“The human in the company of our Master, pay\nheed...\r“Become stronger you must.\nSo much the others cannot but notice.”')
	_END()