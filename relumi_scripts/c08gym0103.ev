ev_c08gym0103_flag_change:
	_LDVAL(@LOCALWORK0, 0)
	_END()
ev_c08gym0103_randomteam_volkner:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 851)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 852)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 853)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 854)
	_RET()
ev_c08gym0103_randomteam_volkner_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 919)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 920)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 921)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 922)
	_RET()
ev_c08gym0103_leader:
	_PLAYER_NAME(0)
	_SYS_FLAG_BADGE_GET($BADGE_ID_C08, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c08gym0103_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 11, 7, 4.500000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(410)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_01_1', 'All right, challenger.\rIt’s not often a Trainer manages to make it all the\nway here to challenge me.\rAnd when they do, they’ve all been boring\nbattles. I didn’t break a sweat beating them.')
	_SET_FORCE_BLINK('C08GYM0103_LEADER', 1)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('C08GYM0103_LEADER', 0)
	_OBJ_ANIME('C08GYM0103_LEADER', 'anm_c08gym0103_leader_01_face03')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_01_2', '*sigh*\nI’m Volkner, the Gym Leader.\rThey say I’m the top Gym Leader in Sinnoh, but...')
	_OBJ_ANIME('C08GYM0103_LEADER', 'anm_c08gym0103_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_01_3', 'Anyway, I guess we’d better get this done.\rI hope you’re the Trainer who’ll make me\nremember how fun it is to battle!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(84)
	_BTL_ENCSEQ_LOAD('gym08')
	_LDVAL(@WK_PLAY_REPO_NO, 19)
	_FLAG_SET(#FE_PLAY_REPO)
	_FLAG_SET(#2196)
	_CALL('ev_c08gym0103_randomteam_volkner')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_FLAG_RESET(#2196)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_02_1', '...Hehehe.\rHahahah!\rThat was the most fun I’ve had in a battle\nsince...I don’t know when!')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_02_2', 'It’s also made me excited to know you and your\nteam will keep battling to greater heights!')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_02_3', 'This is your eighth Gym Badge.\nYou’ve earned this!')
	_TALK_CLOSE()
	_BADGE_GET(7)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_03', 'You received the Beacon Badge from Volkner.')
	_ME_WAIT()
	_SYS_FLAG_BADGE_SET($BADGE_ID_C08)
	_TRAINER_FLAG_SET('ELITEM_09')
	_TRAINER_FLAG_SET('ELITEW_09')
	_TRAINER_FLAG_SET('GUITARIST_04')
	_TRAINER_FLAG_SET('GUITARIST_05')
	_TRAINER_FLAG_SET('GUITARIST_06')
	_TRAINER_FLAG_SET('POKEGIRL_02')
	_TRAINER_FLAG_SET('SCHOOLB_03')
	_TRAINER_FLAG_SET('SCHOOLG_03')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 11700)
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_04_1', 'That Beacon Badge lets you use the hidden move\nWaterfall from your Pokétch.\rWaterfall happens to be key if you’re going to\nthe Pokémon League.')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_04_2', 'Also, because you’ve collected all eight Badges,\nany Pokémon at any level will now obey you\fwithout fail.\rI want you to take these, too.')
	_CB_ITEM_NUM_ADD(72, 4)
	_CB_ITEM_NUM_ADD(73, 3)
	_CB_ITEM_NUM_ADD(22, 3)
	_CB_ITEM_NUM_ADD(23, 3)
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER8_01')
	_SE_PLAY('M_FI014')
	_MACRO_TALKMSG('dialogue_c08gym0103', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c08gym0103_leader_item_get')
	_JUMP('ev_c08gym0103_leader_item_get')
ev_c08gym0103_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 384)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c08gym0103_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C08_GYM_ITEM_GET)
	_LDVAL(@WK_SCENE_C08, 2)
	_MACRO_TALKMSG('dialogue_c08gym0103', '00_msg_c08gym0103_leader_05_1', 'What’s inside that TM is the move Wild Charge.\rIt’s an incredibly strong move that\nalso hurts the user. It’s electrifying!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
anm_c08gym0103_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c08gym0103_leader_01_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
anm_c08gym0103_leader_01_face03:
	_AC_FACE_INDEX(3)
	_ACMD_END()
ev_c08gym0103_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c08gym0103_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C08_GYM_ITEM_GET, 'ev_c08gym0103_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c08gym0103_leader_return_match')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_06_1', 'Your next step is the Pokémon League challenge.\rIt’s time for you to cross the sea and win your\nway through the gauntlet that is Victory Road.')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_06_2', 'Demonstrate to the Pokémon League your\nmastery of your team.\rAgainst you, even the Elite Four will be pushed\nto fend off your challenge!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08gym0103_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C08_GYM_RETRUN_MATCH_FIRST, 'pos_c08gym0101_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C08_GYM_RETRUN_MATCH, 'ev_c08gym0103_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_07_01', 'You’re late. I’ve been waiting so long I’ve\ngone numb.\rI’ve had a few challengers since you were last\nhere, but it’s no shock that none of them really\fgot my heart racing.\rSo, {0,1,0,0}! You defeated the\nChampion and got even stronger, right?\fHeheheh... Hahaha!\rThe thrill of anticipation is tingling through my\nveins—don’t disappoint me!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym08')
	_LDVAL(@WK_PLAY_REPO_NO, 33)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c08gym0103_randomteam_volkner_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_07_02', 'Now that’s what I expect of a Trainer who’s made\nit into the Hall of Fame!\rMy battles with you are always full of shocking\nnew discoveries!')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_07_03', 'This Sticker is charged up with my crackling-hot\nenergy. Give it a try, if you like.')
	_LDVAL(@SCWK_TEMP0, 73)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C08_GYM_RETRUN_MATCH_FIRST)
	_FLAG_SET(#TMFLG_C08_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c08gym0101_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C08_GYM_RETRUN_MATCH, 'ev_c08gym0103_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_08_01', 'You’re late, {0,1,0,0}!\rWhenever I see you, I feel a jolt of anticipation.\nDon’t disappoint me!')
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym08')
	_LDVAL(@WK_PLAY_REPO_NO, 33)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c08gym0103_randomteam_volkner_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_08_02', 'My battles with you are always full of shocking\nnew discoveries!')
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_07_03', 'This Sticker is charged up with my crackling-hot\nenergy. Give it a try, if you like.')
	_LDVAL(@SCWK_TEMP0, 73)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C08_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08gym0103_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c08gym0103', '11-msg_c08gym0103_leader_07_04', 'I’m always eager for a battle with you. Next time\nyou feel like it, come on back for more!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c08gym0103_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c08gym0103_rot:
	_EVENT_START()
	_ROTATE_ELEC_GYM_GEAR()
	_TALK_END()
	_END()