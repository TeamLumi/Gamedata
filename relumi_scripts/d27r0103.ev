ev_d27r0103_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D27R0103)
	_END()
ev_d27r0103_ai:
	_CALL('ev_block_doc')
	_CALL('ev_another_out')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_INDEX(240)
	_ENTRY_UWASA_ZUKAN(481)
	_OBJ_POS_CHANGE_WORLD('HERO', 12, 1, 14)
	_OBJ_DIR_CHANGE('HERO', 180)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_VOICE_PLAY(481, 0, 0)
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_sppoke2_01', 'Kyauun.')
	_TALK_CLOSE()
	_SP_WILD_BTL_SET(481, 60); Fight Mesprit
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 481); Get result
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_d27r0103_mesprit_lose');CatchChk
	_OBJ_DEL('D27R0103_AI'); Delete the Placedata
	_FLAG_SET(#FV_D27R0103_AI)
	_FLAG_SET(#FE_D27R0103_LEGEND_CLEAR)
	_EVENT_CAMERA_INDEX(243)
	_CALL('ev_another_out_end')
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_d27r0103_mesprit_lose:
	_EVENT_CAMERA_INDEX(243)
	_TALK_END()
	_CALL('ev_another_out_end')
	_CALL('ev_block_doc_end')
	_TALK_OBJ_END()
	_END()
ev_d27r0103_doctor_dir_up:
	_OBJ_POS_CHANGE_WORLD('D27R0103_DOCTOR', 12, 1, 22.500000)
	_JUMP('common_d27r0103_doctor_dir')
	_END()
ev_d27r0103_doctor_dir_down:
	_OBJ_POS_CHANGE_WORLD('D27R0103_DOCTOR', 12, 1, 22.500000)
	_JUMP('common_d27r0103_doctor_dir')
	_END()
ev_d27r0103_doctor_dir_left:
	_OBJ_POS_CHANGE_WORLD('D27R0103_DOCTOR', 12, 1, 22.500000)
	_JUMP('common_d27r0103_doctor_dir')
	_END()
ev_d27r0103_doctor_dir_right:
	_OBJ_POS_CHANGE_WORLD('D27R0103_DOCTOR', 12, 1, 22.500000)
	_JUMP('common_d27r0103_doctor_dir')
	_END()
common_d27r0103_doctor_dir:
	_FLAG_RESET(#FV_D27R0103_DOCTOR)
	_OBJ_ADD('D27R0103_DOCTOR')
	_OBJ_ANIME('D27R0103_DOCTOR', 'anm_d27r0103_doctor_01')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'anm_d27r0103_player_01')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_01_1', '...\n...\r{0,1,0,0}, that was Mesprit, wasn’t it?')
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_01_2', 'You’ve accomplished what I’d asked you to do at\nthe Canalave Library...\rI asked you to get data on the Pokémon of the\nlake, and you did.', 1)
	_SET_FORCE_BLINK('D27R0103_DOCTOR', 1)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_01_3', 'But it didn’t provide any answers about the\nmysteries of Evolution.\rI still don’t know why some Pokémon evolve and\nothers don’t. Ultimately, it only deepened\fthe mystery.', 1)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D27R0103_DOCTOR', 0)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_01_4', 'But having mysteries to solve...\nThat adds to my enjoyment!', 1)
	_TALK_CLOSE()
	_OBJ_ANIME('D27R0103_DOCTOR', 'anm_d27r0103_doctor_02')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(248)
	_OBJ_POS_CHANGE_WORLD('D27R0103_DOCTOR', 12, 1, 15.500000)
	_PLAYER_NAME(0)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D27R0103_DOCTOR', 1)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_SET_FORCE_BLINK('D27R0103_DOCTOR', 0)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_02_1', '{0,1,0,0}, why don’t you chase\nafter Mesprit?\rTo me, it seemed as if it wanted to play with you.', 0, 1)
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_02_2', 'If you were to use the Marking Map app on your\nPokétch, you’d be able to track the movements\fof Pokémon.', 1)
	_PLAYER_NAME(0)
	_OBJ_ANIME('D27R0103_DOCTOR', 'anm_d27r0103_doctor_01_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_04_1', 'Go on, {0,1,0,0}.\rI’m sure that you will keep meeting countless\nPokémon and people.')
	_OBJ_ANIME('D27R0103_DOCTOR', 'anm_d27r0103_doctor_01_face00')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_04_2', 'Those encounters will keep thrilling you in their\nown special ways.\rI hope you’ll enjoy that experience!\nTake care, {0,1,0,0}.')
	_TALK_CLOSE()
	_OBJ_ANIME('D27R0103_DOCTOR', 'anm_d27r0103_doctor_03')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('D27R0103_DOCTOR')
	_EVENT_CAMERA_INDEX(243)
	_TALK_OBJ_END()
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CALL('ev_another_out_end')
	_CALL('ev_block_doc_end')
	_TALK_END()
	_END()
ev_d27r0103_poketch_app_nothing:
	_MACRO_TALKMSG('dialogue_d27r0103', '85-msg_d27r0103_doctor_03', 'What? You don’t have the Marking Map app?\rYou should occasionally pay visits to the\nPokétch Company, you know.')
	_RET()
anm_d27r0103_doctor_01:
	_AC_DIR_U(8)
	_AC_UP(7, 8)
	_ACMD_END()
anm_d27r0103_doctor_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_d27r0103_doctor_01_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
anm_d27r0103_doctor_02:
	_AC_DIR_D(8)
	_AC_WAIT(16)
	_AC_DIR_U(8)
	_ACMD_END()
anm_d27r0103_doctor_03:
	_AC_DIR_D(8)
	_AC_DOWN(5, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(2, 8)
	_ACMD_END()
anm_d27r0103_player_01:
	_AC_DIR_D(8)
	_ACMD_END()