ev_c01r0801_boy2:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c01r0801', '55-msg_c01r0801_boy2_01_1', 'I got my Pikachu by trading from a distant land.')
	_MACRO_TALKMSG('dialogue_c01r0801', '55-msg_c01r0801_boy2_01_2', 'He grows quickly and his level’s high, but he\ndoesn’t listen to me.\rIt’s not always easy, but Pikachu is still my\nirreplaceable partner!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
