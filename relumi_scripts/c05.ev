	_OBJ_ANIME('HERO', 'anm_c05_player_202')
	_OBJ_ANIME('C05_POKE', 'anm_c05_shaymin_scene_03')
	_OBJ_ANIME('C05_SHAYMIN', 'anm_c05_shaymin_scene_04')
	_TIME_WAIT(100, @SCWK_ANSWER)
	_PLAY_EMO_SE(11)
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(492, 0, 0)
	_OBJ_ANIME('HERO', 'anm_c05_player_203')
	_OBJ_ANIME('C05_POKE', 'anm_c05_shaymin_scene_07')
	_OBJ_ANIME('C05_SHAYMIN', 'anm_c05_shaymin_scene_08')
	_TIME_WAIT(180, @SCWK_ANSWER)
	_PLAY_EMO_SE(2)
	_OBJ_ANIME_WAIT()
	_CALL('pos_c05_judge_shaymin_down')
	_RET()
pos_c05_judge_shaymin_down:
	_OBJ_ANIME('C05_SHAYMIN', 'anm_c05_shaymin_scene_05')
	_OBJ_ANIME('HERO', 'anm_c05_shaymin_scene_09')
	_OBJ_ANIME('C05_JUDGE', 'anm_c05_judge_01')
	_TIME_WAIT(80, @SCWK_ANSWER)
	_PLAY_EMO_SE(2)
	_TIME_WAIT(80, @SCWK_ANSWER)
	_SE_PLAY('S_FI001')
	_SE_WAIT('S_FI001')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C05_SHAYMIN')
	_RET()
pos_c05_judge_10_common:
	_SXY_POS_CHANGE('C05_JUDGE', 471, 726)
	_SXY_POS_CHANGE('C05_POKE', 471, 726)
	_SXY_POS_CHANGE('C05_SHAYMIN', 471, 726)
	_FLAG_RESET(#513)
	_FLAG_RESET(#514)
	_OBJ_ADD('C05_JUDGE')
	_OBJ_ADD('C05_POKE')
	_OBJ_ADD('C05_SHAYMIN')
	_OBJ_ANIME('HERO', 'anm_c05_player_201')
	_OBJ_ANIME('C05_POKE', 'anm_c05_poke_01')
	_OBJ_ANIME('C05_SHAYMIN', 'anm_c05_poke_01_1')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_BGM_PLAY('EV_SILENCE_SYEIMI')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_CALL('ev_shaymin_theme_play')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(427, 0, 0)
	_VOICE_WAIT()
	_CALL('pos_c05_judge_shaymin')
	_CALL('ev_character_theme_stop')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_judge_01', 'Oh, thank goodness that you happened to be\nthere! If it weren’t for you, who knows how far\faway my Buneary could have run...')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_judge_02', 'Baby Buneary, back into the Poké Ball you go!')
	_VOICE_PLAY(427, 0, 0)
	_VOICE_WAIT()
	_OBJ_DEL('C05_POKE')
	_LDVAL(@SCWK_TEMP0, 0); Effect Instance (not Effect ID)
	_LDVAL(@SCWK_TEMP1, -462); X coordinate
	_LDVAL(@SCWK_TEMP2, 2); Y coordinate
	_LDVAL(@SCWK_TEMP3, 726); Z coordinate
	_CALL('ev_common_poke_ball_return_effect')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_judge_03', 'I’m Keira! I’m a Super Contest Show judge.\rPlease drop by the Contest Hall so I can thank\nyou properly!')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_judge_04', 'Oh hey, your little green Pokémon friend\ndropped this.')
	_LDVAL(@SCWK_TEMP0, 194); Tanga Berry
	_LDVAL(@SCWK_TEMP1, 1); Quantity 1
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_OBJ_ANIME('C05_JUDGE', 'anm_c05_judge_02')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C05_JUDGE')
	_OBJ_DEL('C05_LEADER')
	_CALL('ev_d27r0101_shaymin_flower_picker')
	_LDVAL(@154, 1)
	_LDVAL(@249, 5900)
	_EVENT_CAMERA_INDEX(600)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_another_out_end')
	_FLAG_RESET(#FLAG_STOP_ZONE_PROGRAM)
	_TALK_END()
	_END()
anm_c05_player_200:
	_AC_RIGHT(4, 8)
