ev_c05_woman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_woman2_01', 'When I take my baby out in his stroller, I see the\ntown in a different way.\rI notice things like stairs and bumps in\nthe sidewalk.')
	_END()
ev_c05_middlewoman1:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_middlewoman1_01', 'I get to see Pokémon all day long, but there sure\nare many kinds. How many are there now?')
	_END()
ev_c05_baby:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_baby_01', 'Apapapu!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_artist:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_goods_01', 'Lining up my favorite statues in my underground\nSecret Base is what I live for!')
	_END()
ev_c05_man1a:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_man1a_01', 'I can feel the baby stroller getting heavier each\nand every day.\rI wonder what kind of Pokémon my child will\nbecome friends with first?')
	_END()
ev_c05_baby2:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_baby2_01', 'Papa! Mama!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_fighter:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '00_msg_c05_fighter2_02', 'I put my Vs. Seeker through its paces\na lot.\rI battled this one intriguing Trainer\nover and over using it.\rShe asked me, “Do you like me?”\nLike, oops! Hahahahah!')
	_END()
ev_c05_woman1a:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_woan1a_01', 'I’d like to live in Hearthome City when I get\nmarried. But my boyfriend wants to live in\fVeilstone ’cause of its department store...')
	_END()
