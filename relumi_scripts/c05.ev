ev_c05_flag_change:
	_CALL('ev_box_close')
	_FLAG_RESET(#FE_SAVE_GIMMICK_001)
	_FLAG_RESET(#FE_SAVE_GIMMICK_002)
	_FLAG_RESET(#FE_SAVE_GIMMICK_003)
	_FLAG_RESET(#FE_SAVE_GIMMICK_004)
	_FLAG_RESET(#FE_SAVE_GIMMICK_005)
	_END()
ev_c05_stopper_03:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_stopper_03_01', 'You’re kidding! They found an Egg at the\nPokémon Nursery in Solaceon Town?')
	_END()
ev_c05_stopper_04:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_stopper_04_01', 'I hear they found Eggs in the Johto region, too.')
	_END()
ev_c05_egg:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '00_msg_c05_girl1_02_egg', 'I have a professor friend, and this is\nwhat he told me.\rIf you leave a pair of Pokémon with the\nDay Care, sometimes Eggs are found.\rOr things that are like Eggs, anyway.\rI wonder how my pal Prof. Elm is doing\nthese days?\rHe was always a quiet sort and didn’t\nreally stand out.')
	_END()
yes_c05_egg:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 6, 'c05_egg_temoti_max')
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_egg_02', 'Here you go!')
	_ME_WAIT()
	_ADD_TAMAGO_EXTRA(175, 0, 60007); MonsNo, FormNo, RecievedFrom
	_FLAG_SET(#FE_C05_EGG)
	_JUMP('common_c05_egg')
	_END()
common_c05_egg:
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_egg_03', 'This is what I heard about Eggs...\rIf you take that Egg and travel with energetic\nPokémon, it’ll hatch.\rI remember someone announced that...\nProfessor Elm of Johto maybe?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
no_c05_egg:
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_egg_05', 'All right, then. I’ll just keep waiting for someone\nto take care of this Egg.\rOh? Wait a minute. If I wait around, will the Egg\nhatch for me?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
c05_egg_temoti_max:
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_egg_04', 'Hold up. You don’t seem to have enough room\nfor the Egg.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_middleman1:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_middleman1_01', 'You’re a Trainer, aren’t you?\rYou’ve got two choices of challenges, either\nthe Gym or a Super Contest Show, right?')
	_END()
ev_c05_man1:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '00_msg_c05_man1_02_1', 'At the Lost Tower, people unburden\nthemselves of unbearable sorrow...\rYou’ll understand what I mean if you\nvisit the Lost Tower on Route 209.')
	_END()
ev_c05_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '00_msg_c05_girl2_02', 'I can’t decide what Accessories I\nshould dress up Pokémon with.\rThere are just so many kinds.')
	_END()
ev_c05_girl1:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '00_msg_c05_girl1_02', 'I used a Fire Stone on my Pokémon,\nand it evolved!')
	_END()
ev_c05_oldman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_oldman2_01', 'I went for a stroll in Amity Square with my\nPachirisu today.\rWe came across a cute Sticker while we walked.\rDo you think placing this on my Pachirisu’s Ball\nCapsule will make my Pachirisu look even cuter?')
	_END()
ev_c05_gonbe:
	_EASY_VOICE_MSG('dialogue_c05%33-msg_c05_gonbe_02', 'PLAY_PV_EV_417_00_00')
	_END()
ev_c05_gentleman:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#0, 'ev_c05_gentleman_02')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_gentleman_01_1', 'I’m visiting here all the way from the\nHoenn region.')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_gentleman_01_2', 'I had been hoping to find the Contest Hall, but\nbeing new, I lost my way. Fortunately, the local\fpeople very kindly led me to my destination.\rI was impressed by their kindness and\ngenerosity to a complete stranger.')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_gentleman_01_3', 'Now, may I offer you the courtesy of showing you\nto the Contest Hall?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_c05_gentleman')
	_CALL('ev_another_out')
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_gentleman_02', 'Ah. Please follow me.')
	_TALK_CLOSE()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_GET_REL_POS_HERO('C05_GENTLEMAN', @SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 8, 'pos_c05_gentleman_02_01')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'pos_c05_gentleman_02_02')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 6, 'pos_c05_gentleman_02_03')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'pos_c05_gentleman_02_04')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 9, 'pos_c05_gentleman_02_05')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 3, 'pos_c05_gentleman_02_06')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 7, 'pos_c05_gentleman_02_07')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 1, 'pos_c05_gentleman_02_08')
	_END()
ev_c05_gentleman_02:
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_gentleman_04', 'It makes me happy knowing I’ve helped\nanother person.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
no_c05_gentleman:
	_MACRO_TALKMSG('dialogue_c05', '33-msg_c05_gentleman_05', 'Oh, I do apologize. I should mind my\nown business.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
