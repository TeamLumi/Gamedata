ev_c05_girl1_iro:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_girl1_iro_01', 'One, two, step. ♪\nOne, two, flip. ♪\fAnd turn. ♪')
	_END()
ev_c05_gerggeousm_iro:
	_MACRO_EASY_OBJ_MSG('dialogue_c05', '33-msg_c05_gerggeousm_iro_01', 'After passing this gate, you’ll find a paradise\nwhere lots of Pokémon play—or so I’ve heard!')
	_END()
ev_c05_rakki:
	_EASY_VOICE_MSG('dialogue_c05%33-msg_c05_rakki', 'PLAY_PV_EV_113_00_00')
	_END()
ev_c05_asanan:
	_EASY_VOICE_MSG('dialogue_c05%33-msg_c05_asanan', 'PLAY_PV_EV_307_00_00')
	_END()
ev_c05_advice_dude:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c05', '00_msg_c05_advice_dude_0', 'Hey, there!\nHow’s it going, Trainer?\rYou being here tells me you’re going\nto challenge the Gym Leader.\rWell... I hate to break it to you, but\nthat’s impossible.\rYou’re questioning why, and the answer\nis: she’s not here.\rNot to worry, though.\nWe know she’s at the Contest Hall.\rCome back another time, OK?\nI’ll be waiting right here.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#1804, 'ev_c05_dj_end')
	_IF_FLAGON_JUMP(#1803, 'ev_c05_dj_badge_check')
	_JUMP('ev_c05_dj_intro')
ev_c05_dj_intro:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_intro_1', 'Hey there, {0}!\nI realized I never gave you my name.')
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_intro_2', 'I’m DJ!\nIt’s nice to meet you properly.')
	_FLAG_SET(#1803)
	_JUMP('ev_c05_dj_badge_check')
ev_c05_dj_badge_check:
	_IF_FLAGON_JUMP(#1791, 'ev_c05_dj_tutor_again')
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_badge_check_1', 'Have you been taking care of your partner?\rWhat about raising other Eevees to their\nEeveelutions and getting new badges?\rOur deal is still on, after all!')
	_IFVAL_JUMP(@506, 'EQ', 0, 'ev_c05_dj_box_check'); Will be true if the player didn't offer an Eeveelution on Route 205. No need to check badges.
	_IFVAL_JUMP(@506, 'EQ', 1, 'ev_c05_dj_box_check'); Will be true if the player hasn't received their second badge move yet. Badge check was performed on Route 205. No need to check badges.
	_IFVAL_CALL(@506, 'EQ', 2, 'ev_c05_dj_badge_check_three'); Will be true if the player hasn't received their third badge move yet. Calls a script that checks if the player has three badges yet. Returns if not.
	_IFVAL_CALL(@506, 'EQ', 3, 'ev_c05_dj_badge_check_four'); Will be true if the player hasn't received their fourth badge move yet. Calls a script that checks if the player has four badges yet. Returns if not.
	_IFVAL_CALL(@506, 'EQ', 4, 'ev_c05_dj_badge_check_five'); Will be true if the player hasn't received their fifth badge move yet. Calls a script that checks if the player has five badges yet. Returns if not.
	_IFVAL_CALL(@506, 'EQ', 5, 'ev_c05_dj_badge_check_six'); Will be true if the player hasn't received their sixth badge move yet. Calls a script that checks if the player has six badges yet. Returns if not.
	_IFVAL_CALL(@506, 'EQ', 6, 'ev_c05_dj_badge_check_seven'); Will be true if the player hasn't received their seventh badge move yet. Calls a script that checks if the player has seven badges yet. Returns if not.
	_IFVAL_CALL(@506, 'EQ', 7, 'ev_c05_dj_badge_check_eight'); Will be true if the player hasn't received their eighth badge move yet. Calls a script that checks if the player has eight badges yet. Returns if not.
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_badge_check_2', 'Still working on it?\nI believe in you!\rCome see me with a cute new Eeveelution once\nyou’ve gotten your next badge, okay?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_badge_check_three:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 2, 'ev_c05_dj_box_check')
	_RET()
ev_c05_dj_badge_check_four:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 3, 'ev_c05_dj_box_check')
	_RET()
ev_c05_dj_badge_check_five:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 4, 'ev_c05_dj_box_check')
	_RET()
ev_c05_dj_badge_check_six:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 5, 'ev_c05_dj_box_check')
	_RET()
ev_c05_dj_badge_check_seven:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 6, 'ev_c05_dj_box_check')
	_RET()
ev_c05_dj_badge_check_eight:
	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER); Checks badge count
	_IFVAL_JUMP(@SCWK_ANSWER, 'GT', 7, 'ev_c05_dj_box_check')
	_RET()
ev_c05_dj_box_check:
	_TALK_CLOSE()
    _POKELIST_SET_PROC(22); This only highlight a specific list of mons detailed in UIDatabase.BoxOpenParam
  	_POKELIST_GET_RESULT(@SCWK_PARAM0, @SCWK_PARAM3); Argument 1 is the bag/box position, Argument 2 is the box number (-1 = Party)
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', -1, 'ev_c05_dj_box_check_no'); If SCK_PARAM0 is -1, it means you chose nothing.
    _TEMOTI_BOX_MONSNO(@SCWK_PARAM0, @SCWK_PARAM3, @SCWK_PARAM1); Get the MonsNo of the selected Pokemon, SCWK_PARAM1
	_SWITCH(@SCWK_PARAM1)
	_CASE_JUMP(134, 'ev_c05_dj_box_check_vaporeon'); Vaporeon
	_CASE_JUMP(135, 'ev_c05_dj_box_check_jolteon'); Jolteon
	_CASE_JUMP(136, 'ev_c05_dj_box_check_flareon'); Flareon
	_CASE_JUMP(196, 'ev_c05_dj_box_check_espeon'); Espeon
	_CASE_JUMP(197, 'ev_c05_dj_box_check_umbreon'); Umbreon
	_CASE_JUMP(470, 'ev_c05_dj_box_check_leafeon'); Leafeon
	_CASE_JUMP(471, 'ev_c05_dj_box_check_glaceon'); Glaceon
	_CASE_JUMP(700, 'ev_c05_dj_box_check_sylveon'); Sylveon
	_CASE_JUMP(0, 'ev_c05_dj_box_check_invalid'); Egg
	_JUMP('ev_c05_dj_box_check_invalid'); Everything else
    _END()
ev_c05_dj_box_check_no:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_box_check_no', 'Still working on it?\nI believe in you!\rCome see me with a cute new Eeveelution\nsoon, okay?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_box_check_invalid:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_box_check_invalid', 'That’s... not quite right. You know?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_box_check_repeat:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_box_check_repeat', 'It’s super cute but you’ve shown me this one\nbefore.\rI wanna see all of the cuties that there are!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_box_check_eeveelution:
	_NICK_NAME_ALL(0, @SCWK_PARAM0, @SCWK_PARAM3)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_box_check_eeveelution_1', 'Oh my gosh! {0,1,0,0}, hi!\rLooks like you’ve been hard at work,\n{1,1,0,0}.\rAs promised, you can have another move.')
	_JUMP('ev_c05_dj_tutor')
ev_c05_dj_tutor:
	_TALK_CLOSE()
	_POKELIST_SET_PROC(20) ; Setup Pokémon list with an argument of 2 to be able to select all Pokémon
	_POKELIST_GET_RESULT(@SCWK_PARAM0, @SCWK_PARAM1) ; Open the Pokémon list and get its result. Argument 1 is the bag/box position, Argument 2 is the box number (-1 = Party)
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', -1, 'ev_c05_dj_tutor_no_move') ; If SCK_PARAM0 is -1, the player chose nothing
	_TEMOTI_BOX_MONSNO(@SCWK_PARAM0, @SCWK_PARAM1, @SCWK_PARAM2) ; Get the MonsNo of the selected Pokémon -> SCWK_PARAM2
	_TEMOTI_BOX_FORMNO(@SCWK_PARAM0, @SCWK_PARAM1, @SCWK_PARAM3); Get the FormNo of the selected Pokemon, -> SCWK_PARAM3
	_IFVAL_JUMP(@SCWK_PARAM2, 'NE', 133, 'ev_c05_dj_tutor_invalid_no_move')
	_IFVAL_JUMP(@SCWK_PARAM3, 'EQ', 0, 'ev_c05_dj_tutor_invalid_no_move')
	_IFVAL_JUMP(@SCWK_PARAM3, 'EQ', 2, 'ev_c05_dj_tutor_invalid_no_move')
	_IF_FLAGOFF_CALL(#1790, 'ev_lumi_move_tutor_add_dev_dj_1_table')
	_IF_FLAGOFF_CALL(#1789, 'ev_lumi_move_tutor_add_dev_dj_2_table')
	_IF_FLAGOFF_CALL(#1788, 'ev_lumi_move_tutor_add_dev_dj_3_table')
	_IF_FLAGOFF_CALL(#1787, 'ev_lumi_move_tutor_add_dev_dj_4_table')
	_IF_FLAGOFF_CALL(#1786, 'ev_lumi_move_tutor_add_dev_dj_5_table')
	_IF_FLAGOFF_CALL(#1785, 'ev_lumi_move_tutor_add_dev_dj_6_table')
	_IF_FLAGOFF_CALL(#1784, 'ev_lumi_move_tutor_add_dev_dj_7_table')
	_IF_FLAGOFF_CALL(#1783, 'ev_lumi_move_tutor_add_dev_dj_8_table')
	_MOVE_TUTOR_UI(@SCWK_ANSWER, @SCWK_PARAM0, @SCWK_PARAM1) ; Open the move tutor UI with the stored tables and put the result into SCWK_ANSWER
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_c05_dj_tutor_invalid_no_move') ; -1 if no moves in the stored tables can be learned by the selected Pokémon
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05_dj_tutor_no_move') ; 0 if the relearning was canceled
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 733, 'ev_lumi_move_tutor_disable_dev_dj_1_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 734, 'ev_lumi_move_tutor_disable_dev_dj_2_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 735, 'ev_lumi_move_tutor_disable_dev_dj_3_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 736, 'ev_lumi_move_tutor_disable_dev_dj_4_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 737, 'ev_lumi_move_tutor_disable_dev_dj_5_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 738, 'ev_lumi_move_tutor_disable_dev_dj_6_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 739, 'ev_lumi_move_tutor_disable_dev_dj_7_table')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 740, 'ev_lumi_move_tutor_disable_dev_dj_8_table')
	_IF_FLAGON_JUMP(#1804, 'ev_c05_dj_close')
	_JUMP('ev_c05_dj_tutor_end')
ev_c05_dj_tutor_no_move:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_tutor_no_move', 'You need some more time to decide?\rThat’s okay.\nCome see me when you’re ready.')
	_FLAG_SET(#1791)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_tutor_invalid_no_move:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_tutor_invalid_no_move', 'That isn’t my special Eevee...')
	_FLAG_SET(#1791)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_tutor_end:
	_FLAG_RESET(#1791)
	_ADD_WK(@506, 1)
	_IFVAL_JUMP(@506, 'EQ', 8, 'ev_c05_dj_final'); Will only be true immediately after recieving the eighth badge move
	_IFVAL_JUMP(@506, 'EQ', 5, 'ev_c05_dj_bandana'); Will only be true immediately after recieving the fifth badge move
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_box_check_eeveelution_2', 'I’m sure I’ll see you again soon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_tutor_again:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_tutor_again', 'Oh hey! You still have a special move, waiting\nto be learned.\rShow me your little partner and I can teach it.')
	_JUMP('ev_c05_dj_tutor')
ev_c05_dj_bandana:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_bandana', 'You’re doing amazing, so I wanted to give you\na little present.\rIsn’t this bandana cute?\rI bet your partner will feel more motivated with\nit on!\rGive it a try.')
	_LDVAL(@SCWK_TEMP0, 1306)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_final:
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_final', 'And that’s all he wrote!\rYour partner’s gotta be the best it can be by\nnow!\rDoesn’t it feel amazing knowing you spent this\nwhole journey working toward a goal,\fbecoming the best you can be, and now you\fget to see it pay off?\rI bet you’ve got plenty more left to do, so\nenjoy yourself going forward.\rYou’ve earned it!')
	_FLAG_SET(#1804)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_end:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05', 'msg_c05_dj_end_1', 'Hey there, {0}!\nHow are you and your partner doing?\rRemember to appreciate it and all the time\nyou’ve spent together.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_close:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05_dj_box_check_vaporeon:
	_IF_FLAGON_JUMP(#1799, 'ev_c05_dj_box_check_repeat')
	_FLAG_SET(#1799)
	_JUMP('ev_c05_dj_box_check_eeveelution')
ev_c05_dj_box_check_jolteon:
	_IF_FLAGON_JUMP(#1798, 'ev_c05_dj_box_check_repeat')
	_FLAG_SET(#1798)
	_JUMP('ev_c05_dj_box_check_eeveelution')
ev_c05_dj_box_check_flareon:
	_IF_FLAGON_JUMP(#1797, 'ev_c05_dj_box_check_repeat')
	_FLAG_SET(#1797)
	_JUMP('ev_c05_dj_box_check_eeveelution')
ev_c05_dj_box_check_espeon:
	_IF_FLAGON_JUMP(#1796, 'ev_c05_dj_box_check_repeat')
	_FLAG_SET(#1796)
	_JUMP('ev_c05_dj_box_check_eeveelution')
ev_c05_dj_box_check_umbreon:
	_IF_FLAGON_JUMP(#1795, 'ev_c05_dj_box_check_repeat')
	_FLAG_SET(#1795)
