ev_c04r0203_gingam1:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0203', '7-msg_c04r0203_gingam1_01', 'Ordinary people like you can’t understand\nTeam Galactic’s grand designs!\rCome to think of it...I don’t even know what’s\ngoing on...')
	_END()
ev_c04r0203_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0203', 'msg_c04r0203_poster_01', 'Question not and follow this path!\nThe road to success!')
	_END()