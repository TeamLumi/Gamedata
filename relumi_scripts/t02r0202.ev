ev_t02r0202_game:
	_MACRO_EASY_OBJ_MSG('dialogue_t02r0202', '18-msg_t02r0202_game_01', 'It’s the latest game console—a Nintendo Switch!')
	_END()
ev_t02r0202_pc:
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_t02r0202', '18-msg_t02r0202_pc_01_1', 'You checked the PC screen.\rAdventure Rule No. 1\nThe X Button opens the menu!')
	_MACRO_TALKMSG('dialogue_t02r0202', '18-msg_t02r0202_pc_01_2', 'Adventure Rule No. 2\nRecord your progress with Save.\rThere is nothing else on here...', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()