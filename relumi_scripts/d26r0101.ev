ev_d26r0101_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_D26R0101)
	_END()
ev_d26r0101_obj_change:
	_IF_FLAGON_JUMP(#FV_D26R0101_DOOR, 'ev_d26r0101_obj_change_vanish')
	_END()
ev_d26r0101_obj_change_vanish:
	_SET_DOOR_OBJ('P_C_001_AutoDoor_01')
	_DOOR_FORCE_ANIME_END(0)
	_END()
ev_d26r0101_gingaw:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_D05R0114_CLEAR, 'ev_d26r0101_gingaw_02')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingaw_01_1', 'Welcome. This is Team Galactic Headqu—\rI’m sorry. This is the Galactic Veilstone Building.')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingaw_01_2', 'Cosmic energy for the win!\rWouldn’t it be wonderful if we could harness that\nboundless energy?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_gingaw_02:
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingaw_02_1', 'Welcome. This is Team Galactic Headqu—\rI’m sorry. This is the Galactic Veilstone Building.')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingaw_02_2', 'We have no public events planned at this time.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_gingam1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_D05R0114_CLEAR, 'ev_d26r0101_gingam_02')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingam1_01', 'We, Team Galactic, will take everything that can\nbe taken! We will eliminate everything that is\fnot needed!\rThat is Team Galactic’s policy!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_gingam_02:
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingam1_02_1', 'We, Team Galactic, will take everything that can\nbe taken! We will eliminate everything that is\fnot needed!')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingam1_02_2', 'That is Team Galactic’s policy!\rAt least, it used to be... There’s nothing left now.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_gingaw1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_D05R0114_CLEAR, 'ev_d26r0101_gingaw1_02')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingaw1_01', 'You’re too young for us... You can join us when\nyou’re older.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_gingaw1_02:
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_gingaw1_02', 'I wonder where our boss went.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_assistantm:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_D05R0114_CLEAR, 'ev_d26r0101_assistantm_02')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_assistantm_01', 'Team Galactic conducts research around the\nclock here. We focus on the development of new\fenergy resources.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_assistantm_02:
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_assistantm_02', 'This is where we, Team Galactic, work. What are\nwe supposed to do?\rI’m not sure how, but we’re supposed to chase\nour dream—our dream of making a wonderful\fnew world!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_gkanbu:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0107_gkanbu_01_1', 'So, it’s you...\rI’ve heard about you and what took place at the\nSpear Pillar.')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0107_gkanbu_01_2', 'What our boss really wanted... Even I don’t\nknow that.')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0107_gkanbu_01_3', 'His confident manner of speaking...\nHis logical words...\rI think people just became so enthralled by him.')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0107_gkanbu_01_4', 'I allowed myself to believe his words because I\nwanted to see the world he intended to make.')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0107_gkanbu_01_5', 'I’ve been left in charge of headquarters and the\nremnants of the membership.\rThe decision of what Team Galactic should do\nrests with me.\rBut I’ve learned that extremism is never\nthe solution...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_door:
	_TALK_OBJ_START()
	_ITEM_CHK(440, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_d26r0101_door_02')
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_door_01', 'The door is locked. A special key is needed.')
	_TALK_CLOSE()
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 9800, 'ev_d26r0101_guide_upd')
	_TALK_OBJ_END()
	_END()
ev_d26r0101_anaunce_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 9900)
	_RET()
ev_d26r0101_door_02:
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_door_02', 'The door is locked. A special key is needed.\rWould you like to use the Galactic Key?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'yes_d26r0101_door')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'no_d26r0101_door')
	_END()
yes_d26r0101_door:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_d26r0101', '80-msg_d26r0101_door_03', 'The door opened.')
	_SE_WAIT('UI_COMMON_SELECT')
	_SE_PLAY('S_FI014')
	_SET_DOOR_OBJ('P_C_001_AutoDoor_01')
	_HIT_DOOR_ANIME(0)
	_HIT_DOOR_ANIME_WAIT()
	_FLAG_SET(#FV_D26R0101_DOOR)
	_TALK_CLOSE()
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 10300)
	_TALK_OBJ_END()
	_END()
no_d26r0101_door:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_d26r0101_paper1:
	_MACRO_EASY_OBJ_MSG('dialogue_d26r0101', '80-msg_d26r0101_paper1_01', 'The Team Galactic credo! Everything belongs to\nTeam Galactic!\rLook beyond the world—space will become\nTeam Galactic’s!')
	_END()