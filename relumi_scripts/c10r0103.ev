ev_c10r0103_flag_change:
	_IF_FLAGON_JUMP(#FE_BIGFOUR1_WIN, 'ev_c10r0103_bigfour1_set1')
	_IF_FLAGOFF_JUMP(#FE_BIGFOUR1_WIN, 'ev_c10r0103_bigfour1_set2')
	_END()
ev_c10r0103_bigfour1_set1:
	_IF_FLAGOFF_JUMP(#FH_02, 'ev_c10r0103_bigfour1_set1_end')
	_DOOR_ENABLE_SET('C10R0103_D02', 0)
	_DOOR_ENABLE_SET('C10R0103_D01', 0)
	_SET_DOOR_OBJ('C10R0103_D02')
	_HIT_DOOR_ANIME(0)
	_SXY_EXIT_POS_CHANGE(0, 7, 2)
	_END()
ev_c10r0103_bigfour1_set1_end:
	_END()
ev_c10r0103_bigfour1_set2:
	_DOOR_ENABLE_SET('C10R0103_D02', 0)
	_DOOR_ENABLE_SET('C10R0103_D01', 0)
	_SXY_EXIT_POS_CHANGE(0, 7, 0)
	_END()
ev_c10r0103_bigfour1:
	_IF_FLAGON_JUMP(#FE_BIGFOUR1_WIN, 'ev_c10r0103_bigfour1_02')
	_BGM_PLAY('EV214')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE3, 'ev_c10r0103_bigfour1_pupl3')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE2, 'ev_c10r0103_bigfour1_pupl2')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CALL('ev_block_doc')
	_OBJ_POS_CHANGE_WORLD('HERO', 8, 0, 6.600000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(85)
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_01_1', 'Hello! Welcome to the Pokémon League!\rI’m Aaron of the Elite Four. It’s good to\nmeet you.')
	_OBJ_ANIME('C10R0103_BIGFOUR1', 'anm_c10r0103_bigfour1_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_01_2', 'Oh, I should explain—I’m a huge fan of\nbug Pokémon.\rBug Pokémon are nasty-mean, and yet they’re\nbeautiful, too...')
	_TALK_CLOSE()
	_OBJ_ANIME('C10R0103_BIGFOUR1', 'anm_c10r0103_bigfour1_face00')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_01_3', 'Would you like to know why I take on\nchallengers here, in this room?\rIt’s because I want to become perfect, just like\nmy bug Pokémon!\rOK! Let me take you on!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(86)
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league01')
	_LDVAL(@WK_PLAY_REPO_NO, 21)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c10r0103_randomteam_aaron')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0103_bigfour1_win_common')
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_02_1', 'I lost with the most beautiful and toughest of the\nbug Pokémon...\rWe lost because I wasn’t good enough.\rThat’s it! Back to training camp! Let’s hear it\nfor me!')
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_02_2', 'No... That was wrong... Anyway! Go on to the\nnext room!\rThree more Trainers are waiting for you.\nThey’re all tougher than me.')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0103_bigfour1_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0103_randomteam_aaron:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 855)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 856)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 857)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 858)
	_RET()
ev_c10r0103_randomteam_aaron_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 923)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 924)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 925)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 926)
	_RET()
ev_c10r0103_bigfour1_win_common:
	_FLAG_SET(#FE_BIGFOUR1_WIN)
	_RET()
ev_c10r0103_bigfour1_win_dooropen:
	_SET_DOOR_OBJ('C10R0103_D02')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI116')
	_HIT_DOOR_ANIME_WAIT()
	_SXY_EXIT_POS_CHANGE(0, 7, 2)
	_FLAG_SET(#FH_02)
	_RET()
anm_c10r0103_bigfour1_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c10r0103_bigfour1_face01:
	_AC_FACE_INDEX(1)
	_ACMD_END()
ev_c10r0103_bigfour1_pupl2:
	_TALK_OBJ_START()
	_EVENT_START()
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_11_1', 'Hi there! I’m Aaron.\rBut actually, I’ve battled with you before,\nhaven’t I?\rWait a moment! My bug Pokémon are buzzing\nabout something...\rYou must have gotten even stronger! The hunch\nof a Bug-type Pokémon is rarely wrong.\rAll right, then! I’ll battle you once more with all\nmy strength!')
	_TALK_CLOSE()
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league01')
	_LDVAL(@WK_PLAY_REPO_NO, 34)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c10r0103_randomteam_aaron_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0103_bigfour1_win_common')
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_11_2', 'Ahhh... Today, as always, my bug Pokémon were\ntruly beautiful.\rThey didn’t waste a single motion, and they\npulled off some perfectly-polished moves.\rThe only thing that held them back from winning\nwas my own weakness.\rIf I can improve myself, then they’ll get a chance\nto shine brighter than Beautifly wings in the sun!\rLet’s hear it for my Pokémon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0103_bigfour1_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0103_bigfour1_pupl3:
	_TALK_OBJ_START()
	_EVENT_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_21_1', 'Hey there, {0,1,0,0}!\rI had a hunch you’d be back for more battles!\nI guess you could say a little bug told me.\rAnd I can tell just by looking that your Pokémon\nare more beautiful and polished than before—\fof course, so are mine!\rSo now, let me show you the Evolutionary power\nof bug Pokémon!')
	_TALK_CLOSE()
	_BGM_NOW_MAP_PLAY()
	_BTL_ENCSEQ_LOAD('league01')
	_LDVAL(@WK_PLAY_REPO_NO, 39)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c10r0103_randomteam_aaron_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_CALL('ev_c10r0103_bigfour1_win_common')
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_21_2', 'This brings me back to when I first discovered\nbug Pokémon...\rI couldn’t believe how sharply they’d polished\ntheir survival skills. Ever since then, I’ve devoted\fmyself to following the beauty of the Bug type.\rBut as much as it bugs me to lose like this to you,\nI’ll never stop aiming for perfection.\rThat way, I can keep on showing the wonder of\nbug Pokémon to the world!')
	_TALK_CLOSE()
	_CALL('ev_block_doc_end')
	_CALL('ev_c10r0103_bigfour1_win_dooropen')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0103_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0103_bigfour1_02:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE3, 'ev_c10r0103_bigfour1_pupl3w')
	_IF_FLAGON_JUMP(#FE_POWER_UP_P_LEAGUE2, 'ev_c10r0103_bigfour1_pupl2w')
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_03', 'Go on—go to the next room.\rWith my beautiful and tough bug Pokémon, I’m\ngoing to become a top-level Trainer who can’t\fbe outclassed!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0103_bigfour1_pupl2w:
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_11_3', 'Whoops. Got a little carried away again...\nAnyway, carry on to the next room!\rStronger Trainers than I will put you to the test!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0103_bigfour1_pupl3w:
	_MACRO_TALKMSG('dialogue_c10r0103', '20-msg_c10r0103_bigfour1_21_3', 'And now, on to the next room! My bug Pokémon\nhave already spread the buzz about your victory!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0103_room_in:
	_EVENT_START()
	_SET_DOOR_OBJ('C10R0103_D01')
	_HIT_DOOR_ANIME(0)
	_SE_PLAY('S_FI116')
	_OBJ_ANIME('HERO', 'anm_c10r0103_roomin_01')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET('C10R0103_D01')
	_SE_PLAY('S_FI117')
	_HIT_DOOR_ANIME(1)
	_HIT_DOOR_ANIME_WAIT()
	_DOOR_ENABLE_SET('C10R0103_D02', 0)
	_DOOR_ENABLE_SET('C10R0103_D01', 0)
	_SXY_EXIT_POS_CHANGE(0, 7, 0)
	_LDVAL(@WK_SCENE_CL_DOOR, 2)
	_TALK_END()
	_END()
anm_c10r0103_roomin_01:
	_AC_DIR_U(4)
	_AC_UP(2, 8)
	_AC_WAIT(16)
	_ACMD_END()