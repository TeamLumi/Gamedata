ev_c02gym0101_flag_change:
	_SET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_INIT_FLD_LIFT()
	_END()
ev_c02gym0101_gym_first:
	_EVENT_START()
	_IFVAL_JUMP(@WK_SCENE_C02GYM0101, 'NE', 0, 'ev_c02gym0101_gym_first_end')
	_EVENT_CAMERA_INDEX(407)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c02gym0101_gym_first01')
	_END()
ev_c02gym0101_gym_first01:
	_EVENT_CAMERA_INDEX(87)
	_LDVAL(@WK_SCENE_C02GYM0101, 1)
	_TALK_END()
	_END()
ev_c02gym0101_gym_first_end:
	_TALK_END()
	_END()
ev_c02gym0101_randomteam_byron:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 843)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 844)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 845)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 846)
	_RET()
ev_c02gym0101_randomteam_byron_rematch:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 911)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 912)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 913)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 914)
	_RET()
ev_c02gym0101_leader:
	_PLAYER_NAME(0)
	_SYS_FLAG_BADGE_GET($BADGE_ID_C02, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02gym0101_leader_badge_get')
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_POS_CHANGE_WORLD('HERO', 16, 63, 4.500000)
	_OBJ_DIR_CHANGE('HERO', 180)
	_EVENT_CAMERA_INDEX(408)
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_OBJ_ANIME('C02GYM0101_LEADER', 'anm_c02gym0101_leader_01_face04')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_01_1', 'It’s good to see you!\rDo you feel prepared after training at\nIron Island?\rIf so, then now I will take your challenge!')
	_OBJ_ANIME('C02GYM0101_LEADER', 'anm_c02gym0101_leader_01_face00')
	_OBJ_ANIME_WAIT()
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(117)
	_BTL_ENCSEQ_LOAD('gym06')
	_LDVAL(@WK_PLAY_REPO_NO, 11)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c02gym0101_randomteam_byron')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_EVENT_CAMERA_INDEX(414)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_02', 'You were strong enough to take down my prized\nteam of Pokémon. In recognition of that power,\fI give you this—the Mine Badge!')
	_TALK_CLOSE()
	_BADGE_GET(5)
	_CON_WAIT_CONTEST_MENU()
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI006')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_03', 'You received the Mine Badge from Byron!')
	_ME_WAIT()
	_SYS_FLAG_BADGE_SET($BADGE_ID_C02)
	_TRAINER_FLAG_SET('KARATE_09')
	_TRAINER_FLAG_SET('WORKER_07')
	_TRAINER_FLAG_SET('WORKER_08')
	_TRAINER_FLAG_SET('ELITEM_07')
	_TRAINER_FLAG_SET('ELITEW_07')
	_TRAINER_FLAG_SET('KARATE_16')
	_TRAINER_FLAG_SET('WORKER_09')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 8600)
	_FLAG_RESET(#FV_C02_RIVAL)
	_FLAG_RESET(#FV_C02R0103_RIVAL)
	_FLAG_RESET(#FV_C02R0103_SUPPORT)
	_FLAG_RESET(#FV_C02R0103_DOCTOR)
	_LDVAL(@WK_SCENE_C02, 2)
	_FLAG_SET(#FV_T02R0101_DOCTOR)
	_FLAG_SET(#2351)
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_04_1', 'Having the Mine Badge enables you to use the\nhidden move Strength from your Pokétch anytime.')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_04_2', 'You now have six Gym Badges.\rThat means all Pokémon up to Lv. 70 will obey\nyou without question.\rHere! Take these, too!', 1)
	_CB_ITEM_NUM_ADD(90, 1)
	_CB_ITEM_NUM_ADD(66, 4)
	_CB_ITEM_NUM_ADD(67, 4)
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_LEADER7_01')
	_SE_PLAY('M_FI014')
	_MACRO_TALKMSG('dialogue_c02gym0101', '84-msg_c03gym0101_leader_05_4', 'You obtained the Stickers that\n{0,1,0,0} uses!', 0, 1)
	_ME_WAIT()
	_JUMP('ev_c02gym0101_leader_item_get')
	_JUMP('ev_c02gym0101_leader_item_get')
ev_c02gym0101_leader_item_get:
	_LDVAL(@SCWK_TEMP0, 418)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c02gym0101_leader_item_get_fail')
	_CALL('ev_item_event')
	_FLAG_SET(#FE_C02_GYM_ITEM_GET)
	_ITEM_NAME(0, @SCWK_TEMP0, 1)
	_ITEM_WAZA_NAME(1, @SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_05', '{0,1,9,0} contains the move\n{1,1,7,0}.\rIf it hits, it may also lower the target’s Sp. Def.', 0, 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(415)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
anm_c02gym0101_leader_01_face00:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_c02gym0101_leader_01_face04:
	_AC_FACE_INDEX(4)
	_ACMD_END()
ev_c02gym0101_leader_item_get_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c02gym0101_leader_badge_get:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C02_GYM_ITEM_GET, 'ev_c02gym0101_leader_item_get')
	_IF_FLAGON_JUMP(#FE_POWER_UP_GYM_LEADER, 'ev_c02gym0101_leader_return_match')
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_06_1', 'Gwahahahaha! The Sinnoh region is vast!\rTough Trainers like you and {1,1,0,0}\ncrop up constantly to challenge the old guard!')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_06_2', 'With more young Trainers like you and my son\ntaking charge, the future of Pokémon is bright!\rBut I’m not stepping aside just yet! I merely need\nto rededicate myself to training on Iron Island.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02gym0101_leader_return_match:
	_IF_FLAGON_JUMP(#FE_C02_GYM_RETRUN_MATCH_FIRST, 'pos_c02gym0101_leader_return_match2')
	_IF_FLAGON_JUMP(#TMFLG_C02_GYM_RETRUN_MATCH, 'ev_c02gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_07_01', 'Thanks for coming. I heard about your\nremarkable achievement from Roark—\fthat you’ve entered the Hall of Fame.\rNo surprise there. Small wonder, then, that my\nson and I had such a rough time battling you!\rBut this time, I won’t underestimate you or let my\nguard down in the slightest.\rI have you to thank for shaking me out of\nmy complacency!\rNow then, {0,1,0,0}, brace yourself,\nand let’s begin!', 0, 1)
	_TALK_CLOSE()
	_BTL_ENCSEQ_LOAD('gym06')
	_LDVAL(@WK_PLAY_REPO_NO, 31)
	_FLAG_SET(#FE_PLAY_REPO)
	_CALL('ev_c02gym0101_randomteam_byron_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_07_02', 'Gwahahaha!\rI retrained myself on Iron Island, but it still wasn’t\nenough. It seems that experience is no match for\fyouthful vigor!')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_07_03', 'This is the Sticker I use all the time.\rI know it’s not much, but please accept it!')
	_LDVAL(@SCWK_TEMP0, 67)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C02_GYM_RETRUN_MATCH_FIRST)
	_FLAG_SET(#TMFLG_C02_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
	_NONE_USE_NUMBER()
pos_c02gym0101_leader_return_match2:
	_IF_FLAGON_JUMP(#TMFLG_C02_GYM_RETRUN_MATCH, 'ev_c02gym0101_leader_return_match_won')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_08_01', 'Thanks for coming. Each time I hear your knock\non the Gym gate, my heart leaps like a child’s.\rNow then, {0,1,0,0}, brace yourself,\nand let’s begin!')
	_TALK_CLOSE()
	_LDVAL(@WK_PLAY_REPO_NO, 31)
	_FLAG_SET(#FE_PLAY_REPO)
	_BTL_ENCSEQ_LOAD('gym06')
	_CALL('ev_c02gym0101_randomteam_byron_rematch')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_08_02', 'Gwahahaha!\rI retrained myself on Iron Island, but it still wasn’t\nenough. It seems that experience is no match for\fyouthful vigor!')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_07_03', 'This is the Sticker I use all the time.\rI know it’s not much, but please accept it!')
	_LDVAL(@SCWK_TEMP0, 67)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#TMFLG_C02_GYM_RETRUN_MATCH)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02gym0101_leader_return_match_won:
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_leader_07_04', 'Just looking at you brings back memories of the\ndays I spent training from dawn to dusk with my\fbeloved Pokémon...\rPlease come again any time.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02gym0101_common_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c02gym0101_advice:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C02, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02gym0101_advice_02')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_sunglasses_01', 'Hey there, Champ-to-be!\rThe Gym Leader here uses\nSteel-type Pokémon.\rThey’re really tough.\rSome of them will feel like running into\na load of spikes every time you touch them,\rand others only get bulkier the less they\nfocus on defense!\rEven if you do knock ’em hard\nand fast with super-effective moves,\fthey might hit harder than before!\rThe Leader, even trains on Iron Island every day,\nand has hand-picked the toughest Pokémon\fhe could find.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02gym0101_advice_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_sunglasses_02_1', 'Oh, {0,1,0,0}! You’ve beaten the\nGym Leader! Good going!\rThat makes it six Gym Badges! I tell you what,\nyou’re really turning into one fine Trainer.')
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_sunglasses_02_2', 'If you were to say you’re going to try to become\nthe Pokémon Champ, no one’d laugh at you now!\rI’m in your corner, kiddo!', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02gym0101_statue:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C02, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02gym0101_statue_02')
	_RIVAL_NAME(0)
	_RIVAL_NAME(1)
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_statue_01', 'Canalave City Pokémon Gym\nGym Leader: Byron\fCertified Trainers: {1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02gym0101_statue_02:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_RIVAL_NAME(2)
	_MACRO_TALKMSG('dialogue_c02gym0101', '163-msg_c02gym0101_statue_02', 'Canalave City Pokémon Gym\nGym Leader: Byron\rCertified Trainers: {0,1,0,0}\n{1,1,0,0}')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02gym0101_all_lift:
	_MOVE_FLD_LIFT()
	_END()