pos_r218r0201_zukan:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(910)
	_EVENT_CAMERA_END_WAIT()
	_CALL('pos_r218r0201_assistantm_anime_01')
	_PLAYER_NAME(0)
	_SUPPORT_NAME(1)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r218r0201_assistantm_01')
	_JUMP('ev_r218r0201_assistantm_02')
	_JUMP('ev_r218r0201_assistantm_03')
ev_r218r0201_assistantm_01:
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_01_1', '{0,1,0,0}, long time no see!\rOh? You look puzzled. You’re wondering who\nI am.')
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_01_2', 'I’m Professor Rowan’s assistant and\n{1,1,0,0}’s father.\rThe professor asked that I upgrade your\nPokédex, you see. So I’d chosen this spot on a\fhunch that you’d pass through.', 0, 1)
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_01_3', '{0,1,0,0}, may I have your Pokédex\nfor a moment?', 0, 1)
	_JUMP('ev_r218r0201_assistantm_03')
	_JUMP('ev_r218r0201_assistantm_03')
ev_r218r0201_assistantm_02:
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_02_1', '{0,1,0,0}, long time no see!\rOh? You look puzzled. You’re wondering who\nI am.')
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_02_2', 'I’m Professor Rowan’s assistant and\n{1,1,0,0}’s father.\rThe professor asked that I upgrade your\nPokédex, you see. So I’d chosen this spot on a\fhunch that you’d pass through.', 0, 1)
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_02_3', '{0,1,0,0}, may I have your Pokédex\nfor a moment?', 0, 1)
	_JUMP('ev_r218r0201_assistantm_03')
	_JUMP('ev_r218r0201_assistantm_03')
ev_r218r0201_assistantm_03:
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_03_1', 'Let’s see... Was I supposed to put in the\nsoftware here...?\r*ka-chunk*\n*ka-chunk*')
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_03_2', '...Hm? It looks like your Pokédex doesn’t need\nupgrading. It already lets you toggle between\fimages of male and female Pokémon.\rTechnology sure has improved lately!')
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_03_3', 'OK, I’ll leave you to carry on with your project\nfor the professor.\r...May I also ask you to keep an eye on\nTeam Galactic?')
	_MACRO_TALKMSG('dialogue_r218r0201', '64-msg_r218r0201_assistantm_03_4', 'The professor is concerned about what happened\nin Jubilife City...\rIt’s probably nothing to worry over! I’ll be on my\nway now.')
	_TALK_CLOSE()
	_CALL('ev_r218r0201_assistantm_anime_02')
	_FLAG_SET(#FV_R218R0201_ASSISTANTM)
	_OBJ_DEL('R218R0201_ASSISTANTM')
	_LDVAL(@WK_SCENE_R218R0201_ZUKAN, 1)
	_EVENT_CAMERA_INDEX(911)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
pos_r218r0201_assistantm_anime_01:
	_PLAYER_POS_GET(@SCWK_TEMP1, @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 6, 'pos_r218r0201_assistant_move_in_01')
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 8, 'pos_r218r0201_assistant_move_in_03')
	_JUMP('pos_r218r0201_assistant_move_in_02')
	_JUMP('pos_r218r0201_assistant_move_in_01')
