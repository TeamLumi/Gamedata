ev_r216_flag_change:
	; Place the Darmanitan blocker to be on half a tile
	_IF_FLAGOFF_CALL(#2408, 'ev_r216_darmanitan_position')
	; After Darmanitan blocker has been removed, remove the NPCs if the player is not coming from R217
	_IF_FLAGON_JUMP(#2408, 'ev_r216_remove_blockers_check')
	; Checks if it is too early to activate Maylene
	_IF_FLAGON_JUMP(#2401, 'ev_r216_casteliacone_check')
	_END()
ev_r216_darmanitan_position:
	_OBJ_POS_CHANGE_WORLD('R216_DARMANITAN', 304.5, 2, 385)
	_RET()
ev_r216_casteliacone_check:
	; Checks if the player has at least one Casteliacone when entering the route
	_ITEM_CHK(591, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'GE', 1, 'ev_r216_add_maylene')
	_END()
ev_r216_add_maylene:
	_FLAG_RESET(#2934) ; Player has arrived with Casteliacone
	_OBJ_ADD('R216_MAYLENE') ; Enables Maylene PlaceData
	_END()
ev_r216_remove_blockers_check:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'GT', 385, 'ev_r216_remove_blockers') ; Player is coming from R217
	_END()
ev_r216_remove_blockers:
	_FLAG_SET(#2936)
	_FLAG_SET(#2409)
	_OBJ_DEL('R216_BLOCKER01')
	_OBJ_DEL('R216_BLOCKER02')
	_END()
ev_r216_sign1:
	_EASY_BOARD_MSG('dialogue_r216%172-msg_r216_sign1_01', 'BOARD_TYPE_ROAD', 0, 1)
	_END()
ev_r216_sign2:
	_EASY_BOARD_MSG('dialogue_r216%172-msg_r216_sign2_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_r216_blocker1:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2936, 'ev_r216_blocker1_3') ; Before Lake Verity has been completed
	_IF_FLAGON_JUMP(#2408, 'ev_r216_blocker1_2') ; After Darmanitan has been removed
	; After Lake Verity has been completed
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_01', 'I do wonder. Maybe that Pokémon is hungry\nafter all...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r216_blocker1_2:
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_02', 'Yo, I can’t believe that Casteliacone really did\nget Darmanitan moving.\rNow that I think about it, though.\nA frozen treat would definitely mellow me out,\ftoo.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r216_blocker1_3:
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_03', 'Yo! Be careful, kid. There’s this crazy\nDarmanitan blocking the path to Route 217.\rI wouldn’t get too close to it either if I were\nyou.\rIt’s spitting some wild flames! I know that\nDarmanitan are Fire-type Pokémon so I wonder\fwhy it chose a place like this to jump around.\rI’m chill about it, though. Let’s just hope it\ndoesn’t burn up the trees.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r216_blocker2:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2408, 'ev_r216_blocker2_2') ; After Darmanitan has been removed
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper2_01', 'Have you ever had tried a Casteliacone?\nTrust me, kid. They’re the best treat to simmer\fdown with after a workout.\rThe Veilstone Department Store having them\nback in stock is the best news I’ve heard all\fday!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r216_blocker2_2:
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper2_02', 'I thought that Darmanitan were Fire-type\nPokémon. You mean to tell me that there are\fdifferent variations of the same Pokémon?!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r216_maylene:
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_01', 'I trust you, {0}.\nTry feeding your Casteliacone to the\fDarmanitan.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_r216_darmanitan_1:
	; StopData triggered the first time the player arrives after Lake Verity
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SXY_POS_CHANGE('HERO', 303, 390)
	_SXY_DIR_CHANGE('HERO', 270)
	_EVENT_CAMERA_INDEX(556)
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER01')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_1', 'Yo, hold up! That Darmanitan is bad news.\nIt’s in some kind of fiery frenzy.\rA blonde kid flew by earlier and just barely got\npast it.')
	_CHARA_LOOK_LOCK('R216_BLOCKER02', 'R216_BLOCKER01')
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER02')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_2', 'I bet it’s hungry, man.')
	_CHARA_LOOK_LOCK('R216_BLOCKER01', 'R216_BLOCKER02')
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER01')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_3', 'Hungry? You think it has the energy to bounce\naround that much on an empty stomach?')
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER02')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_4', 'Dude, you put it to shame with the tantrums\nyou throw when you haven’t eaten.')
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER01')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_5', '...\nStop talking about food, okay? I haven’t eaten\ftoday.')
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER02')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_6', 'Oh, did you hear? The Veilstone Department\nStore finally restocked their Regional\fDelicacies!\rI could really go for a Rage Candy Bar...\nNo, wait. A Casteliacone! Those always cool\fme off after a workout at the Veilstone Gym.')
	_CHARA_LOOK_LOCK('HERO', 'R216_BLOCKER01')
	_OBJ_ANIME('R216_BLOCKER01', 'anm_r216_blocker1_angry')
	_PLAY_EMO_SE(12)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_stopper1_pos_7', 'Stop talking about food!!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('R216_BLOCKER01')
	_CHARA_LOOK_RELEASE('R216_BLOCKER02')
	_LDVAL(@441, 2)
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_CAMERA_INDEX(600); Return to default camera
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_FLAG_SET(#2401); Enabled Casteliacones in Veilstone Department Store
	_EVENT_END()
	_END()
anm_r216_blocker1_angry:
	_AC_MARK_EMO(12)
	_ACMD_END()
pos_r216_darmanitan_2_maylene:
	_IF_FLAGOFF_JUMP(#2934, 'pos_r216_darmanitan_2_maylene_2') ; Player has arrived with Casteliacone
	; If the player doesn't have the item, the StopData does nothing
	_END()
pos_r216_darmanitan_2_maylene_2:
	; StopData triggered 
	_EVENT_START()
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SXY_POS_CHANGE('HERO', 302, 388)
	_SXY_DIR_CHANGE('HERO', 180)
	_SXY_DIR_CHANGE('R216_MAYLENE', 0)
	_EVENT_CAMERA_INDEX(557)
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_pos_1', 'Oh, {0}.\nUm, are you maybe on your way to Snowpoint\fCity? That’s where I’m going, too.')
	_CHARA_LOOK_LOCK('R216_MAYLENE', 'R216_DARMANITAN')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_pos_2', 'But, there is this Darmanitan blocking the path.')
	_CHARA_LOOK_LOCK('R216_MAYLENE', 'HERO')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_pos_3', 'If I use Fly, I can get there instantly, but I’m\nwalking for my training. I’m used to the cold,\fbut it takes lots of focus to walk through the\fsnow. Especially because I’m lightly dressed\fand barefoot...\rSorry! I’m getting off track.\nWhat I mean to say is that I could use Fly to\fget around the obstacle, but that isn’t much\fgood for everybody else.')
	_OBJ_ANIME('R216_MAYLENE', 'anm_r216_maylene_emote_think')
	_PLAY_EMO_SE(9)
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_pos_4', 'Oh? You say that you helped a friend of yours\nto get rid of a Darmanitan using a Rage Candy\fBar?')
	_CHARA_LOOK_LOCK('R216_MAYLENE', 'R216_DARMANITAN')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('R216_MAYLENE', 'anm_r216_maylene_emote_skeptical')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_pos_5', 'I don’t think this one needs any more rage in\nits life, {0}...')
	_CHARA_LOOK_LOCK('R216_MAYLENE', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('R216_MAYLENE', 'anm_r216_maylene_emote_neutral')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_maylene_pos_6', 'You brought a Casteliacone for this one? Like,\nto cool it down? Um, yeah. Maybe that could\fwork.')
	_TALK_CLOSE()
	_LDVAL(@441, 3)
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_CHARA_LOOK_RELEASE('R216_MAYLENE')
	_OBJ_DIR_CHANGE('R216_MAYLENE', 270) ; Face right
	_EVENT_CAMERA_INDEX(600); Return to default camera
	_EVENT_CAMERA_END_WAIT()
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_EVENT_END()
	_END()
ev_r216_darmanitan:
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_CHARA_LOOK_LOCK('HERO', 'R216_DARMANITAN')
	_EVENT_CAMERA_INDEX(246)
	_EVENT_CAMERA_END_WAIT()
	; Checks if the player has at least one Casteliacone
	_ITEM_CHK(591, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 1, 'ev_r216_darmanitan_casteliacone_check')
	_IFVAL_CALL(@441, 'LT', 2, 'ev_r216_darmanitan_01')
	_IFVAL_CALL(@441, 'GE', 2, 'ev_r216_darmanitan_02')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(247)
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_r216_darmanitan_01:
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_01', 'The Pokémon is bouncing around violently.\nIt seems too dangerous to run past it.')
	_RET()
ev_r216_darmanitan_02:
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_02', 'It does seem a bit hungry. A Rage Candy Bar\nwould likely make matters worse though.')
	_RET()
ev_r216_darmanitan_casteliacone_check:
	_IFVAL_JUMP(@441, 'EQ', 3, 'ev_r216_darmanitan_casteliacone')
	_RET()
ev_r216_darmanitan_casteliacone:
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_casteliacone', 'The raging Darmanitan’s outburst is too\ndangerous. Would you like to try giving it a\fCasteliacone?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_r216_darmanitan_casteliacone_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_r216_darmanitan_casteliacone_no')
	_END()
ev_r216_darmanitan_casteliacone_no:
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(247)
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_r216_darmanitan_casteliacone_yes:
	_CALL('ev_another_out')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_03', 'Darmanitan responded to the Casteliacone,\nand directed its rampage at you!')
	_TALK_CLOSE()
	_VOICE_PLAY(555, 3, 0)
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_awakened', 'MAAAAAAAAANI! DARMAAAAAANI!!')
	_VOICE_WAIT()
	_TALK_CLOSE()
	; Remove item from bag
	_SUB_ITEM(591, 1, @SCWK_ANSWER)
	; Start wild battle
	_SP_WILD_BTL_SET(555, 48, 0, 2, 1)
	; Reposition the player
	_OBJ_POS_CHANGE_WORLD('HERO', 304.5, 2, 387)
	_OBJ_DIR_CHANGE('HERO', 180)
	; Check if the pokemon was caught
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 555)
	_FLAG_SET(#2408) ; Remove Darmanitan blocker
	_OBJ_DEL('R216_DARMANITAN')
	; If the pokemon was not caught, replace placedata for awakened one
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 0, 'ev_r216_darmanitan_not_caught')
	_EVENT_CAMERA_INDEX(247)
	_EVENT_CAMERA_END_WAIT()
	; Maylene approaches the player
	_OBJ_ANIME('R216_MAYLENE', 'anm_r216_maylene_walk_player')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('HERO', 'R216_MAYLENE')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_after_battle_1', 'Looks like that friend of yours knows their\nstuff, {0}! Makes me wonder if there are any\fother Pokémon in Sinnoh that want snacks\fbefore they’ll battle.\rSpeaking of which, that battle was hot enough\nto warm me right up! I found myself getting\flost in how confidently you work together...\rIt’s important that you and your Pokémon\ndon’t lose focus out here, though.\rYou should give this Technical Machine a try...')
	_LDVAL(@SCWK_TEMP0, 379) ; Focus Blast
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_after_battle_2', 'Um, that contains Focus Blast. It’s a very strong\nFighting-type move.\r...Achoo!\rOh, that was nothing. Really, I’m not cold at\nall!\rUm, anyway. Now that the way is clear I should\nprobably be going now. Please take care!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('R216_MAYLENE')
	_CHARA_LOOK_LOCK('HERO', 'R216_MAYLENE')
	_OBJ_ANIME('R216_MAYLENE', 'anm_r216_maylene_walk_up')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_RELEASE('HERO')
	_FLAG_SET(#2934) ; Disable Maylene PlaceData
	_OBJ_DEL('R216_MAYLENE')
	_CALL('ev_another_out_end')
	_END()
ev_r216_darmanitan_not_caught:
	; Position the awakened Darmanitan in the same place as the blocker
	_OBJ_POS_CHANGE_WORLD('R216_DARMANITAN_AWAKENED', 304.5, 2, 385)
	; Enable awakened Darmanitan
	_FLAG_RESET(#2935)
	_OBJ_ADD('R216_DARMANITAN_AWAKENED')
	;Animation to run up
	_OBJ_ANIME('R216_DARMANITAN_AWAKENED', 'anm_r216_darmanitan_run_up')
	_PLAY_EMO_SE(7)
	_OBJ_ANIME_WAIT()
	_OBJ_POS_CHANGE_WORLD('R216_DARMANITAN_AWAKENED', 304, 2, 355)
	_OBJ_DIR_CHANGE('R216_DARMANITAN_AWAKENED', 0)
	_RET()
ev_r216_darmanitan_awakened:
	_TALK_OBJ_START()
	_VOICE_PLAY(555, 2, 0)
	_MACRO_TALKMSG('dialogue_r216', 'msg_r216_darmanitan_awakened_1', 'Daaaaaaaar... Daaaaaaaar...')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SP_WILD_BTL_SET(555, 48, 0, 2, 1)
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 555)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 1, 'ev_r216_darmanitan_awakened_caught')
	_TALK_OBJ_END()
	_END()
ev_r216_darmanitan_awakened_caught:
	; Remove Darmanitan when caught
	_FLAG_SET(#2935)
	_OBJ_DEL('R216_DARMANITAN_AWAKENED')
	_RET()
anm_r216_maylene_emote_think:
	_AC_MARK_EMO(9)
	_ACMD_END()
anm_r216_maylene_emote_skeptical:
	_AC_FACE_INDEX(3)
	_ACMD_END()
anm_r216_maylene_emote_neutral:
	_AC_FACE_INDEX(0)
	_ACMD_END()
anm_r216_darmanitan_run_up:
	_AC_MARK_EMO(7)
	_AC_WAIT(15)
	_AC_DIR_U(8)
	_AC_UP(9, 8)
	_ACMD_END()
anm_r216_maylene_walk_player:
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_ACMD_END()
anm_r216_maylene_walk_up:
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_DIR_R(8)
	_AC_RIGHT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(7, 8)
	_AC_DIR_L(8)
	_AC_LEFT(1, 8)
	_AC_DIR_U(8)
	_AC_UP(2, 8)
	_ACMD_END()
;REVIEW
; Flag 2401 - Casteliacones can be bought in the department store basement
; Flag 2408 - Darmanitan blocker removed
; Flag 2409 - Flag for the first NPC
; Inverse Flag 2934 - Player has arrived with Casteliacone (enable Maylene)
; Inverse Flag 2935 - Darmanitan awakened static (first one not caught)
; Inverse Flag 2936 - Second NPC (enabled after Lake Verity)
; @441 - Work for both StopDatas
; Removed the StopData for Maylene in R217, as it is now handled in the event