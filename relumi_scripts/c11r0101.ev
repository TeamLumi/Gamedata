ev_c11r0101_flag_change:
	_ARRIVE_FLAG_SET($FLAG_ARRIVE_C11R0101)
	_END()
ev_c11r0101_first_entry:
	_EVENT_START()
	_LDVAL(@WK_SCENE_C11R0101, 1)
	_FLAG_SET(#FV_C01R0206_STOP)
	_FLAG_SET(#FV_C01R0207_STOP)
	_CALL('ev_c11r0101_anm_staff_turn_d')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_01', 'Welcome to the Battle Park!\nIt’s your first time, isn’t it? Please step this way.')
	_TALK_CLOSE()
	_CALL('ev_c11r0101_anm_player_move')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_02', 'Since this is your first visit, you need to be given\na Point Card.\rPoint Cards are used only in the Battle Park.\nHere you go.')
	_LDVAL(@SCWK_TEMP0, 432)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_03_1', 'If you need information on the Point Card,\nplease ask the receptionist next to me.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_03_2', 'I’m the one to ask if you need any information\non the facilities here in the Battle Park.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_03_3', 'For information on the battle rules used at the\nBattle Park, please ask the receptionist across\ffrom me.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_all_end', 'Good luck!')
	_TALK_CLOSE()
	_FLAG_SET(#FV_C01R0206_STOP)
	_OBJ_DEL('C01R0206_STOP_01')
	_FLAG_RESET(#FH_OBJ01)
	_FLAG_RESET(#FH_OBJ02)
	_FLAG_RESET(#FH_OBJ03)
	_OBJ_ADD('C01R0206_GINESS01')
	_OBJ_ADD('C01R0206_GINESS02')
	_OBJ_ADD('C01R0206_GINESS03')
	_FLAG_SET(#FV_C01R0207_STOP)
	_OBJ_DEL('C01R0207_STOP_01')
	_FLAG_RESET(#FH_OBJ01)
	_FLAG_RESET(#FH_OBJ02)
	_FLAG_RESET(#FH_OBJ03)
	_OBJ_ADD('C01R0207_GINESS01')
	_OBJ_ADD('C01R0207_GINESS02')
	_OBJ_ADD('C01R0207_GINESS03')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'NE', 13200, 'ev_c11r0101_guide_upd')
	_TALK_END()
	_END()
ev_c11r0101_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 13000)
	_RET()
ev_c11r0101_staff_a:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_04', 'Welcome to the Battle Park!\rIf you need any information on the facilities, I’m\nthe one to ask.')
	_JUMP('ev_c11r0101_staff_a_menu')
ev_c11r0101_staff_a_menu:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_05', 'What would you like me to explain?')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_02')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_04')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_05')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_01')
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_c11r0101_staff_a_01')
	_CASE_JUMP(1, 'ev_c11r0101_staff_a_02')
	_CASE_JUMP(2, 'ev_c11r0101_staff_a_03')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_all_end', 'Good luck!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c11r0101_staff_a_01:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_06', 'The Battle Park is a place where Trainers may\nenjoy battles.\rThere are two facilities in the Battle Park: the\nExchange Service Corner and the Battle Tower.')
	_JUMP('ev_c11r0101_staff_a_menu')
	_JUMP('ev_c11r0101_staff_b_menu')
ev_c11r0101_staff_a_02:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_08_1', 'The Exchange Service Corner is the building that\nlooks like a castle.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_08_2', 'There, you may exchange the Battle Points (BP)\nyou’ve earned for items.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_08_3', 'Fabulous prizes are offered, so please do visit\nthe Exchange Service Corner when you save\fup BP.')
	_JUMP('ev_c11r0101_staff_a_menu')
	_JUMP('ev_c11r0101_staff_b_menu')
ev_c11r0101_staff_a_03:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_09_1', 'The Battle Tower is the building at the back of\nthe Battle Park.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_09_2', 'The Single Battle Rooms are for conducting\none-on-one battles.\rThe Double Battle Rooms are for\ntwo-on-two battles.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_a_09_3', 'There are also Master Class Single Battles\nand Master Class Double Battles.\rThey feature high-level opponents, and each\ntime you go on a seven-win streak ups your rank.')
	_JUMP('ev_c11r0101_staff_a_menu')
	_JUMP('ev_c11r0101_staff_b_menu')
ev_c11r0101_staff_b:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_b_01', 'Welcome to the Battle Park!\rI can explain how the Point Card and the\nBattle Points (BP) work.')
	_JUMP('ev_c11r0101_staff_b_menu')
ev_c11r0101_staff_b_menu:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_b_02', 'What would you like me to explain?')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_06')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_07')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_01')
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_c11r0101_staff_b_01')
	_CASE_JUMP(1, 'ev_c11r0101_staff_b_02')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_all_end', 'Good luck!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c11r0101_staff_b_01:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_b_03_1', 'Every Trainer visiting the Battle Park is provided\nwith a Point Card that confirms their\fchallenger status.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_b_03_2', 'The Point Card stores Battle Points (BP) that you\nearn from battling in the Battle Tower.')
	_JUMP('ev_c11r0101_staff_b_menu')
	_JUMP('ev_c11r0101_staff_c_menu')
ev_c11r0101_staff_b_02:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_b_04_1', 'BP, short for Battle Points, are used only in the\nBattle Park.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_b_04_2', 'You will earn BP by hitting certain performance\ntargets battling at the Battle Tower.\rThe BP can be traded for prizes at the\nExchange Service Corner.')
	_JUMP('ev_c11r0101_staff_b_menu')
	_JUMP('ev_c11r0101_staff_c_menu')
ev_c11r0101_staff_c:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_01', 'Welcome to the Battle Park!\rI can give you a rundown of the battle rules that\nare used at the Battle Tower.')
	_JUMP('ev_c11r0101_staff_c_menu')
ev_c11r0101_staff_c_menu:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_02', 'What would you like me to explain?')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_08')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_09')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_10')
	_ADD_CUSTUM_WIN_LABEL('dialogue_c11r0101%36-msg_staff_choice_01')
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_SWITCH(@SCWK_ANSWER)
	_CASE_JUMP(0, 'ev_c11r0101_staff_c_01')
	_CASE_JUMP(1, 'ev_c11r0101_staff_c_02')
	_CASE_JUMP(2, 'ev_c11r0101_staff_c_03')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_all_end', 'Good luck!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c11r0101_staff_c_01:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_03_1', 'In Pokémon battles at the Battle Tower,\nPokémon that are Lv. 51 or higher\fwill be set to Lv. 50 for the battles.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_03_2', 'But be careful! Pokémon that are lower than\nLv. 50 will be left as is.')
	_JUMP('ev_c11r0101_staff_c_menu')
	_JUMP('ev_c11r0101_anm_staff_turn_d')
ev_c11r0101_staff_c_02:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_04_1', 'Excluding Eggs and certain exotic Pokémon,\nvirtually every species of Pokémon may enter\fthe Battle Tower.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_04_2', 'Please be aware that the number of Pokémon\nyou may enter will depend on the course you try.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_04_3', 'You are also permitted to take only one of each\nkind of Pokémon into the Battle Tower.')
	_JUMP('ev_c11r0101_staff_c_menu')
	_JUMP('ev_c11r0101_anm_staff_turn_d')
ev_c11r0101_staff_c_03:
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_05_1', 'No two Pokémon in your party may hold the\nsame kind of item in the Battle Tower.')
	_MACRO_TALKMSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c_05_2', 'Please be sure that the Pokémon you bring to\nthe Battle Tower are all holding different items.')
	_JUMP('ev_c11r0101_staff_c_menu')
	_JUMP('ev_c11r0101_anm_staff_turn_d')
ev_c11r0101_anm_staff_turn_d:
	_OBJ_ANIME('C11R0101_STAFF_A', 'anm_c11r0101_turn_d')
	_OBJ_ANIME('C11R0101_STAFF_B', 'anm_c11r0101_turn_d')
	_OBJ_ANIME('C11R0101_STAFF_C', 'anm_c11r0101_turn_d')
	_OBJ_ANIME('C11R0101_STAFF_D_01', 'anm_c11r0101_turn_d')
	_OBJ_ANIME('C11R0101_STAFF_D_02', 'anm_c11r0101_turn_d')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c11r0101_anm_player_move:
	_OBJ_ANIME('C11R0101_STAFF_A', 'anm_c11r0101_turn_r')
	_OBJ_ANIME('C11R0101_STAFF_B', 'anm_c11r0101_turn_r')
	_OBJ_ANIME('C11R0101_STAFF_C', 'anm_c11r0101_turn_l')
	_OBJ_ANIME('C11R0101_STAFF_D_01', 'anm_c11r0101_turn_r')
	_OBJ_ANIME('C11R0101_STAFF_D_02', 'anm_c11r0101_turn_l')
	_OBJ_ANIME('HERO', 'anm_c11r0101_player_move')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c11r0101_turn_d:
	_AC_DIR_D(8)
	_ACMD_END()
anm_c11r0101_turn_r:
	_AC_DIR_R(8)
	_ACMD_END()
anm_c11r0101_turn_l:
	_AC_DIR_L(8)
	_ACMD_END()
anm_c11r0101_player_move:
	_AC_DIR_U(4)
	_AC_UP(4, 8)
	_AC_DIR_L(4)
	_AC_LEFT(1, 8)
	_ACMD_END()
ev_c11r0101_staff_d:
	_MACRO_EASY_OBJ_MSG('dialogue_c11r0101', '36-msg_c11r0101_staff_c', 'Welcome to the Battle Park!')
	_END()
ev_c11r0101_bigman:
	_MACRO_EASY_OBJ_MSG('dialogue_c11r0101', '36-msg_c11r0101_bigman_01', 'The Battle Tower’s up ahead.\rI wonder what kind of Trainers are waiting there.')
	_END()