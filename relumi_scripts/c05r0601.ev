	_OBJ_ANIME('C05R0601_RIVAL', 'anm_c05r0601_rival_fight_approach_player_1')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r0601_rival_fight_approach_player_2:
	_OBJ_ANIME('C05R0601_RIVAL', 'anm_c05r0601_rival_fight_approach_player_2')
