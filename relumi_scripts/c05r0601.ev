ev_c05r0601_rival_fight:
	_TALK_OBJ_START()
	_OBJ_ANIME('C05R0601_RIVAL', 'anm_c05r0601_rival_fight_exclamation')
	_OBJ_ANIME_WAIT()
	_CALL('ev_the_rival_play')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 5, 'ev_c05r0601_rival_fight_approach_player_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 6, 'ev_c05r0601_rival_fight_approach_player_2')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 7, 'ev_c05r0601_rival_fight_approach_player_3')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 8, 'ev_c05r0601_rival_fight_approach_player_4')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 9, 'ev_c05r0601_rival_fight_approach_player_5')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c05r0601', '00_msg_C05R0601_RIVAL_fight_01', 'Ta-daah!\nKept me waiting again, {1,1,0,0}!\rLet’s see how much tougher you and\nI have gotten, right here and now!\rHey, you’re a Trainer now. You’re\nexpected to be ready for a battle.\rNo whining! No waiting!\nLet’s get the show started!')
	_TALK_CLOSE()
	_RIVAL_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c05r0601_rival_fight_turtwig')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c05r0601_rival_fight_chimchar')
	_JUMP('ev_c05r0601_rival_fight_piplup')
	_END()
