ev_c05r0601_girl2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0601', '48-msg_c05r0601_girl2_01', 'There’s a wrecked stone pillar up ahead.\nI wonder what it is. It’s got me very curious.')
	_END()
ev_c05r0601_randomteam_barry_turtwig:
