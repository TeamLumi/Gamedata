	_RET()
ev_c05r0601_rival_fight_over:
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c05r0601', '00_msg_C05R0601_RIVAL_2', 'Waaah!\rIt goes to show my surefire winning\nstrategy doesn’t work.\rSay, hey, {1,1,0,0}.\nRemember what I told you before?\rMake sure all your attacks hit!\nAvoid every enemy attack!\rI thought that was a wicked strategy,\nbut it doesn’t work worth beans.\rI guess I have to grind it out and\ntoughen up the team a bit at a time.')
	_TALK_CLOSE()
	_JUMP('ev_c05r0601_maid_help')
ev_c05r0601_rival_fight_loss:
	_FLAG_RESET(#2775); TODO Who tf is C05R0601_MAID?
	_TALK_OBJ_END()
	_END()
ev_c05r0601_maid_help:
	_OBJ_DEL('C05R0601_MAID')
	_SXY_POS_CHANGE('C05R0601_MAID', 1, 7)
	_SE_PLAY('S_FI001')
	_OBJ_ADD('C05R0601_MAID')
	_MACRO_TALKMSG('dialogue_c05r0601', '00_msg_C05R0601_RIVAL_3', 'Help! Help!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'ev_c05r0601_maid_help_exclamation')
	_OBJ_ANIME('C05R0601_RIVAL', 'ev_c05r0601_maid_help_exclamation')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('HERO', 'ev_c05r0601_maid_help_face_left')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r0601', '00_msg_C05R0601_RIVAL_6', 'Weirdly dressed thugs have taken\nover the Pokémon Mansion!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R0601_MAID', 'ev_c05r0601_maid_help_face_left')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r0601', '00_msg_C05R0601_RIVAL_4', 'I must inform everyone in the hope\nthat we receive aid...')
	_TALK_CLOSE()
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C05R0601_MAID')
	_OBJ_ANIME('HERO', 'ev_c05r0601_maid_help_face_rival')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r0601', '00_msg_C05R0601_RIVAL_5', 'Woah! That was a surprise!\rThe Pokémon Mansion is that huge\nbuilding on Route 212, yeah?\rWeirdly dressed thugs... Does she\nmean those strange Team Galactic guys?\rThose goons must have decided\nthey want something from there...\rI’m off then!\nTo help a lady in distress!')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 5, 'ev_c05r0601_rival_exit_1')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 6, 'ev_c05r0601_rival_exit_2')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 7, 'ev_c05r0601_rival_exit_3')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 8, 'ev_c05r0601_rival_exit_4')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 9, 'ev_c05r0601_rival_exit_5')
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C05R0601_RIVAL')
	_SE_WAIT('S_FI001')
	_FLAG_SET(#FV_C05R0701_STOPPER)
	_FLAG_SET(#2772)
	_LDVAL(@489, 2)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6250)
	_TALK_OBJ_END()
	_END()
