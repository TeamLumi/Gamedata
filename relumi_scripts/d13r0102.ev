ev_d13r0102_flag_change:
	_IFVAL_JUMP(@WK_SCENE_D13R0101, 'GE', 1, 'ev_d13r0102_farm_time_check')
	_END()
ev_d13r0102_farm_time_check:
	_GET_TIME_ZONE(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'GE', 3, 'ev_d13r0102_farm_add_actors'); Night and Midnight
	_JUMP('ev_d13r0102_farm_del_actors')
ev_d13r0102_farm_add_actors:
	_PLAYER_POS_GET(@LOCALWORK0, @LOCALWORK1)
	_OBJ_ADD('D13R0102_MOUNT')
	_OBJ_ADD('D13R0102_BABYBOY1')
	_IFCOORDS_CALL('D13R0102_MOUNT', @LOCALWORK0, @LOCALWORK1, 'ev_d13r0102_farm_move_mount'); Moves the NPC by a tile if the player saved where they are standing before a time change.
	_IFCOORDS_CALL('D13R0102_BABYBOY1', @LOCALWORK0, @LOCALWORK1, 'ev_d13r0102_farm_move_babyboy1'); Moves the NPC by a tile if the player saved where they are standing before a time change.
	_FLAG_RESET(#2929)
	_FLAG_RESET(#2930)
	_RET()
ev_d13r0102_farm_del_actors:
	_OBJ_DEL('D13R0102_MOUNT')
	_OBJ_DEL('D13R0102_BABYBOY1')
	_FLAG_SET(#2929)
	_FLAG_SET(#2930)
	_RET()
ev_d13r0102_farm_move_mount:
	_SXY_POS_CHANGE('D13R0102_MOUNT', 4, 3)
	_RET()
ev_d13r0102_farm_move_babyboy1:
	_SXY_POS_CHANGE('D13R0102_BABYBOY1', 7, 6)
	_RET()
ev_d13r0102_mount:
	_MACRO_EASY_OBJ_MSG('dialogue_d13r0102', '100-msg_d13r0102_mount_01', 'The flowers that grow in the fields here\nare special.\rDo you see how they’re more vivid than flowers\nelsewhere in Sinnoh?\rYou can thank Pokémon for that.')
	_END()
ev_d13r0102_babyboy1:
	_MACRO_EASY_OBJ_MSG('dialogue_d13r0102', '00_msg_d13r0102_babyboy1_02', 'If you put Honey on a tree, a Pokémon\nmight respond to the scent.')
	_END()