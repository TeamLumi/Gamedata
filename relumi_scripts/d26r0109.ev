	_ACMD_END()
anm_d26r0109_cyrus_1_100:
	_AC_DOWN(3, 8)
	_AC_DIR_L(3)
	_AC_LEFT(4, 8)
	_AC_DIR_D(3)
	_AC_DOWN(1, 8)
	_ACMD_END()
anm_d26r0109_cyrus_1_101:
	_AC_DIR_U(3)
	_AC_UP(1, 8)
	_AC_DIR_R(3)
	_AC_RIGHT(4, 8)
	_AC_DIR_U(3)
	_AC_UP(3, 8)
	_ACMD_END()