anm_d26r0109_looker_1_100:
	_AC_MARK_GYOE()
	_ACMD_END()
anm_d26r0109_looker_1_101:
	_AC_DIR_L(3)
	_ACMD_END()
anm_d26r0109_looker_1_102:
	_AC_DIR_L(3)
	_AC_LEFT(1, 4)
	_AC_DIR_U(3)
	_AC_WAIT(10)
	_AC_DIR_L(3)
	_AC_DIR_D(3)
	_AC_WAIT(10)
	_AC_DIR_L(3)
	_AC_LEFT(10, 4)
	_ACMD_END()
anm_d26r0109_hero_1_100:
	_AC_DIR_D(3)
	_AC_DOWN(1, 8)
	_AC_DIR_L(3)
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_d26r0109_hero_2_100:
	_AC_DIR_L(3)
	_AC_LEFT(1, 8)
	_ACMD_END()
anm_d26r0109_hero_3_100:
