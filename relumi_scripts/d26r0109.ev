pos_d26r0109_stop:
	_LDVAL(@520, 1)
	_EVENT_START()
	_CHARA_LOOK_LOCK('D26R0109_LOOKER', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('HERO', 'D26R0109_LOOKER')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D26R0109_LOOKER')
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('D26R0109_LOOKER', 'anm_d26r0109_looker_1_100'); Exclamation mark
	_OBJ_ANIME_WAIT()
	_TALK_START()
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_looker_1', 'Psst! Here.\nOver here.\rThis gathering of the Team Galactic...\nWhat is the meaning of it?')
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_OBJ_ANIME('D26R0109_LOOKER', 'anm_d26r0109_looker_1_101'); Looker looks west
	_OBJ_ANIME_WAIT()
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 15, 'ev_d26r0109_hero_move_1_100')
	_IFVAL_CALL(@SCWK_TEMP1, 'EQ', 16, 'ev_d26r0109_hero_move_2_100')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(482)
	_JUMP('ev_d26r0109_cyrus_speech')
ev_d26r0109_looker:
	_CHARA_LOOK_LOCK('D26R0109_LOOKER', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('HERO', 'D26R0109_LOOKER')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('D26R0109_LOOKER')
	_CHARA_LOOK_RELEASE('HERO')
	_FADE_WAIT()
	_EVENT_CAMERA_END_WAIT()
	_EVENT_CAMERA_INDEX(485)
	_EVENT_CAMERA_END_WAIT()
	_TALK_START()
	_AYOU_NAME(0)
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_looker_2', '...Whew.\rSo, that was Cyrus, the boss of the\nTeam Galactic.\rQuite the performance, no?\nMesmerizing for one only 27 years old.\r...But to make a world for Team Galactic and\nnone other?\rIt is proposterous. So much so that it makes my\nhead spin.\rA new world? What is that?\nAnd what is this incomplete world?\rVery well. To investigate such matters is the\njob of the International Police.\rOf which I am a member in good stead.\nAnd it is my job, therefore.\rWe shall part ways here.\nTake extra care, {0,1,0,0}!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_d26r0109_hero_3_100'); Player looks west.
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('D26R0109_LOOKER', 'anm_d26r0109_looker_1_102'); Looker exits, stage left.
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('D26R0109_LOOKER')
	_FLAG_SET(#1840); Gets rid of all NPCs from Galactic Speech room.
	_END()
ev_d26r0109_cyrus_speech:
	_EVENT_CAMERA_END_WAIT()
	_EVENT_CAMERA_INDEX(483)
	_EVENT_CAMERA_END_WAIT()
	_OBJ_ADD('D26R0109_CYRUS')
	_OBJ_ANIME('D26R0109_CYRUS', 'anm_d26r0109_cyrus_1_100'); Walk to podium
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_CON_CHEER_S')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_START()
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_cyrus_speech_1', 'Fellow members of Team Galactic!\nHear me!\rMy name, as I appear to you today, is Cyrus.\rThis world of ours is a crude one.\nIn a word, it is incomplete.\rIt has been, and always will be, a struggle to\nsurvive in this world.\rWe humans and Pokémon are likewise\nincomplete.\rBecause we are all so lacking, we fight,\nwe maim... It is ugly.\rI hate the incompleteness.\rThat we are all incomplete, I hate it with my\nentire body and being.\rThe world should be complete.\nThe world must change.')
	_TALK_CLOSE()
	_SE_PLAY('S_CON_CHEER_S')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_START()
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_cyrus_speech_2', 'Then, who will change it?\rMe, Cyrus. And Team Galactic.\nYes, all of you.\rTogether we pored over myths and exposed\ntheir secrets.\rTogether we captured legendary Pokémon.\rAnd now, Team Galactic has obtained the\nenergy to change the world!\rThe power of dreams is within our grasp!')
	_TALK_CLOSE()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_START()
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_cyrus_speech_3', 'Understand it, fellow members!\rMy long-held dreamworld is on the verge of\nbecoming reality.\rAll those headed to Mt.Coronet, and those\nwho remain here...\rThough our missions may differ, our hearts\nbeat as one.\rLet there be glory for Team Galactic!')
	_TALK_CLOSE()
	_SE_PLAY('S_CON_CHEER_S')
	_TIME_WAIT(20, @SCWK_ANSWER)
	_TALK_START()
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_cyrus_speech_grunts', 'WROOOAR!!')
	_MACRO_TALKMSG('dialogue_d26r0109', 'msg_d26r0109_cyrus_speech_grunt', 'Master Cyrus is the greatest!')
	_TALK_CLOSE()
	_OBJ_ANIME('D26R0109_CYRUS', 'anm_d26r0109_cyrus_1_101'); Walk to warp pad
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('D26R0109_CYRUS')
	_EVENT_CAMERA_INDEX(484)
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_JUMP('ev_d26r0109_delete_grunts')
ev_d26r0109_hero_move_1_100:
	_OBJ_ANIME('HERO', 'anm_d26r0109_hero_1_100'); Player walks south and then west
	_OBJ_ANIME_WAIT()
	_RET()
ev_d26r0109_hero_move_2_100:
	_OBJ_ANIME('HERO', 'anm_d26r0109_hero_2_100'); Player walks west
	_OBJ_ANIME_WAIT()
	_RET()
ev_d26r0109_delete_cyrus:
	_OBJ_DEL('D26R0109_CYRUS')
	_RET()
