ev_c02r0103_flag_change:
	_GET_MY_SEX(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'c02r0103_male_flag_change_01')
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 1, 'c02r0103_female_flag_change_01')
	_END()
c02r0103_male_flag_change_01:
	_LDVAL(@OBJCHRWORK0, 'HEROINE')
	_END()
c02r0103_female_flag_change_01:
	_LDVAL(@OBJCHRWORK0, 'HERO')
	_END()
ev_c02r0103_rival:
	_EVENT_START()
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_rival_01', 'Hey, {1,1,0,0}! Over here! This way!')
	_TALK_CLOSE()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_01')
	_OBJ_ANIME('HERO', 'anm_c02r0103_player_01')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_DUMMY_SET_POS(@SCWK_TEMP0, @SCWK_TEMP1)
	_CAMERA_TARGET_DUMMY()
	_DUMMY_ANIME('anm_c02r0103_dummy_01')
	_DUMMY_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(213)
	_CHARA_LOOK_LOCK('HERO', 'C02R0103_DOCTOR')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_rival_02', 'OK, gramps! I brought {1,1,0,0} like\nI said!\rAnd now I’m outta here!', 0, 1)
	_TALK_CLOSE()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_00')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_01', '...')
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face_sad')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_rival_05', 'OK. I get it...')
	_TALK_CLOSE()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_80')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_01a_1', 'Hmmm... Everyone’s finally here. Listen up!')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_01a_2', 'You may have forgotten already, but I study the\nEvolution of Pokémon.', 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(214)
	_OBJ_ANIME('C02R0103_DOCTOR', 'anm_c02r0103_doctor_01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_02_1', 'The more I study, the more mysteries appear and\nmultiply. There are some Pokémon that evolve,\fand others that don’t...')
	_SET_FORCE_BLINK('C02R0103_DOCTOR', 1)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_02_2', 'What makes them different from each other?\rDo immature ones evolve into ones that are\nmore mature?', 1)
	_SET_FORCE_BLINK('C02R0103_DOCTOR', 0)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_02_3', 'If so, what do we make of the Legendary\nPokémon that don’t evolve?\rAre we to assume that the Legendary Pokémon\nof Sinnoh are complete as creatures?', 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(215)
	_OBJ_ANIME('C02R0103_DOCTOR', 'anm_c02r0103_doctor_02')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_03_1', 'This is where you three come in.\rThere is said to be a mysterious Pokémon in each\nof the three lakes of Sinnoh.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_03_2', 'If we can obtain data on them, it may shed\nsome light on how the process of Pokémon\fEvolution works.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_03_3', 'I need help from each one of you on this\ngrand undertaking.\fHelp me find these mysterious Pokémon!', 1)
	_EVENT_CAMERA_INDEX(216)
	_RIVAL_NAME(0)
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face_ang')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_rival_03', 'What are you saying? I didn’t get a Pokédex!')
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_04_1', 'And who was it that bolted from the lab before I\nhad a chance to give them one?')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_04_2', 'But that’s water under the bridge!\rSeeing Pokémon with your own eyes is important\nfor you in becoming a better Trainer, too.', 1)
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_male_doctor_01')
	_EVENT_CAMERA_INDEX(217)
	_CHARA_LOOK_RELEASE('HERO')
	_JUMP('c02r0103_female_doctor_01')
	_END()
c02r0103_male_doctor_01:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_heroine_01', 'You can count on me! It will help with my\nPokédex, too.\r{0,1,0,0}, you’ll go too, won’t you?')
	_JUMP('common_c02r0103_doctor_10')
	_END()
c02r0103_female_doctor_01:
	_CHARA_LOOK_LOCK('C02R0103_SUPPORT', 'C02R0103_DOCTOR')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_hero_01', 'You bet, Professor!\rThis will add to the Pokédex database and help\nadvance your research.')
	_JUMP('common_c02r0103_doctor_10')
	_END()
common_c02r0103_doctor_10:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_05', 'Hm! I would have made all of you go regardless...\nNow then, there are three lakes.\rFortuitously, there are three of you. You should\nsplit up and investigate the lakes individually.')
	_TALK_CLOSE()
	_OBJ_ANIME('C02R0103_DOCTOR', 'anm_c02r0103_doctor_03')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_male_doctor_10_01')
	_JUMP('common_c02r0103_doctor_10a')
	_END()
c02r0103_male_doctor_10_01:
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_support_300')
	_OBJ_ANIME_WAIT()
	_RET()
common_c02r0103_doctor_10a:
	_GET_MY_SEX(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_male_doctor_02')
	_JUMP('c02r0103_female_doctor_02')
	_END()
c02r0103_male_doctor_02:
	_EVENT_CAMERA_INDEX(217)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_06', 'Dawn, you go to Lake Verity.')
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_rival_face_happy')
	_OBJ_ANIME_WAIT()
	_SUPPORT_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_heroine_02', 'Will do!')
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c02r0103_doctor_20')
	_END()
c02r0103_female_doctor_02:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_07', 'Lucas, you go to Lake Verity.')
	_SUPPORT_NAME(0)
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_rival_face_happy')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_hero_02', 'Yes, sir!')
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c02r0103_doctor_20')
	_END()
common_c02r0103_doctor_20:
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('C02R0103_SUPPORT')
	_OBJ_ANIME('C02R0103_DOCTOR', 'anm_c02r0103_doctor_04')
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_support_400')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(218)
	_OBJ_INVISIBLE('C02R0103_SUPPORT')
	_OBJ_INVISIBLE('C02R0103_DOCTOR')
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_08', '{0,1,0,0}, I want you to investigate\nLake Acuity.\rThat would take you almost to Snowpoint City.\rThe road there is harsh. I need a tough Trainer\nto go.', 0, 1)
	_TALK_CLOSE()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_400')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face_happy')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_rival_04', 'Uh... Yeah, of course! Gramps, you know how to\ncall it! You can tell I’m the hotness!')
	_TALK_CLOSE()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_401')
	_OBJ_ANIME_WAIT()
	_EVENT_CAMERA_INDEX(219)
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_09', 'And that leaves {0,1,0,0} with\nLake Valor.\rThe lake is between Veilstone and Pastoria, if\nmemory serves.', 0, 1)
	_TALK_CLOSE()
	_OBJ_VISIBLE('C02R0103_SUPPORT')
	_OBJ_VISIBLE('C02R0103_DOCTOR')
	_EVENT_CAMERA_INDEX(220)
	_OBJ_ANIME('HERO', 'anm_c02r0103_rival_face05')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face05')
	_OBJ_ANIME_WAIT()
	_SE_WAIT('UI_COMMON_SELECT')
	_CAMERA_SHAKE(12, 1, 0, 15, 180)
	_SE_PLAY('S_FI229')
	_TIME_WAIT(110, @SCWK_ANSWER)
	_OBJ_ANIME('HERO', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_face')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_10', 'Has it stopped?\rAre all of you unharmed?\rLet’s go outside—but be careful. I’m concerned\nabout the city.')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('HERO')
	_OBJ_ANIME('C02R0103_SUPPORT', 'anm_c02r0103_support_01')
	_OBJ_ANIME('C02R0103_RIVAL', 'anm_c02r0103_rival_02')
	_OBJ_ANIME('C02R0103_DOCTOR', 'anm_c02r0103_doctor_06')
	_DUMMY_ANIME('anm_c02r0103_dummy_02')
	_OBJ_ANIME_WAIT()
	_DUMMY_ANIME_WAIT()
	_OBJ_DEL('C02R0103_RIVAL')
	_OBJ_DEL('C02R0103_SUPPORT')
	_CAMERA_TARGET_HERO()
	_CHARA_LOOK_LOCK('C02R0103_DOCTOR', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C02R0103_DOCTOR')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_doctor_11', '{1,1,0,0}, hurry along. But beware\nof aftershocks.', 0, 1)
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('C02R0103_DOCTOR')
	_CHARA_LOOK_RELEASE('HERO')
	_SE_STOP('UI_COMMON_SELECT')
	_OBJ_ANIME('C02R0103_DOCTOR', 'anm_c02r0103_doctor_07')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C02R0103_DOCTOR')
	_SE_STOP('S_FI001')
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 8800)
	_LDVAL(@WK_SCENE_C02, 4)
	_LDVAL(@WK_SCENE_C02R0103, 2)
	_FLAG_SET(#FE_L02_NEWS)
	_FLAG_SET(#FV_L02_GINGAM)
	_FLAG_RESET(#FV_C02_DOCTOR)
	_FLAG_RESET(#FV_C02_SUPPORT)
	_FLAG_RESET(#FV_C02_RIVAL)
	_TALK_END()
	_END()
