	_ACMD_END()
anm_c02r0103_support_400:
	_AC_DIR_U(8)
	_ACMD_END()
ev_c02r0103_assistantw:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02r0103_assistantw_02')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_assistantw_01_1', 'Every book contains someone’s memories of\nvarious places and times.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_assistantw_01_2', 'Libraries aren’t just buildings where books are\nkept, you know.\rThey’re where different places and times are\ngathered together.', 1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0103_assistantw_02:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_assistantw_02', 'W—was that an earthquake? I didn’t imagine it?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0103_boy2:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_L02_NEWS, 'ev_c02r0103_boy2_02')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_boy2_01', 'Someone’s always checked out the book I want\nto read.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0103_boy2_02:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_boy2_02', 'I’m feeling wobbly...\rEven though the tremor has ended, my knees still\nfeel like jelly.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c02r0103_books1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books1_01', 'This book is titled “Sinnoh Myth.” Would you like\nto read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_books1_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books1_02')
	_END()
c02r0103_books1_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books1_02', 'You put the book back.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
c02r0103_books1_03:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books1_03_1', '“Sinnoh Myth”\rBetray not your anger, lest ??? will come.\rWeep not with sorrow, or ??? will draw near.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books1_03_2', 'When joy and enjoyment come as natural as the\nvery air, that is happiness.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books1_03_3', 'Let such be blessed by the hand of Master ???.\rIt was a custom to speak those words.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books2:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books2_01', 'This book is titled “Sinnoh Region’s Mythology.”\nWould you like to read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_books2_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books2_02')
	_END()
c02r0103_books2_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books2_02', 'You put the book back.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
c02r0103_books2_03:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books2_03_1', '“Sinnoh Region’s Mythology”\rLong ago, when Sinnoh had just been made,\nPokémon and humans led separate lives.\rThat is not to say they did not help each other.\nNo, indeed they did.\rThey supplied each other with goods, and\nsupported each other.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books2_03_2', 'A Pokémon proposed to the others to always be\nready to help humans.\rIt asked that Pokémon be ready to appear\nbefore humans—always.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books2_03_3', 'Thus, to this day, Pokémon appear to us if we\nventure into tall grass.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books3:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books3_01', 'This book is titled “Sinnoh’s Myth.” Would you\nlike to read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_books3_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books3_02')
	_END()
c02r0103_books3_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books3_02', 'You put the book back.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
c02r0103_books3_03:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books3_03_1', '“Sinnoh’s Myth”\rThree Pokémon there were.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books3_03_2', 'Into the lakes they dove.\nDeep, deep, drawing no breath.\rDeeper, deeper they dove.\nInto suffocating depths they dove.\rDeeper, then deepest they alight.\nFrom the lake floor they rise.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books3_03_3', 'Bearing with them the power to make vast lands,\nthey rise again.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books4:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_01', 'This book is titled “Veilstone’s Myth.” Would you\nlike to read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_books4_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books4_02')
	_END()
c02r0103_books4_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_02', 'You put the book back.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
c02r0103_books4_03:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_03_1', '“Veilstone’s Myth”\rA young man, callow and foolish in innocence,\ncame to own a sword.\rWith it, he smote Pokémon, which gave\nsustenance, with carefree abandon.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_03_2', 'Those not taken as food, he discarded, with\nno afterthought.\rThe following year, no Pokémon appeared.\nLarders grew bare.\rWould you like to keep reading?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books4_02')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_04_1', 'The young man, seeking the missing Pokémon,\njourneyed afar.\rLong did he search. And far and wide, too, until\none he did find.\rAsked he, “Why do you hide?”', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_04_2', 'To which the Pokémon replied...\r“If you bear your sword to bring harm upon us,\nwith claws and fangs, we will exact a toll.\r“From your kind we will take our toll, for it must\nbe done.”', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_04_3', '“Done it must be to guard ourselves and for it,\nI apologize.”\rWould you like to keep reading?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books4_02')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_05_1', 'To the skies, the young man shouted his dismay.\r“In having found the sword, I have lost so much.\r“Gorged with power, I grew blind to Pokémon\nbeing alive.”', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_05_2', '“I will never fall savage again. This sword I\ndenounce and forsake.\r“I plead for forgiveness, for I was but a fool.”', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books4_05_3', 'So saying, the young man hurled the sword to the\nground, snapping it.\rSeeing this, the Pokémon disappeared to a place\nbeyond seeing.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books5:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_01', 'This ancient book is titled “The Original Story.”\nWould you like to read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_books5_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books5_02')
	_END()
c02r0103_books5_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_02', 'You put the book back.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
c02r0103_books5_03:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_03_1', 'In the beginning, there was only a churning\nturmoil of chaos.\rAt the heart of chaos, where all things became\none, appeared an Egg.')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_03_2', 'Having tumbled from the vortex, the Egg gave\nrise to the Original One.\rWould you like to keep reading?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books5_02')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_04_1', 'From itself, two beings the Original One\ndid make.\rTime started to spin. Space began to expand.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_04_2', 'From itself again, three living things the\nOriginal One did make.\rWould you like to keep reading?', 1)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books5_02')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books5_05', 'The two beings wished, and from them, matter\ncame to be.\rThe three living things wished, and from them,\nspirit came to be.\rThe world created, the Original One took to\nunyielding sleep.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books6:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books6_01', 'This book is titled “A Horrific Myth.”\nWould you like to read it?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'c02r0103_books6_03')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'c02r0103_books6_02')
	_END()
c02r0103_books6_02:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books6_02', 'You put the book back.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
c02r0103_books6_03:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books6_03_1', 'Look not into the Pokémon’s eyes.\rIn but an instant, you’ll have no recollection of\nwho you are.\rReturn home, but how? When there is nothing\nto remember?')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books6_03_2', 'Dare not touch the Pokémon’s body.\rIn but three short days, all emotions will\ndrain away.\rAbove all, above all, harm not the Pokémon.\rIn a scant seven days, the offender will grow\nimmobile in entirety.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books7:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_01', 'This book is titled “Sinnoh Folk Stories.”')
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_02', 'Which story would you like to read?', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_260', 0)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_261', 1)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_262', 2)
	_ADD_CUSTUM_WIN_LABEL('dp_options%DP_options_263', 3)
	_OPEN_CUSTUM_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c02r0103_books7_1')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c02r0103_books7_2')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c02r0103_books7_3')
	_JUMP('ev_c02r0103_books7_cancel')
	_END()
ev_c02r0103_books7_1:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_04_1', '“Sinnoh Folk Story 1”\rPick clean the bones of Pokémon caught in the\nsea or stream.\rThank them for the meals they provide, and pick\ntheir bones clean.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_04_2', 'When the bones are as clean as can be, set them\nfree in the water from which they came.\rThe Pokémon will return, fully fleshed, and it\nbegins anew.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books7_2:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_05_1', '“Sinnoh Folk Story 2”\rThere lived a Pokémon in a forest.', 1)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_05_2', 'In the forest, the Pokémon shed its hide to sleep\nas a human.\rAwakened, the human dons the Pokémon hide to\nroam villages.', 1)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books7_3:
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_06', '“Sinnoh Folk Story 3”\rThere once were Pokémon that became very\nclose to humans.\rThere once were humans and Pokémon that ate\ntogether at the same table.\rIt was a time when there existed no differences\nto distinguish the two.')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_books7_cancel:
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c02r0103', '167-msg_c02r0103_books7_03', 'You put the book back.')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c02r0103_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c02r0103', '167-msg_c02r0103_poster_01', 'On this floor, you will find many books on the\nmyths and legends of the Sinnoh region.')
	_END()