door_exit_simple:
	_FADE_BUILDING_IN()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_SUB_WK(@SCWK_TEMP1, 2)
	_SXY_POS_CHANGE('HERO', @SCWK_TEMP0, @SCWK_TEMP1)
	_DOOR_FORCE_ANIME_END(0)
	_OBJ_ANIME('HERO', 'anm_exit_common_down')
	_TIME_WAIT(8, @SCWK_ANSWER)
	_HIT_DOOR_ANIME(1)
	_HIT_DOOR_ANIME_WAIT()
	_SE_PLAY('S_FI013')
	_CAMERA_TARGET_HERO()
	_GET_NOW_ZONE_ID(@SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 429, 'ev_stop_door_out3')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 422, 'ev_stop_door_hat_time')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 110, 'ev_stop_door_pastoria_event')
	_END()
ev_stop_door_hat_time:
	_IFVAL_JUMP(@WK_SCENE_T01R0201, 'EQ', 6, 'ev_stop_door_out_set')
	_END()
ev_door_end:
	_END()
ev_stop_door_pastoria_event:
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'NE',  589, 'ev_door_end')
	_IFVAL_JUMP(@SCWK_TEMP0, 'NE',  828, 'ev_door_end')
	_IFVAL_JUMP(@WK_SCENE_C06, 'NE',  1, 'ev_door_end')
	_IF_FLAGON_JUMP(#2545, 'ev_door_end')
	_CALL('ev_block_doc')
	_END()
