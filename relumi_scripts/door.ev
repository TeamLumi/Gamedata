	_FLAG_RESET(#3008); Blastoise
	_FLAG_RESET(#2542); Gengar
	_FLAG_SET(#2587)
	_RET()
ev_healthcheck_add_missing_boss_items:
	_IF_FLAGON_CALL(#FE_D17R0104_LEGEND_CLEAR, 'ev_healthcheck_check_gris_orb')
	_IF_FLAGON_CALL(#FE_D16R0103_LEGEND_CLEAR, 'ev_healthcheck_check_magma_stone')
	_RET()
ev_healthcheck_check_gris_orb:
	_IF_FLAGON_JUMP(#2588, 'ev_healthcheck_return')
	_ITEM_CHK(112, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GT', 0, 'ev_healthcheck_return')
	_ADD_ITEM(112, 1, @SCWK_ANSWER); If no, give one
	_FLAG_SET(#2588)
	_RET()
ev_healthcheck_check_magma_stone:
	_IF_FLAGON_JUMP(#2589, 'ev_healthcheck_return')
	_ITEM_CHK(458, 1, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GT', 0, 'ev_healthcheck_return')
	_ADD_ITEM(458, 1, @SCWK_ANSWER); If no, give one
	_FLAG_SET(#2589)
	_RET()
ev_healthcheck_infinite_repel_check:
	_ITEM_CHK(1303, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_healthcheck_add_infinite_repel')
	_RET()
ev_healthcheck_add_infinite_repel:
	_ADD_ITEM(1303, 1, @SCWK_ANSWER); Add Infinite Repel
	_RET()