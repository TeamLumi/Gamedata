	_SYS_FLAG_BADGE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 5, 'ev_healthcheck_return'); If the player has not enough badges, return
	_IF_FLAGON_JUMP(#2758, 'ev_healthcheck_return'); If the player has fixed the Pastoria event, return
	_FLAG_SET(#2750); Set Pastoria event flag
	_RET()
