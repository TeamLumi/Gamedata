ev_healthcheck_bad_items:
	_LDVAL(@SCWK_TEMP0, 467);Check for dupe secret key
	_GET_ITEM_COUNT(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GT', 1, 'ev_healthcheck_bad_items_remove')
	_LDVAL(@SCWK_TEMP0, 450); Check for dupe bikes
	_GET_ITEM_COUNT(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GT', 1, 'ev_healthcheck_bad_items_remove')
	_LDVAL(@SCWK_TEMP0, 872); Check for bad secret key
	_GET_ITEM_COUNT(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'GE', 1, 'ev_healthcheck_bad_items_remove')
	_RET()
ev_healthcheck_bad_items_remove:
	_LDVAL(@SCWK_TEMP1, @SCWK_ANSWER); Load count into temp1
	_SUB_WK(@SCWK_TEMP1, 1); Subtract 1 from count
	_SUB_ITEM(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER); Subtract all but one of the items
	_RET()
ev_healthcheck_fix_portable_pc:
	_IFVAL_JUMP(@TOWNMAP_GUIDE_SEQUENCE, 'LT', 3500, 'ev_healthcheck_return'); If the player has not spoken to Bebe, return.
	_RESET_SYS_FLAG($SYS_BOX_SYSTEM_OFF)
	_RET()
