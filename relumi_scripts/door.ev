ev_healthcheck:
	_CALL('ev_healthcheck_fix_pastoria_event'); Make sure the Pastoria event is accurate.
	_CALL('ev_healthcheck_reset_mew_event'); Reset the whole Mew event once per save.
	_CALL('ev_healthcheck_fix_ball_capsules'); Fix Ball Capsule bug
	_CALL('ev_healthcheck_fix_eterna_city'); Set new Eterna events as complete if trainer is post-Eterna
	_CALL('ev_healthcheck_enforce_double_battles_off'); Make sure double battle flag is off
	_CALL('ev_healthcheck_enable_iv_judge'); Make sure IV judge is enabled
	_CALL('ev_healthcheck_fix_mira_event'); Fix Mira event blocker.
	_CALL('ev_healthcheck_fix_c01_looker'); Fix old saves' Jubilife Looker visibility
	_CALL('ev_healthcheck_fix_dialga_palkia_sp'); Fix Dialga/Palkia hanging about
	_CALL('ev_healthcheck_fix_d09_blocker'); Fix fat man blocking path
	_CALL('ev_healthcheck_c06_hide_grunts'); Hide Spare grunts in C06
	_CALL('ev_healthcheck_check_poketch_apps'); Try to fix player poketch apps
	_CALL('ev_healthcheck_fix_mansion_event'); End the mansion event if the user is past it.
	_CALL('ev_healthcheck_sunnyshore_fix'); Update Sunnyshore flags
	_CALL('ev_healthcheck_orebourgh_boy_fix'); Update the boy to not stop the champ.
	_CALL('ev_healthcheck_fix_l01_entrance'); Fix L01 entrance value for older saves
	_CALL('ev_healthcheck_canalave_advicedude_fix'); Fix Canalave man
	_CALL('ev_healthcheck_victoryroad_stopper_fix'); Fix Victory Road stoppers
	_CALL('ev_healthcheck_fix_mtcoronet_looker')
	_CALL('ev_healthcheck_check_spear_shaymin'); Fix Shaymin Spear Pillar scene
	_CALL('ev_healthcheck_give_incense_burner'); Add the incense burner
	_CALL('ev_healthcheck_enable_flowers'); correct the flags
	_CALL('ev_healthcheck_check_hisui_flowers'); Check Hisui flower status
	_CALL('ev_healthcheck_c05_blockers')
	_CALL('ev_healthcheck_fix_barry_fight_flag')
	_CALL('ev_healthcheck_check_c10_shaymin_event')
	_CALL('ev_healthcheck_form_shuffle_flag_reset'); Reset events
	_CALL('ev_healthcheck_add_missing_boss_items'); Check for missing Griseous Orb and Magma Stone
	_CALL('ev_healthcheck_infinite_repel_check'); Add infinite repel
	_RET()
ev_healthcheck_return:
	_RET(); Helper function to early return
ev_healthcheck_check_c10_shaymin_event:
	_IFVAL_JUMP(@WK_SCENE_C10R0101, 'EQ', 0, 'ev_healthcheck_return')
	_IFVAL_JUMP(@469, 'EQ', 1, 'ev_healthcheck_return')
	_LDVAL(@469, 1); Shaymin event should have already happened
	_ITEM_CHK(466, 1, @SCWK_ANSWER); Does player have Gracidea
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_healthcheck_return')
	_ADD_ITEM(466, 1, @SCWK_ANSWER); If no, give one
	_RET()
ev_healthcheck_fix_barry_fight_flag:
	_IF_FLAGOFF_JUMP(#2547, 'ev_healthcheck_return')
	_FLAG_RESET(#2547)
	_RET()
ev_healthcheck_check_spear_shaymin:
	_IF_FLAGOFF_JUMP(#1618, 'ev_healthcheck_return'); If player has not unlocked Kakure road, return
	_IFVAL_JUMP(@468, 'GT', 0, 'ev_healthcheck_return')
	_LDVAL(@468, 1)
	_FLAG_SET(#2727); Kill the trigger of odd scene
	_FLAG_SET(#2826)
	_FLAG_SET(#2827)
	_RET()
ev_healthcheck_c05_blockers:
	_SYS_FLAG_BADGE_GET($BADGE_ID_C05, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_healthcheck_return')
	_FLAG_SET(#FV_C05_STOPPER)
	_RET()
ev_healthcheck_check_hisui_flowers:
	_IFVAL_JUMP(@468, 'EQ', 0, 'ev_healthcheck_return')
	_IF_FLAGON_JUMP(#2564, 'ev_healthcheck_return')
	_FLAG_SET(#2564); Enable the Hisui flower
	_RET()
ev_healthcheck_enable_flowers:
	_IF_FLAGON_JUMP(#2566, 'ev_healthcheck_return'); If done before, go home
	_LDVAL(@485, 0); My check = 0;
	_IF_FLAGON_CALL(#2561, 'ev_healthcheck_enable_flowers_add_unova_modifier')
	_IF_FLAGON_CALL(#2562, 'ev_healthcheck_enable_flowers_add_kalos_modifier')
	_IF_FLAGON_CALL(#2563, 'ev_healthcheck_enable_flowers_add_alola_modifier')
	_IF_FLAGON_CALL(#2565, 'ev_healthcheck_enable_flowers_add_galar_modifier')
	_IFVAL_JUMP(@485, 'EQ', 15, 'ev_healthcheck_return'); If A + B + C + D, go home
	_JUMP('ev_healthcheck_check_flowers')
ev_healthcheck_check_flowers:
	_IFVAL_JUMP(@WK_SCENE_D27R0101, 'EQ', 0, 'ev_healthcheck_return'); Hasn't progressed enough
	_IFVAL_CALL(@485, 'EQ', 0, 'ev_healthcheck_enable_unova_flower'); Hasn't chosen a flower
	_IFVAL_JUMP(@WK_SCENE_C05_JUDGE, 'EQ', 0, 'ev_healthcheck_return'); Hasn't progressed enough
	_IFVAL_CALL(@485, 'EQ', 1, 'ev_healthcheck_enable_kalos_flower'); If has only chosen A, enable B
	_IFVAL_CALL(@485, 'EQ', 2, 'ev_healthcheck_enable_unova_flower'); If has only chosen B, enable A
	_IFVAL_CALL(@485, 'EQ', 4, 'ev_healthcheck_enable_kalos_flower'); If has only chosen C, enable B
	_IFVAL_CALL(@485, 'EQ', 8, 'ev_healthcheck_enable_kalos_flower'); If has only chosen D, enable B
	_IFVAL_JUMP(@WK_SCENE_C06, 'LT', 4, 'ev_healthcheck_return'); Hasn't progressed enough
	_IFVAL_CALL(@485, 'EQ', 3, 'ev_healthcheck_enable_alola_flower'); If A + B, enable C
	_IFVAL_CALL(@485, 'EQ', 5, 'ev_healthcheck_enable_kalos_flower'); If A + C, enable B
	_IFVAL_CALL(@485, 'EQ', 6, 'ev_healthcheck_enable_unova_flower'); If B + C, enable A
	_IFVAL_CALL(@485, 'EQ', 9, 'ev_healthcheck_enable_kalos_flower'); If A + D, enable B
	_IFVAL_CALL(@485, 'EQ', 10, 'ev_healthcheck_enable_unova_flower'); If B + D, enable A
	_IFVAL_CALL(@485, 'EQ', 12, 'ev_healthcheck_enable_unova_flower'); If C + D, enable A
	_IFVAL_JUMP(@469, 'EQ', 0, 'ev_healthcheck_return'); Hasn't progressed enough
	_IFVAL_CALL(@485, 'EQ', 7, 'ev_healthcheck_enable_galar_flower'); If A + B + C, enable D
	_IFVAL_CALL(@485, 'EQ', 11, 'ev_healthcheck_enable_alola_flower'); If A + B + D, enable C
	_IFVAL_CALL(@485, 'EQ', 13, 'ev_healthcheck_enable_kalos_flower'); If A + C + D, enable B
	_IFVAL_CALL(@485, 'EQ', 14, 'ev_healthcheck_enable_unova_flower'); If B + C + D, enable A
	_FLAG_SET(#2566); Performed this check
	_RET()
ev_healthcheck_enable_unova_flower:
	_FLAG_SET(#2561)
	_ADD_WK(@485, 1)
	_RET()
ev_healthcheck_enable_kalos_flower:
	_FLAG_SET(#2562)
	_ADD_WK(@485, 2)
	_RET()
ev_healthcheck_enable_alola_flower:
	_FLAG_SET(#2563)
	_ADD_WK(@485, 4)
	_RET()
ev_healthcheck_enable_galar_flower:
	_FLAG_SET(#2565)
	_ADD_WK(@485, 8)
	_RET()
