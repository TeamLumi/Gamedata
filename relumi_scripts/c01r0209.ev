ev_c01r0209_gakubuchi_open1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0209', 'msg_c01r0209_gakubuchi_open1', 'Cynthia presses every advantage to go for\ntotal victory!\rAlmost peerless, Cynthia conducts battles like\na virtuoso performer.')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_CHAMPION_01')
	_LDVAL(@LOCALWORK1, 12)
	_JUMP('ev_c01r0209_gakubuchi_open_main_01')
	_END()
ev_c01r0209_gakubuchi_open2:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0209', 'msg_c01r0209_gakubuchi_open2', 'Aaron climbed up the rankings to the Elite\nFour!\rHe once shared a title as bug Gym Leader.\nNow he’s “Elite!”')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_BIGFOUR1_01')
	_LDVAL(@LOCALWORK1, 8)
	_JUMP('ev_c01r0209_gakubuchi_open_main_02')
	_END()
ev_c01r0209_gakubuchi_open3:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0209', 'msg_c01r0209_gakubuchi_open3', 'Bertha keeps trainers down to earth!\rShe helps keep soil healthy when challengers\nare scarce.')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_BIGFOUR2_01')
	_LDVAL(@LOCALWORK1, 9)
	_JUMP('ev_c01r0209_gakubuchi_open_main_02')
	_END()
ev_c01r0209_gakubuchi_open4:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0209', 'msg_c01r0209_gakubuchi_open4', 'Flint’s burning passion keeps things hot!\rHis rivalry with Volkner drives them both\nforward!')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_BIGFOUR3_01')
	_LDVAL(@LOCALWORK1, 10)
	_JUMP('ev_c01r0209_gakubuchi_open_main_02')
	_END()
ev_c01r0209_gakubuchi_open5:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0209', 'msg_c01r0209_gakubuchi_open5', 'Lucian reads the future on his opponent’s face!\rWhen he’s got time off, he’s always at\nCanalave Library.')
	_SPEAKERS_NAME(0, '%DP_Trainers_Name_TR_BIGFOUR4_01')
	_LDVAL(@LOCALWORK1, 11)
	_JUMP('ev_c01r0209_gakubuchi_open_main_02')
	_END()
ev_c01r0209_gakubuchi_open_main_01:
	_MACRO_TALKMSG('dialogue_c01r0209', '39-msg_c01r0209_clip_gaku_b', 'Would you like to try the same Capsule\nDecoration as Champion Cynthia?')
	_JUMP('ev_c01r0209_gakubuchi_open_main_03')
	_END()
ev_c01r0209_gakubuchi_open_main_02:
	_MACRO_TALKMSG('dialogue_c01r0209', '39-msg_c01r0209_clip_gaku_a', 'Would you like to try the same Capsule\nDecoration as {0} of the Elite Four?')
	_JUMP('ev_c01r0209_gakubuchi_open_main_03')
	_END()
ev_c01r0209_gakubuchi_open_main_03:
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c01r0209_gakubuchi_end')
	_TALK_CLOSE()
	;_CUSTOM_BALL_TRAINER_PAGE(@LOCALWORK1, @SCWK_ANSWER); Commented out to so that we can remove some very large images from texturemass
	;_CUSTOM_BALL_TRAINER_PAGE_WAIT()
	;_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0205_gakubuchi_deco_main')
	_CUSTOM_BALL_TRAINER_COPY_OPEN(@LOCALWORK1, @SCWK_ANSWER)
	_CUSTOM_BALL_TRAINER_PAGE_WAIT()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c01r0205_gakubuchi_deco_main')
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c01r0209_gakubuchi_end:
	_TALK_CLOSE()
	_TALK_END()
	_END()