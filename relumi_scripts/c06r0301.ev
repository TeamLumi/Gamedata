ev_c06r0301_oldman:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_oldman2_01', 'Hmmm... Burmy are an interesting example.\rThey hint at how the environment can shape\npeople’s personalities.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06r0301_oldlady:
    _TALK_OBJ_START()
    _IF_FLAGON_JUMP(#2407, 'ev_c06r0301_oldlady_done')
    _MACRO_TALKMSG('dialogue_c06r0301', '18-msg_c06r0301_oldlady_01', 'Oh, hello there! Would you like to hear a story\nfrom a weary, old soul?')
    _YES_NO_WIN(@SCWK_ANSWER)
    _IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06r0301_oldlady_no')
    _MACRO_TALKMSG('dialogue_c06r0301', '18-msg_c06r0301_oldlady_03', 'Oh, wonderful! Well, it all started when I was\nabout your age.\rI’d just started my own Pokémon\njourney and encountered the most beautiful\fPokémon...')
    _TALK_CLOSE()
    _BLACK_OUT('SCR_WIPE_DIV', 3)
    _FADE_WAIT()
    _TIME_WAIT(30, @SCWK_ANSWER)
    _BLACK_IN('SCR_WIPE_DIV', 3)
    _FADE_WAIT()
    _MACRO_TALKMSG('dialogue_c06r0301', '18-msg_c06r0301_oldlady_04', '...and finally, you showed up!\rSo you see, you’re the perfect trainer to show\nmy Lapras a brand new adventure.\rI know you’ll take great care of it.')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_c06r0301_oldlady_no_tray_space'); Party and Boxes are full
    _POKEMON_NAME_EXTRA(1, 131, 0, 0)
    _SE_PLAY('M_FI013')
    _MACRO_TALKMSG('dialogue_c06r0301', '18-msg_allpurpose_poke_rcv', 'You received {1,1,1,0}!')
    _ME_WAIT()
    _ADD_POKEMON_UI_EXTRA(131, 0, 35, 0, 3, 22); MonsNo, FormNo, Level, Item, MaxIVs, BallId
    _FLAG_SET(#2407)
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c06r0301_oldlady_no:
    _MACRO_TALKMSG('dialogue_c06r0301', '18-msg_c06r0301_oldlady_02', 'Oh... That’s alright. It is quite a long story.\nDo let me know if you change your mind.')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c06r0301_oldlady_no_tray_space:
    _MACRO_TALKMSG('dialogue_c06r0301', 'msg_c06r0301_oldlady_no_tray_space', 'Oh... But you have no room for my dear\nLapras...')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c06r0301_oldlady_done:
    _MACRO_TALKMSG('dialogue_c06r0301', '18-msg_c06r0301_oldlady_05', 'Please be kind to my Lapras.')
    _TALK_CLOSE()
    _TALK_OBJ_END()
    _END()
ev_c06r0301_minomutti_item_get:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C06R0301_ITEM_GET, 'ev_minomutti_item_get_end')
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_boy3_01', 'You know about Burmy and how they come in\ndifferent forms?\rDo you have all forms of that there Burmy?')
	_CHECKMINOMUCHICOMP(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_minomutti_no_get')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_minomutti_no_comp')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_minomutti_no_comp')
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_boy3_04', 'Cool! That’s all the different kinds of Burmy!\nI feel giddy!\rSince I feel so giddy, take this! Go ahead, take it!')
	_LDVAL(@SCWK_TEMP0, 215)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_minomutti_item_noget')
	_FLAG_SET(#FE_C06R0301_ITEM_GET)
	_CALL('ev_item_event')
	_JUMP('ev_minomutti_item_get_end')
	_END()
ev_minomutti_no_get:
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_boy3_02', 'Aww, you don’t even have a single Burmy? You\ndon’t like ’em? They’re kind of mooshy and cute!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_minomutti_no_comp:
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_boy3_03', 'Hmm... It’d be cool if you had all the\ndifferent-looking Burmy.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_minomutti_item_noget:
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_boy3_05', 'Whoops, your Bag is crammed full! I’ll give this\nto you later.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_minomutti_item_get_end:
	_MACRO_TALKMSG('dialogue_c06r0301', '126-msg_c06r0301_boy3_06', 'You’re good! You’d make an awesome\nBug Maniac!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()