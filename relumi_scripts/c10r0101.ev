	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 804)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 805)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 806)
	_RET()
ev_c10r0101_randomteam_barry_piplup:
	_GET_RND(@SCWK_ANSWER, 4)
	_LDVAL(@SCWK_TEMP3, 807)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 808)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 809)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_common_return')
	_LDVAL(@SCWK_TEMP3, 810)
	_RET()
ev_c10r0101_rival_01:
	_CALL('ev_c10r0101_randomteam_barry_piplup')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_JUMP('ev_c10r0101_rival_btl_coomon')
	_JUMP('ev_c10r0101_rival_btl_coomon')
ev_c10r0101_rival_02:
	_CALL('ev_c10r0101_randomteam_barry_turtwig')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_JUMP('ev_c10r0101_rival_btl_coomon')
	_JUMP('ev_c10r0101_rival_btl_coomon')
ev_c10r0101_rival_03:
	_CALL('ev_c10r0101_randomteam_barry_chimchar')
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_JUMP('ev_c10r0101_rival_btl_coomon')
	_JUMP('ev_c10r0101_rival_btl_coomon')
ev_c10r0101_rival_btl_coomon:
	_IF_FLAGON_CALL(#FE_PLAY_REPO, 'ev_to_write_play_repo')
	_OBJ_ADD('C10R0101_RIVAL')
	_OBJ_ADD('C10R0101_VETERAN2')
	_FLAG_RESET(#FV_C10R0101_VETERAN2)
	_FLAG_SET(#FV_C10R0101_VETERAN1)
	_OBJ_DEL('C10R0101_VETERAN1')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_rival_02_1', 'I guess I’m not ready for the Pokémon League if\nI’m losing to you! Darn it!\rJust you wait! I’ll get tougher and win my way\nthrough the Pokémon League!')
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_rival_02_2', 'Because I’m going to become the toughest\nPokémon Trainer there is—the Champion!\r{1,1,0,0}! You’d better not lose to\nanyone before me!')
	_TALK_CLOSE()
	_LDVAL(@WK_SCENE_C10R0101, 1)
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 10, 'ev_c10r0101_rival_x11')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 11, 'ev_c10r0101_rival_x12')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 12, 'ev_c10r0101_rival_x13')
	_END()
ev_c10r0101_rival_x11:
	_OBJ_ANIME('C10R0101_RIVAL', 'anm_c10r0101_rival_11')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_rival_11')
	_JUMP('common_c10r0101_rival_11')
ev_c10r0101_rival_x12:
