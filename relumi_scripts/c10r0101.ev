	_AC_DIR_U(4)
	_AC_UP(3, 4)
	_AC_DIR_R(4)
	_AC_RIGHT(1, 4)
	_AC_DIR_U(4)
	_AC_UP(3, 4)
	_ACMD_END()
anm_c10r0101_rival_11:
