	_AC_DOWN(3, 4)
	_AC_DIR_L(4)
	_AC_LEFT(1, 4)
	_AC_DIR_D(4)
	_AC_DOWN(3, 4)
	_ACMD_END()
ev_c10r0101_woman3:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_woman3_01', 'It doesn’t matter if the gain is slow.\rNor does it matter how many challenges\nit takes.\rI’m never giving up!\nNot until I beat the Elite Four!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0101_man1:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_man1_01', 'What is the Pokémon League?\nDon’t take my word for it.\rTake the challenge and experience it\nfor yourself!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0101_tmhandler:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#3001, 'ev_c10r0101_tmhandler_no')
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_tmhandler_01', 'Hello, strong Trainer!\rI am the Technical Machine collector!\nI’ve got all the TMs you’ll ever need.\rDo you need me to give you a full use\nset of every Technical Machine?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c10r0101_tmhandler_yes')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c10r0101_tmhandler_no')
	_TALK_CLOSE()
	_END()
ev_c10r0101_tmhandler_yes:
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_tmhandler_01_yes', 'Excellent! Here I go, then.\rPlease be patient.\nThis may take a moment...')
	;Starting ID
	_LDVAL(@SCWK_PARAM0, 328)
	;Last ID to give
	_LDVAL(@SCWK_PARAM1, 427)
	;Will give TMs from ID 328 to 427
	_CALL('ev_c10r0101_tm_handler_loop')
	;Starting ID
	_LDVAL(@SCWK_PARAM0, 2161)
	;Last ID to give
	_LDVAL(@SCWK_PARAM1, 2210)
	;Will give TMs from ID 2161 to 2210
	_CALL('ev_c10r0101_tm_handler_loop')
	;Received item sound
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_tmhandler_loop_end', 'You have received all TMs.')
	;The last message is the same, so it can be reused
	_JUMP('ev_c10r0101_tmhandler_no')
	_END()
ev_c10r0101_tm_handler_loop:
	;Manually add delay. _ADD_ITEM won't work without it.
	_TIME_WAIT(1, @SCWK_TEMP1)
	;Give the TM
	_ADD_ITEM(@SCWK_PARAM0, 1, @SCWK_ANSWER)
	;Next TM id
	_ADD_WK(@SCWK_PARAM0, 1)
	_IFVAL_JUMP(@SCWK_PARAM0, 'LE', @SCWK_PARAM1, 'ev_c10r0101_tm_handler_loop')
	_RET()
ev_c10r0101_tmhandler_no:
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_tmhandler_01_no', 'Alright. Come back again!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0101_pcwoman1:
	_JUMP('ev_heal_p01')
	_END()