	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_rival_11')
	_JUMP('common_c10r0101_rival_11')
ev_c10r0101_rival_x13:
	_OBJ_ANIME('C10R0101_RIVAL', 'anm_c10r0101_rival_13')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_rival_11')
	_JUMP('common_c10r0101_rival_11')
common_c10r0101_rival_11:
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C10R0101_RIVAL')
	_SE_WAIT('S_FI001')
	_LDVAL(@WK_SCENE_C10R0101, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 11900)
	_TALK_END()
	_EVENT_CAMERA_INDEX(462)
	_EVENT_CAMERA_END_WAIT()
	_END()
anm_c10r0101_player_01:
	_AC_DIR_D(8)
	_ACMD_END()
anm_c10r0101_rival_01:
	_AC_DIR_U(4)
	_AC_UP(3, 4)
	_AC_DIR_L(4)
	_AC_LEFT(1, 4)
	_AC_DIR_U(4)
	_AC_UP(3, 4)
	_ACMD_END()
anm_c10r0101_rival_02:
	_AC_DIR_U(4)
	_AC_UP(6, 4)
	_ACMD_END()
