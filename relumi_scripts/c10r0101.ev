	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_rival_01')
	_JUMP('ev_c10r0101_rival_btl_coomon')
common_c10r0101_rival_01:
	_OBJ_ANIME('HERO', 'anm_c10r0101_player_01')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_rival_01_1', 'Hold it! Don’t go off without me!\rYou’re challenging the Pokémon League,\naren’t you? That’s why I’m here, too.')
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_rival_01_2', 'Let’s see who’s more worthy of making the\nchallenge with a battle!')
	_TALK_CLOSE()
	_LDVAL(@WK_PLAY_REPO_NO, 20)
	_FLAG_SET(#FE_PLAY_REPO)
	_RIVAL_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c10r0101_rival_02')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c10r0101_rival_03')
	_JUMP('ev_c10r0101_rival_01')
	_JUMP('ev_c10r0101_rival_btl_coomon')
