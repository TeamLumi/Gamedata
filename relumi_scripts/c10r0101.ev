ev_c10r0101_flag_change:
	_ARRIVE_FLAG_SET('FLAG_ARRIVE_CHAMPLEAGUE')
	_FLAG_SET(#FV_C10R0103_DOOR_01)
	_FLAG_SET(#FV_C10R0105_DOOR_01)
	_FLAG_SET(#FV_C10R0107_DOOR_01)
	_FLAG_SET(#FV_C10R0109_DOOR_01)
	_FLAG_RESET(#FV_C10R0103_DOOR_02)
	_FLAG_RESET(#FV_C10R0105_DOOR_02)
	_FLAG_RESET(#FV_C10R0107_DOOR_02)
	_FLAG_RESET(#FV_C10R0109_DOOR_02)
	_IFVAL_CALL(@WK_SCENE_C10R0101, 'EQ', 0, 'ev_c10r0101_rival_before')
	_IFVAL_CALL(@WK_SCENE_C10R0101, 'GE', 1, 'ev_c10r0101_rival_after')
	_OBJ_DEL('C10R0101_RIVAL')
	_FLAG_RESET(#FE_BIGFOUR1_WIN)
	_FLAG_RESET(#FE_BIGFOUR2_WIN)
	_FLAG_RESET(#FE_BIGFOUR3_WIN)
	_FLAG_RESET(#FE_BIGFOUR4_WIN)
	_FLAG_RESET(#FE_C10R0111_CHAMP_WIN)
	_IF_FLAGON_CALL($SYS_FLAG_WILDCARD_000, 'ev_c10r0101_flag_change_a')
	_IF_FLAGOFF_CALL($SYS_FLAG_WILDCARD_000, 'ev_c10r0101_flag_change_b')
	_IF_FLAGON_JUMP(#FE_C10R0101_VETERAN, 'ev_c10r0101_flag_change_pos')
	_END()
ev_c10r0101_flag_change_pos:
	_SXY_POS_CHANGE('C10R0101_VETERAN2', 12, 3)
	_OBJ_ADD('C10R0101_VETERAN2')
	_FLAG_RESET(#FV_C10R0101_VETERAN2)
	_FLAG_SET(#FV_C10R0101_VETERAN1)
	_OBJ_DEL('C10R0101_VETERAN1')
	_END()
ev_c10r0101_flag_change_a:
	_FLAG_SET(#FV_STOPPER_FRIENDBOOK)
	_RET()
ev_c10r0101_flag_change_b:
	_FLAG_RESET(#FV_STOPPER_FRIENDBOOK)
	_SXY_EXIT_POS_CHANGE(3, 80, 80)
	_RET()
ev_c10r0101_rival_before:
	_FLAG_SET(#FV_C10R0101_VETERAN2)
	_FLAG_RESET(#FV_C10R0101_VETERAN1)
	_RET()
ev_c10r0101_rival_after:
	_FLAG_SET(#FV_C10R0101_VETERAN1)
	_FLAG_RESET(#FV_C10R0101_VETERAN2)
	_RET()
ev_c10r0101_veteran:
	_TALK_OBJ_START()
	_EVENT_START()
	_IF_FLAGON_JUMP(#FE_C10R0101_VETERAN, 'ev_c10r0101_veteran_02')
	_EVENT_CAMERA_INDEX(463)
	_EVENT_CAMERA_END_WAIT()
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_veteran_01_1', 'Let me confirm that you are qualified to\nchallenge the Pokémon League.\rTo do so, I’ll need to examine the Gym Badges\nyou gathered from around Sinnoh.')
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_veteran_01_2', 'Oreburgh City’s Coal Badge!\nEterna City’s Forest Badge!\fHearthome City’s Relic Badge!\fVeilstone City’s Cobble Badge!')
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_veteran_01_3', 'Pastoria City’s Fen Badge!\nCanalave City’s Mine Badge!\fSnowpoint City’s Icicle Badge!\fAnd finally, Sunyshore City’s Beacon Badge!')
	_TALK_CLOSE()
	_SE_PLAY('M_FI006')
	_ME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 11, 'ev_c10r0101_veteran_dir_up')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 12, 'ev_c10r0101_veteran_dir_left')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 10, 'ev_c10r0101_veteran_dir_right')
	_END()
ev_c10r0101_veteran_dir_up:
	_OBJ_ANIME('C10R0101_VETERAN2', 'anm_c10r0101_veteran_01')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_veteran_dir')
	_JUMP('common_c10r0101_veteran_dir')
ev_c10r0101_veteran_dir_left:
	_OBJ_ANIME('C10R0101_VETERAN2', 'anm_c10r0101_veteran_02')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_veteran_dir')
	_JUMP('common_c10r0101_veteran_dir')
ev_c10r0101_veteran_dir_right:
	_OBJ_ANIME('C10R0101_VETERAN2', 'anm_c10r0101_veteran_03')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c10r0101_veteran_dir')
	_JUMP('common_c10r0101_veteran_dir')
common_c10r0101_veteran_dir:
	_FLAG_SET(#FE_C10R0101_VETERAN)
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_veteran_02', 'Very well!\rTrainer, you’ve indeed collected all the Gym\nBadges of Sinnoh! Demonstrate the power\fthat brought you here, and go for glory!')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(464)
	_EVENT_CAMERA_END_WAIT()
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 12000)
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c10r0101_veteran_02:
	_MACRO_TALKMSG('dialogue_c10r0101', '19-msg_c10r0101_veteran_03', 'Here at the Pokémon League, you will be facing\nthe Elite Four.\rIf you can’t beat all four of them in a row,\nyou’ll have to start from the beginning.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
anm_c10r0101_veteran_01:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_DIR_D(8)
	_ACMD_END()
anm_c10r0101_veteran_02:
	_AC_DIR_L(4)
	_AC_LEFT(1, 8)
	_AC_DIR_R(8)
	_ACMD_END()
anm_c10r0101_veteran_03:
	_AC_DIR_R(4)
	_AC_RIGHT(1, 8)
	_AC_DIR_L(8)
	_ACMD_END()
ev_c10r0101_shop:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_c10r0101_shop_re')
	_END()
ev_c10r0101_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_c10r0101_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_198', 1)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_c10r0101_shop_buy')
	_CASE_JUMP(1, 'ev_c10r0101_shop_sell')
	_CASE_JUMP(2, 'ev_c10r0101_shop_end')
	_JUMP('ev_c10r0101_shop_end')
	_END()
ev_c10r0101_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_c10r0101', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_c10r0101_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 15, 'ev_c10fs0101_01')
	_EVENT_CAMERA_INDEX(300)
	_JUMP('ev_c10fs0101_01a')
	_END()
ev_c10fs0101_01a:
	_EVENT_CAMERA_END_WAIT()
	_DPR_SHOP_OPEN('C10R0101')
	_DPR_SHOP_OPEN_WAIT()
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 15, 'ev_c10fs0101_02')
	_EVENT_CAMERA_INDEX(301)
	_JUMP('ev_c10fs0101_02a')
	_END()
ev_c10fs0101_02a:
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_c10r0101_shop_re')
	_END()
ev_c10fs0101_01:
	_EVENT_CAMERA_INDEX(302)
	_JUMP('ev_c10fs0101_01a')
	_END()
ev_c10fs0101_02:
	_EVENT_CAMERA_INDEX(303)
	_JUMP('ev_c10fs0101_02a')
	_END()
ev_c10r0101_shop_sell:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_SHOP_OPEN_SELL()
	_DPR_SHOP_OPEN_WAIT()
	_JUMP('ev_c10r0101_shop_re')
	_END()
ev_c10r0101_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0101_fix_shop:
	_TALK_OBJ_START()
	_CALL('ev_shop_start_talk')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c10r0101_rival:
	_EVENT_START()
	_FLAG_RESET(#FV_C10R0101_RIVAL)
	_OBJ_ADD('C10R0101_RIVAL')
	_EVENT_CAMERA_INDEX(461)
	_EVENT_CAMERA_END_WAIT()
	_CALL('ev_the_rival_play')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 10, 'ev_c10r0101_rival_x1')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 11, 'ev_c10r0101_rival_x2')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 12, 'ev_c10r0101_rival_x3')
	_END()
ev_c10r0101_rival_x1:
