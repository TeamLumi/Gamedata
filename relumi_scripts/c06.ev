	_AC_MARK_EMO(12)
	_AC_DOWN(1, 4)
	_ACMD_END()
anm_c06_grunt_scared:
	_AC_MARK_GYOE()
	_AC_DOWN(1, 4)
	_ACMD_END()
anm_c06_grunt_runaway:
	_AC_DIR_L(4)
	_AC_WAIT(4)
	_AC_DIR_R(4)
	_AC_WAIT(4)
	_AC_DIR_U(4)
	_ACMD_END()
ev_c06_galactic_bomb_shaymin:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_20', 'Fweh! That was rough.')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_20_1', 'That darn hedgehog took out two of my friends.')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_20_2', 'Luckily I was able to run away while it did so...\nhehehe...')
	_OBJ_ANIME('C06_WAKE2', 'anm_c06_wake_face_player_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_21', 'YOU!\nWhat’ve you done?!')
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_galatic_bomb_grunt_face_shaymin')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_22', 'What’ve I done, you’re asking?\nWell, technically speaking, it wasn’t me.\rThe package that arrived, see, that\nwas a bomb, named the Galactic Bomb.\rMe, I was told to push the button.\nSo I did. Like, “Poink!”\rOh, that’s right! Mustn’t forget!\nThe test results need reporting!')
	_TALK_CLOSE()
	_FLAG_RESET(#2869)
	_OBJ_ADD('C06_SHAYMIN')
	_SE_PLAY('S_FI001')
	_OBJ_ANIME('C06_SHAYMIN', 'anm_c06_shaymin_angry')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(492, 0, 0)
	_CHARA_LOOK_LOCK('C06_SHAYMIN', 'C06_GRUNT2')
	_CHARA_LOOK_LOCK('C06_GRUNT2', 'C06_SHAYMIN')
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_grunt_scared')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_22_1', 'Not that thing again... grr...\nI need to report on the bomb’s success.')
	_CHARA_LOOK_RELEASE('C06_GRUNT2')
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_grunt_runaway')
	_OBJ_ANIME_WAIT()
	_RET()
anm_c06_shaymin_smug:
	_AC_ANIME_DURATION(0.110000)
	_AC_INDEX_ANIME(4, 1)
	_AC_INDEX_ANIME_WAIT()
	_AC_WAIT(16)
	_AC_DIR_U(8)
	_AC_INVISIBLE_ON()
	_ACMD_END()
ev_c06_end_shaymin_and_grunt:
	_CHARA_LOOK_RELEASE('C06_SHAYMIN')
	_OBJ_DEL('C06_GRUNT2')
	_LDVAL(@WK_SCENE_C06, 2)
	_VOICE_PLAY(492, 0, 0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_shaymin_smug', 'The Pokémon is looking very pleased with itself...')
	_OBJ_ANIME('C06_SHAYMIN', 'anm_c06_shaymin_smug')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C06_SHAYMIN')
	_FLAG_SET(#2869)
	_RET()
