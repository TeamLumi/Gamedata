	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C06_BARRY_STARTER3', 'anm_c06_barry_starter_roar')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_VOICE_PLAY(395, 0, 0)
	_VOICE_WAIT()
	_RET()
