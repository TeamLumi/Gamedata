pos_c06_galactic_bomb_stop_data:
	_EVENT_START()
	_JUMP('ev_c06_galactic_bomb')
ev_c06_galactic_bomb_talk_start:
	_TALK_OBJ_START()
	_JUMP('ev_c06_galactic_bomb')
ev_c06_galactic_bomb:
	_HERO_MOVE_GRID_CENTER(0)
	_CALL('ev_c06_galactic_bomb_explosion')
	_SE_PLAY('S_FI001')
	_OBJ_ADD('C06_GRUNT2')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 610, 'ev_c06_galactic_bomb_grunt_appear_2'); Player is in the way and gets pushed out the way and spins
	_IFVAL_CALL(@SCWK_TEMP0, 'NE', 610, 'ev_c06_galactic_bomb_grunt_appear_1')
	_OBJ_ANIME('HERO', 'anm_c06_player_face_down'); Make the player look down after a slight pause after the spin move
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_galatic_bomb_grunt_walk_down')
	_OBJ_ANIME_WAIT()
	_CALL('ev_c06_galactic_bomb_shaymin')
	_OBJ_ANIME('HERO', 'anm_c06_player_face_right')
	_OBJ_ANIME('C06_BARRY2', 'anm_c06_rival_face_right')
	_OBJ_ANIME('C06_WAKE2', 'anm_c06_wake_face_right')
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_galactic_bomb_grunt_escape')
	_OBJ_ANIME_WAIT()
	_CALL('ev_c06_end_shaymin_and_grunt')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_23', 'The Great Marsh is invaluable...')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_CALL(@SCWK_TEMP0, 'EQ', 611, 'ev_c06_wake_player_face_eachother_1')
	_IFVAL_CALL(@SCWK_TEMP0, 'NE', 611, 'ev_c06_wake_player_face_eachother_2')
	_CALL('ev_c06_wake_exit')
	_FLAG_RESET(#2913)
	_FLAG_RESET(#2931)
	_OBJ_ADD('C06_GINGAM_RUNAWAY')
	_OBJ_ADD('C06_BARRY3')
	_FLAG_SET(#2838)
	_OBJ_DEL('C06_BARRY2')
	_LDVAL(@484, 3); Sets the work to 3 for the first Galactic Runaway interactions
	_TALK_OBJ_END()
	_END()
ev_c06_galactic_bomb_explosion:
	_OBJ_ANIME('C06_BARRY2', 'anm_c06_rival_move_up')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_17', 'Hey!\rWhat am I, chopped liver?\nDon’t forget I’m here, too!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c06_player_face_up_1')
	_OBJ_ANIME('C06_WAKE2', 'anm_c06_wake_face_up')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_18', 'So, where’s this Galac...')
	_OBJ_ANIME('C06_BARRY2', 'anm_c06_rival_face_up')
	_OBJ_ANIME_WAIT()
	_CAMERA_SHAKE(12, 1, 0, 15, 180)
	_SE_PLAY('S_FI229')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_19', '<size=250%>DDDOOOMMM!!!</size>')
	_TALK_CLOSE()
	_RET()
ev_c06_galactic_bomb_grunt_appear_1:
	_OBJ_ANIME('C06_WAKE2', 'anm_c06_wake_face_player_1')
	_OBJ_ANIME('HERO', 'anm_c06_player_face_down')
	_OBJ_ANIME('C06_BARRY2', 'anm_c06_rival_face_down')
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_galatic_bomb_grunt_walk_down')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c06_galactic_bomb_grunt_appear_2:
	_OBJ_ANIME('C06_WAKE2', 'anm_c06_wake_face_player_1')
	_OBJ_ANIME('HERO', 'anm_c06_player_pushed')
	_OBJ_ANIME('C06_BARRY2', 'anm_c06_rival_face_down')
	_OBJ_ANIME('C06_GRUNT2', 'anm_c06_galatic_bomb_grunt_walk_down')
	_OBJ_ANIME_WAIT()
	_RET()
