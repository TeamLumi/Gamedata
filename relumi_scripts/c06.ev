ev_c06_flag_change:
	_CALL('ev_box_close')
	_LDVAL(@WK_SAVE_GIMMICK_002, 0); Turns off the water level changes in Pastoria gym
	_LDVAL(@WK_SAVE_GIMMICK_001, 0); Turns off the water level changes in Pastoria gym
	_LDVAL(@473, 0); Stubbed Great Marsh Catch Quest which means you can't exit until you complete the quest.
	_IFVAL_CALL(@501, 'EQ', 2, 'ev_c06_add_rematch_barry'); Player lost to Barry outside of Pastoria Gym
	_SYS_FLAG_BADGE_GET($BADGE_ID_C06, @SCWK_ANSWER); Checks if you have Pastoria Badge upon exiting
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_grunt_removal')
	_IFVAL_CALL(@TOWNMAP_GUIDE_SEQUENCE, 'EQ', 6700, 'ev_c06_guide_upd')
	_END()
ev_c06_add_rematch_barry:
	_FLAG_SET(#2911); Hide Barry if the player lost to him the first time.
	_OBJ_DEL('C06_BARRY')
	_FLAG_RESET(#2912); Add the Barry in front of the Gym to force a rematch.
	_OBJ_ADD('C06_BARRY_LOSE')
	_RET()
ev_c06_grunt_removal:
	_OBJ_DEL('C06_SPARE_GINGAM')
	_OBJ_DEL('C06_GINGAM_SPARE2')
	_FLAG_SET(#2758)
	_RET()
ev_c06_guide_upd:
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6800); Why do we need this?
	; It gets set to 6700 after travelling to Veilstone (c07) for some reason
	_RET()
ev_c06_bigman1:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_bigman1_01', 'Here where I am standing, I’m smack-dab in the\nmiddle of town.')
	_END()
ev_c06_lapras:
	_TALK_OBJ_START()
	_VOICE_PLAY(131, 0, 0)
	_MACRO_TALKMSG('dialogue_c06', '18-msg_c06_lapras_01', 'Laaaa!')
	_ME_WAIT()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_assistantm:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_assistantm_01', 'I study rare Pokémon that appear only in the\nGreat Marsh.')
	_END()
ev_c06_picnicgirl:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_picnicgirl_01', 'Some Trainers deliberately prevent their\nPokémon from evolving.\rThey wait until the Pokémon levels up and learns\ncertain moves.')
	_END()
ev_c06_woman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_woman2_01', 'I’m visiting the area because I wanted to see the\nGreat Marsh. I’m staying at the lakeside hotel.')
	_END()
ev_c06_fighter:
	_TALK_OBJ_START()
	_SYS_FLAG_BADGE_GET($BADGE_ID_C06, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_fighter_badge_get')
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_fighter_01', 'Pastoria’s Gym Leader is like...breathtaking...in\na weird way.\rIt’s hard to explain. You’ll know what I\nmean, though.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_fighter_badge_get:
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_fighter_02', 'Wasn’t the Pastoria Gym Leader kind of\nbreathtaking in a weird way?\rBut don’t judge him by the way he looks\nand acts.\rI hear he uses the prize money to help people\nand Pokémon in trouble.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_ambrella:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#FE_C06_ACCE_GET, 'ev_c06_ambrella_02')
	_FIRST_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_c06_ambrella_acce_no_1_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_ambrella_acce_no_2_set')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_c06_ambrella_acce_no_3_set')
	_SEAL_NAME(0, @SCWK_TEMP0, 3)
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_ambrella_01', 'You’re just like a totally impatient boy I\nmet earlier.\rJust like you, he was very close with his Pokémon.\rHey, thanks for making me smile! These might\nput a smile on your face.\rThey’re {0,1,77,0}.\nPlace them on a Ball Capsule.')
	_CALL('ev_c06_ambrella_acce_get')
	_FLAG_SET(#FE_C06_ACCE_GET)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_ambrella_02:
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_ambrella_02', 'Someone gave me a Berry, so I planted it and\ngrew some more. Then, I took the Berries and\fcooked them into Poffins.\rAll the work is worth it when I see how happy\nPoffins make my Pokémon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_ambrella_acce_no_1_set:
	_GET_RND(@SCWK_TEMP2, 3)
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 0, 'ev_c06_ambrella_acce_no_1_set_a')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_c06_ambrella_acce_no_1_set_b')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 2, 'ev_c06_ambrella_acce_no_1_set_c')
	_RET()
ev_c06_ambrella_acce_no_1_set_a:
	_LDVAL(@SCWK_TEMP0, 29)
	_RET()
ev_c06_ambrella_acce_no_1_set_b:
	_LDVAL(@SCWK_TEMP0, 30)
	_RET()
ev_c06_ambrella_acce_no_1_set_c:
	_LDVAL(@SCWK_TEMP0, 31)
	_RET()
ev_c06_ambrella_acce_no_2_set:
	_GET_RND(@SCWK_TEMP2, 3)
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 0, 'ev_c06_ambrella_acce_no_2_set_a')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_c06_ambrella_acce_no_2_set_b')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 2, 'ev_c06_ambrella_acce_no_2_set_c')
	_RET()
ev_c06_ambrella_acce_no_2_set_a:
	_LDVAL(@SCWK_TEMP0, 25)
	_RET()
ev_c06_ambrella_acce_no_2_set_b:
	_LDVAL(@SCWK_TEMP0, 26)
	_RET()
ev_c06_ambrella_acce_no_2_set_c:
	_LDVAL(@SCWK_TEMP0, 27)
	_RET()
ev_c06_ambrella_acce_no_3_set:
	_GET_RND(@SCWK_TEMP2, 3)
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 0, 'ev_c06_ambrella_acce_no_3_set_a')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 1, 'ev_c06_ambrella_acce_no_3_set_b')
	_IFVAL_CALL(@SCWK_TEMP2, 'EQ', 2, 'ev_c06_ambrella_acce_no_3_set_c')
	_RET()
ev_c06_ambrella_acce_no_3_set_a:
	_LDVAL(@SCWK_TEMP0, 37)
	_RET()
ev_c06_ambrella_acce_no_3_set_b:
	_LDVAL(@SCWK_TEMP0, 38)
	_RET()
ev_c06_ambrella_acce_no_3_set_c:
	_LDVAL(@SCWK_TEMP0, 39)
	_RET()
ev_c06_ambrella_acce_get:
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_RET()
ev_c06_bigman1a:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_bigman1a_01', 'Someone in the Great Marsh offered me a\nTechnical Machine containing a hidden move,\fbut I declined.\rI don’t need it ’cause the Gym Leader will use\nDefog for us if we ever need it in this city.')
	_END()
ev_c06_man3a:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_man3a_01', 'Have you been to the Pokémon Mansion?\rThe owner, Mr. Backlot, likes to brag about his\nrare Pokémon.')
	_END()
ev_c06_man3:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '118-msg_c06_man3_01', 'The Great Marsh keeps the weather cool in\nthe summertime.\rThis is a good town for Water-type Pokémon.')
	_END()
ev_c06_maril:
	_EASY_VOICE_MSG('dialogue_c06%118-msg_c06_maril_01', 'PLAY_PV_EV_035_00_00')
	_END()
ev_c06_gingam_outside_great_marsh:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_gingam_05_1', 'Grr... The package hasn’t arrived\nfrom the Veilstone warehouse yet...\rI have to wait here until then?\nI’m going batty from this wait...\rOh, man, I wish I could do something\nthat involved lots of explosives!\rYup, this is going to be a smashing\njob for Team Galactic...')
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_gingam_05_2', 'Grr...\nThis is so annoying...\rWhat is it, you? Oh, some kid with\nonly four Gym Badges.\rLittle rascals like you should know\nto stay out of Team Galactic’s way!\r...Now, this package from Veilstone...\nWhere should I set it off...?\rYup, this is going to be a smashing\njob for Team Galactic...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
pos_c06_gingam_runaway_stop_data:
	_EVENT_START()
	_JUMP('ev_c06_gingam_runaway')
ev_c06_gingam_runaway_talk_start:
	_TALK_OBJ_START()
	_JUMP('ev_c06_gingam_runaway')
ev_c06_gingam_runaway:
	_CALL('ev_another_out')
	_EVENT_CAMERA_INDEX(434)
	_EVENT_CAMERA_END_WAIT()
	_CHARA_LOOK_LOCK('C06_GINGAM_RUNAWAY', 'HERO')
	_CHARA_LOOK_LOCK('HERO', 'C06_GINGAM_RUNAWAY')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C06_GINGAM_RUNAWAY')
	_CHARA_LOOK_RELEASE('HERO')
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_gingam_04_1', 'Gweh! Persistent pest!\rIf our plan works, our boss’s dream comes closer\nto fruition!\rOur boss’s ideal world is going to be created!')
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_gingam_04_2', 'So, I’m not going to waste my time on a nobody\nlike you!\rI’m telling you now, don’t you come chasing\nafter me!')
	_TALK_CLOSE()
	_GET_REL_POS_HERO('C06_GINGAM_RUNAWAY', @SCWK_TEMP0)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 6, 'ev_c06_gingam_left_02')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 4, 'ev_c06_gingam_right_02')
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'ev_c06_gingam_up_02')
	_JUMP('ev_c06_gingam_down_02')
	_END()
ev_c06_gingam_left_02:
	_OBJ_ANIME('C06_GINGAM_RUNAWAY', 'anm_c06_gingam_exit_1')
	_OBJ_ANIME('HERO', 'anm_c06_player_track_gingnam_1')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c06_gingam_04')
	_END()
ev_c06_gingam_right_02:
	_OBJ_ANIME('C06_GINGAM_RUNAWAY', 'anm_c06_gingam_exit_2')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c06_gingam_04')
	_END()
ev_c06_gingam_up_02:
	_OBJ_ANIME('C06_GINGAM_RUNAWAY', 'anm_c06_gingam_exit_2')
	_OBJ_ANIME('HERO', 'anm_c06_player_track_gingnam_2')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c06_gingam_04')
	_END()
ev_c06_gingam_down_02:
	_OBJ_ANIME('C06_GINGAM_RUNAWAY', 'anm_c06_gingam_exit_2')
	_OBJ_ANIME('HERO', 'anm_c06_player_track_gingnam_3')
	_OBJ_ANIME_WAIT()
	_JUMP('common_c06_gingam_04')
	_END()
common_c06_gingam_04:
	_SE_PLAY('S_FI001')
	_FLAG_SET(#2913)
	_LDVAL(@484, 4); Sets the work to 4 for the second step of the Galactic Runaway scene
	_OBJ_DEL('C06_GINGAM_RUNAWAY')
	_TIME_WAIT(15, @SCWK_ANSWER)
	_LDVAL(@WK_SCENE_C06, 3)
	_LDVAL(@WK_PLAY_REPO_NO, 8)
	_FLAG_SET(#FE_PLAY_REPO)
	_FLAG_SET(#FE_C06_GINGAM_2)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 7100)
	_LDVAL(@WK_SCENE_C06, 4)
	_EVENT_CAMERA_INDEX(435)
	_EVENT_CAMERA_END_WAIT()
	_NONE_USE_NUMBER('_TALK_OBJ_END')
	_CALL('ev_d27r0101_shaymin_flower_picker')
	_TALK_END()
	_END()
anm_c06_player_track_gingnam_1:
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_AC_WAIT(8)
	_AC_DIR_R(8)
	_ACMD_END()
anm_c06_player_track_gingnam_3:
	_AC_WAIT(8)
	_AC_DIR_R(8)
	_ACMD_END()
anm_c06_player_track_gingnam_2:
	_AC_WAIT(8)
	_AC_DIR_R(8)
	_ACMD_END()
anm_c06_gingam_exit_1:
	_AC_DIR_D(4)
	_AC_DOWN(1, 4)
	_AC_DIR_R(4)
	_AC_RIGHT(2, 4)
	_ACMD_END()
anm_c06_gingam_exit_2:
	_AC_DIR_R(4)
	_AC_RIGHT(2, 4)
	_ACMD_END()
ev_c06_sign1:
	_EVENT_START()
	_IF_FLAGOFF_JUMP($SYS_FLAG_WILDCARD_000, 'ev_c01_sign1_01')
	_EVENT_CAMERA_INDEX(333)
	_EASY_BOARD_MSG('dialogue_c06%118-msg_c06_sign1_01', 'BOARD_TYPE_TOWN', 0)
	_EVENT_CAMERA_INDEX(111)
	_EVENT_CAMERA_END_WAIT()
	_EVENT_END()
	_END()
ev_c06_sign2:
	_EASY_INFOBOARD_MSG('dialogue_c06%118-msg_c06_sign2_01', 'BOARD_TYPE_INFO', 0)
	_END()
ev_c06_sign3:
	_EASY_BOARD_MSG('dialogue_c06%118-msg_c06_sign3_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_c06_sign4:
	_EASY_BOARD_MSG('dialogue_c06%118-msg_c06_sign4_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_c06_wishboy:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2671, 'ev_c06_wishboy_done')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy', 'Trainer! Hey, Trainer!\nI have a wish!\rPlease show me a Pokémon that’s\na mean-looking fish!')
	_TEMOTI_POKE_CHK(@SCWK_ANSWER, 318)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_wishboy_318')
	_TEMOTI_POKE_CHK(@SCWK_ANSWER, 319)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_wishboy_319')
	_TEMOTI_POKE_CHK(@SCWK_ANSWER, 130)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_wishboy_130')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy_no', 'Aww, you don’t have any Pokémon\nthat look like a mean fish...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_wishboy_318:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy_318', 'Ooh! Look at that CARVANHA!\nIt’s the meanest fish I’ve ever seen!')
	_JUMP('ev_c06_wishboy_common')
ev_c06_wishboy_319:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy_319', 'Ooh! Look at that SHARPEDO!\nIt’s the meanest fish I’ve ever seen!')
	_JUMP('ev_c06_wishboy_common')
ev_c06_wishboy_130:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy_130', 'Woah! You have a GYARADOS!\nHey, Trainer, is GYARADOS a fish?\rI don’t know, but I love it!\nIt’s the meanest thing I’ve ever seen!')
	_JUMP('ev_c06_wishboy_common')
ev_c06_wishboy_common:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy_success', 'Yay! Thank you, Trainer!\nI’ll tell my sister all about it!')
	_TALK_CLOSE()
	_VOICE_WAIT()
	_WHITE_OUT('SCR_WIPE_DIV', 6)
	_FADE_WAIT()
	_TIME_WAIT(20, @SCWK_ANSWER)
	_VOICE_PLAY(385, 0, 0)
	_WHITE_IN()
	_FADE_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_t04r0201_oldwoman_wish', 'Someone, somewhere, saw that you\nmade somebody’s wish come true.')
	_FLAG_SET(#2671)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_wishboy_done:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_wishboy_done', 'Thanks a bunch, Trainer!\nI can’t wait to tell my sister!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_mew_torchic:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_torchic_greeting', 'Chiic chic...')
	_VOICE_PLAY(255, 0, 0)
	_OBJ_ANIME('C06_MEW_TORCHIC', 'anm_c06_hungry_torchic')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_torchic_hungry', 'Torchic seems extremely peckish...\nIt may want an Old Gateau.')
	_ITEM_CHK(54, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06_mew_torchic_no_cake')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_torchic_question', 'Give a Old Gateau to Torchic?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06_mew_torchic_yes')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_mew_torchic_no_cake:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c06_mew_torchic_yes:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_torchic_ate_cake', 'Torchic ate the Old Gateau.\nIt was thrilled to bits!')
	_TALK_CLOSE()
	_OBJ_ANIME('C06_MEW_TORCHIC', 'anm_c06_torchic_run')
	_OBJ_ANIME_WAIT()
	_WHITE_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_OBJ_DEL('C06_MEW_TORCHIC')
	_FLAG_SET(#2813)
	_TIME_WAIT(10, @SCWK_ANSWER)
	_FLAG_RESET(#2814)
	_OBJ_ADD('C06_MEW_EVENT')
	_CHARA_LOOK_LOCK('C06_MEW_EVENT', 'HERO')
	_WHITE_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_FLAG_RESET(#2818)
	_VOICE_PLAY(151, 0, 0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_mew_cry', 'Myuu!')
	_TALK_CLOSE()
	_WHITE_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C06_MEW_EVENT')
	_FLAG_SET(#2814)
	_OBJ_DEL('C06_MEW_EVENT')
	_WHITE_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC*3')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_ev_c06_mew_final', 'The strange Pokémon disappeared,\nbut it looked extremely happy.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_c06_hungry_torchic:
	_AC_INDEX_ANIME(44)
	_AC_MARK_EMO(8)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
anm_c06_torchic_run:
	_AC_DIR_D(8)
	_AC_DOWN(2, 8)
	_AC_DIR_L(8)
	_AC_LEFT(3, 8)
	_ACMD_END()
ev_c06_advice_dude:
	_MACRO_EASY_OBJ_MSG('dialogue_c06', '00_msg_c06_advice_dude_1', 'Hey there!\nHow’s it going, Champ-to-be?\rSorry to say that the Gym Leader\nis away from the Gym at the moment.\rWake—Crasher Wake, rather—said he\nwas heading out west to Route 212,\fto enjoy the scenery for a while.\rMaybe you can ask him to return\nto the Gym if you can find him?')
	_END()
ev_c06_rival_event:; Gets called after beating Wake when work @484 is set to 1 and exiting the gym
	_EVENT_START()
	_FLAG_RESET(#2911); Makes the C06_BARRY show up
	_OBJ_ADD('C06_BARRY')
	_TIME_WAIT(30, @SCWK_ANSWER)
	_SXY_MV_CHANGE('C06_BARRY', 'MV_LEFT'); Why not use _AC_LEFT??
	_OBJ_DIR_CHANGE('C06_BARRY', 1)
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_event_approach_player')
	_OBJ_ANIME('HERO', 'anm_c06_player_face_rival_event')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI003')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_1', 'Oh, hey!\nYou got the Gym Badge here, huh?\rWhat’d I tell you? Mr. Wake—I mean,\nthe master—is pretty awesome, hey?')
	_TALK_CLOSE()
	_SE_PLAY('S_FI012')
	_SET_DOOR_OBJ('C06GYM0101_D01')
	_HIT_DOOR_ANIME(0)
	_OBJ_ANIME('HERO', 'anm_c06_player_stop_blocking_wake')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET(#2836)
	_OBJ_ADD('C06_WAKE')
	_OBJ_ANIME('C06_WAKE', 'anm_c06_wake_enter_1')
	_OBJ_ANIME_WAIT()
	_HIT_DOOR_ANIME_WAIT()
	_SE_PLAY('S_FI013')
	_SET_DOOR_OBJ('C06GYM0101_D01')
	_HIT_DOOR_ANIME(1)
	_OBJ_ANIME('C06_WAKE', 'anm_c06_wake_enter_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_2', 'What’s this racket, then?\nOh, it’s you two.')
	_TALK_CLOSE()
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_exclamation')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_3', 'Oh, Master!')
	_OBJ_ANIME('C06_WAKE', 'anm_c06_wake_face_rival_event')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_4', '...Listen, kid.\nI know your father. I won’t deny that.\rBut I don’t recall ever taking you on\nas an apprentice. Not in the least.')
	_OBJ_ANIME('C06_WAKE', 'anm_c06_wake_face_down')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_5', 'Besides, you two don’t need me.\rYou can become strong on your own\nwithout being my apprentice.')
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_6_1', 'It doesn’t matter.\nI made you my master! I decided!\rBut forget that!\nThere’s trouble brewing!\rThere’s a Team Galactic goon in front \nof the Observatory Gate.\rHe said something about using a bomb!')
	_OBJ_ANIME('C06_WAKE', 'anm_c06_wake_face_rival_event')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_7', 'WHAAAAT?!\rNo one messes with Pastoria!\nNot on my watch!')
	_TALK_CLOSE()
	_OBJ_ANIME('HERO', 'anm_c06_player_face_wake_exit')
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_face_wake_exit')
	_OBJ_ANIME('C06_WAKE', 'anm_c06_wake_exit_gym')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_8', 'Hey!\nMaster! Wait!')
	_TALK_CLOSE()
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_chase_wake')
	_OBJ_ANIME_WAIT()
	_FLAG_RESET(#2837)
	_OBJ_ADD('C06_WAKE2')
	_FLAG_RESET(#2838)
	_OBJ_ADD('C06_BARRY2')
	_FLAG_SET(#FE_C06_GINGAM)
	_OBJ_DEL('C06_GINGAM')
	_OBJ_DEL('C06_SPARE_GINGAM')
	_OBJ_DEL('C06_GINGAM_SPARE2')
	_OBJ_DEL('C06_BARRY')
	_OBJ_DEL('C06_WAKE')
	_FLAG_SET(#2911)
	_FLAG_RESET(#2750)
	_FLAG_SET(#2758)
	_FLAG_SET(#2545)
	_LDVAL(@484, 2); Sets the StopData for the Galactic Bomb
	_TALK_OBJ_END()
	_END()
