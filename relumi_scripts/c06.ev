	_VOICE_WAIT()
	_RET()
anm_c06_barry_starter_roar:
	_AC_INDEX_ANIME(9)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
ev_c06_wake_exit:
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_24_shaymin', 'What an odd Pokémon. ANYWAY!')
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_24', 'You two! Do NOT follow me!\nDon’t let anyone else in, either!\rThere’d be big trouble if there’s any\nof that bomb left!')
	_TALK_CLOSE()
	_OBJ_ANIME('C06_WAKE2', 'anm_c06_wake_exit')
	_OBJ_ANIME('HERO', 'anm_c06_player_face_wake_4')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C06_WAKE2')
	_SE_PLAY('S_FI001')
	_SE_WAIT('S_FI001')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_CALL('ev_c06_rival_approach_player_2')
	_FLAG_SET(#2837)
	_CALL('ev_c06_setup_safari_zone_blockers')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_wake_25', 'Hey! {1,1,0,0}!\nYou go after that Galactic goon!\rI’m staying here like Master said!\nGotta keep others from going in!\rDon’t let that Galactic guy get away!')
	_TALK_CLOSE()
	_RET()
ev_c06_rival_approach_player_2:
	_OBJ_ANIME('C06_BARRY2', 'anm_c06_rival_approach_player_2')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c06_rival_fight:
	_EVENT_START()
	_OBJ_ADD('C06_BARRY')
	_FLAG_RESET(#2911)
	_LDVAL(@501, 2); Enable Barry in front of the Gym doors for refight
	_SXY_MV_CHANGE('C06_BARRY', 'MV_LEFT')
	_OBJ_DIR_CHANGE('C06_BARRY', 1)
	_CALL('ev_the_rival_play')
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_fight_approach_player_1')
	_OBJ_ANIME_WAIT()
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_SWITCH(@SCWK_TEMP0)
	_CASE_CALL(588, 'ev_c06_rival_approach_player_left')
	_CASE_CALL(589, 'ev_c06_rival_approach_player_center')
	_CASE_CALL(590, 'ev_c06_rival_approach_player_right')
	_OBJ_ANIME('HERO', 'anm_c06_player_face_rival_fight_1')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_rival_01_1', 'Whoops! Hehehe! I’m not always going to plow\ninto you every time we meet!')
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_rival_01_2', 'So how’s it going, {1,1,0,0}? Buffing up\nyour Pokémon, eh?\rI’ll test you and your Pokémon out to see how\nbuff and tough you are!', 0, 1)
	_TALK_CLOSE()
	_RIVAL_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06_rival_fight_piplup_setup')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_rival_fight_turtwig_setup')
	_JUMP('ev_c06_rival_fight_chimchar_setup')
ev_c06_rival_approach_player_left:
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_fight_approach_player_left')
	_RET()
ev_c06_rival_approach_player_center:
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_fight_approach_player_center')
	_RET()
ev_c06_rival_approach_player_right:
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_fight_approach_player_right')
	_RET()
ev_c06_rival_fight_defeated:
	_OBJ_ANIME('HERO', 'anm_c06_player_face_rival_fight_2')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_6', 'Heh, yeah, maybe you\ndid get a bit tougher since last time.\rThat even shocked me a bit, so yeah,\nI got beat ’cause I was careless.\rOh, yeah, I joined Mr. Wake as an\napprentice!\rLike, I want my own theme song!')
	_TALK_CLOSE()
	_OBJ_ANIME('C06_BARRY', 'anm_c06_rival_fight_exit')
	_OBJ_ANIME_WAIT()
	_LDVAL(@501, 0); End the Barry fighting scenes
	_FLAG_SET(#2911); Hide barry
	_OBJ_DEL('C06_BARRY')
	_TALK_OBJ_END()
	_END()
