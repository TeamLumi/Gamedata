ev_c06_rival_fight_talk:
	_TALK_OBJ_START()
	_CALL('ev_the_rival_play')
	_RIVAL_NAME(0)
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_c06', '118-msg_c06_rival_01_2', 'So how’s it going, {1,1,0,0}? Buffing up\nyour Pokémon, eh?\rI’ll test you and your Pokémon out to see how\nbuff and tough you are!', 0, 1)
	_TALK_CLOSE()
	_FLAG_RESET(#2912); Show Pastoria Barry Lose
	_RIVAL_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c06_rival_fight_talk_piplup_setup')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_rival_fight_talk_turtwig_setup')
	_JUMP('ev_c06_rival_fight_talk_chimchar_setup')
ev_c06_rival_fight_talk_defeated:
	_OBJ_ANIME('HERO', 'anm_c06_player_face_rival_left_fight_2')
	_OBJ_ANIME_WAIT()
	_RIVAL_NAME(0)
	_MACRO_TALKMSG('dialogue_c06', '00_msg_c06_barry_6', 'Heh, yeah, maybe you\ndid get a bit tougher since last time.\rThat even shocked me a bit, so yeah,\nI got beat ’cause I was careless.\rOh, yeah, I joined Mr. Wake as an\napprentice!\rLike, I want my own theme song!')
	_TALK_CLOSE()
	_JUMP('ev_c06_rival_fight_talk_defeated_end')
	_END()
ev_c06_rival_fight_talk_defeated_end:
	_BLACK_OUT()
	_FADE_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_LDVAL(@501, 0); End the Barry fighting scenes
	_OBJ_DEL('C06_BARRY_LOSE')
	_FLAG_SET(#2912); Hide Barry Lose
	_TIME_WAIT(15, @SCWK_ANSWER)
	_BLACK_IN()
	_FADE_WAIT()
	_TALK_OBJ_END()
	_END()
