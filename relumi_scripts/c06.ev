ev_c06_setup_safari_zone_blockers:
	_RIVAL_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c06_setup_blockers_infernape')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_c06_setup_blockers_empoleon')
	_FLAG_RESET(#2942)
	_OBJ_ADD('C06_BARRY_STARTER1')
	_LDVAL(@SCWK_TEMP0, 0); Effect Instance (not Effect ID)
	_LDVAL(@SCWK_TEMP1, -610); X coordinate
	_LDVAL(@SCWK_TEMP2, 2); Y coordinate
	_LDVAL(@SCWK_TEMP3, 810); Z coordinate
	_CALL('ev_common_poke_ball_appear_effect')
	_TIME_WAIT(5, @SCWK_ANSWER)
	_OBJ_ANIME('C06_BARRY_STARTER1', 'anm_c06_barry_starter_roar')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_VOICE_PLAY(389, 0, 0)
	_VOICE_WAIT()
	_RET()
ev_c06_setup_blockers_empoleon:
	_FLAG_RESET(#2944)
	_OBJ_ADD('C06_BARRY_STARTER3')
	_LDVAL(@SCWK_TEMP0, 0); Effect Instance (not Effect ID)
	_LDVAL(@SCWK_TEMP1, -610); X coordinate
	_LDVAL(@SCWK_TEMP2, 2); Y coordinate
	_LDVAL(@SCWK_TEMP3, 810); Z coordinate
