ev_t03_gingam:
	_TALK_OBJ_START_TURN_NOT()
	_OBJ_ANIME('T03_GINGAM_A', 'anm_t03_gingam_a')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gingam_a_01', 'Aren’t we Team Galactic? And we’re\nassigned here?\rStanding around among flowers... This doesn’t\nseem all that cool.')
	_TALK_CLOSE()
	_OBJ_ANIME('T03_GINGAM_B', 'anm_t03_gingam_b')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gingam_b_01', 'Hey now! Don’t complain. This is a pretty decent\nassignment. But Bug- and Grass-type Pokémon\fso creep me out...\rI don’t like being here, either.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_t03_gingam_a:
	_AC_DIR_R(8)
	_ACMD_END()
anm_t03_gingam_b:
	_AC_DIR_L(8)
	_ACMD_END()
ev_t03_boy1:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_D02R0101, 'GE', 2, 'ev_t03_boy1_02')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_boy1_01', 'I wanted to get some flowers from\nFloaroma Meadow...\rBut some Team Galactic guys in snazzy outfits\ncame along...')
	_OBJ_ANIME('T03_BOY1', 'anm_t03_boy1_01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_boy1_02', 'Those Galactic guys went to the meadow past\nthese flowers here...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_boy1_02:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_boy1_03', 'Being surrounded by flowers puts me in an oddly\npleasant mood.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
anm_t03_boy1_01:
	_AC_DIR_U(8)
	_AC_WAIT(3)
	_ACMD_END()
ev_t03_girl1:
	_MACRO_EASY_OBJ_MSG('dialogue_t03', '92-msg_t03_girl1_01', 'I simply love it here... The atmosphere is\nso uplifting.\rYou came to get emotionally healed too,\ndidn’t you?')
	_END()
ev_t03_woman1:
	_MACRO_EASY_OBJ_MSG('dialogue_t03', '92-msg_t03_woman1_01', 'Welcome to Floaroma, the town of flowers,\nflowers, and more flowers!\rYou should plant some flowers of your own, too.\nYay for flowers!')
	_END()
ev_t03_oldwoman2:
	_MACRO_EASY_OBJ_MSG('dialogue_t03', '92-msg_t03_oldwoman2_01', 'Berry trees are profoundly interesting.\nIf you grow them with care, they will bear\fgreat Berries.')
	_END()
ev_t03_campboy:
	_MACRO_EASY_OBJ_MSG('dialogue_t03', '92-msg_t03_campboy_01', 'I got drawn here by the sweet scent of Honey...\rSeriously, what’s that? What am I? A Pokémon or\nsomething? Mmm... Honey.')
	_END()
ev_t03_sign1:
	_EASY_BOARD_MSG('dialogue_t03%92-msg_t03_sign1_01', 'BOARD_TYPE_TOWN', 0)
	_END()
ev_t03_sign2:
	_EASY_BOARD_MSG('dialogue_t03%92-msg_t03_sign2_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_t03_sign3:
	_EASY_BOARD_MSG('dialogue_t03%92-msg_t03_sign3_01', 'BOARD_TYPE_POST', 0)
	_END()
ev_t03_woman2:
	_TALK_OBJ_START()
	_TEMOTI_POKE_CHK(@SCWK_ANSWER, 492)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t03_woman2_poke_nothing')
	_ITEM_CHK(466, 1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 0, 'ev_t03_woman2_item_have')
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_woman2_01', 'Oh, a Shaymin?\rIf you have that Pokémon, then you also should\nhave some Gracidea flowers.\rI’ve got a whole bunch, so you can have some.')
	_LDVAL(@SCWK_TEMP0, 466)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_woman2_poke_nothing:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_woman2_03', 'Do you know about Gracidea flowers?\rThey’re given as bouquets to express feelings\nof gratitude.\rIt’s an enduring tradition around these parts.')
	_JUMP('ev_t03_woman2_end')
	_END()
ev_t03_woman2_item_have:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_woman2_02', 'Gracidea flowers have been around a long time\nin this region.\rThey’re given as bouquets to express feelings\nof gratitude. Isn’t that charming?\rWith these Gracidea flowers, you don’t need to\nsay thanks with words.\rYou can, instead, demonstrate your gratitude\nwith a bouquet. How nice!')
	_JUMP('ev_t03_woman2_end')
	_END()
ev_t03_woman2_end:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_madam:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_T03_SP_MADAM, 'EQ', 3, 'ev_t03_madam5')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_01', 'Why, hello there...')
	_SAVE_RENDOU_ENABLE(@SCWK_ANSWER, 0)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t03_madam1')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_02', 'It looks like you’ve played Let’s Go in\nKanto before.')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_03', 'Would you like to ”go” on an adventure in\nSinnoh with this Pokémon?')
	_JUMP('ev_t03_madamu_pokemon_add_check')
	_END()
ev_t03_madam1:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_01_02', 'I see you’re adventuring with Pokémon. I’m sure\nyou’re making many lovely memories together.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_madam2:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_03_02', 'Oh dear. It appears you can’t accept any\nmore Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_madamu_pokemon_add_check:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 6, 'ev_t03_pokemon_add_check1')
	_COUNT_MONSBOX_SPACE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t03_pokemon_add_check1')
	_CALL('ev_t03_madam2')
	_END()
ev_t03_madam4:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_04', 'I’m sure it will be a good partner to you.')
	_LDVAL(@WK_SCENE_T03_SP_MADAM, 3)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_madam5:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_05', 'Please try to take very good care of Mew,\nthe New Species Pokémon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_pokemon_add_check1:
	_PLAYER_NAME(0)
	_POKEMON_NAME_EXTRA(1, 151, 0, 0)
	_SE_PLAY('M_FI013')
	_TALKMSG('dialogue_t03%53-msg_c05r0901_girl2_09')
	_ME_WAIT()
	_ADD_UNIQUE_POKEMON_UI(0, @SCWK_ANSWER)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
	_SUB_WK(@SCWK_ANSWER, 1)
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_madam_04', 'I’m sure it will be a good partner to you.')
	_LDVAL(@WK_SCENE_T03_SP_MADAM, 3)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_gentleman:
	_TALK_OBJ_START()
	_IFVAL_JUMP(@WK_SCENE_T03_SP_GENTLEMAN, 'EQ', 3, 'ev_t03_gentleman5')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gentleman_01', 'Oh, you there...')
	_SAVE_RENDOU_ENABLE(@SCWK_ANSWER, 1)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t03_gentleman1')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gentleman_02', 'And I gather you’ve seen a Wishing Star before.')
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gentleman_03', 'Would you mind taking this Pokémon? I think it\nwould be perfect for you.')
	_JUMP('ev_t03_gentlemanu_pokemon_add_check')
	_END()
