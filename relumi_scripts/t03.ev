	_TALK_OBJ_END()
	_END()
ev_t03_gentleman2:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gentleman_03_02', 'Oh my. Apparently you don’t have room for any\nmore Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_gentlemanu_pokemon_add_check:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 6, 'ev_t03_pokemon_add_check2')
	_COUNT_MONSBOX_SPACE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_t03_pokemon_add_check2')
	_CALL('ev_t03_gentleman2')
	_END()
ev_t03_gentleman4:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gentleman_04', 'I wish you and this Pokémon the grandest of\nadventures together!')
	_LDVAL(@WK_SCENE_T03_SP_GENTLEMAN, 3)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_gentleman5:
	_MACRO_TALKMSG('dialogue_t03', '92-msg_t03_gentleman_05', 'Take good care of Jirachi, the Wish Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_pokemon_add_check2:
	_PLAYER_NAME(0)
	_POKEMON_NAME_EXTRA(1, 385, 0, 0)
	_SE_PLAY('M_FI013')
	_TALKMSG('dialogue_t03%53-msg_c05r0901_girl2_09')
	_ME_WAIT()
	_ADD_UNIQUE_POKEMON_UI(1, @SCWK_ANSWER)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(115)
	_EVENT_CAMERA_INDEX(116)
	_EVENT_CAMERA_END_WAIT()
