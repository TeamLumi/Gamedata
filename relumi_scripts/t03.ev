ev_pokechange_zukan_add_t03:
	_ZUKAN_TOUROKU(-1, @SCWK_TEMP0)
	_ZUKAN_TOUROKU_WAIT()
	_RET()
ev_t03_ranger_drifloon_quest:
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#2011, 'ev_t03_ranger_quest_completed'); TODO Find other flags to use :P
	_IF_FLAGON_JUMP(#2010, 'ev_t03_ranger_gift_again')
	_IF_FLAGON_JUMP(#2009, 'ev_t03_ranger_drifloon_check')
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_drifloon_start', 'Greetings! Recently, there have been reports\nof a peculiar balloon-like Pokémon\fsomewhere around here.\rIf you find that Pokémon, could you please\nshow it to me?')
	_FLAG_SET(#2009); Drifloon Ranger has been talked to once
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_ranger_drifloon_check:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_drifloon_cont', 'Oh, hello again.\rHave you found the balloon Pokémon yet?')
	_TALK_CLOSE()
	_CALL('ev_t03_ranger_pokemon_check'); Loads SCWK_PARAM1 as MonsNo and SCWK_PARAM2 as FormNo
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_drifloon_success', 'That must be it!\nEverything matches the report perfectly!\rThis species of Pokémon is a danger to\nchildren and other short people.\rIts excitement causes it to get carried away\nand well... it carries them away!\rHere, this is to thank you for\nyour help with this.')
	_JUMP('ev_t03_ranger_drifloon_success')
	_END()
ev_t03_ranger_pokemon_check:
    _POKELIST_SET_PROC(24); This only highlight a specific list of mons detailed in UIDatabase.BoxOpenParam
  	_POKELIST_GET_RESULT(@SCWK_PARAM0, @SCWK_PARAM3); Argument 1 is the bag/box position, Argument 2 is the box number (0 = Bag)
	_IFVAL_JUMP(@SCWK_PARAM0, 'EQ', -1, 'ev_t03_ranger_drifloon_no'); If SCK_PARAM0 is -1, it means you chose nothing.
    _TEMOTI_BOX_MONSNO(@SCWK_PARAM0, @SCWK_PARAM3, @SCWK_PARAM1); Get the MonsNo of the selected Pokemon, SCWK_PARAM1
	_SWITCH(@SCWK_PARAM1)
	_CASE_JUMP(425, 'ev_t03_ranger_correct_pokemon'); Drifloon
	_CASE_JUMP(0, 'ev_t03_ranger_drifloon_invalid'); Egg
	_JUMP('ev_t03_ranger_drifloon_invalid'); Everything else
    _END()
ev_t03_ranger_drifloon_no:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_drifloon_no', 'You haven’t found it yet?\nKeep looking!\rRemember, we’re looking for a\nballoon-shaped Pokémon.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_ranger_drifloon_invalid:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_drifloon_invalid', 'No, that’s not quite right...\rThe Pokémon we’re looking for is\nshaped like a balloon.\rThe reports also said that it’s purple,\nmaybe that will help. Good luck!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_ranger_correct_pokemon:
	_RET(); Returns back to ev_t03_ranger_drifloon_check
ev_t03_ranger_drifloon_success:
	_LDVAL(@SCWK_TEMP3, 0)
	_FIRST_POKE_NO_GET(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_t03_ranger_gift_not_turtwig'); You have Turtwig
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_t03_ranger_gift_not_chimchar'); You have Chimchar
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_t03_ranger_gift_not_piplup'); You have Piplup
	_IFVAL_CALL(@SCWK_TEMP3, 'EQ', 1, 'ev_t03_ranger_gift_singular')
	_IFVAL_CALL(@SCWK_TEMP3, 'EQ', 2, 'ev_t03_ranger_gift_multiple')
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_Cancel', 'Not right now', 2)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0); SCWK_TEMP0 will have the MonsNo of the pokemon chosen
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 2, 'ev_t03_ranger_no_gift_give')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_t03_ranger_gift_no_tray_space'); Party and Boxes are full
	_POKEMON_NAME_EXTRA(0, @SCWK_TEMP0, 0, 0)
    _ME_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_receive_starter', 'You received {0,1,1,0}.')
    _ME_WAIT()
	_ADD_POKEMON_UI_EXTRA(@SCWK_TEMP0, 0, 5, 0, 3, 4) ; MonsNo, FormNo, Level, Item, MaxIVs, BallId
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(387, 'ev_t03_ranger_drifloon_turtwig_flag_set')
	_CASE_JUMP(390, 'ev_t03_ranger_drifloon_chimchar_flag_set')
	_CASE_JUMP(393, 'ev_t03_ranger_drifloon_piplup_flag_set')
	_END()
ev_t03_ranger_gift_not_piplup:
	_IF_FLAGOFF_CALL(#2293, 'ev_t03_ranger_gift_add_turtwig')
	_IF_FLAGOFF_CALL(#2294, 'ev_t03_ranger_gift_add_chimchar')
	_RET()
ev_t03_ranger_gift_not_turtwig:
	_IF_FLAGOFF_CALL(#2294, 'ev_t03_ranger_gift_add_chimchar')
	_IF_FLAGOFF_CALL(#2295, 'ev_t03_ranger_gift_add_piplup')
	_RET()
ev_t03_ranger_gift_not_chimchar:
	_IF_FLAGOFF_CALL(#2293, 'ev_t03_ranger_gift_add_turtwig')
	_IF_FLAGOFF_CALL(#2295, 'ev_t03_ranger_gift_add_piplup')
	_RET()
ev_t03_ranger_gift_add_turtwig:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_Turtwig', 'Turtwig', 387)
	_ADD_WK(@SCWK_TEMP3, 1)
	_RET()
ev_t03_ranger_gift_add_chimchar:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_Chimchar', 'Chimchar', 390)
	_ADD_WK(@SCWK_TEMP3, 1)
	_RET()
ev_t03_ranger_gift_add_piplup:
	_MACRO_ADD_CUSTUM_WIN_LABEL('dp_options', 'DP_ranger_options_Piplup', 'Piplup', 393)
	_ADD_WK(@SCWK_TEMP3, 1)
	_RET()
ev_t03_ranger_gift_singular:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_drifloon_ranger_single_pokemon_gift', 'This Pokémon is rare here in the Sinnoh Region.\nTake it with you on your journey.')
	_RET()
ev_t03_ranger_gift_multiple:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_drifloon_ranger_multiple_pokemon_gift', 'These Pokémon are rare here in the Sinnoh Region.\nChoose one to take with you on your journey.')
	_RET()
ev_t03_ranger_gift_again:
	_FLAG_RESET(#2010); Resets if the player has said no to Ranger Starter gift.
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_gift_again', 'Oh, hello again. Ready to take this Pokémon?')
	_JUMP('ev_t03_ranger_drifloon_success')
ev_t03_ranger_no_gift_give:
	_FLAG_SET(#2010); Player said no to Drifloon Ranger Starter Gift
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_no_gift_give', 'Oh, you’re not ready for it now?\nNo problem.\rI’ll hold onto it until you decide.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_ranger_gift_no_tray_space:
	_FLAG_SET(#2010); Player said no to Drifloon Ranger Starter Gift
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_gift_no_tray_space', 'Oh, but you don’t have space in your boxes.\nI’ll hold onto it until you make room.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_ranger_drifloon_turtwig_flag_set:
	_FLAG_SET(#2293); Ranger Turtwig
	_JUMP('ev_t03_ranger_quest_finish')
ev_t03_ranger_drifloon_chimchar_flag_set:
	_FLAG_SET(#2294); Ranger Chimchar
	_JUMP('ev_t03_ranger_quest_finish')
ev_t03_ranger_drifloon_piplup_flag_set:
	_FLAG_SET(#2295); Ranger Piplup
	_JUMP('ev_t03_ranger_quest_finish')
ev_t03_ranger_quest_finish:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_quest_finish', 'Take good care of it, and raise it well.\rI’ve got to continue my survey work now, but\nif you’re on your way to Eterna City,\fyou should speak to my colleague there.')
	_FLAG_SET(#2011); Route 203 Ranger Drifloon Quest completed.
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_t03_ranger_quest_completed:
	_MACRO_TALKMSG('dialogue_t03', 'msg_t03_ranger_quest_completed', 'If you’re on your way to Eterna City,\nyou should speak to my colleague there.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
