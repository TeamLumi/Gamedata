ev_r214r0101_middleman2:
	_TALK_OBJ_START()
	_ANOON_SEE_NUM(@LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'GE', 26, 'ev_r214r0101_middleman2_02')
	_MACRO_TALKMSG('dialogue_r214r0101', '110-msg_r214r0101_middleman2_01', 'Are you going to take Route 214? You’re\nserious, aren’t you?\rIt’s too badly chewed up, and there’s nothing to\nsee there.\rWell, I guess there is that Ruin Maniac guy you\ncould check out.\rThat guy’s been digging his way through the\nbedrock all by himself.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_r214r0101_middleman2_02:
	_MACRO_TALKMSG('dialogue_r214r0101', '110-msg_r214r0101_middleman2_02', 'That Ruin Maniac! It takes effort and dedication\nto do what he did!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()