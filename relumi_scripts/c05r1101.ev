ev_c05r1101_posdir_dahni:
	_IF_FLAGON_JUMP(#1805, 'ev_c05r1101_posdir_dahni_pikachu')
	_IF_FLAGON_JUMP(#1811, 'ev_c05r1101_posdir_dahni_2')
	_IF_FLAGON_JUMP(#1810, 'ev_c05r1101_posdir_dahni_1')
	_RET()
ev_c05r1101_judge:
	_EVENT_START()
	_OBJ_ANIME('C05R1101_JUDGE', 'anm_c05r1101_judge_100')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C05R1101_JUDGE', 'anm_c05r1101_judge_100_g')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C05R1101_JUDGE', 'HERO')
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_judge_01', 'Oh! My hero!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_MAMA', 'anm_c05r1101_mama_100')
	_OBJ_ANIME_WAIT()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_01', 'Oh, hi, {0,1,0,0}.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(379)
	_OBJ_ANIME('HERO', 'anm_c05r1101_player_100')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05_judge_02_01', 'Wait! No! Really?! Johanna is your mom?\nSo you might be a Super Contest Show star?!')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_06', 'Oh, I don’t know about that.\rI’ve never spoken to {0,1,0,0} about\nSuper Contest Shows.\rI’m surprised you two know each other, though.', 0, 1)
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_judge_03', 'Oh, yes, that’s right! I need to thank you for\nearlier. Please take this Sticker.')
	_LDVAL(@SCWK_TEMP0, 55)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_exec_item_seal_get')
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', '00_msg_c05r1101_judge_shinystone', 'Buneary wants me to give you\na little something else too.\nHere’s a simply dazzling stone she found for you!')
	_LDVAL(@SCWK_TEMP0, 107); Shiny Stone
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_judge_04_1', 'Place that Sticker on one of your Ball Capsules\nbefore a show.\rIt will lend a nice touch of sophistication\nand glamour.')
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_judge_04_2', 'I’m a show judge, so come join us for all kinds\nof fun. If you’re unsure of yourself, we also offer\fpractice sessions.')
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_judge_05', 'OK, Johanna, I’ll see you!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('C05R1101_JUDGE')
	_CHARA_LOOK_LOCK('HERO', 'C05R1101_JUDGE')
	_CHARA_LOOK_LOCK('C05R1101_MAMA', 'C05R1101_JUDGE')
	_OBJ_ANIME('C05R1101_JUDGE', 'anm_c05r1101_judge_110')
	_OBJ_ANIME_WAIT()
	_LDVAL(@WK_SCENE_C05R1101_JUDGE, 1)
	_CHARA_LOOK_RELEASE('HERO')
	_CHARA_LOOK_RELEASE('C05R1101_MAMA')
	_EVENT_CAMERA_INDEX(380)
	_OBJ_ANIME('C05R1101_MAMA', 'anm_c05r1101_mama_111')
	_OBJ_ANIME('HERO', 'anm_c05r1101_player_111')
	_OBJ_ANIME_WAIT()
	_OBJ_DEL('C05R1101_JUDGE')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_02_1', 'Were you surprised to see me,\n{0,1,0,0}?\rI got bored, so I came out to Hearthome for a\nlittle vacation.\rI’m just as surprised to see you here, my dear!', 0, 1)
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_02_2', 'But are you serious about entering\nSuper Contest Shows? Not dressed that way!\rIt’s your Pokémon’s time to shine, so you\nshouldn’t just be dressed your usual way.\rPut this on for a little glamour.')
	_TALK_CLOSE()
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_03', 'You obtained <color=#FF7A92FF>Contest Styles</color>!')
	_FLAG_SET(#1940); Contest Style Obtained
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_04', 'You put your new outfit into the\nClothing Trunk.')
	_JUMP('common_c05r1101_mama_10')
common_c05r1101_mama_10:
	_ME_WAIT()
	_OBJ_ANIME('C05R1101_MAMA', 'anm_c05r1101_mama_face01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_mama_05', 'I’m sure it will look good on you. After all, I\nchose it.\rGo enjoy the Super Contest Shows, honey!\rShows will give you a different look at the many\ncharms of Pokémon.\rIt should be an eye-opening experience for you.\nBye now!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_MAMA', 'anm_c05r1101_mama_face00')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(15, @SCWK_ANSWER)
	_EVENT_CAMERA_INDEX(381)
	_OBJ_ANIME('HERO', 'anm_c05r1101_player_01')
	_OBJ_ANIME('C05R1101_MAMA', 'anm_c05r1101_mama_11')
	_OBJ_ANIME_WAIT()
	_SE_PLAY('S_FI001')
	_OBJ_DEL('C05R1101_MAMA')
	_SE_WAIT('S_FI001')
	_EVENT_CAMERA_END_WAIT()
	_SET_WARP_ID(89)
	_SET_TELEPORT_ID(74, 0)
	_LDVAL(@WK_SCENE_C05, 1)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6100)
	_SET_SYS_FLAG($SYS_FLAG_PST)
	_LDVAL(@WK_SCENE_C05R1101, 1)
	_TALK_END()
	_END()
