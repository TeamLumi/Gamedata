	_AC_MARK_EMO(12)
	_AC_INDEX_ANIME_WAIT()
	_ACMD_END()
anm_cosplay_pikachu_2:
	_AC_INDEX_ANIME(54)
	_AC_INDEX_ANIME_WAIT()
	_AC_INDEX_ANIME(55)
	_AC_INDEX_ANIME_WAIT()
	_AC_INDEX_ANIME(56)
	_AC_INDEX_ANIME_WAIT()
    _AC_WAIT(10)
	_ACMD_END()
