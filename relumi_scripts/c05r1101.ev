	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c05r1101_woman3:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r1101', '55-msg_c05r1101_woman3_01', 'A Pokémon fed Poffins does better in\nVisual Evaluations.\rI’d better learn how to cook delicious Poffins at\nthe Poffin House!')
	_END()
ev_c05r1101_clown1:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_clown_01', 'Every Super Contest Show has three parts:\nVisual! Dance! And a Contest Move!\rEach contestant will be graded in those\ncategories, dohoho!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_girl3:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r1101', '55-msg_c05r1101_girl3_01', 'If your Pokémon is selected as the Star of\nthe Show, they’ll put up its photo!')
	_END()
ev_c05r1101_lovelovew_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C02R1101_LOVE_W_TALK01, 'ev_c05r1101_lovelovew_talk01')
	_IF_FLAGON_JUMP(#FE_C05R1101_CONTEST_FIRST, 'ev_c05r1101_lovelovew_iro_01_seen02')
	_JUMP('ev_c05r1101_lovelovew_talk01')
ev_c05r1101_lovelovew_talk01:
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_lovelovew_iro_01', 'My boyfriend gets so nervous that he can’t work\nup the courage to enter a contest show.\rWhat should I do...?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FE_C02R1101_LOVE_W_TALK01)
	_END()
ev_c05r1101_lovelovew_iro_01_seen02:
	_IF_FLAGON_JUMP(#FE_C05R1101_SEAL_GET1, 'ev_c05r1101_lovelovew_iro_01_seen03')
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_lovelovew_iro_02', 'It seems you inspired my boyfriend. He’s made\nup his mind to enter a contest show.\rI’d like to show my thanks by giving you these.')
	_LDVAL(@SCWK_TEMP0, 44)
	_LDVAL(@SCWK_TEMP1, 3)
	_CALL('ev_exec_item_seal_get')
	_FLAG_SET(#FE_C05R1101_SEAL_GET1)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_lovelovew_iro_01_seen03:
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_lovelovew_iro_03', 'I’m so looking forward to his big debut...')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_lovelovem_iro_01:
	_TALK_OBJ_START()
	_IF_FLAGOFF_JUMP(#FE_C02R1101_LOVE_M_TALK01, 'ev_c05r1101_lovelovem_talk01')
	_IF_FLAGON_JUMP(#FE_C05R1101_CONTEST_FIRST, 'ev_c05r1101_lovelovem_iro_01_seen02')
	_JUMP('ev_c05r1101_lovelovem_talk01')
ev_c05r1101_lovelovem_talk01:
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_lovelovem_iro_01', 'Today’s the day! I’m definitely going to compete\nin a contest show. Yeah, definitely...\r*gulp*\nAre you going to enter a contest show, too?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_FLAG_SET(#FE_C02R1101_LOVE_M_TALK01)
	_END()
ev_c05r1101_lovelovem_iro_01_seen02:
	_MACRO_TALKMSG('dialogue_c05r1101', '55-msg_c05r1101_lovelovem_iro_02', 'Your commanding stage presence gave me the\ncourage I needed to finally put myself out there.\rYeah, I can do this! That’s right—I’m going to\nenter a contest show!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_kodakku:
	_EASY_VOICE_MSG('dialogue_c05r1101%55-msg_c05r1101_kodakku', 'PLAY_PV_EV_054_00_00')
	_END()
ev_c05r1101_gorudakku:
	_EASY_VOICE_MSG('dialogue_c05r1101%55-msg_c05r1101_gorudakku', 'PLAY_PV_EV_055_00_00')
	_END()
ev_c05r1101_gym_leader:
	_TALK_OBJ_START()
	_OBJ_ANIME('C05R1101_GYM_LEADER', 'anm_c05r1101_leader_spin_1')
	_OBJ_ANIME_WAIT()
	_TIME_WAIT(4, @SCWK_ANSWER)
	_CHARA_LOOK_LOCK('C05R1101_GYM_LEADER', 'HERO')
	_MACRO_TALKMSG('dialogue_c05r1101', '00_msg_c05r1101_gymleader_0', 'Yes?\nI beg your pardon?\rAh, oui, Contests you are here for?\nI hope very much you enjoy them.\rIncidentally, Fantina, the Gym Leader\nof Hearthome, is also a Contestant.\rShe is, how do you say, très\nfantastique!\rFantina being myself, of course!')
	_MACRO_TALKMSG('dialogue_c05r1101', '00_msg_c05r1101_gymleader_1', 'Mmm, let me see...\nYou also seem to be très strong.\rEnfin, so it shall be.\nI wait for you at the Gym!')
	_TALK_CLOSE()
	_CHARA_LOOK_RELEASE('C05R1101_GYM_LEADER')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_FLAG_SET(#2549)
	_OBJ_DEL('C05R1101_GYM_LEADER')
	_BLACK_IN('SCR_WIPE_DIV', 3)
	_LDVAL(@TOWNMAP_GUIDE_SEQUENCE, 6150)
	_FADE_WAIT()
	_TALK_OBJ_END()
	_END()
anm_c05r1101_leader_spin_1:
	_AC_DIR_U(4)
	_AC_DIR_R(4)
	_AC_DIR_D(4)
	_AC_DIR_L(4)
	_ACMD_END()
ev_c05r1101_posdir_dahni_pikachu:
	_OBJ_POS_CHANGE_WORLD('C05R1101_DAHNI', 25, 0, 6)
	_OBJ_DIR_CHANGE('C05R1101_DAHNI', 0)
	_OBJ_DIR_CHANGE('C05R1101_COSPLAY_PIKACHU', 0)
	_RET()
ev_c05r1101_posdir_dahni_2:
	_OBJ_POS_CHANGE_WORLD('C05R1101_DAHNI', 25, 0, 6)
	_OBJ_DIR_CHANGE('C05R1101_DAHNI', 270)
	_RET()
ev_c05r1101_posdir_dahni_1:
	_OBJ_POS_CHANGE_WORLD('C05R1101_DAHNI', 25, 0, 6)
	_OBJ_DIR_CHANGE('C05R1101_DAHNI', 0)
	_RET()
ev_c05r1101_dahni:
	_IF_FLAGON_JUMP(#1809, 'ev_c05r1101_dahni_caught')
	_IF_FLAGON_JUMP(#1808, 'ev_c05r1101_dahni_not_caught')
	_IF_FLAGON_JUMP(#1807, 'ev_c05r1101_dahni_both_poffin')
	_IF_FLAGON_JUMP(#1806, 'ev_c05r1101_dahni_no_spicy_poffin')
	_IF_FLAGON_JUMP(#1805, 'ev_c05r1101_dahni_no_sweet_poffin')
	_IF_FLAGON_JUMP(#1811, 'ev_c05r1101_dahni_intro')
	_IF_FLAGON_JUMP(#1810, 'ev_c05r1101_dahni_post_meeting')
	_JUMP('ev_c05r1101_dahni_meeting')
	_END()
ev_c05r1101_dahni_meeting:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_meeting_1', 'Hi there!\nCan I help you with something?')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_meeting_2', 'Oh, I’m so sorry.\nYou must be wanting to register for a Contest,\nright?\rOh, but you don’t appear to have a Poffin\nCase.\rYou won’t get far in the Super Contest Shows\nwithout one. Trust me on that.\rHere, as way of an apology for chatting your\near off and to help you get started, take this!')
	_TALK_CLOSE()
	_LDVAL(@SCWK_TEMP0, 449)
	_LDVAL(@SCWK_TEMP1, 1)
	_ADD_ITEM_CHK(@SCWK_TEMP0, @SCWK_TEMP1, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05r1101_dahni_meeting_item_event_fail')
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_meeting_3', 'Letting your Pokémon eat Poffins is the key to\nreally letting them shine in Contests!\rAnd you can make all sorts of flavors too!\rI’d recomend swinging by the Poffin Pot in\nAmity Square or the Poffin House, so you can\flearn to make them!\rAnyway, I’ll get out of your hair, now.\rIf you’re interested, though. I’m going to be\nrunning a Contest Practice Class, that you can\fparticipate in by talking to the nurse at the\fcounter on the right.\rI look forward to seeing you there!')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_meeting_4', 'My name is Dahni, by the way.\rIt was great meeting you!')
	_TALK_CLOSE()
	_CALL('ev_c05r1101_dahni_meeting_move')
	_FLAG_SET(#1810); Met Dahni and received Poffin Case
	_FLAG_SET(#FE_C05R1101_POFIN_INFOMATION); Enables main counter contest nurse
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_meeting_move:
	_GET_REL_POS_HERO('C05R1101_DAHNI', @SCWK_TEMP2)
	_IFVAL_JUMP(@SCWK_TEMP2, 'EQ', 6, 'ev_c05r1101_dahni_meeting_move_around')
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_4')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r1101_dahni_meeting_move_around:
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_5')
	_OBJ_ANIME_WAIT()
	_RET()
ev_c05r1101_dahni_meeting_item_event_fail:
	_CALL('ev_item_event_fail')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_post_meeting:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_post_meeting', 'Oh hey!\nAre you here because you decided to try out\fmy Contest Class?\rYou can enter by talking to the nurse at the\ncounter!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_intro:
	_TALK_START()
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_1', 'What’s the matter?\nWhy are you kicking up such a fuss?')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_5')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_1')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(25, 1, 2)
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_pikachu_1', 'Piiika...')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_1')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_2', 'I really wish I spoke Pikachu...')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_2')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C05R1101_DAHNI', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C05R1101_DAHNI')
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_3', 'Oh, hello again!\nSorry if we were bothering you.\rI just realized that I told you my name, but I\nnever got yours.')
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_4', '{0}, huh. Well it’s lovely to properly\nmeet you, {0}!\rThis is my fussy little girl, Pikachu.')
	_TALK_CLOSE()
	_VOICE_PLAY(25, 1, 0)
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_4')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_pikachu_2', 'Chuuu!')
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_3')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_5', 'She’s been acting all agitated lately and I just\ndon’t know what to do.\rI fed her some of my special, homemade\npoffins. So there’s no way she’s hungry...')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_5')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(25, 1, 0)
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_1')
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_pikachu_3', 'Piii...')
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_2')
	_OBJ_ANIME_WAIT()
	_MACRO_TALK_KEYWAIT('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_6', 'Wait! You ARE hungry?!')
	_TALK_CLOSE()
	_CHARA_LOOK_LOCK('C05R1101_DAHNI', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C05R1101_DAHNI')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_7', 'Could you do me a huge favor?\rI’m not sure what the matter is with my\ncooking, but she’s clearly hungry for\fsomething.')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_8', 'My girl loves Sweet Poffins.\rDo you think you could go and make her a\nfresh one? Pretty please?\rThe Poffin Pot in Amity Square is a lovely\nplace to make them.')
	_FLAG_SET(#1805)
	_TALK_CLOSE()
	_TALK_END()
	_END()
ev_c05r1101_dahni_no_sweet_poffin:
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_no_sweet_poffin', 'There you are, {0}!\nDid you manage to make us a Sweet Poffin?')
	_TALK_CLOSE()
	_SELECT_POFFIN_UI(@SCWK_TEMP0)
	_GET_POFFIN_FLAVOR_NAME(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 10, 'ev_c05r1101_dahni_sweet_poffin'); Check for Sweet Poffin
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_dahni_8', 'My girl loves Sweet Poffins.\rDo you think you could go and make her a\nfresh one? Pretty please?\rThe Poffin Pot in Amity Square is a lovely\nplace to make them.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_sweet_poffin:
	_DEL_POFFIN(@SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_1', 'A Sweet Poffin! Thank you so much!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_3')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_2', 'Okay. Open wide!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_5')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_2')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(25, 1, 0)
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_1')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_intro_pikachu_3', 'Piii...')
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_3', 'WHAT?? That wasn’t right either?!')
	_TALK_CLOSE()
	_VOICE_PLAY(25, 1, 3)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_cosplay_pikachu_cry', 'Chuuu...')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_4', 'I just don’t understand.')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_2')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C05R1101_DAHNI', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C05R1101_DAHNI')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_5', 'Wait! Sometimes she prefers Spicy Poffins.\nYeah, that’s right!')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_6', 'I’m so sorry to put you through all of this\ntrouble, but do you think you could try one\fmore time with a Spicy Poffin?\rI promise to make it up to you, for all of your\nhard work!')
	_FLAG_SET(#1806)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_no_spicy_poffin:
	_TALK_OBJ_START()
	_PLAYER_NAME(0)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_no_spicy_poffin', 'There you are, {0}!\nDid you manage to make us a Spicy Poffin?')
	_TALK_CLOSE()
	_SELECT_POFFIN_UI(@SCWK_TEMP0)
	_GET_POFFIN_FLAVOR_NAME(@SCWK_TEMP0, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_c05r1101_dahni_spicy_poffin'); Check for Spicy Poffin
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_sweet_poffin_dahni_6', 'I’m so sorry to put you through all of this\ntrouble, but do you think you could try one\fmore time with a Spicy Poffin?\rI promise to make it up to you, for all of your\nhard work!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_spicy_poffin:
	_DEL_POFFIN(@SCWK_TEMP0)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_dahni_1', 'A Spicy Poffin! Let’s hope this is the one!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_3')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_dahni_2', 'Alright. Here comes the airplane!')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_5')
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_2')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(25, 1, 0)
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_1')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_pikachu_1', 'Ka...')
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_TALK_CLOSE()
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_dahni_3', 'I don’t get it.\nIf your favorite foods aren’t doing it then...')
	_TALK_CLOSE()
	_TIME_WAIT(10, @SCWK_ANSWER)
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_2')
	_OBJ_ANIME_WAIT()
	_CHARA_LOOK_LOCK('C05R1101_DAHNI', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C05R1101_DAHNI')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_dahni_4', 'Hang on a second!\nWhat if it isn’t food she wants?\rMaybe it’s battle that she’s hungry for!\rI’ll admit that while she always does well at\ncontests, I’ve recently had the feeling that\fshe’s yearning for more.\rI’m not much of a battler myself, but perhaps\nyou could take her with you.')
	_TALK_CLOSE()
	_OBJ_ANIME('C05R1101_DAHNI', 'anm_cosplay_dahni_3')
	_OBJ_ANIME_WAIT()
	_VOICE_PLAY(25, 1, 0)
	_OBJ_ANIME('C05R1101_COSPLAY_PIKACHU', 'anm_cosplay_pikachu_3')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_pikachu_2', 'Chu! Kachu, kachu!')
	_OBJ_ANIME_WAIT()
	_VOICE_WAIT()
	_CHARA_LOOK_LOCK('C05R1101_DAHNI', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C05R1101_DAHNI')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_spicy_poffin_dahni_5', 'Sounds like her mind is made up!')
	_FLAG_SET(#1807)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_dahni_both_poffin:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r1101', 'msg_c05r1101_dahni_both_poffin', 'Alright! Let’s see her give it her all in her first\nreal battle!')
	_END()
ev_c05r1101_dahni_not_caught:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r1101', 'msg_c05r1101_dahni_not_caught', 'It looks like she loved that!\rTry to catch her this time though, okay?\rI think she wants to go on to have lots of fun\nbattles and I really think that you’re the best\ftrainer to take her on that journey.')
	_END()
ev_c05r1101_dahni_caught:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r1101', 'msg_c05r1101_dahni_caught', 'How’s my old partner?\rHave you and Pikachu been having lots of fun\nbattling and playing dress-up?\rDid you try all the outfits?\nShe looks cute in all of them!')
	_END()
anm_cosplay_dahni_1:
	_AC_MARK_EMO(8)
    _AC_WAIT(15)
	_ACMD_END()
anm_cosplay_dahni_2:
	_AC_MARK_GYOE()
    _AC_WAIT(15)
	_ACMD_END()
anm_cosplay_dahni_3:
	_AC_DIR_R(8)
    _AC_WAIT(2)
	_ACMD_END()
anm_cosplay_dahni_4:
	_AC_DIR_R(4)
	_AC_RIGHT(9, 8)
	_AC_DIR_D(4)
	_ACMD_END()
anm_cosplay_dahni_5:
	_AC_DIR_D(4)
	_AC_DOWN(1, 8)
	_AC_DIR_R(4)
	_AC_RIGHT(9, 8)
	_AC_DIR_U(4)
	_AC_UP(1, 8)
	_AC_DIR_D(4)
	_ACMD_END()
ev_c05r1101_cosplay_pikachu:
	_IF_FLAGON_JUMP(#1807, 'ev_c05r1101_cosplay_pikachu_battle')
	_JUMP('ev_c05r1101_cosplay_pikachu_cry')
	_END()
ev_c05r1101_cosplay_pikachu_cry:
	_TALK_OBJ_START()
	_VOICE_PLAY(25, 1, 2)
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_cosplay_pikachu_cry', 'Chuuu...')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_cosplay_pikachu_battle:
	_TALK_OBJ_START()
	_VOICE_PLAY(25, 1, 2)
	_MACRO_TALKMSG('dialogue_c05r1101', '186-msg_r222r0101_pikachu1_01', 'Pikachuuu!')
	_VOICE_WAIT()
	_TALK_CLOSE()
	_SET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_SP_WILD_BTL_SET(25, 25, 0, 3); Cosplay Pikachu Belle Lv25
	_SEACRET_POKE_RETRY_CHECK(@SCWK_TEMP0, 25)
	_RESET_SYS_FLAG($SYS_FLAG_AUTOSAVE_STOP)
	_IFVAL_JUMP(@SCWK_TEMP0, 'EQ', 0, 'ev_c05r1101_cosplay_pikachu_lose')
	_OBJ_POS_CHANGE_WORLD('HERO', 25, 0, 7); Moves the Character to the X, Y, and Z locations
	_OBJ_DIR_CHANGE('HERO', 180); Make the player look North
	_OBJ_DIR_CHANGE('C05R1101_DAHNI', 0); Make Dahni look South
	_OBJ_DEL('C05R1101_COSPLAY_PIKACHU')
	_FLAG_SET(#1809); Battle is complete flag
	_FLAG_SET(#2923); Removes Cosplay Pikachu
	_JUMP('ev_c05r1101_cosplay_pikachu_caught')
	_END()
ev_c05r1101_cosplay_pikachu_lose:
	_CHARA_LOOK_LOCK('C05R1101_DAHNI', 'HERO')
	_TIME_WAIT(10, @SCWK_ANSWER)
	_CHARA_LOOK_RELEASE('C05R1101_DAHNI')
	_MACRO_TALKMSG('dialogue_c05r1101', 'msg_c05r1101_dahni_not_caught', 'It looks like she loved that!\rTry to catch her this time though, okay?\rI think she wants to go on to have lots of fun\nbattles and I really think that you’re the best\ftrainer to take her on that journey.')
	_FLAG_SET(#1808)
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r1101_cosplay_pikachu_caught:
	_MACRO_TALKMSG('dialogue_c05r1101', 'ev_c05r1101_cosplay_pikachu_caught_1', 'Hooray!\rIt makes me a little sad that my contest partner\nis leaving me, but I’m so glad that she’s going\fto go on an adventure like yours to achieve her\fdreams!\rEven though she’s calling it quits on full time\ncontests, I’m sure she wouldn’t mind dazzling\fthe competition on stage with you!\rIn that case, you’ll want this.')
	_LDVAL(@SCWK_TEMP0, 1307)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALKMSG('dialogue_c05r1101', 'ev_c05r1101_cosplay_pikachu_caught_2', 'There are lots of clothes in there for my—\nno. Our little girl!\rShe really loves to dress up.\rPlease take good care of her.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
