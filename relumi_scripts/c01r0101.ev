ev_c01r0101_flag_change:
	_TV_INTERVIEWER_CHECK(6, @LOCALWORK0)
	_IFVAL_JUMP(@LOCALWORK0, 'EQ', 0, 'ev_c01r0101_flagchange_vanish')
	_IFVAL_JUMP(@WK_SCENE_C01, 'LT', 2, 'ev_c01r0101_flagchange_vanish')
	_FLAG_RESET(#FV_TV_INTERVIEW_06)
	_END()
ev_c01r0101_flagchange_vanish:
	_FLAG_SET(#FV_TV_INTERVIEW_06)
	_END()
ev_c01r0101_middlem:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c01r0101', '32-msg_c01r0101_middlem_01', 'Hi, hi!\rI’m the president of the Pokétch Company!')
	_MACRO_TALKMSG('dialogue_c01r0101', '32-msg_c01r0101_middlem_15', 'So, yup, what to do? Do you think I should solicit\nnew Pokétch ideas?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c01r0101_assistantm:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0101', '32-msg_c01r0101_assistantm_01', 'Oh, you can be sure I’ll keep developing\nPokétch apps.\rJust like Pokémon, my Pokétch is something\nthat evolves!')
	_END()
ev_c01r0101_woman6:
	_MACRO_EASY_OBJ_MSG('dialogue_c01r0101', '32-msg_c01r0101_woman6_01', 'Welcome to the Pokétch Company.\rWe’re actually a family-run business, so we’re not\nvery impressive.\rOur biggest break was working with that other\ncompany to add Rotom to our newest models.')
	_END()