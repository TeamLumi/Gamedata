	_OBJ_ANIME('HERO', 'anm_c11_pw_man_out03')
	_OBJ_ANIME_WAIT()
	_TALK_END()
	_END()
	_OBJ_ANIME_WAIT()
	_END()
anm_c11_pw_man_out02:
