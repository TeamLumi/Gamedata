ev_t04r0101_berry_seller:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_sodateya', '00_msg_t04r0101_berry_greeting', 'I’ve got me some sweet and juicy\nberries from the local fields.\rThey’ll make ya Pokémon happy!\nOh yes, so very happy!\rI’ll sell ya a whole batch.')
	_LDVAL(@LOCALWORK3, 0)
	_JUMP('ev_t04r0101_fix_shop_re')
	_END()
ev_t04r0101_fix_shop_re:
	_IFVAL_CALL(@LOCALWORK3, 'EQ', 1, 'ev_t04r0101_fix_shop_sonohoka')
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_197', 0)
	_ADD_CUSTUM_WIN_LABEL('ss_fld_shop%SS_fld_shop_199', 1)
	_OPEN_CUSTUM_WIN(@SCWK_TEMP0)
	_SWITCH(@SCWK_TEMP0)
	_CASE_JUMP(0, 'ev_t04r0101_fix_shop_buy')
	_CASE_JUMP(1, 'ev_t04r0101_fix_shop_end')
	_JUMP('ev_t04r0101_fix_shop_end')
	_END()
ev_t04r0101_fix_shop_sonohoka:
	_MACRO_TALKMSG('dialogue_sodateya', '28-mes_shop_01_03', 'Is there anything else I can do for you?')
	_RET()
ev_t04r0101_fix_shop_buy:
	_LDVAL(@LOCALWORK3, 1)
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(300)
	_SHOP_OPEN_FIXED(16)
	_DPR_SHOP_OPEN_WAIT()
	_EVENT_CAMERA_INDEX(301)
	_EVENT_CAMERA_END_WAIT()
	_JUMP('ev_t04r0101_fix_shop_re')
	_END()
ev_t04r0101_fix_shop_end:
	_TALKMSG('ss_fld_shop%SS_fld_shop_202')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
