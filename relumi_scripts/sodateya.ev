ev_sodateya_m_init:
	_AZUKARIYA_OLDMAN_INIT()
	_END()
ev_sodateya_m_init_dir:
	_AZUKARIYA_EXIST_EGG(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_m_move_front')
	_END()
ev_sodateya_m_move_front:
	_OBJ_DIR_CHANGE('T04_SODATEYA_M', 0)
	_END()
ev_sodateya_m_move:
	_OBJ_ANIME('T04_SODATEYA_M', 'anm_sodateya_m_move')
	_END()
anm_sodateya_m_move:
	_AC_DIR_R(8)
	_ACMD_END()
ev_sodateya_m:
	_TALK_OBJ_START()
	_AZUKARIYA_EXIST_EGG(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_m_0100')
	_AZUKARIYA_STORED_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_m_0200')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_sodateya_m_0300')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_01', 'I’m the Pokémon Nursery Man. We look after the\nprecious Pokémon of other Trainers.\rIf you’d like us to take care of your Pokémon,\nhave a word with my wife.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_m_0100:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_02_1', 'Ah, it’s you! We were taking care of your\nPokémon, and my goodness, were we surprised!\rYour Pokémon was holding an Egg!')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_02_2', 'We don’t know how it got there, but your\nPokémon had it.\rYou do want it, don’t you?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_m_0101')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_11', 'I really will keep it. You do want this Egg, yes?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_m_0101')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_04', 'Well then, I’ll hang on to it. Thanks!')
	_TALK_CLOSE()
	_FLAG_RESET(#FE_SODATE_TAMAGO)
	_AZUKARIYA_DISCARD_EGG()
	_TALK_OBJ_END()
	_END()
ev_sodateya_m_0101:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'NE', 6, 'ev_sodateya_m_0102')
	_COUNT_MONSBOX_SPACE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_m_0102')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_05', 'Your team and all your PC Boxes are full.\rCome back when you’ve made room.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_m_0102:
	_PLAYER_NAME(0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_06', 'You received the Egg from the\nPokémon Nursery Man.')
	_ME_WAIT()
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_AZUKARIYA_GET_EGG()
	_FLAG_RESET(#FE_SODATE_TAMAGO)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_07', 'You take good care of it.')
	_AB_KEYWAIT()
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_m_0200:
	_AZUKARIYA_SET_STORED_NAME(0, 0)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_03', 'Ah, it’s you! Good to see you.\nYour {0,1,2,0}’s doing just fine.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_m_0300:
	_AZUKARIYA_SET_STORED_NAME(0, 0)
	_AZUKARIYA_SET_STORED_NAME(1, 1)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldman_10', 'Ah, it’s you! Good to see you!\rYour {0,1,2,0} and {1,1,2,0}\nare doing just fine.')
	_AZUKARIYA_LOVE_LEVEL(@SCWK_ANSWER)
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_aishou_level1')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_aishou_level2')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 2, 'ev_sodateya_aishou_level3')
	_IFVAL_CALL(@SCWK_ANSWER, 'EQ', 3, 'ev_sodateya_aishou_level4')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_aishou_level1:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_01', 'The two seem to get along very well.')
	_RET()
ev_sodateya_aishou_level2:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_02', 'The two seem to get along.')
	_RET()
ev_sodateya_aishou_level3:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_03', 'The two don’t seem to like each other much.')
	_RET()
ev_sodateya_aishou_level4:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_04', 'The two prefer to play with other Pokémon more\nthan with each other.')
	_RET()
ev_sodateya_w:
	_TALK_OBJ_START()
	_AZUKARIYA_EXIST_EGG(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_w_0100')
	_MONEY_OPEN()
	_AZUKARIYA_STORED_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_w_0200')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_sodateya_w_0300')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_01', 'I’m the Pokémon Nursery Lady. We can take care\nof up to two Pokémon for you.\rWould you like us to take care of your Pokémon?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_0001')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_06', 'Oh. Fine, then. Come again.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_w_0001:
	_GET_POKE_COUNT4(@LOCALWORK2)
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 1, 'ev_sodateya_w_0003')
	_IFVAL_JUMP(@LOCALWORK2, 'EQ', 2, 'ev_sodateya_w_0005')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_02', 'Which Pokémon should we take care of for you?')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_LDVAL(@SCWK_ANSWER, 0)
	_AZUKARIYA_STORE_UI(@SCWK_ANSWER, @234, @235, @236, @237)
	_MONEY_OPEN()
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_end')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_oldwoman_03')
	_JUMP('ev_sodateya_oldwoman_28')
	_END()
ev_sodateya_oldwoman_03:
	_ALL_MONSNO(@234, @235, @8)
	_IFVAL_JUMP(@8, 'EQ', 0, 'ev_sodateya_this_is_egg')
	_GET_POKE_COUNT3(@6)
	_IFVAL_CALL(@235, 'EQ', -1, 'ev_sodateya_oldwoman_28_pokecount')
	_IFVAL_JUMP(@6, 'EQ', 0, 'ev_sodateya_w_0003')
	_AZUKARIYA_STORED_COUNT(@18)
	_IFVAL_JUMP(@18, 'EQ', 1, 'ev_sodateya_oldwoman_03_1keep')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_26', 'It’ll cost 500 to leave one Pokémon.\nIs that all right?')
	_JUMP('ev_sodateya_oldwoman_03_ato')
	_END()
ev_sodateya_oldwoman_03_1keep:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_27', 'That will be an additional 500.\nIs that all right?')
	_JUMP('ev_sodateya_oldwoman_03_ato')
	_END()
ev_sodateya_oldwoman_03_ato:
	_YES_NO_WIN(@4)
	_IFVAL_JUMP(@4, 'EQ', 1, 'ev_sodateya_w_end')
	_COMP_GOLD(@5, 500)
	_IFVAL_JUMP(@5, 'EQ', 0, 'ev_sodateya_no_maney')
	_SUB_GOLD(500)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MONEY_CLOSE()
	_FLAG_SET(#213)
	_UNKNOWN_FORM_GET(@234, @235, @9)
	_AZUKARIYA_STORE(@234, @235, -1, -1)
	_AZUKARIYA_STORED_COUNT(@235)
	_SUB_WK(@235, 1)
	_AZUKARIYA_GET_STORED_MONSNO(@SCWK_ANSWER, @235)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_sodateya_w_end')
	_VOICE_PLAY(@SCWK_ANSWER, @9, 0)
	_AZUKARIYA_SET_STORED_NAME(0, @235)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_03', 'Fine, we’ll take care of your {0,1,2,0}\nfor a while.\rCome back for it later.', 0, 1)
	_TALK_CLOSE()
	_VOICE_WAIT()
	_TALK_OBJ_END()
	_END()
ev_sodateya_oldwoman_28:
	_ALL_MONSNO(@234, @235, @9)
	_IFVAL_JUMP(@9, 'EQ', 0, 'ev_sodateya_this_is_egg')
	_ALL_MONSNO(@236, @237, @10)
	_IFVAL_JUMP(@10, 'EQ', 0, 'ev_sodateya_this_is_egg')
	_GET_POKE_COUNT4(@7)
	_IFVAL_JUMP(@7, 'LE', 3, 'ev_sodateya_w_0003')
	_GET_POKE_COUNT3(@6)
	_IFVAL_CALL(@235, 'EQ', -1, 'ev_sodateya_oldwoman_28_pokecount')
	_IFVAL_CALL(@237, 'EQ', -1, 'ev_sodateya_oldwoman_28_pokecount')
	_IFVAL_JUMP(@6, 'EQ', 0, 'ev_sodateya_w_0003')
	_JUMP('ev_sodateya_oldwoman_28_2')
	_END()
ev_sodateya_oldwoman_28_2:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_25', 'It’ll cost 1,000 to leave two Pokémon.\nIs that all right?')
	_YES_NO_WIN(@4)
	_IFVAL_JUMP(@4, 'EQ', 1, 'ev_sodateya_w_end')
	_COMP_GOLD(@5, 1000)
	_IFVAL_JUMP(@5, 'EQ', 0, 'ev_sodateya_no_maney')
	_SUB_GOLD(1000)
	_FLAG_SET(#213)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_MONEY_CLOSE()
	_UNKNOWN_FORM_GET(@234, @235, @9)
	_UNKNOWN_FORM_GET(@236, @237, @10)
	_AZUKARIYA_STORE(@234, @235, @236, @237)
	_AZUKARIYA_GET_STORED_MONSNO(@SCWK_ANSWER, 0)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_sodateya_w_end')
	_VOICE_PLAY(@SCWK_ANSWER, @9, 0)
	_AZUKARIYA_SET_STORED_NAME(0, 0)
	_TIME_WAIT(15, @SCWK_ANSWER)
	_AZUKARIYA_GET_STORED_MONSNO(@SCWK_ANSWER, 1)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', -1, 'ev_sodateya_w_end')
	_VOICE_PLAY(@SCWK_ANSWER, @10, 0)
	_AZUKARIYA_SET_STORED_NAME(1, 1)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_28', 'OK. I’ll take good care of your {0,1,2,0}\nand {1,1,2,0}.\rCome back for them later.')
	_TALK_CLOSE()
	_VOICE_WAIT()
	_TALK_OBJ_END()
	_END()
ev_sodateya_oldwoman_28_pokecount:
	_SUB_WK(@6, 1)
	_RET()
ev_sodateya_w_end:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_09', 'Come again.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_w_0003:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_16', 'Oh? You can’t leave your Pokémon because you\ndon’t have enough Pokémon with you.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_w_0005:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_19', 'Huh? Now, now...\rIf you leave that Pokémon with me, you’ll be left\nwith just one. You will be better off if you catch\fsome more, if I do say so myself.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_w_0100:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_05', 'Ah, there you are! My husband was looking\nfor you.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_w_0200:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_10', 'Ah, it’s you! Good to see you. Now, about\nyour Pokémon...')
	_LDVAL(@234, 0)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_04', 'We can keep two of your Pokémon. Would you\nlike to leave another?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_0001')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_17', 'Do you want your Pokémon back?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_0201')
	_JUMP('ev_sodateya_w_end')
	_JUMP('ev_sodateya_w_0201')
ev_sodateya_w_0201:
	_AZUKARIYA_STORED_COUNT(@236)
	_LDVAL(@235, 0)
	_IFVAL_JUMP(@236, 'EQ', 1, 'ev_sodateya_w_0202')
	_LDVAL(@235, 0)
	_CALL('ev_sodateya_restore_win')
	_LDVAL(@235, 1)
	_CALL('ev_sodateya_restore_win')
	_ADD_CUSTUM_WIN_LABEL_WORD_SET('dp_options%DP_options_136', 2)
	_OPEN_CUSTUM_WIN_WORD_SET(@235)
	_SWITCH(@235)
	_CASE_JUMP(0, 'ev_sodateya_w_0202')
	_CASE_JUMP(1, 'ev_sodateya_w_0202')
	_JUMP('ev_sodateya_w_end')
	_END()
ev_sodateya_restore_win:
	_AZUKARIYA_SET_STORED_INFO_STR(@235)
	_AZUKARIYA_GET_STORED_SEX(@236, @235)
	_SWITCH(@236)
	_CASE_JUMP(0, 'ev_sodateya_restore_win_male')
	_CASE_JUMP(1, 'ev_sodateya_restore_win_female')
	_JUMP('ev_sodateya_restore_win_unknown')
	_END()
ev_sodateya_restore_win_male:
	_ADD_CUSTUM_WIN_LABEL_WORD_SET('dp_options%DP_options_851', @235)
	_RET()
ev_sodateya_restore_win_female:
	_ADD_CUSTUM_WIN_LABEL_WORD_SET('dp_options%DP_options_852', @235)
	_RET()
ev_sodateya_restore_win_unknown:
	_ADD_CUSTUM_WIN_LABEL_WORD_SET('dp_options%DP_options_853', @235)
	_RET()
ev_sodateya_w_0202:
	_CALL('ev_sodateya_w_poke_max_check')
	_AZUKARIYA_SET_STORED_NAME(0, @235)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_29', 'Just a moment. I’ll go get your {0,1,2,0}.')
	_TALK_CLOSE()
	_AZUKARIYA_TAKE_OVER_POKE(@235, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_end')
	_AZUKARIYA_SET_STORED_NAME(0, @235)
	_AZUKARIYA_RESTORE(@235, @SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_sodateya_w_restore')
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 2, 'ev_sodateya_w_restore')
	_END()
ev_sodateya_w_restore:
	_OBJ_ANIME('SODATEYA_OLDWOMAN2', 'oldwoman2_01_anime01')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_15', 'Excellent! Here’s your Pokémon.')
	_PLAYER_NAME(1)
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_20', 'You took {0,1,2,0} back from the\nPokémon Nursery Lady.')
	_AZUKARIYA_STORED_COUNT(@236)
	_IFVAL_JUMP(@236, 'EQ', 0, 'ev_sodateya_w_end')
	_JUMP('ev_sodateya_w_0205')
	_END()
ev_sodateya_w_0205:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_08', 'Do you want to take back the other one, too?')
	_LDVAL(@235, 0)
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_0202')
	_JUMP('ev_sodateya_w_end')
oldwoman2_01_anime01:
	_AC_WAIT(8)
	_AC_DIR_L(8)
	_AC_WAIT(4)
	_AC_DIR_U(8)
	_AC_UP(1, 8)
	_AC_WAIT(4)
	_AC_VANISH_ON(1)
	_AC_WAIT(8)
	_AC_DIR_D(8)
	_AC_VANISH_OFF(1)
	_AC_DOWN(1, 8)
	_AC_WAIT(8)
	_ACMD_END()
	_JUMP('ev_sodateya_w_poke_max_check_ok')
ev_sodateya_w_poke_max_check:
	_GET_POKE_COUNT(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'LT', 6, 'ev_sodateya_w_poke_max_check_ok')
	_COUNT_MONSBOX_SPACE(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_poke_max_check_ok')
	_JUMP('ev_sodateya_w_poke_max_end')
	_JUMP('ev_sodateya_w_poke_max_check_ok')
ev_sodateya_w_poke_max_check_ok:
	_RET()
ev_sodateya_w_poke_max_end:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_12', 'Your team and all your PC Boxes are full.\rCome back when you’ve made room.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_w_0300:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_10', 'Ah, it’s you! Good to see you. Now, about\nyour Pokémon...')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_17', 'Do you want your Pokémon back?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 0, 'ev_sodateya_w_0201')
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_09', 'Come again.')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_sodateya_no_maney:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_07', 'You don’t have enough money...')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_END()
	_END()
ev_sodateya_this_is_egg:
	_MACRO_TALKMSG('dialogue_sodateya', '62-msg_sodateya_oldwoman_21', 'Now, now.\nWe can’t take care of Eggs!')
	_TALK_CLOSE()
	_MONEY_CLOSE()
	_TALK_END()
	_END()
ev_sodateya_evtrain_starter_package:
	_PLAYER_NAME(0)
	_MACRO_TALK_KEYWAIT('dialogue_sodateya', '00_msg_ev_sodateya_evtrain_starter_package', 'Howdy, Trainer!\nWhat’s your name?\r{0}, huh?\nThat’s a proper tootin’ name!\rAre your Pokémon in need of training?\rIn that case, I’m your gal!\nEvey, that’s me!\rPokémon are able to improve a stat if\nthey battle Pokémon that specialize\nin that stat.\rI’ve got teams of Pokémon to help\nyou with all of that.\rOh, and experience, too.\nIf you just want to level up, that is.\rYou just talk to me if you need any\nhelp! All free of charge!\rOh! I almost forgot.\nThis is a starter pack for you.\rBear with me...')
	_LDVAL(@SCWK_TEMP0, 289)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 290)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 291)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 292)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 293)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_LDVAL(@SCWK_TEMP0, 294)
	_LDVAL(@SCWK_TEMP1, 1)
	_CALL('ev_item_event')
	_MACRO_TALK_KEYWAIT('dialogue_sodateya', '00_msg_ev_sodateya_evtrain_starter_package_2', 'There! All done.\rEquip those items to your Pokémon to\nspeed up training for a specific stat.\rNow, if you want to train, just come\nback here and chat to me!')
	_TALK_CLOSE()
	_FLAG_SET(#2697)
	_TALK_OBJ_END()
	_END()
ev_sodateya_evtrain:
	_TALK_OBJ_START()
	_PC_KAIFUKU(); Silently heal pokemon
	_IF_FLAGOFF_JUMP(#2697, 'ev_sodateya_evtrain_starter_package')
