ev_c04r0204_gkanbu1:
	_TALK_OBJ_START_LOOK_NONE()
	_EVENT_START()
	_CALL('ev_block_doc')
	_BLACK_OUT('SCR_WIPE_DIV', 3)
	_FADE_WAIT()
	_SXY_POS_CHANGE('HERO', 16, 7)
	_OBJ_DIR_CHANGE('HERO', 180)
	_OBJ_DIR_CHANGE('GINGALEADER2_01', 0)
	_EVENT_CAMERA_INDEX(403)
	_TIME_WAIT(30, @246)
	_OBJ_ANIME('C04R0204_MIDDLEM', 'anm_c04r0204_middlem_40')
	_OBJ_ANIME_WAIT()
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_gkanbu1_01', 'Eh? Did you want something?\rHow silly of me to even ask. You want to free the\nPokémon.\rFine!\nI, Jupiter, will deal with you.')
	_TALK_CLOSE()
	_EVENT_CAMERA_INDEX(400)
	_LDVAL(@428, 4)
	_FLAG_SET(#1751)
	_LDVAL(@SCWK_TEMP3, 876)
	_CALL('ev_set_trainer_id_for_current_gamemode_scripted_battle')
	_TRAINER_BTL_SET(@SCWK_TEMP3, 0)
	_IF_FLAGON_CALL(#1751, 'ev_to_write_play_repo')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_gkanbu1_02_1', 'Well, aren’t you tough...?\rIt’s OK, though. Our official Pokémon-statue\ninvestigation is finished.\rMars has collected energy from the Valley\nWindworks.')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_gkanbu1_02_2', 'We’re pretty much finished here. I’ll let you in on\none little thing.\rOur boss is researching the myths of ancient\nPokémon. With the power of mythical Pokémon,\fhe will become the ruler of Sinnoh...')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_gkanbu1_02_3', 'I suggest you keep out of Team Galactic’s affairs\nfrom now on.\rThis is your last warning!')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_CALL('ev_block_doc_end')
	_OBJ_DEL('C04R0204_GKANBU1')
    _FLAG_RESET(#2893)
    _OBJ_ADD('C04R0204_PORY')
	_LDVAL(@249, 5300)
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_JUMP('ev_c04r0204_gkanbu2')
	_CALL('ev_block_doc_end')
	_END()
ev_c04r0204_gkanbu2:
	_OBJ_ANIME('C04R0204_MIDDLEM', 'anm_c04r0204_middlem_30')
	_OBJ_ANIME('HERO', 'anm_c04r0204_player_30')
	_OBJ_ANIME_WAIT()
	_JUMP('ev_c04r0204_gkanbu3')
	_END()
ev_c04r0204_gkanbu3:
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_02_1', 'I got my Clefairy back, and it’s all thanks to you!\nBut that Team Galactic...')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_02_2', 'They said, “Clefairy came from space. Hand\nit over!”\rTheir logic baffles me still. It’s like they are\nfrom space!')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_02_3', 'Anyway, they’re gone now. Thank you very much!\rI can’t thank you enough right now, but cruise by\nmy Cycle Shop, OK?')
	_TALK_CLOSE()
	_BLACK_OUT('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_FLAG_SET(#450)
	_FLAG_SET(#90)
	_FLAG_RESET(#345)
	_FLAG_SET(#452)
	_FLAG_RESET(#453)
	_FLAG_RESET(#451)
	_OBJ_DEL('C04R0204_MIDDLEM')
	_OBJ_DEL('C04R0204_PIPPI')
	_OBJ_DEL('C04R0204_GONBE')
	_BLACK_IN('SCR_WIPE_DIV', 'SCR_WIPE_SYNC')
	_FADE_WAIT()
	_FLAG_SET(#1625)
	_SET_SYS_FLAG($39)
	_LDVAL(@WK_SCENE_C04, 3)
	_LDVAL(@249, 5400)
	_TALK_END()
	_TALK_OBJ_END()
	_END()
ev_c04r0204_gkanbu1_battle_lose:
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c04r0204_poster:
	_MACRO_EASY_OBJ_MSG('dialogue_c04r0204', 'msg_c04r0204_poster_01', 'Working for world peace.\n       Team Galactic')
	_END()
anm_c04r0204_middlem_40:
	_AC_DIR_U(8)
	_ACMD_END()
anm_c04r0204_middlem_30:
	_AC_UP(1, 8)
	_ACMD_END()
anm_c04r0204_player_30:
	_AC_DIR_D(8)
	_ACMD_END()
ev_c04r0204_pippi:
	_EASY_VOICE_MSG('dialogue_c04r0204%8-msg_c04r0204_pippi_01', 'PLAY_PV_EV_035_00_00')
	_END()
ev_c04r0204_gonbe:
	_EASY_VOICE_MSG('dialogue_c04r0204%8-msg_c04r0204_gonbe_01', 'Play_PV_EV_427_00_03')
	_END()
ev_c04r0204_middlem:
	_EVENT_START()
	_EVENT_CAMERA_INDEX(910)
	_EVENT_CAMERA_END_WAIT()
	_TALK_OBJ_START()
	_IF_FLAGON_JUMP(#90, 'ev_c04r0204_middlem_02')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_01', 'What is it with this Team Galactic?\rWhy did they take our Pokémon? What are they\ntrying to accomplish?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_EVENT_CAMERA_INDEX(911)
	_EVENT_CAMERA_END_WAIT()
	_TALK_END()
	_END()
ev_c04r0204_middlem_02:
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_02_1', 'I got my Clefairy back, and it’s all thanks to you!\nBut that Team Galactic...')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_02_2', 'They said, “Clefairy came from space. Hand\nit over!”\rTheir logic baffles me still. It’s like they are\nfrom space!')
	_MACRO_TALKMSG('dialogue_c04r0204', '8-msg_c04r0204_middlem_02_3', 'Anyway, they’re gone now. Thank you very much!\rI can’t thank you enough right now, but cruise by\nmy Cycle Shop, OK?')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_TALK_END()
	_END()
ev_c04r0204_pory_no:
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0204_pory:
	_TALK_OBJ_START()
	_MACRO_TALKMSG('dialogue_c04r0204', '00_msg_c04r0204_pory_0', 'This Porygon doesn’t seem to have a Trainer.\nWould you like to take it with you?')
	_YES_NO_WIN(@SCWK_ANSWER)
	_IFVAL_JUMP(@SCWK_ANSWER, 'EQ', 1, 'ev_c04r0204_pory_no')
	_CALL('ev_common_tray_space_check'); Checks if there is any remaining space in the Party and Boxes
	_IFVAL_JUMP(@551, 'EQ', 1, 'ev_c04r0204_pory_no_tray_space'); Party and Boxes are full
	_POKEMON_NAME_EXTRA(1, 137, 0, 0)
	_SE_PLAY('M_FI013')
	_MACRO_TALKMSG('dialogue_c04r0204', '31-msg-c01pc0101_reporter1_m', 'You received {1,1,1,0}!')
	_ME_WAIT()
	_ADD_POKEMON_UI_EXTRA(137, 0, 22, 0, 3, 4) ; MonsNo, FormNo, Level, Item, MaxIVs, BallId
    _OBJ_DEL('C04R0204_PORY')
	_FLAG_SET(#2893)
	_MACRO_TALK_KEYWAIT('dialogue_c04r0204', '00_msg_c04r0204_pory_1', 'You received a Porygon!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c04r0204_pory_no_tray_space:
	_MACRO_TALKMSG('dialogue_c04r0204', 'msg_c04r0204_pory_no_tray_space', 'You don’t have any room for it in your party or\nboxes.')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()