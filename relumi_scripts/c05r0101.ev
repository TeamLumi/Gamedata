ev_c05r0101_flag_change:
	_LDVAL(@WK_ELEVATOR_FLOOR, 0)
	_LDVAL(@LOCALWORK1, 0)
	_END()
ev_c05r0101_door_exit:
	_SET_DOOR_OBJ('C05R0103_D01')
	_PLAYER_POS_GET(@SCWK_TEMP0, @SCWK_TEMP1)
	_IFVAL_JUMP(@SCWK_TEMP1, 'EQ', 3, 'door_exit_elevator')
	_END()
ev_c05r0101_middleman2:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0101', '41-msg_c05r0101_middleman2_01', 'There are the Super Contest Shows! Then, we\nhave Amity Square!\rWe have visitors from all over, so we need to\nkeep the city looking nice!')
	_END()
ev_c05r0101_gorggeousw:
	_TALK_OBJ_START_TURN_NOT()
	_MACRO_TALKMSG('dialogue_c05r0101', '41-msg_c05r0101_gorggeousw_01', 'People all over the world follow Super\nContest Shows.\rWhat should I do? I could captivate the\nwhole world!')
	_TALK_CLOSE()
	_TALK_OBJ_END()
	_END()
ev_c05r0101_script_3:
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0101', '00_msg_c05r0101_script_3', 'My Shroomish finds Berries and things\nwhen we go to Amity Square.')
	_END()
ev_c05r0101_script_4:
	_VOICE_PLAY(285, 0, 0)
	_MACRO_EASY_OBJ_MSG('dialogue_c05r0101', '00_msg_c05r0101_script_4', 'Pofwaaah!')
	_END()